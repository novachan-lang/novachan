import forge_rbac

fn main()
    let r = rbac_new()
    assert(len(r["role_perms"]) == 0, "new policy has no role_perms")
    assert(len(r["role_parents"]) == 0, "new policy has no role_parents")
    assert(len(r["user_roles"]) == 0, "new policy has no user_roles")

    r = rbac_grant(r, "admin", "write")
    r = rbac_grant(r, "viewer", "read")
    r = rbac_inherit(r, "admin", "viewer")

    r = rbac_assign(r, "alice", "admin")
    r = rbac_assign(r, "bob", "viewer")

    assert(rbac_can(r, "alice", "write"), "alice can write (direct grant)")
    assert(rbac_can(r, "alice", "read"), "alice can read (inherited via viewer)")
    assert(not rbac_can(r, "bob", "write"), "bob cannot write")
    assert(rbac_can(r, "bob", "read"), "bob can read (direct grant)")
    assert(not rbac_can(r, "unknown", "read"), "unassigned user is denied")

    assert(rbac_has_role(r, "alice", "admin"), "alice directly holds admin")
    assert(not rbac_has_role(r, "alice", "viewer"), "alice does not directly hold viewer (only inherits it)")
    assert(not rbac_has_role(r, "unknown", "admin"), "unknown user holds no role")

    print("RBAC KAT PASS")
