import forge_deploy_pipeline

fn main()
    let dp = dpipe_new()
    dp = dpipe_add_stage(dp, "build")
    dp = dpipe_add_stage(dp, "test")
    dp = dpipe_add_stage(dp, "deploy")
    assert(dpipe_stage_count(dp) == 3, "3 stages")
    assert(dpipe_status(dp) == "idle", "idle")

    let r1 = dpipe_start(dp)
    dp = unwrap(r1)
    assert(dpipe_status(dp) == "running", "running")
    let cs = dpipe_current_stage(dp)
    assert(unwrap(cs) == "build", "at build")

    let r2 = dpipe_complete_stage(dp)
    dp = unwrap(r2)
    let cs2 = dpipe_current_stage(dp)
    assert(unwrap(cs2) == "test", "at test")

    let r3 = dpipe_complete_stage(dp)
    dp = unwrap(r3)
    let cs3 = dpipe_current_stage(dp)
    assert(unwrap(cs3) == "deploy", "at deploy")

    let r4 = dpipe_complete_stage(dp)
    dp = unwrap(r4)
    assert(dpipe_status(dp) == "success", "success")
    assert(dpipe_deploy_count(dp) == 1, "1 deploy")

    let ss = dpipe_stage_status(dp, "build")
    assert(unwrap(ss) == "passed", "build passed")

    let r5 = dpipe_start(dp)
    dp = unwrap(r5)
    let r6 = dpipe_fail_stage(dp, "test timeout")
    dp = unwrap(r6)
    assert(dpipe_status(dp) == "failed", "failed")
    assert(dpipe_fail_count(dp) == 1, "1 fail")

    let bad = dpipe_stage_status(dp, "nope")
    assert(is_err(bad), "no such stage")

    print("DEPLOY-PIPELINE KAT PASS")
