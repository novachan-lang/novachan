// LOCK-3 positive: an impl whose param + return TYPES match the trait signature must compile & run.
trait Shape
    fn area(self) -> float
    fn name(self) -> string
    fn scaled(self, factor: float) -> float

type Circle : Shape
    radius: float

fn Circle.area() -> float
    3.14159 * self.radius * self.radius
fn Circle.name() -> string
    "circle"
fn Circle.scaled(factor: float) -> float
    self.radius * factor

fn main()
    let c = Circle(5.0)
    print(c.name())
    print(str(c.area()))
    print(str(c.scaled(2.0)))
    print("_trait_sig_ok_test passed")
