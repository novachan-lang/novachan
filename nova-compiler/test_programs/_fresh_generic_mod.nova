// Fixture for finding #4 (cross-module generic freshening). These exports take a BARE
// type parameter — T is the parameter's OWN declared type, NOT laundered through a
// container like list<T>. Before the fix, the import loop registered these with a
// MONOMORPHIC scheme, so the first call pinned T to a concrete type and a second call
// at a different type failed type-check ("expected T, found <type>").
fn <T> fg_id(x: T) -> T
    x

fn <T> fg_pick(a: T, b: T, use_first: bool) -> T
    if use_first
        return a
    b
