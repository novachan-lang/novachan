import forge_tenant_manager

fn main()
    let t = tm_new()
    let r1 = tm_create(t, "acme", "pro")
    assert(is_ok(r1), "create ok")
    t = unwrap(r1)
    let r2 = tm_create(t, "globex", "free")
    t = unwrap(r2)
    assert(tm_tenant_count(t) == 2, "2 tenants")

    let dup = tm_create(t, "acme", "x")
    assert(is_err(dup), "duplicate tenant is err")

    let r3 = tm_set_quota(t, "acme", 100)
    t = unwrap(r3)

    let r4 = tm_use(t, "acme", 50)
    assert(is_ok(r4), "use 50 ok")
    t = unwrap(r4)
    assert(tm_usage(t, "acme") == 50, "50 used")

    let r5 = tm_use(t, "acme", 60)
    assert(is_err(r5), "quota exceeded")

    let plan = tm_plan(t, "globex")
    assert(unwrap(plan) == "free", "globex=free")

    let bad = tm_use(t, "unknown", 1)
    assert(is_err(bad), "unknown tenant is err")

    print("TENANT-MANAGER KAT PASS")
