import forge_version_vector

fn main()
    let v1 = vv_new()
    v1 = vv_increment(v1, "A")
    v1 = vv_increment(v1, "A")
    v1 = vv_increment(v1, "B")
    assert(vv_node_count(v1) == 2, "2 nodes")
    assert(vv_total_increments(v1) == 3, "3 increments")

    let ga = vv_get(v1, "A")
    assert(is_ok(ga), "get A ok")
    assert(unwrap(ga) == 2, "A=2")
    let gb = vv_get(v1, "B")
    assert(is_ok(gb), "get B ok")
    assert(unwrap(gb) == 1, "B=1")

    let bad = vv_get(v1, "C")
    assert(is_err(bad), "C not found")

    let v2 = vv_new()
    v2 = vv_increment(v2, "A")
    v2 = vv_increment(v2, "C")
    v2 = vv_increment(v2, "C")
    v2 = vv_increment(v2, "C")

    let merged = vv_merge(v1, v2)
    let ma = vv_get(merged, "A")
    assert(unwrap(ma) == 2, "merged A=2 (max)")
    let mc = vv_get(merged, "C")
    assert(unwrap(mc) == 3, "merged C=3")

    assert(vv_dominates(merged, v2) == 1, "merged dominates v2")
    assert(vv_dominates(v2, merged) == 0, "v2 does not dominate merged")

    print("VERSION-VECTOR KAT PASS")
