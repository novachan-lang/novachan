// rtti_any_test -- field_names/field_types/field_get work through `any` (a struct value whose static type
// is unknown, e.g. a forge fn introspecting an app struct cross-module). Triggered here via a dict-erased
// value (dict values are `any` -> the runtime registry path, identical codegen to the cross-module case).
// SOUNDNESS: a non-struct `any` returns empty/null without crashing; a float field round-trips (boxed).
type P
    name: string
    score: float
    n: int

fn main()
    let d = {}
    d["p"] = P("ada", 9.5, 7)
    let v = d["p"]

    let fns = field_names(v)
    assert(len(fns) == 3, "field_names n=3 (got " + str(len(fns)) + ")")
    assert(fns[0] == "name" and fns[1] == "score" and fns[2] == "n", "field_names in declaration order")

    let fts = field_types(v)
    assert(fts[0] == "string" and fts[1] == "float" and fts[2] == "int", "field_types correct")

    assert(field_get(v, "name") == "ada", "field_get string")
    assert(field_get(v, "n") == 7, "field_get int")
    let sc = field_get(v, "score")
    assert(sc > 9.49 and sc < 9.51, "field_get float boxed correctly")
    assert(field_get(v, "score") * 2.0 > 18.9 and field_get(v, "score") * 2.0 < 19.1, "field_get float arithmetic round-trips")
    print("PASS: struct RTTI through any (names/types/get incl float)")

    // non-struct any -> empty / null, NO crash (the wild-deref guard)
    let d2 = {}
    d2["x"] = 42
    let iv = d2["x"]
    assert(len(field_names(iv)) == 0, "non-struct field_names -> empty")
    assert(field_get(iv, "name") == 0, "non-struct field_get -> null")
    d2["s"] = "hello"
    assert(len(field_names(d2["s"])) == 0, "string field_names -> empty (no crash)")
    print("PASS: non-struct any -> empty/null, no crash")

    print("rtti_any_test passed")
