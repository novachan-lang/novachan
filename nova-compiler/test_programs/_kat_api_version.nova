import forge_api_version

fn main()
    let a = av_new()
    a = av_add_version(a, "v1", "handler_v1")
    a = av_add_version(a, "v2", "handler_v2")
    assert(av_version_count(a) == 2, "2 versions")
    assert(av_default_version(a) == "v1", "default=v1")

    let r1 = av_resolve(a, "v2")
    assert(is_ok(r1), "resolve v2")
    assert(unwrap(r1) == "handler_v2", "handler_v2")

    let r2 = av_resolve(a, "")
    assert(is_ok(r2), "resolve default")
    assert(unwrap(r2) == "handler_v1", "default handler")

    let r3 = av_set_default(a, "v2")
    assert(is_ok(r3), "set default ok")
    a = unwrap(r3)
    assert(av_default_version(a) == "v2", "default=v2")

    let r4 = av_deprecate(a, "v1")
    assert(is_ok(r4), "deprecate ok")
    a = unwrap(r4)
    assert(av_is_deprecated(a, "v1") == 1, "v1 deprecated")
    assert(av_is_deprecated(a, "v2") == 0, "v2 not deprecated")

    let bad = av_resolve(a, "v99")
    assert(is_err(bad), "unknown version is err")

    print("API-VERSION KAT PASS")
