import std/net/mqtt_connect

fn main()
    // ── Build CONNECT packet for client_id="cid", keepalive=60, clean=true ──
    let pkt = mqtt_connect("cid", 60, 1)

    // Total length check:
    // Fixed header: [0x10, 15] = 2 bytes
    // Var+payload:  [0,4,'M','Q','T','T',4,2,0,60,0,3,'c','i','d'] = 15 bytes
    // Total = 17 bytes
    if len(pkt) != 17
        print("FAIL mqtt_connect pkt len: got "+str(len(pkt))+" want 17")
        exit(1)

    // Fixed header byte0 = 0x10 (CONNECT type=1, flags=0)
    if pkt[0] != 16
        print("FAIL mqtt_connect byte0: got "+str(pkt[0])+" want 16 (0x10)")
        exit(1)

    // Fixed header remaining length = 15
    if pkt[1] != 15
        print("FAIL mqtt_connect remlen: got "+str(pkt[1])+" want 15")
        exit(1)

    // After fixed header (offset 2): variable header+payload
    // Expected: [0,4,'M','Q','T','T',4,2,0,60,0,3,'c','i','d']
    // offset 2: 0
    if pkt[2] != 0
        print("FAIL mqtt_connect var[0]: got "+str(pkt[2])+" want 0 (proto name len hi)")
        exit(1)
    // offset 3: 4
    if pkt[3] != 4
        print("FAIL mqtt_connect var[1]: got "+str(pkt[3])+" want 4 (proto name len lo)")
        exit(1)
    // offset 4: 'M' = 77
    if pkt[4] != 77
        print("FAIL mqtt_connect var[2] M: got "+str(pkt[4])+" want 77")
        exit(1)
    // offset 5: 'Q' = 81
    if pkt[5] != 81
        print("FAIL mqtt_connect var[3] Q: got "+str(pkt[5])+" want 81")
        exit(1)
    // offset 6: 'T' = 84
    if pkt[6] != 84
        print("FAIL mqtt_connect var[4] T: got "+str(pkt[6])+" want 84")
        exit(1)
    // offset 7: 'T' = 84
    if pkt[7] != 84
        print("FAIL mqtt_connect var[5] T: got "+str(pkt[7])+" want 84")
        exit(1)
    // offset 8: protocol level = 4
    if pkt[8] != 4
        print("FAIL mqtt_connect var[6] proto_level: got "+str(pkt[8])+" want 4")
        exit(1)
    // offset 9: connect flags = 2 (clean_session)
    if pkt[9] != 2
        print("FAIL mqtt_connect var[7] connect_flags: got "+str(pkt[9])+" want 2")
        exit(1)
    // offset 10: keepalive hi = 0
    if pkt[10] != 0
        print("FAIL mqtt_connect var[8] keepalive_hi: got "+str(pkt[10])+" want 0")
        exit(1)
    // offset 11: keepalive lo = 60
    if pkt[11] != 60
        print("FAIL mqtt_connect var[9] keepalive_lo: got "+str(pkt[11])+" want 60")
        exit(1)
    // offset 12: client_id len hi = 0
    if pkt[12] != 0
        print("FAIL mqtt_connect var[10] cid_len_hi: got "+str(pkt[12])+" want 0")
        exit(1)
    // offset 13: client_id len lo = 3
    if pkt[13] != 3
        print("FAIL mqtt_connect var[11] cid_len_lo: got "+str(pkt[13])+" want 3")
        exit(1)
    // offset 14: 'c' = 99
    if pkt[14] != 99
        print("FAIL mqtt_connect var[12] c: got "+str(pkt[14])+" want 99")
        exit(1)
    // offset 15: 'i' = 105
    if pkt[15] != 105
        print("FAIL mqtt_connect var[13] i: got "+str(pkt[15])+" want 105")
        exit(1)
    // offset 16: 'd' = 100
    if pkt[16] != 100
        print("FAIL mqtt_connect var[14] d: got "+str(pkt[16])+" want 100")
        exit(1)

    // ── Decode round-trip ─────────────────────────────────────────────────────
    let d = mqtt_connect_decode(pkt)
    if not contains(d, "client_id")
        print("FAIL mqtt_connect decode missing client_id")
        exit(1)
    if d["client_id"] != "cid"
        print("FAIL mqtt_connect decode client_id: got "+str(d["client_id"])+" want cid")
        exit(1)
    if d["keepalive"] != 60
        print("FAIL mqtt_connect decode keepalive: got "+str(d["keepalive"])+" want 60")
        exit(1)
    if d["clean"] != 1
        print("FAIL mqtt_connect decode clean: got "+str(d["clean"])+" want 1")
        exit(1)

    // ── clean_session=false test ───────────────────────────────────────────────
    let pkt2 = mqtt_connect("test", 30, 0)
    let d2 = mqtt_connect_decode(pkt2)
    if d2["clean"] != 0
        print("FAIL mqtt_connect decode clean=false: got "+str(d2["clean"])+" want 0")
        exit(1)
    if d2["client_id"] != "test"
        print("FAIL mqtt_connect decode client_id=test: got "+str(d2["client_id"])+" want test")
        exit(1)
    if d2["keepalive"] != 30
        print("FAIL mqtt_connect decode keepalive=30: got "+str(d2["keepalive"])+" want 30")
        exit(1)

    print("PASS _mqtt_connect_test")
