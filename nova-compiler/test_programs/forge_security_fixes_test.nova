// forge_security_fixes_test -- guards for the core-security review fixes:
//  - WS frame decoder rejects oversize/fragmented control frames, reserved opcodes, and RSV bits (1002)
//  - WS decoder still accepts well-formed frames (no false rejection)
//  - multipart parser rejects a part whose header carries an embedded NUL (name/filename confusion)
import forge

fn _b(s: string)
    let n = len(s)
    let out = bytes(0)
    let i = 0
    while i < n
        out = bytes_append(out, ord(char_at(s, i)))
        i = i + 1
    out

// build a multipart body for boundary B; if nul=1, embed a NUL inside the part header.
fn _mp(boundary: string, nul: int)
    let b = str_to_bytes("--" + boundary + "\r\nContent-Disposition: form-data; name=" + chr(34) + "a" + chr(34))
    if nul == 1
        b = bytes_append(b, 0)
        b = bytes_concat(b, str_to_bytes("evil"))
    b = bytes_concat(b, str_to_bytes("\r\n\r\nVAL\r\n--" + boundary + "--\r\n"))
    b

fn main()
    let mask = [1, 2, 3, 4]

    // valid frame still decodes
    let ok = forge.ws_try_decode(forge.ws_encode_frame(1, 1, _b("hi"), mask), 0)
    assert(ok.status == 1, "well-formed text frame decodes (status 1)")
    assert(bytes_to_str(ok.payload) == "hi", "payload intact")
    print("PASS: valid frame accepted")

    // oversize control frame (ping, 200 bytes -> len7=126) -> protocol error 1002
    let big = forge.ws_try_decode(forge.ws_encode_frame(1, 9, bytes(200), mask), 0)
    assert(big.status == 0 - 1002, "oversize control frame rejected (1002)")
    print("PASS: oversize control frame rejected")

    // fragmented control frame (ping, FIN=0) -> 1002
    let frag = forge.ws_try_decode(forge.ws_encode_frame(0, 9, _b("x"), mask), 0)
    assert(frag.status == 0 - 1002, "fragmented control frame rejected (1002)")
    print("PASS: fragmented control frame rejected")

    // reserved opcode (3) -> 1002
    let resv = forge.ws_try_decode(forge.ws_encode_frame(1, 3, _b("x"), mask), 0)
    assert(resv.status == 0 - 1002, "reserved opcode rejected (1002)")
    print("PASS: reserved opcode rejected")

    // RSV1 bit set on an otherwise-valid frame -> 1002
    let rf = forge.ws_encode_frame(1, 1, _b("hi"), mask)
    bytes_set(rf, 0, bytes_get(rf, 0) | 64)
    let rsv = forge.ws_try_decode(rf, 0)
    assert(rsv.status == 0 - 1002, "RSV bit set rejected (1002)")
    print("PASS: RSV bit rejected")

    // multipart: a clean body parses to one part; a NUL in the header is rejected
    let clean = forge.parse_multipart(_mp("BND", 0), "BND")
    assert(len(clean) == 1, "clean multipart parses one part")
    let dirty = forge.parse_multipart(_mp("BND", 1), "BND")
    assert(len(dirty) == 0, "multipart part with NUL in header is rejected")
    print("PASS: multipart NUL-header rejection")
    print("forge_security_fixes_test passed")
