import std/time/period

fn main()
    // ── period_add_months ────────────────────────────────────────────────────

    // KAT 1: Jan 31 + 1 month → Feb 29 (2024 is a leap year, clamp)
    let r1 = period_add_months(2024, 1, 31, 1)
    if r1[0] != 2024 or r1[1] != 2 or r1[2] != 29
        print("FAIL period add_months leap clamp: got " + str(r1[0]) + "-" + str(r1[1]) + "-" + str(r1[2]) + " want 2024-2-29")
        exit(1)

    // KAT 2: Jan 31 + 1 month in non-leap year → Feb 28 (2023)
    let r2 = period_add_months(2023, 1, 31, 1)
    if r2[0] != 2023 or r2[1] != 2 or r2[2] != 28
        print("FAIL period add_months non-leap clamp: got " + str(r2[0]) + "-" + str(r2[1]) + "-" + str(r2[2]) + " want 2023-2-28")
        exit(1)

    // KAT 3: Dec 15 + 2 months → Feb 15 next year
    let r3 = period_add_months(2024, 12, 15, 2)
    if r3[0] != 2025 or r3[1] != 2 or r3[2] != 15
        print("FAIL period add_months year-wrap: got " + str(r3[0]) + "-" + str(r3[1]) + "-" + str(r3[2]) + " want 2025-2-15")
        exit(1)

    // KAT 4: No-clamp case: Mar 31 + 1 → Apr 30
    let r4 = period_add_months(2024, 3, 31, 1)
    if r4[0] != 2024 or r4[1] != 4 or r4[2] != 30
        print("FAIL period add_months apr-clamp: got " + str(r4[0]) + "-" + str(r4[1]) + "-" + str(r4[2]) + " want 2024-4-30")
        exit(1)

    // KAT 5: Large addition — Jan 15 + 25 months → Feb 15 two years later
    let r5 = period_add_months(2023, 1, 15, 25)
    if r5[0] != 2025 or r5[1] != 2 or r5[2] != 15
        print("FAIL period add_months large: got " + str(r5[0]) + "-" + str(r5[1]) + "-" + str(r5[2]) + " want 2025-2-15")
        exit(1)

    // KAT 6: Negative months — March 15 - 2 months → January 15
    let r6 = period_add_months(2024, 3, 15, -2)
    if r6[0] != 2024 or r6[1] != 1 or r6[2] != 15
        print("FAIL period add_months negative: got " + str(r6[0]) + "-" + str(r6[1]) + "-" + str(r6[2]) + " want 2024-1-15")
        exit(1)

    // ── period_add_years ─────────────────────────────────────────────────────

    // KAT 7: Feb 29 (leap) + 1 year → Feb 28 (non-leap clamp)
    let r7 = period_add_years(2024, 2, 29, 1)
    if r7[0] != 2025 or r7[1] != 2 or r7[2] != 28
        print("FAIL period add_years non-leap clamp: got " + str(r7[0]) + "-" + str(r7[1]) + "-" + str(r7[2]) + " want 2025-2-28")
        exit(1)

    // KAT 8: Feb 29 (leap) + 4 years → Feb 29 (next leap year, no clamp)
    let r8 = period_add_years(2024, 2, 29, 4)
    if r8[0] != 2028 or r8[1] != 2 or r8[2] != 29
        print("FAIL period add_years leap-to-leap: got " + str(r8[0]) + "-" + str(r8[1]) + "-" + str(r8[2]) + " want 2028-2-29")
        exit(1)

    // KAT 9: Normal date no clamp
    let r9 = period_add_years(2023, 6, 15, 3)
    if r9[0] != 2026 or r9[1] != 6 or r9[2] != 15
        print("FAIL period add_years normal: got " + str(r9[0]) + "-" + str(r9[1]) + "-" + str(r9[2]) + " want 2026-6-15")
        exit(1)

    // ── period_diff_months ───────────────────────────────────────────────────

    // KAT 10: 6 whole months between same-day boundaries
    let diff1 = period_diff_months(2024, 1, 15, 2024, 7, 15)
    if diff1 != 6
        print("FAIL period diff_months 6mo: got " + str(diff1) + " want 6")
        exit(1)

    // KAT 11: Day not yet reached → one month fewer
    let diff2 = period_diff_months(2024, 1, 20, 2024, 7, 15)
    if diff2 != 5
        print("FAIL period diff_months day-not-reached: got " + str(diff2) + " want 5")
        exit(1)

    // KAT 12: Cross year boundary
    let diff3 = period_diff_months(2023, 11, 1, 2025, 3, 1)
    if diff3 != 16
        print("FAIL period diff_months cross-year: got " + str(diff3) + " want 16")
        exit(1)

    // KAT 13: Negative diff (date2 before date1)
    let diff4 = period_diff_months(2024, 7, 15, 2024, 1, 15)
    if diff4 != -6
        print("FAIL period diff_months negative: got " + str(diff4) + " want -6")
        exit(1)

    // ── period_add_days ──────────────────────────────────────────────────────

    // KAT 14: Feb 28 + 2 days in leap year → Mar 1
    let r14 = period_add_days(2024, 2, 28, 2)
    if r14[0] != 2024 or r14[1] != 3 or r14[2] != 1
        print("FAIL period add_days leap-cross: got " + str(r14[0]) + "-" + str(r14[1]) + "-" + str(r14[2]) + " want 2024-3-1")
        exit(1)

    // KAT 15: Year end wrap Dec 30 + 5 days → Jan 4 next year
    let r15 = period_add_days(2024, 12, 30, 5)
    if r15[0] != 2025 or r15[1] != 1 or r15[2] != 4
        print("FAIL period add_days year-wrap: got " + str(r15[0]) + "-" + str(r15[1]) + "-" + str(r15[2]) + " want 2025-1-4")
        exit(1)

    // KAT 16: Negative days — Jan 3 - 5 days → Dec 29 prior year
    let r16 = period_add_days(2024, 1, 3, -5)
    if r16[0] != 2023 or r16[1] != 12 or r16[2] != 29
        print("FAIL period add_days negative: got " + str(r16[0]) + "-" + str(r16[1]) + "-" + str(r16[2]) + " want 2023-12-29")
        exit(1)

    // ── Round-trip: add_months then undo ─────────────────────────────────────

    // KAT 17: round-trip: add 13 months then subtract 13 months → same date
    let orig_y = 2024
    let orig_m = 5
    let orig_d = 15
    let fwd = period_add_months(orig_y, orig_m, orig_d, 13)
    let back = period_add_months(fwd[0], fwd[1], fwd[2], -13)
    if back[0] != orig_y or back[1] != orig_m or back[2] != orig_d
        print("FAIL period round-trip months: got " + str(back[0]) + "-" + str(back[1]) + "-" + str(back[2]) + " want 2024-5-15")
        exit(1)

    // KAT 18: round-trip add_days: +365 -365 = same date (non-leap year start)
    let base = period_add_days(2023, 3, 1, 365)
    let ret = period_add_days(base[0], base[1], base[2], -365)
    if ret[0] != 2023 or ret[1] != 3 or ret[2] != 1
        print("FAIL period round-trip days: got " + str(ret[0]) + "-" + str(ret[1]) + "-" + str(ret[2]) + " want 2023-3-1")
        exit(1)

    print("PASS _period_test")
