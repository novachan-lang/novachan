import forge_hmac_signer

fn main()
    let sig1 = hmac_sign("mykey", "hello")
    let sig2 = hmac_sign("mykey", "hello")
    assert(sig1 == sig2, "deterministic")

    let sig3 = hmac_sign("mykey", "world")
    assert(sig1 != sig3, "different messages")

    let r1 = hmac_verify("mykey", "hello", sig1)
    assert(is_ok(r1), "verify ok")

    let r2 = hmac_verify("mykey", "hello", 99999)
    assert(is_err(r2), "bad sig")

    let ts_sig = hmac_sign_with_timestamp("key", "msg", 1000)
    let r3 = hmac_verify_with_timestamp("key", "msg", 1000, ts_sig, 1050, 60)
    assert(is_ok(r3), "ts verify ok")

    let r4 = hmac_verify_with_timestamp("key", "msg", 1000, ts_sig, 1100, 60)
    assert(is_err(r4), "expired")

    print("HMAC-SIGNER KAT PASS")
