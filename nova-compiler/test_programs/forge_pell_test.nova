import forge_pell as pl

fn check(cond: bool, label: string)
    if cond == false
        print("FAIL: " + label)

fn main()
    // ---- fundamental solutions (known values) ----
    // D=2 -> (3,2): 9-2*4=1
    let s2 = pl.pell_fundamental(2)
    check(len(s2) == 2 and s2[0] == 3 and s2[1] == 2, "pell 2 -> (3,2)")
    // D=3 -> (2,1)
    let s3 = pl.pell_fundamental(3)
    check(len(s3) == 2 and s3[0] == 2 and s3[1] == 1, "pell 3 -> (2,1)")
    // D=5 -> (9,4)
    let s5 = pl.pell_fundamental(5)
    check(len(s5) == 2 and s5[0] == 9 and s5[1] == 4, "pell 5 -> (9,4)")
    // D=6 -> (5,2)
    let s6 = pl.pell_fundamental(6)
    check(len(s6) == 2 and s6[0] == 5 and s6[1] == 2, "pell 6 -> (5,2)")
    // D=7 -> (8,3)
    let s7 = pl.pell_fundamental(7)
    check(len(s7) == 2 and s7[0] == 8 and s7[1] == 3, "pell 7 -> (8,3)")
    // D=13 -> (649,180)
    let s13 = pl.pell_fundamental(13)
    check(len(s13) == 2 and s13[0] == 649 and s13[1] == 180, "pell 13 -> (649,180)")
    // D=61 -> (1766319049, 226153980) -- famous large fundamental solution
    let s61 = pl.pell_fundamental(61)
    check(len(s61) == 2 and s61[0] == 1766319049 and s61[1] == 226153980, "pell 61 -> big")

    // ---- perfect squares & non-positive: no solution ----
    check(len(pl.pell_fundamental(4)) == 0, "pell 4 (square) -> none")
    check(len(pl.pell_fundamental(9)) == 0, "pell 9 (square) -> none")
    check(len(pl.pell_fundamental(1)) == 0, "pell 1 (square) -> none")
    check(len(pl.pell_fundamental(0)) == 0, "pell 0 -> none")

    // ---- every fundamental solution must actually satisfy the equation ----
    let d = 2
    while d <= 60
        let a = 1
        // skip perfect squares
        while a * a < d
            a = a + 1
        if a * a != d
            let sol = pl.pell_fundamental(d)
            check(len(sol) == 2, "pell " + str(d) + " has solution")
            check(pl.pell_check(d, sol[0], sol[1]), "pell " + str(d) + " satisfies eq")
            check(sol[0] > 0 and sol[1] > 0, "pell " + str(d) + " positive")
        d = d + 1

    // ---- generated solutions all satisfy the equation ----
    let gens = pl.pell_solutions(2, 5)
    check(len(gens) == 10, "5 solutions for D=2")
    let i = 0
    while i < len(gens)
        check(pl.pell_check(2, gens[i], gens[i + 1]), "gen D=2 sol satisfies idx " + str(i))
        i = i + 2
    // first generated is the fundamental
    check(gens[0] == 3 and gens[1] == 2, "gen[0] == fundamental (3,2)")
    // second solution for D=2 is (17,12): 289-2*144=289-288=1
    check(gens[2] == 17 and gens[3] == 12, "gen[1] == (17,12)")

    // generated solutions for D=3: (2,1),(7,4),(26,15)
    let g3 = pl.pell_solutions(3, 3)
    check(g3[0] == 2 and g3[1] == 1, "D=3 sol1 (2,1)")
    check(g3[2] == 7 and g3[3] == 4, "D=3 sol2 (7,4)")
    check(g3[4] == 26 and g3[5] == 15, "D=3 sol3 (26,15)")

    print("forge_pell: all passed")
