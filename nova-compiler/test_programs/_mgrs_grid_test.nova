import std/geo/mgrs_grid

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // mg_normalize
    let norm1 = mg_normalize("32u pu 91 45")
    cks("normalize", norm1, "32UPU9145")

    // mg_is_valid
    ckb("is_valid(32UPU9145)", mg_is_valid("32UPU9145"), true)
    ckb("is_valid(32IPU9145)", mg_is_valid("32IPU9145"), false)
    ckb("is_valid(4QFJ1267)", mg_is_valid("4QFJ1267"), true)
    ckb("is_valid(empty)", mg_is_valid(""), false)
    ckb("is_valid(bad_odd_digits)", mg_is_valid("32UPU914"), false)

    // mg_parse for '32UPU9145'
    let p1 = mg_parse("32UPU9145")
    cki("parse.zone", p1["zone"], 32)
    cks("parse.band", p1["band"], "U")
    cks("parse.square", p1["square"], "PU")
    cki("parse.easting", p1["easting"], 91)
    cki("parse.northing", p1["northing"], 45)
    cki("parse.precision", p1["precision"], 2)

    // mg_format round-trip
    let fmt1 = mg_format(32, "U", "PU", 91, 45, 2)
    cks("format(32,U,PU,91,45,2)", fmt1, "32UPU9145")

    // round-trip: parse then format
    let rt_parsed = mg_parse("32UPU9145")
    let rt_zone = rt_parsed["zone"]
    let rt_band = rt_parsed["band"]
    let rt_sq = rt_parsed["square"]
    let rt_e = rt_parsed["easting"]
    let rt_n = rt_parsed["northing"]
    let rt_pr = rt_parsed["precision"]
    let rt_fmt = mg_format(rt_zone, rt_band, rt_sq, rt_e, rt_n, rt_pr)
    cks("roundtrip(32UPU9145)", rt_fmt, "32UPU9145")

    // mg_zone
    cki("zone(4QFJ1267)", mg_zone("4QFJ1267"), 4)
    cki("zone(32UPU9145)", mg_zone("32UPU9145"), 32)

    // mg_band
    cks("band(32UPU9145)", mg_band("32UPU9145"), "U")
    cks("band(4QFJ1267)", mg_band("4QFJ1267"), "Q")

    // mg_square
    cks("square(32UPU9145)", mg_square("32UPU9145"), "PU")
    cks("square(4QFJ1267)", mg_square("4QFJ1267"), "FJ")

    // mg_precision (metres from digit count)
    // 2 digits per coord -> 10^(5-2) = 1000m
    cki("precision(32UPU9145)", mg_precision("32UPU9145"), 1000)
    // 4QFJ1267: digits="1267" len=4, half=2 => 1000m
    cki("precision(4QFJ1267)", mg_precision("4QFJ1267"), 1000)

    // mg_easting_northing
    let en1 = mg_easting_northing("32UPU9145")
    cki("en.easting(32UPU9145)", en1[0], 91)
    cki("en.northing(32UPU9145)", en1[1], 45)

    // mg_format with padding
    let fmt2 = mg_format(4, "Q", "FJ", 12, 67, 2)
    cks("format(4,Q,FJ,12,67,2)", fmt2, "4QFJ1267")

    // mg_format with single-digit values (needs zero-pad)
    let fmt3 = mg_format(32, "U", "PU", 9, 4, 2)
    cks("format_pad(32,U,PU,9,4,2)", fmt3, "32UPU0904")

    // mg_format precision 1 (10km)
    let fmt4 = mg_format(33, "T", "WG", 5, 3, 1)
    cks("format_p1", fmt4, "33TWG53")

    // mg_format precision 0 (100km, no digits)
    let fmt5 = mg_format(33, "T", "WG", 0, 0, 0)
    cks("format_p0", fmt5, "33TWG")

    // 5-digit precision round-trip
    let p5 = mg_parse("33TWG0579012345")
    let p5_valid = p5["valid"]
    cki("parse_p5_valid", p5_valid, 1)
    let p5_pr = p5["precision"]
    cki("parse_p5_precision", p5_pr, 5)
    let p5_e = p5["easting"]
    let p5_n = p5["northing"]
    cki("parse_p5_easting", p5_e, 5790)
    cki("parse_p5_northing", p5_n, 12345)
    let rt5 = mg_format(33, "T", "WG", 5790, 12345, 5)
    cks("roundtrip_p5", rt5, "33TWG0579012345")

    print("PASS _mgrs_grid_test")
