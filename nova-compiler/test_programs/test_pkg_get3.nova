fn nova_parse_toml_deps(content: string) -> dict
    let deps = {}
    deps

fn nova_pkg_get(pkg_spec: string)
    let pkg_name = pkg_spec
    let pkg_version = "*"
    let at_pos = find(pkg_spec, "@")
    if at_pos >= 0
        pkg_name = slice(pkg_spec, 0, at_pos)
        pkg_version = slice(pkg_spec, at_pos + 1, len(pkg_spec))
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found")
        exit(1)
    let deps = nova_parse_toml_deps(toml)
    if contains(deps, pkg_name)
        let existing_ver = deps[pkg_name]
        print(f"Package '{pkg_name}' already in deps (version {existing_ver})")
        return 0
    let dep_line = pkg_name + " = \"" + pkg_version + "\"\n"
    print(dep_line)

fn main()
    print("test done")
