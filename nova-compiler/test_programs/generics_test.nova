// ── NOVA Generics Comprehensive Test ──────────────────────────────

// Test 1: Generic identity function
fn<T> identity(x: T) -> T
    return x

let a = identity(42)
let b = identity("hello")
let c = identity(true)
print(a)
print(b)
print(c)

// Test 2: Generic wrap/unwrap
fn<T> wrap(val: T) -> List<T>
    return [val]

let w = wrap(99)
print(w[0])

// Test 3: Generic higher-order function
fn<A, B> apply_fn(f, x: A) -> B
    return f(x)

let double = fn(x) x * 2
let d = apply_fn(double, 21)
print(d)

// Test 4: Generic struct (Pair)
type Pair<A, B>
    first: A
    second: B

let p1 = Pair(10, "ten")
print(p1.first)
print(p1.second)

// Test 5: Generic struct with same types
let p2 = Pair("hello", "world")
print(p2.first)
print(p2.second)

// Test 6: Generic struct (Box)
type Box<T>
    value: T

let bi = Box(42)
print(bi.value)

let bs = Box("boxed")
print(bs.value)

// Test 7: Nested generic structs
let nested = Box(Pair(1, 2))
print(nested.value.first)
print(nested.value.second)

// Test 8: Generic function returning generic struct
fn<T> make_box(x: T) -> Box<T>
    return Box(x)

let mb1 = make_box(777)
print(mb1.value)

let mb2 = make_box("packed")
print(mb2.value)

// Test 9: Multiple generic instantiations in same scope
let r1 = identity(1)
let r2 = identity("two")
let r3 = identity(3)
let r4 = identity("four")
print(r1)
print(r2)
print(r3)
print(r4)

// Test 10: Generic function with List operations
fn<T> first_elem(xs: List<T>) -> T
    return xs[0]

fn<T> last_elem(xs: List<T>) -> T
    return xs[len(xs) - 1]

print(first_elem([10, 20, 30]))
print(last_elem([10, 20, 30]))
print(first_elem(["alpha", "beta"]))
print(last_elem(["alpha", "beta"]))

// Expected output:
// 42
// hello
// true
// 99
// 42
// 10
// ten
// hello
// world
// 42
// boxed
// 1
// 2
// 777
// packed
// 1
// two
// 3
// four
// 10
// 30
// alpha
// beta
