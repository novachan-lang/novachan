fn<T> identity(x: T) -> T
    return x

fn<T> wrap(val: T) -> List<T>
    return [val]

fn<A, B> apply_fn(f, x: A) -> B
    return f(x)

type Pair<A, B>
    first: A
    second: B

let a = identity(42)
let b = identity("hello")
print(a)
print(b)

let w = wrap(99)
print(w[0])

let double = fn(x) x * 2
let c = apply_fn(double, 21)
print(c)

let p = Pair(10, "ten")
print(p.first)
print(p.second)
