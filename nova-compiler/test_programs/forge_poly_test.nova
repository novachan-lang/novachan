import forge_poly

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn near(a: float, b: float) -> bool
    let d = a - b
    d > -0.001 and d < 0.001

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // eval: 1 + 2x + 3x^2 at x=2 -> 1+4+12 = 17
    fails = fails + expect_true("eval_17", near(poly_eval([1, 2, 3], 2), 17.0))
    // x^2 at x=5 -> 25
    fails = fails + expect_true("eval_25", near(poly_eval([0, 0, 1], 5), 25.0))
    // constant
    fails = fails + expect_true("eval_const", near(poly_eval([7], 100), 7.0))
    // at x=0 -> a0
    fails = fails + expect_true("eval_zero", near(poly_eval([3, 9, 2], 0), 3.0))
    // negative x: 1 - x + x^2 at x=-1 -> 1+1+1=3
    fails = fails + expect_true("eval_neg", near(poly_eval([1, 0 - 1, 1], 0 - 1), 3.0))

    // degree
    fails = fails + expect("degree", str(poly_degree([1, 2, 3])), "2")
    fails = fails + expect("degree_padded", str(poly_degree([1, 2, 0, 0])), "1")
    fails = fails + expect("degree_const", str(poly_degree([5])), "0")

    // add: (1+2x) + (3+4x+5x^2) = 4+6x+5x^2
    fails = fails + expect("add", join_ints(poly_add([1, 2], [3, 4, 5])), "4,6,5")

    // multiply: (x+1)^2 = x^2+2x+1 -> [1,2,1]
    fails = fails + expect("mul_square", join_ints(poly_mul([1, 1], [1, 1])), "1,2,1")
    // (x+1)(x-1) = x^2-1 -> [-1,0,1]
    fails = fails + expect("mul_diff", join_ints(poly_mul([1, 1], [0 - 1, 1])), "-1,0,1")
    // (2+3x)(4) = 8+12x
    fails = fails + expect("mul_scalar", join_ints(poly_mul([2, 3], [4])), "8,12")

    // derivative: d/dx (5 + 3x + 2x^2) = 3 + 4x -> [3,4]
    fails = fails + expect("deriv", join_ints(poly_derivative([5, 3, 2])), "3,4")
    fails = fails + expect("deriv_const", str(len(poly_derivative([7]))), "0")

    // scale
    fails = fails + expect("scale", join_ints(poly_scale([1, 2, 3], 2)), "2,4,6")

    // eval(mul) == eval*eval : (x+1)^2 at x=3 -> 16 (from coeffs) = poly_eval([1,2,1],3)
    fails = fails + expect_true("mul_eval", near(poly_eval(poly_mul([1, 1], [1, 1]), 3), 16.0))

    if fails == 0
        print("forge_poly: all passed")
    else
        print("forge_poly: " + str(fails) + " FAILED")
