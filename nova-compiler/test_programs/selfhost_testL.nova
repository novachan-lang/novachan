// Test: dicts, contains, nested control flow
fn count_chars(s: string) -> dict
    let counts = {}
    let i = 0
    while i < len(s)
        let ch = s[i]
        if contains(counts, ch)
            counts[ch] = counts[ch] + 1
        else
            counts[ch] = 1
        i = i + 1
    return counts

let result = count_chars("hello world")
print(result["l"])
print(result["o"])
print(result["h"])
print(len(result))
