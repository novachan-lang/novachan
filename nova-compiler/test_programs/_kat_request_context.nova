import forge_request_context

fn main()
    let c = ctx_new("req-abc-123")
    assert(ctx_request_id(c) == "req-abc-123", "request id")
    assert(ctx_size(c) == 0, "starts empty")
    assert(ctx_is_cancelled(c) == 0, "not cancelled")

    c = ctx_set(c, "user_id", "42")
    c = ctx_set(c, "role", "admin")
    assert(ctx_get(c, "user_id") == "42", "get user_id")
    assert(ctx_has(c, "role") == 1, "has role")
    assert(ctx_has(c, "missing") == 0, "no missing")
    assert(ctx_get(c, "missing") == "", "get missing empty")
    assert(ctx_size(c) == 2, "2 values")

    c = ctx_set_start(c, 1000)
    let elapsed = ctx_elapsed(c, 1250)
    assert(elapsed == 250, "250ms elapsed")

    c = ctx_cancel(c)
    assert(ctx_is_cancelled(c) == 1, "cancelled")

    print("REQUEST-CONTEXT KAT PASS")
