// KAT for std/text/slug — URL slugify.
import std/text/slug

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("hello", slugify("Hello, World!"), "hello-world")
    cks("spaces", slugify("  multiple   spaces  "), "multiple-spaces")
    cks("already", slugify("already-a-slug"), "already-a-slug")
    cks("mixed", slugify("Foo_Bar Baz"), "foo-bar-baz")
    cks("symbols", slugify("C++ & Rust!"), "c-rust")
    cks("trim", slugify("---trim---"), "trim")
    cks("empty", slugify(""), "")
    cks("upper", slugify("UPPER123"), "upper123")
    print("_slug_test passed")
