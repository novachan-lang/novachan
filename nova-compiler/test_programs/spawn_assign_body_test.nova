// Regression: the ASSIGNED spawn form `p = spawn fn() <body>` must run the body IN
// the spawned Process (not on the main thread). Verified two ways: (1) a value the
// body sends arrives; (2) a panic in the body is CONTAINED (monitor sees status 1),
// which is only possible if the body ran inside the Process's fault boundary.

done = channel()
p = spawn fn()
    send(done, 7)
m = monitor(p)
assert_eq(receive(done), 7)
assert_eq(receive(m), 0)

pc = spawn fn()
    panic("body ran in process")
mc = monitor(pc)
assert_eq(receive(mc), 1)

print("spawn assign body passed")
