// KAT test for std/game/maze_kruskals
// Structural validation: edge_count == w*h-1, fully connected, deterministic.

import std/game/maze_kruskals

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL maze_kruskals " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// edge_count: sum of len(links[c]) for all c, divided by 2.
// Each passage is stored at both endpoints, so the total / 2 = actual edge count.
fn _edge_count(links: list) -> int
    let total = len(links)
    let s = 0
    let i = 0
    while i < total
        s = s + len(links[i])
        i = i + 1
    s / 2

// _bfs_visited: BFS from cell 0 following links; returns number of cells visited.
// Uses a queue implemented as a list with a head pointer.
// Bound: at most total = w*h iterations (perfect maze visits all).
fn _bfs_visited(links: list) -> int
    let total = len(links)
    // visited array: 0=unvisited, 1=visited
    let vis = []
    let vi = 0
    while vi < total
        vis = vis + [0]
        vi = vi + 1
    // queue as list; head index
    let q = [0]
    vis[0] = 1
    let head = 0
    let count = 1
    // bound loop to total*total to be safe (BFS visits each edge once)
    let iters = 0
    let maxiters = total * total
    while head < len(q) and iters < maxiters
        let cur = q[head]
        head = head + 1
        let nb = links[cur]
        let nlen = len(nb)
        let ni = 0
        while ni < nlen
            let nc = nb[ni]
            if vis[nc] == 0
                vis[nc] = 1
                push(q, nc)
                count = count + 1
            ni = ni + 1
        iters = iters + 1
    count

// _links_equal: check two adjacency-list mazes are identical.
// Compares sorted neighbor lists for each cell (order may differ between calls).
// Uses a simple insertion sort on small neighbor lists.
fn _sort_small(xs: list) -> list
    let n = len(xs)
    let buf = []
    let ii = 0
    while ii < n
        buf = buf + [xs[ii]]
        ii = ii + 1
    let oi = 0
    while oi < n
        let ij = oi + 1
        while ij < n
            if buf[oi] > buf[ij]
                let tmp = buf[oi]
                buf[oi] = buf[ij]
                buf[ij] = tmp
            ij = ij + 1
        oi = oi + 1
    buf

fn _links_equal(a: list, b: list) -> int
    if len(a) != len(b)
        return 0
    let n = len(a)
    let i = 0
    while i < n
        let sa = _sort_small(a[i])
        let sb = _sort_small(b[i])
        if len(sa) != len(sb)
            return 0
        let j = 0
        while j < len(sa)
            if sa[j] != sb[j]
                return 0
            j = j + 1
        i = i + 1
    1

// ── KAT 1: gen(6,6,42) -> edge_count==35 and connected ──────────────────────
let links66 = gen(6, 6, 42)
let ec66 = _edge_count(links66)
cki("kat1_6x6_edge_count", ec66, 35)
let vis66 = _bfs_visited(links66)
cki("kat1_6x6_connected", vis66, 36)

// ── KAT 2: gen(4,4,3) -> edge_count==15 and connected ───────────────────────
let links44 = gen(4, 4, 3)
let ec44 = _edge_count(links44)
cki("kat2_4x4_edge_count", ec44, 15)
let vis44 = _bfs_visited(links44)
cki("kat2_4x4_connected", vis44, 16)

// ── KAT 3: gen(3,5,9) -> edge_count==14 and connected ───────────────────────
let links35 = gen(3, 5, 9)
let ec35 = _edge_count(links35)
cki("kat3_3x5_edge_count", ec35, 14)
let vis35 = _bfs_visited(links35)
cki("kat3_3x5_connected", vis35, 15)

// ── KAT 4: determinism -- gen(6,6,42) called twice is identical ──────────────
let links66b = gen(6, 6, 42)
let det_ok = _links_equal(links66, links66b)
cki("kat4_determinism_6x6", det_ok, 1)

// ── KAT 5: determinism -- gen(4,4,3) called twice is identical ───────────────
let links44b = gen(4, 4, 3)
let det44_ok = _links_equal(links44, links44b)
cki("kat5_determinism_4x4", det44_ok, 1)

print("PASS _maze_kruskals_test")
