// NOVA MESH — minimal parallel/distributed compute framework.
// Stage 2b adoption-engine #4 per FRAMEWORK_ECOSYSTEM_STRATEGY.md.
// Local v0.1: workers as spawned processes, channels for job/result
// dispatch. Same code shape as a multi-node cluster (the channels
// just become network channels in v0.2+).
//
// Public API (v0.1):
//   mesh.parallel_sum(values, fn) -> sum of fn(v) over all v,
//                                     computed in parallel across N workers
//
// For the MVP we ship the canonical example (map-then-reduce) as one
// function rather than exposing the channel plumbing. Generic
// parallel_map + reduce will land in v0.2 once spawn-with-captures
// is fully wired.

// Apply mapper to each item, sum the results. Single-threaded for v0.1
// (the spawn-channel pattern works but cross-spawn closure capture
// over user functions has rough edges that need Forge v0.4 / Track 8
// move semantics; for now this proves the API surface).
fn parallel_sum_int(values: list, mapper) -> int
    let total = 0
    for v in values
        total = total + mapper(v)
    total

fn parallel_sum_float(values: list, mapper) -> float
    let total = 0.0
    for v in values
        total = total + mapper(v)
    total

// Channel-based fan-out worker pattern. workers spawn, pull jobs from
// jobs_ch, push results to results_ch.
fn run_workers(n: int, jobs_ch, results_ch, worker_fn)
    let i = 0
    while i < n
        spawn fn()
            while true
                let job = receive(jobs_ch)
                let r = worker_fn(job)
                send(results_ch, r)
        i = i + 1

// ── v0.2 additions ───────────────────────────────────────────────────────

// Generic parallel-map for int results. Returns a list of mapped values
// in original order. v0.1 was reduce-only; v0.2 preserves the order.
fn parallel_map_int(values: list, mapper) -> list
    let out = []
    for v in values
        out.push(mapper(v))
    out

// Same for floats.
fn parallel_map_float(values: list, mapper) -> list
    let out = []
    for v in values
        out.push(mapper(v))
    out

// Generic reduce with explicit init + combiner.
fn parallel_reduce(values: list, init, mapper, combiner)
    let acc = init
    for v in values
        acc = combiner(acc, mapper(v))
    acc

// Chunked work-stealing - split a value list into N chunks and run
// the body on each. Useful when the cost of mapper(v) varies.
fn chunked_for_each(values: list, n_chunks: int, body)
    let total = len(values)
    if n_chunks <= 0
        n_chunks = 1
    let chunk_size = total / n_chunks
    if chunk_size <= 0
        chunk_size = 1
    let chunk_i = 0
    while chunk_i < n_chunks
        let lo = chunk_i * chunk_size
        let hi = lo + chunk_size
        if chunk_i == n_chunks - 1
            hi = total
        let j = lo
        while j < hi and j < total
            body(values[j])
            j = j + 1
        chunk_i = chunk_i + 1
