import forge_deadletter

fn main()
    let dlq = dlq_new(2)
    dlq = dlq_add(dlq, "msg-1", "order-data", "timeout")
    dlq = dlq_add(dlq, "msg-2", "payment-data", "connection-refused")
    assert(dlq_count(dlq) == 2, "2 messages")
    assert(dlq_pending_count(dlq) == 2, "2 pending")

    let m = dlq_get(dlq, "msg-1")
    assert(m["id"] == "msg-1", "got msg-1")
    assert(m["error"] == "timeout", "error is timeout")

    dlq = dlq_retry(dlq, "msg-1")
    let m2 = dlq_get(dlq, "msg-1")
    assert(m2["status"] == "retried", "retried status")
    assert(m2["retries"] == 1, "1 retry")

    dlq = dlq_retry(dlq, "msg-1")
    dlq = dlq_retry(dlq, "msg-1")
    let m3 = dlq_get(dlq, "msg-1")
    assert(m3["status"] == "exhausted", "exhausted after 3 retries")

    dlq = dlq_discard(dlq, "msg-2")
    assert(dlq_count(dlq) == 1, "1 after discard")
    assert(dlq_total_discarded(dlq) == 1, "1 discarded")

    let missing = dlq_get(dlq, "nonexistent")
    assert(missing["id"] == "", "missing returns empty")

    print("DEADLETTER KAT PASS")
