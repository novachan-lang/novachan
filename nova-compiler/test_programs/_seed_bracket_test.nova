import std/game/seed_bracket

fn chk_int(label, got, want)
    if got != want
        print("FAIL seed_bracket " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // KAT 1: seed_order(2) == [1,2]
    let s2 = seed_order(2)
    chk_int("s2 len", len(s2), 2)
    chk_int("s2[0]", s2[0], 1)
    chk_int("s2[1]", s2[1], 2)

    // KAT 2: seed_order(4) == [1,4,2,3]
    let s4 = seed_order(4)
    chk_int("s4 len", len(s4), 4)
    chk_int("s4[0]", s4[0], 1)
    chk_int("s4[1]", s4[1], 4)
    chk_int("s4[2]", s4[2], 2)
    chk_int("s4[3]", s4[3], 3)

    // KAT 3: seed_order(8) == [1,8,4,5,2,7,3,6]
    let s8 = seed_order(8)
    chk_int("s8 len", len(s8), 8)
    chk_int("s8[0]", s8[0], 1)
    chk_int("s8[1]", s8[1], 8)
    chk_int("s8[2]", s8[2], 4)
    chk_int("s8[3]", s8[3], 5)
    chk_int("s8[4]", s8[4], 2)
    chk_int("s8[5]", s8[5], 7)
    chk_int("s8[6]", s8[6], 3)
    chk_int("s8[7]", s8[7], 6)

    // KAT 4: seed_matchups(4) == [[1,4],[2,3]]
    let m4 = seed_matchups(4)
    chk_int("m4 len", len(m4), 2)
    chk_int("m4[0][0]", m4[0][0], 1)
    chk_int("m4[0][1]", m4[0][1], 4)
    chk_int("m4[1][0]", m4[1][0], 2)
    chk_int("m4[1][1]", m4[1][1], 3)

    // KAT 5: seed_matchups(2) == [[1,2]]
    let m2 = seed_matchups(2)
    chk_int("m2 len", len(m2), 1)
    chk_int("m2[0][0]", m2[0][0], 1)
    chk_int("m2[0][1]", m2[0][1], 2)

    // KAT 6: seed_matchups(8) -- 4 matchups, each pair sums to 9
    let m8 = seed_matchups(8)
    chk_int("m8 len", len(m8), 4)
    chk_int("m8[0][0]", m8[0][0], 1)
    chk_int("m8[0][1]", m8[0][1], 8)
    chk_int("m8[1][0]", m8[1][0], 4)
    chk_int("m8[1][1]", m8[1][1], 5)
    chk_int("m8[2][0]", m8[2][0], 2)
    chk_int("m8[2][1]", m8[2][1], 7)
    chk_int("m8[3][0]", m8[3][0], 3)
    chk_int("m8[3][1]", m8[3][1], 6)

    // KAT 7: seed_order(1) returns [1]
    let s1 = seed_order(1)
    chk_int("s1 len", len(s1), 1)
    chk_int("s1[0]", s1[0], 1)

    // KAT 8: seed_order(16) length == 16
    let s16 = seed_order(16)
    chk_int("s16 len", len(s16), 16)
    // First entry must be seed 1, last in pair must be 16
    chk_int("s16[0]", s16[0], 1)
    chk_int("s16[1]", s16[1], 16)

    print("PASS _seed_bracket_test")
