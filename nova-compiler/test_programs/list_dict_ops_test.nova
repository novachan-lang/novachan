// list_dict_ops_test.nova -- get(dict,key,default) + list pop/insert/remove (Python/JS-trivial ops).
type Point
    x: int
    y: int

fn main()
    // get(dict, key, default)
    let d = {"a": 1, "b": 2}
    if get(d, "a", -1) != 1
        print("FAIL get hit")
        exit(1)
    if get(d, "z", -1) != -1
        print("FAIL get miss")
        exit(1)
    // pop -> last element + shrinks
    let l = [10, 20, 30]
    let p = pop(l)
    if p != 30 or len(l) != 2
        print("FAIL pop: " + str(p) + " len=" + str(len(l)))
        exit(1)
    // insert at mid, front, end
    let m = [1, 3]
    insert(m, 1, 2)                 // [1,2,3]
    insert(m, 0, 0)                 // [0,1,2,3]
    insert(m, 4, 4)                 // [0,1,2,3,4] (i==size -> append)
    if len(m) != 5 or m[0] != 0 or m[2] != 2 or m[4] != 4
        print("FAIL insert: len=" + str(len(m)))
        exit(1)
    // remove present (first match) + absent
    let r = [5, 6, 7, 6]
    let f1 = remove(r, 6)          // -> [5,7,6]
    if f1 != 1 or len(r) != 3 or r[1] != 7
        print("FAIL remove present")
        exit(1)
    let f2 = remove(r, 99)        // absent
    if f2 != 0 or len(r) != 3
        print("FAIL remove absent")
        exit(1)
    // string remove (structural equality)
    let s = ["a", "b", "c"]
    let _sf = remove(s, "b")
    if len(s) != 2 or s[1] != "c"
        print("FAIL remove string")
        exit(1)
    // struct elements: pop a list-of-structs, then json_stringify the rest still works
    let pts = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let last = pop(pts)
    if last.x != 3 or last.y != 4
        print("FAIL pop struct")
        exit(1)
    if json_stringify(pts) != "[\{\"x\":1,\"y\":2\}]"
        print("FAIL json after pop: " + json_stringify(pts))
        exit(1)
    // UFCS method syntax: lst.pop(), d.get(k, default)
    let u = [100, 200]
    let up = u.pop()
    if up != 200 or len(u) != 1
        print("FAIL UFCS pop")
        exit(1)
    if d.get("b", 0) != 2
        print("FAIL UFCS get")
        exit(1)
    // RC stress: insert/pop/remove struct elements in a loop -- a double-free would CRASH
    let i = 0
    while i < 500
        let sl = [Point { x: i, y: i }]
        insert(sl, 0, Point { x: 0, y: 0 })
        let _pp = pop(sl)
        let _rf = remove(sl, Point { x: 0, y: 0 })
        i = i + 1
    print("list_dict_ops_test passed")
