import forge_bellmanford

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // classic CLRS graph: nodes 0=s,1=t,2=x,3=y,4=z
    let edges = []
    push(edges, [0, 1, 6])
    push(edges, [0, 3, 7])
    push(edges, [1, 2, 5])
    push(edges, [1, 3, 8])
    push(edges, [1, 4, 0 - 4])
    push(edges, [2, 1, 0 - 2])
    push(edges, [3, 2, 0 - 3])
    push(edges, [3, 4, 9])
    push(edges, [4, 0, 2])
    push(edges, [4, 2, 7])

    let d = bellman_ford(5, edges, 0)
    fails = fails + expect("clrs_dist", joinl(d), "0,2,4,7,-2")
    fails = fails + expect("clrs_nocycle", str(bf_has_negative_cycle(5, edges, 0)), "false")

    // simple positive graph
    let e2 = []
    push(e2, [0, 1, 4])
    push(e2, [0, 2, 1])
    push(e2, [2, 1, 2])
    push(e2, [1, 3, 1])
    push(e2, [2, 3, 5])
    let d2 = bellman_ford(4, e2, 0)
    // 0->2->1->3 = 1+2+1 = 4;  0->1 direct = 4; 0->2 = 1
    fails = fails + expect("pos_dist", joinl(d2), "0,3,1,4")

    // negative cycle: 0->1 (1), 1->2 (-1), 2->0 (-1)  (cycle sum = -1)
    let ec = []
    push(ec, [0, 1, 1])
    push(ec, [1, 2, 0 - 1])
    push(ec, [2, 0, 0 - 1])
    fails = fails + expect("neg_cycle", str(bf_has_negative_cycle(3, ec, 0)), "true")

    // reachability: node 2 disconnected
    let er = []
    push(er, [0, 1, 5])
    let dr = bellman_ford(3, er, 0)
    fails = fails + expect("reach_yes", str(bf_reachable(dr, 1)), "true")
    fails = fails + expect("reach_no", str(bf_reachable(dr, 2)), "false")
    fails = fails + expect("reach_src", str(bf_reachable(dr, 0)), "true")

    if fails == 0
        print("forge_bellmanford: all passed")
    else
        print("forge_bellmanford: " + str(fails) + " FAILED")
