import std/complex/complex_gaussian_prime

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _complex_gaussian_prime_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — assert bool equality
fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL _complex_gaussian_prime_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks — assert string equality
fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _complex_gaussian_prime_test " + label + ": got=" + got + " want=" + want)
        exit(1)

// [1,1]: N=2 (rational prime) -> Gaussian prime = true
let z11 = []
push(z11, 1)
push(z11, 1)
ckb("is_prime_1p1i", cxgp_is_prime(z11), true)

// [2,0]: |2| = 2, 2 mod 4 = 2 (NOT 3) -> NOT Gaussian prime = false
let z20 = []
push(z20, 2)
push(z20, 0)
ckb("is_prime_2", cxgp_is_prime(z20), false)

// [3,0]: |3| = 3, 3 mod 4 = 3, rational prime -> Gaussian prime = true
let z30 = []
push(z30, 3)
push(z30, 0)
ckb("is_prime_3", cxgp_is_prime(z30), true)

// [5,0]: |5| = 5, 5 mod 4 = 1 (NOT 3) -> NOT Gaussian prime = false
let z50 = []
push(z50, 5)
push(z50, 0)
ckb("is_prime_5", cxgp_is_prime(z50), false)

// [2,1]: N = 4+1 = 5 (rational prime) -> Gaussian prime = true
let z21 = []
push(z21, 2)
push(z21, 1)
ckb("is_prime_2p1i", cxgp_is_prime(z21), true)

// [0,3]: purely imaginary, |3| = 3, 3 mod 4 = 3, rational prime -> Gaussian prime = true
let z03 = []
push(z03, 0)
push(z03, 3)
ckb("is_prime_3i", cxgp_is_prime(z03), true)

// [4,0]: |4| = 4, not rational prime -> NOT Gaussian prime = false
let z40 = []
push(z40, 4)
push(z40, 0)
ckb("is_prime_4", cxgp_is_prime(z40), false)

// cxgp_norm_is_prime([2,1]): N = 5 (rational prime) -> true
let z21b = []
push(z21b, 2)
push(z21b, 1)
ckb("norm_is_prime_2p1i", cxgp_norm_is_prime(z21b), true)

// extra checks
// [0,0]: norm=0, not prime
let z00 = []
push(z00, 0)
push(z00, 0)
ckb("is_prime_zero", cxgp_is_prime(z00), false)

// [1,0]: unit, not prime
let z10 = []
push(z10, 1)
push(z10, 0)
ckb("is_prime_unit", cxgp_is_prime(z10), false)

// [7,0]: 7 mod 4 = 3 and rational prime -> true
let z70 = []
push(z70, 7)
push(z70, 0)
ckb("is_prime_7", cxgp_is_prime(z70), true)

// [0,5]: |5| mod 4 = 1, NOT a Gaussian prime -> false
let z05 = []
push(z05, 0)
push(z05, 5)
ckb("is_prime_5i", cxgp_is_prime(z05), false)

print("PASS _complex_gaussian_prime_test")
