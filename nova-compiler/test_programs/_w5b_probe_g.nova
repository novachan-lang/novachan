// G: list built, conditionally aliased, element read after the alias-source frame.
// nested list returned from a helper, outer holds it, outer returned.
fn inner() -> list
    let x = [7, 8, 9]
    return x
fn outer() -> list
    let a = inner()
    let b = [a, a]
    return b
fn main()
    let r = outer()
    let f0 = r[0]
    let f1 = r[1]
    print(len(f0) + len(f1))
    print("G_DONE")
