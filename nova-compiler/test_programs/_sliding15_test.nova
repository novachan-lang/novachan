import std/game/sliding15

fn main()
    // Test 1: sliding_is_goal on a 2x2 goal board [1,2,3,0]
    let g2 = []
    push(g2, 1)
    push(g2, 2)
    push(g2, 3)
    push(g2, 0)
    let r1 = sliding_is_goal(g2, 2)
    if r1 != 1
        print("FAIL sliding15 is_goal_2x2: got " + str(r1) + " want 1")
        exit(1)

    // Test 2: sliding_is_goal false for non-goal board
    let ng2 = []
    push(ng2, 1)
    push(ng2, 2)
    push(ng2, 0)
    push(ng2, 3)
    let r2 = sliding_is_goal(ng2, 2)
    if r2 != 0
        print("FAIL sliding15 not_goal_2x2: got " + str(r2) + " want 0")
        exit(1)

    // Test 3: 3x3 goal board [1,2,3,4,5,6,7,8,0]
    let g3 = []
    push(g3, 1)
    push(g3, 2)
    push(g3, 3)
    push(g3, 4)
    push(g3, 5)
    push(g3, 6)
    push(g3, 7)
    push(g3, 8)
    push(g3, 0)
    let r3 = sliding_is_goal(g3, 3)
    if r3 != 1
        print("FAIL sliding15 is_goal_3x3: got " + str(r3) + " want 1")
        exit(1)

    // Test 4: sliding_solvable — a known solvable 3x3 board
    // [1,2,3,4,5,6,7,8,0] is the goal itself; 0 inversions, n=3 (odd) -> solvable
    let s4 = sliding_solvable(g3, 3)
    if s4 != 1
        print("FAIL sliding15 solvable_goal: got " + str(s4) + " want 1")
        exit(1)

    // Test 5: sliding_solvable — single swap from goal is UNSOLVABLE (3x3)
    // Swap tiles 7 and 8: [1,2,3,4,5,6,8,7,0] -> 1 inversion, odd -> unsolvable
    let us5 = []
    push(us5, 1)
    push(us5, 2)
    push(us5, 3)
    push(us5, 4)
    push(us5, 5)
    push(us5, 6)
    push(us5, 8)
    push(us5, 7)
    push(us5, 0)
    let r5 = sliding_solvable(us5, 3)
    if r5 != 0
        print("FAIL sliding15 unsolvable_swap: got " + str(r5) + " want 0")
        exit(1)

    // Test 6: another solvable 3x3: [1,2,3,4,5,6,0,7,8]
    // blank at index 6, inversions: (7 vs 8 - no), all others in order -> 0 inversions
    // Actually blank row from top = 2, that's standard; n odd -> inversions even -> solvable
    let s6 = []
    push(s6, 1)
    push(s6, 2)
    push(s6, 3)
    push(s6, 4)
    push(s6, 5)
    push(s6, 6)
    push(s6, 0)
    push(s6, 7)
    push(s6, 8)
    let r6 = sliding_solvable(s6, 3)
    if r6 != 1
        print("FAIL sliding15 solvable_3x3: got " + str(r6) + " want 1")
        exit(1)

    // Test 7: sliding_neighbors on 2x2 goal [1,2,3,0]
    // blank at index 3 (row=1, col=1)
    // Can move UP (swap with index 1 = tile 2): [1,0,3,2]
    // Can move LEFT (swap with index 2 = tile 3): [1,2,0,3]
    // No DOWN (row=1 = n-1=1), No RIGHT (col=1 = n-1=1)
    let nb7 = sliding_neighbors(g2, 2)
    let nblen = len(nb7)
    if nblen != 2
        print("FAIL sliding15 neighbors_count: got " + str(nblen) + " want 2")
        exit(1)

    // Check one neighbor is [1,0,3,2] (blank moved up, tile 2 moved down)
    let found_up = 0
    let found_left = 0
    let ni = 0
    while ni < nblen
        let b = nb7[ni]
        // [1,0,3,2]: b[0]=1,b[1]=0,b[2]=3,b[3]=2
        if b[0] == 1 and b[1] == 0 and b[2] == 3 and b[3] == 2
            found_up = 1
        // [1,2,0,3]: b[0]=1,b[1]=2,b[2]=0,b[3]=3
        if b[0] == 1 and b[1] == 2 and b[2] == 0 and b[3] == 3
            found_left = 1
        ni = ni + 1

    if found_up != 1
        print("FAIL sliding15 neighbor_up: not found [1,0,3,2]")
        exit(1)
    if found_left != 1
        print("FAIL sliding15 neighbor_left: not found [1,2,0,3]")
        exit(1)

    // Test 8: neighbors of 3x3 board with blank in center (index 4)
    // [1,2,3,4,0,5,6,7,8] -> blank at row=1,col=1 -> 4 neighbors
    let bc = []
    push(bc, 1)
    push(bc, 2)
    push(bc, 3)
    push(bc, 4)
    push(bc, 0)
    push(bc, 5)
    push(bc, 6)
    push(bc, 7)
    push(bc, 8)
    let nb8 = sliding_neighbors(bc, 3)
    if len(nb8) != 4
        print("FAIL sliding15 center_neighbors: got " + str(len(nb8)) + " want 4")
        exit(1)

    print("PASS _sliding15_test")
