// CONTROL: identical loop shape, ONE type -> static call, no dynamic dispatch
type T0
    t0_v: int

fn T0.kick(self) -> int
    return self.t0_v

fn main()
    let xs = []
    xs.push(T0(0))
    xs.push(T0(1))
    xs.push(T0(2))
    xs.push(T0(3))
    xs.push(T0(4))
    xs.push(T0(5))
    xs.push(T0(6))
    xs.push(T0(7))
    xs.push(T0(8))
    xs.push(T0(9))
    xs.push(T0(10))
    xs.push(T0(11))
    let t0 = clock_ns()
    let acc = 0
    let r = 0
    while r < 200000
        let k = 0
        while k < 12
            acc = acc + xs[k].kick()
            k = k + 1
        r = r + 1
    print("acc=" + str(acc))
    print("control ns=" + str(clock_ns() - t0))
