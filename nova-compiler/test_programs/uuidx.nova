fn uuid_parse(s)
  if len(s) != 36
    return err("invalid UUID length")
  let parts = split(s, "-")
  if len(parts) != 5
    return err("invalid UUID format")
  if len(parts[0]) != 8 or len(parts[1]) != 4 or len(parts[2]) != 4 or len(parts[3]) != 4 or len(parts[4]) != 12
    return err("invalid UUID segment lengths")
  ok(s)

fn uuid_version(s)
  if len(s) < 15
    return 0
  let ch = slice(s, 14, 15)
  let _r = parse_int_safe(ch)
  if is_ok(_r)
    return unwrap(_r)
  0

fn uuid_is_nil(s)
  s == "00000000-0000-0000-0000-000000000000"

fn uuid_nil()
  "00000000-0000-0000-0000-000000000000"

fn main()
  let u = uuid4()
  assert(len(u) == 36, "uuid4 length 36")
  assert(is_ok(uuid_parse(u)), "uuid4 valid format")
  assert(uuid_version(u) == 4, "uuid4 version = 4")

  let u2 = uuid4()
  assert(u != u2, "uuid4 unique")

  assert(uuid_is_nil(uuid_nil()) == 1, "nil uuid")
  assert(uuid_is_nil(u) == 0, "non-nil")

  assert(is_err(uuid_parse("not-a-uuid")), "invalid parse")
  assert(is_err(uuid_parse("12345678-1234-1234-1234")), "too few parts")

  print("uuidx: all passed")
