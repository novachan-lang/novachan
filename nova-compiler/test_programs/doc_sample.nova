/// Adds two numbers and returns the result.
/// This is the primary arithmetic function.
fn add(a: int, b: int) -> int
    a + b

/// Subtracts b from a.
fn subtract(a: int, b: int) -> int
    a - b

/// Represents a 2D point with x and y coordinates.
type Point
    x: int
    y: int

/// Calculates the Manhattan distance between two points.
/// Uses absolute value for each axis.
fn distance(p1: Point, p2: Point) -> int
    abs(p1.x - p2.x) + abs(p1.y - p2.y)

/// Represents possible errors in the application.
enum AppError
    NotFound
    Timeout
    Unknown

// Regular comment, should NOT appear in docs
fn helper()
    print("no doc comment")

/// Greets a user by name.
/// Returns a formatted greeting string.
fn greet(name: string) -> string
    "Hello, " + name + "!"

/// Computes factorial recursively.
fn factorial(n: int) -> int
    if n <= 1
        1
    else
        n * factorial(n - 1)

/// Entry point for the sample program.
fn main()
    let p = Point { x: 3, y: 4 }
    print(add(10, 20))
    print(greet("NOVA"))
    print(factorial(5))
