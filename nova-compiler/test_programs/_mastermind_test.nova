import std/game/mastermind

fn _assert_score(label, guess, secret, wb, ww)
    let sc = mastermind_score(guess, secret)
    let got_b = sc[0]
    let got_w = sc[1]
    if got_b != wb
        print("FAIL mastermind " + label + " black: got " + str(got_b) + " want " + str(wb))
        exit(1)
    if got_w != ww
        print("FAIL mastermind " + label + " white: got " + str(got_w) + " want " + str(ww))
        exit(1)

fn main()
    // Test 1: perfect match [1,2,3,4] vs [1,2,3,4] -> [4,0]
    let g1 = []
    push(g1, 1)
    push(g1, 2)
    push(g1, 3)
    push(g1, 4)
    let s1 = []
    push(s1, 1)
    push(s1, 2)
    push(s1, 3)
    push(s1, 4)
    _assert_score("perfect", g1, s1, 4, 0)

    // Test 2: [1,2,3,4] vs [1,3,2,5] -> [1,2]
    // black: pos0 (1==1); white: pos1 3 in secret at pos2, pos2 2 in secret at pos1 -> 2 white
    let g2 = []
    push(g2, 1)
    push(g2, 2)
    push(g2, 3)
    push(g2, 4)
    let s2 = []
    push(s2, 1)
    push(s2, 3)
    push(s2, 2)
    push(s2, 5)
    _assert_score("one_black_two_white", g2, s2, 1, 2)

    // Test 3: duplicate handling [1,1,2,3] vs [1,2,1,1] -> [1,2]
    // pos0: 1==1 -> black. remaining: guess=[1,2,3], secret=[2,1,1]
    // color 1: min(1,2)=1 white; color 2: min(1,1)=1 white; color 3: min(1,0)=0
    // -> white=2
    let g3 = []
    push(g3, 1)
    push(g3, 1)
    push(g3, 2)
    push(g3, 3)
    let s3 = []
    push(s3, 1)
    push(s3, 2)
    push(s3, 1)
    push(s3, 1)
    _assert_score("duplicates", g3, s3, 1, 2)

    // Test 4: all wrong colors -> [0,0]
    let g4 = []
    push(g4, 5)
    push(g4, 6)
    push(g4, 7)
    push(g4, 8)
    let s4 = []
    push(s4, 1)
    push(s4, 2)
    push(s4, 3)
    push(s4, 4)
    _assert_score("all_wrong", g4, s4, 0, 0)

    // Test 5: all white (right colors, all wrong positions) [2,1,4,3] vs [1,2,3,4] -> [0,4]
    let g5 = []
    push(g5, 2)
    push(g5, 1)
    push(g5, 4)
    push(g5, 3)
    let s5 = []
    push(s5, 1)
    push(s5, 2)
    push(s5, 3)
    push(s5, 4)
    _assert_score("all_white", g5, s5, 0, 4)

    // Test 6: no double-counting [1,1,1,1] vs [1,2,2,2] -> [1,0]
    // pos0 black=1; remaining guess=[1,1,1], secret=[2,2,2]; no common colors
    let g6 = []
    push(g6, 1)
    push(g6, 1)
    push(g6, 1)
    push(g6, 1)
    let s6 = []
    push(s6, 1)
    push(s6, 2)
    push(s6, 2)
    push(s6, 2)
    _assert_score("no_double_count", g6, s6, 1, 0)

    // Test 7: [2,2,2,2] vs [1,2,2,2] -> [3,0]
    let g7 = []
    push(g7, 2)
    push(g7, 2)
    push(g7, 2)
    push(g7, 2)
    let s7 = []
    push(s7, 1)
    push(s7, 2)
    push(s7, 2)
    push(s7, 2)
    _assert_score("three_black", g7, s7, 3, 0)

    print("PASS _mastermind_test")
