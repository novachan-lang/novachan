fn retry(action, max_attempts)
  let attempt = 1
  while attempt <= max_attempts
    let result = action(attempt)
    if is_ok(result)
      return result
    if attempt == max_attempts
      return result
    attempt = attempt + 1
  err("exhausted retries")

fn retry_with_delay(action, max_attempts, delay_ms)
  let attempt = 1
  while attempt <= max_attempts
    let result = action(attempt)
    if is_ok(result)
      return result
    if attempt < max_attempts
      sleep(delay_ms)
    attempt = attempt + 1
  err("exhausted retries")

fn retry_exp_backoff(action, max_attempts, base_ms, max_delay_ms)
  let attempt = 1
  while attempt <= max_attempts
    let result = action(attempt)
    if is_ok(result)
      return result
    if attempt < max_attempts
      let delay = base_ms
      let exp = attempt - 1
      while exp > 0
        delay = delay * 2
        exp = exp - 1
      if delay > max_delay_ms
        delay = max_delay_ms
      sleep(delay)
    attempt = attempt + 1
  err("exhausted retries")

fn retry_while(action, should_retry_fn, max_attempts)
  let attempt = 1
  while attempt <= max_attempts
    let result = action(attempt)
    if is_ok(result)
      return result
    if not should_retry_fn(result, attempt)
      return result
    attempt = attempt + 1
  err("exhausted retries")

fn _flaky(attempt)
  if attempt < 3
    return err("fail-" + str(attempt))
  ok("success on " + str(attempt))

fn _always_fail(attempt)
  err("nope-" + str(attempt))

fn main()
  let r1 = retry(fn(z) _flaky(z), 5)
  assert(is_ok(r1), "flaky eventually succeeds")
  assert(unwrap(r1) == "success on 3", "succeeds on attempt 3")

  let r2 = retry(fn(z) _always_fail(z), 3)
  assert(is_err(r2), "always-fail returns error")

  let r3 = retry(fn(z) ok(42), 1)
  assert(is_ok(r3), "immediate success")
  assert(unwrap(r3) == 42, "returns 42")

  let r4 = retry_while(fn(z) _flaky(z), fn(r, a) a < 5, 10)
  assert(is_ok(r4), "retry_while succeeds")

  let r5 = retry_while(fn(z) _always_fail(z), fn(r, a) a < 2, 10)
  assert(is_err(r5), "retry_while stops at predicate")

  print("retryx: all passed")
