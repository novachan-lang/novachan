// Multi-threaded HTTP server: spawn a worker per connection.
// Demonstrates real concurrency — a slow request no longer blocks the others.

type Request
    method: string
    path: string
    query: string
    version: string
    headers: dict
    body: string

type Response
    status: int
    headers: dict
    body: string

fn http_parse_request(raw: string) -> Request
    let header_end = find(raw, "\r\n\r\n")
    let header_part = raw
    let body = ""
    if header_end >= 0
        header_part = slice(raw, 0, header_end)
        body = slice(raw, header_end + 4, len(raw))
    let lines = split(header_part, "\r\n")
    let method = ""
    let path = ""
    let query = ""
    let version = "HTTP/1.1"
    if len(lines) > 0
        let parts = split(lines[0], " ")
        if len(parts) >= 1
            method = parts[0]
        if len(parts) >= 2
            let p = parts[1]
            let q_pos = find(p, "?")
            if q_pos >= 0
                path = slice(p, 0, q_pos)
                query = slice(p, q_pos + 1, len(p))
            else
                path = p
        if len(parts) >= 3
            version = parts[2]
    let headers = {}
    let i = 1
    while i < len(lines)
        let line = lines[i]
        let colon = find(line, ":")
        if colon > 0
            headers[lower(trim(slice(line, 0, colon)))] = trim(slice(line, colon + 1, len(line)))
        i = i + 1
    Request(method, path, query, version, headers, body)

fn http_status_text(status: int) -> string
    if status == 200
        return "OK"
    if status == 404
        return "Not Found"
    if status == 500
        return "Internal Server Error"
    return "OK"

fn http_build_response(r: Response) -> string
    let body_len = len(r.body)
    let header_str = "Content-Type: text/plain; charset=utf-8\r\n"
    header_str = header_str + "Content-Length: " + str(body_len) + "\r\n"
    header_str = header_str + "Connection: close\r\n"
    "HTTP/1.1 " + str(r.status) + " " + http_status_text(r.status) + "\r\n" + header_str + "\r\n" + r.body

fn ok(body: string) -> Response
    Response(200, {}, body)

fn not_found(body: string) -> Response
    Response(404, {}, body)

fn dispatch(req: Request) -> Response
    let key = req.method + " " + req.path
    if key == "GET /"
        return ok("multi-threaded NOVA HTTP")
    if key == "GET /fast"
        return ok("fast response")
    if key == "GET /slow"
        // Simulate 1s of work — single-threaded server would block other reqs
        sleep(1000)
        return ok("slow response (1s)")
    if key == "GET /tid"
        return ok("worker handled request at time={time_ms()}")
    if key == "GET /stop"
        return ok("stopping")
    not_found("404 {req.method} {req.path}")

fn handle_connection(client: int)
    let raw = http_read_request(client)
    let req = http_parse_request(raw)
    let resp = dispatch(req)
    let out = http_build_response(resp)
    http_send_raw(client, out)

fn serve(port: int)
    let sock = tcp_listen(port)
    if sock >= 0
        print("Multi-threaded server listening on http://127.0.0.1:{port}")
        let running = 1
        while running == 1
            let client = tcp_accept(sock)
            if client >= 0
                spawn fn()
                    handle_connection(client)
        print("Server stopped")
    else
        print("error: cannot listen on {port}")

fn main()
    let port = 18766
    let argv = args()
    if len(argv) > 1
        port = parse_int(argv[1])
    serve(port)
