// KAT for std/matrix/matdet — determinant and cofactor operations (tol 0.0001).
import std/matrix/matdet

fn _ck_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

fn ckf(label: string, got: float, want: float)
    let d = _ck_fabs(got - want)
    if d > 0.0001
        print("FAIL matdet " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL matdet " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Helper: build a 2x2 matrix from four floats.
fn mk22(a: float, b: float, c: float, e: float) -> any
    let data = []
    push(data, a)
    push(data, b)
    push(data, c)
    push(data, e)
    md_make(2, 2, data)

fn main()
    // KAT 1: md_det of 2x2 [[1,2],[3,4]] == -2.0
    let m22a = mk22(1.0, 2.0, 3.0, 4.0)
    let d1 = md_det(m22a)
    ckf("det_2x2_a", d1, -2.0)

    // KAT 2: md_det of 2x2 [[2,0],[0,3]] == 6.0 (diagonal)
    let m22b = mk22(2.0, 0.0, 0.0, 3.0)
    let d2 = md_det(m22b)
    ckf("det_2x2_diag", d2, 6.0)

    // KAT 3: md_det of 3x3 identity == 1.0
    let mid3 = md_identity(3)
    let d3 = md_det(mid3)
    ckf("det_3x3_identity", d3, 1.0)

    // KAT 4: md_det_3x3 [[6,1,1],[4,-2,5],[2,8,7]] == -306.0
    let v33a = []
    push(v33a, 6.0)
    push(v33a, 1.0)
    push(v33a, 1.0)
    push(v33a, 4.0)
    push(v33a, -2.0)
    push(v33a, 5.0)
    push(v33a, 2.0)
    push(v33a, 8.0)
    push(v33a, 7.0)
    let m33a = md_make(3, 3, v33a)
    let d4 = md_det_3x3(m33a)
    ckf("det_3x3_a", d4, -306.0)

    // KAT 5: md_det dispatches to det_3x3 for 3x3 — same result
    let d5 = md_det(m33a)
    ckf("det_dispatch_3x3", d5, -306.0)

    // KAT 6: singular matrix [[1,2],[2,4]] det == 0.0
    let m22sing = mk22(1.0, 2.0, 2.0, 4.0)
    let d6 = md_det(m22sing)
    ckf("det_singular_2x2", d6, 0.0)

    // KAT 7: md_is_singular([[1,2],[2,4]], 0.0001) == true
    let sing = md_is_singular(m22sing, 0.0001)
    ckb("is_singular_true", sing, true)

    // KAT 8: md_is_singular([[1,2],[3,4]], 0.0001) == false
    let not_sing = md_is_singular(m22a, 0.0001)
    ckb("is_singular_false", not_sing, false)

    // KAT 9: md_cofactor([[1,2],[3,4]], 0, 0) == 4.0
    // cofactor(0,0) = (-1)^0 * minor(0,0) = det([[4]]) = 4.0
    let cof00 = md_cofactor(m22a, 0, 0)
    ckf("cofactor_00", cof00, 4.0)

    // KAT 10: md_minor([[1,2,3],[4,5,6],[7,8,9]], 0, 0) == 5*9-6*8 == -3.0
    let v33b = []
    push(v33b, 1.0)
    push(v33b, 2.0)
    push(v33b, 3.0)
    push(v33b, 4.0)
    push(v33b, 5.0)
    push(v33b, 6.0)
    push(v33b, 7.0)
    push(v33b, 8.0)
    push(v33b, 9.0)
    let m33b = md_make(3, 3, v33b)
    let minor00 = md_minor(m33b, 0, 0)
    ckf("minor_3x3_00", minor00, -3.0)

    // KAT 11: md_det_2x2 direct formula
    let d11 = md_det_2x2(m22a)
    ckf("det_2x2_direct", d11, -2.0)

    // KAT 12: md_det_upper_triangular for [[2,5],[0,3]] -> 2*3 = 6.0
    let mut2 = mk22(2.0, 5.0, 0.0, 3.0)
    let dut = md_det_upper_triangular(mut2)
    ckf("det_upper_tri", dut, 6.0)

    // KAT 13: md_laplace agrees with md_det for 3x3
    let dlap = md_laplace(m33a)
    ckf("laplace_3x3", dlap, -306.0)

    // KAT 14: md_laplace for 2x2
    let dlap2 = md_laplace(m22a)
    ckf("laplace_2x2", dlap2, -2.0)

    // KAT 15: md_det for 4x4 via LU — diagonal matrix diag(2,3,5,7) -> 210.0
    let d4x4 = []
    push(d4x4, 2.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 3.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 5.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 0.0)
    push(d4x4, 7.0)
    let m4x4 = md_make(4, 4, d4x4)
    let d15 = md_det(m4x4)
    ckf("det_4x4_diag", d15, 210.0)

    // KAT 16: md_cofactor with negative sign: cofactor(0,1) for [[1,2],[3,4]]
    // = (-1)^(0+1) * minor(0,1) = -1 * det([[3]]) = -3.0
    let cof01 = md_cofactor(m22a, 0, 1)
    ckf("cofactor_01_neg", cof01, -3.0)

    // KAT 17: md_det 1x1 matrix
    let v1x1 = []
    push(v1x1, 7.0)
    let m1x1 = md_make(1, 1, v1x1)
    let d17 = md_det(m1x1)
    ckf("det_1x1", d17, 7.0)

    print("PASS _matdet_test")
