// KAT test for std/random/lehmer
//
// Lehmer MCG 64-bit: state *= 0xD1342543DE82EF95 (mod 2^64), output = high 32 bits.
//
// Anchor values computed with Python reference:
//   M = 0xD1342543DE82EF95
//   state = seed | 1
//   state = (state * M) & (2**64 - 1)
//   high32 = state >> 32
//
// lehmer_seed(1): initial state = 1
//   [0] high32 = 3509855555   state=0xD1342543DE82EF95
//   [1] high32 = 2981745788   state=0xB1B9D47C9F8B8CB9
//   [2] high32 = 1939709901   state=0x739D9FCD088B9EAD
//   [3] high32 = 1226006551   state=0x49136017EC40DDB1
//   [4] high32 = 3892057856   state=0xE7FC1700229B4705
//   [5] high32 = 758254882    state=0x2D320D22823800E9
//   [6] high32 = 905279453    state=0x35F577DD97C40E9D
//   [7] high32 = 3459923707   state=0xCE3A3EFBF07B1461
//
// lehmer_seed(2): initial state = 3 (2|1 = 3)
//   [0] high32 = 1939632075   state=0x739C6FCB9B88CEBF

import std/random/lehmer

fn main()
    // ── KAT 1: anchor[0] for seed(1) ────────────────────────────────────────
    let r1 = lehmer_seed(1)
    let v0 = lehmer_next(r1)
    if v0 != 3509855555
        print("FAIL lehmer KAT1: anchor[0] got " + str(v0) + " want 3509855555")
        exit(1)

    // ── KAT 2: anchor[1] ────────────────────────────────────────────────────
    let v1 = lehmer_next(r1)
    if v1 != 2981745788
        print("FAIL lehmer KAT2: anchor[1] got " + str(v1) + " want 2981745788")
        exit(1)

    // ── KAT 3: anchor[2] ────────────────────────────────────────────────────
    let v2 = lehmer_next(r1)
    if v2 != 1939709901
        print("FAIL lehmer KAT3: anchor[2] got " + str(v2) + " want 1939709901")
        exit(1)

    // ── KAT 4: anchor[3] ────────────────────────────────────────────────────
    let v3 = lehmer_next(r1)
    if v3 != 1226006551
        print("FAIL lehmer KAT4: anchor[3] got " + str(v3) + " want 1226006551")
        exit(1)

    // ── KAT 5: anchor[4] ────────────────────────────────────────────────────
    let v4 = lehmer_next(r1)
    if v4 != 3892057856
        print("FAIL lehmer KAT5: anchor[4] got " + str(v4) + " want 3892057856")
        exit(1)

    // ── KAT 6: anchor[5] ────────────────────────────────────────────────────
    let v5 = lehmer_next(r1)
    if v5 != 758254882
        print("FAIL lehmer KAT6: anchor[5] got " + str(v5) + " want 758254882")
        exit(1)

    // ── KAT 7: anchor[6] ────────────────────────────────────────────────────
    let v6 = lehmer_next(r1)
    if v6 != 905279453
        print("FAIL lehmer KAT7: anchor[6] got " + str(v6) + " want 905279453")
        exit(1)

    // ── KAT 8: anchor[7] ────────────────────────────────────────────────────
    let v7 = lehmer_next(r1)
    if v7 != 3459923707
        print("FAIL lehmer KAT8: anchor[7] got " + str(v7) + " want 3459923707")
        exit(1)

    // ── KAT 9: DETERMINISM -- two generators seeded the same produce same 8 outputs
    let ra = lehmer_seed(1)
    let rb = lehmer_seed(1)
    let i = 0
    while i < 8
        let va = lehmer_next(ra)
        let vb = lehmer_next(rb)
        if va != vb
            print("FAIL lehmer KAT9: determinism diverged at step " + str(i) + ": " + str(va) + " vs " + str(vb))
            exit(1)
        i = i + 1

    // ── KAT 10: state stays ODD -- verify internal invariant across 20 steps ─
    // We verify by checking that lehmer_next64 always returns an odd number.
    let rc = lehmer_seed(1)
    let j = 0
    while j < 20
        let raw = lehmer_next64(rc)
        let parity = raw & 1
        if parity != 1
            print("FAIL lehmer KAT10: state not odd at step " + str(j) + ": " + str(raw))
            exit(1)
        j = j + 1

    // ── KAT 11: state stays NONZERO -- seed(0)|1 = 1, verify no wrap to zero ─
    // MCG with multiplier 0xD1342543DE82EF95 and odd state can never produce 0
    // (product of two odd numbers is odd; 0 is even).
    let rd = lehmer_seed(0)
    let k = 0
    while k < 20
        let rv = lehmer_next64(rd)
        if rv == 0
            print("FAIL lehmer KAT11: state became zero at step " + str(k))
            exit(1)
        k = k + 1

    // ── KAT 12: lehmer_next output fits in [0, 2^32-1] ──────────────────────
    let mask32 = 4294967295
    let re = lehmer_seed(99)
    let m = 0
    while m < 30
        let nv = lehmer_next(re)
        if nv < 0
            print("FAIL lehmer KAT12a: negative at step " + str(m) + ": " + str(nv))
            exit(1)
        if nv > mask32
            print("FAIL lehmer KAT12b: >2^32-1 at step " + str(m) + ": " + str(nv))
            exit(1)
        m = m + 1

    // ── KAT 13: lehmer_next_range stays in [0, n) ───────────────────────────
    let rf = lehmer_seed(777)
    let n = 0
    while n < 100
        let rv2 = lehmer_next_range(rf, 10)
        if rv2 < 0
            print("FAIL lehmer KAT13a: range < 0 at step " + str(n) + ": " + str(rv2))
            exit(1)
        if rv2 >= 10
            print("FAIL lehmer KAT13b: range >= 10 at step " + str(n) + ": " + str(rv2))
            exit(1)
        n = n + 1

    // ── KAT 14: lehmer_next_range with n=1 always returns 0 ─────────────────
    let rg = lehmer_seed(42)
    let p = 0
    while p < 10
        let rv3 = lehmer_next_range(rg, 1)
        if rv3 != 0
            print("FAIL lehmer KAT14: range(1) != 0 at step " + str(p) + ": " + str(rv3))
            exit(1)
        p = p + 1

    // ── KAT 15: different seeds produce different outputs ────────────────────
    // seed(1) initial state = 1; seed(2) initial state = 3 (2|1=3)
    // Both advance differently. Verify first output differs.
    let rx = lehmer_seed(1)
    let ry = lehmer_seed(2)
    let vx = lehmer_next(rx)
    let vy = lehmer_next(ry)
    if vx == vy
        print("FAIL lehmer KAT15: seed(1) and seed(2) produced same first output: " + str(vx))
        exit(1)

    // ── KAT 16: anchor for seed(2) first high32 output = 1939632075 ─────────
    // seed(2) -> state = 2|1 = 3, then 3 * M mod 2^64 -> high32 = 1939632075
    let rz = lehmer_seed(2)
    let vz = lehmer_next(rz)
    if vz != 1939632075
        print("FAIL lehmer KAT16: seed(2) anchor[0] got " + str(vz) + " want 1939632075")
        exit(1)

    // ── KAT 17: lehmer_next64 anchor for seed(1) ─────────────────────────────
    // First lehmer_next64(seed(1)) = full state after first multiply.
    // state = 1 * M = 0xD1342543DE82EF95 as signed i64 = -3372029247567499371
    let rq = lehmer_seed(1)
    let want64 = (0xD1342543 << 32) | 0xDE82EF95
    let got64 = lehmer_next64(rq)
    if got64 != want64
        print("FAIL lehmer KAT17: next64 seed(1)[0] got " + str(got64) + " want " + str(want64))
        exit(1)

    // ── KAT 18: lehmer_next_range concrete anchor ────────────────────────────
    // seed(1) first outputs mod 7:
    //   3509855555 % 7 = 3
    //   2981745788 % 7 = 0
    //   1939709901 % 7 = 3
    let rr = lehmer_seed(1)
    let w0 = lehmer_next_range(rr, 7)
    if w0 != 3
        print("FAIL lehmer KAT18a: range anchor[0]%7 got " + str(w0) + " want 3")
        exit(1)
    let w1 = lehmer_next_range(rr, 7)
    if w1 != 0
        print("FAIL lehmer KAT18b: range anchor[1]%7 got " + str(w1) + " want 0")
        exit(1)
    let w2 = lehmer_next_range(rr, 7)
    if w2 != 3
        print("FAIL lehmer KAT18c: range anchor[2]%7 got " + str(w2) + " want 3")
        exit(1)

    print("PASS _lehmer_test")
