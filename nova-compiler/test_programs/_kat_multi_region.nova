import forge_multi_region

fn main()
    let m = mr_new()
    m = mr_add_region(m, "us-east", 10)
    m = mr_add_region(m, "eu-west", 8)
    m = mr_add_region(m, "ap-south", 5)
    assert(mr_region_count(m) == 3, "3 regions")

    m = mr_set_primary(m, "us-east")
    let r1 = mr_route(m)
    assert(r1 == "us-east", "routes to primary")

    m = mr_mark_down(m, "us-east")
    let r2 = mr_route(m)
    assert(r2 == "eu-west", "failover to eu-west (highest pri)")

    m = mr_mark_down(m, "eu-west")
    let r3 = mr_route(m)
    assert(r3 == "ap-south", "failover to ap-south")

    m = mr_mark_up(m, "us-east")
    let r4 = mr_route(m)
    assert(r4 == "us-east", "primary back up")

    print("MULTI-REGION KAT PASS")
