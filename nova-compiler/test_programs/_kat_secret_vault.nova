import forge_secret_vault

fn main()
    let v = sv_new()
    assert(sv_secret_count(v) == 0, "starts empty")
    assert(sv_is_locked(v) == 0, "not locked")

    v = sv_store(v, "api_key", "sk-abc123")
    v = sv_store(v, "db_pass", "p4ssw0rd")
    assert(sv_secret_count(v) == 2, "2 secrets")
    assert(sv_has_secret(v, "api_key") == 1, "has api_key")
    assert(sv_has_secret(v, "nope") == 0, "no nope")

    let r1 = sv_retrieve(v, "api_key", "service-a")
    v = r1["v"]
    assert(r1["found"] == 1, "found api_key")
    assert(r1["value"] == "sk-abc123", "correct value")
    assert(sv_access_count(v) == 1, "1 access")

    let r2 = sv_retrieve(v, "missing", "service-b")
    v = r2["v"]
    assert(r2["found"] == 0, "missing not found")
    assert(sv_access_count(v) == 1, "still 1 access")

    v = sv_lock(v)
    assert(sv_is_locked(v) == 1, "locked")
    v = sv_store(v, "new_secret", "value")
    assert(sv_has_secret(v, "new_secret") == 0, "locked blocks store")

    v = sv_unlock(v)
    v = sv_store(v, "new_secret", "value")
    assert(sv_has_secret(v, "new_secret") == 1, "unlocked allows store")

    print("SECRET-VAULT KAT PASS")
