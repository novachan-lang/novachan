import std/data/java_class

// cki: assert integer equality, exit(1) with FAIL on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL java_class " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// cks: assert string equality, exit(1) with FAIL on mismatch.
fn cks(label, got, want)
    if got != want
        print("FAIL java_class " + label + ": got=" + got + " want=" + want)
        exit(1)

// ckb: assert boolean equality, exit(1) with FAIL on mismatch.
fn ckb(label, got, want)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL java_class " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // Build a minimal Java class header buffer:
    // magic: 202,254,186,190
    // minor: u16be(0) -> 0,0
    // major: u16be(52) -> 0,52
    // cp_count: u16be(10) -> 0,10
    let buf = []
    push(buf, 202)
    push(buf, 254)
    push(buf, 186)
    push(buf, 190)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 52)
    push(buf, 0)
    push(buf, 10)

    // KAT 1: magic check
    ckb("magic_check", jclass_magic_check(buf), true)

    // KAT 2: minor version
    cki("minor", jclass_minor(buf), 0)

    // KAT 3: major version
    cki("major", jclass_major(buf), 52)

    // KAT 4: constant pool count
    cki("cp_count", jclass_cp_count(buf), 10)

    // KAT 5: java version for major 52 -> '8'
    cks("java_version", jclass_java_version(buf), "8")

    // KAT 6: major_to_jdk direct calls
    cks("major_to_jdk_45", jclass_major_to_jdk(45), "1.1")
    cks("major_to_jdk_46", jclass_major_to_jdk(46), "1.2")
    cks("major_to_jdk_47", jclass_major_to_jdk(47), "1.3")
    cks("major_to_jdk_48", jclass_major_to_jdk(48), "1.4")
    cks("major_to_jdk_49", jclass_major_to_jdk(49), "5")
    cks("major_to_jdk_50", jclass_major_to_jdk(50), "6")
    cks("major_to_jdk_51", jclass_major_to_jdk(51), "7")
    cks("major_to_jdk_52", jclass_major_to_jdk(52), "8")
    cks("major_to_jdk_53", jclass_major_to_jdk(53), "9")
    cks("major_to_jdk_55", jclass_major_to_jdk(55), "11")
    cks("major_to_jdk_61", jclass_major_to_jdk(61), "17")
    cks("major_to_jdk_65", jclass_major_to_jdk(65), "21")
    cks("major_to_jdk_99", jclass_major_to_jdk(99), "unknown")
    cks("major_to_jdk_44", jclass_major_to_jdk(44), "unknown")

    // KAT 7: is_preview false (minor=0)
    ckb("is_preview_false", jclass_is_preview(buf), false)

    // KAT 8: is_valid true
    ckb("is_valid", jclass_is_valid(buf), true)

    // KAT 9: min_supported and max_known
    cki("min_supported", jclass_min_supported(), 45)
    cki("max_known", jclass_max_known(), 65)

    // KAT 10: describe
    cks("describe", jclass_describe(buf), "Java class, JDK 8")

    // KAT 11: preview detection (minor=65535)
    let pbuf = []
    push(pbuf, 202)
    push(pbuf, 254)
    push(pbuf, 186)
    push(pbuf, 190)
    push(pbuf, 255)
    push(pbuf, 255)
    push(pbuf, 0)
    push(pbuf, 61)
    push(pbuf, 0)
    push(pbuf, 5)
    ckb("is_preview_true", jclass_is_preview(pbuf), true)
    cks("preview_version", jclass_java_version(pbuf), "17")

    // KAT 12: bad magic -> magic_check false, is_valid false
    let bad = []
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    ckb("bad_magic", jclass_magic_check(bad), false)
    ckb("bad_is_valid", jclass_is_valid(bad), false)

    // KAT 13: too-short buffer
    let tiny = []
    push(tiny, 202)
    push(tiny, 254)
    ckb("tiny_magic_false", jclass_magic_check(tiny), false)
    cki("tiny_minor", jclass_minor(tiny), 0)

    print("PASS _java_class_test")
