// Ledger #12: signal handling. SIGINT/SIGTERM graceful shutdown already exists
// (shutdown_requested); this proves the NEW SIGHUP reload channel is wired.
// No signal is raised here (SIGHUP does not even exist on the Windows dev host), so
// both poll their steady-state 0 — this gates the builtin wiring + the correct
// no-signal value + the CONSUMING (re-armable) semantics of reload_requested.
fn main() -> int
    let fails = 0
    // reload channel (SIGHUP): 0 when no SIGHUP has arrived
    if reload_requested() != 0
        print("FAIL reload nonzero at start")
        fails = fails + 1
    // consuming semantics: still 0 on a repeat poll (nothing re-armed it)
    if reload_requested() != 0
        print("FAIL reload nonzero on repeat")
        fails = fails + 1
    // shutdown channel (SIGINT/SIGTERM): 0 in steady state, distinct from reload
    if shutdown_requested() != 0
        print("FAIL shutdown nonzero at start")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_signals")
    else
        print("FAILED _kat_signals")
    return 0
