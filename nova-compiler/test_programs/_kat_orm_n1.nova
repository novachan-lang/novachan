// Phase 2.3 KAT: W2002 must fire for a typed ORM read inside a for-loop body.
// The file must COMPILE (exit 0) -- the warning is non-fatal.
fn orm_all(db, sql: string, params) -> list
    []

type Item
    id: int
    name: string

fn main()
    let items: list<Item> = orm_all(0, "SELECT id, name FROM Item", [])
    for item in items
        let subs: list<Item> = orm_all(0, "SELECT id, name FROM Item WHERE id = ?", [item.id])
        print("sub count: {len(subs)}")
    print("done")
