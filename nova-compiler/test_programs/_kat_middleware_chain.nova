import forge_middleware_chain

fn main()
    let m = mc_new()
    m = mc_add(m, "auth", 1)
    m = mc_add(m, "logging", 2)
    m = mc_add(m, "cors", 3)
    assert(mc_count(m) == 3, "3 middleware")

    let active = mc_run(m)
    assert(active == 3, "3 active")

    let d = mc_disable(m, "logging")
    assert(is_ok(d), "disable ok")
    m = unwrap(d)
    assert(mc_is_enabled(m, "logging") == 0, "logging disabled")

    let active2 = mc_run(m)
    assert(active2 == 2, "2 active after disable")
    assert(mc_total_runs(m) == 2, "2 runs")

    let e = mc_enable(m, "logging")
    assert(is_ok(e), "enable ok")

    let bad = mc_disable(m, "nope")
    assert(is_err(bad), "not found")

    print("MIDDLEWARE-CHAIN KAT PASS")
