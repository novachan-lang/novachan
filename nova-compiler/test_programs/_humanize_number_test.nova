import std/util/humanize_number

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── hn_format KAT ────────────────────────────────────────────────────────
    // Below threshold: plain integer, no suffix.
    cks("hn_format(0)",   hn_format(0),   "0")
    cks("hn_format(999)", hn_format(999), "999")

    // K boundary and mid-value.
    cks("hn_format(1000)", hn_format(1000), "1.0K")
    cks("hn_format(1500)", hn_format(1500), "1.5K")
    cks("hn_format(9999)", hn_format(9999), "9.9K")

    // M boundary and mid-value.
    cks("hn_format(1000000)",   hn_format(1000000),   "1.0M")
    cks("hn_format(2500000)",   hn_format(2500000),   "2.5M")

    // B boundary.
    cks("hn_format(1000000000)", hn_format(1000000000), "1.0B")

    // Negative value below threshold.
    cks("hn_format(-500)", hn_format(-500), "-500")

    // Negative value with suffix.
    cks("hn_format(-1500)", hn_format(-1500), "-1.5K")

    // ── hn_parse KAT ─────────────────────────────────────────────────────────
    // Plain integer (no suffix).
    cki("hn_parse(999)",    hn_parse("999"),    999)
    cki("hn_parse(0)",      hn_parse("0"),      0)

    // K suffix with decimal.
    cki("hn_parse(1.5K)",   hn_parse("1.5K"),   1500)
    cki("hn_parse(1.0K)",   hn_parse("1.0K"),   1000)

    // M suffix without decimal.
    cki("hn_parse(2M)",     hn_parse("2M"),     2000000)

    // B suffix.
    cki("hn_parse(1.0B)",   hn_parse("1.0B"),   1000000000)

    // Round-trip: format then parse.
    cki("roundtrip(2500000)", hn_parse(hn_format(2500000)), 2500000)
    cki("roundtrip(1000000000)", hn_parse(hn_format(1000000000)), 1000000000)

    print("_humanize_number_test passed")
