// _memo_smoke -- validates the 0E @memo wrapper restructure (lock the lookup+insert, release for the
// compute). fib is RECURSIVE @memo: each fib(n) cache-misses, RELEASES the memo lock, recurses (which
// re-enters the same @memo lock for fib(n-1)/fib(n-2)), then re-acquires to store. If the lock were held
// across the compute this would self-deadlock; release-before-compute makes it correct. Run at N=1 AND
// N=4 (N>1 actually takes the lock) -- the memoized result must be exact either way.
@memo
fn fib(n: int) -> int
    if n < 2
        n
    else
        fib(n - 1) + fib(n - 2)

fn main()
    let r = fib(30)
    assert(r == 832040, "fib(30) memoized exactly (got " + str(r) + ")")
    // a second call hits the warm cache on every node
    let r2 = fib(32)
    assert(r2 == 2178309, "fib(32) memoized exactly (got " + str(r2) + ")")
    print("PASS memo: fib(30)=" + str(r) + " fib(32)=" + str(r2))
