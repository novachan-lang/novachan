import forge_deployment_strategy

fn main()
    let d = deploy_new("api-service", "canary")
    d = deploy_add_version(d, "v1.0")
    d = deploy_set_active(d, "v1.0")
    d = deploy_set_traffic(d, "v1.0", 100)

    assert(deploy_active_version(d) == "v1.0", "active=v1.0")
    assert(deploy_get_traffic(d, "v1.0") == 100, "v1.0 100%")

    d = deploy_canary_start(d, "v1.1", 10)
    assert(deploy_status(d) == "canary", "canary status")
    assert(deploy_get_traffic(d, "v1.1") == 10, "canary 10%")
    assert(deploy_get_traffic(d, "v1.0") == 90, "old 90%")

    d = deploy_canary_promote(d, "v1.1")
    assert(deploy_active_version(d) == "v1.1", "active=v1.1")
    assert(deploy_get_traffic(d, "v1.1") == 100, "v1.1 100%")
    assert(deploy_get_traffic(d, "v1.0") == 0, "v1.0 0%")
    assert(deploy_status(d) == "active", "active status")

    d = deploy_rollback(d)
    assert(deploy_active_version(d) == "v1.0", "rolled back to v1.0")
    assert(deploy_get_traffic(d, "v1.0") == 100, "v1.0 100% after rollback")
    assert(deploy_status(d) == "rolled_back", "rolled_back status")

    print("DEPLOYMENT-STRATEGY KAT PASS")
