// _tile_math_test.nova — KAT for std/geo/tile_math
import std/geo/tile_math

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    let gi = 0
    if got
        gi = 1
    let ei = 0
    if expected
        ei = 1
    if gi != ei
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(ei))
        exit(1)

fn ckf(label, got, expected, eps)
    let diff = got - expected
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    if adiff > eps
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(expected))
        exit(1)

fn main()
    // tm_num_tiles: 2^3 = 8
    cki("tm_num_tiles(3)", tm_num_tiles(3), 8)

    // tm_total_tiles: 4^2 = 16
    cki("tm_total_tiles(2)", tm_total_tiles(2), 16)

    // tm_parent(3,5,3) -> [1,2,2]
    let p = tm_parent(3, 5, 3)
    let px = p[0] * 1
    let py = p[1] * 1
    let pz = p[2] * 1
    cki("tm_parent 3,5,3 x", px, 1)
    cki("tm_parent 3,5,3 y", py, 2)
    cki("tm_parent 3,5,3 z", pz, 2)

    // tm_children(1,2,2) -> 4 children at zoom 3, all valid
    let ch = tm_children(1, 2, 2)
    cki("tm_children count", len(ch), 4)
    // children of (1,2) at zoom 2 -> (2,4),(3,4),(2,5),(3,5) at zoom 3
    let c0 = ch[0]
    let c1 = ch[1]
    let c2 = ch[2]
    let c3 = ch[3]
    cki("tm_children c0 x", c0[0] * 1, 2)
    cki("tm_children c0 y", c0[1] * 1, 4)
    cki("tm_children c1 x", c1[0] * 1, 3)
    cki("tm_children c1 y", c1[1] * 1, 4)
    cki("tm_children c2 x", c2[0] * 1, 2)
    cki("tm_children c2 y", c2[1] * 1, 5)
    cki("tm_children c3 x", c3[0] * 1, 3)
    cki("tm_children c3 y", c3[1] * 1, 5)
    // All valid at zoom 3 (side=8): tx,ty in {2,3,4,5} all < 8
    ckb("tm_children c0 valid", tm_is_valid(c0[0]*1, c0[1]*1, 3), true)
    ckb("tm_children c1 valid", tm_is_valid(c1[0]*1, c1[1]*1, 3), true)
    ckb("tm_children c2 valid", tm_is_valid(c2[0]*1, c2[1]*1, 3), true)
    ckb("tm_children c3 valid", tm_is_valid(c3[0]*1, c3[1]*1, 3), true)

    // tm_lon_bounds(0, 1) -> [-180, 0]
    let lb0 = tm_lon_bounds(0, 1)
    ckf("tm_lon_bounds(0,1) west", lb0[0]*1.0, -180.0, 0.001)
    ckf("tm_lon_bounds(0,1) east", lb0[1]*1.0, 0.0, 0.001)

    // tm_lon_bounds(1, 1) -> [0, 180]
    let lb1 = tm_lon_bounds(1, 1)
    ckf("tm_lon_bounds(1,1) west", lb1[0]*1.0, 0.0, 0.001)
    ckf("tm_lon_bounds(1,1) east", lb1[1]*1.0, 180.0, 0.001)

    // tm_is_valid: (8, 0, 3) -> false (8 not < 8)
    ckb("tm_is_valid(8,0,3)", tm_is_valid(8, 0, 3), false)

    // tm_is_valid: (7, 7, 3) -> true
    ckb("tm_is_valid(7,7,3)", tm_is_valid(7, 7, 3), true)

    // tm_is_valid: (0, 0, 0) -> true
    ckb("tm_is_valid(0,0,0)", tm_is_valid(0, 0, 0), true)

    // tm_flip_y(5, 3): 2^3-1-5 = 7-5 = 2
    cki("tm_flip_y(5,3)", tm_flip_y(5, 3), 2)

    // tm_flip_y is an involution
    cki("tm_flip_y involution", tm_flip_y(tm_flip_y(5, 3), 3), 5)

    // tm_neighbors(0, 0, 2): corner tile, should have < 8 neighbors (3 max)
    let nb = tm_neighbors(0, 0, 2)
    let nb_count = len(nb)
    if nb_count >= 8
        print("FAIL tm_neighbors corner: got=" + str(nb_count) + " want <8")
        exit(1)
    if nb_count < 1
        print("FAIL tm_neighbors corner: got=0 want >=1")
        exit(1)

    // tm_morton(3, 5, 3):
    // tx=3=011, ty=5=101, 3 bits each
    // bit0: x=1->pos0, y=1->pos1: contributes 1+2=3
    // bit1: x=1->pos2, y=0->pos3: contributes 4+0=4
    // bit2: x=0->pos4, y=1->pos5: contributes 0+32=32
    // Total = 3+4+32 = 39
    cki("tm_morton(3,5,3)", tm_morton(3, 5, 3), 39)

    // tm_morton determinism: same call twice
    cki("tm_morton determinism", tm_morton(3, 5, 3), tm_morton(3, 5, 3))

    // tm_morton(0,0,3) = 0
    cki("tm_morton(0,0,3)", tm_morton(0, 0, 3), 0)

    // tm_ancestor: (3,5,3) up 2 levels -> (0,1,1)
    let anc = tm_ancestor(3, 5, 3, 2)
    cki("tm_ancestor x", anc[0]*1, 0)
    cki("tm_ancestor y", anc[1]*1, 1)
    cki("tm_ancestor z", anc[2]*1, 1)

    // tm_zoom_in(1,2) -> [2,4]
    let zi = tm_zoom_in(1, 2)
    cki("tm_zoom_in x", zi[0]*1, 2)
    cki("tm_zoom_in y", zi[1]*1, 4)

    // Parent of tm_zoom_in should return the original tile
    let zi2 = tm_zoom_in(1, 2)
    let zi2x = zi2[0] * 1
    let zi2y = zi2[1] * 1
    let p2 = tm_parent(zi2x, zi2y, 3)
    cki("tm_zoom_in parent x", p2[0]*1, 1)
    cki("tm_zoom_in parent y", p2[1]*1, 2)

    // Round-trip: tile at (1,2) lon_bounds -> center should match expected
    // zoom=2: 4 tiles per axis. tile 0=[-180,-90], tile 1=[-90,0], tile 2=[0,90], tile 3=[90,180]
    // tile 1 occupies [-90, 0], center = -45.0
    let lb_rt = tm_lon_bounds(1, 2)
    let w = lb_rt[0] * 1.0
    let e = lb_rt[1] * 1.0
    let ctr = (w + e) / 2.0
    ckf("tm_lon_bounds center", ctr, -45.0, 0.001)

    // Total tile count at zoom 3 = 8*8 = 64
    cki("tm_total_tiles(3)", tm_total_tiles(3), 64)

    print("PASS _tile_math_test")
