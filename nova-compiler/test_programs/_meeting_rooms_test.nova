import std/greedy/meeting_rooms

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _meeting_rooms_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _meeting_rooms_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // ── mr_can_attend_all ────────────────────────────────────────────────────
    // [0,30,5],[10,40,15]: meetings (0,10),(30,40),(5,15) - sorted: (0,10),(5,15) overlap -> false
    let st1 = []
    push(st1, 0)
    push(st1, 30)
    push(st1, 5)
    let en1 = []
    push(en1, 10)
    push(en1, 40)
    push(en1, 15)
    ckb("can_attend_false", mr_can_attend_all(st1, en1), false)

    // [7,0],[10,5]: meetings (7,10),(0,5) - sorted: (0,5),(7,10) - 5<=7 no overlap -> true
    let st2 = []
    push(st2, 7)
    push(st2, 0)
    let en2 = []
    push(en2, 10)
    push(en2, 5)
    ckb("can_attend_true", mr_can_attend_all(st2, en2), true)

    // empty: true
    let st_empty = []
    let en_empty = []
    ckb("can_attend_empty", mr_can_attend_all(st_empty, en_empty), true)

    // single: true
    let st_single = []
    push(st_single, 5)
    let en_single = []
    push(en_single, 10)
    ckb("can_attend_single", mr_can_attend_all(st_single, en_single), true)

    // touching: [0,5],[5,10] -> 5==5, start(5) not < end(5) -> true (no strict overlap)
    let st3 = []
    push(st3, 0)
    push(st3, 5)
    let en3 = []
    push(en3, 5)
    push(en3, 10)
    ckb("can_attend_touching", mr_can_attend_all(st3, en3), true)

    // ── mr_min_rooms ─────────────────────────────────────────────────────────
    // [0,5,15],[30,10,20]: meetings (0,30),(5,10),(15,20)
    // Events: 0s,5s,10e,15s,20e,30e -> max concurrent=2
    let st4 = []
    push(st4, 0)
    push(st4, 5)
    push(st4, 15)
    let en4 = []
    push(en4, 30)
    push(en4, 10)
    push(en4, 20)
    cki("min_rooms_2", mr_min_rooms(st4, en4), 2)

    // [0,5,10],[5,10,15]: meetings (0,5),(5,10),(10,15) - no overlap, ends before next starts
    // Events at same time: ends before starts -> 0s→1, 5e→0, 5s→1, 10e→0, 10s→1, 15e→0 -> max=1
    let st5 = []
    push(st5, 0)
    push(st5, 5)
    push(st5, 10)
    let en5 = []
    push(en5, 5)
    push(en5, 10)
    push(en5, 15)
    cki("min_rooms_1", mr_min_rooms(st5, en5), 1)

    // [1,2,3],[10,10,10]: all overlap -> 3 rooms
    let st6 = []
    push(st6, 1)
    push(st6, 2)
    push(st6, 3)
    let en6 = []
    push(en6, 10)
    push(en6, 10)
    push(en6, 10)
    cki("min_rooms_3", mr_min_rooms(st6, en6), 3)

    // empty: 0 rooms
    cki("min_rooms_empty", mr_min_rooms(st_empty, en_empty), 0)

    // single: 1 room
    cki("min_rooms_single", mr_min_rooms(st_single, en_single), 1)

    // two non-overlapping: [0,20],[30,50] -> 1 room
    let st7 = []
    push(st7, 0)
    push(st7, 30)
    let en7 = []
    push(en7, 20)
    push(en7, 50)
    cki("min_rooms_nonoverlap", mr_min_rooms(st7, en7), 1)

    print("PASS _meeting_rooms_test")
