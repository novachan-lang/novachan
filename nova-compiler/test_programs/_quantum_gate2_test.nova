import std/quantum/quantum_state
import std/quantum/quantum_gate2

// cki — integer known-answer check.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _quantum_gate2_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _round1000 — local test helper: round x*1000 to nearest int (handles negative x).
fn _round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// _make_x_gate — build a Pauli-X 2x2 gate matrix locally (this module does not
// import quantum_gate1, so the matrix is assembled here from raw complex
// numbers, same shape as qg1_x() would produce: [[0,1],[1,0]]).
fn _make_x_gate() -> list
    let row0 = []
    push(row0, qst_c(0.0, 0.0))
    push(row0, qst_c(1.0, 0.0))
    let row1 = []
    push(row1, qst_c(1.0, 0.0))
    push(row1, qst_c(0.0, 0.0))
    let g = []
    push(g, row0)
    push(g, row1)
    g

fn main()
    // qg2_cnot: control=1 flips target. |10> -> |11> = basis(2,3).
    let cn1 = qg2_cnot(qst_basis(2, 2), 0, 1)
    cki("cnot|10>=|11>", qst_equal_x1000(cn1, qst_basis(2, 3)), 1)

    // qg2_cnot: control=0 leaves state unchanged. |00> -> |00>.
    let cn2 = qg2_cnot(qst_basis(2, 0), 0, 1)
    cki("cnot|00>=|00>", qst_equal_x1000(cn2, qst_basis(2, 0)), 1)

    // qg2_cnot: control=1, target already 1. |11> -> |10> = basis(2,2).
    let cn3 = qg2_cnot(qst_basis(2, 3), 0, 1)
    cki("cnot|11>=|10>", qst_equal_x1000(cn3, qst_basis(2, 2)), 1)

    // qg2_swap: |01> -> |10>.
    let sw1 = qg2_swap(qst_basis(2, 1), 0, 1)
    cki("swap|01>=|10>", qst_equal_x1000(sw1, qst_basis(2, 2)), 1)

    // qg2_swap: |10> -> |01> (the reverse pair).
    let sw2 = qg2_swap(qst_basis(2, 2), 0, 1)
    cki("swap|10>=|01>", qst_equal_x1000(sw2, qst_basis(2, 1)), 1)

    // qg2_swap: |00> and |11> are fixed points (both qubits equal).
    let sw3 = qg2_swap(qst_basis(2, 0), 0, 1)
    cki("swap|00>=|00>", qst_equal_x1000(sw3, qst_basis(2, 0)), 1)
    let sw4 = qg2_swap(qst_basis(2, 3), 0, 1)
    cki("swap|11>=|11>", qst_equal_x1000(sw4, qst_basis(2, 3)), 1)

    // qg2_cz: |11> (basis(2,3)) both bits set -> amplitude negated.
    let cz1 = qg2_cz(qst_basis(2, 3), 0, 1)
    cki("cz|11> prob3", qst_prob_x1000(cz1, 3), 1000)
    let cz1amp = qst_amp(cz1, 3)
    cki("cz|11> amp3 re", _round1000(cz1amp[0]), -1000)

    // qg2_cz: |10> (basis(2,2)) only control set -> unchanged.
    let cz2 = qg2_cz(qst_basis(2, 2), 0, 1)
    cki("cz|10>=|10>", qst_equal_x1000(cz2, qst_basis(2, 2)), 1)

    // qg2_cz: |01> (basis(2,1)) only target set -> unchanged.
    let cz3 = qg2_cz(qst_basis(2, 1), 0, 1)
    cki("cz|01>=|01>", qst_equal_x1000(cz3, qst_basis(2, 1)), 1)

    // qg2_toffoli: both controls set (|110> = basis(3,6)) -> flips target -> |111> = basis(3,7).
    let tf1 = qg2_toffoli(qst_basis(3, 6), 0, 1, 2)
    cki("toffoli|110>=|111>", qst_equal_x1000(tf1, qst_basis(3, 7)), 1)

    // qg2_toffoli: only one control set (|010> = basis(3,2)) -> unchanged.
    let tf2 = qg2_toffoli(qst_basis(3, 2), 0, 1, 2)
    cki("toffoli|010>=|010>", qst_equal_x1000(tf2, qst_basis(3, 2)), 1)

    // qg2_toffoli: neither control set (|000>) -> unchanged.
    let tf3 = qg2_toffoli(qst_basis(3, 0), 0, 1, 2)
    cki("toffoli|000>=|000>", qst_equal_x1000(tf3, qst_basis(3, 0)), 1)

    // qg2_controlled with an X gate matches qg2_cnot exactly.
    let gx = _make_x_gate()
    let ctl1 = qg2_controlled(qst_basis(2, 2), 0, 1, gx)
    cki("controlled(X)|10>=|11>", qst_equal_x1000(ctl1, qst_basis(2, 3)), 1)
    let ctl2 = qg2_controlled(qst_basis(2, 0), 0, 1, gx)
    cki("controlled(X)|00>=|00>", qst_equal_x1000(ctl2, qst_basis(2, 0)), 1)

    print("PASS _quantum_gate2_test")
