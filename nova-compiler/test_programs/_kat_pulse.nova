import forge_pulse
import std/data/dataframe

fn main()
    let cols = ["name", "dept", "salary", "bonus"]
    let rows = [["Alice", "eng", 100, 10], ["Bob", "eng", 120, 15], ["Carol", "sales", 80, 8], ["Dave", "sales", 90, 12], ["Eve", "eng", 110, 11]]
    let df = df_new(cols, rows)

    let desc = pulse_describe(df)
    assert(desc["salary"]["count"] == 5, "describe count 5")
    assert(desc["salary"]["min"] == 80, "describe min 80")
    assert(desc["salary"]["max"] == 120, "describe max 120")
    let salary_sum = desc["salary"]["sum"] * 1.0
    assert(salary_sum > 499.0 and salary_sum < 501.0, "describe sum 500")

    let dept_sum = pulse_agg(df, "dept", "salary", "sum")
    let eng_sum = dept_sum["eng"] * 1.0
    assert(eng_sum > 329.0 and eng_sum < 331.0, "eng salary sum 330")
    let sales_sum = dept_sum["sales"] * 1.0
    assert(sales_sum > 169.0 and sales_sum < 171.0, "sales salary sum 170")

    let dept_count = pulse_agg(df, "dept", "salary", "count")
    assert(dept_count["eng"] == 3, "eng count 3")
    assert(dept_count["sales"] == 2, "sales count 2")

    let rolling = pulse_rolling(df, "salary", 3, "mean")
    assert(len(rolling) == 5, "rolling has 5 entries")
    let r0 = rolling[0] * 1.0
    assert(r0 > 99.0 and r0 < 101.0, "rolling[0] = 100")
    let r2 = rolling[2] * 1.0
    assert(r2 > 99.0 and r2 < 101.0, "rolling[2] = 100")

    let ct = pulse_crosstab(df, "dept", "name")
    assert(ct["eng"]["Alice"] == 1, "crosstab eng/Alice")
    assert(ct["sales"]["Dave"] == 1, "crosstab sales/Dave")

    let corr = pulse_corr(df, "salary", "bonus") * 1.0
    assert(corr > 0.5, "salary-bonus correlation positive")

    let csv = "name,age,score\nAlice,30,95\nBob,25,87\nCarol,35,92"
    let csv_df = pulse_from_csv(csv, ",")
    assert(df_nrows(csv_df) == 3, "csv 3 rows")
    let ages = df_col(csv_df, "age")
    assert(ages[0] == 30, "csv age[0]=30")
    assert(ages[2] == 35, "csv age[2]=35")

    print("FORGE-PULSE KAT PASS")
