import forge_membership

fn main()
    let m = mem_new()
    m = mem_join(m, "node-1", "10.0.0.1:8080")
    m = mem_join(m, "node-2", "10.0.0.2:8080")
    m = mem_join(m, "node-3", "10.0.0.3:8080")
    assert(mem_member_count(m) == 3, "3 members")
    assert(mem_alive_count(m) == 3, "3 alive")

    assert(mem_status(m, "node-1") == "alive", "node-1 alive")
    assert(mem_address(m, "node-2") == "10.0.0.2:8080", "node-2 address")

    m = mem_suspect(m, "node-2")
    assert(mem_status(m, "node-2") == "suspect", "node-2 suspect")
    assert(mem_alive_count(m) == 2, "2 alive")

    m = mem_confirm_alive(m, "node-2")
    assert(mem_status(m, "node-2") == "alive", "node-2 recovered")
    assert(mem_alive_count(m) == 3, "3 alive again")

    m = mem_leave(m, "node-3")
    assert(mem_status(m, "node-3") == "left", "node-3 left")
    assert(mem_alive_count(m) == 2, "2 alive after leave")
    assert(mem_member_count(m) == 3, "still 3 total members")

    let alive = mem_alive_members(m)
    assert(len(alive) == 2, "2 alive members")

    assert(mem_status(m, "nonexistent") == "", "missing = empty")
    assert(mem_address(m, "nonexistent") == "", "missing addr = empty")

    print("MEMBERSHIP KAT PASS")
