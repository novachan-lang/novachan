// _struct_enum_payload_test.nova -- CORE_GAP 0.8: enum-variant managed-payload ownership + slot mapping.
// Enum variants are lowered as normal (non-repr_c) HASHED structs: slot 0 = type hash (the match
// discriminant), payload fields at slot 1+. So the managed-slot bitmap's (field_i + 1) mapping must hold
// for variants exactly as for plain structs. This drives 2000 Full(list) variants, each rebound (and so
// dropped) on the next iteration: FULLRC rebind-drops the previous variant -> its rc_free must dec slot 1
// (the payload list) via the bitmap. If the variant slot mapping were off-by-one, payloads would leak
// (miss the list) or a scalar/discriminant slot would be dec'd (crash).
//
// The variant is intentionally NOT matched/read here: reading a variant's payload needs a match-binding
// (stores a borrow into a slot) or a user call, both of which conservatively PIN the subject alive -- a
// separate, SAFE FULLRC drop-coverage limitation (also true of `push`ing a fresh value into a container),
// not the field-OWNERSHIP gap under test. Dropping the unused variant is exactly the drop path 0.8 fixes.

enum Box
    Full(items: list)
    Empty()

fn main()
    let base = live_count()
    let n = 0
    let j = 0
    while j < 2000
        let _b = Full([j, j + 1, j + 2])   // fresh list payload; dropped on next rebind
        n = n + j
        j = j + 1
    let delta = live_count() - base
    // churn to reuse any wrongly-freed payload memory (a UAF corrupts these reused blocks).
    let junk = []
    let k = 0
    while k < 500
        push(junk, [k])
        k = k + 1
    print("struct_enum_payload delta=" + str(delta) + " n=" + str(n))
    if n != 1999000
        print("struct_enum_payload_test FAILED: value corruption n=" + str(n))
        exit(1)
    // Each rebound variant + its list payload must be reclaimed -> delta ~O(1). A wrong slot mapping
    // (missed the list) would leave ~2000; a crash would mean the discriminant/scalar slot was dec'd.
    if delta > 100
        print("struct_enum_payload_test FAILED: variant managed payload leaks on drop delta=" + str(delta))
        exit(1)
    print("struct_enum_payload_test passed (enum variant managed payload owned + freed on drop; slot mapping correct)")
