// forge_pg_live_test -- LIVE integration for the pure-NOVA Postgres driver (plaintext, Unit 1). Connects to
// a real PG server over tcp_*, drives the v3 startup + auth handshake (cleartext/MD5/SCRAM-SHA-256), and --
// if credentials let it in -- runs a real SELECT round-trip. Connection params come from the standard PG
// env vars (PGHOST/PGPORT/PGUSER/PGDATABASE/PGPASSWORD) with localhost/postgres defaults, so creds are
// supplied WITHOUT editing code. The server being UP is required (skips cleanly if it is down). This gates
// the LIVE wire plumbing: a structured pg: error (auth failed / db missing / SSL required) still proves
// connect + startup + the framed read-loop + auth-method handling + error parsing all work end to end.
import forge_pg

fn _envor(name: string, dflt: string) -> string
    let v = env(name)
    if len(v) > 0
        return v
    dflt

fn main()
    let host = _envor("PGHOST", "127.0.0.1")
    let port = parse_int(_envor("PGPORT", "5432"))
    let user = _envor("PGUSER", "postgres")
    let db = _envor("PGDATABASE", "postgres")
    let password = _envor("PGPASSWORD", "postgres")
    print("connecting to pg " + host + ":" + str(port) + " user=" + user + " db=" + db)
    let r = pg_connect(host, port, user, db, password)
    match r
        Ok(sock) =>
            print("LIVE PG CONNECT OK (full auth handshake completed)")
            let q = pg_exec(sock, "SELECT 1 AS one, 'hello'::text AS greet")
            match q
                Ok(rows) =>
                    if len(rows) < 1
                        print("FAIL: SELECT returned no rows")
                        exit(1)
                    let row = rows[0]
                    print("row: one=" + row["one"] + " greet=" + row["greet"])
                    assert_eq(row["one"], "1")
                    assert_eq(row["greet"], "hello")
                    print("LIVE PG ROUND-TRIP OK (real SELECT over a real socket)")
                Err(e) =>
                    print("FAIL: query error: " + e)
                    exit(1)
            pg_close(sock)
        Err(e) =>
            // The server is up; a STRUCTURED pg: error (auth/config) still proves the live plumbing drove
            // the startup + read-loop + auth-method handling + error parse correctly. A hang/crash would not
            // produce this (and kill-on-timeout would catch a hang).
            print("PG connect returned a structured error: " + e)
            assert(starts_with(e, "pg:"), "error is a structured pg: error (live plumbing reached the server)")
            print("LIVE PG PLUMBING OK (set PGUSER/PGPASSWORD/PGDATABASE for the full round-trip)")
    print("forge_pg_live_test passed")
