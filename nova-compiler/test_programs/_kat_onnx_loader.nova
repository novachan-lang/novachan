// Canonical KAT test for std/ml/onnx_loader.
//
// Builds a minimal but structurally realistic ONNX ModelProto ENTIRELY
// in-memory using std/encoding/protobuf's own encoder primitives (plus raw
// vi_encode from std/encoding/varint for the packed-varint dims case) —
// there is no .onnx fixture file on disk. This doubles as an integration
// check between onnx_loader and protobuf.nova: if either module's wire
// framing drifted, this test desynchronizes and fails loudly rather than
// silently reading garbage.
//
// Model under test: a single Add node  Z = Add(X, Y)
//   inputs:  X (external), Y (initializer, shape [1,3])
//   outputs: Z (external)
//   plus a second initializer W (shape [224,224], packed-varint dims) and
//   assorted unknown/skippable fields (attribute payload, doc_string,
//   fixed32/fixed64 junk fields) interleaved to prove the skip-path never
//   corrupts adjacent field parsing.
//
// onnx_parse(data) returns Result (Ok(model dict) / Err(message)) — per the
// documented NOVA gotcha that `match` arms on Result may not execute
// reliably, every check here goes through is_ok()/is_err()/unwrap()/
// unwrap_err() instead of `match ... Ok(..) => / Err(..) =>`.

import std/ml/onnx_loader
import std/encoding/protobuf
import std/encoding/varint

// ── local assertion helpers (single-exit, no return-null/return-value mix) ──

fn eq_i(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn eq_s(name: string, got: string, want: string)
    if got != want
        print("FAIL " + name + ": got '" + got + "' want '" + want + "'")
        exit(1)
    print("ok " + name)

fn eq_list_s(name: string, got: list, want: list)
    let n = len(got)
    let m = len(want)
    if n != m
        print("FAIL " + name + ": length got " + str(n) + " want " + str(m))
        exit(1)
    let i = 0
    while i < n
        if got[i] != want[i]
            print("FAIL " + name + ": at index " + str(i) + " got '" + got[i] + "' want '" + want[i] + "'")
            exit(1)
        i = i + 1
    print("ok " + name)

fn eq_list_i(name: string, got: list, want: list)
    let n = len(got)
    let m = len(want)
    if n != m
        print("FAIL " + name + ": length got " + str(n) + " want " + str(m))
        exit(1)
    let i = 0
    while i < n
        if got[i] != want[i]
            print("FAIL " + name + ": at index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1
    print("ok " + name)

// asserts r is Ok, prints ok/FAIL, and returns the unwrapped payload
// (single trailing return -- avoids the documented return-null/return-value
// mistag by never spelling `return null` on any path).
fn _parse_ok(name: string, r: Result) -> any
    let v = null
    if is_ok(r) == 1
        print("ok " + name)
        v = unwrap(r)
    else
        print("FAIL " + name + ": expected Ok, got Err: " + unwrap_err(r))
        exit(1)
    return v

fn _parse_err(name: string, r: Result)
    if is_err(r) == 1
        print("ok " + name)
    else
        print("FAIL " + name + ": expected Err, got Ok")
        exit(1)

// ── field builders (all go through protobuf.nova so the on-wire shape is
//    exactly what a real protoc-generated encoder would produce) ───────────

fn _node_bytes() -> any
    let junk_attr = str_to_bytes("ignored-attribute-payload")
    let out = bytes(0)
    out = bytes_concat(out, pb_encode_string_field(1, "X"))       // input
    out = bytes_concat(out, pb_encode_string_field(1, "Y"))       // input (repeated)
    out = bytes_concat(out, pb_encode_string_field(2, "Z"))       // output
    out = bytes_concat(out, pb_encode_field(5, pb_wire_len(), junk_attr)) // attribute (skipped)
    out = bytes_concat(out, pb_encode_string_field(3, "add1"))    // name
    out = bytes_concat(out, pb_encode_string_field(4, "Add"))     // op_type
    out

fn _tensor_y_bytes() -> any
    // dims = [1, 3] via UNPACKED varint occurrences (field 1 repeated VARINT).
    let out = bytes(0)
    out = bytes_concat(out, pb_encode_varint_field(1, 1))
    out = bytes_concat(out, pb_encode_varint_field(1, 3))
    out = bytes_concat(out, pb_encode_string_field(8, "Y"))
    out

fn _tensor_w_bytes() -> any
    // dims = [224, 224] via PACKED varint (single LEN field 1 occurrence
    // holding two concatenated raw varints) -- the proto3-default encoding.
    let packed = bytes_concat(vi_encode(224), vi_encode(224))
    let out = bytes(0)
    out = bytes_concat(out, pb_encode_field(1, pb_wire_len(), packed))
    out = bytes_concat(out, pb_encode_string_field(8, "W"))
    out

fn _graph_bytes() -> any
    let out = bytes(0)
    out = bytes_concat(out, pb_encode_field(1, pb_wire_len(), _node_bytes()))       // node
    out = bytes_concat(out, pb_encode_string_field(2, "test_graph"))                // name
    out = bytes_concat(out, pb_encode_field(5, pb_wire_len(), _tensor_y_bytes()))   // initializer Y
    out = bytes_concat(out, pb_encode_field(5, pb_wire_len(), _tensor_w_bytes()))   // initializer W
    out = bytes_concat(out, pb_encode_field(11, pb_wire_len(), pb_encode_string_field(1, "X"))) // input
    out = bytes_concat(out, pb_encode_field(12, pb_wire_len(), pb_encode_string_field(1, "Z"))) // output
    out

fn _opset_bytes() -> any
    // domain omitted -> defaults to "" (the ai.onnx core domain).
    pb_encode_varint_field(2, 13)

fn _full_model_bytes() -> any
    let out = bytes(0)
    out = bytes_concat(out, pb_encode_varint_field(1, 7))                    // ir_version
    out = bytes_concat(out, pb_encode_string_field(2, "nova-test"))          // producer_name
    out = bytes_concat(out, pb_encode_string_field(3, "1.0"))                // producer_version
    out = bytes_concat(out, pb_encode_string_field(4, "test.domain"))        // domain
    out = bytes_concat(out, pb_encode_varint_field(5, 1))                    // model_version
    out = bytes_concat(out, pb_encode_string_field(6, "unused doc string"))  // doc_string (skipped)
    out = bytes_concat(out, pb_encode_fixed32_field(99, 12345))              // unknown I32 field (skipped)
    out = bytes_concat(out, pb_encode_fixed64_field(100, 999999))            // unknown I64 field (skipped)
    out = bytes_concat(out, pb_encode_field(7, pb_wire_len(), _graph_bytes())) // graph
    out = bytes_concat(out, pb_encode_field(8, pb_wire_len(), _opset_bytes())) // opset_import
    out

fn main()
    // ── full model: every field exercised ───────────────────────────────
    let model_bytes = _full_model_bytes()
    let model = _parse_ok("onnx_parse full model", onnx_parse(model_bytes))

    eq_i("ir_version", model["ir_version"], 7)
    eq_s("producer_name", model["producer_name"], "nova-test")
    eq_s("producer_version", model["producer_version"], "1.0")
    eq_s("domain", model["domain"], "test.domain")
    eq_i("model_version", model["model_version"], 1)
    eq_s("graph_name", model["graph_name"], "test_graph")

    eq_i("onnx_node_count", onnx_node_count(model), 1)
    eq_i("onnx_opset_version (default domain)", onnx_opset_version(model), 13)

    eq_list_s("onnx_input_names", onnx_input_names(model), ["X"])
    eq_list_s("onnx_output_names", onnx_output_names(model), ["Z"])

    eq_list_s("initializer_names", model["initializer_names"], ["Y", "W"])

    let shapes = onnx_tensor_shapes(model)
    if contains(shapes, "Y") == false
        print("FAIL tensor_shapes: missing key 'Y'")
        exit(1)
    eq_list_i("tensor_shapes[Y] (unpacked dims)", shapes["Y"], [1, 3])
    if contains(shapes, "W") == false
        print("FAIL tensor_shapes: missing key 'W'")
        exit(1)
    eq_list_i("tensor_shapes[W] (packed dims)", shapes["W"], [224, 224])

    let nodes = model["nodes"]
    eq_i("nodes length", len(nodes), 1)
    let n0 = nodes[0]
    eq_s("node[0].op_type", n0["op_type"], "Add")
    eq_s("node[0].name", n0["name"], "add1")
    eq_list_s("node[0].inputs", n0["inputs"], ["X", "Y"])
    eq_list_s("node[0].outputs", n0["outputs"], ["Z"])

    let opsets = model["opset_import"]
    eq_i("opset_import length", len(opsets), 1)
    eq_s("opset_import[0].domain", opsets[0]["domain"], "")
    eq_i("opset_import[0].version", opsets[0]["version"], 13)

    // ── minimal model: only ir_version present -> every other field must
    //    default cleanly (no graph, no opset_import at all) ────────────────
    let minimal_bytes = pb_encode_varint_field(1, 3)
    let minimal = _parse_ok("onnx_parse minimal model", onnx_parse(minimal_bytes))
    eq_i("minimal.ir_version", minimal["ir_version"], 3)
    eq_s("minimal.graph_name (default)", minimal["graph_name"], "")
    eq_i("minimal onnx_node_count (default)", onnx_node_count(minimal), 0)
    eq_i("minimal onnx_opset_version (no opsets -> fallback 0)", onnx_opset_version(minimal), 0)
    eq_list_s("minimal onnx_input_names (default)", onnx_input_names(minimal), [])
    eq_list_s("minimal onnx_output_names (default)", onnx_output_names(minimal), [])
    if contains(onnx_tensor_shapes(minimal), "Y")
        print("FAIL minimal tensor_shapes: unexpected key 'Y'")
        exit(1)
    print("ok minimal tensor_shapes empty")

    // ── malformed / adversarial input ───────────────────────────────────
    _parse_err("onnx_parse empty buffer -> Err", onnx_parse(bytes(0)))

    // A single tag byte using wire type 3 (deprecated START_GROUP) at the
    // top level: cannot be skipped without a schema, must report Err rather
    // than silently misreading the rest of the (nonexistent) buffer.
    let group_tag_only = pb_encode_tag(1, 3)
    _parse_err("onnx_parse invalid/group wire type -> Err", onnx_parse(group_tag_only))

    print("ALL ONNX_LOADER KAT CHECKS PASSED")
