import std/graph/euler_path

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT 1: ep_has_euler_circuit([[1,3],[0,2],[1,3],[0,2]],4)=true
    // Square cycle: 0-1-2-3-0, all degrees = 2 (even), connected
    let adj1 = []
    push(adj1, [1, 3])
    push(adj1, [0, 2])
    push(adj1, [1, 3])
    push(adj1, [0, 2])
    ckb("circuit_square", ep_has_euler_circuit(adj1, 4), true)

    // KAT 2: ep_has_euler_path([[1],[0,2],[1]],3)=true
    // Path 0-1-2: node 0 deg=1 (odd), node 1 deg=2 (even), node 2 deg=1 (odd) => exactly 2 odd => euler path
    let adj2 = []
    push(adj2, [1])
    push(adj2, [0, 2])
    push(adj2, [1])
    ckb("path_line", ep_has_euler_path(adj2, 3), true)

    // KAT 3: ep_has_euler_circuit([[1],[0,2],[1]],3)=false
    // Path graph: has 2 odd-degree vertices => no circuit
    ckb("circuit_line_false", ep_has_euler_circuit(adj2, 3), false)

    // KAT 4: ep_has_euler_path([[1,2,3],[0],[0],[0]],4)=false
    // Star: center=0 deg=3 (odd), leaves deg=1 (odd) => 4 odd vertices => no euler path
    let adj4 = []
    push(adj4, [1, 2, 3])
    push(adj4, [0])
    push(adj4, [0])
    push(adj4, [0])
    ckb("path_star_false", ep_has_euler_path(adj4, 4), false)

    // KAT 5: ep_circuit_length([[1,3],[0,2],[1,3],[0,2]],4)=4
    // Square has 4 edges total
    cki("circuit_len_square", ep_circuit_length(adj1, 4), 4)

    // Additional: circuit_length on line graph => -1 (no circuit)
    cki("circuit_len_line_neg", ep_circuit_length(adj2, 3), -1)

    // Empty graph: n=0 => false for circuit and path
    let adj0 = []
    ckb("circuit_empty_false", ep_has_euler_circuit(adj0, 0), false)
    ckb("path_empty_false", ep_has_euler_path(adj0, 0), false)
    cki("circuit_len_empty_neg", ep_circuit_length(adj0, 0), -1)

    // Single node, no edges: isolated => false (no non-isolated vertices => trivially connected but no edges)
    let adj_one = []
    push(adj_one, [])
    // Degree=0, so 0 odd vertices, all non-isolated vertices connected (none exist)
    // ep_has_euler_circuit: 0 odd => returns true BUT the graph has no edges so circuit length=0
    // Actually: circuit of length 0 is valid (trivial circuit on isolated node)
    // The spec says "ignore isolated vertices for connectivity": the single node is isolated
    // so it's trivially connected; 0 odd vertices means circuit exists (trivial circuit = 0 edges)
    // Circuit_length = 0 in this case (sum of degrees / 2 = 0)
    cki("circuit_len_single", ep_circuit_length(adj_one, 1), 0)

    // Triangle: all degree 2 => circuit
    let adj3 = []
    push(adj3, [1, 2])
    push(adj3, [0, 2])
    push(adj3, [0, 1])
    ckb("circuit_triangle", ep_has_euler_circuit(adj3, 3), true)
    cki("circuit_len_triangle", ep_circuit_length(adj3, 3), 3)

    // Disconnected: 0-1 edge and isolated node 2
    let adj_disc = []
    push(adj_disc, [1])
    push(adj_disc, [0])
    push(adj_disc, [])
    // Non-isolated: 0,1 — connected to each other. Node 2 ignored.
    // Both 0 and 1 have odd degree (1 each) => 2 odd => euler path but not circuit
    ckb("path_disconnected_iso", ep_has_euler_path(adj_disc, 3), true)
    ckb("circuit_disconnected_iso", ep_has_euler_circuit(adj_disc, 3), false)

    print("PASS _euler_path_test")

main()
