// KAT test for std/text/textrank
import std/text/textrank

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Text where 'graph', 'connect', 'nodes' co-occur frequently.
    let text = "graph nodes connect graph edges connect nodes graph connect"

    // 1. tr_node_count: distinct words in tokenized text
    //    words: graph, nodes, connect, edges => 4 distinct
    let tokens = ["graph", "nodes", "connect", "graph", "edges", "connect", "nodes", "graph", "connect"]
    let g = tr_build_graph(tokens, 4)
    let nc = tr_node_count(g)
    cki("node_count", nc, 4)

    // 2. PageRank is deterministic: two calls return the same top word
    let top1 = tr_top_word(text)
    let top2 = tr_top_word(text)
    if top1 != top2
        print("FAIL determinism: first=" + top1 + " second=" + top2)
        exit(1)

    // 3. tr_top_word is one of the words in the text (any is valid; all 4 words
    //    have near-equal PageRank on this fully-connected 4-node graph).
    if top1 != "graph" and top1 != "connect" and top1 != "nodes" and top1 != "edges"
        print("FAIL top_word_expected: got '" + top1 + "' — must be a word from the text")
        exit(1)

    // 4. tr_keywords returns exactly 3 words
    let kws = tr_keywords(text, 3)
    cki("keywords_count", len(kws), 3)

    // 5. tr_rank_words returns a dict; all scores are positive
    let scores = tr_rank_words(text)
    let ks = keys(scores)
    if len(ks) == 0
        print("FAIL rank_words_empty")
        exit(1)
    let all_pos = true
    let i = 0
    while i < len(ks)
        let s = scores[ks[i]]
        if s <= 0.0
            all_pos = false
        i = i + 1
    ckb("all_scores_positive", all_pos, true)

    // 6. tr_edge_weight: 'graph' and 'nodes' co-occur in window => weight >= 1.0
    let ew = tr_edge_weight(g, "graph", "nodes")
    if ew < 1.0
        print("FAIL edge_weight_graph_nodes: got " + str(ew) + " expected >= 1.0")
        exit(1)

    // 7. tr_edge_weight: non-existent edge returns 0.0
    let ew_none = tr_edge_weight(g, "graph", "zzz")
    if ew_none != 0.0
        print("FAIL edge_weight_absent: got " + str(ew_none) + " expected 0.0")
        exit(1)

    // 8. tr_neighbors: 'graph' has neighbors (connect, nodes, edges)
    let nb = tr_neighbors(g, "graph")
    if len(nb) < 1
        print("FAIL neighbors_graph: got " + str(len(nb)) + " expected >= 1")
        exit(1)

    // 9. tr_neighbors for unknown word returns []
    let nb_unk = tr_neighbors(g, "zzz")
    cki("neighbors_unknown", len(nb_unk), 0)

    // 10. tr_normalize_scores: max score == 1.0
    let normalized = tr_normalize_scores(scores)
    let nks = keys(normalized)
    let max_norm = 0.0
    let ni = 0
    while ni < len(nks)
        let s = normalized[nks[ni]]
        if s > max_norm
            max_norm = s
        ni = ni + 1
    if max_norm < 0.99 or max_norm > 1.01
        print("FAIL normalize_max: got " + str(max_norm) + " expected ~1.0")
        exit(1)

    // 11. In a deliberately star-topology graph, the hub word outscores the leaves.
    //     Build a chain 'hub alpha beta gamma' repeated so hub co-occurs with many unique words;
    //     leaves are rare and isolated. Window=2 ensures only adjacent pairs connect.
    //     Topology: hub-alpha, hub-beta, hub-gamma as separate pairs.
    let star_tokens = ["hub", "alpha", "hub", "beta", "hub", "gamma", "hub", "delta"]
    let star_g = tr_build_graph(star_tokens, 2)
    let star_scores = tr_pagerank(star_g, 0.85, 20)
    // hub co-occurs with alpha,beta,gamma,delta (4 neighbors); each leaf has only hub as neighbor.
    // In PageRank on this star: hub receives contributions from all 4 leaves each iteration,
    // while leaves only receive from hub. Hub score >> leaf score.
    let hub_score = star_scores["hub"]
    let alpha_score = star_scores["alpha"]
    if hub_score <= alpha_score
        print("FAIL hub_gt_leaf: hub=" + str(hub_score) + " alpha=" + str(alpha_score))
        exit(1)

    // 12. tr_summarize: multi-sentence text returns correct count
    let text2 = "The graph has many nodes. Each node connects to others. Connections form the structure."
    let summary = tr_summarize(text2, 2)
    if len(summary) < 1
        print("FAIL summarize_empty: got 0 sentences")
        exit(1)
    if len(summary) > 2
        print("FAIL summarize_over: got " + str(len(summary)) + " expected <= 2")
        exit(1)

    // 13. tr_summarize on single-sentence text returns 1 sentence
    let single = tr_summarize("One sentence only.", 3)
    cki("summarize_single", len(single), 1)

    // 14. tr_keywords first word is a non-empty content word from the text.
    //     All 4 words (graph/connect/nodes/edges) are valid top words given the
    //     near-uniform PageRank on a fully-connected 4-node graph.
    let kw0 = kws[0]
    if len(kw0) == 0
        print("FAIL keywords_first_nonempty: got empty string")
        exit(1)
    // For a star text where one word clearly dominates, check that separately.
    let star_text = "hub alpha hub beta hub gamma hub delta hub epsilon"
    let star_kws = tr_keywords(star_text, 1)
    if len(star_kws) < 1
        print("FAIL star_kws_empty")
        exit(1)
    let star_top = star_kws[0]
    if star_top != "hub"
        print("FAIL star_top_word: got '" + star_top + "' expected 'hub'")
        exit(1)

    // 15. Empty text safety
    let empty_g = tr_build_graph([], 4)
    cki("empty_graph_nodes", tr_node_count(empty_g), 0)
    let empty_scores = tr_pagerank(empty_g, 0.85, 20)
    cki("empty_pagerank_keys", len(keys(empty_scores)), 0)
    let empty_top = tr_top_word("")
    cki("empty_top_word_len", len(empty_top), 0)

    print("PASS _textrank_test")
