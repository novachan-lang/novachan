// KAT test for std/compress/elias
// Verifies: gamma encoding bitstrings, delta encoding bitstrings,
//           round-trips for both codes, list encode/decode round-trip.
import std/compress/elias

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1: el_gamma_encode known bitstrings ───────────────────────────────────
// From spec and manual derivation:
//   n=1:  k=0, zeros="",     bits(1,1)="1"        -> "1"
//   n=2:  k=1, zeros="0",    bits(2,2)="10"       -> "010"
//   n=5:  k=2, zeros="00",   bits(5,3)="101"      -> "00101"
//   n=9:  k=3, zeros="000",  bits(9,4)="1001"     -> "0001001"
//   n=20: k=4, zeros="0000", bits(20,5)="10100"   -> "000010100"
//   n=100:k=6, zeros x6,     bits(100,7)="1100100"-> "0000001100100"
cks("gamma_1",   el_gamma_encode(1),   "1")
cks("gamma_2",   el_gamma_encode(2),   "010")
cks("gamma_5",   el_gamma_encode(5),   "00101")
cks("gamma_9",   el_gamma_encode(9),   "0001001")
cks("gamma_20",  el_gamma_encode(20),  "000010100")
cks("gamma_100", el_gamma_encode(100), "0000001100100")

// ── KAT 2: el_gamma_decode round-trips ────────────────────────────────────────
// el_gamma_decode(el_gamma_encode(n))[0] must equal n.
let gr1 = el_gamma_decode(el_gamma_encode(1))
cki("gamma_rt_1_val",  gr1[0], 1)
cki("gamma_rt_1_pos",  gr1[1], 1)

let gr2 = el_gamma_decode(el_gamma_encode(2))
cki("gamma_rt_2_val",  gr2[0], 2)
cki("gamma_rt_2_pos",  gr2[1], 3)

let gr5 = el_gamma_decode(el_gamma_encode(5))
cki("gamma_rt_5_val",  gr5[0], 5)
cki("gamma_rt_5_pos",  gr5[1], 5)

let gr9 = el_gamma_decode(el_gamma_encode(9))
cki("gamma_rt_9_val",  gr9[0], 9)
cki("gamma_rt_9_pos",  gr9[1], 7)

let gr20 = el_gamma_decode(el_gamma_encode(20))
cki("gamma_rt_20_val", gr20[0], 20)

let gr100 = el_gamma_decode(el_gamma_encode(100))
cki("gamma_rt_100_val", gr100[0], 100)

// ── KAT 3: el_delta_encode known bitstrings ───────────────────────────────────
// Manual derivation:
//   n=1:   k=0, gamma(1)="1",      0 low bits -> "1"
//   n=2:   k=1, gamma(2)="010",    low1(2)=0  -> "0100"
//   n=5:   k=2, gamma(3)="011",    low2(5)=01 -> "01101"
//   n=9:   k=3, gamma(4)="00100",  low3(9)=001 -> "00100001"
//   n=20:  k=4, gamma(5)="00101",  low4(20)=0100 -> "001010100"
//   n=100: k=6, gamma(7)="0000111",low6(100)=100100 -> "0000111100100"
cks("delta_1",   el_delta_encode(1),   "1")
cks("delta_2",   el_delta_encode(2),   "0100")
cks("delta_5",   el_delta_encode(5),   "01101")
cks("delta_9",   el_delta_encode(9),   "00100001")
cks("delta_20",  el_delta_encode(20),  "001010100")
cks("delta_100", el_delta_encode(100), "00111100100")

// ── KAT 4: el_delta_decode round-trips ────────────────────────────────────────
let dr1 = el_delta_decode(el_delta_encode(1))
cki("delta_rt_1_val",   dr1[0], 1)

let dr2 = el_delta_decode(el_delta_encode(2))
cki("delta_rt_2_val",   dr2[0], 2)

let dr5 = el_delta_decode(el_delta_encode(5))
cki("delta_rt_5_val",   dr5[0], 5)

let dr9 = el_delta_decode(el_delta_encode(9))
cki("delta_rt_9_val",   dr9[0], 9)

let dr20 = el_delta_decode(el_delta_encode(20))
cki("delta_rt_20_val",  dr20[0], 20)

let dr100 = el_delta_decode(el_delta_encode(100))
cki("delta_rt_100_val", dr100[0], 100)

// ── KAT 5: el_encode_list + el_decode_list round-trip ─────────────────────────
// [1,2,3]: "1" ++ "010" ++ "011" = "1010011"
let xs123 = []
xs123.push(1)
xs123.push(2)
xs123.push(3)
let bits123 = el_encode_list(xs123)
cks("enc_list_1_2_3", bits123, "1010011")
let dec123 = el_decode_list(bits123, 3)
cki("dec_list_1", dec123[0], 1)
cki("dec_list_2", dec123[1], 2)
cki("dec_list_3", dec123[2], 3)

// ── KAT 6: el_encode_list + el_decode_list with larger values ─────────────────
let xs_big = []
xs_big.push(5)
xs_big.push(9)
xs_big.push(20)
xs_big.push(100)
let bits_big = el_encode_list(xs_big)
let dec_big = el_decode_list(bits_big, 4)
cki("dec_big_5",   dec_big[0], 5)
cki("dec_big_9",   dec_big[1], 9)
cki("dec_big_20",  dec_big[2], 20)
cki("dec_big_100", dec_big[3], 100)

// ── KAT 7: single-element list round-trips ────────────────────────────────────
let xs_one = []
xs_one.push(7)
let bits_one = el_encode_list(xs_one)
let dec_one = el_decode_list(bits_one, 1)
cki("dec_one_7", dec_one[0], 7)

let xs_one2 = []
xs_one2.push(1)
let bits_one2 = el_encode_list(xs_one2)
let dec_one2 = el_decode_list(bits_one2, 1)
cki("dec_one_1", dec_one2[0], 1)

// ── KAT 8: verify gamma decode next_pos for concatenated values ───────────────
// Decode the second value from a concatenated bitstring manually.
// gamma(3)="011" ++ gamma(4)="00100" = "01100100"
// Decode pos=0 -> value=3, next_pos=3
// Then use next_pos to start the second decode (simulate via decode_list).
let xs_concat = []
xs_concat.push(3)
xs_concat.push(4)
let bits_concat = el_encode_list(xs_concat)
cks("concat_bits", bits_concat, "01100100")
let dec_concat = el_decode_list(bits_concat, 2)
cki("dec_concat_3", dec_concat[0], 3)
cki("dec_concat_4", dec_concat[1], 4)

// ── KAT 9: gamma edge case — power-of-two values ─────────────────────────────
// n=4:  k=2, "00100"
// n=8:  k=3, "0001000"
// n=16: k=4, "000010000"
cks("gamma_4",  el_gamma_encode(4),  "00100")
cks("gamma_8",  el_gamma_encode(8),  "0001000")
cks("gamma_16", el_gamma_encode(16), "000010000")
let gr4  = el_gamma_decode(el_gamma_encode(4))
cki("gamma_rt_4_val",  gr4[0],  4)
let gr8  = el_gamma_decode(el_gamma_encode(8))
cki("gamma_rt_8_val",  gr8[0],  8)
let gr16 = el_gamma_decode(el_gamma_encode(16))
cki("gamma_rt_16_val", gr16[0], 16)

// ── KAT 10: delta edge cases ──────────────────────────────────────────────────
let dr3  = el_delta_decode(el_delta_encode(3))
cki("delta_rt_3_val",  dr3[0], 3)
let dr4  = el_delta_decode(el_delta_encode(4))
cki("delta_rt_4_val",  dr4[0], 4)
let dr16 = el_delta_decode(el_delta_encode(16))
cki("delta_rt_16_val", dr16[0], 16)
let dr50 = el_delta_decode(el_delta_encode(50))
cki("delta_rt_50_val", dr50[0], 50)

print("_elias_test passed")
