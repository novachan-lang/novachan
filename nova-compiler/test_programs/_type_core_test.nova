import std/typesystem/type_core

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// ckt: deep structural equality using tyc_equal
fn ckt(label, a, b)
    let eq = type_core.tyc_equal(a, b)
    if eq == 0
        print("FAIL " + label + ": types not equal")
        exit(1)

// cklist: compare two int lists
fn cklist(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": length got=" + str(len(got)) + " expected=" + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != expected[i]
            print("FAIL " + label + ": at index " + str(i) + " got=" + str(got[i]) + " expected=" + str(expected[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: tyc_equal(tyc_int(), tyc_con("int",[])) = true
    let ti = type_core.tyc_int()
    let tc = type_core.tyc_con("int", [])
    cki("equal_int_con", type_core.tyc_equal(ti, tc), 1)

    // KAT 2: tyc_ftv(tyc_arr(tyc_tvar(0), tyc_tvar(1))) == [0, 1]
    let arr01 = type_core.tyc_arr(type_core.tyc_tvar(0), type_core.tyc_tvar(1))
    let want01 = []
    push(want01, 0)
    push(want01, 1)
    cklist("ftv_arr_0_1", type_core.tyc_ftv(arr01), want01)

    // KAT 3: tyc_ftv(tyc_int()) == []
    cklist("ftv_int_empty", type_core.tyc_ftv(type_core.tyc_int()), [])

    // KAT 4: tyc_ftv(tyc_arr(tyc_tvar(2), tyc_tvar(2))) == [2]
    let arr22 = type_core.tyc_arr(type_core.tyc_tvar(2), type_core.tyc_tvar(2))
    let want2 = []
    push(want2, 2)
    cklist("ftv_arr_2_2", type_core.tyc_ftv(arr22), want2)

    // KAT 5: tyc_is_arr(tyc_arr(tyc_int(), tyc_bool())) = true
    let ab = type_core.tyc_arr(type_core.tyc_int(), type_core.tyc_bool())
    cki("is_arr_true", type_core.tyc_is_arr(ab), 1)

    // KAT 6: tyc_size(tyc_arr(tyc_int(), tyc_bool())) = 3
    // arr node=1, int node=1, bool node=1 -> total=3
    cki("size_arr_int_bool", type_core.tyc_size(ab), 3)

    // Additional KATs
    // tyc_is_tvar(tyc_tvar(5)) = 1
    cki("is_tvar_true", type_core.tyc_is_tvar(type_core.tyc_tvar(5)), 1)
    // tyc_is_tvar(tyc_int()) = 0
    cki("is_tvar_false", type_core.tyc_is_tvar(type_core.tyc_int()), 0)
    // tyc_is_con(tyc_int()) = 1
    cki("is_con_int", type_core.tyc_is_con(type_core.tyc_int()), 1)
    // tyc_is_con(tyc_arr(...)) = 0
    cki("is_con_arr_false", type_core.tyc_is_con(ab), 0)

    // tyc_list(tyc_int()) structural equality
    let li = type_core.tyc_list(type_core.tyc_int())
    let li2 = type_core.tyc_con("list", [])
    push(li2[2], type_core.tyc_int())
    cki("equal_list_int", type_core.tyc_equal(li, li2), 1)

    // tyc_pair(tyc_int(), tyc_bool()) structural equality
    let pb = type_core.tyc_pair(type_core.tyc_int(), type_core.tyc_bool())
    let pb2 = type_core.tyc_con("pair", [])
    push(pb2[2], type_core.tyc_int())
    push(pb2[2], type_core.tyc_bool())
    cki("equal_pair", type_core.tyc_equal(pb, pb2), 1)

    // tyc_size(tyc_tvar(0)) = 1
    cki("size_tvar", type_core.tyc_size(type_core.tyc_tvar(0)), 1)

    // tyc_size(tyc_list(tyc_tvar(0))) = 2 (con node + tvar node)
    let lv0 = type_core.tyc_list(type_core.tyc_tvar(0))
    cki("size_list_tvar", type_core.tyc_size(lv0), 2)

    // ftv ordering: tyc_arr(tyc_tvar(3), tyc_tvar(1)) -> sorted = [1, 3]
    let arr31 = type_core.tyc_arr(type_core.tyc_tvar(3), type_core.tyc_tvar(1))
    let want31 = []
    push(want31, 1)
    push(want31, 3)
    cklist("ftv_sorted", type_core.tyc_ftv(arr31), want31)

    // tyc_equal on different constructors: int != bool
    cki("not_equal_int_bool", type_core.tyc_equal(type_core.tyc_int(), type_core.tyc_bool()), 0)

    print("PASS _type_core_test")

main()
