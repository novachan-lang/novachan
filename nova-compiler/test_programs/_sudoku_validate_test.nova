import std/game/sudoku_validate

fn assert_bool(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if gs != ws
        print("FAIL sudoku_validate " + label + ": got " + gs + " want " + ws)
        exit(1)

fn _push9(b, a0, a1, a2, a3, a4, a5, a6, a7, a8)
    push(b, a0)
    push(b, a1)
    push(b, a2)
    push(b, a3)
    push(b, a4)
    push(b, a5)
    push(b, a6)
    push(b, a7)
    push(b, a8)

fn main()
    // Build the classic partial puzzle board (flat, row-major)
    let partial = []
    _push9(partial, 5,3,0, 0,7,0, 0,0,0)
    _push9(partial, 6,0,0, 1,9,5, 0,0,0)
    _push9(partial, 0,9,8, 0,0,0, 0,6,0)
    _push9(partial, 8,0,0, 0,6,0, 0,0,3)
    _push9(partial, 4,0,0, 8,0,3, 0,0,1)
    _push9(partial, 7,0,0, 0,2,0, 0,0,6)
    _push9(partial, 0,6,0, 0,0,0, 2,8,0)
    _push9(partial, 0,0,0, 4,1,9, 0,0,5)
    _push9(partial, 0,0,0, 0,8,0, 0,7,9)

    // --- is_valid_sudoku: valid partial board ---
    let v1 = is_valid_sudoku(partial)
    assert_bool("valid_partial", v1, true)

    // --- is_valid_sudoku: duplicate in a row (row0: 5,3,5,...) ---
    let dup_row = []
    _push9(dup_row, 5,3,5, 0,7,0, 0,0,0)
    _push9(dup_row, 6,0,0, 1,9,5, 0,0,0)
    _push9(dup_row, 0,9,8, 0,0,0, 0,6,0)
    _push9(dup_row, 8,0,0, 0,6,0, 0,0,3)
    _push9(dup_row, 4,0,0, 8,0,3, 0,0,1)
    _push9(dup_row, 7,0,0, 0,2,0, 0,0,6)
    _push9(dup_row, 0,6,0, 0,0,0, 2,8,0)
    _push9(dup_row, 0,0,0, 4,1,9, 0,0,5)
    _push9(dup_row, 0,0,0, 0,8,0, 0,7,9)
    let v2 = is_valid_sudoku(dup_row)
    assert_bool("dup_in_row", v2, false)

    // --- is_complete: full solved board ---
    let solved = []
    _push9(solved, 5,3,4, 6,7,8, 9,1,2)
    _push9(solved, 6,7,2, 1,9,5, 3,4,8)
    _push9(solved, 1,9,8, 3,4,2, 5,6,7)
    _push9(solved, 8,5,9, 7,6,1, 4,2,3)
    _push9(solved, 4,2,6, 8,5,3, 7,9,1)
    _push9(solved, 7,1,3, 9,2,4, 8,5,6)
    _push9(solved, 9,6,1, 5,3,7, 2,8,4)
    _push9(solved, 2,8,7, 4,1,9, 6,3,5)
    _push9(solved, 3,4,5, 2,8,6, 1,7,9)
    let v3 = is_complete(solved)
    assert_bool("is_complete_full", v3, true)

    // --- is_complete: board with a zero ---
    let v4 = is_complete(partial)
    assert_bool("is_complete_partial", v4, false)

    // --- is_valid_sudoku: duplicate in col (col0: 8 at rows 0 and 3) ---
    let dup_col = []
    _push9(dup_col, 8,3,0, 0,7,0, 0,0,0)
    _push9(dup_col, 6,0,0, 1,9,5, 0,0,0)
    _push9(dup_col, 0,9,0, 0,0,0, 0,6,0)
    _push9(dup_col, 8,0,0, 0,6,0, 0,0,3)
    _push9(dup_col, 4,0,0, 8,0,3, 0,0,1)
    _push9(dup_col, 7,0,0, 0,2,0, 0,0,6)
    _push9(dup_col, 0,6,0, 0,0,0, 2,8,0)
    _push9(dup_col, 0,0,0, 4,1,9, 0,0,5)
    _push9(dup_col, 0,0,0, 0,0,0, 0,7,0)
    let v5 = is_valid_sudoku(dup_col)
    assert_bool("dup_in_col", v5, false)

    print("PASS _sudoku_validate_test")
