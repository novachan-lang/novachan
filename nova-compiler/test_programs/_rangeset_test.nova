import std/collections/rangeset

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // ---- KAT 1: add(1,3);add(5,7);add(2,4) -> [[1,4],[5,7]] ----
    // [2,4] overlaps [1,3] -> merged to [1,4]; does NOT overlap [5,7] (4<5)
    let rs = rangeset.rs_new()
    rangeset.rs_add(rs, 1, 3)
    rangeset.rs_add(rs, 5, 7)
    rangeset.rs_add(rs, 2, 4)
    let ivs = rangeset.rs_intervals(rs)
    cki(len(ivs), 2, "kat1: interval count==2")
    let iv0 = ivs[0]
    let iv1 = ivs[1]
    cki(iv0[0], 1, "kat1: iv[0].lo==1")
    cki(iv0[1], 4, "kat1: iv[0].hi==4")
    cki(iv1[0], 5, "kat1: iv[1].lo==5")
    cki(iv1[1], 7, "kat1: iv[1].hi==7")

    // ---- KAT 2: contains ----
    cki(rangeset.rs_contains(rs, 3), 1, "kat2: contains(3)==true")
    cki(rangeset.rs_contains(rs, 4), 1, "kat2: contains(4)==true")
    cki(rangeset.rs_contains(rs, 8), 0, "kat2: contains(8)==false")

    // ---- KAT 3: size() == 7 ----
    // [1,4]=4 integers + [5,7]=3 integers = 7
    cki(rangeset.rs_size(rs), 7, "kat3: size==7 after [[1,4],[5,7]]")

    // ---- KAT 4: add(4,5) merges -> [[1,7]], size==7 ----
    // [4,5] overlaps [1,4] (hi=4>=lo=4) AND overlaps [5,7] (lo=5<=hi=5)
    rangeset.rs_add(rs, 4, 5)
    let ivs2 = rangeset.rs_intervals(rs)
    cki(len(ivs2), 1, "kat4: merged to 1 interval")
    let iv2 = ivs2[0]
    cki(iv2[0], 1, "kat4: iv[0].lo==1")
    cki(iv2[1], 7, "kat4: iv[0].hi==7")
    cki(rangeset.rs_size(rs), 7, "kat4: size==7 after merge to [[1,7]]")

    // ---- KAT 5: remove(3,5) -> [[1,2],[6,7]] ----
    // [1,7] straddles [3,5]: left=[1,2], right=[6,7]
    rangeset.rs_remove(rs, 3, 5)
    let ivs3 = rangeset.rs_intervals(rs)
    cki(len(ivs3), 2, "kat5: remove splits to 2 intervals")
    let iv3a = ivs3[0]
    let iv3b = ivs3[1]
    cki(iv3a[0], 1, "kat5: iv[0].lo==1")
    cki(iv3a[1], 2, "kat5: iv[0].hi==2")
    cki(iv3b[0], 6, "kat5: iv[1].lo==6")
    cki(iv3b[1], 7, "kat5: iv[1].hi==7")

    // ---- KAT 6: edge cases ----
    // empty set
    let rs2 = rangeset.rs_new()
    cki(rangeset.rs_size(rs2), 0, "kat6: empty size==0")
    cki(rangeset.rs_contains(rs2, 0), 0, "kat6: empty contains(0)==0")
    cki(len(rangeset.rs_intervals(rs2)), 0, "kat6: empty intervals==[]")
    // single point interval
    rangeset.rs_add(rs2, 5, 5)
    cki(rangeset.rs_size(rs2), 1, "kat6: single point size==1")
    cki(rangeset.rs_contains(rs2, 5), 1, "kat6: single point contains(5)==1")
    cki(rangeset.rs_contains(rs2, 4), 0, "kat6: single point contains(4)==0")
    // remove the single point -> empty
    rangeset.rs_remove(rs2, 5, 5)
    cki(rangeset.rs_size(rs2), 0, "kat6: after remove single point, size==0")
    // remove from empty -> no crash
    rangeset.rs_remove(rs2, 1, 10)
    cki(rangeset.rs_size(rs2), 0, "kat6: remove from empty==0")
    // add a range, then remove only right portion
    rangeset.rs_add(rs2, 10, 20)
    rangeset.rs_remove(rs2, 15, 25)
    let ivs4 = rangeset.rs_intervals(rs2)
    cki(len(ivs4), 1, "kat6: partial right-trim -> 1 interval")
    let iv4 = ivs4[0]
    cki(iv4[0], 10, "kat6: trim right lo==10")
    cki(iv4[1], 14, "kat6: trim right hi==14")

    print("_rangeset_test passed")

main()
