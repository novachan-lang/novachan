// Phase 13 Game: Entity-Component System (ECS)

fn test_ecs_world()
    let world = ecs_world()
    assert_eq(world >= 0, true)
    // Create some entities
    let e1 = ecs_entity(world)
    let e2 = ecs_entity(world)
    assert_eq(e1 >= 1, true)
    assert_eq(e2 > e1, true)
    print("ECS world/entity test passed")

fn test_ecs_components()
    let world = ecs_world()
    let player = ecs_entity(world)
    let enemy = ecs_entity(world)
    // Set components
    ecs_set(world, player, "health", 100)
    ecs_set(world, player, "x", 0)
    ecs_set(world, player, "y", 0)
    ecs_set(world, enemy, "health", 50)
    ecs_set(world, enemy, "x", 10)
    // Get components
    assert_eq(ecs_get(world, player, "health"), 100)
    assert_eq(ecs_get(world, player, "x"), 0)
    assert_eq(ecs_get(world, enemy, "health"), 50)
    assert_eq(ecs_get(world, enemy, "x"), 10)
    // Has component
    assert_eq(ecs_has(world, player, "health"), 1)
    assert_eq(ecs_has(world, player, "y"), 1)
    assert_eq(ecs_has(world, enemy, "y"), 0)
    assert_eq(ecs_has(world, player, "nonexistent"), 0)
    // Update
    ecs_set(world, player, "health", 80)
    assert_eq(ecs_get(world, player, "health"), 80)
    print("ECS component test passed")

fn test_ecs_query()
    let world = ecs_world()
    let e1 = ecs_entity(world)
    let e2 = ecs_entity(world)
    let e3 = ecs_entity(world)
    ecs_set(world, e1, "health", 100)
    ecs_set(world, e2, "health", 50)
    ecs_set(world, e3, "x", 5)
    // Query entities with "health"
    let with_health = ecs_query(world, "health")
    assert_eq(len(with_health) >= 2, true)
    // Query entities with "x"
    let with_x = ecs_query(world, "x")
    assert_eq(len(with_x) >= 1, true)
    print("ECS query test passed")

fn test_ecs_destroy()
    let world = ecs_world()
    let e1 = ecs_entity(world)
    ecs_set(world, e1, "health", 100)
    assert_eq(ecs_has(world, e1, "health"), 1)
    ecs_destroy(world, e1)
    assert_eq(ecs_has(world, e1, "health"), 0)
    print("ECS destroy test passed")

fn main()
    test_ecs_world()
    test_ecs_components()
    test_ecs_query()
    test_ecs_destroy()
    print("All Phase 13 Game tests passed!")
