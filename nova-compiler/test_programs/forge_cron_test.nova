// Forge T4.18 (matcher core): parse a 5-field cron expression and test whether a given wall-clock
// minute is due. Pure + deterministic (clock fields supplied -> no real time). Socketless.
import forge_otp

fn main()
    // "*/15 * * * *" -> due at minute 0,15,30,45; not at 7
    let p = cron_parse("*/15 * * * *")
    if cron_due(p, 0, 10, 1, 1, 1) == false
        print("FAIL: */15 should be due at minute 0")
        exit(1)
    if cron_due(p, 15, 10, 1, 1, 1) == false
        print("FAIL: */15 should be due at minute 15")
        exit(1)
    if cron_due(p, 45, 10, 1, 1, 1) == false
        print("FAIL: */15 should be due at minute 45")
        exit(1)
    if cron_due(p, 7, 10, 1, 1, 1)
        print("FAIL: */15 should NOT be due at minute 7")
        exit(1)

    // "0 9 * * *" -> due only at 09:00
    let p2 = cron_parse("0 9 * * *")
    if cron_due(p2, 0, 9, 1, 1, 1) == false
        print("FAIL: should be due at 09:00")
        exit(1)
    if cron_due(p2, 0, 10, 1, 1, 1)
        print("FAIL: should NOT be due at 10:00")
        exit(1)
    if cron_due(p2, 30, 9, 1, 1, 1)
        print("FAIL: should NOT be due at 09:30")
        exit(1)

    print("PASS forge_cron (*/15 minute-step matching + exact hour:minute matching)")
