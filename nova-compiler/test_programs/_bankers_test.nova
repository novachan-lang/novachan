import std/scheduling/bankers

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bankers " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL bankers " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label: string, got: list, want: list)
    let n = len(want)
    if len(got) != n
        print("FAIL bankers " + label + ": len got=" + str(len(got)) + " want=" + str(n))
        exit(1)
    let i = 0
    while i < n
        if got[i] != want[i]
            print("FAIL bankers " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // Classic Silberschatz example
    // alloc: P0=[0,1,0] P1=[2,0,0] P2=[3,0,2] P3=[2,1,1] P4=[0,0,2]
    let alloc = []
    let a0 = []
    push(a0, 0)
    push(a0, 1)
    push(a0, 0)
    push(alloc, a0)
    let a1 = []
    push(a1, 2)
    push(a1, 0)
    push(a1, 0)
    push(alloc, a1)
    let a2 = []
    push(a2, 3)
    push(a2, 0)
    push(a2, 2)
    push(alloc, a2)
    let a3 = []
    push(a3, 2)
    push(a3, 1)
    push(a3, 1)
    push(alloc, a3)
    let a4 = []
    push(a4, 0)
    push(a4, 0)
    push(a4, 2)
    push(alloc, a4)

    // max: P0=[7,5,3] P1=[3,2,2] P2=[9,0,2] P3=[2,2,2] P4=[4,3,3]
    let max = []
    let m0 = []
    push(m0, 7)
    push(m0, 5)
    push(m0, 3)
    push(max, m0)
    let m1 = []
    push(m1, 3)
    push(m1, 2)
    push(m1, 2)
    push(max, m1)
    let m2 = []
    push(m2, 9)
    push(m2, 0)
    push(m2, 2)
    push(max, m2)
    let m3 = []
    push(m3, 2)
    push(m3, 2)
    push(m3, 2)
    push(max, m3)
    let m4 = []
    push(m4, 4)
    push(m4, 3)
    push(m4, 3)
    push(max, m4)

    // available = [3,3,2]
    let avail = []
    push(avail, 3)
    push(avail, 3)
    push(avail, 2)

    // bk_is_safe(...) = true
    ckb("is_safe_true", bk_is_safe(alloc, max, avail), true)

    // bk_safe_sequence(...) = [1,3,4,0,2]
    let seq = bk_safe_sequence(alloc, max, avail)
    let want_seq = []
    push(want_seq, 1)
    push(want_seq, 3)
    push(want_seq, 4)
    push(want_seq, 0)
    push(want_seq, 2)
    ckl("safe_sequence", seq, want_seq)

    // bk_need row 0 = [7,4,3]
    let need = bk_need(alloc, max)
    let need0 = need[0]
    cki("need_p0_r0", need0[0], 7)
    cki("need_p0_r1", need0[1], 4)
    cki("need_p0_r2", need0[2], 3)

    // unsafe case: available = [1,0,0]
    let avail2 = []
    push(avail2, 1)
    push(avail2, 0)
    push(avail2, 0)
    ckb("is_safe_false", bk_is_safe(alloc, max, avail2), false)

    // bk_safe_sequence on unsafe = []
    let seq2 = bk_safe_sequence(alloc, max, avail2)
    cki("unsafe_seq_len", len(seq2), 0)

    // edge: empty
    let empty_list = []
    let empty_avail = []
    ckb("is_safe_empty", bk_is_safe(empty_list, empty_list, empty_avail), true)

    print("PASS _bankers_test")
