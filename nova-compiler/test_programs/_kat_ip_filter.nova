import forge_ip_filter

fn main()
    let f = ipf_new()
    assert(ipf_allow_count(f) == 0, "starts with 0 allow")
    assert(ipf_deny_count(f) == 0, "starts with 0 deny")

    // no rules at all -> everything allowed
    let r0 = ipf_check(f, "8.8.8.8")
    assert(is_ok(r0), "check ok")
    assert(unwrap(r0) == "allowed", "default allow with no rules")

    f = ipf_deny(f, "10.0.0.5")
    assert(ipf_deny_count(f) == 1, "1 deny rule")
    let r1 = ipf_check(f, "10.0.0.5")
    assert(unwrap(r1) == "denied", "denied exact")

    let r2 = ipf_check(f, "10.0.0.6")
    assert(unwrap(r2) == "allowed", "other ip allowed (no allow list yet)")

    f = ipf_deny(f, "172.16.*")
    let r3 = ipf_check(f, "172.16.0.1")
    assert(unwrap(r3) == "denied", "wildcard deny")

    let r4 = ipf_check(f, "172.17.0.1")
    assert(unwrap(r4) == "allowed", "different prefix ok")

    f = ipf_allow(f, "192.168.1.*")
    f = ipf_allow(f, "10.0.0.1")
    assert(ipf_allow_count(f) == 2, "2 allow rules")
    assert(ipf_has_allow(f, "10.0.0.1") == 1, "has_allow exact")
    assert(ipf_has_allow(f, "9.9.9.9") == 0, "has_allow miss")

    let r5 = ipf_check(f, "192.168.1.50")
    assert(unwrap(r5) == "allowed", "in allow list (wildcard)")

    let r6 = ipf_check(f, "10.0.0.1")
    assert(unwrap(r6) == "allowed", "exact allow")

    let r7 = ipf_check(f, "8.8.8.8")
    assert(unwrap(r7) == "denied", "not in allow list -> whitelist mode denies")

    let r8 = ipf_check(f, "10.0.0.5")
    assert(unwrap(r8) == "denied", "deny still wins even though not on allow list either")

    assert(ipf_total_checks(f) == 9, "9 total checks")
    assert(ipf_denied_count(f) == 4, "4 denied")
    assert(ipf_allowed_count(f) == 5, "5 allowed")

    print("IP-FILTER KAT PASS")
