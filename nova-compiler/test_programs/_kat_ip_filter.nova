import forge_ip_filter

fn main()
    let f = ipf_new()
    let r1 = ipf_check(f, "192.168.1.1")
    f = r1["filter"]
    assert(r1["allowed"] == 1, "allow-all mode")

    f = ipf_deny(f, "10.0.0.5")
    let r2 = ipf_check(f, "10.0.0.5")
    f = r2["filter"]
    assert(r2["allowed"] == 0, "denied exact")

    let r3 = ipf_check(f, "10.0.0.6")
    f = r3["filter"]
    assert(r3["allowed"] == 1, "other ip allowed")

    f = ipf_deny(f, "172.16.*")
    let r4 = ipf_check(f, "172.16.0.1")
    f = r4["filter"]
    assert(r4["allowed"] == 0, "prefix deny")

    let r5 = ipf_check(f, "172.17.0.1")
    f = r5["filter"]
    assert(r5["allowed"] == 1, "different prefix ok")

    f = ipf_set_mode(f, "allow-list")
    f = ipf_allow(f, "192.168.1.*")
    f = ipf_allow(f, "10.0.0.1")

    let r6 = ipf_check(f, "192.168.1.50")
    f = r6["filter"]
    assert(r6["allowed"] == 1, "in allow list")

    let r7 = ipf_check(f, "10.0.0.1")
    f = r7["filter"]
    assert(r7["allowed"] == 1, "exact allow")

    let r8 = ipf_check(f, "8.8.8.8")
    f = r8["filter"]
    assert(r8["allowed"] == 0, "not in allow list")

    let r9 = ipf_check(f, "10.0.0.5")
    f = r9["filter"]
    assert(r9["allowed"] == 0, "deny takes priority")

    assert(ipf_log_count(f) >= 8, "log has entries")

    print("IP-FILTER KAT PASS")
