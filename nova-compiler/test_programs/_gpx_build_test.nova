// KAT test for std/data/gpx_build
import std/data/gpx_build
import std/data/gpx_parse

// ── Helper: check if string s contains needle ────────────────────────────────
fn contains_str(s, needle)
    let ns = len(s)
    let nn = len(needle)
    let result = 0
    if nn > 0 and ns >= nn
        let i = 0
        let go = 1
        while go == 1
            if i + nn > ns
                go = 0
            else
                let ok = 1
                let j = 0
                let mgo = 1
                while mgo == 1
                    if j >= nn
                        mgo = 0
                    else
                        if char_at(s, i + j) != char_at(needle, j)
                            ok = 0
                            mgo = 0
                        else
                            j = j + 1
                if ok == 1
                    result = 1
                    go = 0
                else
                    i = i + 1
    return result

// ── Helper: approximate float equality ───────────────────────────────────────
fn approx(a, b, tol)
    let diff = a - b
    let adiff = diff
    if diff < 0.0
        adiff = 0.0 - diff
    let result = 0
    if adiff <= tol
        result = 1
    return result

// ── Test 1: gpx_build([[1.5, 2.5]]) structure ────────────────────────────────
let pts1 = []
let pair1 = []
push(pair1, 1.5)
push(pair1, 2.5)
push(pts1, pair1)
let out1 = gpx_build(pts1)

if contains_str(out1, "<gpx") != 1
    print("FAIL gpx_build missing <gpx")
    exit(1)
if contains_str(out1, "trkpt") != 1
    print("FAIL gpx_build missing trkpt")
    exit(1)
if contains_str(out1, "1.5") != 1
    print("FAIL gpx_build missing 1.5")
    exit(1)
if contains_str(out1, "2.5") != 1
    print("FAIL gpx_build missing 2.5")
    exit(1)
if contains_str(out1, "<trk>") != 1
    print("FAIL gpx_build missing <trk>")
    exit(1)
if contains_str(out1, "<trkseg>") != 1
    print("FAIL gpx_build missing <trkseg>")
    exit(1)

// ── Test 2: gpx_build([]) -> valid structure, no trkpt ───────────────────────
let pts_empty = []
let out_empty = gpx_build(pts_empty)
if contains_str(out_empty, "<gpx") != 1
    print("FAIL gpx_build empty missing <gpx")
    exit(1)
if contains_str(out_empty, "trkpt") == 1
    print("FAIL gpx_build empty should have no trkpt")
    exit(1)

// ── Test 3: round-trip — gpx_parse(gpx_build(pts)) recovers pts ──────────────
let pts_rt = []
let pa = []
push(pa, 1.5)
push(pa, 2.5)
let pb = []
push(pb, 3.0)
push(pb, 4.0)
let pc = []
push(pc, 51.5074)
push(pc, 0.0 - 0.1278)
push(pts_rt, pa)
push(pts_rt, pb)
push(pts_rt, pc)

let built = gpx_build(pts_rt)
let recovered = gpx_parse(built)

if len(recovered) != 3
    print("FAIL gpx_build roundtrip count: expected 3 got " + str(len(recovered)))
    exit(1)

let rp0 = recovered[0]
let rp1 = recovered[1]
let rp2 = recovered[2]

if approx(rp0[0], 1.5, 0.001) != 1
    print("FAIL gpx_build rt[0].lat: got " + str(rp0[0]))
    exit(1)
if approx(rp0[1], 2.5, 0.001) != 1
    print("FAIL gpx_build rt[0].lon: got " + str(rp0[1]))
    exit(1)
if approx(rp1[0], 3.0, 0.001) != 1
    print("FAIL gpx_build rt[1].lat: got " + str(rp1[0]))
    exit(1)
if approx(rp1[1], 4.0, 0.001) != 1
    print("FAIL gpx_build rt[1].lon: got " + str(rp1[1]))
    exit(1)
if approx(rp2[0], 51.5074, 0.001) != 1
    print("FAIL gpx_build rt[2].lat: got " + str(rp2[0]))
    exit(1)
if approx(rp2[1], 0.0 - 0.1278, 0.001) != 1
    print("FAIL gpx_build rt[2].lon: got " + str(rp2[1]))
    exit(1)

// ── Test 4: multiple points all appear ───────────────────────────────────────
let pts4 = []
let p4a = []
push(p4a, 48.8566)
push(p4a, 2.3522)
let p4b = []
push(p4b, 52.52)
push(p4b, 13.405)
push(pts4, p4a)
push(pts4, p4b)
let out4 = gpx_build(pts4)
if contains_str(out4, "48.8566") != 1
    print("FAIL gpx_build multi missing 48.8566")
    exit(1)
if contains_str(out4, "52.52") != 1
    print("FAIL gpx_build multi missing 52.52")
    exit(1)

print("PASS _gpx_build_test")
