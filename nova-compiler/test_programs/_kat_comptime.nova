// KAT 2.5 — COMPILE-TIME EVALUATION. Zig's comptime is the benchmark.
//
// Every `const` below whose initializer is a call must be EVALUATED BY THE COMPILER and
// baked as a literal. The gate checks that structurally (no call left in the IR) as well as
// by value, because value-only checking passes just as happily against no folding at all --
// the program computes the same answer either way, which is exactly what makes this feature
// invisible to an ordinary test.
//
// The fail-closed cases at the bottom are the load-bearing half. Comptime's whole safety
// argument is that an unsupported construct falls back to runtime rather than guessing, so
// a case that CANNOT be folded must still produce the RIGHT ANSWER.

// ---- int: recursion + arithmetic ------------------------------------------------
fn ct_fib(n: int) -> int
    if n < 2
        return n
    ct_fib(n - 1) + ct_fib(n - 2)

const FIB20 = ct_fib(20)

// ---- for..in over range(), building a LOOKUP TABLE -----------------------------
// This is the single most valuable thing compile-time evaluation is used for: a table
// that would otherwise be hand-written, generated by a build script, or rebuilt on every
// startup. `push` into a comptime list is what makes it expressible.
fn ct_squares(n: int) -> list
    let t = []
    for i in range(n)
        push(t, i * i)
    t

const SQUARES = ct_squares(10)

// ---- break and continue --------------------------------------------------------
fn ct_first_over(limit: int) -> int
    let found = -1
    for i in range(1000)
        if i * i <= limit
            continue
        found = i
        break
    found

const FIRST_OVER_500 = ct_first_over(500)

// ---- while, reassignment, min/max, nested calls --------------------------------
fn ct_collatz_len(start: int) -> int
    let n = start
    let steps = 0
    while n != 1
        if n % 2 == 0
            n = n / 2
        else
            n = 3 * n + 1
        steps = steps + 1
    steps

const COLLATZ_27 = ct_collatz_len(27)

// ---- strings -------------------------------------------------------------------
fn ct_banner(n: int) -> str
    let out = ""
    for i in range(n)
        out = out + "ab"
    out

const BANNER = ct_banner(4)

// ---- nested lists + indexing + len ---------------------------------------------
fn ct_grid(w: int, h: int) -> list
    let rows = []
    for y in range(h)
        let row = []
        for x in range(w)
            push(row, y * w + x)
        push(rows, row)
    rows

const GRID = ct_grid(3, 2)

// ---- FAIL-CLOSED: a float result must NOT be baked, but must still be RIGHT ----
// A float literal is emitted as a decimal string and NOVA's float rendering is not
// round-trip exact, so baking one would silently change the value in its last bits. The
// compiler declines and computes it at runtime instead.
fn ct_half(n: int) -> float
    n * 0.5

const HALF_7 = ct_half(7)

// ---- FAIL-CLOSED: an impure call must NOT be evaluated at compile time ---------
// If the compiler folded this, every run of the built binary would report the SAME clock
// reading -- a program that no longer means what its source says. It must stay a call.
const NOT_FOLDABLE = ct_passthru(1)
fn ct_passthru(x: int) -> int
    x + time_ms() - time_ms()

fn main()
    let ok = 0
    let fail = 0

    if FIB20 == 6765
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL fib: " + str(FIB20))

    if len(SQUARES) == 10 and SQUARES[0] == 0 and SQUARES[3] == 9 and SQUARES[9] == 81
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL squares table")

    if FIRST_OVER_500 == 23
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL break/continue: " + str(FIRST_OVER_500))

    if COLLATZ_27 == 111
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL collatz: " + str(COLLATZ_27))

    if BANNER == "abababab"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL banner: " + BANNER)

    if len(GRID) == 2 and len(GRID[0]) == 3 and GRID[1][2] == 5
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL grid")

    // the fail-closed cases must still be CORRECT
    if HALF_7 > 3.49 and HALF_7 < 3.51
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL float fallback value")

    if NOT_FOLDABLE == 1
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL impure fallback value: " + str(NOT_FOLDABLE))

    print("COMPTIME ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("COMPTIME PASS")
    else
        print("COMPTIME FAIL")
