import forge_tenant_isolator

fn main()
    let t = ti_new()
    t = ti_add_tenant(t, "acme", 3)
    t = ti_add_tenant(t, "globex", 5)
    assert(ti_tenant_count(t) == 2, "2 tenants")

    let r1 = ti_request(t, "acme")
    t = r1["t"]
    assert(r1["allowed"] == 1, "acme allowed")
    let r2 = ti_request(t, "acme")
    t = r2["t"]
    let r3 = ti_request(t, "acme")
    t = r3["t"]
    assert(ti_usage(t, "acme") == 3, "3 used")

    let r4 = ti_request(t, "acme")
    t = r4["t"]
    assert(r4["allowed"] == 0, "acme quota exceeded")
    assert(r4["reason"] == "quota_exceeded", "reason")

    let r5 = ti_request(t, "unknown")
    t = r5["t"]
    assert(r5["allowed"] == 0, "unknown denied")
    assert(r5["reason"] == "unknown_tenant", "unknown reason")

    t = ti_suspend(t, "globex")
    let r6 = ti_request(t, "globex")
    t = r6["t"]
    assert(r6["allowed"] == 0, "suspended denied")
    assert(r6["reason"] == "suspended", "suspended reason")

    t = ti_activate(t, "globex")
    let r7 = ti_request(t, "globex")
    t = r7["t"]
    assert(r7["allowed"] == 1, "reactivated allowed")

    t = ti_reset_usage(t, "acme")
    assert(ti_usage(t, "acme") == 0, "usage reset")

    print("TENANT-ISOLATOR KAT PASS")
