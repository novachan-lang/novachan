import std/finance/inflation

// Helper: absolute value for float
fn float_abs(x: float) -> float
    if x < 0.0
        let r = x * -1.0
        return r
    x

// KAT 1: future value of $100 at 3% for 10 years = 134.39
let fv1 = infl_future_value(100.0, 0.03, 10)
let diff1 = float_abs(fv1 - 134.39)
if diff1 > 0.01
    print("FAIL KAT1 infl_future_value(100,0.03,10) expected 134.39 got " + str(fv1))
    exit(1)

// KAT 2: present value of 134.39 at 3% for 10 years ≈ 100.0
let pv2 = infl_present_value(134.39, 0.03, 10)
let diff2 = float_abs(pv2 - 100.0)
if diff2 > 0.01
    print("FAIL KAT2 infl_present_value(134.39,0.03,10) expected ~100.0 got " + str(pv2))
    exit(1)

// KAT 3: real rate via Fisher: (1.08)/(1.03)-1 = 0.048543...
let rr3 = infl_real_rate(0.08, 0.03)
let diff3 = float_abs(rr3 - 0.0485)
if diff3 > 0.0001
    print("FAIL KAT3 infl_real_rate(0.08,0.03) expected 0.0485 got " + str(rr3))
    exit(1)

// KAT 4: purchasing power of $1000 at 3% for 10 years = 744.09
let pp4 = infl_purchasing_power(1000.0, 0.03, 10)
let diff4 = float_abs(pp4 - 744.09)
if diff4 > 0.01
    print("FAIL KAT4 infl_purchasing_power(1000,0.03,10) expected 744.09 got " + str(pp4))
    exit(1)

// KAT 5: zero inflation — future value unchanged
let fv5 = infl_future_value(100.0, 0.0, 5)
let diff5 = float_abs(fv5 - 100.0)
if diff5 > 0.01
    print("FAIL KAT5 infl_future_value(100,0.0,5) expected 100.0 got " + str(fv5))
    exit(1)

// KAT 6: purchasing power == present value symmetry
//   infl_future_value and infl_purchasing_power are inverses
let fv6 = infl_future_value(500.0, 0.05, 20)
let pp6 = infl_purchasing_power(fv6, 0.05, 20)
let diff6 = float_abs(pp6 - 500.0)
if diff6 > 0.01
    print("FAIL KAT6 round-trip fv/pp expected 500.0 got " + str(pp6))
    exit(1)

// KAT 7: real rate with zero inflation equals nominal rate
let rr7 = infl_real_rate(0.05, 0.0)
let diff7 = float_abs(rr7 - 0.05)
if diff7 > 0.0001
    print("FAIL KAT7 infl_real_rate(0.05,0.0) expected 0.05 got " + str(rr7))
    exit(1)

print("_inflation_test passed")
