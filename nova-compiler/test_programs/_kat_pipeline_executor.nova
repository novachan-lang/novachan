import forge_pipeline_executor

fn main()
    let p = pe_new()
    p = pe_add_stage(p, "fetch")
    p = pe_add_stage(p, "transform")
    p = pe_add_stage(p, "load")
    assert(pe_stage_count(p) == 3, "3 stages")

    p = pe_start(p)
    assert(pe_status(p) == "running", "running")
    assert(pe_stage_status(p, 0) == "running", "fetch running")
    assert(pe_current_stage(p) == 0, "at stage 0")

    p = pe_complete_stage(p, "200 rows")
    assert(pe_stage_status(p, 0) == "done", "fetch done")
    assert(pe_stage_status(p, 1) == "running", "transform running")
    assert(pe_progress(p) == 33, "33%")

    p = pe_complete_stage(p, "200 transformed")
    p = pe_complete_stage(p, "200 loaded")
    assert(pe_status(p) == "done", "pipeline done")
    assert(pe_progress(p) == 100, "100%")

    let p2 = pe_new()
    p2 = pe_add_stage(p2, "step1")
    p2 = pe_start(p2)
    p2 = pe_fail_stage(p2, "network error")
    assert(pe_status(p2) == "failed", "failed pipeline")

    print("PIPELINE-EXECUTOR KAT PASS")
