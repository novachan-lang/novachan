import forge_admission_control

fn main()
    let ac = ac_new(10)
    assert(ac_throttle_pct(ac) == 0, "starts 0 throttle")
    assert(ac_error_rate(ac) == 0, "0 error rate")

    let i = 0
    while i < 8
        ac = ac_record_success(ac)
        i = i + 1
    let j = 0
    while j < 2
        ac = ac_record_error(ac)
        j = j + 1
    assert(ac_error_rate(ac) == 20, "20% error rate")
    assert(ac_throttle_pct(ac) == 20, "20% throttle (10% over target * 2)")

    let r1 = ac_should_admit(ac, 50)
    ac = r1["ac"]
    assert(r1["admitted"] == 1, "50 >= 20 admitted")

    let r2 = ac_should_admit(ac, 10)
    ac = r2["ac"]
    assert(r2["admitted"] == 0, "10 < 20 rejected")

    ac = ac_reset_window(ac)
    assert(ac_throttle_pct(ac) == 0, "reset throttle")
    assert(ac_error_rate(ac) == 0, "reset error rate")

    print("ADMISSION-CONTROL KAT PASS")
