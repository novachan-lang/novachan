@test
fn test_addition() -> bool
    1 + 1 == 2

@test
fn test_string_concat() -> bool
    let s = "hello" + " " + "world"
    s == "hello world"

@test
fn test_list_ops() -> bool
    let xs = [10, 20, 30]
    len(xs) == 3 and xs[0] == 10 and xs[2] == 30

@test
fn test_dict_basic() -> bool
    let d = {"a": 1, "b": 2}
    d["a"] == 1 and d["b"] == 2

@test
fn test_math_ops() -> bool
    10 - 3 == 7 and 4 * 5 == 20 and 15 / 3 == 5
