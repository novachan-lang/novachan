import std/graph/cycle_enum

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // Graph A: K3 triangle — nodes 0,1,2 all connected to each other
    // adj: 0->[1,2], 1->[0,2], 2->[0,1]
    let adj_k3 = []
    let k3_0 = []
    push(k3_0, 1)
    push(k3_0, 2)
    push(adj_k3, k3_0)
    let k3_1 = []
    push(k3_1, 0)
    push(k3_1, 2)
    push(adj_k3, k3_1)
    let k3_2 = []
    push(k3_2, 0)
    push(k3_2, 1)
    push(adj_k3, k3_2)

    // KAT 1: ce_count_triangles on K3 = 1
    cki("triangles_k3", ce_count_triangles(adj_k3, 3), 1)

    // KAT 2: ce_girth on K3 = 3
    cki("girth_k3", ce_girth(adj_k3, 3), 3)

    // KAT 3: ce_has_cycle on K3 = true
    ckb("has_cycle_k3", ce_has_cycle(adj_k3, 3), true)

    // Graph B: path graph 0-1-2 (no cycle)
    // adj: 0->[1], 1->[0,2], 2->[1]
    let adj_path = []
    let p0 = []
    push(p0, 1)
    push(adj_path, p0)
    let p1 = []
    push(p1, 0)
    push(p1, 2)
    push(adj_path, p1)
    let p2 = []
    push(p2, 1)
    push(adj_path, p2)

    // KAT 4: ce_has_cycle on path = false
    ckb("has_cycle_path", ce_has_cycle(adj_path, 3), false)

    // KAT 5: ce_girth on path = -1 (acyclic)
    cki("girth_path", ce_girth(adj_path, 3), -1)

    // KAT 6: ce_count_triangles on path = 0
    cki("triangles_path", ce_count_triangles(adj_path, 3), 0)

    // Graph C: 4-node graph with edges 0-1, 0-2, 0-3, 1-2
    // Triangle: {0,1,2}; node 3 connects only to 0
    // adj: 0->[1,2,3], 1->[0,2], 2->[0,1], 3->[0]
    let adj_4 = []
    let n4_0 = []
    push(n4_0, 1)
    push(n4_0, 2)
    push(n4_0, 3)
    push(adj_4, n4_0)
    let n4_1 = []
    push(n4_1, 0)
    push(n4_1, 2)
    push(adj_4, n4_1)
    let n4_2 = []
    push(n4_2, 0)
    push(n4_2, 1)
    push(adj_4, n4_2)
    let n4_3 = []
    push(n4_3, 0)
    push(adj_4, n4_3)

    // KAT 7: ce_count_triangles on 4-node graph = 1
    cki("triangles_4node", ce_count_triangles(adj_4, 4), 1)

    // KAT 8: ce_has_cycle on 4-node graph = true (has triangle 0-1-2)
    ckb("has_cycle_4node", ce_has_cycle(adj_4, 4), true)

    // Graph D: square cycle 0-1-2-3-0 (girth = 4)
    // adj: 0->[1,3], 1->[0,2], 2->[1,3], 3->[2,0]
    let adj_sq = []
    let sq0 = []
    push(sq0, 1)
    push(sq0, 3)
    push(adj_sq, sq0)
    let sq1 = []
    push(sq1, 0)
    push(sq1, 2)
    push(adj_sq, sq1)
    let sq2 = []
    push(sq2, 1)
    push(sq2, 3)
    push(adj_sq, sq2)
    let sq3 = []
    push(sq3, 2)
    push(sq3, 0)
    push(adj_sq, sq3)

    // KAT 9: ce_girth on C4 = 4
    cki("girth_c4", ce_girth(adj_sq, 4), 4)

    // KAT 10: ce_has_cycle on C4 = true
    ckb("has_cycle_c4", ce_has_cycle(adj_sq, 4), true)

    // KAT 11: ce_count_triangles on C4 = 0
    cki("triangles_c4", ce_count_triangles(adj_sq, 4), 0)

    // Graph E: empty graph (n=0)
    let adj_empty = []
    ckb("has_cycle_empty", ce_has_cycle(adj_empty, 0), false)
    cki("girth_empty", ce_girth(adj_empty, 0), -1)
    cki("triangles_empty", ce_count_triangles(adj_empty, 0), 0)

    // Graph F: single node no edges (n=1)
    let adj_solo = []
    let solo0 = []
    push(adj_solo, solo0)
    ckb("has_cycle_solo", ce_has_cycle(adj_solo, 1), false)
    cki("girth_solo", ce_girth(adj_solo, 1), -1)

    print("PASS _cycle_enum_test")
