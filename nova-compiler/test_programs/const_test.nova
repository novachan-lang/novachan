const PI = 3
const TAU = PI * 2
const NAME = "NOVA"
const MAX_SIZE = 1024
const IS_DEBUG = false

fn test_basic_const()
  assert(PI == 3, "PI == 3")
  assert(TAU == 6, "TAU == 6")
  assert(MAX_SIZE == 1024, "MAX_SIZE == 1024")

fn test_const_in_expr()
  let x = PI + 1
  assert(x == 4, "PI + 1 == 4")
  let y = MAX_SIZE / 2
  assert(y == 512, "MAX_SIZE / 2 == 512")

fn test_const_string()
  assert(NAME == "NOVA", "NAME == NOVA")
  let greeting = "Hello " + NAME
  assert(greeting == "Hello NOVA", "greeting: " + greeting)

fn test_local_const()
  const LOCAL_VAL = 42
  assert(LOCAL_VAL == 42, "local const == 42")
  const DOUBLED = LOCAL_VAL * 2
  assert(DOUBLED == 84, "doubled == 84")

fn test_const_bool()
  if IS_DEBUG
    assert(false, "should not reach debug branch")
  assert(true, "non-debug branch")

fn main()
  test_basic_const()
  test_const_in_expr()
  test_const_string()
  test_local_const()
  test_const_bool()
  print("const_test: all passed")
