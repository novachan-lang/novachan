import cluster

fn main()
    let port = 19293
    // registry node in a green task; give it a moment to bind before connecting.
    spawn fn()
        cluster.registry_run(port, 3)
    sleep(300)
    // client ops over the network (localhost): register, look up, miss.
    assert(cluster.reg_register("127.0.0.1", port, "svc", "node-A:7000") == 1, "register ok")
    assert(cluster.reg_whereis("127.0.0.1", port, "svc") == "node-A:7000", "whereis finds svc across the wire")
    assert(cluster.reg_whereis("127.0.0.1", port, "missing") == "", "absent name -> empty")
    print("cluster_test: all passed")
