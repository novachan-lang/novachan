import std/framing/kiss

// ── Helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if (a[i] & 0xFF) != (b[i] & 0xFF)
            return false
        i = i + 1
    true

fn assert_list(label: string, got, want)
    if not list_eq(got, want)
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let j = 0
        while j < len(want)
            if j > 0
                ws = ws + ","
            ws = ws + str(want[j])
            j = j + 1
        ws = ws + "]"
        print("FAIL kiss " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL kiss " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: kiss_escape([0xC0]) == [0xDB, 0xDC] ───────────────────────────
    let inp1 = []
    push(inp1, 0xC0)
    let esc1 = kiss_escape(inp1)
    let want1 = []
    push(want1, 0xDB)
    push(want1, 0xDC)
    assert_list("escape FEND", esc1, want1)

    // ── KAT 2: kiss_escape([0xDB]) == [0xDB, 0xDD] ───────────────────────────
    let inp2 = []
    push(inp2, 0xDB)
    let esc2 = kiss_escape(inp2)
    let want2 = []
    push(want2, 0xDB)
    push(want2, 0xDD)
    assert_list("escape FESC", esc2, want2)

    // ── KAT 3: kiss_command_byte(1, 0) == 0x10 ───────────────────────────────
    assert_int("command_byte(1,0)", kiss_command_byte(1, 0), 0x10)

    // ── KAT 4: kiss_command_byte(2, 3) == 0x23 ───────────────────────────────
    assert_int("command_byte(2,3)", kiss_command_byte(2, 3), 0x23)

    // ── KAT 5: kiss_frame(0,0,[1,2,3]) == [0xC0,0x00,1,2,3,0xC0] ─────────────
    let d5 = []
    push(d5, 1)
    push(d5, 2)
    push(d5, 3)
    let f5 = kiss_frame(0, 0, d5)
    let w5 = []
    push(w5, 0xC0)
    push(w5, 0x00)
    push(w5, 1)
    push(w5, 2)
    push(w5, 3)
    push(w5, 0xC0)
    assert_list("frame(0,0,[1,2,3])", f5, w5)

    // ── KAT 6: kiss_frame(0,0,[0xC0]) == [0xC0,0x00,0xDB,0xDC,0xC0] ─────────
    let d6 = []
    push(d6, 0xC0)
    let f6 = kiss_frame(0, 0, d6)
    let w6 = []
    push(w6, 0xC0)
    push(w6, 0x00)
    push(w6, 0xDB)
    push(w6, 0xDC)
    push(w6, 0xC0)
    assert_list("frame(0,0,[FEND])", f6, w6)

    // ── KAT 7: round-trip kiss_frame(2,0,[0xC0,0xDB,1,2]) ────────────────────
    let payload7 = []
    push(payload7, 0xC0)
    push(payload7, 0xDB)
    push(payload7, 1)
    push(payload7, 2)
    let f7 = kiss_frame(2, 0, payload7)
    let dec7 = kiss_deframe(f7)
    assert_int("rt port", dec7["port"], 2)
    assert_int("rt cmd", dec7["cmd"], 0)
    assert_list("rt data", dec7["data"], payload7)

    // ── KAT 8: kiss_unescape(kiss_escape(data)) == data ──────────────────────
    let data8 = []
    push(data8, 0xC0)
    push(data8, 0xDB)
    push(data8, 0x00)
    push(data8, 0xFF)
    push(data8, 42)
    let rt8 = kiss_unescape(kiss_escape(data8))
    assert_list("unescape(escape(data))", rt8, data8)

    // ── KAT 9: empty payload round-trip ──────────────────────────────────────
    let empty9 = []
    let f9 = kiss_frame(0, 0, empty9)
    let dec9 = kiss_deframe(f9)
    assert_list("empty payload rt", dec9["data"], empty9)

    // ── KAT 10: kiss_frame_data convenience (port=0 cmd=0) ───────────────────
    let d10 = []
    push(d10, 5)
    push(d10, 6)
    let f10 = kiss_frame_data(d10)
    let dec10 = kiss_deframe(f10)
    assert_int("frame_data port", dec10["port"], 0)
    assert_int("frame_data cmd", dec10["cmd"], 0)
    assert_list("frame_data payload", dec10["data"], d10)

    // ── KAT 11: kiss_get_data extracts payload ────────────────────────────────
    let d11 = []
    push(d11, 7)
    push(d11, 8)
    push(d11, 9)
    let f11 = kiss_frame(3, 1, d11)
    let gd11 = kiss_get_data(f11)
    assert_list("get_data", gd11, d11)

    // ── KAT 12: malformed (empty) input does not crash ────────────────────────
    let bad12 = []
    let dec12 = kiss_deframe(bad12)
    assert_int("deframe empty port", dec12["port"], 0)
    assert_int("deframe empty cmd", dec12["cmd"], 0)

    // ── KAT 13: all-FEND payload survives round-trip ──────────────────────────
    let d13 = []
    push(d13, 0xC0)
    push(d13, 0xC0)
    push(d13, 0xC0)
    let f13 = kiss_frame(0, 0, d13)
    let dec13 = kiss_deframe(f13)
    assert_list("all-FEND rt", dec13["data"], d13)

    print("PASS _kiss_test")
