import std/search/first_true

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + name + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(name: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + name + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + name + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// KAT: ft_boundary([false,false,true,true])=2
let b1 = [false, false, true, true]
cki("boundary_basic", ft_boundary(b1), 2)

// KAT: ft_boundary([true,true])=0
let b2 = [true, true]
cki("boundary_all_true", ft_boundary(b2), 0)

// KAT: ft_boundary([false,false])=-1
let b3 = [false, false]
cki("boundary_all_false", ft_boundary(b3), -1)

// KAT: ft_boundary([false,true])=1
let b4 = [false, true]
cki("boundary_two", ft_boundary(b4), 1)

// edge: single true
let b5 = [true]
cki("boundary_single_true", ft_boundary(b5), 0)

// edge: single false
let b6 = [false]
cki("boundary_single_false", ft_boundary(b6), -1)

// edge: empty
let b7 = []
cki("boundary_empty", ft_boundary(b7), -1)

// larger monotone list: boundary at 5
let b8 = [false, false, false, false, false, true, true, true]
cki("boundary_larger", ft_boundary(b8), 5)

// boundary at last index
let b9 = [false, false, false, true]
cki("boundary_last", ft_boundary(b9), 3)

// KAT: ft_smallest_with_sq_ge(10)=4  (4*4=16>=10, 3*3=9<10)
cki("sq_ge_10", ft_smallest_with_sq_ge(10), 4)

// KAT: ft_smallest_with_sq_ge(9)=3   (3*3=9>=9)
cki("sq_ge_9", ft_smallest_with_sq_ge(9), 3)

// edge: target=0 -> x=0
cki("sq_ge_0", ft_smallest_with_sq_ge(0), 0)

// edge: target=1 -> x=1
cki("sq_ge_1", ft_smallest_with_sq_ge(1), 1)

// target=4 -> x=2
cki("sq_ge_4", ft_smallest_with_sq_ge(4), 2)

// target=5 -> x=3 (3*3=9>=5, 2*2=4<5)
cki("sq_ge_5", ft_smallest_with_sq_ge(5), 3)

// target=25 -> x=5
cki("sq_ge_25", ft_smallest_with_sq_ge(25), 5)

// target=26 -> x=6 (6*6=36>=26, 5*5=25<26)
cki("sq_ge_26", ft_smallest_with_sq_ge(26), 6)

// KAT: ft_largest_with_sq_le(10)=3  (3*3=9<=10, 4*4=16>10)
cki("sq_le_10", ft_largest_with_sq_le(10), 3)

// KAT: ft_largest_with_sq_le(9)=3   (3*3=9<=9)
cki("sq_le_9", ft_largest_with_sq_le(9), 3)

// edge: target=0 -> x=0
cki("sq_le_0", ft_largest_with_sq_le(0), 0)

// edge: target=1 -> x=1
cki("sq_le_1", ft_largest_with_sq_le(1), 1)

// target=3 -> x=1 (1*1=1<=3, 2*2=4>3)
cki("sq_le_3", ft_largest_with_sq_le(3), 1)

// target=4 -> x=2
cki("sq_le_4", ft_largest_with_sq_le(4), 2)

// target=24 -> x=4 (4*4=16<=24, 5*5=25>24)
cki("sq_le_24", ft_largest_with_sq_le(24), 4)

// target=25 -> x=5
cki("sq_le_25", ft_largest_with_sq_le(25), 5)

print("PASS _first_true_test")
