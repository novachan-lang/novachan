import forge_catalog

fn main()
    let c = cat_new()
    c = cat_add_table(c, "users", "User accounts")
    c = cat_add_table(c, "orders", "Purchase orders")
    assert(cat_table_count(c) == 2, "2 tables")

    let r1 = cat_add_column(c, "users", "id", "int")
    assert(is_ok(r1), "add column ok")
    c = unwrap(r1)
    let r2 = cat_add_column(c, "users", "name", "string")
    c = unwrap(r2)
    assert(cat_column_count(c, "users") == 2, "2 columns")

    let r3 = cat_add_column(c, "missing", "x", "int")
    assert(is_err(r3), "unknown table is err")

    let desc = cat_table_description(c, "users")
    assert(is_ok(desc), "desc ok")
    assert(unwrap(desc) == "User accounts", "correct desc")

    let r4 = cat_add_lineage(c, "users", "orders")
    assert(is_ok(r4), "lineage ok")
    c = unwrap(r4)
    assert(cat_has_lineage(c, "users", "orders") == 1, "lineage exists")
    assert(cat_has_lineage(c, "orders", "users") == 0, "no reverse lineage")

    let bad = cat_add_lineage(c, "users", "unknown")
    assert(is_err(bad), "unknown target is err")

    print("CATALOG KAT PASS")
