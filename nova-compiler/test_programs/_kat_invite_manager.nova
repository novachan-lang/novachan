import forge_invite_manager

fn main()
    let i = inv_new(3)
    i = inv_create(i, "ABC123", "admin", 1000)
    assert(inv_total_created(i) == 1, "1 created")

    let r1 = inv_redeem(i, "ABC123", 500)
    assert(is_ok(r1), "redeem ok")
    i = unwrap(r1)
    assert(inv_uses(i, "ABC123") == 1, "1 use")

    let r2 = inv_redeem(i, "ABC123", 600)
    i = unwrap(r2)
    let r3 = inv_redeem(i, "ABC123", 700)
    i = unwrap(r3)

    let r4 = inv_redeem(i, "ABC123", 800)
    assert(is_err(r4), "max uses reached")

    let expired = inv_redeem(i, "ABC123", 2000)
    assert(is_err(expired), "expired invite")

    let unknown = inv_redeem(i, "XYZ", 100)
    assert(is_err(unknown), "unknown invite")

    i = inv_create(i, "DEF456", "bob", 5000)
    let rev = inv_revoke(i, "DEF456")
    i = unwrap(rev)
    let revoked = inv_redeem(i, "DEF456", 100)
    assert(is_err(revoked), "revoked invite")

    assert(inv_total_redeemed(i) == 3, "3 redeemed")

    print("INVITE-MANAGER KAT PASS")
