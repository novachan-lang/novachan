// Known-answer tests for std/util/ulid.
// Hand-computed invariants are used where the result is fully determined;
// structural assertions (length, alphabet membership, round-trip) cover the
// rest.  The same (ts, seed) pair always produces the same string — verified
// by generating twice and comparing.

import std/util/ulid
import std/util/prng

// Helper: return 1 if every character of s is in the Crockford Base32
// alphabet "0123456789ABCDEFGHJKMNPQRSTVWXYZ", else 0.
fn _all_in_alpha(s: str) -> int
    let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let i = 0
    while i < len(s)
        let c = s[i]
        let found = 0
        let j = 0
        while j < 32
            if alpha[j] == c
                found = 1
            j = j + 1
        if found == 0
            return 0
        i = i + 1
    1

fn cki(got: int, exp: int, label: str)
    if got != exp
        print("FAIL " + label + ": got " + str(got) + " expected " + str(exp))
        exit(1)

fn cks(got: str, exp: str, label: str)
    if got != exp
        print("FAIL " + label + ": got " + got + " expected " + exp)
        exit(1)

fn main()
    let seed = prng_seed(42)

    // ── KAT 1: length is exactly 26 ─────────────────────────────────────────
    let r1 = ul_gen(1700000000000, seed)
    let id1 = r1[0]
    cki(len(id1), 26, "length==26")

    // ── KAT 2: every character is in the Crockford alphabet ─────────────────
    cki(_all_in_alpha(id1), 1, "all_in_alpha")

    // ── KAT 3: round-trip timestamp ──────────────────────────────────────────
    // ul_timestamp decodes the first 10 chars back to the original ms value.
    cki(ul_timestamp(id1), 1700000000000, "roundtrip ts=1700000000000")

    // ── KAT 4: timestamp 0 round-trips ───────────────────────────────────────
    let r4 = ul_gen(0, seed)
    let id4 = r4[0]
    cki(ul_timestamp(id4), 0, "roundtrip ts=0")
    // The timestamp prefix for ts=0 is all '0' characters.
    cks(id1[0], "0", "ts0 prefix char0")

    // ── KAT 5: determinism — same (ts, seed) -> identical string ─────────────
    let r5a = ul_gen(1700000000000, seed)
    let r5b = ul_gen(1700000000000, seed)
    cks(r5a[0], r5b[0], "determinism: same ts+seed -> same id")

    // ── KAT 6: larger ts gives lexicographically not-smaller ts prefix ───────
    // We compare the 10-char timestamp prefixes of two ULIDs with ts1 < ts2.
    // Because Crockford encodes big-endian, lexicographic order == numeric order.
    let ts_small = 1700000000000
    let ts_large = 1700000001000
    let r_small = ul_gen(ts_small, seed)
    let r_large = ul_gen(ts_large, seed)
    let prefix_small = r_small[0][0] + r_small[0][1] + r_small[0][2] + r_small[0][3] + r_small[0][4] + r_small[0][5] + r_small[0][6] + r_small[0][7] + r_small[0][8] + r_small[0][9]
    let prefix_large = r_large[0][0] + r_large[0][1] + r_large[0][2] + r_large[0][3] + r_large[0][4] + r_large[0][5] + r_large[0][6] + r_large[0][7] + r_large[0][8] + r_large[0][9]
    // Lexicographic: prefix_small <= prefix_large. Since ts_large > ts_small,
    // the encoded prefix must be >= the smaller. Verify they differ.
    if prefix_large < prefix_small
        print("FAIL lex_order: larger ts should give not-smaller prefix")
        exit(1)

    // ── KAT 7: the id structure is 10 ts chars + 16 random chars ─────────────
    // Round-trip on a different timestamp.
    let r7 = ul_gen(1000000000000, seed)
    let id7 = r7[0]
    cki(len(id7), 26, "length==26 ts2")
    cki(ul_timestamp(id7), 1000000000000, "roundtrip ts=1000000000000")
    cki(_all_in_alpha(id7), 1, "all_in_alpha ts2")

    // ── KAT 8: ts=0 prefix is "0000000000" ───────────────────────────────────
    let id0 = ul_gen(0, seed)[0]
    let prefix0 = id0[0] + id0[1] + id0[2] + id0[3] + id0[4] + id0[5] + id0[6] + id0[7] + id0[8] + id0[9]
    cks(prefix0, "0000000000", "ts=0 prefix is all zeros")

    print("_ulid_test passed")
