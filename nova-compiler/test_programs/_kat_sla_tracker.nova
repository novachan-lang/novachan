import forge_sla_tracker

fn main()
    let s = sla_new()
    s = sla_set_target(s, "api", 95)
    s = sla_set_target(s, "db", 99)
    assert(sla_service_count(s) == 2, "2 services")

    let i = 0
    while i < 100
        s = sla_record(s, "api", 1)
        i = i + 1
    assert(sla_pct(s, "api") == 100, "api 100%")
    assert(sla_is_met(s, "api") == 1, "api meets SLA")

    i = 0
    while i < 10
        s = sla_record(s, "db", 1)
        i = i + 1
    i = 0
    while i < 2
        s = sla_record(s, "db", 0)
        i = i + 1
    assert(sla_pct(s, "db") == 83, "db 83%")
    assert(sla_is_met(s, "db") == 0, "db misses 99% SLA")

    assert(sla_worst_service(s) == "db", "db is worst")
    assert(sla_violations(s) == 1, "1 violation")

    print("SLA-TRACKER KAT PASS")
