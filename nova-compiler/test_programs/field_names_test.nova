type Person
    name: string
    age: int
    score: float

fn main()
    let p = Person("Alice", 30, 9.5)
    let ns = field_names(p)
    assert(len(ns) == 3, "3 field names")
    assert(ns[0] == "name", "f0 name")
    assert(ns[1] == "age", "f1 age")
    assert(ns[2] == "score", "f2 score")
    let ts = field_types(p)
    assert(ts[0] == "string", "t0 string")
    assert(ts[2] == "float", "t2 float")
    print("field_names_test: passed")
