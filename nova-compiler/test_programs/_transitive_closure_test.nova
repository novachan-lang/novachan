import std/graph/transitive_closure

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT graph: 0->1->2 (chain)
    let adj = []
    let r0 = []
    r0.push(1)
    adj.push(r0)
    let r1 = []
    r1.push(2)
    adj.push(r1)
    let r2 = []
    adj.push(r2)

    // tc_is_reachable
    ckb("kat1_reach_0_2", transitive_closure.tc_is_reachable(adj, 3, 0, 2), true)
    ckb("kat2_reach_2_0", transitive_closure.tc_is_reachable(adj, 3, 2, 0), false)
    ckb("kat3_reach_0_1", transitive_closure.tc_is_reachable(adj, 3, 0, 1), true)
    ckb("kat4_reach_1_2", transitive_closure.tc_is_reachable(adj, 3, 1, 2), true)
    ckb("kat5_reach_1_0", transitive_closure.tc_is_reachable(adj, 3, 1, 0), false)
    ckb("kat6_reach_2_1", transitive_closure.tc_is_reachable(adj, 3, 2, 1), false)

    // tc_count_reachable
    cki("kat7_count_0", transitive_closure.tc_count_reachable(adj, 3, 0), 2)
    cki("kat8_count_1", transitive_closure.tc_count_reachable(adj, 3, 1), 1)
    cki("kat9_count_2", transitive_closure.tc_count_reachable(adj, 3, 2), 0)

    // tc_closure_matrix
    let mat = transitive_closure.tc_closure_matrix(adj, 3)
    cki("kat10_mat_0_2", mat[0][2], 1)
    cki("kat11_mat_0_1", mat[0][1], 1)
    cki("kat12_mat_1_2", mat[1][2], 1)
    cki("kat13_mat_0_0", mat[0][0], 0)
    cki("kat14_mat_2_0", mat[2][0], 0)
    cki("kat15_mat_1_0", mat[1][0], 0)
    cki("kat16_mat_2_1", mat[2][1], 0)
    cki("kat17_mat_1_1", mat[1][1], 0)
    cki("kat18_mat_2_2", mat[2][2], 0)

    // edge case: n=0
    let empty_adj = []
    let mat0 = transitive_closure.tc_closure_matrix(empty_adj, 0)
    cki("kat19_empty_matrix_len", len(mat0), 0)
    cki("kat20_empty_count", transitive_closure.tc_count_reachable(empty_adj, 0, 0), 0)

    // cycle: 0->1->2->0
    let cadj = []
    let cr0 = []
    cr0.push(1)
    cadj.push(cr0)
    let cr1 = []
    cr1.push(2)
    cadj.push(cr1)
    let cr2 = []
    cr2.push(0)
    cadj.push(cr2)
    ckb("kat21_cycle_0_2", transitive_closure.tc_is_reachable(cadj, 3, 0, 2), true)
    ckb("kat22_cycle_2_0", transitive_closure.tc_is_reachable(cadj, 3, 2, 0), true)
    cki("kat23_cycle_count_0", transitive_closure.tc_count_reachable(cadj, 3, 0), 2)

    print("PASS _transitive_closure_test")

main()
