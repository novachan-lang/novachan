import forge_anagram
fn main()
    for p in [["listen","silent"],["abc","cba"],["abc","abd"],["a",""],["",""],["aab","abb"],["Abc","abc"]]
        print("[" + p[0] + "|" + p[1] + "] " + str(is_anagram(p[0], p[1])))
    for w in ["cba", "", "aaa", "zyx"]
        print("sig(" + w + ")=[" + anagram_signature(w) + "]")
