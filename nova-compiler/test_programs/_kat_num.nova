import std/core/num

fn main() -> int
    let fails = 0
    if int_abs(0 - 7) != 7
        print("FAIL abs")
        fails = fails + 1
    if int_sign(0 - 3) != 0 - 1
        print("FAIL sign neg")
        fails = fails + 1
    if int_sign(0) != 0
        print("FAIL sign zero")
        fails = fails + 1
    if int_clamp(15, 0, 10) != 10
        print("FAIL clamp hi")
        fails = fails + 1
    if int_clamp(0 - 5, 0, 10) != 0
        print("FAIL clamp lo")
        fails = fails + 1
    if int_clamp(5, 0, 10) != 5
        print("FAIL clamp mid")
        fails = fails + 1
    if int_min(3, 8) != 3
        print("FAIL min")
        fails = fails + 1
    if int_max(3, 8) != 8
        print("FAIL max")
        fails = fails + 1
    if int_gcd(12, 18) != 6
        print("FAIL gcd")
        fails = fails + 1
    if int_lcm(4, 6) != 12
        print("FAIL lcm")
        fails = fails + 1
    if int_pow(2, 10) != 1024
        print("FAIL pow")
        fails = fails + 1
    if int_pow(5, 0) != 1
        print("FAIL pow0")
        fails = fails + 1
    if not int_is_even(4)
        print("FAIL even")
        fails = fails + 1
    if not int_is_odd(7)
        print("FAIL odd")
        fails = fails + 1
    if fails == 0
        print("PASS _kat_num")
    else
        print("FAILED _kat_num")
    return 0
