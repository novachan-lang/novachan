// forge_validate_typed_test -- forge.validate_typed validates a TYPED app struct cross-module via the
// RTTI-through-any keystone (forge introspecting a struct defined HERE). The real cross-module exercise
// of 76ff854. Adds the fail-closed coverage check (typo'd rule key -> unknown_field) the dict path lacks.
import forge

type User
    name: string
    age: int
    score: float

fn rules()
    let r = {}
    r["name"] = [forge.required(), forge.min_len(1), forge.max_len(80)]
    r["age"] = [forge.min(13), forge.max(120)]
    r["score"] = [forge.min(0), forge.max(10)]
    r

fn main()
    // valid typed struct -> ok (forge walks the app struct via cross-module RTTI)
    let good = User("ada", 30, 9.5)
    assert(is_ok(forge.validate_typed(good, rules())), "valid typed struct -> ok")
    print("PASS: valid typed struct -> ok (cross-module RTTI)")

    // multiple violations on the typed struct -> collect-all (name empty+short, age too small, score too big)
    let bad = User("", 5, 99.0)
    let rb = forge.validate_typed(bad, rules())
    assert(is_err(rb), "invalid typed struct -> err")
    let errs = unwrap_err(rb)
    assert(len(errs) >= 3, "collect-all on typed struct: >=3 (got " + str(len(errs)) + ")")
    let body = forge.body_of(forge.errors_response(errs))
    assert(find(body, "name") >= 0, "name error")
    assert(find(body, "too_small") >= 0, "age too_small")
    assert(find(body, "too_big") >= 0, "score(float) too_big")
    print("PASS: collect-all on typed struct (" + str(len(errs)) + " errors, incl. float range)")

    // fail-closed coverage: a rule key that is NOT a struct field -> unknown_field (the dict path cannot detect this)
    let rt = forge.validate_typed(good, {"naem": [forge.required()]})
    assert(is_err(rt), "typo'd rule key -> err (fail-closed)")
    assert(find(forge.body_of(forge.errors_response(unwrap_err(rt))), "unknown_field") >= 0, "unknown_field code")
    print("PASS: typo'd rule key -> unknown_field (coverage check)")

    print("forge_validate_typed_test passed")
