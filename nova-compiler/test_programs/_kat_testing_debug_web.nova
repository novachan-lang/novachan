// ============================================================================
// KAT — combined known-answer test for 6 new stdlib modules:
//   std/testing/mock (mk_ API)      std/testing/snapshot (sn_ API)
//   std/debug/trace  (dt_ API)      std/debug/inspect     (di_ API)
//   std/web/url_builder (ub_ API)   std/web/form          (wf_ API)
// Every expected value below is hand-computed, not just "does it run".
// ============================================================================

import std/testing/mock
import std/testing/snapshot
import std/debug/trace
import std/debug/inspect
import std/web/url_builder
import std/web/form

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

fn ckbool(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": bool mismatch")
        exit(1)

// ── std/testing/mock (mk_ API) ────────────────────────────────────────────────
fn test_mock()
    let m = mk_new("collab_spy")

    // fresh tracker: nothing called yet
    cki("mk_fresh_count_a", mk_call_count(m, "on_success"), 0)
    cki("mk_fresh_was_called", mk_was_called(m, "on_success"), 0)

    // record 3 calls to on_success, 1 to on_error
    mk_called(m, "on_success")
    mk_called(m, "on_success")
    mk_called(m, "on_success")
    mk_called(m, "on_error")

    cki("mk_count_on_success", mk_call_count(m, "on_success"), 3)
    cki("mk_count_on_error", mk_call_count(m, "on_error"), 1)
    cki("mk_count_unseen", mk_call_count(m, "on_complete"), 0)
    cki("mk_was_called_success", mk_was_called(m, "on_success"), 1)
    cki("mk_was_called_unseen", mk_was_called(m, "on_complete"), 0)

    // verify_all: all present -> 1
    let expected_all = ["on_success", "on_error"]
    cki("mk_verify_all_true", mk_verify_all(m, expected_all), 1)

    // verify_all: one missing -> 0
    let expected_missing = ["on_success", "on_error", "on_complete"]
    cki("mk_verify_all_false", mk_verify_all(m, expected_missing), 0)

    // verify_all with empty expected list -> vacuously 1
    let expected_empty = []
    cki("mk_verify_all_empty", mk_verify_all(m, expected_empty), 1)

    // reset clears counts
    mk_reset(m)
    cki("mk_reset_count", mk_call_count(m, "on_success"), 0)
    cki("mk_reset_was_called", mk_was_called(m, "on_success"), 0)

    // second, independent tracker is unaffected by the first
    let m2 = mk_new("other_spy")
    mk_called(m2, "handler")
    cki("mk_independent_m2", mk_call_count(m2, "handler"), 1)
    cki("mk_independent_m", mk_call_count(m, "handler"), 0)

    print("mock: OK")

// ── std/testing/snapshot (sn_ API) ────────────────────────────────────────────
fn test_snapshot()
    let store = sn_new()
    cki("sn_new_count", sn_count(store), 0)

    // record two snapshots
    sn_record(store, "user_1", {"name": "Ada", "age": 30})
    sn_record(store, "greeting", "hello")

    cki("sn_count_after_record", sn_count(store), 2)

    // check: matching value -> 1
    cki("sn_check_match", sn_check(store, "greeting", "hello"), 1)

    // check: changed value -> 0
    cki("sn_check_mismatch", sn_check(store, "greeting", "goodbye"), 0)

    // check: unknown key -> 0
    cki("sn_check_missing_key", sn_check(store, "nope", "x"), 0)

    // diff: matching value -> ""
    cks("sn_diff_match", sn_diff(store, "greeting", "hello"), "")

    // diff: unknown key -> dedicated message
    cks("sn_diff_missing_key", sn_diff(store, "nope", "x"), "no snapshot recorded for key nope")

    // diff: changed value -> snap_diff's standard message
    cks("sn_diff_mismatch", sn_diff(store, "greeting", "goodbye"), "snapshot mismatch: got goodbye want hello")

    // dict snapshot still matches via canonical serialization (key order independent)
    let d2 = {}
    d2["age"] = 30
    d2["name"] = "Ada"
    cki("sn_check_dict_match", sn_check(store, "user_1", d2), 1)

    // keys: both recorded keys present (order-independent — sort for determinism)
    let ks = sn_keys(store)
    cki("sn_keys_len", len(ks), 2)
    let sorted_ks = sort(ks)
    cks("sn_keys_sorted_0", sorted_ks[0], "greeting")
    cks("sn_keys_sorted_1", sorted_ks[1], "user_1")

    print("snapshot: OK")

// ── std/debug/trace (dt_ API) ─────────────────────────────────────────────────
fn test_trace()
    let t = dt_new()
    cki("dt_fresh_depth", dt_depth(t), 0)
    cki("dt_fresh_entries_len", len(dt_entries(t)), 0)

    dt_enter(t, "main")
    cki("dt_depth_after_enter_main", dt_depth(t), 1)

    dt_enter(t, "helper")
    cki("dt_depth_after_enter_helper", dt_depth(t), 2)

    dt_log(t, "doing work")

    dt_exit(t, "helper")
    cki("dt_depth_after_exit_helper", dt_depth(t), 1)

    dt_exit(t, "main")
    cki("dt_depth_after_exit_main", dt_depth(t), 0)

    let entries = dt_entries(t)
    cki("dt_entries_len", len(entries), 5)
    cks("dt_entry_0", entries[0], "-> main")
    cks("dt_entry_1", entries[1], "  -> helper")
    cks("dt_entry_2", entries[2], "    doing work")
    cks("dt_entry_3", entries[3], "  <- helper")
    cks("dt_entry_4", entries[4], "<- main")

    let dump = dt_dump(t)
    let want_dump = "-> main\n  -> helper\n    doing work\n  <- helper\n<- main"
    cks("dt_dump_full", dump, want_dump)

    // exit-underflow guard: extra exit on a fresh trace never goes below depth 0
    let t2 = dt_new()
    dt_exit(t2, "phantom")
    cki("dt_underflow_guard", dt_depth(t2), 0)

    print("trace: OK")

// ── std/debug/inspect (di_ API) ───────────────────────────────────────────────
fn test_inspect()
    // di_type_name
    cks("di_type_int", di_type_name(42), "int")
    cks("di_type_float", di_type_name(3.5), "float")
    cks("di_type_string", di_type_name("hi"), "string")
    cks("di_type_list", di_type_name([1, 2]), "list")
    cks("di_type_dict", di_type_name({}), "dict")
    // booleans ARE ints in NOVA's type_of (documented project-wide convention)
    cks("di_type_bool_is_int", di_type_name(true), "int")

    // di_is_truthy
    cki("di_truthy_nonzero_int", di_is_truthy(42), 1)
    cki("di_truthy_zero_int", di_is_truthy(0), 0)
    cki("di_truthy_null", di_is_truthy(null), 0)
    cki("di_truthy_nonempty_string", di_is_truthy("x"), 1)
    cki("di_truthy_empty_string", di_is_truthy(""), 0)
    cki("di_truthy_nonempty_list", di_is_truthy([1]), 1)
    cki("di_truthy_empty_list", di_is_truthy([]), 0)
    cki("di_truthy_nonempty_dict", di_is_truthy({"a": 1}), 1)
    cki("di_truthy_empty_dict", di_is_truthy({}), 0)
    cki("di_truthy_nonzero_float", di_is_truthy(2.5), 1)
    cki("di_truthy_zero_float", di_is_truthy(0.0), 0)

    // di_deep_size
    cki("di_deep_scalar", di_deep_size(42), 1)
    cki("di_deep_flat_list", di_deep_size([1, 2, 3]), 4)          // 1 + 3 leaves
    cki("di_deep_nested_list", di_deep_size([[1, 2], [3]]), 6)    // 1 + (1+1+1) + (1+1)
    cki("di_deep_empty_dict", di_deep_size({}), 1)
    let dd = {}
    dd["a"] = 1
    dd["b"] = [2, 3]
    cki("di_deep_mixed_dict", di_deep_size(dd), 5)                // 1 + 1 + (1+1+1)

    // di_summarize
    cks("di_sum_int", di_summarize(7), "int:7")
    cks("di_sum_list", di_summarize([1, 2, 3]), "list[3]")
    let sd = {}
    sd["x"] = 1
    sd["y"] = 2
    // '{'/'}' interpolate in NOVA string literals -- build the expected
    // "dict{2}" via chr(123)/chr(125), same idiom as std/testing/snapshot.
    let ob2 = chr(123)
    let cb2 = chr(125)
    cks("di_sum_dict", di_summarize(sd), "dict" + ob2 + "2" + cb2)
    cks("di_sum_short_string", di_summarize("hi"), "string(2):hi")

    // di_compare
    cki("di_cmp_int_lt", di_compare(1, 2), -1)
    cki("di_cmp_int_eq", di_compare(5, 5), 0)
    cki("di_cmp_int_gt", di_compare(9, 2), 1)
    cki("di_cmp_mixed_num", di_compare(2, 2.5), -1)          // 2 < 2.5 across int/float
    cki("di_cmp_str_lt", di_compare("apple", "banana"), -1)
    cki("di_cmp_str_eq", di_compare("same", "same"), 0)
    cki("di_cmp_str_prefix", di_compare("app", "apple"), -1) // shorter prefix sorts first

    print("inspect: OK")

// ── std/web/url_builder (ub_ API) ─────────────────────────────────────────────
fn test_url_builder()
    // base with no trailing slash
    let b = ub_new("https://api.example.com")
    ub_path(b, "users")
    ub_path(b, "42")
    ub_param(b, "sort", "name")
    ub_param(b, "q", "a b")
    ub_fragment(b, "top")

    cks("ub_params_str", ub_params_str(b), "sort=name&q=a%20b")
    cks("ub_build_full", ub_build(b), "https://api.example.com/users/42?sort=name&q=a%20b#top")

    // base with trailing slash is normalized (trimmed)
    let b2 = ub_new("https://api.example.com/")
    ub_path(b2, "ping")
    cks("ub_build_trailing_slash_base", ub_build(b2), "https://api.example.com/ping")

    // no path, no params, no fragment -> just the base
    let b3 = ub_new("https://x.com")
    cks("ub_build_bare", ub_build(b3), "https://x.com")

    // empty params_str when no params were added
    let b4 = ub_new("https://x.com")
    cks("ub_params_str_empty", ub_params_str(b4), "")

    // duplicate keys are preserved, both appear
    let b5 = ub_new("https://x.com")
    ub_param(b5, "tag", "a")
    ub_param(b5, "tag", "b")
    cks("ub_dup_keys", ub_params_str(b5), "tag=a&tag=b")

    // reserved characters in a path segment get escaped (segment treated as opaque)
    let b6 = ub_new("https://x.com")
    ub_path(b6, "a/b")
    cks("ub_path_escapes_slash", ub_build(b6), "https://x.com/a%2Fb")

    print("url_builder: OK")

// ── std/web/form (wf_ API) ────────────────────────────────────────────────────
fn test_form()
    let f = wf_new()
    ckbool("wf_new_has_none", wf_has(f, "q"), false)
    cks("wf_new_get_missing", wf_get(f, "q"), "")

    wf_set(f, "q", "a+b c")
    wf_set(f, "page", "2")

    ckbool("wf_has_q", wf_has(f, "q"), true)
    cks("wf_get_q", wf_get(f, "q"), "a+b c")
    cks("wf_get_page", wf_get(f, "page"), "2")

    let ks = wf_keys(f)
    cki("wf_keys_len", len(ks), 2)
    cks("wf_keys_order_0", ks[0], "q")
    cks("wf_keys_order_1", ks[1], "page")

    // re-setting an existing key updates value, does NOT change key order
    wf_set(f, "q", "updated")
    cks("wf_get_q_updated", wf_get(f, "q"), "updated")
    let ks2 = wf_keys(f)
    cks("wf_keys_order_unchanged_0", ks2[0], "q")

    // encode: '+' -> %2B, space -> '+', in insertion order
    let f2 = wf_new()
    wf_set(f2, "q", "a+b c")
    wf_set(f2, "page", "2")
    cks("wf_encode", wf_encode(f2), "q=a%2Bb+c&page=2")

    // empty form encodes to ""
    let f3 = wf_new()
    cks("wf_encode_empty", wf_encode(f3), "")

    // decode round-trips the encoded form
    let decoded = wf_decode("q=a%2Bb+c&page=2")
    cks("wf_decode_q", wf_get(decoded, "q"), "a+b c")
    cks("wf_decode_page", wf_get(decoded, "page"), "2")
    let dks = wf_keys(decoded)
    cks("wf_decode_order_0", dks[0], "q")
    cks("wf_decode_order_1", dks[1], "page")

    // decode: bare key with no '=' gets empty value
    let flag_form = wf_decode("flag")
    ckbool("wf_decode_bare_has", wf_has(flag_form, "flag"), true)
    cks("wf_decode_bare_val", wf_get(flag_form, "flag"), "")

    // decode: empty string -> empty form
    let empty_form = wf_decode("")
    cki("wf_decode_empty_keys", len(wf_keys(empty_form)), 0)

    print("form: OK")

fn main()
    test_mock()
    test_snapshot()
    test_trace()
    test_inspect()
    test_url_builder()
    test_form()
    print("PASS _kat_testing_debug_web")
