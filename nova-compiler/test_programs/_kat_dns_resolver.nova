import forge_dns_resolver

fn main()
    let d = dns_new()
    assert(dns_host_count(d) == 0, "empty")

    d = dns_add_record(d, "api.example.com", "10.0.0.1", 300, 1000)
    d = dns_add_record(d, "api.example.com", "10.0.0.2", 300, 1000)
    d = dns_add_record(d, "db.example.com", "10.0.1.1", 600, 1000)
    assert(dns_host_count(d) == 2, "2 hosts")

    let r1 = dns_resolve(d, "api.example.com", 1100)
    d = r1["dns"]
    assert(r1["found"] == 1, "found api")
    assert(r1["ip"] == "10.0.0.1", "first ip")

    let r2 = dns_resolve(d, "unknown.com", 1100)
    d = r2["dns"]
    assert(r2["found"] == 0, "unknown not found")

    let all = dns_resolve_all(d, "api.example.com", 1100)
    assert(len(all) == 2, "2 ips for api")

    let r3 = dns_resolve(d, "api.example.com", 2000)
    d = r3["dns"]
    assert(r3["found"] == 0, "expired after TTL")

    d = dns_set_health(d, "db.example.com", "10.0.1.1", 0)
    let r4 = dns_resolve(d, "db.example.com", 1100)
    d = r4["dns"]
    assert(r4["found"] == 0, "unhealthy not returned")

    d = dns_set_health(d, "db.example.com", "10.0.1.1", 1)
    let r5 = dns_resolve(d, "db.example.com", 1100)
    d = r5["dns"]
    assert(r5["found"] == 1, "healthy again")

    let stats = dns_stats(d)
    assert(stats["queries"] == 5, "5 queries")
    assert(stats["hits"] >= 2, "at least 2 hits")

    print("DNS-RESOLVER KAT PASS")
