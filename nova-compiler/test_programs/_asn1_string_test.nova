// _asn1_string_test — KAT for std/data/asn1_string
//
// Verifies byte-exact DER encoding per X.690 for UTF8String (0x0C),
// PrintableString (0x13), and IA5String (0x16), plus round-trip decode.
//
// KAT 1: asn1_utf8_encode("hi")     == [0x0C, 0x02, 0x68, 0x69]
// KAT 2: asn1_utf8_encode("")       == [0x0C, 0x00]
// KAT 3: asn1_printable_encode("US") == [0x13, 0x02, 0x55, 0x53]
// KAT 4: asn1_ia5_encode("a@b")     == [0x16, 0x03, 0x61, 0x40, 0x62]
// KAT 5: round-trip UTF8String "hi"   — decode recovers tag 12 + value "hi"
// KAT 6: round-trip PrintableString "US" — tag 19 + value "US"
// KAT 7: round-trip IA5String "a@b" — tag 22 + value "a@b"
// KAT 8: round-trip empty UTF8String — tag 12 + value ""
// KAT 9: asn1_string_decode rejects wrong tag (0x02 = INTEGER)
// KAT 10: asn1_string_decode on truncated input returns tag -1

import std/data/asn1_string

fn ckb(label, got, want)
    if got != want
        print("FAIL asn1_string " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: asn1_utf8_encode("hi") == [0x0C,0x02,0x68,0x69] ─────────────
    let enc1 = asn1_utf8_encode("hi")
    ckb("utf8_hi len",    bytes_len(enc1), 4)
    ckb("utf8_hi tag",    bytes_get(enc1, 0), 12)
    ckb("utf8_hi lenb",   bytes_get(enc1, 1), 2)
    ckb("utf8_hi val[0]", bytes_get(enc1, 2), 104)
    ckb("utf8_hi val[1]", bytes_get(enc1, 3), 105)
    print("KAT 1 passed: asn1_utf8_encode(\"hi\") == [0x0C,0x02,0x68,0x69]")

    // ── KAT 2: asn1_utf8_encode("") == [0x0C,0x00] ───────────────────────────
    let enc2 = asn1_utf8_encode("")
    ckb("utf8_empty len",  bytes_len(enc2), 2)
    ckb("utf8_empty tag",  bytes_get(enc2, 0), 12)
    ckb("utf8_empty lenb", bytes_get(enc2, 1), 0)
    print("KAT 2 passed: asn1_utf8_encode(\"\") == [0x0C,0x00]")

    // ── KAT 3: asn1_printable_encode("US") == [0x13,0x02,0x55,0x53] ─────────
    // 'U'=0x55=85, 'S'=0x53=83
    let enc3 = asn1_printable_encode("US")
    ckb("prt_US len",    bytes_len(enc3), 4)
    ckb("prt_US tag",    bytes_get(enc3, 0), 19)
    ckb("prt_US lenb",   bytes_get(enc3, 1), 2)
    ckb("prt_US val[0]", bytes_get(enc3, 2), 85)
    ckb("prt_US val[1]", bytes_get(enc3, 3), 83)
    print("KAT 3 passed: asn1_printable_encode(\"US\") == [0x13,0x02,0x55,0x53]")

    // ── KAT 4: asn1_ia5_encode("a@b") == [0x16,0x03,0x61,0x40,0x62] ─────────
    // 'a'=0x61=97, '@'=0x40=64, 'b'=0x62=98
    let enc4 = asn1_ia5_encode("a@b")
    ckb("ia5_atb len",    bytes_len(enc4), 5)
    ckb("ia5_atb tag",    bytes_get(enc4, 0), 22)
    ckb("ia5_atb lenb",   bytes_get(enc4, 1), 3)
    ckb("ia5_atb val[0]", bytes_get(enc4, 2), 97)
    ckb("ia5_atb val[1]", bytes_get(enc4, 3), 64)
    ckb("ia5_atb val[2]", bytes_get(enc4, 4), 98)
    print("KAT 4 passed: asn1_ia5_encode(\"a@b\") == [0x16,0x03,0x61,0x40,0x62]")

    // ── KAT 5: round-trip UTF8String "hi" ─────────────────────────────────────
    let rt5 = asn1_string_decode(enc1, 0)
    let d5 = rt5[0]
    let pos5 = rt5[1]
    ckb("rt_utf8 tag",   d5["tag"], 12)
    ckb("rt_utf8 value", d5["value"], "hi")
    ckb("rt_utf8 pos",   pos5, 4)
    print("KAT 5 passed: round-trip UTF8String \"hi\" -> tag=12, value=\"hi\", next_pos=4")

    // ── KAT 6: round-trip PrintableString "US" ────────────────────────────────
    let rt6 = asn1_string_decode(enc3, 0)
    let d6 = rt6[0]
    let pos6 = rt6[1]
    ckb("rt_prt tag",   d6["tag"], 19)
    ckb("rt_prt value", d6["value"], "US")
    ckb("rt_prt pos",   pos6, 4)
    print("KAT 6 passed: round-trip PrintableString \"US\" -> tag=19, value=\"US\"")

    // ── KAT 7: round-trip IA5String "a@b" ─────────────────────────────────────
    let rt7 = asn1_string_decode(enc4, 0)
    let d7 = rt7[0]
    let pos7 = rt7[1]
    ckb("rt_ia5 tag",   d7["tag"], 22)
    ckb("rt_ia5 value", d7["value"], "a@b")
    ckb("rt_ia5 pos",   pos7, 5)
    print("KAT 7 passed: round-trip IA5String \"a@b\" -> tag=22, value=\"a@b\"")

    // ── KAT 8: round-trip empty UTF8String ────────────────────────────────────
    let rt8 = asn1_string_decode(enc2, 0)
    let d8 = rt8[0]
    let pos8 = rt8[1]
    ckb("rt_empty tag",   d8["tag"], 12)
    ckb("rt_empty value", d8["value"], "")
    ckb("rt_empty pos",   pos8, 2)
    print("KAT 8 passed: round-trip empty UTF8String -> tag=12, value=\"\"")

    // ── KAT 9: asn1_string_decode rejects INTEGER tag (0x02) ─────────────────
    // Build [0x02, 0x01, 0x00] — a DER INTEGER, not a string type
    let buf9 = bytes(3)
    bytes_set(buf9, 0, 2)
    bytes_set(buf9, 1, 1)
    bytes_set(buf9, 2, 0)
    let rt9 = asn1_string_decode(buf9, 0)
    let d9 = rt9[0]
    ckb("reject_int tag", d9["tag"], -1)
    print("KAT 9 passed: asn1_string_decode rejects INTEGER tag -> tag=-1")

    // ── KAT 10: asn1_string_decode on truncated input ─────────────────────────
    // Buffer has only the tag byte; no length byte follows
    let buf10 = bytes(1)
    bytes_set(buf10, 0, 12)
    let rt10 = asn1_string_decode(buf10, 0)
    let d10 = rt10[0]
    ckb("truncated tag", d10["tag"], -1)
    print("KAT 10 passed: asn1_string_decode truncated buffer -> tag=-1")

    print("PASS _asn1_string_test")
