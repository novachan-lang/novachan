import forge_config_store

fn main()
    let c = cfg_new()
    c = cfg_set(c, "host", "localhost")
    c = cfg_set(c, "port", "8080")
    c = cfg_set_default(c, "timeout", "30")
    assert(cfg_count(c) == 2, "2 values")

    let r1 = cfg_get(c, "host")
    assert(is_ok(r1), "get host ok")
    assert(unwrap(r1) == "localhost", "host=localhost")

    let r2 = cfg_get(c, "timeout")
    assert(is_ok(r2), "get default ok")
    assert(unwrap(r2) == "30", "timeout=30")

    assert(cfg_has(c, "port") == 1, "has port")
    assert(cfg_has(c, "nope") == 0, "no nope")

    let bad = cfg_get(c, "missing")
    assert(is_err(bad), "missing err")

    print("CONFIG-STORE KAT PASS")
