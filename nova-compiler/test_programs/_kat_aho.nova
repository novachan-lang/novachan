import forge_aho

fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let ac = ac_new()
    ac_add(ac, "he")
    ac_add(ac, "she")
    ac_add(ac, "his")
    ac_add(ac, "hers")
    ac_build(ac)
    // classic example: text "ushers" -> she@3, he@3, hers@5 ; "his" absent
    let m = ac_search(ac, "ushers")
    print("count=" + str(len(m)))
    // collect "pattern@end" strings
    let found = ""
    let i = 0
    while i < len(m)
        found = found + m[i][0] + "@" + str(m[i][1]) + " "
        i = i + 1
    print("she=" + tf(find(found, "she@3") >= 0))
    print("he=" + tf(find(found, "he@3") >= 0))
    print("hers=" + tf(find(found, "hers@5") >= 0))
    print("no_his=" + tf(find(found, "his@") < 0))
    // multiple occurrences
    let ac2 = ac_new()
    ac_add(ac2, "ab")
    ac_build(ac2)
    let m2 = ac_search(ac2, "ababab")
    print("multi=" + tf(len(m2) == 3))
    // no match
    print("empty=" + tf(len(ac_search(ac, "xyz")) == 0))
