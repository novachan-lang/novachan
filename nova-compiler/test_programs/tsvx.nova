fn tsv_parse(content)
  let lines = split(content, "\n")
  let result = []
  for line in lines
    if len(trim(line)) > 0
      push(result, split(line, "\t"))
  result

fn tsv_parse_with_header(content)
  let rows = tsv_parse(content)
  if len(rows) == 0
    return []
  let headers = rows[0]
  let records = []
  let i = 1
  while i < len(rows)
    let row = rows[i]
    let record = {}
    let j = 0
    while j < len(headers) and j < len(row)
      record[headers[j]] = row[j]
      j = j + 1
    push(records, record)
    i = i + 1
  records

fn tsv_format(rows)
  let lines = []
  for row in rows
    push(lines, join(row, "\t"))
  join(lines, "\n")

fn tsv_format_with_header(headers, records)
  let lines = [join(headers, "\t")]
  for rec in records
    let vals = []
    for h in headers
      if contains(rec, h)
        push(vals, str(rec[h]))
      else
        push(vals, "")
    push(lines, join(vals, "\t"))
  join(lines, "\n")

fn main()
  let tsv = "Name\tAge\tCity\nAlice\t30\tNY\nBob\t25\tSF"
  let rows = tsv_parse(tsv)
  assert(len(rows) == 3, "3 rows")
  assert(rows[0][0] == "Name", "header name")
  assert(rows[1][1] == "30", "alice age")

  let records = tsv_parse_with_header(tsv)
  assert(len(records) == 2, "2 data records")
  assert(records[0]["Name"] == "Alice", "alice name")
  assert(records[1]["City"] == "SF", "bob city")

  let formatted = tsv_format([["a", "b"], ["1", "2"]])
  assert(contains(formatted, "a\tb"), "format tabs")
  assert(contains(formatted, "1\t2"), "format data")

  let headers = ["id", "val"]
  let recs = [{"id": "1", "val": "x"}, {"id": "2", "val": "y"}]
  let out = tsv_format_with_header(headers, recs)
  assert(starts_with(out, "id\tval"), "header line")
  assert(contains(out, "1\tx"), "data line 1")

  print("tsvx: all passed")
