fn env_get(name, default_val)
  let val = env(name)
  if val == ""
    return default_val
  val

fn env_int(name, default_val)
  let val = env(name)
  if val == ""
    return default_val
  let r = parse_int_safe(val)
  if is_ok(r)
    return unwrap(r)
  default_val

fn env_bool(name, default_val)
  let val = env(name)
  if val == ""
    return default_val
  if val == "1" or val == "true" or val == "yes" or val == "TRUE" or val == "YES"
    return 1
  if val == "0" or val == "false" or val == "no" or val == "FALSE" or val == "NO"
    return 0
  default_val

fn env_require(name)
  let val = env(name)
  if val == ""
    panic("required environment variable '" + name + "' is not set")
  val

fn env_list(name, sep, default_val)
  let val = env(name)
  if val == ""
    return default_val
  split(val, sep)

fn env_dump(names)
  let result = {}
  for name in names
    let val = env(name)
    if val != ""
      result[name] = val
  result

fn main()
  set_env("TEST_PORT", "8080")
  set_env("TEST_HOST", "localhost")
  set_env("TEST_DEBUG", "true")
  set_env("TEST_WORKERS", "abc")
  set_env("TEST_TAGS", "api,web,db")

  assert(env_get("TEST_HOST", "default") == "localhost", "env_get existing")
  assert(env_get("TEST_NONEXIST", "fallback") == "fallback", "env_get missing")

  assert(env_int("TEST_PORT", 3000) == 8080, "env_int valid")
  assert(env_int("TEST_NONEXIST", 3000) == 3000, "env_int missing")
  assert(env_int("TEST_WORKERS", 4) == 4, "env_int invalid")

  assert(env_bool("TEST_DEBUG", 0) == 1, "env_bool true")
  set_env("TEST_DEBUG", "0")
  assert(env_bool("TEST_DEBUG", 1) == 0, "env_bool false")
  assert(env_bool("TEST_NONEXIST", 0) == 0, "env_bool missing")

  let tags = env_list("TEST_TAGS", ",", [])
  assert(len(tags) == 3, "env_list count")
  assert(tags[0] == "api", "env_list first")
  assert(tags[2] == "db", "env_list last")

  let dump = env_dump(["TEST_PORT", "TEST_HOST", "TEST_NONEXIST"])
  assert(contains(dump, "TEST_PORT"), "dump has port")
  assert(contains(dump, "TEST_HOST"), "dump has host")
  assert(not contains(dump, "TEST_NONEXIST"), "dump skips missing")

  print("envx: all passed")
