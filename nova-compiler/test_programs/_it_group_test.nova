import std/itertools/it_group

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckflat(label: string, got, want)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + "_len: got=" + str(gn) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn cknest(label: string, got, want)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + "_outerlen: got=" + str(gn) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        let gr = got[i]
        let wr = want[i]
        let grl = len(gr)
        let wrl = len(wr)
        if grl != wrl
            print("FAIL " + label + "[" + str(i) + "]_len: got=" + str(grl) + " want=" + str(wrl))
            exit(1)
        let j = 0
        while j < wrl
            if gr[j] != wr[j]
                print("FAIL " + label + "[" + str(i) + "][" + str(j) + "]: got=" + str(gr[j]) + " want=" + str(wr[j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // --- itg_group_consecutive ---
    // basic: [1,1,2,3,3,3] -> [[1,1],[2],[3,3,3]]
    let gc1 = itg_group_consecutive([1, 1, 2, 3, 3, 3])
    cknest("group_basic", gc1, [[1, 1], [2], [3, 3, 3]])
    // all same
    let gc2 = itg_group_consecutive([5, 5, 5])
    cknest("group_allsame", gc2, [[5, 5, 5]])
    // all distinct
    let gc3 = itg_group_consecutive([1, 2, 3])
    cknest("group_distinct", gc3, [[1], [2], [3]])
    // single element
    let gc4 = itg_group_consecutive([7])
    cknest("group_single", gc4, [[7]])
    // empty
    cki("group_empty", len(itg_group_consecutive([])), 0)
    // alternating
    let gc5 = itg_group_consecutive([1, 2, 1, 2])
    cknest("group_alternating", gc5, [[1], [2], [1], [2]])

    // --- itg_rle ---
    // basic: [1,1,2,3,3,3] -> [[1,2],[2,1],[3,3]]
    let r1 = itg_rle([1, 1, 2, 3, 3, 3])
    cknest("rle_basic", r1, [[1, 2], [2, 1], [3, 3]])
    // empty
    cki("rle_empty", len(itg_rle([])), 0)
    // single
    let r2 = itg_rle([42])
    cknest("rle_single", r2, [[42, 1]])
    // all same
    let r3 = itg_rle([9, 9, 9, 9])
    cknest("rle_allsame", r3, [[9, 4]])
    // all distinct
    let r4 = itg_rle([1, 2, 3])
    cknest("rle_alldistinct", r4, [[1, 1], [2, 1], [3, 1]])

    // --- itg_rle_decode ---
    // basic: [[1,2],[2,1],[3,3]] -> [1,1,2,3,3,3]
    let d1 = itg_rle_decode([[1, 2], [2, 1], [3, 3]])
    ckflat("rle_decode_basic", d1, [1, 1, 2, 3, 3, 3])
    // empty
    cki("rle_decode_empty", len(itg_rle_decode([])), 0)
    // count=1
    let d2 = itg_rle_decode([[7, 1]])
    ckflat("rle_decode_single", d2, [7])

    // --- itg_run_lengths ---
    // [1,1,2,3,3,3] -> [2,1,3]
    let rl1 = itg_run_lengths([1, 1, 2, 3, 3, 3])
    ckflat("runlen_basic", rl1, [2, 1, 3])
    // empty
    cki("runlen_empty", len(itg_run_lengths([])), 0)
    // all distinct
    let rl2 = itg_run_lengths([4, 5, 6])
    ckflat("runlen_distinct", rl2, [1, 1, 1])
    // all same
    let rl3 = itg_run_lengths([3, 3, 3])
    ckflat("runlen_allsame", rl3, [3])

    // --- ROUND-TRIP: itg_rle_decode(itg_rle(xs)) == xs ---
    let xs_rt = [5, 5, 5, 1, 2, 2]
    let rt = itg_rle_decode(itg_rle(xs_rt))
    ckflat("roundtrip_rle", rt, [5, 5, 5, 1, 2, 2])
    // round-trip on empty
    let rt2 = itg_rle_decode(itg_rle([]))
    cki("roundtrip_empty", len(rt2), 0)
    // round-trip on single
    let rt3 = itg_rle_decode(itg_rle([99]))
    ckflat("roundtrip_single", rt3, [99])

    print("PASS _it_group_test")
