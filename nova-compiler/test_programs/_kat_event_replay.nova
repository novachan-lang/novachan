import forge_event_replay

fn main()
    let er = er_new()
    assert(er_event_count(er) == 0, "empty")

    let d1 = {}
    d1["amount"] = 100
    er = er_append(er, "order-1", "OrderCreated", d1)

    let d2 = {}
    d2["amount"] = 100
    d2["method"] = "card"
    er = er_append(er, "order-1", "OrderPaid", d2)

    let d3 = {}
    d3["amount"] = 50
    er = er_append(er, "order-2", "OrderCreated", d3)

    assert(er_event_count(er) == 3, "3 events")
    assert(er_last_seq(er) == 3, "last seq=3")

    let o1 = er_events_for(er, "order-1")
    assert(len(o1) == 2, "order-1 has 2 events")
    assert(o1[0]["type"] == "OrderCreated", "first=created")
    assert(o1[1]["type"] == "OrderPaid", "second=paid")

    let since = er_events_since(er, 1)
    assert(len(since) == 2, "2 events since seq 1")

    let created = er_events_by_type(er, "OrderCreated")
    assert(len(created) == 2, "2 OrderCreated events")

    let streams = er_stream_names(er)
    assert(len(streams) == 2, "2 streams")

    let snap_state = {}
    snap_state["total_orders"] = 2
    snap_state["revenue"] = 150
    er = er_save_snapshot(er, "totals", snap_state)

    let loaded = er_load_snapshot(er, "totals")
    assert(loaded["at_seq"] == 3, "snapshot at seq 3")
    let ls = loaded["state"]
    assert(ls["total_orders"] == 2, "snap total=2")

    let missing = er_load_snapshot(er, "nope")
    assert(missing["at_seq"] == 0, "missing snapshot")

    er = er_set_projection(er, "order_count", 2)
    assert(er_get_projection(er, "order_count") == 2, "projection=2")
    assert(er_get_projection(er, "missing") == 0, "missing proj=0")

    print("EVENT-REPLAY KAT PASS")
