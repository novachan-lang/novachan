import std/game/elo_kfactor

fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn chk(name: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL elo_kfactor " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // Provisional player (< 30 games): K = 40
    let k1 = kfactor(1500.0, 10)
    chk("provisional", k1, 40.0, 0.001)

    // Exactly at 29 games: still provisional
    let k2 = kfactor(2300.0, 29)
    chk("29_games_provisional", k2, 40.0, 0.001)

    // Established, under 2400: K = 20
    let k3 = kfactor(1800.0, 50)
    chk("established_low", k3, 20.0, 0.001)

    // Established, exactly at 2399: still K = 20
    let k4 = kfactor(2399.0, 100)
    chk("just_under_2400", k4, 20.0, 0.001)

    // High rated (>= 2400): K = 10
    let k5 = kfactor(2500.0, 100)
    chk("high_rated", k5, 10.0, 0.001)

    // Exactly 2400: K = 10
    let k6 = kfactor(2400.0, 200)
    chk("exactly_2400", k6, 10.0, 0.001)

    // Boundary: 30 games, low rating -> K=20
    let k7 = kfactor(1500.0, 30)
    chk("exactly_30_games", k7, 20.0, 0.001)

    print("PASS _elo_kfactor_test")
