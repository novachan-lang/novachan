import std/framing/stxetx

// ── Helpers ──────────────────────────────────────────────────────────────────

fn list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ck_int(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bool(label, got, want)
    let g = 0
    if got
        g = 1
    let w = 0
    if want
        w = 1
    if g != w
        print("FAIL " + label + ": got=" + str(g) + " want=" + str(w))
        exit(1)

fn ck_list(label, got, want)
    if not list_eq(got, want)
        print("FAIL " + label + ": list mismatch (len " + str(len(got)) + " vs " + str(len(want)) + ")")
        exit(1)

fn make3(a, b, c) -> list
    let out = []
    push(out, a)
    push(out, b)
    push(out, c)
    out

fn make5(a, b, c, d, e) -> list
    let out = []
    push(out, a)
    push(out, b)
    push(out, c)
    push(out, d)
    push(out, e)
    out

fn main()
    // ── KAT 1: sx_frame([1,2,3]) == [0x02,1,2,3,0x03] ───────────────────────
    let d123 = make3(1, 2, 3)
    let want_frame = make5(0x02, 1, 2, 3, 0x03)
    let got_frame = sx_frame(d123)
    ck_list("sx_frame_123", got_frame, want_frame)

    // ── KAT 2: sx_lrc([1,2,3]) == 0 (1 XOR 2 XOR 3 = 0) ────────────────────
    ck_int("sx_lrc_123", sx_lrc(d123), 0)

    // ── KAT 3: sx_lrc([0x0F,0x0A]) == 5 ─────────────────────────────────────
    let d0f0a = []
    push(d0f0a, 0x0F)
    push(d0f0a, 0x0A)
    ck_int("sx_lrc_0F0A", sx_lrc(d0f0a), 5)

    // ── KAT 4: sx_dle_stuff([0x02]) == [0x10, 0x02] ──────────────────────────
    let stx_only = []
    push(stx_only, 0x02)
    let want_stuffed_stx = []
    push(want_stuffed_stx, 0x10)
    push(want_stuffed_stx, 0x02)
    ck_list("sx_dle_stuff_stx", sx_dle_stuff(stx_only), want_stuffed_stx)

    // ── KAT 5: sx_dle_stuff([0x10]) == [0x10, 0x10] ──────────────────────────
    let dle_only = []
    push(dle_only, 0x10)
    let want_stuffed_dle = []
    push(want_stuffed_dle, 0x10)
    push(want_stuffed_dle, 0x10)
    ck_list("sx_dle_stuff_dle", sx_dle_stuff(dle_only), want_stuffed_dle)

    // ── KAT 6: ROUND-TRIP sx_deframe(sx_frame([1,2,3])) == [1,2,3] ──────────
    let rt_data = make3(1, 2, 3)
    let rt_frame = sx_frame(rt_data)
    let rt_got = sx_deframe(rt_frame)
    ck_list("sx_roundtrip_basic", rt_got, rt_data)

    // ── KAT 7: DLE round-trip with delimiters in payload ─────────────────────
    // payload = [0x02, 0x03, 0x10, 5]
    let dle_payload = []
    push(dle_payload, 0x02)
    push(dle_payload, 0x03)
    push(dle_payload, 0x10)
    push(dle_payload, 5)
    let dle_frame = sx_frame_dle(dle_payload)
    let dle_result = sx_deframe_dle(dle_frame)
    let dle_data = dle_result["data"]
    ck_list("sx_deframe_dle_data", dle_data, dle_payload)

    // ── KAT 8: LRC round-trip ─────────────────────────────────────────────────
    let lrc_payload = make3(1, 2, 3)
    let lrc_frame = sx_frame_lrc(lrc_payload)
    let lrc_result = sx_deframe_lrc(lrc_frame)
    let lrc_ok = lrc_result["lrc_ok"]
    ck_bool("sx_deframe_lrc_ok", lrc_ok, true)

    // ── KAT 9: sx_is_framed ───────────────────────────────────────────────────
    let framed = sx_frame(make3(9, 8, 7))
    ck_bool("sx_is_framed_true", sx_is_framed(framed), true)
    let not_framed = make3(1, 2, 3)
    ck_bool("sx_is_framed_false", sx_is_framed(not_framed), false)

    // ── KAT 10: empty payload ─────────────────────────────────────────────────
    let empty = []
    let ef = sx_frame(empty)
    let ed = sx_deframe(ef)
    ck_list("sx_roundtrip_empty", ed, empty)

    // ── KAT 11: sx_lrc empty == 0 ────────────────────────────────────────────
    ck_int("sx_lrc_empty", sx_lrc(empty), 0)

    // ── KAT 12: deframe on malformed (no STX) returns empty ──────────────────
    let bad = make3(1, 2, 3)
    let bad_deframe = sx_deframe(bad)
    ck_list("sx_deframe_malformed", bad_deframe, empty)

    // ── KAT 13: sx_dle_stuff on ETX byte ─────────────────────────────────────
    let etx_only = []
    push(etx_only, 0x03)
    let want_etx_stuffed = []
    push(want_etx_stuffed, 0x10)
    push(want_etx_stuffed, 0x03)
    ck_list("sx_dle_stuff_etx", sx_dle_stuff(etx_only), want_etx_stuffed)

    // ── KAT 14: sx_dle_unstuff inverts sx_dle_stuff ───────────────────────────
    let mixed = []
    push(mixed, 0x02)
    push(mixed, 0x10)
    push(mixed, 0x03)
    push(mixed, 42)
    let stuffed = sx_dle_stuff(mixed)
    let unstuffed = sx_dle_unstuff(stuffed)
    ck_list("sx_dle_roundtrip", unstuffed, mixed)

    // ── KAT 15: LRC check fails on corrupted frame ────────────────────────────
    let corrupt = sx_frame_lrc(make3(1, 2, 3))
    let last_idx = len(corrupt) - 1
    corrupt[last_idx] = 0xFF
    let corrupt_result = sx_deframe_lrc(corrupt)
    let corrupt_ok = corrupt_result["lrc_ok"]
    ck_bool("sx_deframe_lrc_bad", corrupt_ok, false)

    print("PASS _stxetx_test")
