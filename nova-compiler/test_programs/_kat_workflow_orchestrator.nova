import forge_workflow_orchestrator

fn main()
    let s = we_new()
    assert(we_workflow_count(s) == 0, "no workflows yet")
    assert(we_instance_count(s) == 0, "no instances yet")

    s = we_define(s, "onboarding")
    s = we_define(s, "onboarding")
    assert(we_workflow_count(s) == 1, "define is idempotent")

    let r1 = we_add_step(s, "onboarding", "verify_email")
    assert(is_ok(r1), "add step 1 ok")
    let r2 = we_add_step(s, "onboarding", "collect_profile")
    assert(is_ok(r2), "add step 2 ok")
    let r3 = we_add_step(s, "onboarding", "send_welcome")
    assert(is_ok(r3), "add step 3 ok")

    let rbad = we_add_step(s, "no-such-workflow", "x")
    assert(is_err(rbad), "add step to unknown workflow fails")

    let rsc = we_step_count(s, "onboarding")
    assert(is_ok(rsc), "step count ok")
    assert(unwrap(rsc) == 3, "3 steps")

    let start1 = we_start(s, "onboarding", "user-1")
    assert(is_ok(start1), "start instance ok")
    assert(we_instance_count(s) == 1, "1 instance")

    let dup_start = we_start(s, "onboarding", "user-1")
    assert(is_err(dup_start), "duplicate instance id rejected")

    let cur1 = we_current_step(s, "user-1")
    assert(is_ok(cur1), "current step ok")
    assert(unwrap(cur1) == "verify_email", "first step is verify_email")

    let done1 = we_is_complete(s, "user-1")
    assert(is_ok(done1), "is_complete ok")
    assert(unwrap(done1) == 0, "not complete yet")

    let adv1 = we_advance(s, "user-1")
    assert(is_ok(adv1), "advance 1 ok")
    let cur2 = we_current_step(s, "user-1")
    assert(unwrap(cur2) == "collect_profile", "second step")

    let adv2 = we_advance(s, "user-1")
    assert(is_ok(adv2), "advance 2 ok")
    let cur3 = we_current_step(s, "user-1")
    assert(unwrap(cur3) == "send_welcome", "third step")

    let adv3 = we_advance(s, "user-1")
    assert(is_ok(adv3), "advance 3 ok")
    let done2 = we_is_complete(s, "user-1")
    assert(unwrap(done2) == 1, "now complete")

    let adv4 = we_advance(s, "user-1")
    assert(is_err(adv4), "advancing a complete instance fails")

    let cur4 = we_current_step(s, "user-1")
    assert(is_err(cur4), "current_step on complete instance fails")

    let unknown = we_advance(s, "no-such-instance")
    assert(is_err(unknown), "advance unknown instance fails")

    let start2 = we_start(s, "onboarding", "user-2")
    assert(is_ok(start2), "second instance starts")
    assert(we_instance_count(s) == 2, "2 instances total")

    print("WORKFLOW-ORCHESTRATOR KAT PASS")
