import std/backtracking/bt_combination_sum

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_str — render int list as "[a,b,...]"
fn list_str(xs)
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// list_eq — true if two int lists are equal
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// results_contains — true if any element of results equals want (as a list)
fn results_contains(results, want) -> bool
    let i = 0
    while i < len(results)
        if list_eq(results[i], want)
            return true
        i = i + 1
    false

// ck_contains — assert that results contains the expected combo
fn ck_contains(label: string, results, want)
    if not results_contains(results, want)
        print("FAIL " + label + ": result set does not contain " + list_str(want))
        exit(1)

// cknest — assert outer length then check each inner list against expected values element-wise
fn cknest(label: string, results, want_len: int)
    if len(results) != want_len
        print("FAIL " + label + "_len: got=" + str(len(results)) + " want=" + str(want_len))
        exit(1)

fn main()
    // --- cs_count basic KATs ---
    // [2,3,6,7] target=7: solutions [2,2,3] and [7] => count=2
    cki("cs_count_2367_7", cs_count([2, 3, 6, 7], 7), 2)

    // [2,3,5] target=8: [2,2,2,2],[2,3,3],[3,5] => count=3
    cki("cs_count_235_8", cs_count([2, 3, 5], 8), 3)

    // [2] target=1: 2 > 1, no solution => count=0
    cki("cs_count_2_1", cs_count([2], 1), 0)

    // target=0: one empty combination => count=1
    cki("cs_count_any_0", cs_count([1], 0), 1)

    // --- cs_solve correctness ---
    // [2,3,6,7] target=7 => exactly 2 combos, contains [7] and [2,2,3]
    let r7 = cs_solve([2, 3, 6, 7], 7)
    cknest("cs_solve_2367_7", r7, 2)
    ck_contains("contains_7", r7, [7])
    ck_contains("contains_223", r7, [2, 2, 3])

    // [2,3,5] target=8 => 3 combos
    let r8 = cs_solve([2, 3, 5], 8)
    cknest("cs_solve_235_8", r8, 3)
    ck_contains("contains_2222", r8, [2, 2, 2, 2])
    ck_contains("contains_233", r8, [2, 3, 3])
    ck_contains("contains_35", r8, [3, 5])

    // empty candidates => 0 combos
    cki("cs_count_empty_5", cs_count([], 5), 0)

    // target=0 => 1 empty combo
    let r0 = cs_solve([2, 3], 0)
    cknest("cs_solve_target0", r0, 1)
    ck_contains("contains_empty", r0, [])

    // negative target => 0 combos
    cki("cs_count_neg", cs_count([1, 2], -1), 0)

    // duplicates in input are collapsed: [2,2,3] same as [2,3] for target=4
    // [2,3] target=4: [2,2] only (4=2+2; 3 alone<4, 3+3=6>4 wait no: 3<4, try 3+3=6>4; 2+2=4 yes; 3+... no)
    // Actually: [2,2]=4 yes, [2,2] only = 1
    cki("cs_count_dedup", cs_count([2, 2, 3], 4), 1)

    // Single candidate [3] target=9 => [3,3,3]
    let r9 = cs_solve([3], 9)
    cknest("cs_solve_3_9", r9, 1)
    ck_contains("contains_333", r9, [3, 3, 3])

    // [1,2] target=3 => [1,1,1],[1,2] => count=2
    cki("cs_count_12_3", cs_count([1, 2], 3), 2)
    let r12 = cs_solve([1, 2], 3)
    cknest("cs_solve_12_3", r12, 2)
    ck_contains("contains_111", r12, [1, 1, 1])
    ck_contains("contains_12", r12, [1, 2])

    print("PASS _bt_combination_sum_test")
