// Bit-manipulation builtins: popcount, clz, ctz, rotl, rotr.
// Round-trips + small known cases avoid writing INT64_MIN as a literal.

fn main()
    // popcount
    assert_eq(popcount(0), 0)
    assert_eq(popcount(1), 1)
    assert_eq(popcount(255), 8)
    assert_eq(popcount(-1), 64)        // all 64 bits set

    // count leading / trailing zeros (0 guarded to 64, never UB)
    assert_eq(clz(0), 64)
    assert_eq(clz(1), 63)
    assert_eq(clz(2), 62)
    assert_eq(ctz(0), 64)
    assert_eq(ctz(1), 0)
    assert_eq(ctz(8), 3)

    // rotates: small known cases
    assert_eq(rotl(1, 1), 2)
    assert_eq(rotl(1, 0), 1)
    assert_eq(rotr(2, 1), 1)
    assert_eq(rotr(1, 0), 1)

    // count masked to 0..63: rotate by 64 == identity (no shift-by-64 UB)
    assert_eq(rotl(12345, 64), 12345)
    assert_eq(rotr(12345, 64), 12345)

    // round-trips (also exercises the sign bit without an INT64_MIN literal)
    assert_eq(rotr(rotl(98765, 13), 13), 98765)
    assert_eq(rotl(rotr(98765, 50), 50), 98765)
    assert_eq(rotr(rotl(1, 63), 63), 1)

    print("bit_ops_test passed")
