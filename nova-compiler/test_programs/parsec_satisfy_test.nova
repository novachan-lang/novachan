// Minimal test for p_satisfy — the suspected crash point

fn p_ok(val, pos: int) -> list
    return [1, val, pos]

fn p_err(msg: string, pos: int) -> list
    return [0, msg, pos]

fn p_is_ok(r: list) -> int
    return r[0] == 1

fn p_val(r: list)
    return r[1]

fn p_pos(r: list) -> int
    return r[2]

fn _is_digit(c: string) -> int
    let o = ord(c)
    return o >= 48 and o <= 57

fn _is_alpha(c: string) -> int
    let o = ord(c)
    return (o >= 65 and o <= 90) or (o >= 97 and o <= 122)

fn p_satisfy(input: string, pos: int, pred, desc: string) -> list
    if pos < len(input)
        let c = input[pos:pos + 1]
        if pred(c)
            return p_ok(c, pos + 1)
    return p_err("expected " + desc, pos)

fn p_digit(input: string, pos: int) -> list
    return p_satisfy(input, pos, _is_digit, "digit")

fn p_alpha(input: string, pos: int) -> list
    return p_satisfy(input, pos, _is_alpha, "letter")

fn main()
    print("testing p_satisfy with _is_digit...")
    let r1 = p_satisfy("3abc", 0, _is_digit, "digit")
    assert(p_is_ok(r1), "satisfy digit ok")
    assert(p_val(r1) == "3", "satisfy digit val")
    print("  digit: ok")

    print("testing p_satisfy with _is_alpha...")
    let r2 = p_satisfy("abc", 0, _is_alpha, "letter")
    assert(p_is_ok(r2), "satisfy alpha ok")
    assert(p_val(r2) == "a", "satisfy alpha val")
    print("  alpha: ok")

    print("testing p_digit wrapper...")
    let r3 = p_digit("5x", 0)
    assert(p_is_ok(r3), "p_digit ok")
    assert(p_val(r3) == "5", "p_digit val")
    print("  p_digit: ok")

    print("testing p_alpha wrapper...")
    let r4 = p_alpha("xy", 0)
    assert(p_is_ok(r4), "p_alpha ok")
    assert(p_val(r4) == "x", "p_alpha val")
    print("  p_alpha: ok")

    // Now test passing p_alpha to another function
    print("testing higher-order: passing p_alpha...")
    let parser = p_alpha
    let r5 = parser("hello", 0)
    assert(p_is_ok(r5), "ho alpha ok")
    print("  higher-order: ok")

    print("parsec_satisfy: all passed")
