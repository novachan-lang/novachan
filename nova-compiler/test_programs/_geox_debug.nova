fn geo_bounding_box(points)
  let min_lat = points[0][0]
  let max_lat = points[0][0]
  let min_lon = points[0][1]
  let max_lon = points[0][1]
  for p in points
    if p[0] < min_lat
      min_lat = p[0]
    if p[0] > max_lat
      max_lat = p[0]
    if p[1] < min_lon
      min_lon = p[1]
    if p[1] > max_lon
      max_lon = p[1]
  [[min_lat, min_lon], [max_lat, max_lon]]

fn main()
  let ny = [40.7128, -74.006]
  let la = [33.9425, -118.408]
  let london = [51.5074, -0.1278]
  let points = [ny, la, london]
  print("ny[0] = " + str(ny[0]))
  print("la[0] = " + str(la[0]))
  print("london[0] = " + str(london[0]))
  let bb = geo_bounding_box(points)
  print("bb = " + str(bb))
  print("bb[0] = " + str(bb[0]))
  print("bb[1] = " + str(bb[1]))
  print("bb[1][0] = " + str(bb[1][0]))
  let v = bb[1][0]
  print("v = " + str(v))
  print("v > 50.0 = " + str(v > 50.0))
  print("done")
