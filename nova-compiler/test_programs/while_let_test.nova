fn main()
    let items = [ok(1), ok(2), ok(3), err("done")]
    let idx = 0
    let total = 0
    while let Ok(v) = items[idx]
        total = total + v
        idx = idx + 1
    assert_eq(total, 6)
    assert_eq(idx, 3)
    print("while-let sum: " + str(total) + " (stopped at idx " + str(idx) + ")")

    let results = [ok("hello"), ok("world"), err("end")]
    let ri = 0
    let words = []
    while let Ok(w) = results[ri]
        push(words, w)
        ri = ri + 1
    assert_eq(words, ["hello", "world"])
    print("while-let words: " + str(words))

    let empty = [err("nope")]
    let ei = 0
    let ran = false
    while let Ok(x) = empty[ei]
        ran = true
        ei = ei + 1
    assert_eq(ran, false)
    print("while-let no-match: body never ran")

    let stream = [ok(10), ok(20), ok(30)]
    let si = 0
    let vals = []
    while si < len(stream)
        if let Ok(n) = stream[si]
            push(vals, n)
        si = si + 1
    assert_eq(vals, [10, 20, 30])
    print("for+if-let all ok: " + str(vals))

    print("ALL WHILE-LET TESTS PASSED")
