import std/util/enumflags

fn cki(label: str, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label: str, got: bool, expected: bool)
    if got != expected
        let gs = "false"
        if got
            gs = "true"
        let es = "false"
        if expected
            es = "true"
        print("FAIL " + label + ": got " + gs + " expected " + es)
        exit(1)

fn main()
    // ef_flag: 1 << bit
    cki("flag(0)", ef_flag(0), 1)
    cki("flag(3)", ef_flag(3), 8)
    cki("flag(1)", ef_flag(1), 2)
    cki("flag(7)", ef_flag(7), 128)

    // ef_has: (mask & flag) != 0
    ckb("has(9,1)", ef_has(9, 1), true)
    ckb("has(9,2)", ef_has(9, 2), false)
    ckb("has(9,8)", ef_has(9, 8), true)
    ckb("has(0,1)", ef_has(0, 1), false)

    // ef_add: mask | flag
    cki("add(1,8)", ef_add(1, 8), 9)
    cki("add(0,7)", ef_add(0, 7), 7)

    // ef_remove: mask & ~flag
    cki("remove(9,1)", ef_remove(9, 1), 8)
    cki("remove(7,2)", ef_remove(7, 2), 5)

    // ef_toggle: mask ^ flag
    cki("toggle(0,4)", ef_toggle(0, 4), 4)
    cki("toggle(4,4)", ef_toggle(4, 4), 0)
    cki("toggle(3,1)", ef_toggle(3, 1), 2)

    // ef_combine: OR of list
    let flags = [1, 2, 4]
    cki("combine([1,2,4])", ef_combine(flags), 7)
    let empty = []
    cki("combine([])", ef_combine(empty), 0)

    // ef_count: popcount
    cki("count(7)", ef_count(7), 3)
    cki("count(11)", ef_count(11), 3)
    cki("count(0)", ef_count(0), 0)
    cki("count(1)", ef_count(1), 1)
    cki("count(255)", ef_count(255), 8)

    print("_enumflags_test passed")
