// functional: model-driven admin — struct-derived columns + UPDATE/edit (Django-signature additions)
import forge_db
import forge_admin

type Product
    id: int
    name: string
    price: int

fn main()
    let cols = admin_cols_of(Product(0, "", 0))
    if str(cols) != str(["id", "name", "price"])
        print("FAIL cols = " + str(cols))
        exit(1)
    let fc = admin_form_cols(cols)
    if str(fc) != str(["name", "price"])
        print("FAIL form_cols = " + str(fc))
        exit(1)
    let pool = pool_open("_admin_model_test.db", 1)
    pool_query(pool, "DROP TABLE IF EXISTS products", [])
    pool_query(pool, "CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, price INTEGER)", [])
    let f1 = {}
    f1["name"] = "widget"
    f1["price"] = "10"
    admin_create(pool, "products", fc, f1)
    let rows = db_all(pool, "products")
    if len(rows) != 1
        print("FAIL create")
        exit(1)
    let id = rows[0]["id"]
    let f2 = {}
    f2["name"] = "gadget"
    f2["price"] = "20"
    admin_update(pool, "products", cols, id, f2)
    let after = db_find(pool, "products", id)
    if after["name"] != "gadget"
        print("FAIL update name = " + str(after["name"]))
        exit(1)
    let ef = admin_render_edit_form("products", cols, after)
    if find(ef, "gadget") < 0
        print("FAIL edit form not prefilled")
        exit(1)
    if find(ef, "/products/" + str(id) + "/update") < 0
        print("FAIL edit action")
        exit(1)
    if find(admin_render_table_ed("products", cols, db_all(pool, "products")), "/edit") < 0
        print("FAIL table edit link")
        exit(1)
    print("PASS forge_admin_model")
