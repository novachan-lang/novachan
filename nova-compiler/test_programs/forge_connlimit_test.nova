// Forge T1.3: the accept-side connection cap. _conn_sem(n) is a channel-semaphore of n permits; the
// live acceptor recv()s a permit before spawning a handler, so at most n connections are in flight. Here
// with cap=2, a 3rd acquirer must PARK until one of the first two releases. Socketless (the cap IS the
// channel-semaphore the acceptor uses) -> deterministic, kill-on-timeout safe.
import forge

// Mirrors forge's internal _conn_sem(n) (a `_`-prefixed module-private helper, so it can't be called
// from here): a channel pre-filled with n permits. This test guards the cap PATTERN the live acceptor
// uses (recv a permit before spawning a handler; the handler sends it back when the connection closes).
fn make_sem(n: int)
    let ch = channel()
    let i = 0
    while i < n
        send(ch, 1)
        i = i + 1
    ch

fn acq(sem, id: int, hold_ms: int, order)
    recv(sem)                  // acquire a permit (parks if all n are in use)
    send(order, id)            // record acquisition ORDER
    sleep(hold_ms)
    send(sem, 1)               // release

fn main()
    let sem = make_sem(2)   // cap = 2 permits (mirrors forge._conn_sem)
    let order = channel()
    // 3 tasks, cap 2: tasks 1+2 acquire immediately; task 3 must PARK until 1 or 2 releases (~120ms).
    spawn fn()
        acq(sem, 1, 120, order)
    sleep(30)
    spawn fn()
        acq(sem, 2, 120, order)
    sleep(30)
    spawn fn()
        acq(sem, 3, 0, order)
    let a = receive(order)
    let b = receive(order)
    let c = receive(order)
    if c != 3
        print("FAIL: 3rd acquirer should be LAST (parked at the cap until a release); got " + str(a) + "," + str(b) + "," + str(c))
        exit(1)
    if (a + b) != 3
        print("FAIL: first two acquirers should be 1 and 2; got " + str(a) + "," + str(b))
        exit(1)
    print("PASS forge_connlimit (cap=2: 3rd connection parks until a permit frees)")
