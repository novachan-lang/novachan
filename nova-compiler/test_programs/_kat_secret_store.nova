import forge_secret_store

fn main()
    let s = ss_new()
    s = ss_put(s, "db_pass", "hunter2")
    s = ss_put(s, "api_key", "sk_live_abc")
    assert(ss_count(s) == 2, "2 secrets")
    assert(ss_has(s, "db_pass") == 1, "has db_pass")

    let r1 = ss_get(s, "db_pass")
    assert(is_ok(r1), "get ok")
    assert(unwrap(r1) == "hunter2", "correct value")
    assert(ss_access_count(s, "db_pass") == 1, "1 access")

    let r2 = ss_get(s, "db_pass")
    assert(is_ok(r2), "get again ok")
    assert(ss_access_count(s, "db_pass") == 2, "2 accesses")
    assert(ss_total_accesses(s) == 2, "2 total")

    let r3 = ss_get(s, "nope")
    assert(is_err(r3), "not found")

    let d = ss_delete(s, "api_key")
    assert(is_ok(d), "delete ok")
    s = unwrap(d)
    assert(ss_has(s, "api_key") == 0, "deleted")
    assert(ss_count(s) == 1, "1 remaining")

    print("SECRET-STORE KAT PASS")
