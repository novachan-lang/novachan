// Probe: async data JS->wasm. host_provide(cb) -> the host (later: fetch().then) writes a string
// into wasm linear memory + calls the NOVA export named cb with the ptr. NOVA renders it to #app.
extern fn dom_get_by_id(id: string) -> int
extern fn dom_set_text(node: int, txt: string)
extern fn host_provide(cb_name: string)

fn on_data(s: string)
    let app = unsafe dom_get_by_id("app")
    unsafe dom_set_text(app, s)

fn main()
    unsafe host_provide("on_data")
