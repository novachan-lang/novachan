import forge_trie_router

fn main()
    let t = tr_new()
    t = tr_add(t, "/api/users", "user_handler")
    t = tr_add(t, "/api/orders", "order_handler")
    t = tr_add(t, "/api", "api_handler")
    assert(tr_route_count(t) == 3, "3 routes")

    let r1 = tr_match(t, "/api/users")
    assert(is_ok(r1), "exact match")
    assert(unwrap(r1) == "user_handler", "correct handler")

    let r2 = tr_match(t, "/api/users/123")
    assert(is_ok(r2), "prefix match")
    assert(unwrap(r2) == "user_handler", "matched users prefix")

    let r3 = tr_match(t, "/nope")
    assert(is_err(r3), "no match")

    assert(tr_match_count(t) == 2, "2 matches")
    assert(tr_miss_count(t) == 1, "1 miss")

    print("TRIE-ROUTER KAT PASS")
