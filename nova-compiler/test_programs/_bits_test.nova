// KAT for std/math/bits — 32-bit bit manipulation.
// All expected values are hand-computed.
import std/math/bits

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let g = "false"
        if got
            g = "true"
        let w = "false"
        if want
            w = "true"
        print("FAIL " + label + ": got " + g + " want " + w)
        exit(1)

fn main()
    // --- b_rotl32 ---
    // rotl32(0x80000000, 1): high bit rotates to bit 0 -> 1
    cki("rotl32(0x80000000,1)", b_rotl32(0x80000000, 1), 1)
    // rotl32(1, 31): bit 0 rotates to bit 31 -> 0x80000000 = 2147483648
    cki("rotl32(1,31)", b_rotl32(1, 31), 2147483648)
    // rotl32(0, n) = 0
    cki("rotl32(0,5)", b_rotl32(0, 5), 0)
    // rotl32(x, 0) = x
    cki("rotl32(0xFF,0)", b_rotl32(0xFF, 0), 255)
    // rotl32(0x12345678, 8) = 0x34567812
    cki("rotl32(0x12345678,8)", b_rotl32(0x12345678, 8), 0x34567812)

    // --- b_rotr32 ---
    // rotr32(1, 1): bit 0 rotates to bit 31 -> 0x80000000 = 2147483648
    cki("rotr32(1,1)", b_rotr32(1, 1), 2147483648)
    // rotr32(0x80000000, 1): bit 31 rotates right to bit 30 -> 0x40000000 = 1073741824
    cki("rotr32(0x80000000,1)", b_rotr32(0x80000000, 1), 1073741824)
    // rotr32(x, 0) = x
    cki("rotr32(0xFF,0)", b_rotr32(0xFF, 0), 255)
    // rotr32(0x12345678, 8) = 0x78123456
    cki("rotr32(0x12345678,8)", b_rotr32(0x12345678, 8), 0x78123456)

    // --- b_reverse_bits32 ---
    // reverse_bits32(1) = 0x80000000 = 2147483648
    cki("reverse_bits32(1)", b_reverse_bits32(1), 2147483648)
    // reverse_bits32(0x80000000) = 1
    cki("reverse_bits32(0x80000000)", b_reverse_bits32(0x80000000), 1)
    // reverse_bits32(0) = 0
    cki("reverse_bits32(0)", b_reverse_bits32(0), 0)
    // reverse_bits32(0xFFFFFFFF) = 0xFFFFFFFF = 4294967295
    cki("reverse_bits32(0xFFFFFFFF)", b_reverse_bits32(0xFFFFFFFF), 4294967295)
    // reverse_bits32(0xF0F0F0F0) = 0x0F0F0F0F = 252645135
    cki("reverse_bits32(0xF0F0F0F0)", b_reverse_bits32(0xF0F0F0F0), 0x0F0F0F0F)

    // --- b_next_pow2 ---
    cki("next_pow2(1)", b_next_pow2(1), 1)
    cki("next_pow2(2)", b_next_pow2(2), 2)
    cki("next_pow2(16)", b_next_pow2(16), 16)
    cki("next_pow2(17)", b_next_pow2(17), 32)
    cki("next_pow2(33)", b_next_pow2(33), 64)
    cki("next_pow2(100)", b_next_pow2(100), 128)
    cki("next_pow2(1024)", b_next_pow2(1024), 1024)
    cki("next_pow2(1025)", b_next_pow2(1025), 2048)

    // --- b_is_pow2 ---
    ckb("is_pow2(1)", b_is_pow2(1), true)
    ckb("is_pow2(2)", b_is_pow2(2), true)
    ckb("is_pow2(64)", b_is_pow2(64), true)
    ckb("is_pow2(63)", b_is_pow2(63), false)
    ckb("is_pow2(0)", b_is_pow2(0), false)
    ckb("is_pow2(1024)", b_is_pow2(1024), true)
    ckb("is_pow2(1023)", b_is_pow2(1023), false)

    // --- b_set_bit ---
    cki("set_bit(0,3)", b_set_bit(0, 3), 8)
    cki("set_bit(0,0)", b_set_bit(0, 0), 1)
    cki("set_bit(8,3)", b_set_bit(8, 3), 8)
    cki("set_bit(0,31)", b_set_bit(0, 31), 2147483648)

    // --- b_test_bit ---
    ckb("test_bit(8,3)", b_test_bit(8, 3), true)
    ckb("test_bit(8,0)", b_test_bit(8, 0), false)
    ckb("test_bit(0xFF,7)", b_test_bit(0xFF, 7), true)
    ckb("test_bit(0xFF,8)", b_test_bit(0xFF, 8), false)

    // --- b_clear_bit ---
    // clear_bit(15,1): 15=0b1111, clear bit1 -> 0b1101=13
    cki("clear_bit(15,1)", b_clear_bit(15, 1), 13)
    // clear_bit(0xFF,0): 0xFF=255, clear bit0 -> 254
    cki("clear_bit(0xFF,0)", b_clear_bit(0xFF, 0), 254)
    // clear_bit(0,3) = 0
    cki("clear_bit(0,3)", b_clear_bit(0, 3), 0)

    // --- b_toggle_bit ---
    // toggle_bit(0,0) = 1
    cki("toggle_bit(0,0)", b_toggle_bit(0, 0), 1)
    // toggle_bit(1,0) = 0
    cki("toggle_bit(1,0)", b_toggle_bit(1, 0), 0)
    // toggle_bit(0b1010,1) = 0b1000 = 8
    cki("toggle_bit(10,1)", b_toggle_bit(10, 1), 8)
    // toggle_bit(0b1010,3) = 0b0010 = 2
    cki("toggle_bit(10,3)", b_toggle_bit(10, 3), 2)

    // --- b_lowest_set_bit ---
    // lowest_set_bit(12) = 4 (12 = 0b1100, lowest bit is bit 2 = 4)
    cki("lowest_set_bit(12)", b_lowest_set_bit(12), 4)
    // lowest_set_bit(1) = 1
    cki("lowest_set_bit(1)", b_lowest_set_bit(1), 1)
    // lowest_set_bit(0) = 0
    cki("lowest_set_bit(0)", b_lowest_set_bit(0), 0)
    // lowest_set_bit(0x80000000) = 2147483648
    cki("lowest_set_bit(0x80000000)", b_lowest_set_bit(0x80000000), 2147483648)
    // lowest_set_bit(6) = 2 (6 = 0b110)
    cki("lowest_set_bit(6)", b_lowest_set_bit(6), 2)

    print("_bits_test passed")
