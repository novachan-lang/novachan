// _narayana_test.nova — KAT for std/math/narayana.nova
import std/math/narayana

// KAT 1: N(1,1) = 1
let v1 = nr_narayana(1, 1)
if v1 != 1
    print("FAIL nr_narayana(1,1): expected 1 got " + str(v1))
    exit(1)

// KAT 2: N(4,1) = 1
let v2 = nr_narayana(4, 1)
if v2 != 1
    print("FAIL nr_narayana(4,1): expected 1 got " + str(v2))
    exit(1)

// KAT 3: N(4,2) = 6
let v3 = nr_narayana(4, 2)
if v3 != 6
    print("FAIL nr_narayana(4,2): expected 6 got " + str(v3))
    exit(1)

// KAT 4: N(4,3) = 6
let v4 = nr_narayana(4, 3)
if v4 != 6
    print("FAIL nr_narayana(4,3): expected 6 got " + str(v4))
    exit(1)

// KAT 5: N(4,4) = 1
let v5 = nr_narayana(4, 4)
if v5 != 1
    print("FAIL nr_narayana(4,4): expected 1 got " + str(v5))
    exit(1)

// KAT 6: N(5,2) = 10
let v6 = nr_narayana(5, 2)
if v6 != 10
    print("FAIL nr_narayana(5,2): expected 10 got " + str(v6))
    exit(1)

// KAT 7: nr_row(4) = [1,6,6,1]
let row4 = nr_row(4)
let row4_ok = 1
if len(row4) != 4
    row4_ok = 0
if row4_ok == 1
    if row4[0] != 1
        row4_ok = 0
if row4_ok == 1
    if row4[1] != 6
        row4_ok = 0
if row4_ok == 1
    if row4[2] != 6
        row4_ok = 0
if row4_ok == 1
    if row4[3] != 1
        row4_ok = 0
if row4_ok != 1
    print("FAIL nr_row(4): expected [1,6,6,1] got len=" + str(len(row4)))
    exit(1)

// KAT 8: nr_row_sum(4) = 14 (Catalan(4))
let s4 = nr_row_sum(4)
if s4 != 14
    print("FAIL nr_row_sum(4): expected 14 got " + str(s4))
    exit(1)

// KAT 9: nr_row_sum(5) = 42 (Catalan(5))
let s5 = nr_row_sum(5)
if s5 != 42
    print("FAIL nr_row_sum(5): expected 42 got " + str(s5))
    exit(1)

print("_narayana_test passed")
