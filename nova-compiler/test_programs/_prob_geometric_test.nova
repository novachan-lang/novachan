import std/probability/prob_geometric

// ckr — check fraction [num,den] matches expected wn/wd.
fn ckr(label: string, got, wn: int, wd: int)
    if got[0] != wn or got[1] != wd
        print("FAIL prob_geometric " + label + ": got=[" + str(got[0]) + "," + str(got[1]) + "] want=[" + str(wn) + "," + str(wd) + "]")
        exit(1)

// cki — check integer equality.
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL prob_geometric " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // pg_pmf(1, 1, 2) = (1-1/2)^0 * (1/2) = 1 * 1/2 = [1,2]
    let r1 = pg_pmf(1, 1, 2)
    ckr("pg_pmf(1,1,2)", r1, 1, 2)

    // pg_pmf(3, 1, 2) = (1/2)^2 * (1/2) = 1/8 = [1,8]
    let r2 = pg_pmf(3, 1, 2)
    ckr("pg_pmf(3,1,2)", r2, 1, 8)

    // pg_pmf(2, 1, 3) = (2/3)^1 * (1/3) = 2/9 = [2,9]
    let r3 = pg_pmf(2, 1, 3)
    ckr("pg_pmf(2,1,3)", r3, 2, 9)

    // pg_cdf(2, 1, 2) = 1 - (1/2)^2 = 1 - 1/4 = 3/4 = [3,4]
    let r4 = pg_cdf(2, 1, 2)
    ckr("pg_cdf(2,1,2)", r4, 3, 4)

    // pg_mean(1, 3) = 1/(1/3) = 3 = [3,1]
    let r5 = pg_mean(1, 3)
    ckr("pg_mean(1,3)", r5, 3, 1)

    // pg_cdf(1, 1, 2) = 1 - (1/2)^1 = 1/2 = [1,2]
    let r6 = pg_cdf(1, 1, 2)
    ckr("pg_cdf(1,1,2)", r6, 1, 2)

    // Edge: pg_pmf(0, 1, 2) = [0,1] (k<1)
    let r7 = pg_pmf(0, 1, 2)
    ckr("pg_pmf(0,1,2)=edge_k0", r7, 0, 1)

    // Edge: pg_mean(1, 1) = 1/1 = [1,1]
    let r8 = pg_mean(1, 1)
    ckr("pg_mean(1,1)", r8, 1, 1)

    // pg_pmf(4, 1, 4) = (3/4)^3 * (1/4) = 27/256 = [27,256]
    let r9 = pg_pmf(4, 1, 4)
    ckr("pg_pmf(4,1,4)", r9, 27, 256)

    // pg_cdf(3, 1, 3) = 1 - (2/3)^3 = 1 - 8/27 = 19/27 = [19,27]
    let r10 = pg_cdf(3, 1, 3)
    ckr("pg_cdf(3,1,3)", r10, 19, 27)

    print("PASS _prob_geometric_test")
