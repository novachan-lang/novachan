type V3
    x: float
    y: float
    z: float

fn dot(a, b)
    a.x * b.x + a.y * b.y + a.z * b.z

fn main()
    let n = 30000000
    let acc = 0.0
    let i = 0
    let t = 0.0
    while i < n
        let a = V3 { x: t, y: t + 1.0, z: t + 2.0 }
        let b = V3 { x: 0.5, y: 0.25, z: 0.125 }
        acc = acc + dot(a, b)
        t = t + 1.0
        i = i + 1
    print(str(acc))
