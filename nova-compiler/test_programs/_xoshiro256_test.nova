// KAT test for std/random/xoshiro256 (xoshiro256**)
//
// Reference values computed via Python reference implementation matching
// the canonical xoshiro256** algorithm by Blackman & Vigna (prng.di.unimi.it).
//
// Seeding uses SplitMix64: rng["s0"] after xo256_seed(0) equals the first
// SplitMix64 output = 0xE220A8397B1DCDAF = -2152535657050944081 (signed i64).
//
// seed=0 first 3 outputs (signed i64):
//   step 0: -7355399402456485196  (0x99ec5f36cb75f2b4)
//   step 1: -4652746763540216534  (0xbf6e1f784956452a)
//   step 2:  1900383378846508768  (0x1a5f849d4933e6e0)
//
// KAT1:  Anchor -- seeding: rng["s0"] after xo256_seed(0) == sm64 first output
// KAT2:  Anchor -- first output of xo256_seed(0) matches reference
// KAT3:  Determinism -- two xo256_seed(0) generators produce identical first 8 outputs
// KAT4:  Anchor -- second and third outputs match reference
// KAT5:  Non-zero output after non-zero seed
// KAT6:  xo256_next_range stays in [0, n)
// KAT7:  Different seeds produce different outputs

import std/random/xoshiro256

fn main()
    // ── KAT1: seeding anchor -- s0 == splitmix64(seed=0) first output ─────────
    // SplitMix64 first output from seed=0 = 0xE220A8397B1DCDAF
    // As signed i64: -2152535657050944081
    // Built from 32-bit halves: (0xE220A839 << 32) | 0x7B1DCDAF
    let want_s0 = (0xE220A839 << 32) | 0x7B1DCDAF
    let rng_s0 = xo256_seed(0)
    let got_s0 = rng_s0["s0"]
    if got_s0 != want_s0
        print("FAIL xoshiro256 KAT1 seed-state s0: got " + str(got_s0) + " want " + str(want_s0))
        exit(1)

    // ── KAT2: first output anchor, seed=0 ────────────────────────────────────
    // Reference: 0x99EC5F36CB75F2B4 = -7355399402456485196 signed i64
    // Built as: (0x99EC5F36 << 32) | 0xCB75F2B4
    let want2 = (0x99EC5F36 << 32) | 0xCB75F2B4
    let rng2 = xo256_seed(0)
    let got2 = xo256_next(rng2)
    if got2 != want2
        print("FAIL xoshiro256 KAT2 first-output seed=0: got " + str(got2) + " want " + str(want2))
        exit(1)

    // ── KAT3: determinism -- two generators seeded identically must agree ─────
    let ra = xo256_seed(0)
    let rb = xo256_seed(0)
    let a0 = xo256_next(ra)
    let a1 = xo256_next(ra)
    let a2 = xo256_next(ra)
    let a3 = xo256_next(ra)
    let a4 = xo256_next(ra)
    let a5 = xo256_next(ra)
    let a6 = xo256_next(ra)
    let a7 = xo256_next(ra)
    let b0 = xo256_next(rb)
    let b1 = xo256_next(rb)
    let b2 = xo256_next(rb)
    let b3 = xo256_next(rb)
    let b4 = xo256_next(rb)
    let b5 = xo256_next(rb)
    let b6 = xo256_next(rb)
    let b7 = xo256_next(rb)
    if a0 != b0
        print("FAIL xoshiro256 KAT3 determinism step0: " + str(a0) + " vs " + str(b0))
        exit(1)
    if a1 != b1
        print("FAIL xoshiro256 KAT3 determinism step1: " + str(a1) + " vs " + str(b1))
        exit(1)
    if a2 != b2
        print("FAIL xoshiro256 KAT3 determinism step2: " + str(a2) + " vs " + str(b2))
        exit(1)
    if a3 != b3
        print("FAIL xoshiro256 KAT3 determinism step3: " + str(a3) + " vs " + str(b3))
        exit(1)
    if a4 != b4
        print("FAIL xoshiro256 KAT3 determinism step4: " + str(a4) + " vs " + str(b4))
        exit(1)
    if a5 != b5
        print("FAIL xoshiro256 KAT3 determinism step5: " + str(a5) + " vs " + str(b5))
        exit(1)
    if a6 != b6
        print("FAIL xoshiro256 KAT3 determinism step6: " + str(a6) + " vs " + str(b6))
        exit(1)
    if a7 != b7
        print("FAIL xoshiro256 KAT3 determinism step7: " + str(a7) + " vs " + str(b7))
        exit(1)

    // ── KAT4: anchor steps 1 and 2 from seed=0 ───────────────────────────────
    // a1 = step 1: 0xBF6E1F784956452A = -4652746763540216534 signed
    // a2 = step 2: 0x1A5F849D4933E6E0 =  1900383378846508768 signed
    let want_a1 = (0xBF6E1F78 << 32) | 0x4956452A
    let want_a2 = (0x1A5F849D << 32) | 0x4933E6E0
    if a1 != want_a1
        print("FAIL xoshiro256 KAT4 anchor step1: got " + str(a1) + " want " + str(want_a1))
        exit(1)
    if a2 != want_a2
        print("FAIL xoshiro256 KAT4 anchor step2: got " + str(a2) + " want " + str(want_a2))
        exit(1)

    // ── KAT5: non-zero output after non-zero seed ─────────────────────────────
    // seed=1 step 0: 0xB3F2AF6D0FC710C5 = -5480124913605472059 signed
    // Verifies that a non-trivial seed produces a non-trivial first output.
    let want5 = (0xB3F2AF6D << 32) | 0x0FC710C5
    let rng5 = xo256_seed(1)
    let got5 = xo256_next(rng5)
    if got5 != want5
        print("FAIL xoshiro256 KAT5 seed=1 first output: got " + str(got5) + " want " + str(want5))
        exit(1)

    // ── KAT6: xo256_next_range stays in [0, n) ───────────────────────────────
    let rng6 = xo256_seed(42)
    let j = 0
    while j < 200
        let rv = xo256_next_range(rng6, 37)
        if rv < 0
            print("FAIL xoshiro256 KAT6 range < 0 at step " + str(j))
            exit(1)
        if rv >= 37
            print("FAIL xoshiro256 KAT6 range >= 37 at step " + str(j) + ": " + str(rv))
            exit(1)
        j = j + 1

    // ── KAT7: different seeds produce different first outputs ─────────────────
    let rng7a = xo256_seed(0)
    let rng7b = xo256_seed(999)
    let v7a = xo256_next(rng7a)
    let v7b = xo256_next(rng7b)
    if v7a == v7b
        print("FAIL xoshiro256 KAT7 seed=0 and seed=999 produced the same first output: " + str(v7a))
        exit(1)

    print("PASS _xoshiro256_test")
