import forge_metric_alert

fn main()
    let m = ma_new()
    assert(ma_metric_count(m) == 0, "starts with 0 metrics")
    assert(ma_total_alerts(m) == 0, "0 alerts")
    assert(ma_total_records(m) == 0, "0 records")

    m = ma_add_metric(m, "cpu")
    m = ma_add_metric(m, "latency_ms")
    assert(ma_metric_count(m) == 2, "2 metrics registered")

    let rt1 = ma_set_threshold(m, "cpu", "gt", 90)
    assert(is_ok(rt1), "set threshold ok")

    let rtbad = ma_set_threshold(m, "cpu", "weird", 90)
    assert(is_err(rtbad), "invalid op rejected")

    let rtmiss = ma_set_threshold(m, "ghost", "gt", 1)
    assert(is_err(rtmiss), "threshold on unknown metric rejected")

    let rlv0 = ma_latest_value(m, "cpu")
    assert(is_err(rlv0), "no value recorded yet")

    let ria0 = ma_is_alerting(m, "cpu")
    assert(is_ok(ria0), "is_alerting ok even before recording")
    assert(unwrap(ria0) == 0, "not alerting before any record")

    let rr1 = ma_record(m, "cpu", 50)
    assert(is_ok(rr1), "record ok")
    assert(ma_total_records(m) == 1, "1 record")

    let rac1 = ma_alert_count(m, "cpu")
    assert(unwrap(rac1) == 0, "no alert yet (50 < 90)")

    let rr2 = ma_record(m, "cpu", 95)
    assert(is_ok(rr2), "record ok 2")
    let rac2 = ma_alert_count(m, "cpu")
    assert(unwrap(rac2) == 1, "1 alert (95 > 90)")
    assert(ma_total_alerts(m) == 1, "1 total alert")

    let ria1 = ma_is_alerting(m, "cpu")
    assert(unwrap(ria1) == 1, "currently alerting")

    let rr3 = ma_record(m, "cpu", 20)
    assert(is_ok(rr3), "record ok 3")
    let ria2 = ma_is_alerting(m, "cpu")
    assert(unwrap(ria2) == 0, "no longer alerting after drop")
    let rac3 = ma_alert_count(m, "cpu")
    assert(unwrap(rac3) == 1, "still just 1 alert total for cpu")

    // latency_ms has no threshold set -> never alerts, but still records
    let rr4 = ma_record(m, "latency_ms", 5000)
    assert(is_ok(rr4), "record ok 4")
    let ria3 = ma_is_alerting(m, "latency_ms")
    assert(unwrap(ria3) == 0, "no threshold -> not alerting")

    let rlv = ma_latest_value(m, "latency_ms")
    assert(is_ok(rlv), "latest value ok")
    assert(unwrap(rlv) == 5000, "latest value 5000")

    let rrmiss = ma_record(m, "ghost", 1)
    assert(is_err(rrmiss), "record on unknown metric errs")

    let racmiss = ma_alert_count(m, "ghost")
    assert(is_err(racmiss), "alert_count on unknown metric errs")

    assert(ma_total_records(m) == 4, "4 total records")
    assert(ma_total_alerts(m) == 1, "1 total alert across all metrics")

    print("METRIC-ALERT KAT PASS")
