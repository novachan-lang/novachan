// KAT test for std/tree/tree_isomorphism.
import std/tree/tree_isomorphism

fn cki(name, got, want)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn ckb(name, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + name + ": got " + str(gi) + " want " + str(wi))
        exit(1)
    print("ok " + name)

fn cks(name, got, want)
    if got != want
        print("FAIL " + name + ": got [" + got + "] want [" + want + "]")
        exit(1)
    print("ok " + name)

fn main()
    // KAT 1: path4 vs star4 -> NOT isomorphic
    // path4: adj=[[1],[0,2],[1,3],[2]], n=4
    let ap = []
    let rp0 = []
    rp0.push(1)
    ap.push(rp0)
    let rp1 = []
    rp1.push(0)
    rp1.push(2)
    ap.push(rp1)
    let rp2 = []
    rp2.push(1)
    rp2.push(3)
    ap.push(rp2)
    let rp3 = []
    rp3.push(2)
    ap.push(rp3)
    // star4: adj=[[1,2,3],[0],[0],[0]], n=4
    let as1 = []
    let rs0 = []
    rs0.push(1)
    rs0.push(2)
    rs0.push(3)
    as1.push(rs0)
    let rs1 = []
    rs1.push(0)
    as1.push(rs1)
    let rs2 = []
    rs2.push(0)
    as1.push(rs2)
    let rs3 = []
    rs3.push(0)
    as1.push(rs3)
    ckb("path4 vs star4 not iso", ti_are_isomorphic(ap, 4, as1, 4), false)

    // KAT 2: two relabeled paths of 4 -> IS isomorphic
    // path4a: 0-1-2-3 adj=[[1],[0,2],[1,3],[2]]  (same as ap above)
    // path4b relabeled: 3-2-1-0, i.e. adj=[[3],[2],[1,3],[0,2]] but as given:
    // adj=[[3],[2],[1,3],[0,2]], n=4
    let ap2 = []
    let r2a = []
    r2a.push(3)
    ap2.push(r2a)
    let r2b = []
    r2b.push(2)
    ap2.push(r2b)
    let r2c = []
    r2c.push(1)
    r2c.push(3)
    ap2.push(r2c)
    let r2d = []
    r2d.push(0)
    r2d.push(2)
    ap2.push(r2d)
    ckb("path4 vs path4-relabeled iso", ti_are_isomorphic(ap, 4, ap2, 4), true)

    // KAT 3: single node vs single node -> iso
    let a1a = []
    let n1 = []
    a1a.push(n1)
    let a1b = []
    let n2 = []
    a1b.push(n2)
    ckb("single vs single iso", ti_are_isomorphic(a1a, 1, a1b, 1), true)

    // KAT 4: determinism — ti_canonical same tree twice gives same string
    let can1 = ti_canonical(ap, 4)
    let can2 = ti_canonical(ap, 4)
    cks("path4 canonical deterministic", can1, can2)

    // KAT 5: different sizes -> not iso
    let a2node = []
    let d2a = []
    d2a.push(1)
    a2node.push(d2a)
    let d2b = []
    d2b.push(0)
    a2node.push(d2b)
    ckb("path2 vs path4 not iso", ti_are_isomorphic(a2node, 2, ap, 4), false)

    // KAT 6: path2 canonical is same as another path2 (two-node tree)
    let a2c = []
    let e2a = []
    e2a.push(1)
    a2c.push(e2a)
    let e2b = []
    e2b.push(0)
    a2c.push(e2b)
    ckb("path2 vs path2 iso", ti_are_isomorphic(a2node, 2, a2c, 2), true)

    // KAT 7: path4 canonical vs star4 canonical must differ
    let can_path = ti_canonical(ap, 4)
    let can_star = ti_canonical(as1, 4)
    ckb("path4 canon != star4 canon", can_path != can_star, true)

    print("PASS _tree_isomorphism_test")
