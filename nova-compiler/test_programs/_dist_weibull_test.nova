// KAT test for std/numeric/dist_weibull — Weibull distribution.
//
// Known answers:
//   weibull with shape=1 is Exponential: CDF = 1 - exp(-x/lam)
//   weibull_cdf(1.0, 1.0, 1.0) = 1 - exp(-1) ~= 0.6321
//   weibull_pdf(x,...) = 0.0 for x < 0
//   weibull_cdf(lam, k, lam) = 1 - 1/e ~= 0.6321 for ANY shape k
//   weibull_cdf(1.0, 2.0, 1.0) = 1 - exp(-1) ~= 0.6321 (since lam=scale=1)
//   For shape=2, scale=1: mean = gamma(1.5) ~= 0.8862 (sqrt(pi)/2)
import std/numeric/dist_weibull

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ck(label: string, got: float, want: float, tol: float)
    let ok = approx(got, want, tol)
    if ok == 0
        print("FAIL dist_weibull " + label + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + label)

fn main()
    // shape=1 is Exponential: CDF(x=1, lam=1) = 1-exp(-1) ~= 0.6321
    let c1 = weibull_cdf(1.0, 1.0, 1.0)
    ck("weibull_cdf(1,1,1)=0.6321", c1, 0.6321, 0.001)

    // weibull_pdf(x,...) = 0.0 for x < 0
    let pneg = weibull_pdf(0.0 - 1.0, 2.0, 1.0)
    ck("weibull_pdf(-1,2,1)=0.0", pneg, 0.0, 0.0001)

    // weibull_cdf(lam, k, lam) = 1-1/e for any shape
    // shape=2, scale=1: CDF(1.0, 2, 1) = 1 - exp(-1^2) = 1 - exp(-1) ~= 0.6321
    let c2 = weibull_cdf(1.0, 2.0, 1.0)
    ck("weibull_cdf(1,2,1)=0.6321", c2, 0.6321, 0.001)

    // shape=3, scale=1: CDF(1.0, 3, 1) = 1-exp(-1) ~= 0.6321
    let c3 = weibull_cdf(1.0, 3.0, 1.0)
    ck("weibull_cdf(1,3,1)=0.6321", c3, 0.6321, 0.001)

    // weibull_cdf(0.0, ...) = 0.0
    let c0 = weibull_cdf(0.0, 2.0, 1.0)
    ck("weibull_cdf(0,2,1)=0.0", c0, 0.0, 0.0001)

    // weibull_mean(1.0, 2.0) = 2.0 * Gamma(2) = 2.0 * 1 = 2.0
    let m1 = weibull_mean(1.0, 2.0)
    ck("weibull_mean(1,2)=2.0", m1, 2.0, 0.001)

    // weibull_mean(2.0, 1.0) = Gamma(1.5) = sqrt(pi)/2 ~= 0.8862
    let m2 = weibull_mean(2.0, 1.0)
    ck("weibull_mean(2,1)=0.8862", m2, 0.8862, 0.001)

    // weibull_pdf positive for x>0
    let p1 = weibull_pdf(1.0, 1.0, 1.0)
    // shape=1: pdf = (1/1)*(1/1)^0 * exp(-1) = exp(-1) ~= 0.3679
    ck("weibull_pdf(1,1,1)=0.3679", p1, 0.3679, 0.001)

    print("PASS _dist_weibull_test")
