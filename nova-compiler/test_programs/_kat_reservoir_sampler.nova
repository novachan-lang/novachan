import forge_reservoir_sampler

fn main()
    let r = rs_new(3)
    r = rs_add(r, "a")
    r = rs_add(r, "b")
    r = rs_add(r, "c")
    assert(rs_count(r) == 3, "3 samples")
    assert(rs_is_full(r) == 1, "full")

    let s0 = rs_get(r, 0)
    assert(is_ok(s0), "get 0 ok")

    let bad = rs_get(r, 99)
    assert(is_err(bad), "out of range")

    r = rs_add(r, "d")
    r = rs_add(r, "e")
    assert(rs_total_seen(r) == 5, "5 seen")
    assert(rs_count(r) == 3, "still 3 samples")

    print("RESERVOIR-SAMPLER KAT PASS")
