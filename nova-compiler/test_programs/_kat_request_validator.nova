import forge_request_validator

fn main()
    let rv = rv_new()
    rv = rv_require_field(rv, "name")
    rv = rv_require_field(rv, "email")
    rv = rv_require_type(rv, "age", "int")
    rv = rv_min_length(rv, "name", 2)
    rv = rv_max_length(rv, "name", 50)
    assert(rv_rule_count(rv) == 5, "5 rules")

    let b1 = {}
    b1["name"] = "Alice"
    b1["email"] = "alice@example.com"
    b1["age"] = 30
    let v1 = rv_validate(rv, b1)
    assert(v1["valid"] == 1, "valid request")
    assert(len(v1["errors"]) == 0, "no errors")

    let b2 = {}
    b2["name"] = "Alice"
    let v2 = rv_validate(rv, b2)
    assert(v2["valid"] == 0, "missing email")
    assert(len(v2["errors"]) >= 1, "has errors")

    let b3 = {}
    b3["name"] = "A"
    b3["email"] = "a@b.com"
    b3["age"] = 25
    let v3 = rv_validate(rv, b3)
    assert(v3["valid"] == 0, "name too short")

    let b4 = {}
    let v4 = rv_validate(rv, b4)
    assert(v4["valid"] == 0, "all missing")
    assert(len(v4["errors"]) == 2, "2 missing fields")

    print("REQUEST-VALIDATOR KAT PASS")
