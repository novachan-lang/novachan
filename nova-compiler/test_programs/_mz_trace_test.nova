fn _mz_rng(state)
    return (state * 1103515245 + 12345) & 0x7FFFFFFF

fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, ns % n]

fn main()
    // Trace first 40 steps of Aldous-Broder on 3x3 seed=7
    let visited = [1, 0, 0, 0, 0, 0, 0, 0, 0]
    let rng = 7
    let cur = 0
    let visit_count = 1
    let step = 0
    let w = 3
    let total = 9
    while step < 40
        let nb = []
        if cur >= w
            push(nb, cur - w)
        if cur + w < total
            push(nb, cur + w)
        if cur % w > 0
            push(nb, cur - 1)
        if cur % w < w - 1
            push(nb, cur + 1)
        let nb_len = len(nb)
        let rr = _mz_randint(rng, nb_len)
        rng = rr[0]
        let idx = rr[1]
        let next = nb[idx]
        let carved = 0
        if visited[next] == 0
            visited[next] = 1
            visit_count = visit_count + 1
            carved = 1
        print("s=" + str(step) + " c=" + str(cur) + " nbs=" + str(nb_len) + " idx=" + str(idx) + " nxt=" + str(next) + " cv=" + str(carved) + " vc=" + str(visit_count))
        cur = next
        step = step + 1
