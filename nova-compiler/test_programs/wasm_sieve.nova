// A real NOVA algorithm in wasm: Sieve of Eratosthenes over primes <= 1000.
// n is large enough that clang cannot unroll/const-fold the marking loops, so the
// sieve GENUINELY computes in wasm (168 primes), exercising the linear-memory list
// runtime + ~7 array growths (cap 8 -> 1024). Prints each prime.
fn main()
    let n = 1000
    let sieve = []
    let i = 0
    while i <= n
        push(sieve, 1)
        i = i + 1
    let p = 2
    while p * p <= n
        if sieve[p] == 1
            let m = p * p
            while m <= n
                sieve[m] = 0
                m = m + p
        p = p + 1
    let q = 2
    while q <= n
        if sieve[q] == 1
            print(str(q))
        q = q + 1
