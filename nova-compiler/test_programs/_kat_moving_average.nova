import forge_moving_average

fn main()
    let m = sma_new(3)
    m = sma_add(m, 10)
    m = sma_add(m, 20)
    m = sma_add(m, 30)
    assert(sma_count(m) == 3, "count 3")
    assert(sma_is_full(m) == 1, "full")
    assert(sma_sum(m) == 60, "sum 60")

    let avg = sma_average(m)
    assert(is_ok(avg), "avg ok")
    assert(unwrap(avg) == 20, "avg=20")

    m = sma_add(m, 40)
    assert(sma_count(m) == 3, "still 3")
    assert(sma_sum(m) == 90, "sum=90 after slide")

    let avg2 = sma_average(m)
    assert(unwrap(avg2) == 30, "avg=30 after slide")

    let empty = sma_new(5)
    assert(is_err(sma_average(empty)), "empty avg err")
    assert(sma_is_full(empty) == 0, "not full")

    print("MOVING-AVERAGE KAT PASS")
