fn sum_loop(n: int) -> int
    let total = 0
    let i = 0
    while i < n
        total = total + i
        i = i + 1
    return total

fn count_primes(limit: int) -> int
    let count = 0
    let n = 2
    while n < limit
        let is_prime = 1
        let d = 2
        while d * d <= n
            if n % d == 0
                is_prime = 0
            d = d + 1
        if is_prime == 1
            count = count + 1
        n = n + 1
    return count

fn run_bench()
    let t0 = clock_ns()
    let r1 = sum_loop(10000000)
    let t1 = clock_ns()
    let r2 = count_primes(50000)
    let t2 = clock_ns()
    print("sum(10M)    = " + str(r1) + " in " + str((t1 - t0) / 1000000) + " ms")
    print("primes(50K) = " + str(r2) + " in " + str((t2 - t1) / 1000000) + " ms")

run_bench()
