import std/cli/cli_flags

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn ckl(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    // KAT: clf_has_flag(['-v','file'],'-v')=true
    ckb("has_flag_present", clf_has_flag(["-v", "file"], "-v"), true)

    // KAT: clf_has_flag(['-v'],'-x')=false
    ckb("has_flag_absent", clf_has_flag(["-v"], "-x"), false)

    // KAT: clf_count_flag(['-vvv'],'v')=3
    cki("count_cluster3", clf_count_flag(["-vvv"], "v"), 3)

    // KAT: clf_count_flag(['-v','-v'],'v')=2
    cki("count_separate2", clf_count_flag(["-v", "-v"], "v"), 2)

    // KAT: clf_count_flag(['-vav'],'v')=2
    cki("count_mixed2", clf_count_flag(["-vav"], "v"), 2)

    // KAT: clf_has_any(['-h'],['-v','-h'])=true
    ckb("has_any_true", clf_has_any(["-h"], ["-v", "-h"]), true)

    // KAT: clf_has_flag([],'-v')=false
    ckb("has_flag_empty", clf_has_flag([], "-v"), false)

    // Additional robustness tests.

    // Long flag present.
    ckb("long_flag_present", clf_has_flag(["--verbose", "file"], "--verbose"), true)

    // Long flag absent.
    ckb("long_flag_absent", clf_has_flag(["--verbose"], "--debug"), false)

    // Count across mix of clustered and separate.
    cki("count_mixed_all", clf_count_flag(["-vvv", "-v", "-vav"], "v"), 6)

    // count_flag with '--' long option: should not scan it.
    cki("count_skip_long", clf_count_flag(["--verbose", "-v"], "v"), 1)

    // has_any with no match.
    ckb("has_any_false", clf_has_any(["--debug"], ["-v", "--verbose"]), false)

    // has_any on empty argv.
    ckb("has_any_empty_argv", clf_has_any([], ["-v"]), false)

    // has_any with empty names list.
    ckb("has_any_empty_names", clf_has_any(["-v"], []), false)

    // count_flag letter not present.
    cki("count_absent_letter", clf_count_flag(["-abc"], "v"), 0)

    print("PASS _cli_flags_test")
