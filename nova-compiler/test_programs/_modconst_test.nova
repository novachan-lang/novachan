// Pins module-level scalar constant inlining. Before the fix, a module-level `let X = <literal>`
// read INSIDE a function returned 0/"" (each fn got its own zero'd copy). Now scalar module
// consts are inlined into the functions that read them. Also guards local shadowing.
let PI = 3.141592653589793
let MAX = 100
let GREETING = "hello"
let FLAG = true

fn get_pi() -> float
    return PI

fn use_max() -> int
    let m = MAX
    return m + MAX

fn get_greeting() -> string
    return GREETING

fn get_flag() -> bool
    return FLAG

fn shadow() -> int
    let MAX = 5
    return MAX

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.0001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    // read module consts inside a function (main == nova_user_main)
    ckf("pi_here", PI, 3.141592653589793)
    cki("max_here", MAX, 100)
    // read via other functions (the core fix)
    ckf("pi_fn", get_pi(), 3.141592653589793)
    cki("max_fn", use_max(), 200)
    cks("greeting_fn", get_greeting(), "hello")
    // bool const
    if get_flag()
        cki("flag_ok", 1, 1)
    else
        print("FAIL flag: expected true")
        exit(1)
    // local shadow must win over the module const
    cki("shadow", shadow(), 5)
    print("_modconst_test passed")
