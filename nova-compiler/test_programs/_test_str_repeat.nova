fn main()
    let r1 = str_repeat("abc", 3)
    assert(r1 == "abcabcabc", "repeat 3")

    let r2 = str_repeat("x", 5)
    assert(r2 == "xxxxx", "repeat 5")

    let r3 = str_repeat("hi", 1)
    assert(r3 == "hi", "repeat 1")

    let r4 = str_repeat("z", 0)
    assert(r4 == "", "repeat 0")

    let r5 = str_repeat("", 10)
    assert(r5 == "", "empty repeat")

    let sep = str_repeat("-", 10)
    assert(sep == "----------", "separator")

    print("STR_REPEAT TEST PASS")
