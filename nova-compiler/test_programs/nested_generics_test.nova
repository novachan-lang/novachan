// Nested-generic type annotations test

fn first_int(xs: List<int>) -> int
    if len(xs) == 0
        return 0
    return xs[0]

fn sum_list(xs: List<int>) -> int
    let total = 0
    for x in xs
        total = total + x
    return total

fn first_of_first(xs: List<List<int>>) -> int
    if len(xs) == 0
        return -1
    let inner = xs[0]
    if len(inner) == 0
        return -1
    return inner[0]

fn lookup(m: Map<string, int>, k: string) -> int
    if m.has(k)
        return m[k]
    return -1

fn main()
    let a = first_int([10, 20, 30])
    print(a)

    let b = sum_list([1, 2, 3, 4, 5])
    print(b)

    let nested = [[1, 2], [3, 4], [5, 6]]
    let c = first_of_first(nested)
    print(c)

    let m = {"alice": 100, "bob": 200, "carol": 300}
    let d = lookup(m, "bob")
    print(d)
    let e = lookup(m, "dave")
    print(e)
