// showcase_rpn -- a reverse-Polish-notation calculator that returns a Result (ok/err) and uses
// `match` for error handling. An ELEVENTH angle: the built-in Result ADT + pattern matching +
// idiomatic error propagation (underflow, division-by-zero, malformed input all become Err, never a
// crash), over a stack (list + push/pop). Self-verifying.

fn is_op(t: string) -> int
    if t == "+" or t == "-" or t == "*" or t == "/"
        return 1
    return 0

fn apply_op(op: string, a: int, b: int) -> int
    if op == "+"
        return a + b
    if op == "-"
        return a - b
    if op == "*"
        return a * b
    return a / b

fn eval_rpn(expr: string)
    let toks = split(expr, " ")
    let stack = []
    for t in toks
        if t == ""
            continue
        else if is_op(t) == 1
            if len(stack) < 2
                return err("underflow at '" + t + "'")
            let b = pop(stack)
            let a = pop(stack)
            if t == "/" and b == 0
                return err("division by zero")
            push(stack, apply_op(t, a, b))
        else
            push(stack, parse_int(t))
    if len(stack) != 1
        return err("malformed: " + str(len(stack)) + " values left on stack")
    return ok(pop(stack))

fn result_str(r) -> string
    match r
        Ok(v) => "ok:" + str(v)
        Err(e) => "err:" + e

fn main()
    // valid expressions
    assert(result_str(eval_rpn("3 4 +")) == "ok:7", "3 4 + = 7")
    assert(result_str(eval_rpn("5 1 2 + 4 * + 3 -")) == "ok:14", "5 1 2 + 4 * + 3 - = 14")
    assert(result_str(eval_rpn("2 3 4 * +")) == "ok:14", "2 3 4 * + = 14")
    assert(result_str(eval_rpn("10 2 /")) == "ok:5", "10 2 / = 5")
    assert(result_str(eval_rpn("7")) == "ok:7", "single value = 7")
    print("valid: " + result_str(eval_rpn("5 1 2 + 4 * + 3 -")))

    // error cases -> Err, never a crash
    assert(result_str(eval_rpn("1 +")) == "err:underflow at '+'", "underflow rejected")
    assert(result_str(eval_rpn("+")) == "err:underflow at '+'", "lone op rejected")
    assert(result_str(eval_rpn("5 0 /")) == "err:division by zero", "div-by-zero rejected")
    assert(result_str(eval_rpn("1 2 3 +")) == "err:malformed: 2 values left on stack", "leftover values rejected")
    print("error: " + result_str(eval_rpn("5 0 /")))

    print("showcase_rpn_test passed -- RPN eval with Result ADT + match error handling, pure NOVA")
