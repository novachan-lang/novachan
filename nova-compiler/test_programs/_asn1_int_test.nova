// _asn1_int_test — KAT for std/data/asn1_int
//
// Verifies byte-exact DER TLV encoding of signed integers and round-trip
// decode for all canonical vectors specified in the module task.
//
// KAT vectors (X.690 / RFC 5280):
//   asn1_int_encode(0)    == [0x02,0x01,0x00]
//   asn1_int_encode(127)  == [0x02,0x01,0x7F]
//   asn1_int_encode(128)  == [0x02,0x02,0x00,0x80]
//   asn1_int_encode(256)  == [0x02,0x02,0x01,0x00]
//   asn1_int_encode(-1)   == [0x02,0x01,0xFF]
//   asn1_int_encode(-128) == [0x02,0x01,0x80]
//   asn1_int_encode(300)  == [0x02,0x02,0x01,0x2C]
//   Round-trip decode: 0, 127, 128, 256, -1, -128, 300

import std/data/asn1_int

// ck: assert two ints equal; on mismatch print FAIL and exit(1)
fn ck(label, got, want)
    if got != want
        print("FAIL asn1_int " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── KAT 1: asn1_int_encode(0) == [0x02, 0x01, 0x00] ─────────────────────
    let e0 = asn1_int_encode(0)
    ck("enc(0) len",    bytes_len(e0), 3)
    ck("enc(0) tag",    bytes_get(e0, 0), 2)
    ck("enc(0) clen",   bytes_get(e0, 1), 1)
    ck("enc(0) val",    bytes_get(e0, 2), 0)
    print("PASS kat1: asn1_int_encode(0)")

    // ── KAT 2: asn1_int_encode(127) == [0x02, 0x01, 0x7F] ───────────────────
    let e127 = asn1_int_encode(127)
    ck("enc(127) len",  bytes_len(e127), 3)
    ck("enc(127) tag",  bytes_get(e127, 0), 2)
    ck("enc(127) clen", bytes_get(e127, 1), 1)
    ck("enc(127) val",  bytes_get(e127, 2), 127)
    print("PASS kat2: asn1_int_encode(127)")

    // ── KAT 3: asn1_int_encode(128) == [0x02, 0x02, 0x00, 0x80] ─────────────
    let e128 = asn1_int_encode(128)
    ck("enc(128) len",  bytes_len(e128), 4)
    ck("enc(128) tag",  bytes_get(e128, 0), 2)
    ck("enc(128) clen", bytes_get(e128, 1), 2)
    ck("enc(128) b0",   bytes_get(e128, 2), 0)
    ck("enc(128) b1",   bytes_get(e128, 3), 128)
    print("PASS kat3: asn1_int_encode(128)")

    // ── KAT 4: asn1_int_encode(256) == [0x02, 0x02, 0x01, 0x00] ─────────────
    let e256 = asn1_int_encode(256)
    ck("enc(256) len",  bytes_len(e256), 4)
    ck("enc(256) tag",  bytes_get(e256, 0), 2)
    ck("enc(256) clen", bytes_get(e256, 1), 2)
    ck("enc(256) b0",   bytes_get(e256, 2), 1)
    ck("enc(256) b1",   bytes_get(e256, 3), 0)
    print("PASS kat4: asn1_int_encode(256)")

    // ── KAT 5: asn1_int_encode(-1) == [0x02, 0x01, 0xFF] ────────────────────
    let em1 = asn1_int_encode(-1)
    ck("enc(-1) len",   bytes_len(em1), 3)
    ck("enc(-1) tag",   bytes_get(em1, 0), 2)
    ck("enc(-1) clen",  bytes_get(em1, 1), 1)
    ck("enc(-1) val",   bytes_get(em1, 2), 255)
    print("PASS kat5: asn1_int_encode(-1)")

    // ── KAT 6: asn1_int_encode(-128) == [0x02, 0x01, 0x80] ──────────────────
    let em128 = asn1_int_encode(-128)
    ck("enc(-128) len",  bytes_len(em128), 3)
    ck("enc(-128) tag",  bytes_get(em128, 0), 2)
    ck("enc(-128) clen", bytes_get(em128, 1), 1)
    ck("enc(-128) val",  bytes_get(em128, 2), 128)
    print("PASS kat6: asn1_int_encode(-128)")

    // ── KAT 7: asn1_int_encode(300) == [0x02, 0x02, 0x01, 0x2C] ─────────────
    let e300 = asn1_int_encode(300)
    ck("enc(300) len",  bytes_len(e300), 4)
    ck("enc(300) tag",  bytes_get(e300, 0), 2)
    ck("enc(300) clen", bytes_get(e300, 1), 2)
    ck("enc(300) b0",   bytes_get(e300, 2), 1)
    ck("enc(300) b1",   bytes_get(e300, 3), 44)
    print("PASS kat7: asn1_int_encode(300)")

    // ── KAT 8: Round-trip decode for all seven vectors ────────────────────────
    let rt0 = asn1_int_decode(e0, 0)
    ck("rt(0) val",      rt0[0], 0)
    ck("rt(0) next_pos", rt0[1], 3)

    let rt127 = asn1_int_decode(e127, 0)
    ck("rt(127) val",      rt127[0], 127)
    ck("rt(127) next_pos", rt127[1], 3)

    let rt128 = asn1_int_decode(e128, 0)
    ck("rt(128) val",      rt128[0], 128)
    ck("rt(128) next_pos", rt128[1], 4)

    let rt256 = asn1_int_decode(e256, 0)
    ck("rt(256) val",      rt256[0], 256)
    ck("rt(256) next_pos", rt256[1], 4)

    let rtm1 = asn1_int_decode(em1, 0)
    ck("rt(-1) val",      rtm1[0], -1)
    ck("rt(-1) next_pos", rtm1[1], 3)

    let rtm128 = asn1_int_decode(em128, 0)
    ck("rt(-128) val",      rtm128[0], -128)
    ck("rt(-128) next_pos", rtm128[1], 3)

    let rt300 = asn1_int_decode(e300, 0)
    ck("rt(300) val",      rt300[0], 300)
    ck("rt(300) next_pos", rt300[1], 4)

    print("PASS kat8: round-trip decode all vectors")

    // ── KAT 9: Decode at non-zero offset (concatenated TLVs) ─────────────────
    // Concatenate enc(127) ++ enc(-1) and decode each at correct offset
    let two = bytes_concat(e127, em1)
    let d0 = asn1_int_decode(two, 0)
    ck("concat d0 val",   d0[0], 127)
    ck("concat d0 next",  d0[1], 3)
    let d1 = asn1_int_decode(two, d0[1])
    ck("concat d1 val",   d1[0], -1)
    ck("concat d1 next",  d1[1], 6)
    print("PASS kat9: decode at offset in concatenated bytes")

    // ── KAT 10: Error handling — wrong tag, truncated, empty ─────────────────
    // Wrong tag (use 0x04 = OCTET STRING)
    let bad_tag = bytes(3)
    bytes_set(bad_tag, 0, 4)
    bytes_set(bad_tag, 1, 1)
    bytes_set(bad_tag, 2, 0)
    let r_bad = asn1_int_decode(bad_tag, 0)
    ck("bad_tag sentinel0", r_bad[0], -1)
    ck("bad_tag sentinel1", r_bad[1], -1)

    // Truncated: claims length 5 but only 2 content bytes follow
    let trunc = bytes(4)
    bytes_set(trunc, 0, 2)
    bytes_set(trunc, 1, 5)
    bytes_set(trunc, 2, 1)
    bytes_set(trunc, 3, 2)
    let r_trunc = asn1_int_decode(trunc, 0)
    ck("trunc sentinel0", r_trunc[0], -1)
    ck("trunc sentinel1", r_trunc[1], -1)

    print("PASS kat10: error sentinel on malformed input")

    print("PASS _asn1_int_test")

main()
