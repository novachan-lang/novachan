// ============================================================================
// KAT for std/net/dns_message
// ============================================================================
// Vectors:
//   (a) Query encode exact bytes:
//       header {id=0x1234, rd=1}, questions [{name="example.com",type=1,class=1}]
//       => 29 bytes: 12-byte header + 17-byte question
//       header: [0x12,0x34, 0x01,0x00, 0x00,0x01, 0x00,0x00, 0x00,0x00, 0x00,0x00]
//       question: [0x07 'example' 0x03 'com' 0x00 0x00 0x01 0x00 0x01]
//
//   (b) Query encode -> decode round-trip:
//       header.id==0x1234, questions[0].name=="example.com" type==1
//
//   (c) Response encode exact header byte check:
//       header {id=0x1234, qr=1}, question same, answers [{rdata=[1,2,3,4] ttl=300}]
//       => 56 bytes; header flags byte[2]==0x80 (QR=1)
//
//   (d) Response encode -> decode round-trip:
//       answers[0].ttl==300, rdata bytes [1,2,3,4]
// ============================================================================
import std/net/dns_message

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL dns_message " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL dns_message " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── (a) Query: exact byte check ───────────────────────────────────────────
    // Build a standard A query for example.com
    let q_hdr = {"id": 0x1234, "rd": 1}
    let q_question = {"name": "example.com", "type": 1, "class": 1}
    let q_questions = [q_question]
    let q_msg = {"header": q_hdr, "questions": q_questions, "answers": []}
    let q_wire = dns_message_encode(q_msg)

    // Total: 12 (header) + 17 (question) = 29 bytes
    cki("query_len", bytes_len(q_wire), 29)

    // Header bytes
    cki("q_hdr_id_hi",   bytes_get(q_wire, 0),  0x12)
    cki("q_hdr_id_lo",   bytes_get(q_wire, 1),  0x34)
    // flags: rd=1 => bit 8 set => 0x0100 => byte2=0x01, byte3=0x00
    cki("q_hdr_fl_hi",   bytes_get(q_wire, 2),  0x01)
    cki("q_hdr_fl_lo",   bytes_get(q_wire, 3),  0x00)
    // qdcount=1
    cki("q_hdr_qd_hi",   bytes_get(q_wire, 4),  0x00)
    cki("q_hdr_qd_lo",   bytes_get(q_wire, 5),  0x01)
    // ancount=0
    cki("q_hdr_an_hi",   bytes_get(q_wire, 6),  0x00)
    cki("q_hdr_an_lo",   bytes_get(q_wire, 7),  0x00)
    // nscount=0, arcount=0
    cki("q_hdr_ns_hi",   bytes_get(q_wire, 8),  0x00)
    cki("q_hdr_ns_lo",   bytes_get(q_wire, 9),  0x00)
    cki("q_hdr_ar_hi",   bytes_get(q_wire, 10), 0x00)
    cki("q_hdr_ar_lo",   bytes_get(q_wire, 11), 0x00)

    // Question bytes starting at offset 12
    // QNAME "example.com": 0x07 'example' 0x03 'com' 0x00 = 13 bytes
    cki("q_qn_len0",   bytes_get(q_wire, 12), 7)      // len("example")
    cki("q_qn_e",      bytes_get(q_wire, 13), 101)    // 'e'
    cki("q_qn_x",      bytes_get(q_wire, 14), 120)    // 'x'
    cki("q_qn_a",      bytes_get(q_wire, 15), 97)     // 'a'
    cki("q_qn_m",      bytes_get(q_wire, 16), 109)    // 'm'
    cki("q_qn_p",      bytes_get(q_wire, 17), 112)    // 'p'
    cki("q_qn_l",      bytes_get(q_wire, 18), 108)    // 'l'
    cki("q_qn_e2",     bytes_get(q_wire, 19), 101)    // 'e'
    cki("q_qn_len1",   bytes_get(q_wire, 20), 3)      // len("com")
    cki("q_qn_c",      bytes_get(q_wire, 21), 99)     // 'c'
    cki("q_qn_o",      bytes_get(q_wire, 22), 111)    // 'o'
    cki("q_qn_m2",     bytes_get(q_wire, 23), 109)    // 'm'
    cki("q_qn_term",   bytes_get(q_wire, 24), 0)      // terminator
    // QTYPE=1 big-endian
    cki("q_qtype_hi",  bytes_get(q_wire, 25), 0)
    cki("q_qtype_lo",  bytes_get(q_wire, 26), 1)
    // QCLASS=1 big-endian
    cki("q_qclass_hi", bytes_get(q_wire, 27), 0)
    cki("q_qclass_lo", bytes_get(q_wire, 28), 1)

    print("ok: query encode 29-byte exact wire verified")

    // ── (b) Query round-trip: encode -> decode ────────────────────────────────
    let q_dec = dns_message_decode(q_wire)

    // Header fields
    let q_dhdr = q_dec["header"]
    cki("qt_id",      q_dhdr["id"],      0x1234)
    cki("qt_qr",      q_dhdr["qr"],      0)
    cki("qt_rd",      q_dhdr["rd"],      1)
    cki("qt_qdcount", q_dhdr["qdcount"], 1)
    cki("qt_ancount", q_dhdr["ancount"], 0)

    // Questions section
    let q_dqs = q_dec["questions"]
    cki("qt_nquestions", len(q_dqs), 1)
    let q_dq0 = q_dqs[0]
    cks("qt_q0_name",  q_dq0["name"],  "example.com")
    cki("qt_q0_type",  q_dq0["type"],  1)
    cki("qt_q0_class", q_dq0["class"], 1)

    // Answers and other sections must be empty lists
    cki("qt_nanswers",    len(q_dec["answers"]),    0)
    cki("qt_nauthority",  len(q_dec["authority"]),  0)
    cki("qt_nadditional", len(q_dec["additional"]), 0)

    print("ok: query encode->decode round-trip verified")

    // ── (c) Response: exact header byte check ────────────────────────────────
    // Build rdata = [1,2,3,4]
    let rdata = bytes(4)
    bytes_set(rdata, 0, 1)
    bytes_set(rdata, 1, 2)
    bytes_set(rdata, 2, 3)
    bytes_set(rdata, 3, 4)

    let r_hdr = {"id": 0x1234, "qr": 1}
    let r_question = {"name": "example.com", "type": 1, "class": 1}
    let r_answer = {"name": "example.com", "type": 1, "class": 1, "ttl": 300, "rdata": rdata}
    let r_questions = [r_question]
    let r_answers = [r_answer]
    let r_msg = {"header": r_hdr, "questions": r_questions, "answers": r_answers}
    let r_wire = dns_message_encode(r_msg)

    // Total: 12 (header) + 17 (question) + 27 (RR) = 56 bytes
    cki("resp_len", bytes_len(r_wire), 56)

    // Header: id=0x1234, qr=1, flags=0x8000, qdcount=1, ancount=1
    cki("r_hdr_id_hi",   bytes_get(r_wire, 0),  0x12)
    cki("r_hdr_id_lo",   bytes_get(r_wire, 1),  0x34)
    // flags: qr=1 => bit15 set => 0x8000 => byte2=0x80, byte3=0x00
    cki("r_hdr_fl_hi",   bytes_get(r_wire, 2),  0x80)
    cki("r_hdr_fl_lo",   bytes_get(r_wire, 3),  0x00)
    // qdcount=1
    cki("r_hdr_qd_hi",   bytes_get(r_wire, 4),  0x00)
    cki("r_hdr_qd_lo",   bytes_get(r_wire, 5),  0x01)
    // ancount=1
    cki("r_hdr_an_hi",   bytes_get(r_wire, 6),  0x00)
    cki("r_hdr_an_lo",   bytes_get(r_wire, 7),  0x01)

    // Answer RR starts at offset 29 (12 + 17)
    // NAME "example.com": same 13 bytes
    cki("r_an_name0",   bytes_get(r_wire, 29), 7)    // len("example")
    cki("r_an_name1",   bytes_get(r_wire, 30), 101)  // 'e'
    cki("r_an_nterm",   bytes_get(r_wire, 41), 0)    // terminator at offset 29+12=41
    // TYPE=1 at offset 42
    cki("r_an_type_hi", bytes_get(r_wire, 42), 0)
    cki("r_an_type_lo", bytes_get(r_wire, 43), 1)
    // CLASS=1 at offset 44
    cki("r_an_cls_hi",  bytes_get(r_wire, 44), 0)
    cki("r_an_cls_lo",  bytes_get(r_wire, 45), 1)
    // TTL=300=0x0000012C at offset 46
    cki("r_an_ttl_b0",  bytes_get(r_wire, 46), 0)
    cki("r_an_ttl_b1",  bytes_get(r_wire, 47), 0)
    cki("r_an_ttl_b2",  bytes_get(r_wire, 48), 1)
    cki("r_an_ttl_b3",  bytes_get(r_wire, 49), 44)   // 0x2C=44
    // RDLENGTH=4 at offset 50
    cki("r_an_rdlen_hi",bytes_get(r_wire, 50), 0)
    cki("r_an_rdlen_lo",bytes_get(r_wire, 51), 4)
    // RDATA [1,2,3,4] at offset 52
    cki("r_an_rd0",     bytes_get(r_wire, 52), 1)
    cki("r_an_rd1",     bytes_get(r_wire, 53), 2)
    cki("r_an_rd2",     bytes_get(r_wire, 54), 3)
    cki("r_an_rd3",     bytes_get(r_wire, 55), 4)

    print("ok: response encode 56-byte exact wire verified")

    // ── (d) Response round-trip: encode -> decode ─────────────────────────────
    let r_dec = dns_message_decode(r_wire)

    // Header
    let r_dhdr = r_dec["header"]
    cki("rt_id",      r_dhdr["id"],      0x1234)
    cki("rt_qr",      r_dhdr["qr"],      1)
    cki("rt_qdcount", r_dhdr["qdcount"], 1)
    cki("rt_ancount", r_dhdr["ancount"], 1)
    cki("rt_nscount", r_dhdr["nscount"], 0)
    cki("rt_arcount", r_dhdr["arcount"], 0)

    // Question
    let r_dqs = r_dec["questions"]
    cki("rt_nquestions", len(r_dqs), 1)
    let r_dq0 = r_dqs[0]
    cks("rt_q0_name",  r_dq0["name"],  "example.com")
    cki("rt_q0_type",  r_dq0["type"],  1)
    cki("rt_q0_class", r_dq0["class"], 1)

    // Answer
    let r_dans = r_dec["answers"]
    cki("rt_nanswers", len(r_dans), 1)
    let r_dan0 = r_dans[0]
    cks("rt_a0_name",  r_dan0["name"],     "example.com")
    cki("rt_a0_type",  r_dan0["type"],     1)
    cki("rt_a0_class", r_dan0["class"],    1)
    cki("rt_a0_ttl",   r_dan0["ttl"],      300)
    cki("rt_a0_rdlen", r_dan0["rdlength"], 4)

    // rdata bytes [1,2,3,4]
    let r_rd = r_dan0["rdata"]
    cki("rt_a0_rd_len", bytes_len(r_rd), 4)
    cki("rt_a0_rd0",    bytes_get(r_rd, 0), 1)
    cki("rt_a0_rd1",    bytes_get(r_rd, 1), 2)
    cki("rt_a0_rd2",    bytes_get(r_rd, 2), 3)
    cki("rt_a0_rd3",    bytes_get(r_rd, 3), 4)

    // Authority and additional must be empty
    cki("rt_nauthority",  len(r_dec["authority"]),  0)
    cki("rt_nadditional", len(r_dec["additional"]), 0)

    print("ok: response encode->decode round-trip verified (ttl=300, rdata=[1,2,3,4])")

    // ── (e) Multi-section message: authority + additional ─────────────────────
    let ns_rdata = bytes(0)
    // NS RR name in rdata (wire-encoded "ns1.example.com")
    // We just use bytes(0) as raw rdata for the NS RR for simplicity
    let ns_rr = {"name": "example.com", "type": 2, "class": 1, "ttl": 3600, "rdata": ns_rdata}
    let ar_rr  = {"name": "ns1.example.com", "type": 1, "class": 1, "ttl": 3600, "rdata": rdata}
    let m3_msg = {"header": {"id": 0x0001, "qr": 1, "aa": 1}, "questions": [r_question], "answers": [r_answer], "authority": [ns_rr], "additional": [ar_rr]}
    let m3_wire = dns_message_encode(m3_msg)
    let m3_dec  = dns_message_decode(m3_wire)
    let m3_hdr  = m3_dec["header"]
    cki("m3_id",       m3_hdr["id"],      1)
    cki("m3_qr",       m3_hdr["qr"],      1)
    cki("m3_aa",       m3_hdr["aa"],      1)
    cki("m3_qdcount",  m3_hdr["qdcount"], 1)
    cki("m3_ancount",  m3_hdr["ancount"], 1)
    cki("m3_nscount",  m3_hdr["nscount"], 1)
    cki("m3_arcount",  m3_hdr["arcount"], 1)
    cki("m3_nquestions",  len(m3_dec["questions"]),  1)
    cki("m3_nanswers",    len(m3_dec["answers"]),    1)
    cki("m3_nauthority",  len(m3_dec["authority"]),  1)
    cki("m3_nadditional", len(m3_dec["additional"]), 1)
    cks("m3_auth_name",   m3_dec["authority"][0]["name"],  "example.com")
    cks("m3_add_name",    m3_dec["additional"][0]["name"], "ns1.example.com")

    print("ok: multi-section message authority+additional round-trip verified")

    // ── (f) Robustness: truncated message must not crash ──────────────────────
    let short = bytes(5)
    let bad1 = dns_message_decode(short)
    // Returns a dict (not crash); questions list is empty
    cki("trunc_nq", len(bad1["questions"]), 0)

    let empty_b = bytes(0)
    let bad2 = dns_message_decode(empty_b)
    cki("empty_nq", len(bad2["questions"]), 0)

    print("ok: truncated/empty inputs handled without crash")

    print("PASS _dns_message_test")
