import std/collections/ordereddict

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // --- Basic insertion order: c, a, b ---
    let od = ordereddict.od_new()
    ordereddict.od_set(od, "c", 3)
    ordereddict.od_set(od, "a", 1)
    ordereddict.od_set(od, "b", 2)

    let k = ordereddict.od_keys(od)
    cks(k[0], "c", "keys[0] == c")
    cks(k[1], "a", "keys[1] == a")
    cks(k[2], "b", "keys[2] == b")
    cki(ordereddict.od_len(od), 3, "len after 3 inserts")

    // --- od_get retrieves correct values ---
    cki(ordereddict.od_get(od, "c"), 3, "get c == 3")
    cki(ordereddict.od_get(od, "a"), 1, "get a == 1")
    cki(ordereddict.od_get(od, "b"), 2, "get b == 2")

    // --- od_has ---
    cki(ordereddict.od_has(od, "a"), 1, "has a")
    cki(ordereddict.od_has(od, "z"), 0, "has z (absent)")

    // --- Re-set "a": value updated, keys order unchanged ---
    ordereddict.od_set(od, "a", 99)
    let k2 = ordereddict.od_keys(od)
    cks(k2[0], "c", "keys[0] unchanged after re-set a")
    cks(k2[1], "a", "keys[1] unchanged after re-set a")
    cks(k2[2], "b", "keys[2] unchanged after re-set a")
    cki(ordereddict.od_get(od, "a"), 99, "get a == 99 after re-set")
    cki(ordereddict.od_len(od), 3, "len unchanged after re-set")

    // --- od_del "a": removes from keys, len drops to 2 ---
    ordereddict.od_del(od, "a")
    cki(ordereddict.od_len(od), 2, "len == 2 after del a")
    cki(ordereddict.od_has(od, "a"), 0, "a absent after del")
    let k3 = ordereddict.od_keys(od)
    cks(k3[0], "c", "keys[0] == c after del a")
    cks(k3[1], "b", "keys[1] == b after del a")

    // --- od_values follows insertion order after del ---
    let v = ordereddict.od_values(od)
    cki(v[0], 3, "values[0] == 3 (c)")
    cki(v[1], 2, "values[1] == 2 (b)")

    // --- get on missing key returns null ---
    let missing = ordereddict.od_get(od, "z")
    cki(missing == null, 1, "get missing returns null")

    // --- od_del on absent key is a no-op ---
    ordereddict.od_del(od, "z")
    cki(ordereddict.od_len(od), 2, "len unchanged after del absent key")

    // --- Empty dict ---
    let empty = ordereddict.od_new()
    cki(ordereddict.od_len(empty), 0, "empty len == 0")
    cki(ordereddict.od_has(empty, "x"), 0, "empty has x == 0")

    print("_ordereddict_test passed")
