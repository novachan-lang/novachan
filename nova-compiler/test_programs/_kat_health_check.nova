import forge_health_check

fn main()
    let hc = hc_new()
    hc = hc_register(hc, "database", "tcp")
    hc = hc_register(hc, "cache", "tcp")
    hc = hc_register(hc, "disk", "local")
    assert(hc_check_count(hc) == 3, "3 checks")

    hc = hc_report_up(hc, "database", 100)
    hc = hc_report_up(hc, "cache", 100)
    hc = hc_report_up(hc, "disk", 100)
    assert(hc_overall(hc) == "up", "all up")
    assert(hc_status(hc, "database") == "up", "db up")

    hc = hc_report_degraded(hc, "cache", "high latency", 200)
    assert(hc_overall(hc) == "degraded", "degraded")

    hc = hc_report_down(hc, "database", "connection refused", 300)
    assert(hc_overall(hc) == "down", "down")

    let down = hc_down_checks(hc)
    assert(len(down) == 1, "1 down")
    assert(down[0] == "database", "db down")

    let summary = hc_summary(hc)
    assert(summary["overall"] == "down", "summary down")
    assert(summary["total"] == 3, "summary total")
    assert(summary["down"] == 1, "summary 1 down")

    hc = hc_report_up(hc, "database", 400)
    hc = hc_report_up(hc, "cache", 400)
    assert(hc_overall(hc) == "up", "recovered")

    print("HEALTH-CHECK KAT PASS")
