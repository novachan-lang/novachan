// Select: multiplex multiple channels — receive from whichever is ready first.
// 3 producers send at different "speeds", consumer uses select to handle
// messages as they arrive. No polling, no callbacks, no async — just select.

fn slow_producer(ch, label, count)
    let i = 0
    while i < count
        send(ch, label + ":" + str(i))
        i = i + 1

fn main()
    let ch_a = channel()
    let ch_b = channel()
    let ch_c = channel()

    // 3 producers sending to different channels
    spawn slow_producer(ch_a, "A", 3)
    spawn slow_producer(ch_b, "B", 2)
    spawn slow_producer(ch_c, "C", 4)

    // Receive all 9 messages using select (3+2+4)
    let total = 9
    let received = []
    let i = 0
    while i < total
        let result = select(ch_a, ch_b, ch_c)
        let _idx = result[0]
        let val = result[1]
        push(received, val)
        i = i + 1

    print("received " + str(len(received)) + " messages via select:")
    let j = 0
    while j < len(received)
        print("  " + str(received[j]))
        j = j + 1

    // Verify counts per source
    let a_count = 0
    let b_count = 0
    let c_count = 0
    let k = 0
    while k < len(received)
        if starts_with(received[k], "A:")
            a_count = a_count + 1
        if starts_with(received[k], "B:")
            b_count = b_count + 1
        if starts_with(received[k], "C:")
            c_count = c_count + 1
        k = k + 1

    assert(a_count == 3, "A sent 3")
    assert(b_count == 2, "B sent 2")
    assert(c_count == 4, "C sent 4")
    print("mt_select_test: PASSED — multiplexed 3 channels, got all 9 messages")
