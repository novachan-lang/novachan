// KAT test for std/time/rfc2822
import std/time/rfc2822

fn cki(got, expected, label) -> int
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)
    0

fn cks(got, expected, label) -> int
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)
    0

fn main()
    // KAT 1-5: parse the primary RFC 2822 example
    let d = r2_parse("Mon, 13 Jul 2026 15:30:00 +0000")
    let _a = cki(d["day"], 13, "day")
    let _b = cki(d["month"], 7, "month")
    let _c = cki(d["year"], 2026, "year")
    let _d = cki(d["hour"], 15, "hour")
    let _e = cki(d["minute"], 30, "minute")
    let _f = cki(d["second"], 0, "second")
    let _g = cki(d["tzoff"], 0, "tzoff_utc")
    let _wk = cks(d["weekday"], "Mon", "weekday")

    // KAT 6: +0530 offset -> 330 minutes
    let d2 = r2_parse("Tue, 01 Jan 2030 00:00:00 +0530")
    let _h = cki(d2["tzoff"], 330, "tzoff_plus0530")
    let _i = cki(d2["year"], 2030, "year2")
    let _j = cki(d2["day"], 1, "day2")
    let _k = cki(d2["month"], 1, "month_jan")

    // KAT 7: month_num lookups
    let _m = cki(r2_month_num("Jul"), 7, "month_num_Jul")
    let _n = cki(r2_month_num("Dec"), 12, "month_num_Dec")
    let _o = cki(r2_month_num("Jan"), 1, "month_num_Jan")
    let _p = cki(r2_month_num("XXX"), 0, "month_num_unknown")

    // KAT 8: month_name lookups
    let _q = cks(r2_month_name(3), "Mar", "month_name_3")
    let _r = cks(r2_month_name(1), "Jan", "month_name_1")
    let _s = cks(r2_month_name(12), "Dec", "month_name_12")
    let _t = cks(r2_month_name(0), "", "month_name_0")

    // KAT 9: negative tzoff (-0500 -> -300)
    let d3 = r2_parse("Wed, 04 Jun 2025 12:00:00 -0500")
    let _u = cki(d3["tzoff"], -300, "tzoff_minus0500")

    // KAT 10: format round-trip
    let fstr = r2_format(d)
    let _v = cks(fstr, "Mon, 13 Jul 2026 15:30:00 +0000", "format_roundtrip")

    // KAT 11: format with +0530 offset
    let fstr2 = r2_format(d2)
    let _w = cks(fstr2, "Tue, 01 Jan 2030 00:00:00 +0530", "format_plus0530")

    // KAT 12: GMT and UTC special tokens
    let d4 = r2_parse("Fri, 25 Dec 2020 08:00:00 GMT")
    let _x = cki(d4["tzoff"], 0, "tzoff_gmt")
    let _y = cki(d4["month"], 12, "month_dec")

    print("_rfc2822_test passed")
