import std/encoding/properties

// KAT helpers
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        if expected
            print("FAIL " + label + ": expected true but got false")
        else
            print("FAIL " + label + ": expected false but got true")
        exit(1)

// ── KAT 1: canonical spec input ──────────────────────────────────────────────
// Build the test text using chr(10) for newlines as required by the spec.
let nl = chr(10)
let text1 = "a=1" + nl + "b : 2" + nl + "# c=3" + nl + "d=hello world" + nl + "! e=x"
let p1 = prop_parse(text1)

cks("a", prop_get(p1, "a"), "1")
cks("b", prop_get(p1, "b"), "2")
cks("d", prop_get(p1, "d"), "hello world")

// comment keys must NOT appear
ckb("no_c", contains(p1, "c"), false)
ckb("no_e", contains(p1, "e"), false)

// ── KAT 2: colon-separated with surrounding spaces ───────────────────────────
let text2 = "  x  :  hello  " + nl + "  y = world  "
let p2 = prop_parse(text2)
cks("x_space", prop_get(p2, "x"), "hello")
cks("y_space", prop_get(p2, "y"), "world")

// ── KAT 3: blank lines and mixed comments ─────────────────────────────────────
let text3 = nl + "# skip me" + nl + nl + "! also skip" + nl + "k1=v1" + nl + nl + "k2=v2"
let p3 = prop_parse(text3)
cks("k1", prop_get(p3, "k1"), "v1")
cks("k2", prop_get(p3, "k2"), "v2")
ckb("no_skip", contains(p3, "skip"), false)

// ── KAT 4: prop_get missing key returns empty string ─────────────────────────
let p4 = prop_parse("only=this")
cks("present", prop_get(p4, "only"), "this")
cks("absent",  prop_get(p4, "missing"), "")
ckb("absent_contains", contains(p4, "missing"), false)

// ── KAT 5: duplicate key — last value wins ───────────────────────────────────
let text5 = "dup=first" + nl + "dup=second"
let p5 = prop_parse(text5)
cks("dup_last", prop_get(p5, "dup"), "second")

// ── KAT 6: prop_serialize round-trip ─────────────────────────────────────────
// Build a small dict, serialize it, parse it back, verify values survive.
let pd = {}
pd["alpha"] = "one"
pd["beta"] = "two"
let serial = prop_serialize(pd)
let p6 = prop_parse(serial)
cks("rt_alpha", prop_get(p6, "alpha"), "one")
cks("rt_beta", prop_get(p6, "beta"), "two")

// ── KAT 7: value with equals sign in it ──────────────────────────────────────
let text7 = "url=http://x.com?a=1&b=2"
let p7 = prop_parse(text7)
cks("url_val", prop_get(p7, "url"), "http://x.com?a=1&b=2")

// ── KAT 8: no trailing newline on last line ───────────────────────────────────
let text8 = "noeol=yes"
let p8 = prop_parse(text8)
cks("noeol", prop_get(p8, "noeol"), "yes")

print("_properties_test passed")
