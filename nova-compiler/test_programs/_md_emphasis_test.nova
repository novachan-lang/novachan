import std/text/md_emphasis

fn main()
    // KAT 1: **bold**
    let got1 = md_emphasis("**bold**")
    let exp1 = "<strong>bold</strong>"
    if got1 != exp1
        print("FAIL md_emphasis KAT1: got [" + got1 + "]")
        exit(1)

    // KAT 2: *italic*
    let got2 = md_emphasis("*it*")
    let exp2 = "<em>it</em>"
    if got2 != exp2
        print("FAIL md_emphasis KAT2: got [" + got2 + "]")
        exit(1)

    // KAT 3: `code` span
    let got3 = md_emphasis("use `x` here")
    let exp3 = "use <code>x</code> here"
    if got3 != exp3
        print("FAIL md_emphasis KAT3: got [" + got3 + "]")
        exit(1)

    // KAT 4: bold and italic together
    let got4 = md_emphasis("a **b** c *d*")
    let exp4 = "a <strong>b</strong> c <em>d</em>"
    if got4 != exp4
        print("FAIL md_emphasis KAT4: got [" + got4 + "]")
        exit(1)

    // KAT 5: plain text unchanged
    let got5 = md_emphasis("hello world")
    if got5 != "hello world"
        print("FAIL md_emphasis KAT5: got [" + got5 + "]")
        exit(1)

    // KAT 6: code span with asterisks inside — asterisks not treated as emphasis
    let got6 = md_emphasis("`a*b*c`")
    let exp6 = "<code>a*b*c</code>"
    if got6 != exp6
        print("FAIL md_emphasis KAT6: got [" + got6 + "]")
        exit(1)

    // KAT 7: multiple bold spans
    let got7 = md_emphasis("**x** and **y**")
    let exp7 = "<strong>x</strong> and <strong>y</strong>"
    if got7 != exp7
        print("FAIL md_emphasis KAT7: got [" + got7 + "]")
        exit(1)

    // KAT 8: empty string
    let got8 = md_emphasis("")
    if got8 != ""
        print("FAIL md_emphasis KAT8: got [" + got8 + "]")
        exit(1)

    print("PASS _md_emphasis_test")
