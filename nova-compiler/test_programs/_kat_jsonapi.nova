import forge_jsonapi

fn has(s: string, sub: string) -> string
    if find(s, sub) >= 0
        return "T"
    "F"
fn tf(b: bool) -> string
    if b
        return "T"
    "F"

fn main()
    let q = chr(34)
    let attrs = {}
    attrs["title"] = "Hello"
    let r = jsonapi_resource("articles", "1", attrs)
    jsonapi_relationship(r, "author", "people", "9")
    let doc = jsonapi_document(r)
    let j = jsonapi_to_json(doc)
    print("has_data=" + has(j, q + "data" + q))
    print("has_type=" + has(j, q + "type" + q + ":" + q + "articles" + q))
    print("has_id=" + has(j, q + "id" + q + ":" + q + "1" + q))
    print("has_attrs=" + has(j, q + "attributes" + q))
    print("has_title=" + has(j, q + "title" + q + ":" + q + "Hello" + q))
    print("has_rel=" + has(j, q + "relationships" + q))
    print("has_author=" + has(j, q + "author" + q))
    print("has_relref=" + has(j, q + "type" + q + ":" + q + "people" + q))
    // errors document
    let errdoc = jsonapi_errors([jsonapi_error(404, "Not Found", "no such article")])
    let je = jsonapi_to_json(errdoc)
    print("has_errors=" + has(je, q + "errors" + q))
    print("has_status=" + has(je, q + "status" + q + ":" + q + "404" + q))
    print("has_errtitle=" + has(je, q + "title" + q + ":" + q + "Not Found" + q))
    print("ct=" + tf(jsonapi_content_type() == "application/vnd.api+json"))
