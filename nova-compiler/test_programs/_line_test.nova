// _line_test.nova — KAT for std/geometry/line.nova
import std/geometry/line

fn main() -> int
    // Build the two diagonal lines used across multiple KATs.
    let p00 = []
    push(p00, 0)
    push(p00, 0)
    let p22 = []
    push(p22, 2)
    push(p22, 2)
    let p02 = []
    push(p02, 0)
    push(p02, 2)
    let p20 = []
    push(p20, 2)
    push(p20, 0)
    let l1 = ln_from_points(p00, p22)
    let l2 = ln_from_points(p02, p20)

    // KAT 1: ln_intersect(l1, l2) == [1.0, 1.0]
    let inter12 = ln_intersect(l1, l2)
    let ix = inter12[0]
    let iy = inter12[1]
    let klen12 = len(inter12)
    if klen12 != 2
        print("FAIL KAT1: expected len 2 got " + str(klen12))
        exit(1)
    if ix < 0.999
        print("FAIL KAT1: ix < 0.999, got " + str(ix))
        exit(1)
    if ix > 1.001
        print("FAIL KAT1: ix > 1.001, got " + str(ix))
        exit(1)
    if iy < 0.999
        print("FAIL KAT1: iy < 0.999, got " + str(iy))
        exit(1)
    if iy > 1.001
        print("FAIL KAT1: iy > 1.001, got " + str(iy))
        exit(1)

    // KAT 2: ln_parallel for horizontal lines — must be true.
    let ph0a = []
    push(ph0a, 0)
    push(ph0a, 0)
    let ph0b = []
    push(ph0b, 1)
    push(ph0b, 0)
    let ph1a = []
    push(ph1a, 0)
    push(ph1a, 1)
    let ph1b = []
    push(ph1b, 1)
    push(ph1b, 1)
    let lh0 = ln_from_points(ph0a, ph0b)
    let lh1 = ln_from_points(ph1a, ph1b)
    let par_true = ln_parallel(lh0, lh1)
    if par_true != true
        print("FAIL KAT2: expected parallel==true for y=0 and y=1")
        exit(1)

    // KAT 3: ln_parallel(l1, l2) — diagonal lines that cross — must be false.
    let par_false = ln_parallel(l1, l2)
    if par_false != false
        print("FAIL KAT3: expected parallel==false for crossing diagonals")
        exit(1)

    // KAT 4: ln_dist_point — vertical line x=0, distance from (3,2) == 3.0
    let pv0 = []
    push(pv0, 0)
    push(pv0, 0)
    let pv4 = []
    push(pv4, 0)
    push(pv4, 4)
    let lv = ln_from_points(pv0, pv4)
    let d = ln_dist_point(lv, 3, 2)
    if d < 2.999
        print("FAIL KAT4: dist < 2.999, got " + str(d))
        exit(1)
    if d > 3.001
        print("FAIL KAT4: dist > 3.001, got " + str(d))
        exit(1)

    // KAT 5: ln_side — x-axis (y=0), point (1,5) is above -> side == 1
    let px0 = []
    push(px0, 0)
    push(px0, 0)
    let px4 = []
    push(px4, 4)
    push(px4, 0)
    let lx = ln_from_points(px0, px4)
    let side_pos = ln_side(lx, 1, 5)
    if side_pos != 1
        print("FAIL KAT5: expected side==1 for (1,5) above x-axis, got " + str(side_pos))
        exit(1)

    // KAT 6: ln_intersect of parallel lines == [].
    let inter_par = ln_intersect(lh0, lh1)
    let klen_par = len(inter_par)
    if klen_par != 0
        print("FAIL KAT6: expected [] for parallel intersect, got len=" + str(klen_par))
        exit(1)

    print("_line_test passed")
    0
