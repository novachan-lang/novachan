import std/graph/graph_metrics

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn ckl(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Graph A: star tree — node 0 connects to 1 and 2; nodes 1,2 connect back to 0
    // adj: 0->[1,2], 1->[0], 2->[0]
    let adj_star = []
    let s0 = []
    push(s0, 1)
    push(s0, 2)
    push(adj_star, s0)
    let s1 = []
    push(s1, 0)
    push(adj_star, s1)
    let s2 = []
    push(s2, 0)
    push(adj_star, s2)

    // KAT 1: gm_is_tree on star = true
    ckb("is_tree_star", gm_is_tree(adj_star, 3), true)

    // KAT 2: gm_is_connected on star = true
    ckb("is_connected_star", gm_is_connected(adj_star, 3), true)

    // KAT 3: gm_is_bipartite on star = true (star is bipartite)
    ckb("is_bip_star", gm_is_bipartite(adj_star, 3), true)

    // KAT 4: gm_diameter on star (path 0-1-2 doesn't exist; max dist = 2 via 1-0-2)
    cki("diameter_star", gm_diameter(adj_star, 3), 2)

    // KAT 5: gm_component_count on star = 1
    cki("comp_count_star", gm_component_count(adj_star, 3), 1)

    // KAT 6: gm_degree_sequence on star = [2,1,1]
    let ds_star = gm_degree_sequence(adj_star, 3)
    ckl("deg_seq_star", ds_star, [2, 1, 1])

    // Graph B: 3 nodes where node 2 is isolated — 0-1 edge only
    // adj: 0->[1], 1->[0], 2->[]
    let adj_iso = []
    let i0 = []
    push(i0, 1)
    push(adj_iso, i0)
    let i1 = []
    push(i1, 0)
    push(adj_iso, i1)
    let i2 = []
    push(adj_iso, i2)

    // KAT 7: gm_is_connected on isolated graph = false
    ckb("is_connected_iso", gm_is_connected(adj_iso, 3), false)

    // KAT 8: gm_component_count on isolated graph = 2
    cki("comp_count_iso", gm_component_count(adj_iso, 3), 2)

    // KAT 9: gm_is_tree on isolated graph = false (not connected)
    ckb("is_tree_iso", gm_is_tree(adj_iso, 3), false)

    // KAT 10: gm_diameter on disconnected graph = -1
    cki("diameter_iso", gm_diameter(adj_iso, 3), -1)

    // Graph C: K3 triangle — all 3 nodes pairwise connected
    // adj: 0->[1,2], 1->[0,2], 2->[0,1]
    let adj_k3 = []
    let k0 = []
    push(k0, 1)
    push(k0, 2)
    push(adj_k3, k0)
    let k1 = []
    push(k1, 0)
    push(k1, 2)
    push(adj_k3, k1)
    let k2 = []
    push(k2, 0)
    push(k2, 1)
    push(adj_k3, k2)

    // KAT 11: gm_is_bipartite on K3 = false (odd cycle)
    ckb("is_bip_k3", gm_is_bipartite(adj_k3, 3), false)

    // KAT 12: gm_is_tree on K3 = false (has cycle)
    ckb("is_tree_k3", gm_is_tree(adj_k3, 3), false)

    // KAT 13: gm_diameter on K3 = 1 (all pairs distance 1)
    cki("diameter_k3", gm_diameter(adj_k3, 3), 1)

    // Graph D: path 0-1-2
    // adj: 0->[1], 1->[0,2], 2->[1]
    let adj_path = []
    let pp0 = []
    push(pp0, 1)
    push(adj_path, pp0)
    let pp1 = []
    push(pp1, 0)
    push(pp1, 2)
    push(adj_path, pp1)
    let pp2 = []
    push(pp2, 1)
    push(adj_path, pp2)

    // KAT 14: gm_diameter on path = 2
    cki("diameter_path", gm_diameter(adj_path, 3), 2)

    // KAT 15: gm_is_bipartite on path = true
    ckb("is_bip_path", gm_is_bipartite(adj_path, 3), true)

    // KAT 16: gm_is_tree on path = true
    ckb("is_tree_path", gm_is_tree(adj_path, 3), true)

    // KAT 17: gm_degree_sequence on path = [2,1,1]
    let ds_path = gm_degree_sequence(adj_path, 3)
    ckl("deg_seq_path", ds_path, [2, 1, 1])

    // Graph E: empty (n=0)
    let adj_empty = []
    ckb("is_connected_empty", gm_is_connected(adj_empty, 0), true)
    cki("comp_count_empty", gm_component_count(adj_empty, 0), 0)
    ckb("is_tree_empty", gm_is_tree(adj_empty, 0), true)
    ckb("is_bip_empty", gm_is_bipartite(adj_empty, 0), true)
    cki("diameter_empty", gm_diameter(adj_empty, 0), -1)

    // Graph F: single node (n=1)
    let adj_one = []
    let one0 = []
    push(adj_one, one0)
    ckb("is_connected_one", gm_is_connected(adj_one, 1), true)
    cki("comp_count_one", gm_component_count(adj_one, 1), 1)
    ckb("is_tree_one", gm_is_tree(adj_one, 1), true)
    cki("diameter_one", gm_diameter(adj_one, 1), 0)

    print("PASS _graph_metrics_test")
