fn range(n)
  i = 0
  while i < n
    yield i
    i = i + 1

fn squares(n)
  for i in range(n)
    yield i * i

fn fibonacci(n)
  a = 0
  b = 1
  count = 0
  while count < n
    yield a
    temp = a + b
    a = b
    b = temp
    count = count + 1

result = gen_collect(range(5))
print(result)

sq = gen_collect(squares(5))
print(sq)

fibs = gen_collect(fibonacci(8))
print(fibs)

print(len(gen_collect(range(10))))
