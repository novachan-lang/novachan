// functional: gRPC-over-h2 unary dispatch END-TO-END in-process (HEADERS+DATA -> reply frames + trailers)
import forge_grpc_h2
import forge_h2
import forge_hpack
import forge_grpc

fn _echo(payload: list) -> list
    payload

fn main()
    let hdrs = []
    push(hdrs, [":method", "POST"])
    push(hdrs, [":path", "/echo.Echo/Say"])
    push(hdrs, ["content-type", "application/grpc"])
    let req = forge_h2.h2_frame(forge_h2.h2_HEADERS(), forge_h2.h2_END_HEADERS(), 1, forge_hpack.hpack_encode_header_block(hdrs))
    let dframe = forge_h2.h2_frame(forge_h2.h2_DATA(), forge_h2.h2_END_STREAM(), 1, forge_grpc.grpc_frame([1, 2, 3]))
    let i = 0
    while i < len(dframe)
        push(req, dframe[i])
        i = i + 1
    let smap = forge_grpc.grpc_register(forge_grpc.grpc_service_map(), "/echo.Echo/Say", _echo)
    let dec = grpc_h2_decode_reply(grpc_h2_handle(smap, req, 1))
    if dec[0] != 0
        print("FAIL grpc-status = " + str(dec[0]))
        exit(1)
    if str(dec[1]) != str([0, 0, 0, 0, 3, 1, 2, 3])
        print("FAIL reply data = " + str(dec[1]))
        exit(1)
    let h2 = []
    push(h2, [":path", "/no.Such/Method"])
    let req2 = forge_h2.h2_frame(forge_h2.h2_HEADERS(), forge_h2.h2_END_HEADERS(), 3, forge_hpack.hpack_encode_header_block(h2))
    let d2 = forge_h2.h2_frame(forge_h2.h2_DATA(), forge_h2.h2_END_STREAM(), 3, forge_grpc.grpc_frame([9]))
    let j = 0
    while j < len(d2)
        push(req2, d2[j])
        j = j + 1
    let dec2 = grpc_h2_decode_reply(grpc_h2_handle(smap, req2, 3))
    if dec2[0] != 12
        print("FAIL unimpl status = " + str(dec2[0]))
        exit(1)
    print("PASS forge_grpc_h2")
