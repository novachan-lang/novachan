@event
fn on_click(x: int) -> int
    return x + 1

@event("user.login")
fn handle_login(user: string) -> string
    return "logged in: " + user

fn main()
    assert(on_click__event_name() == "on_click", "auto name")
    assert(on_click__is_event_handler() == 1, "is handler")

    assert(handle_login__event_name() == "user.login", "custom name")
    assert(handle_login__is_event_handler() == 1, "login is handler")

    let r = on_click(5)
    assert(r == 6, "fn works")

    let l = handle_login("Alice")
    assert(l == "logged in: Alice", "login works")

    print("EVENT ANNOTATION TEST PASS")
