// Test higher-order list functions: map, filter, sort

fn test_map()
    nums = [1, 2, 3, 4, 5]
    doubled = map(nums, fn(x) x * 2)
    for v in doubled
        print(v)

fn test_filter()
    nums = [1, 2, 3, 4, 5, 6, 7, 8]
    evens = filter(nums, fn(x) x % 2 == 0)
    for v in evens
        print(v)

fn test_sort()
    nums = [5, 3, 8, 1, 9, 2, 7]
    sort(nums)
    for v in nums
        print(v)

fn test_combined()
    data = [10, 25, 3, 42, 7, 18, 31]
    big = filter(data, fn(x) x > 10)
    doubled = map(big, fn(x) x * 2)
    sort(doubled)
    for v in doubled
        print(v)

test_map()
print("---")
test_filter()
print("---")
test_sort()
print("---")
test_combined()
print("done")
