// Test higher-order functions: map, filter with closures

fn my_map(items: list, f) -> list
    let result = []
    for item in items
        push(result, f(item))
    result

fn my_filter(items: list, pred) -> list
    let result = []
    for item in items
        if pred(item)
            push(result, item)
    result

fn my_reduce(items: list, init, f) -> int
    let acc = init
    for item in items
        acc = f(acc, item)
    acc

fn test()
    let nums = [1, 2, 3, 4, 5]

    // Map: double each element
    let doubled = my_map(nums, x => x * 2)
    assert(doubled[0] == 2, "map0")
    assert(doubled[2] == 6, "map2")
    assert(doubled[4] == 10, "map4")

    // Filter: keep evens
    let evens = my_filter(nums, x => x % 2 == 0)
    assert(len(evens) == 2, "filter count")
    assert(evens[0] == 2, "filter0")
    assert(evens[1] == 4, "filter1")

    // Reduce: sum
    let total = my_reduce(nums, 0, (acc, x) => acc + x)
    assert(total == 15, "reduce sum")

    // Reduce: product
    let product = my_reduce(nums, 1, (acc, x) => acc * x)
    assert(product == 120, "reduce product")

    // Closure capturing outer variable
    let factor = 10
    let scaled = my_map(nums, x => x * factor)
    assert(scaled[0] == 10, "capture0")
    assert(scaled[4] == 50, "capture4")

    print("Higher-order function tests: ALL PASSED")

test()
