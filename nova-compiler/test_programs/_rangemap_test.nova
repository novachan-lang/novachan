import std/collections/rangemap

// helper: check string equality
fn cks(got, want, label)
    if got == want
        return 0
    print("FAIL " + label + ": got=" + got + " want=" + want)
    exit(1)

// helper: check int equality
fn cki(got, want, label)
    if got == want
        return 0
    print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn main()
    // Build a basic two-range map
    let m = rm_new()
    rm_set(m, 1, 5, "low")
    rm_set(m, 6, 10, "high")

    // KAT 1: query inside first range
    cks(rm_get(m, 3, ""), "low", "rm_get(3)")

    // KAT 2: query inside second range
    cks(rm_get(m, 8, ""), "high", "rm_get(8)")

    // KAT 3: query outside all ranges returns default
    cks(rm_get(m, 20, "none"), "none", "rm_get(20,none)")

    // KAT 4: rm_contains for point inside first range
    cki(rm_contains(m, 3), 1, "rm_contains(3)")

    // KAT 5: rm_contains for point outside all ranges
    cki(rm_contains(m, 20), 0, "rm_contains(20)")

    // KAT 6: boundary — last point of first range
    cks(rm_get(m, 5, ""), "low", "rm_get(5)")

    // KAT 7: boundary — first point of second range
    cks(rm_get(m, 6, ""), "high", "rm_get(6)")

    // KAT 8: rm_ranges returns insertion-order list of length 2
    let rng = rm_ranges(m)
    cki(len(rng), 2, "len(rm_ranges)")

    // KAT 9: later rm_set wins on overlap (last-wins precedence)
    let m2 = rm_new()
    rm_set(m2, 1, 10, "first")
    rm_set(m2, 5, 8, "second")
    cks(rm_get(m2, 6, ""), "second", "overlap_last_wins")

    // KAT 10: rm_contains after overlap set
    cki(rm_contains(m2, 3), 1, "m2_rm_contains(3)")

    print("_rangemap_test passed")
