// KAT for std/game/handscore -- Poker hand strength.
// Deterministic vectors verified by hand against standard poker rules.
import std/game/handscore

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // ── category_rank ────────────────────────────────────────────────────────
    cki("cr_royal_flush",      category_rank("royal_flush"),      9)
    cki("cr_straight_flush",   category_rank("straight_flush"),   8)
    cki("cr_four_of_a_kind",   category_rank("four_of_a_kind"),   7)
    cki("cr_full_house",       category_rank("full_house"),       6)
    cki("cr_flush",            category_rank("flush"),            5)
    cki("cr_straight",         category_rank("straight"),         4)
    cki("cr_three_of_a_kind",  category_rank("three_of_a_kind"),  3)
    cki("cr_two_pair",         category_rank("two_pair"),         2)
    cki("cr_pair",             category_rank("pair"),             1)
    cki("cr_high_card",        category_rank("high_card"),        0)
    cki("cr_unknown",          category_rank("bad_name"),         -1)

    // ── Build canonical hands (rank=card[0], suit=card[1]) ──────────────────
    // Royal flush: A-K-Q-J-T spades (suits all 3)
    let rf = []
    push(rf, [14, 3])
    push(rf, [13, 3])
    push(rf, [12, 3])
    push(rf, [11, 3])
    push(rf, [10, 3])

    // Straight flush: 9-8-7-6-5 spades
    let sf = []
    push(sf, [9, 3])
    push(sf, [8, 3])
    push(sf, [7, 3])
    push(sf, [6, 3])
    push(sf, [5, 3])

    // Straight flush low: 6-5-4-3-2 hearts
    let sf_low = []
    push(sf_low, [6, 2])
    push(sf_low, [5, 2])
    push(sf_low, [4, 2])
    push(sf_low, [3, 2])
    push(sf_low, [2, 2])

    // Wheel straight flush: A-2-3-4-5 clubs (effective high=5)
    let sf_wheel = []
    push(sf_wheel, [14, 0])
    push(sf_wheel, [2, 0])
    push(sf_wheel, [3, 0])
    push(sf_wheel, [4, 0])
    push(sf_wheel, [5, 0])

    // Four of a kind: four Aces + king kicker
    let foak = []
    push(foak, [14, 0])
    push(foak, [14, 1])
    push(foak, [14, 2])
    push(foak, [14, 3])
    push(foak, [13, 0])

    // Four of a kind low: four 2s + 3 kicker
    let foak_low = []
    push(foak_low, [2, 0])
    push(foak_low, [2, 1])
    push(foak_low, [2, 2])
    push(foak_low, [2, 3])
    push(foak_low, [3, 0])

    // Full house: Aces full of Kings
    let fh = []
    push(fh, [14, 0])
    push(fh, [14, 1])
    push(fh, [14, 2])
    push(fh, [13, 0])
    push(fh, [13, 1])

    // Full house low: 2s full of 3s
    let fh_low = []
    push(fh_low, [2, 0])
    push(fh_low, [2, 1])
    push(fh_low, [2, 2])
    push(fh_low, [3, 0])
    push(fh_low, [3, 1])

    // Flush: A-K-Q-J-9 hearts
    let fl = []
    push(fl, [14, 2])
    push(fl, [13, 2])
    push(fl, [12, 2])
    push(fl, [11, 2])
    push(fl, [9,  2])

    // Flush low: 2-3-4-5-7 hearts
    let fl_low = []
    push(fl_low, [7, 2])
    push(fl_low, [5, 2])
    push(fl_low, [4, 2])
    push(fl_low, [3, 2])
    push(fl_low, [2, 2])

    // Straight: A-K-Q-J-T offsuit (broadway, NOT a flush)
    let st = []
    push(st, [14, 0])
    push(st, [13, 1])
    push(st, [12, 2])
    push(st, [11, 3])
    push(st, [10, 0])

    // Straight low: 6-5-4-3-2 offsuit
    let st_low = []
    push(st_low, [6, 0])
    push(st_low, [5, 1])
    push(st_low, [4, 2])
    push(st_low, [3, 3])
    push(st_low, [2, 0])

    // Wheel straight (A-2-3-4-5 offsuit, effective high=5)
    let st_wheel = []
    push(st_wheel, [14, 0])
    push(st_wheel, [2, 1])
    push(st_wheel, [3, 2])
    push(st_wheel, [4, 3])
    push(st_wheel, [5, 0])

    // Three of a kind: three Kings + A,Q kickers
    let toak = []
    push(toak, [13, 0])
    push(toak, [13, 1])
    push(toak, [13, 2])
    push(toak, [14, 3])
    push(toak, [12, 0])

    // Two pair: Aces and Kings, Q kicker
    let tp = []
    push(tp, [14, 0])
    push(tp, [14, 1])
    push(tp, [13, 2])
    push(tp, [13, 3])
    push(tp, [12, 0])

    // Two pair low: 2s and 3s, 4 kicker
    let tp_low = []
    push(tp_low, [2, 0])
    push(tp_low, [2, 1])
    push(tp_low, [3, 2])
    push(tp_low, [3, 3])
    push(tp_low, [4, 0])

    // Pair of Kings: K,K,A,Q,J
    let pr_k = []
    push(pr_k, [13, 0])
    push(pr_k, [13, 1])
    push(pr_k, [14, 2])
    push(pr_k, [12, 3])
    push(pr_k, [11, 0])

    // Pair of 2s: 2,2,3,4,5
    let pr_2 = []
    push(pr_2, [2, 0])
    push(pr_2, [2, 1])
    push(pr_2, [3, 2])
    push(pr_2, [4, 3])
    push(pr_2, [5, 0])

    // High card: A-K-Q-J-9 offsuit (not a flush)
    let hc = []
    push(hc, [14, 0])
    push(hc, [13, 1])
    push(hc, [12, 2])
    push(hc, [11, 3])
    push(hc, [9,  0])

    // High card low: 2-3-4-5-7 offsuit
    let hc_low = []
    push(hc_low, [7, 0])
    push(hc_low, [5, 1])
    push(hc_low, [4, 2])
    push(hc_low, [3, 3])
    push(hc_low, [2, 0])

    // ── Score the hands ──────────────────────────────────────────────────────
    let s_rf      = poker_score(rf)
    let s_sf      = poker_score(sf)
    let s_sf_low  = poker_score(sf_low)
    let s_sf_wheel = poker_score(sf_wheel)
    let s_foak    = poker_score(foak)
    let s_foak_low = poker_score(foak_low)
    let s_fh      = poker_score(fh)
    let s_fh_low  = poker_score(fh_low)
    let s_fl      = poker_score(fl)
    let s_fl_low  = poker_score(fl_low)
    let s_st      = poker_score(st)
    let s_st_low  = poker_score(st_low)
    let s_st_wheel = poker_score(st_wheel)
    let s_toak    = poker_score(toak)
    let s_tp      = poker_score(tp)
    let s_tp_low  = poker_score(tp_low)
    let s_pr_k    = poker_score(pr_k)
    let s_pr_2    = poker_score(pr_2)
    let s_hc      = poker_score(hc)
    let s_hc_low  = poker_score(hc_low)

    // ── KAT: category ordering (spec requirement) ────────────────────────────
    // royal_flush > full_house > flush > straight > pair > high_card
    if s_rf <= s_fh
        print("FAIL handscore royal_flush_vs_full_house: got " + str(s_rf) + " <= " + str(s_fh))
        exit(1)
    if s_fh <= s_fl
        print("FAIL handscore full_house_vs_flush: got " + str(s_fh) + " <= " + str(s_fl))
        exit(1)
    if s_fl <= s_st
        print("FAIL handscore flush_vs_straight: got " + str(s_fl) + " <= " + str(s_st))
        exit(1)
    if s_st <= s_pr_k
        print("FAIL handscore straight_vs_pair: got " + str(s_st) + " <= " + str(s_pr_k))
        exit(1)
    if s_pr_k <= s_hc
        print("FAIL handscore pair_vs_high_card: got " + str(s_pr_k) + " <= " + str(s_hc))
        exit(1)

    // ── KAT: complete category chain ─────────────────────────────────────────
    if s_rf <= s_sf
        print("FAIL handscore royal_flush > straight_flush: " + str(s_rf) + " " + str(s_sf))
        exit(1)
    if s_sf <= s_foak
        print("FAIL handscore straight_flush > four_of_a_kind: " + str(s_sf) + " " + str(s_foak))
        exit(1)
    if s_foak <= s_fh
        print("FAIL handscore four_of_a_kind > full_house: " + str(s_foak) + " " + str(s_fh))
        exit(1)
    if s_fh <= s_fl
        print("FAIL handscore full_house > flush: " + str(s_fh) + " " + str(s_fl))
        exit(1)
    if s_fl <= s_st
        print("FAIL handscore flush > straight: " + str(s_fl) + " " + str(s_st))
        exit(1)
    if s_st <= s_toak
        print("FAIL handscore straight > three_of_a_kind: " + str(s_st) + " " + str(s_toak))
        exit(1)
    if s_toak <= s_tp
        print("FAIL handscore three_of_a_kind > two_pair: " + str(s_toak) + " " + str(s_tp))
        exit(1)
    if s_tp <= s_pr_k
        print("FAIL handscore two_pair > pair: " + str(s_tp) + " " + str(s_pr_k))
        exit(1)
    if s_pr_k <= s_hc
        print("FAIL handscore pair > high_card: " + str(s_pr_k) + " " + str(s_hc))
        exit(1)

    // ── KAT: spec-required straight_flush < royal_flush ──────────────────────
    if s_sf >= s_rf
        print("FAIL handscore straight_flush_below_royal: " + str(s_sf) + " >= " + str(s_rf))
        exit(1)

    // ── KAT: pair of Kings > pair of 2s ──────────────────────────────────────
    if s_pr_k <= s_pr_2
        print("FAIL handscore pair_kings_gt_pair_2s: " + str(s_pr_k) + " <= " + str(s_pr_2))
        exit(1)

    // ── KAT: within-category ordering ───────────────────────────────────────
    // Higher four-of-a-kind beats lower
    if s_foak <= s_foak_low
        print("FAIL handscore foak_high_gt_foak_low: " + str(s_foak) + " " + str(s_foak_low))
        exit(1)
    // Higher full house beats lower
    if s_fh <= s_fh_low
        print("FAIL handscore fh_high_gt_fh_low: " + str(s_fh) + " " + str(s_fh_low))
        exit(1)
    // Higher flush beats lower
    if s_fl <= s_fl_low
        print("FAIL handscore fl_high_gt_fl_low: " + str(s_fl) + " " + str(s_fl_low))
        exit(1)
    // Higher straight beats lower
    if s_st <= s_st_low
        print("FAIL handscore st_high_gt_st_low: " + str(s_st) + " " + str(s_st_low))
        exit(1)
    // Wheel straight is lowest straight
    if s_st_wheel >= s_st_low
        print("FAIL handscore wheel_lt_st_low: " + str(s_st_wheel) + " " + str(s_st_low))
        exit(1)
    // Wheel straight flush is lowest straight flush (but still above four-of-a-kind)
    if s_sf_wheel >= s_sf_low
        print("FAIL handscore sf_wheel_lt_sf_low: " + str(s_sf_wheel) + " " + str(s_sf_low))
        exit(1)
    if s_sf_wheel <= s_foak
        print("FAIL handscore sf_wheel_gt_foak: " + str(s_sf_wheel) + " " + str(s_foak))
        exit(1)
    // Higher two pair beats lower
    if s_tp <= s_tp_low
        print("FAIL handscore tp_high_gt_tp_low: " + str(s_tp) + " " + str(s_tp_low))
        exit(1)
    // Higher high card beats lower
    if s_hc <= s_hc_low
        print("FAIL handscore hc_high_gt_hc_low: " + str(s_hc) + " " + str(s_hc_low))
        exit(1)

    print("PASS _handscore_test")
