import forge_load_shedder

fn main()
    let ls = ls_new(3)
    assert(ls_inflight(ls) == 0, "starts 0")

    let r1 = ls_admit(ls, 1)
    ls = r1["ls"]
    assert(r1["admitted"] == 1, "first admitted")

    let r2 = ls_admit(ls, 1)
    ls = r2["ls"]
    let r3 = ls_admit(ls, 1)
    ls = r3["ls"]
    assert(ls_inflight(ls) == 3, "3 inflight = at capacity")

    let r4 = ls_admit(ls, 5)
    ls = r4["ls"]
    assert(r4["admitted"] == 0, "low priority shed")
    assert(ls_total_shed(ls) == 1, "1 shed")

    let r5 = ls_admit(ls, 10)
    ls = r5["ls"]
    assert(r5["admitted"] == 1, "high priority admitted over capacity")

    ls = ls_complete(ls)
    ls = ls_complete(ls)
    assert(ls_inflight(ls) == 2, "2 inflight after 2 completions")

    assert(ls_total_accepted(ls) == 4, "4 total accepted")
    assert(ls_shed_rate(ls) == 20, "20% shed rate")
    assert(ls_utilization(ls) == 66, "66% util")

    print("LOAD-SHEDDER KAT PASS")
