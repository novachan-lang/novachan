import forge_consistent_hash

fn main()
    let c = ch_new(3)
    c = ch_add_node(c, "server1")
    c = ch_add_node(c, "server2")
    assert(ch_node_count(c) == 2, "2 nodes")
    assert(ch_ring_size(c) == 6, "6 vnodes")

    let r1 = ch_get_node(c, "user_123")
    assert(is_ok(r1), "got node for user_123")
    let n1 = unwrap(r1)
    assert(n1 == "server1" or n1 == "server2", "valid node")

    let r2 = ch_get_node(c, "user_456")
    assert(is_ok(r2), "got node for user_456")

    let empty = ch_new(3)
    let r3 = ch_get_node(empty, "key")
    assert(is_err(r3), "empty ring errors")

    print("CONSISTENT-HASH KAT PASS")
