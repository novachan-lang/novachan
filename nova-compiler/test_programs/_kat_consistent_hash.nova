import forge_consistent_hash

fn main()
    let ch = ch_new(3)
    ch = ch_add_node(ch, "server-a")
    ch = ch_add_node(ch, "server-b")
    ch = ch_add_node(ch, "server-c")
    assert(ch_node_count(ch) == 3, "3 nodes")
    assert(ch_ring_size(ch) == 9, "9 ring points (3 nodes * 3 replicas)")

    let n1 = ch_get_node(ch, "user:1")
    assert(len(n1) > 0, "got a node for user:1")

    let n2 = ch_get_node(ch, "user:1")
    assert(n1 == n2, "same key same node")

    let n3 = ch_get_node(ch, "order:42")
    assert(len(n3) > 0, "got a node for order:42")

    let empty = ch_new(3)
    let n_empty = ch_get_node(empty, "key")
    assert(n_empty == "", "empty ring = empty")

    print("CONSISTENT-HASH KAT PASS")
