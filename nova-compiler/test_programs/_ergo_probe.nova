fn main()
    let xs = [10, 20, 30, 40, 50]
    xs[0] += 5
    assert_eq(xs[0], 15)

    let a = 1
    let b = 2
    let t = a
    a = b
    b = t
    assert_eq(a, 2)
    assert_eq(b, 1)

    let squares = [x * x for x in range(6)]
    assert_eq(squares, [0, 1, 4, 9, 16, 25])

    let evens = [x for x in range(10) if x % 2 == 0]
    assert_eq(evens, [0, 2, 4, 6, 8])

    let d = {"a": 1, "b": 2, "c": 3}
    let keys = [k for (k, v) in d]
    assert_eq(len(keys), 3)

    let data = [1, 2, 3, 4, 5]
    let result = data |> map(|x| x * 2) |> filter(|x| x > 4)
    assert_eq(result, [6, 8, 10])

    print("ergo_probe: all passed")
