// KAT for std/net/iprange — IPv4 range/host enumeration.
import std/net/iprange

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ipr_to_int — dotted-quad to 32-bit integer
    cki("to_int_basic",   ipr_to_int("192.168.1.1"),      3232235777)
    cki("to_int_zero",    ipr_to_int("0.0.0.0"),          0)
    cki("to_int_max",     ipr_to_int("255.255.255.255"),   4294967295)
    cki("to_int_bad",     ipr_to_int("256.0.0.1"),        -1)

    // ipr_to_str — 32-bit integer to dotted-quad
    cks("to_str_basic",   ipr_to_str(3232235777),          "192.168.1.1")
    cks("to_str_zero",    ipr_to_str(0),                   "0.0.0.0")
    cks("to_str_max",     ipr_to_str(4294967295),          "255.255.255.255")
    cks("to_str_10",      ipr_to_str(167772160),           "10.0.0.0")

    // ipr_hosts_in_cidr — usable host count
    cki("hosts_24",       ipr_hosts_in_cidr("10.0.0.0/24"), 254)
    cki("hosts_30",       ipr_hosts_in_cidr("10.0.0.0/30"), 2)
    cki("hosts_31",       ipr_hosts_in_cidr("10.0.0.0/31"), 2)
    cki("hosts_32",       ipr_hosts_in_cidr("10.0.0.0/32"), 1)
    cki("hosts_16",       ipr_hosts_in_cidr("172.16.0.0/16"), 65534)

    // ipr_network — network address
    // 192.168.1.128/25: mask=0xFFFFFF80, network=192.168.1.128 (bit7 of last octet set)
    cki("net_25",         ipr_network("192.168.1.128/25"),  ipr_to_int("192.168.1.128"))
    // 10.5.6.7/8: network = 10.0.0.0
    cki("net_8",          ipr_network("10.5.6.7/8"),        ipr_to_int("10.0.0.0"))
    // 192.168.1.1/24: network = 192.168.1.0
    cki("net_24",         ipr_network("192.168.1.1/24"),    ipr_to_int("192.168.1.0"))

    // ipr_broadcast — broadcast address
    // 192.168.1.0/24: broadcast = 192.168.1.255
    cki("bcast_24",       ipr_broadcast("192.168.1.0/24"),  ipr_to_int("192.168.1.255"))
    // 10.0.0.0/8: broadcast = 10.255.255.255
    cki("bcast_8",        ipr_broadcast("10.0.0.0/8"),      ipr_to_int("10.255.255.255"))
    // 192.168.1.128/25: broadcast = 192.168.1.255
    cki("bcast_25",       ipr_broadcast("192.168.1.128/25"), ipr_to_int("192.168.1.255"))

    // ipr_contains — CIDR membership
    ckb("contains_true",  ipr_contains("10.0.0.0/8", "10.5.5.5"),   true)
    ckb("contains_false", ipr_contains("10.0.0.0/8", "11.0.0.0"),   false)
    ckb("contains_24t",   ipr_contains("192.168.1.0/24", "192.168.1.254"), true)
    ckb("contains_24f",   ipr_contains("192.168.1.0/24", "192.168.2.1"),   false)
    ckb("contains_net",   ipr_contains("10.0.0.0/8", "10.0.0.0"),   true)
    ckb("contains_bcast", ipr_contains("10.0.0.0/8", "10.255.255.255"), true)

    // ipr_iter — consecutive IP list
    let got3 = ipr_iter("10.0.0.1", 3)
    cks("iter_0", got3[0], "10.0.0.1")
    cks("iter_1", got3[1], "10.0.0.2")
    cks("iter_2", got3[2], "10.0.0.3")

    // ipr_iter — wrap across octet boundary
    let got_wrap = ipr_iter("10.0.0.254", 3)
    cks("iter_wrap_0", got_wrap[0], "10.0.0.254")
    cks("iter_wrap_1", got_wrap[1], "10.0.0.255")
    cks("iter_wrap_2", got_wrap[2], "10.0.1.0")

    // ipr_iter — count=1 (single host)
    let got1 = ipr_iter("172.16.0.1", 1)
    cks("iter_1host", got1[0], "172.16.0.1")

    print("_iprange_test passed")
