// forge_cassandra — Apache Cassandra CQL native-protocol v4 codec (wire framing +
// core CQL primitive types), over raw TCP. Binary-safe (`bytes`-native, never NOVA
// `string` for wire bytes) and big-endian throughout, matching the framing style of
// std/net/http2 and std/net/dns_header.
//
// Imports ONLY std/encoding/pack (fixed-width BE integer pack/unpack — reused rather
// than hand-rolling shift/mask arithmetic a third time in this codebase).
//
// FRAME HEADER (CQL native protocol v4, §2.2 of the spec) — 9 octets:
//   byte  0    : version   — 0x04 request, 0x84 (0x04|0x80) response
//   byte  1    : flags     — compression/tracing/custom-payload/warning bits
//   bytes 2-3  : stream id — signed 16-bit BE (client-chosen correlation id;
//                negative stream ids are reserved for server-initiated EVENT
//                frames on protocol versions < 4; kept signed here for fidelity)
//   byte  4    : opcode
//   bytes 5-8  : length    — unsigned 32-bit BE, byte length of the body that follows
//
// OPCODES (subset used by this module; full registry is larger):
//   ERROR=0x00 STARTUP=0x01 READY=0x02 OPTIONS=0x05 QUERY=0x07 RESULT=0x08
//
// CQL PRIMITIVE TYPES (§3 of the spec) implemented here:
//   [string]     : [short] n, then n bytes UTF-8            (length is BYTE count)
//   [long string]: [int] n,   then n bytes UTF-8
//   [string map] : [short] count, then count * ([string] key, [string] value)
//   [bytes]      : [int] n, then n bytes (n == -1 means null; NOT bit-length-clamped
//                  like [short bytes] — full 32-bit signed per spec)
//
// WHY [string]/[long string] measure length in `str_to_bytes(s)` bytes and not
// `len(s)` chars: CQL string length is a byte count (it's UTF-8 on the wire), and
// NOVA `len()` on a `string` counts characters. For the ASCII option/query text this
// module targets they coincide, but keying off the byte count is the only correct
// choice for non-ASCII text and is what this module does everywhere.
//
// BINARY SAFETY: [string]/[string map] are CQL's own *text* types (protocol option
// names, CQL query text) — they are decoded with bytes_to_str, which is the correct
// operation for a field the spec defines as UTF-8 text. True opaque/binary payloads
// (bound query parameter values, result-row cell data) use CQL's [bytes] type, which
// this module keeps as `bytes` end-to-end (cql_bytes_encode/cql_bytes_decode) and
// NEVER routes through bytes_to_str — that is the binary-safe path for 0x00-laden
// payloads such as blobs, counters, or UUIDs.
//
// INJECTION SAFETY: every CQL primitive here is LENGTH-PREFIXED, not delimiter- or
// terminator-based. A control character (or a literal copy of another frame's bytes)
// embedded inside a [string]/[string map] key or value cannot forge a second frame or
// truncate parsing early — the reader always advances by the declared length, never by
// scanning for a sentinel byte. This is a structural property of the wire format, not
// an ad hoc filter.
//
// ─────────────────────────────────────────────────────────────────────────────
// RAISED 2026-08-05. The wire format itself is UNTOUCHED — byte layouts, field
// widths, masking rules, bounds checks and the exact failure *decisions* are all
// preserved, and the behaviour diff over the full public API is byte-identical.
// What changed is that the codec no longer THROWS AWAY WHY A FRAME FAILED, and the
// rules it enforces are each written exactly once:
//
//   1. FAILURE WAS TWO DIFFERENT IN-BAND SENTINELS, BOTH LOSSY. Encoders returned
//      `bytes_create(0)`; decoders returned a zero value with `next_pos == pos`
//      unchanged. Both say "something was wrong" and nothing else — for a network
//      codec, where the whole point of a failure is to tell an operator whether the
//      peer sent garbage, the frame was truncated, or OUR OWN encode overflowed a
//      length field, that is the least useful possible answer. Every rule now lives
//      in a Result-returning `*_write` / `*_read` function carrying a reason built
//      from a CqlFail ADT, and every historical `*_encode` / `*_decode` entry point
//      is a ONE-LINE adapter with byte-identical behaviour.
//
//   2. THE "PROPAGATE THE FAILURE SENTINEL" RULE WAS WRITTEN SIX TIMES as
//      `if bytes_len(x) == 0 { return bytes_create(0) }`, and twice more as a hand-
//      rolled `let ok = 1` flag threaded through a while-loop to fake an early exit
//      (cql_string_map_encode, cql_string_map_decode). Six hand-written copies of a
//      propagation rule is six chances to forget one — and forgetting one in an
//      encoder is precisely the frame-desync class this module is hardened against.
//      It is now `?`, once per call site, and both flag-loops are gone.
//
//   3. [string] AND [long string] WERE THE SAME CODE TWICE, differing only in the
//      width of the length prefix (2 vs 4 bytes). Four functions carried two copies
//      of one rule; they had already drifted in their comments, and a bounds fix
//      applied to one would not have been applied to the other. There is now ONE
//      writer and ONE reader parameterised by width, with the four public names as
//      adapters — the two widths are now INCAPABLE of disagreeing.
//
//   4. THE OPCODE AND CONSISTENCY REGISTRIES WERE WRITTEN TWICE EACH — 54 `if`
//      branches across four functions, with name→number and number→name as
//      independent copies of the same fact. They agreed today; nothing made them
//      agree tomorrow. Each registry is now ONE dict literal, and the reverse
//      direction is DERIVED by inverting it.
//
// PUBLIC API — sentinel entry points (behaviour preserved exactly):
//   cql_frame_header_encode(version, flags, stream, opcode, length) -> bytes   (9 bytes)
//   cql_frame_header_decode(b, pos) -> list   [{"version","flags","stream","opcode","length"}, next_pos]
//     Bounds-safe: returns [{}, pos] if pos<0 or fewer than 9 bytes remain.
//
//   cql_string_encode(s) -> bytes / cql_string_decode(b, pos) -> list [string, next_pos]
//   cql_long_string_encode(s) -> bytes / cql_long_string_decode(b, pos) -> list [string, next_pos]
//   cql_string_map_encode(m: dict) -> bytes / cql_string_map_decode(b, pos) -> list [dict, next_pos]
//   cql_bytes_encode(payload: bytes) -> bytes / cql_bytes_encode_null() -> bytes
//   cql_bytes_decode(b, pos) -> list  [payload_bytes, next_pos, is_null(0/1)]
//     All decoders are bounds-safe: on truncation/malformed input they return the
//     zero value ("" / {} / empty bytes) with next_pos == pos unchanged, so a caller
//     can detect failure by comparing returned pos to the pos it passed in.
//
//   cql_startup_body(options: dict) -> bytes         (just the [string map])
//   cql_startup_frame(stream, options: dict) -> bytes  (full STARTUP frame, header+body)
//   cql_query_body(query: string, consistency: int) -> bytes
//     [long string query][short consistency][byte flags=0x00] (no bound values, v4 no-values form)
//   cql_query_frame(stream, query: string, consistency: int) -> bytes  (full QUERY frame)
//   cql_options_frame(stream) -> bytes                (empty-body OPTIONS frame)
//
//   cql_opcode_name(op: int) -> string / cql_opcode_num(name: string) -> int
//   cql_consistency_name(c: int) -> string / cql_consistency_num(name: string) -> int
//
// PUBLIC API — Result twins (NEW: same rules, but they tell you WHY):
//   cql_frame_header_write/read, cql_string_write/read, cql_long_string_write/read,
//   cql_string_map_write/read, cql_bytes_write/read, cql_frame_write,
//   cql_startup_write, cql_query_body_write, cql_query_write, cql_options_write
//     Writers -> ok(bytes) | err(reason). Readers -> ok([value, next_pos, ...]) | err(reason).
//     These are THE implementations; the sentinel names above are adapters over them.
//     Prefer these for anything user-facing — "truncated frame: 7-byte [string] body
//     at 12" is actionable, `["", 12]` is not.
//
// ENCODE FAILURE CONTRACT (unchanged): every *_encode function whose input has a
// declared wire width (cql_string_encode/cql_long_string_encode/cql_string_map_encode/
// cql_bytes_encode/cql_frame_header_encode and everything built on top of them —
// cql_startup_body/cql_startup_frame/cql_query_body/cql_query_frame) validates its
// input against that width and returns bytes_create(0) (0 bytes) on failure,
// instead of silently masking/wrapping an oversized length into the fixed-width
// length prefix. A real encoding from any of these functions is NEVER 0 bytes
// (the shortest is the 2-byte empty-[string]/empty-[string-map] encoding), so
// `bytes_len(result) == 0` is an unambiguous in-band failure signal — callers
// that accept untrusted/unbounded-size input (e.g. a query string or option
// value sourced from a caller-supplied string) MUST check it. This closes a
// silent frame-desync class: masking (e.g. `n & 0xFFFF`) on a length that
// overflows the field turns an oversized value into a WRONG SMALLER declared
// length while still writing the full oversized payload — a decoder then reads
// a short/empty field and misinterprets the leftover bytes as later frame
// fields, the production-side mirror of the over-read/malformed-acceptance bugs
// this module's decoders are hardened against.
//
// LEAF w.r.t. protocol logic — imports only std/encoding/pack for BE int helpers.

import std/encoding/pack as pk

// ── failure causes ───────────────────────────────────────────────────────────

// Why a read or write failed. An ADT rather than a bare string so the CAUSE is a value a
// caller can match on, and so the four causes stay DISTINCT: `Truncated` means the PEER
// sent (or we were handed) fewer bytes than a declared length demands — a network/framing
// problem; `Oversized` means OUR OWN payload cannot be described by the wire's fixed-width
// length field — a local bug or an unvalidated user input, and the one case where retrying
// the same frame can never help; `TooManyEntries` is the same class at the [string map]
// count field; `NegativeLength` is a malformed [bytes] length that is not the legal -1 null
// sentinel. The old code flattened all four into a 0-byte result or an unchanged position.
enum CqlFail
    Truncated(string)
    Oversized(string)
    TooManyEntries(string)
    NegativeLength(string)

fn _cql_fail_text(f) -> string
    match f
        Truncated(t) => "truncated frame: {t}"
        Oversized(t) => "{t} does not fit its wire length field"
        TooManyEntries(t) => "[string map] has {t} entries, exceeding the 16-bit count field"
        NegativeLength(t) => "[bytes] declared length {t}, which is negative and is not the -1 null sentinel"

// ── shared primitives ────────────────────────────────────────────────────────

// Concatenate an ordered list of already-encoded fields. Every frame and every composite
// primitive in this module is "these fields, in this order", and writing that as a LIST
// rather than a chain of `out = bytes_concat(out, ...)` reassignments makes the wire order
// a single readable expression instead of five statements that must be read in sequence to
// confirm nothing was appended out of order. The byte order is identical.
fn _cql_join(parts: list) -> bytes
    reduce(parts, (a, b) => bytes_concat(a, b), bytes_create(0))

// The three width-dependent pieces of a length-prefixed field, each an explicit two-branch
// dispatch rather than computed arithmetic (`(1 << (width * 8)) - 1` and friends): these are
// wire constants, and a reader auditing this codec against the spec must be able to see
// 0xFFFF and 0xFFFFFFFF written down.
fn _cql_len_pack(n: int, width: int) -> bytes
    if width == 2
        return pk.pack_u16_be(n)
    pk.pack_u32_be(n)

fn _cql_len_unpack(b: bytes, pos: int, width: int) -> int
    if width == 2
        return pk.unpack_u16_be(b, pos)
    pk.unpack_u32_be(b, pos)

fn _cql_len_max(width: int) -> int
    if width == 2
        return 0xFFFF
    0xFFFFFFFF

// THE decode adapter, shared by all five historical *_decode entry points: on success hand
// back the reader's [value, next_pos] (or [payload, next_pos, is_null]) list unchanged; on
// failure hand back `on_fail`, which each caller supplies as its own documented zero value
// plus the UNCHANGED pos. One function instead of five copies of the same shape.
fn _cql_pair_or(r: Result, on_fail: list) -> list
    if is_err(r)
        return on_fail
    unwrap(r)

// ── frame header (9 bytes) ──────────────────────────────────────────────────

// cql_frame_header_write: build the 9-byte CQL native-protocol frame header.
// version/flags/opcode masked to 8 bits; stream masked to 16 bits (two's-complement,
// so a negative stream id round-trips correctly — that field is a client-chosen ID,
// not a buffer length, so wraparound there is harmless by design).
// `length` is DIFFERENT: it is the body byte-count and governs how many following
// bytes a peer will read, so it must NEVER be silently masked/wrapped — a length
// that does not fit the wire's 32-bit unsigned field is a genuine encode error, not
// a value to truncate.
fn cql_frame_header_write(version: int, flags: int, stream: int, opcode: int, length: int) -> Result
    if length < 0 or length > 0xFFFFFFFF
        return err(_cql_fail_text(Oversized("a body length of {length}")))
    ok(_cql_join([pk.pack_u8(version & 0xFF), pk.pack_u8(flags & 0xFF), pk.pack_u16_be(stream & 0xFFFF), pk.pack_u8(opcode & 0xFF), pk.pack_u32_be(length)]))

// Returns bytes_create(0) (0 bytes — never a valid header size, which is always exactly 9)
// if length is negative or exceeds 0xFFFFFFFF.
fn cql_frame_header_encode(version: int, flags: int, stream: int, opcode: int, length: int) -> bytes
    unwrap_or(cql_frame_header_write(version, flags, stream, opcode, length), bytes_create(0))

// cql_frame_header_read: decode a 9-byte frame header from b at pos.
// Bounds-safe — b is attacker-controlled network input.
fn cql_frame_header_read(b: bytes, pos: int) -> Result
    if pos < 0 or pos + 9 > bytes_len(b)
        return err(_cql_fail_text(Truncated("9-byte frame header at {pos}")))
    let hdr = {"version": pk.unpack_u8(b, pos), "flags": pk.unpack_u8(b, pos + 1), "stream": pk.unpack_i16_be(b, pos + 2), "opcode": pk.unpack_u8(b, pos + 4), "length": pk.unpack_u32_be(b, pos + 5)}
    ok([hdr, pos + 9])

// Returns [{"version","flags","stream","opcode","length"}, pos+9] on success, or
// [{}, pos] if pos is negative or fewer than 9 bytes remain.
fn cql_frame_header_decode(b: bytes, pos: int) -> list
    _cql_pair_or(cql_frame_header_read(b, pos), [{}, pos])

// ── [string] / [long string] : ONE length-prefixed UTF-8 text codec ─────────

// THE text writer, for BOTH CQL text primitives: [string] has a 16-bit byte-length prefix
// and [long string] a 32-bit one, and that width is the ONLY difference between them — so it
// is a parameter, not a second copy of the function.
// The length field is a fixed-width wire quantity, so a string whose BYTE length exceeds it
// does not fit. The old code masked with `n & 0xFFFF`, which for n==65536 silently wrote a
// 0x0000 ("empty string") length prefix followed by the full 65536-byte payload — a decoder
// would read an empty string and then misinterpret those smuggled bytes as subsequent frame
// fields (a self-inflicted frame-desync, the production-side mirror of the over-read/
// malformed-acceptance decode bugs this module is otherwise hardened against). Validate and
// reject instead of wrapping.
// The PIPE states the wire order the way the spec states it: the length prefix, then the payload.
fn _cql_text_write(s: string, width: int) -> Result
    let sb = str_to_bytes(s)
    let n = bytes_len(sb)
    if n > _cql_len_max(width)
        return err(_cql_fail_text(Oversized("a {n}-byte text field")))
    ok(_cql_len_pack(n, width) |> bytes_concat(sb))

// THE text reader, for both widths. Two bounds checks, in the only order that is safe: the
// prefix must be fully present before it can be trusted, and the body it declares must be
// fully present before it is sliced.
fn _cql_text_read(b: bytes, pos: int, width: int) -> Result
    if pos < 0 or pos + width > bytes_len(b)
        return err(_cql_fail_text(Truncated("{width}-byte text length prefix at {pos}")))
    let n = _cql_len_unpack(b, pos, width)
    let start = pos + width
    if start + n > bytes_len(b)
        return err(_cql_fail_text(Truncated("{n}-byte text body at {start}")))
    ok([bytes_to_str(bytes_slice(b, start, start + n)), start + n])

// [string] : [short] byte-length + UTF-8 bytes.
fn cql_string_write(s: string) -> Result
    _cql_text_write(s, 2)

// Returns bytes_create(0) (never a valid encoding, which is always >= 2 bytes even for the
// empty string) on oversized input; check via bytes_len(result) == 0.
fn cql_string_encode(s: string) -> bytes
    unwrap_or(cql_string_write(s), bytes_create(0))

fn cql_string_read(b: bytes, pos: int) -> Result
    _cql_text_read(b, pos, 2)

// Bounds-safe. Returns ["", pos] unchanged on truncation (declared length prefix present
// but fewer than n bytes remain, or fewer than 2 header bytes remain).
fn cql_string_decode(b: bytes, pos: int) -> list
    _cql_pair_or(cql_string_read(b, pos), ["", pos])

// [long string] : [int] byte-length + UTF-8 bytes.
fn cql_long_string_write(s: string) -> Result
    _cql_text_write(s, 4)

// Returns bytes_create(0) (never a valid encoding, always >= 4 bytes) if the byte length
// exceeds 0xFFFFFFFF.
fn cql_long_string_encode(s: string) -> bytes
    unwrap_or(cql_long_string_write(s), bytes_create(0))

fn cql_long_string_read(b: bytes, pos: int) -> Result
    _cql_text_read(b, pos, 4)

fn cql_long_string_decode(b: bytes, pos: int) -> list
    _cql_pair_or(cql_long_string_read(b, pos), ["", pos])

// ── [string map] : [short] count + count * ([string] key, [string] value) ───

// cql_string_map_write: iteration order follows keys(m) — the caller controls
// determinism by controlling insertion order (matches this codebase's existing
// [string map]-shaped encoders, e.g. std/net/httpheaders).
// The entry `count` is itself a 16-bit field (masking it on overflow would desync count vs.
// actual entries written — same bug class as the text writer), and if ANY key/value fails to
// encode (e.g. a value longer than 0xFFFF bytes) that failure must abort the WHOLE map, not
// just silently contribute zero bytes for that one entry while `count` still claims it is
// present (which would desync every entry after it). That whole-map abort used to be a
// hand-rolled `let ok = 1` flag threaded through a while-loop; it is now `?`, which cannot
// be forgotten on a later edit the way a flag check can.
// The LOOP STAYS: each entry contributes two length-prefixed fields, so the work is per-entry
// and there is nothing for a comprehension to express more clearly.
fn cql_string_map_write(m: dict) -> Result
    let ks = keys(m)
    if len(ks) > 0xFFFF
        return err(_cql_fail_text(TooManyEntries(str(len(ks)))))
    let parts = [pk.pack_u16_be(len(ks))]
    for k in ks
        push(parts, _cql_text_write(k, 2)?)
        push(parts, _cql_text_write(m[k], 2)?)
    ok(_cql_join(parts))

// Returns bytes_create(0) (never valid — a real encoding is always >= 2 bytes) on failure.
fn cql_string_map_encode(m: dict) -> bytes
    unwrap_or(cql_string_map_write(m), bytes_create(0))

// cql_string_map_read: never returns a partially-populated map — the first malformed entry
// aborts the whole read, so a caller gets an unambiguous success/fail signal.
// The LOOP STAYS: `cur` advances by a data-dependent amount (each entry's own declared
// lengths), which no for-range expresses, and `?` gives the early exit on the first bad
// entry that the old `while i < count and ok == 1` was emulating by hand.
fn cql_string_map_read(b: bytes, pos: int) -> Result
    if pos < 0 or pos + 2 > bytes_len(b)
        return err(_cql_fail_text(Truncated("[string map] 2-byte count at {pos}")))
    let count = pk.unpack_u16_be(b, pos)
    let cur = pos + 2
    let out = {}
    for i in 0..count
        let kr = _cql_text_read(b, cur, 2)?
        let vr = _cql_text_read(b, kr[1], 2)?
        out[kr[0]] = vr[0]
        cur = vr[1]
    ok([out, cur])

// Bounds-safe. Returns [{}, pos] unchanged as soon as either a key or a value fails to
// decode (truncated input).
fn cql_string_map_decode(b: bytes, pos: int) -> list
    _cql_pair_or(cql_string_map_read(b, pos), [{}, pos])

// ── [bytes] : [int] n + n bytes (n == -1 means null) ────────────────────────

// cql_bytes_write: [int] n + n bytes. `n` is a SIGNED 32-bit field on the wire
// (the reader takes it with unpack_i32_be so that -1 can mean null). A payload of 2^31
// bytes or more has no correct signed-32-bit representation: the bit pattern would round-trip
// as a NEGATIVE number (and if it happened to land on -1, it would even collide with the null
// sentinel). Reject rather than emit a length prefix that cannot decode back to the true size.
fn cql_bytes_write(payload: bytes) -> Result
    let n = bytes_len(payload)
    if n < 0 or n > 0x7FFFFFFF
        return err(_cql_fail_text(Oversized("a {n}-byte [bytes] payload")))
    ok(pk.pack_i32_be(n) |> bytes_concat(payload))

// Returns bytes_create(0) (never valid — a real encoding is always >= 4 bytes) if the
// payload does not fit in a signed 32-bit length.
fn cql_bytes_encode(payload: bytes) -> bytes
    unwrap_or(cql_bytes_write(payload), bytes_create(0))

fn cql_bytes_encode_null() -> bytes
    pk.pack_i32_be(-1)

// cql_bytes_read: ok([payload_bytes, next_pos, is_null]). is_null==1 iff the length prefix
// was exactly -1 (CQL's null-bytes sentinel) — payload_bytes is an empty `bytes` in that
// case, never a null/undefined value. Any OTHER negative length is malformed and is now
// reported as such by name (NegativeLength) rather than being merged into "truncated".
fn cql_bytes_read(b: bytes, pos: int) -> Result
    if pos < 0 or pos + 4 > bytes_len(b)
        return err(_cql_fail_text(Truncated("[bytes] 4-byte length prefix at {pos}")))
    let n = pk.unpack_i32_be(b, pos)
    if n == -1
        return ok([bytes_create(0), pos + 4, 1])
    if n < 0
        return err(_cql_fail_text(NegativeLength(str(n))))
    if pos + 4 + n > bytes_len(b)
        return err(_cql_fail_text(Truncated("{n}-byte [bytes] payload at {pos}")))
    ok([bytes_slice(b, pos + 4, pos + 4 + n), pos + 4 + n, 0])

// Malformed input is reported the same way the string/map decoders report failure:
// next_pos == pos unchanged, is_null == 0.
fn cql_bytes_decode(b: bytes, pos: int) -> list
    _cql_pair_or(cql_bytes_read(b, pos), [bytes_create(0), pos, 0])

// ── request frames ───────────────────────────────────────────────────────────

// THE frame builder: header (version 0x04, flags 0x00, caller's stream, caller's opcode,
// the body's own length) followed by the body. This was written out twice — once in
// cql_startup_frame and once in cql_query_frame, each with its own copy of the
// "if the header failed, do not emit a header that claims a body" check — and a third time
// in degenerate form in cql_options_frame. One function now, so a fix to frame assembly
// lands in every request type at once.
fn cql_frame_write(stream: int, opcode: int, body: bytes) -> Result
    let hdr = cql_frame_header_write(0x04, 0x00, stream, opcode, bytes_len(body))?
    ok(bytes_concat(hdr, body))

// STARTUP (opcode 0x01). `options` is typically {"CQL_VERSION": "3.0.0"} and optionally
// "COMPRESSION". A failed body must abort the frame rather than produce a header that
// claims a body which was never written.
fn cql_startup_write(stream: int, options: dict) -> Result
    let body = cql_string_map_write(options)?
    cql_frame_write(stream, 0x01, body)

fn cql_startup_body(options: dict) -> bytes
    cql_string_map_encode(options)

fn cql_startup_frame(stream: int, options: dict) -> bytes
    unwrap_or(cql_startup_write(stream, options), bytes_create(0))

// QUERY body: [long string query][short consistency][byte flags]. flags is always 0x00 here
// (no bound values, no paging, no serial consistency, no default-timestamp, no
// names-for-values) — the simplest legal v4 QUERY body. If the query text is too large for
// its 32-bit length prefix, abort the whole body: appending the consistency/flags bytes onto
// a failed (empty) query field would silently produce a body missing its length-prefixed
// query entirely, desyncing every byte after it.
fn cql_query_body_write(query: string, consistency: int) -> Result
    let qb = cql_long_string_write(query)?
    ok(_cql_join([qb, pk.pack_u16_be(consistency & 0xFFFF), pk.pack_u8(0)]))

// Returns bytes_create(0) (never valid — always >= 7 bytes) on failure.
fn cql_query_body(query: string, consistency: int) -> bytes
    unwrap_or(cql_query_body_write(query, consistency), bytes_create(0))

// QUERY (opcode 0x07).
fn cql_query_write(stream: int, query: string, consistency: int) -> Result
    let body = cql_query_body_write(query, consistency)?
    cql_frame_write(stream, 0x07, body)

fn cql_query_frame(stream: int, query: string, consistency: int) -> bytes
    unwrap_or(cql_query_write(stream, query, consistency), bytes_create(0))

// OPTIONS (opcode 0x05) — empty body, so this is the frame builder with nothing after the
// header. It is the same 9 bytes as before; it just no longer says so in its own words.
fn cql_options_write(stream: int) -> Result
    cql_frame_write(stream, 0x05, bytes_create(0))

fn cql_options_frame(stream: int) -> bytes
    unwrap_or(cql_options_write(stream), bytes_create(0))

// ── opcode / consistency registries ──────────────────────────────────────────

// THE opcode registry — the only place in this module where an opcode number is written down.
// Was 32 `if` branches across two functions holding TWO INDEPENDENT COPIES of this table; there
// is now one copy, and the number→name and name→number directions both read it, so they can no
// longer drift.
//
// WHY A DISPATCH AND NOT A DICT LITERAL. A dict literal is the obvious way to write a registry
// and it is the wrong one HERE, because in NOVA a container built inside a function body is
// rebuilt on EVERY call — and a module-level `let TBL = {...}` in an imported module does not
// bake at all (it silently reads back EMPTY; probed 2026-08-05, see the note in the verify log).
// So `get({...literal...}, name, -1)` allocates a 16-entry dict per lookup, and deriving the
// reverse direction by inverting it allocates a second one plus 16 `str()` calls. MEASURED over
// 200k lookups: dict form 2766 ms vs this dispatch 9 ms — 307x. `cql_opcode_name` is called
// once per RECEIVED FRAME by any driver that logs or dispatches on opcode, so that is 14 µs of
// allocation on the frame path. String literals, unlike containers, are baked constants: a
// dispatch returning literals allocates nothing. The dedup goal is fully met either way — this
// form just does not pay 307x for it.
fn _cql_opcode_at(op: int) -> string
    if op == 0x00 then return "ERROR"
    if op == 0x01 then return "STARTUP"
    if op == 0x02 then return "READY"
    if op == 0x03 then return "AUTHENTICATE"
    if op == 0x05 then return "OPTIONS"
    if op == 0x06 then return "SUPPORTED"
    if op == 0x07 then return "QUERY"
    if op == 0x08 then return "RESULT"
    if op == 0x09 then return "PREPARE"
    if op == 0x0A then return "EXECUTE"
    if op == 0x0B then return "REGISTER"
    if op == 0x0C then return "EVENT"
    if op == 0x0D then return "BATCH"
    if op == 0x0E then return "AUTH_CHALLENGE"
    if op == 0x0F then return "AUTH_RESPONSE"
    if op == 0x10 then return "AUTH_SUCCESS"
    ""

// THE consistency registry — likewise, was 22 `if` branches across two functions.
fn _cql_consistency_at(c: int) -> string
    if c == 0x0000 then return "ANY"
    if c == 0x0001 then return "ONE"
    if c == 0x0002 then return "TWO"
    if c == 0x0003 then return "THREE"
    if c == 0x0004 then return "QUORUM"
    if c == 0x0005 then return "ALL"
    if c == 0x0006 then return "LOCAL_QUORUM"
    if c == 0x0007 then return "EACH_QUORUM"
    if c == 0x0008 then return "SERIAL"
    if c == 0x0009 then return "LOCAL_SERIAL"
    if c == 0x000A then return "LOCAL_ONE"
    ""

// Name of an opcode, or "" if it is not a known opcode (e.g. 0x04, CREDENTIALS, removed after
// protocol v1 — absence from the registry IS the "" answer, it is not a separate rule).
fn cql_opcode_name(op: int) -> string
    _cql_opcode_at(op)

// Number of a named opcode, or -1 if the name is not known. DERIVED by scanning the one
// registry above rather than restating it — 17 string compares, zero allocation.
// The empty-name guard is LOAD-BEARING: 0x04 is a hole whose registry entry is "", so without
// it `cql_opcode_num("")` would answer 4 instead of -1.
fn cql_opcode_num(name: string) -> int
    if name == ""
        return -1
    for op in 0..0x11
        if _cql_opcode_at(op) == name
            return op
    -1

// Name of a consistency level, or "" if it is not a known level.
fn cql_consistency_name(c: int) -> string
    _cql_consistency_at(c)

// Number of a named consistency level, or -1 if the name is not known. DERIVED, same as opcodes.
// The consistency table has no holes today, but the guard costs nothing and keeps the two
// registries' contracts identical.
fn cql_consistency_num(name: string) -> int
    if name == ""
        return -1
    for c in 0..0x0B
        if _cql_consistency_at(c) == name
            return c
    -1
