// forge_bayes -- a multinomial naive Bayes text classifier: learn from labelled example documents, then label
// new text by which class makes the words most probable. This is the classic, effective approach to spam vs.
// ham, sentiment (positive/negative), topic/intent routing, and language detection -- fast, tiny, and needs
// only a handful of examples per class. Train by feeding (class, tokens) documents; classify returns the
// best-scoring class. It uses Laplace (add-one) smoothing so an unseen word doesn't zero out a class, and sums
// LOG probabilities so many small factors don't underflow. Tokenize however you like (words, stems, bigrams)
// before calling. LEAF -- imports NOTHING.
//
// Model: [word_counts, class_totals, class_docs, vocab, total_docs]. word_counts keys are "class|token" (flat,
// not nested); class_totals[c] = total tokens seen in class c; class_docs[c] = document count; vocab is the
// set of all tokens; total_docs = documents trained.
//
// RAISED 2026-08-05. Five problems:
//
//   1. bayes_train / bayes_score used for-index loops. for-in.
//   2. bayes_train / bayes_score used `cls + "|" + tok` at 4 sites. Interpolation.
//   3. model[4] = model[4] + 1. Compound `+=`.
//   4. bayes_classify used `started == false`. `not started`.
//   5. bayes_classify had nested else+if. `else if`.

fn bayes_new() -> list
    [{}, {}, {}, {}, 0]

fn bayes_train(model: list, cls: string, tokens: list)
    let docs = model[2]
    docs[cls] = get(docs, cls, 0) + 1
    model[4] += 1
    let wc = model[0]
    let ct = model[1]
    let vocab = model[3]
    for tok in tokens
        let key = "{cls}|{tok}"
        wc[key] = get(wc, key, 0) + 1
        ct[cls] = get(ct, cls, 0) + 1
        vocab[tok] = 1

fn bayes_score(model: list, cls: string, tokens: list) -> float
    let cls_docs = get(model[2], cls, 0)
    let total_docs = model[4]
    let vocab_size = len(model[3])
    let cls_total = get(model[1], cls, 0)
    let wc = model[0]
    let score = 0.0
    if total_docs > 0 and cls_docs > 0
        let prior = (cls_docs * 1.0) / (total_docs * 1.0)
        score = log(prior)
        for tok in tokens
            let key = "{cls}|{tok}"
            let count = get(wc, key, 0)
            let prob = ((count + 1) * 1.0) / ((cls_total + vocab_size) * 1.0)
            score += log(prob)
    score

fn bayes_classify(model: list, tokens: list) -> string
    let classes = keys(model[2])
    let best = ""
    let best_score = 0.0
    let started = false
    for cls in classes
        let s = bayes_score(model, cls, tokens) * 1.0
        if not started
            best_score = s
            best = cls
            started = true
        else if s > best_score
            best_score = s
            best = cls
    best

fn bayes_classes(model: list) -> list
    keys(model[2])

fn bayes_doc_count(model: list) -> int
    model[4]
