// forge_dns_cache — DNS resolution caching with TTL and Result API.

fn dns_new() -> dict
    {"records": {}, "ttls": {}, "hits": 0, "misses": 0, "count": 0}

fn dns_put(d: dict, hostname: string, ip: string, ttl: int, now: int) -> dict
    let rk = "r_" + hostname
    let tk = "t_" + hostname
    let is_new = rk not in d["records"]
    d["records"][rk] = ip
    d["ttls"][tk] = now + ttl
    if is_new
        d["count"] += 1
    d

fn dns_lookup(d: dict, hostname: string, now: int) -> Result
    let rk = "r_" + hostname
    if rk not in d["records"]
        d["misses"] += 1
        return err("not cached")
    let tk = "t_" + hostname
    if now > d["ttls"][tk]
        d["misses"] += 1
        return err("expired")
    d["hits"] += 1
    ok(d["records"][rk])

fn dns_evict(d: dict, hostname: string) -> Result
    let rk = "r_" + hostname
    if rk not in d["records"]
        return err("not found")
    d["records"][rk] = ""
    d["count"] -= 1
    ok(d)

fn dns_hit_rate(d: dict) -> int
    let total = d["hits"] + d["misses"]
    if total == 0
        return 0
    d["hits"] * 100 / total

fn dns_count(d: dict) -> int
    d["count"]
