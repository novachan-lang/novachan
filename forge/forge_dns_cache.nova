// forge_dns_cache — DNS resolution caching with TTL and Result API.

fn dns_new() -> dict
    let d = {}
    d["records"] = {}
    d["ttls"] = {}
    d["hits"] = 0
    d["misses"] = 0
    d["count"] = 0
    d

fn dns_put(d: dict, hostname: string, ip: string, ttl: int, now: int) -> dict
    let rk = "r_" + hostname
    let tk = "t_" + hostname
    let is_new = 0
    if contains(d["records"], rk) != true
        is_new = 1
    d["records"][rk] = ip
    d["ttls"][tk] = now + ttl
    if is_new == 1
        d["count"] = d["count"] + 1
    d

fn dns_lookup(d: dict, hostname: string, now: int) -> Result
    let rk = "r_" + hostname
    if contains(d["records"], rk) != true
        d["misses"] = d["misses"] + 1
        return err("not cached")
    let tk = "t_" + hostname
    if now > d["ttls"][tk]
        d["misses"] = d["misses"] + 1
        return err("expired")
    d["hits"] = d["hits"] + 1
    ok(d["records"][rk])

fn dns_evict(d: dict, hostname: string) -> Result
    let rk = "r_" + hostname
    if contains(d["records"], rk) != true
        return err("not found")
    d["records"][rk] = ""
    d["count"] = d["count"] - 1
    ok(d)

fn dns_hit_rate(d: dict) -> int
    let total = d["hits"] + d["misses"]
    if total == 0
        return 0
    d["hits"] * 100 / total

fn dns_count(d: dict) -> int
    d["count"]
