// forge_htmlentities -- decode HTML character entities back to text (the inverse of forge_html esc()): turn
// &amp; &lt; &#169; &#x2022; into & < (copyright) (bullet). Needed when CONSUMING HTML: scraped pages, RSS/Atom
// feed content, or values that arrived HTML-encoded. Handles the common named entities plus decimal (&#NNN;)
// and hex (&#xHH;) numeric refs, emitting correct UTF-8 for code points beyond ASCII. LEAF -- imports NOTHING.

// PRIVATE: encode a Unicode code point to its UTF-8 byte string (via /,% -- no bit-shifts). BMP coverage.
fn _ent_utf8(cp: int) -> string
    if cp < 128
        return chr(cp)
    if cp < 2048
        return chr(192 + (cp / 64)) + chr(128 + (cp % 64))
    chr(224 + (cp / 4096)) + chr(128 + ((cp / 64) % 64)) + chr(128 + (cp % 64))

// PRIVATE: code point for a named entity, or -1 if unknown.
fn _ent_named(name: string) -> int
    if name == "amp"
        return 38
    if name == "lt"
        return 60
    if name == "gt"
        return 62
    if name == "quot"
        return 34
    if name == "apos"
        return 39
    if name == "nbsp"
        return 160
    if name == "copy"
        return 169
    if name == "reg"
        return 174
    if name == "trade"
        return 8482
    if name == "mdash"
        return 8212
    if name == "ndash"
        return 8211
    if name == "hellip"
        return 8230
    if name == "euro"
        return 8364
    if name == "pound"
        return 163
    if name == "cent"
        return 162
    if name == "deg"
        return 176
    if name == "bull"
        return 8226
    -1

fn _ent_hex(s: string) -> int
    let v = 0
    let i = 0
    while i < len(s)
        let d = find("0123456789abcdef", lower(char_at(s, i)))
        if d < 0
            return -1
        v = v * 16 + d
        i = i + 1
    v

fn _ent_dec(s: string) -> int
    let v = 0
    let i = 0
    while i < len(s)
        let d = find("0123456789", char_at(s, i))
        if d < 0
            return -1
        v = v * 10 + d
        i = i + 1
    v

// PRIVATE: decode the text BETWEEN & and ; -> the character(s), or "" if not a recognized entity.
fn _ent_decode_body(body: string) -> string
    if len(body) == 0
        return ""
    if char_at(body, 0) == "#"
        let numpart = slice(body, 1, len(body))
        if len(numpart) == 0
            return ""
        let cp = 0
        if char_at(numpart, 0) == "x" or char_at(numpart, 0) == "X"
            cp = _ent_hex(slice(numpart, 1, len(numpart)))
        else
            cp = _ent_dec(numpart)
        if cp <= 0
            return ""
        return _ent_utf8(cp)
    let named = _ent_named(body)
    if named < 0
        return ""
    _ent_utf8(named)

// Decode all HTML entities in `s`. An unrecognized "&...;" (or a lone &) is passed through literally.
fn html_decode(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        if c == "&"
            let rest = slice(s, i, n)
            let semi = find(rest, ";")
            if semi > 1 and semi <= 12
                let decoded = _ent_decode_body(slice(s, i + 1, i + semi))
                if len(decoded) > 0
                    out = out + decoded
                    i = i + semi + 1
                else
                    out = out + c
                    i = i + 1
            else
                out = out + c
                i = i + 1
        else
            out = out + c
            i = i + 1
    out
