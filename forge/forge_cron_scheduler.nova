// forge_cron_scheduler — cron-like scheduler with Result API.

fn cron_new() -> dict
    {"jobs": {}, "job_count": 0, "total_runs": 0}

fn cron_add(c: dict, name: string, interval: int) -> Result
    let jk = "job_{name}"
    if jk in c["jobs"]
        return err("job exists: {name}")
    c["jobs"][jk] = interval
    c["jobs"][jk + "_last"] = 0
    c["jobs"][jk + "_runs"] = 0
    c["jobs"][jk + "_enabled"] = 1
    c["job_count"] += 1
    ok(c)

fn cron_should_run(c: dict, name: string, now: int) -> int
    let jk = "job_{name}"
    if jk not in c["jobs"]
        return 0
    if c["jobs"][jk + "_enabled"] == 0
        return 0
    let elapsed = now - c["jobs"][jk + "_last"]
    1 if elapsed >= c["jobs"][jk] else 0

fn cron_mark_run(c: dict, name: string, now: int) -> Result
    let jk = "job_{name}"
    if jk not in c["jobs"]
        return err("unknown job: {name}")
    c["jobs"][jk + "_last"] = now
    c["jobs"][jk + "_runs"] += 1
    c["total_runs"] += 1
    ok(c)

fn cron_disable(c: dict, name: string) -> Result
    let jk = "job_{name}"
    if jk not in c["jobs"]
        return err("unknown job: {name}")
    c["jobs"][jk + "_enabled"] = 0
    ok(c)

fn cron_enable(c: dict, name: string) -> Result
    let jk = "job_{name}"
    if jk not in c["jobs"]
        return err("unknown job: {name}")
    c["jobs"][jk + "_enabled"] = 1
    ok(c)

fn cron_job_count(c: dict) -> int
    c["job_count"]

fn cron_total_runs(c: dict) -> int
    c["total_runs"]
