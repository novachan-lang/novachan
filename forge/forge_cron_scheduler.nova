// forge_cron_scheduler — Cron-style job scheduling with interval tracking.

fn cron_new() -> dict
    let c = {}
    c["jobs"] = {}
    c["next_id"] = 1
    c["executions"] = 0
    c

fn cron_add(c: dict, name: string, interval: int) -> dict
    let id = c["next_id"]
    let k = str(id)
    c["next_id"] = id + 1
    c["jobs"][k + "_name"] = name
    c["jobs"][k + "_interval"] = interval
    c["jobs"][k + "_last_run"] = 0
    c["jobs"][k + "_run_count"] = 0
    c["jobs"][k + "_enabled"] = 1
    c

fn cron_tick(c: dict, now: int) -> dict
    let triggered_count = 0
    let triggered_names = {}
    let i = 1
    while i < c["next_id"]
        let k = str(i)
        let has = contains(c["jobs"], k + "_enabled")
        if has == true
            if c["jobs"][k + "_enabled"] == 1
                let elapsed = now - c["jobs"][k + "_last_run"]
                if elapsed >= c["jobs"][k + "_interval"]
                    c["jobs"][k + "_last_run"] = now
                    c["jobs"][k + "_run_count"] = c["jobs"][k + "_run_count"] + 1
                    c["executions"] = c["executions"] + 1
                    triggered_names[str(triggered_count)] = c["jobs"][k + "_name"]
                    triggered_count = triggered_count + 1
        i = i + 1
    let result = {}
    result["c"] = c
    result["triggered_count"] = triggered_count
    result["triggered"] = triggered_names
    result

fn cron_disable(c: dict, job_id: int) -> dict
    let k = str(job_id)
    let has = contains(c["jobs"], k + "_enabled")
    if has == true
        c["jobs"][k + "_enabled"] = 0
    c

fn cron_enable(c: dict, job_id: int) -> dict
    let k = str(job_id)
    let has = contains(c["jobs"], k + "_enabled")
    if has == true
        c["jobs"][k + "_enabled"] = 1
    c

fn cron_job_count(c: dict) -> int
    let count = 0
    let i = 1
    while i < c["next_id"]
        let has = contains(c["jobs"], str(i) + "_name")
        if has == true
            count = count + 1
        i = i + 1
    count

fn cron_total_executions(c: dict) -> int
    c["executions"]

fn cron_job_runs(c: dict, job_id: int) -> int
    let k = str(job_id)
    let has = contains(c["jobs"], k + "_run_count")
    if has != true
        return 0
    c["jobs"][k + "_run_count"]
