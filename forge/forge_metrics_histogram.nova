// forge_metrics_histogram — Fixed-bucket histogram for latency/size distributions.

fn hist_new(bucket_count: int, bucket_width: int) -> dict
    let buckets = {str(i): 0 for i in 0..bucket_count}
    {"bucket_count": bucket_count, "bucket_width": bucket_width, "buckets": buckets, "total": 0, "sum": 0, "min_val": 999999999, "max_val": 0}

fn hist_observe(h: dict, value: int) -> dict
    h["total"] += 1
    h["sum"] += value
    if value < h["min_val"]
        h["min_val"] = value
    if value > h["max_val"]
        h["max_val"] = value
    let bucket_idx = value / h["bucket_width"]
    if bucket_idx >= h["bucket_count"]
        bucket_idx = h["bucket_count"] - 1
    if bucket_idx < 0
        bucket_idx = 0
    let k = str(bucket_idx)
    h["buckets"][k] += 1
    h

fn hist_count(h: dict) -> int
    h["total"]

fn hist_sum(h: dict) -> int
    h["sum"]

fn hist_mean(h: dict) -> int
    if h["total"] == 0
        return 0
    h["sum"] / h["total"]

fn hist_min(h: dict) -> int
    if h["total"] == 0
        return 0
    h["min_val"]

fn hist_max(h: dict) -> int
    h["max_val"]

fn hist_bucket_value(h: dict, bucket_idx: int) -> int
    if bucket_idx < 0
        return 0
    if bucket_idx >= h["bucket_count"]
        return 0
    h["buckets"][str(bucket_idx)]

fn hist_percentile(h: dict, pct: int) -> int
    if h["total"] == 0
        return 0
    let target = h["total"] * pct / 100
    if target == 0
        target = 1
    let running = 0
    for i in 0..h["bucket_count"]
        running += h["buckets"][str(i)]
        if running >= target
            return (i + 1) * h["bucket_width"]
    h["bucket_count"] * h["bucket_width"]
