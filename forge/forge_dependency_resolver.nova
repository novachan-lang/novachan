// forge_dependency_resolver — Resolve package/module dependencies.

fn dr_new() -> dict
    let d = {}
    d["pkgs"] = {}
    d["deps"] = {}
    d["dep_count"] = 0
    d["pkg_count"] = 0
    d

fn dr_add_package(d: dict, name: string, version: int) -> dict
    d["pkgs"][name] = version
    d["pkg_count"] = d["pkg_count"] + 1
    d

fn dr_add_dependency(d: dict, pkg: string, depends_on: string) -> dict
    let k = str(d["dep_count"])
    d["deps"][k + "_pkg"] = pkg
    d["deps"][k + "_dep"] = depends_on
    d["dep_count"] = d["dep_count"] + 1
    d

fn dr_dep_count_for(d: dict, pkg: string) -> int
    let count = 0
    let i = 0
    while i < d["dep_count"]
        if d["deps"][str(i) + "_pkg"] == pkg
            count += 1
        i += 1
    count

fn dr_is_satisfied(d: dict, pkg: string) -> int
    let i = 0
    while i < d["dep_count"]
        let k = str(i)
        if d["deps"][k + "_pkg"] == pkg
            let dep = d["deps"][k + "_dep"]
            let has = contains(d["pkgs"], dep)
            if has != true
                return 0
        i += 1
    1

fn dr_missing_deps(d: dict, pkg: string) -> int
    let count = 0
    let i = 0
    while i < d["dep_count"]
        let k = str(i)
        if d["deps"][k + "_pkg"] == pkg
            let dep = d["deps"][k + "_dep"]
            let has = contains(d["pkgs"], dep)
            if has != true
                count += 1
        i += 1
    count

fn dr_reverse_deps(d: dict, pkg: string) -> int
    let count = 0
    let i = 0
    while i < d["dep_count"]
        if d["deps"][str(i) + "_dep"] == pkg
            count += 1
        i += 1
    count

fn dr_total_packages(d: dict) -> int
    d["pkg_count"]
