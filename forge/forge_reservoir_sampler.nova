// forge_reservoir_sampler — reservoir sampling with Result API.

fn rs_new(size: int) -> dict
    let r = {}
    r["size"] = size
    r["samples"] = {}
    r["count"] = 0
    r["total_seen"] = 0
    r

fn rs_add(r: dict, value: string) -> dict
    r["total_seen"] = r["total_seen"] + 1
    if r["count"] < r["size"]
        let key = "s_" + str(r["count"])
        r["samples"][key] = value
        r["count"] = r["count"] + 1
        return r
    let hv = hash(value)
    if hv < 0
        hv = 0 - hv
    let j = hv % r["total_seen"]
    if j < r["size"]
        let key = "s_" + str(j)
        r["samples"][key] = value
    r

fn rs_get(r: dict, idx: int) -> Result
    if idx < 0 or idx >= r["count"]
        return err("index out of range")
    let key = "s_" + str(idx)
    ok(r["samples"][key])

fn rs_count(r: dict) -> int
    r["count"]

fn rs_total_seen(r: dict) -> int
    r["total_seen"]

fn rs_is_full(r: dict) -> int
    if r["count"] >= r["size"]
        return 1
    0
