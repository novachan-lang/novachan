// forge_idgen — ID generation strategies.
// Sequential, prefixed, composite, and format-based ID generators.

fn idg_sequential(prefix: string, counter: int) -> dict
    let g = {}
    g["type"] = "sequential"
    g["prefix"] = prefix
    g["counter"] = counter
    g

fn idg_next(g: dict) -> dict
    let id = g["prefix"] + str(g["counter"])
    g["counter"] = g["counter"] + 1
    let r = {}
    r["gen"] = g
    r["id"] = id
    r

fn idg_next_n(g: dict, n: int) -> dict
    let ids = []
    let i = 0
    while i < n
        let id = g["prefix"] + str(g["counter"])
        g["counter"] = g["counter"] + 1
        push(ids, id)
        i = i + 1
    let r = {}
    r["gen"] = g
    r["ids"] = ids
    r

fn idg_current(g: dict) -> int
    g["counter"]

fn idg_composite(parts: list, sep: string) -> string
    let result = ""
    let i = 0
    while i < len(parts)
        if i > 0
            result = result + sep
        result = result + str(parts[i])
        i = i + 1
    result

fn idg_padded(prefix: string, num: int, width: int) -> string
    let s = str(num)
    let pad = ""
    while len(pad) + len(s) < width
        pad = pad + "0"
    prefix + pad + s

fn idg_from_parts(parts: list) -> string
    let result = ""
    let i = 0
    while i < len(parts)
        result = result + str(parts[i])
        i = i + 1
    result

fn idg_with_timestamp(prefix: string, ts: int, seq: int) -> string
    prefix + str(ts) + "-" + str(seq)

fn idg_validate_format(id: string, prefix: string) -> int
    if len(id) <= len(prefix)
        return 0
    let i = 0
    while i < len(prefix)
        if id[i] != prefix[i]
            return 0
        i = i + 1
    1
