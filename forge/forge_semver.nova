// forge_semver — semantic versioning with Result API.

fn sv_new(major: int, minor: int, patch: int) -> dict
    {"major": major, "minor": minor, "patch": patch}

fn sv_major(v: dict) -> int
    v["major"]

fn sv_minor(v: dict) -> int
    v["minor"]

fn sv_patch(v: dict) -> int
    v["patch"]

fn sv_bump_major(v: dict) -> dict
    v["major"] += 1
    v["minor"] = 0
    v["patch"] = 0
    v

fn sv_bump_minor(v: dict) -> dict
    v["minor"] += 1
    v["patch"] = 0
    v

fn sv_bump_patch(v: dict) -> dict
    v["patch"] += 1
    v

fn sv_to_string(v: dict) -> string
    let mj = v["major"]
    let mn = v["minor"]
    let pt = v["patch"]
    "{mj}.{mn}.{pt}"

fn sv_compare(a: dict, b: dict) -> int
    if a["major"] != b["major"]
        return 1 if a["major"] > b["major"] else -1
    if a["minor"] != b["minor"]
        return 1 if a["minor"] > b["minor"] else -1
    if a["patch"] != b["patch"]
        return 1 if a["patch"] > b["patch"] else -1
    0

fn sv_is_compatible(a: dict, b: dict) -> int
    1 if a["major"] == b["major"] else 0
