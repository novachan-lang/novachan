// forge_semver -- semantic-version parse/compare (npm `semver` / Cargo semver). LEAF -- imports NOTHING.
//
// semver_parse("1.2.3")        -> [1, 2, 3, ""]
// semver_parse("v1.2.3-beta.1") -> [1, 2, 3, "beta.1"]   (leading 'v' stripped)
// semver_parse("1.2.3+build.7") -> [1, 2, 3, ""]          (build metadata after '+' ignored)
// semver_cmp("1.0.0-beta", "1.0.0") -> -1   (a prerelease is LOWER than the release)
// semver_satisfies("1.2.5", "^1.2.3") -> true;  semver_satisfies("2.0.0", "^1.2.3") -> false
//
// Built-ins used: split, parse_int, slice, find, len, starts_with, str, char_at.
// Strings support == != < > (used for lexical prerelease-segment comparison).

// ── private helpers ─────────────────────────────────────────────────────────────────────────────────

// _is_num: true iff s is non-empty and every character is a digit 0-9.
fn _is_num(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let i = 0
    while i < n
        if find("0123456789", char_at(s, i)) < 0
            return false
        i = i + 1
    true

// _pre_cmp: compare two prerelease strings (each may be "") per semver §11.
// Empty prerelease ("") means "no prerelease" and RANKS HIGHER than any non-empty prerelease.
// Both non-empty: split on '.' and compare segment-by-segment --
//   numeric vs numeric  -> compare numerically
//   string  vs string   -> compare lexically (ASCII via string < / >)
//   numeric vs string   -> numeric is LOWER
// If all shared segments are equal, the version with MORE segments is higher.
fn _pre_cmp(pa: string, pb: string) -> int
    if pa == pb
        return 0
    if pa == ""
        return 1
    if pb == ""
        return -1
    let sa = split(pa, ".")
    let sb = split(pb, ".")
    let na = len(sa)
    let nb = len(sb)
    let shared = na
    if nb < shared
        shared = nb
    let i = 0
    while i < shared
        let x = sa[i]
        let y = sb[i]
        if x != y
            let xn = _is_num(x)
            let yn = _is_num(y)
            if xn and yn
                let ix = parse_int(x)
                let iy = parse_int(y)
                if ix < iy
                    return -1
                return 1
            if xn
                return -1
            if yn
                return 1
            if x < y
                return -1
            return 1
        i = i + 1
    if na < nb
        return -1
    if na > nb
        return 1
    0

// ── public API ──────────────────────────────────────────────────────────────────────────────────────

// semver_parse: "1.2.3" / "v1.2.3" / "1.2.3-beta.1" / "1.2.3-rc.1+build.9" -> [maj, min, pat, pre].
// Steps: drop build metadata after '+'; strip an optional leading 'v'; split the prerelease after '-';
// split the core on '.' (missing minor/patch default to 0).
fn semver_parse(v: string) -> list
    let s = v
    // Drop build metadata: everything from the first '+' onward is ignored.
    let plus = find(s, "+")
    if plus >= 0
        s = slice(s, 0, plus)
    // Strip an optional leading 'v'.
    if starts_with(s, "v")
        s = slice(s, 1, len(s))
    // Split off the prerelease (everything after the first '-').
    let pre = ""
    let dash = find(s, "-")
    if dash >= 0
        pre = slice(s, dash + 1, len(s))
        s = slice(s, 0, dash)
    // Parse the numeric core, defaulting missing parts to 0.
    let parts = split(s, ".")
    let np = len(parts)
    let maj = 0
    let min = 0
    let pat = 0
    if np > 0 and len(parts[0]) > 0
        maj = parse_int(parts[0])
    if np > 1 and len(parts[1]) > 0
        min = parse_int(parts[1])
    if np > 2 and len(parts[2]) > 0
        pat = parse_int(parts[2])
    let out = []
    push(out, maj)
    push(out, min)
    push(out, pat)
    push(out, pre)
    out

// semver_cmp: -1 / 0 / 1. Compare major, minor, patch numerically; then break ties by prerelease
// (a version WITH a prerelease is lower than the same version WITHOUT one -- see _pre_cmp).
fn semver_cmp(a: string, b: string) -> int
    let pa = semver_parse(a)
    let pb = semver_parse(b)
    let amaj = pa[0]
    let bmaj = pb[0]
    if amaj < bmaj
        return -1
    if amaj > bmaj
        return 1
    let amin = pa[1]
    let bmin = pb[1]
    if amin < bmin
        return -1
    if amin > bmin
        return 1
    let apat = pa[2]
    let bpat = pb[2]
    if apat < bpat
        return -1
    if apat > bpat
        return 1
    _pre_cmp(pa[3], pb[3])

// semver_eq / semver_gt / semver_lt: convenience comparators over semver_cmp.
fn semver_eq(a: string, b: string) -> bool
    semver_cmp(a, b) == 0

fn semver_gt(a: string, b: string) -> bool
    semver_cmp(a, b) > 0

fn semver_lt(a: string, b: string) -> bool
    semver_cmp(a, b) < 0

// semver_satisfies: does version v satisfy a range?
//   "1.2.3"    -- exact match (==)
//   ">=1.2.3"  -- v >= 1.2.3
//   "^1.2.3"   -- v >= 1.2.3 AND v < (MAJOR+1).0.0
//   "~1.2.3"   -- v >= 1.2.3 AND v < MAJOR.(MINOR+1).0
fn semver_satisfies(v: string, range: string) -> bool
    let r = trim(range)
    if starts_with(r, ">=")
        let base = trim(slice(r, 2, len(r)))
        return semver_cmp(v, base) >= 0
    if starts_with(r, "^")
        let base = trim(slice(r, 1, len(r)))
        let p = semver_parse(base)
        let upper = str(p[0] + 1) + ".0.0"
        if semver_cmp(v, base) < 0
            return false
        return semver_cmp(v, upper) < 0
    if starts_with(r, "~")
        let base = trim(slice(r, 1, len(r)))
        let p = semver_parse(base)
        let upper = str(p[0]) + "." + str(p[1] + 1) + ".0"
        if semver_cmp(v, base) < 0
            return false
        return semver_cmp(v, upper) < 0
    semver_cmp(v, r) == 0
