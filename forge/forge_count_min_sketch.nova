// forge_count_min_sketch — frequency estimation with Result API.

fn cms_new(width: int, depth: int) -> dict
    let c = {}
    c["width"] = width
    c["depth"] = depth
    c["counters"] = {}
    c["total"] = 0
    c

fn cms_hash(key: string, seed: int, width: int) -> int
    let h = hash(key) + seed * 6271
    let result = h % width
    if result < 0
        result = 0 - result
    result

fn cms_add(c: dict, key: string, count: int) -> dict
    let d = 0
    while d < c["depth"]
        let h = cms_hash(key, d * 11 + 3, c["width"])
        let ck = "c_" + str(d) + "_" + str(h)
        let has = contains(c["counters"], ck)
        if has == true
            c["counters"][ck] = c["counters"][ck] + count
        else
            c["counters"][ck] = count
        d += 1
    c["total"] = c["total"] + count
    c

fn cms_estimate(c: dict, key: string) -> int
    let min_val = 999999999
    let d = 0
    while d < c["depth"]
        let h = cms_hash(key, d * 11 + 3, c["width"])
        let ck = "c_" + str(d) + "_" + str(h)
        let has = contains(c["counters"], ck)
        if has == true
            if c["counters"][ck] < min_val
                min_val = c["counters"][ck]
        else
            return 0
        d += 1
    min_val

fn cms_total(c: dict) -> int
    c["total"]
