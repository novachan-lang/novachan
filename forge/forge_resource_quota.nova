// forge_resource_quota — Resource quota management with usage tracking.

fn rq_new() -> dict
    let r = {}
    r["quotas"] = {}
    r["usage"] = {}
    r

fn rq_set_quota(r: dict, resource: string, limit: int) -> dict
    r["quotas"][resource] = limit
    let has = contains(r["usage"], resource)
    if has != true
        r["usage"][resource] = 0
    r

fn rq_consume(r: dict, resource: string, amount: int) -> dict
    let result = {}
    let has_q = contains(r["quotas"], resource)
    if has_q != true
        result["ok"] = 0
        result["reason"] = "no_quota"
        result["r"] = r
        return result
    let used = r["usage"][resource]
    let limit = r["quotas"][resource]
    if used + amount > limit
        result["ok"] = 0
        result["reason"] = "exceeded"
        result["r"] = r
        return result
    r["usage"][resource] = used + amount
    result["ok"] = 1
    result["reason"] = ""
    result["r"] = r
    result

fn rq_release(r: dict, resource: string, amount: int) -> dict
    let has = contains(r["usage"], resource)
    if has == true
        r["usage"][resource] = r["usage"][resource] - amount
        if r["usage"][resource] < 0
            r["usage"][resource] = 0
    r

fn rq_usage(r: dict, resource: string) -> int
    let has = contains(r["usage"], resource)
    if has != true
        return 0
    r["usage"][resource]

fn rq_remaining(r: dict, resource: string) -> int
    let has_q = contains(r["quotas"], resource)
    if has_q != true
        return 0
    r["quotas"][resource] - r["usage"][resource]

fn rq_utilization(r: dict, resource: string) -> int
    let has_q = contains(r["quotas"], resource)
    if has_q != true
        return 0
    if r["quotas"][resource] == 0
        return 0
    r["usage"][resource] * 100 / r["quotas"][resource]
