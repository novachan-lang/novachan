// forge_correlation_id — request correlation ID tracking with Result API.

fn cid_new() -> dict
    let c = {}
    c["next_id"] = 1000
    c["active_count"] = 0
    c["total_issued"] = 0
    c

fn cid_issue(c: dict, context: string) -> dict
    let cid = c["next_id"]
    c["cid_" + str(cid) + "_ctx"] = context
    c["cid_" + str(cid) + "_active"] = 1
    c["next_id"] = cid + 1
    c["active_count"] = c["active_count"] + 1
    c["total_issued"] = c["total_issued"] + 1
    c

fn cid_latest_id(c: dict) -> Result
    if c["total_issued"] == 0
        return err("no IDs issued")
    ok(c["next_id"] - 1)

fn cid_context(c: dict, cid: int) -> Result
    let ck = "cid_" + str(cid) + "_ctx"
    if ck not in c
        return err("correlation ID not found")
    ok(c[ck])

fn cid_complete(c: dict, cid: int) -> Result
    let ak = "cid_" + str(cid) + "_active"
    if ak not in c
        return err("correlation ID not found")
    if c[ak] != 1
        return err("already completed")
    c[ak] = 0
    c["active_count"] = c["active_count"] - 1
    ok(c)

fn cid_is_active(c: dict, cid: int) -> int
    let ak = "cid_" + str(cid) + "_active"
    if ak in c
        if c[ak] == 1
            return 1
    0

fn cid_active_count(c: dict) -> int
    c["active_count"]

fn cid_total_issued(c: dict) -> int
    c["total_issued"]
