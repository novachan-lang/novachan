// forge_event_bus — Distributed event bus (Mesh).
// Named topics, per-topic subscriber sets, publish/unsubscribe with a
// Result API, and running counters for message accounting.

fn eb_new() -> dict
    let s = {}
    s["topics"] = {}
    s["subscribers"] = {}
    s["msg_counts"] = {}
    s["total_messages"] = 0
    s

fn eb_create_topic(s: dict, topic_name: string) -> dict
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has != true
        s["topics"][key] = 1
        s["subscribers"][key] = []
        s["msg_counts"][key] = 0
    s

fn eb_has_topic(s: dict, topic_name: string) -> int
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has == true
        return 1
    0

fn eb_subscribe(s: dict, topic_name: string, subscriber_id: string) -> Result
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has != true
        return err("topic not found: " + topic_name)
    let subs = s["subscribers"][key]
    for i in 0..len(subs)
        if subs[i] == subscriber_id
            return err("already subscribed: " + subscriber_id)
    push(s["subscribers"][key], subscriber_id)
    ok(s)

fn eb_unsubscribe(s: dict, topic_name: string, subscriber_id: string) -> Result
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has != true
        return err("topic not found: " + topic_name)
    let removed = remove(s["subscribers"][key], subscriber_id)
    if removed == 0
        return err("not subscribed: " + subscriber_id)
    ok(s)

fn eb_publish(s: dict, topic_name: string, message: string) -> Result
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has != true
        return err("topic not found: " + topic_name)
    s["msg_counts"][key] = s["msg_counts"][key] + 1
    s["total_messages"] = s["total_messages"] + 1
    ok(s)

fn eb_topic_count(s: dict) -> int
    len(keys(s["topics"]))

fn eb_subscriber_count(s: dict, topic_name: string) -> Result
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has != true
        return err("topic not found: " + topic_name)
    ok(len(s["subscribers"][key]))

fn eb_message_count(s: dict, topic_name: string) -> Result
    let key = "t_" + topic_name
    let has = contains(s["topics"], key)
    if has != true
        return err("topic not found: " + topic_name)
    ok(s["msg_counts"][key])

fn eb_total_messages(s: dict) -> int
    s["total_messages"]
