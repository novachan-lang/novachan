// forge_countmin -- a Count-Min Sketch: estimate how many times each item has been seen using FIXED memory,
// no matter how many distinct items stream through. Where forge_counter stores an exact count per key (memory
// grows with distinct keys), a Count-Min Sketch uses width*depth counters and hashes each item into one bucket
// per row; the estimate is the MIN across rows. It never UNDER-counts (collisions only inflate), so it is the
// right tool for heavy-hitters, trending topics, and per-key rate limiting at a scale where exact counts won't
// fit. Layout: a flat list [width, depth, cell0, cell1, ...]. LEAF -- imports NOTHING.

// PRIVATE: FNV-1a-style hash of an ASCII string into [0, width), differentiated by `seed` (one per row).
fn _cms_hash(s: string, seed: int, width: int) -> int
    let mask = 4294967295
    let h = (2166136261 ^ (seed * 2654435761)) & mask
    let i = 0
    while i < len(s)
        h = h ^ ord(char_at(s, i))
        h = (h * 16777619) & mask
        i = i + 1
    h % width

// A new sketch with `width` buckets per row and `depth` rows (more depth -> fewer over-counts).
fn cms_new(width: int, depth: int) -> list
    let cms = [width, depth]
    let i = 0
    while i < width * depth
        push(cms, 0)
        i = i + 1
    cms

// Add `count` occurrences of `item`.
fn cms_add(cms: list, item: string, count: int) -> list
    let width = cms[0]
    let depth = cms[1]
    let r = 0
    while r < depth
        let col = _cms_hash(item, r, width)
        let idx = 2 + r * width + col
        cms[idx] = cms[idx] + count
        r = r + 1
    cms

// Estimated count of `item` (the min across rows -- never less than the true count).
fn cms_estimate(cms: list, item: string) -> int
    let width = cms[0]
    let depth = cms[1]
    let est = 1000000000
    let r = 0
    while r < depth
        let col = _cms_hash(item, r, width)
        let idx = 2 + r * width + col
        if cms[idx] < est
            est = cms[idx]
        r = r + 1
    est
