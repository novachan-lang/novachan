// forge_countmin -- thin wrapper over std/sketch/countmin (canonical implementation).
import std/sketch/countmin

fn cms_new(width: int, depth: int) -> list
    return cm_new(width, depth)

fn cms_add(cms: list, item: string, count: int) -> list
    return cm_add(cms, item, count)

fn cms_estimate(cms: list, item: string) -> int
    return cm_estimate(cms, item)

