// forge_pagination -- pagination METADATA + page-window helpers (Spring Data Page/Pageable, Django
// Paginator, Rails kaminari). Integer math only. LEAF -- imports NOTHING.

fn _max(a: int, b: int) -> int
    if a > b
        return a
    b

fn _min(a: int, b: int) -> int
    if a < b
        return a
    b

// 0-based row offset for a 1-based page number. Page clamped to >= 1. offset = (page-1)*per_page.
fn page_offset(page: int, per_page: int) -> int
    let p = _max(page, 1)
    (p - 1) * per_page

// ceil(total/per_page) via integer math. Returns 0 when per_page <= 0 or total is 0.
fn page_total_pages(total: int, per_page: int) -> int
    if per_page <= 0
        return 0
    if total <= 0
        return 0
    (total + per_page - 1) / per_page

// Full metadata dict for a page: total/page/per_page/total_pages/offset/has_prev/has_next/from/to.
fn page_meta(total: int, page: int, per_page: int) -> dict
    let total_pages = page_total_pages(total, per_page)
    let p = _min(_max(page, 1), _max(total_pages, 1))
    let offset = page_offset(p, per_page)
    let count = 0
    if total_pages > 0
        count = _min(per_page, total - offset)
    let from = 0
    let to = 0
    if count > 0
        from = offset + 1
        to = _min(offset + count, total)
    let m = {}
    m["total"] = total
    m["page"] = p
    m["per_page"] = per_page
    m["total_pages"] = total_pages
    m["offset"] = offset
    m["has_prev"] = p > 1
    m["has_next"] = p < total_pages
    m["from"] = from
    m["to"] = to
    m

// A window of up to `width` page numbers centered on `page`, clamped to [1, total_pages], shifting near
// edges to stay in range. Returns [1..total_pages] when total_pages <= width.
fn page_window(page: int, total_pages: int, width: int) -> list
    let out = []
    if total_pages <= 0
        return out
    if width <= 0
        return out
    let start = 1
    let last = total_pages
    if total_pages > width
        let half = width / 2
        start = _max(page - half, 1)
        last = start + width - 1
        if last > total_pages
            last = total_pages
            start = total_pages - width + 1
    let i = start
    while i <= last
        push(out, i)
        i = i + 1
    out
