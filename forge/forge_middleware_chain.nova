// forge_middleware_chain — ordered middleware pipeline with Result API.

fn mc_new() -> dict
    let m = {}
    m["chain"] = {}
    m["enabled"] = {}
    m["count"] = 0
    m["total_runs"] = 0
    m

fn mc_add(m: dict, name: string, priority: int) -> dict
    let ck = "c_" + str(m["count"])
    m["chain"][ck] = name
    let pk = "p_" + str(m["count"])
    m["chain"][pk] = priority
    let ek = "e_" + name
    m["enabled"][ek] = 1
    m["count"] = m["count"] + 1
    m

fn mc_disable(m: dict, name: string) -> Result
    let ek = "e_" + name
    if contains(m["enabled"], ek) != true
        return err("middleware not found")
    m["enabled"][ek] = 0
    ok(m)

fn mc_enable(m: dict, name: string) -> Result
    let ek = "e_" + name
    if contains(m["enabled"], ek) != true
        return err("middleware not found")
    m["enabled"][ek] = 1
    ok(m)

fn mc_is_enabled(m: dict, name: string) -> int
    let ek = "e_" + name
    if contains(m["enabled"], ek) == true
        return m["enabled"][ek]
    0

fn mc_run(m: dict) -> int
    let active = 0
    let i = 0
    while i < m["count"]
        let ck = "c_" + str(i)
        let name = m["chain"][ck]
        let ek = "e_" + name
        if m["enabled"][ek] == 1
            active = active + 1
        i = i + 1
    m["total_runs"] = m["total_runs"] + 1
    active

fn mc_count(m: dict) -> int
    m["count"]

fn mc_total_runs(m: dict) -> int
    m["total_runs"]
