// forge_pid -- a PID (proportional-integral-derivative) controller: the workhorse feedback loop of control
// systems, robotics, motor/thermostat/drone control, and any "drive a measured value to a setpoint" task
// (NOVA's embedded/edge story). Given the error (setpoint - measured) each tick, it outputs a correction that
// blends the present error (P), accumulated past error (I), and the rate of change (D). State (integral,
// previous error) lives in the controller list and is updated in place across ticks. LEAF -- imports NOTHING.
//
// A controller is the list [kp, ki, kd, integral, prev_error]; the last two are the running state. The output
// is bound to a `let` before return (sound near NOVA's float-return codegen edge).

// Create a controller with the three gains; integral and previous error start at 0.
fn pid_new(kp: float, ki: float, kd: float) -> list
    [kp, ki, kd, 0.0, 0.0]

// Advance one control step with the current `error` and timestep `dt`; returns the control output and updates
// the controller's integral + previous-error state in place.
fn pid_step(pid: list, error: float, dt: float) -> float
    let kp = pid[0]
    let ki = pid[1]
    let kd = pid[2]
    let integral = pid[3] + error * dt
    let derivative = (error - pid[4]) / dt
    pid[3] = integral
    pid[4] = error
    let p_term = kp * error
    let i_term = ki * integral
    let d_term = kd * derivative
    let output = p_term + i_term + d_term
    output

// Convenience: step from a setpoint and a measured value (error = setpoint - measured).
fn pid_control(pid: list, setpoint: float, measured: float, dt: float) -> float
    pid_step(pid, setpoint - measured, dt)

// Reset the running state (integral + previous error) to zero, keeping the gains.
fn pid_reset(pid: list) -> list
    pid[3] = 0.0
    pid[4] = 0.0
    pid
