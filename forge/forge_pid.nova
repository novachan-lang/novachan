// forge_pid -- thin wrapper over std/control/pid (canonical implementation).
import std/control/pid

fn pid_new(kp: float, ki: float, kd: float) -> list
    return pid_new(kp, ki, kd)

fn pid_step(pid: list, error: float, dt: float) -> float
    return pid_step(pid, error, dt)

fn pid_control(pid: list, setpoint: float, measured: float, dt: float) -> float
    pid_step(pid, setpoint - measured, dt)

// Reset the running state (integral + previous error) to zero, keeping the gains.

fn pid_reset(pid: list) -> list
    return pid_reset(pid)

