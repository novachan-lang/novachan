// forge_data_validator — data quality validation rules (required/min/max/pattern/enum).
//
// NOTE: forge_domain_validator.nova already ships a `dv_*` API for a different purpose
// (validating domain-name strings). To avoid a function-name collision in the flat
// module namespace (dv_new/dv_validate/dv_pass_count/dv_fail_count would otherwise
// clash with different signatures), this module uses the `dqv_*` prefix (Data Quality
// Validator).
//
// Rule params are always passed as strings so one add_rule signature covers every
// rule type: "required" ignores param; "min"/"max" take a base-10 integer string
// threshold (values are parsed with parse_int); "pattern" takes a required substring
// (no regex engine in std — substring containment is the supported check); "enum"
// takes a "|"-separated list of allowed values (e.g. "red|green|blue").

fn dqv_new() -> dict
    let s = {}
    s["rules"] = {}
    s["rule_count"] = 0
    s["fields"] = {}
    s["field_count"] = 0
    s["pass_count"] = 0
    s["fail_count"] = 0
    s

fn dqv_add_rule(state: dict, field_name: string, rule_type: string, param: string) -> dict
    let idx = state["rule_count"]
    let k = "r" + str(idx)
    state["rules"][k + "_field"] = field_name
    state["rules"][k + "_type"] = rule_type
    state["rules"][k + "_param"] = param
    state["rule_count"] = idx + 1
    let has_field = contains(state["fields"], field_name)
    if has_field != true
        state["fields"][field_name] = 1
        state["field_count"] = state["field_count"] + 1
    state

fn _dqv_check_one(state: dict, field_name: string, value: string, idx: int) -> string
    let k = "r" + str(idx)
    if state["rules"][k + "_field"] != field_name
        return ""
    let rule_type = state["rules"][k + "_type"]
    let param = state["rules"][k + "_param"]
    if rule_type == "required"
        if value == ""
            return field_name + " is required"
        return ""
    if rule_type == "min"
        let n = parse_int(value)
        let m = parse_int(param)
        if n < m
            return field_name + " is below minimum"
        return ""
    if rule_type == "max"
        let n = parse_int(value)
        let m = parse_int(param)
        if n > m
            return field_name + " is above maximum"
        return ""
    if rule_type == "pattern"
        let has = contains(value, param)
        if has != true
            return field_name + " does not match pattern"
        return ""
    if rule_type == "enum"
        let opts = split(param, "|")
        let allowed = contains(opts, value)
        if allowed != true
            return field_name + " is not an allowed value"
        return ""
    ""

fn dqv_validate(state: dict, field_name: string, value: string) -> Result
    let n = state["rule_count"]
    let i = 0
    let failure = ""
    while i < n
        if failure == ""
            let msg = _dqv_check_one(state, field_name, value, i)
            if msg != ""
                failure = msg
        i += 1
    if failure != ""
        state["fail_count"] = state["fail_count"] + 1
        return err(failure)
    state["pass_count"] = state["pass_count"] + 1
    ok("valid")

fn dqv_validate_all(state: dict, field_values_csv: string) -> Result
    let pairs = split(field_values_csv, ",")
    let n = len(pairs)
    let i = 0
    let first_error = ""
    while i < n
        let kv = split(pairs[i], "=")
        if len(kv) >= 2
            let field_name = kv[0]
            let value = kv[1]
            let r = dqv_validate(state, field_name, value)
            if is_err(r)
                if first_error == ""
                    first_error = unwrap_err(r)
        i += 1
    if first_error != ""
        return err(first_error)
    ok("valid")

fn dqv_rule_count(state: dict) -> int
    state["rule_count"]

fn dqv_field_count(state: dict) -> int
    state["field_count"]

fn dqv_pass_count(state: dict) -> int
    state["pass_count"]

fn dqv_fail_count(state: dict) -> int
    state["fail_count"]

fn dqv_pass_rate(state: dict) -> Result
    let total = state["pass_count"] + state["fail_count"]
    if total == 0
        return err("no validations recorded yet")
    ok(state["pass_count"] * 100 / total)
