// forge_tensor — Basic CPU tensor operations (1D/2D), pure-NOVA.
// Values stored as a flat comma-separated string (row-major layout).

fn tn_new(rows: int, cols: int) -> dict
    let n = rows * cols
    let vals = ["0" for i in 0..n]
    {"rows": rows, "cols": cols, "data": join(vals, ",")}

fn tn_set(state: dict, row: int, col: int, value: int) -> Result
    if row < 0
        return err("row out of bounds: {row}")
    if row >= state["rows"]
        return err("row out of bounds: {row}")
    if col < 0
        return err("col out of bounds: {col}")
    if col >= state["cols"]
        return err("col out of bounds: {col}")
    let idx = row * state["cols"] + col
    let vals = split(state["data"], ",")
    let rv = [str(value) if i == idx else vals[i] for i in 0..len(vals)]
    state["data"] = join(rv, ",")
    ok(value)

fn tn_get(state: dict, row: int, col: int) -> Result
    if row < 0
        return err("row out of bounds: {row}")
    if row >= state["rows"]
        return err("row out of bounds: {row}")
    if col < 0
        return err("col out of bounds: {col}")
    if col >= state["cols"]
        return err("col out of bounds: {col}")
    let idx = row * state["cols"] + col
    let vals = split(state["data"], ",")
    ok(int(vals[idx]))

fn tn_rows(state: dict) -> int
    state["rows"]

fn tn_cols(state: dict) -> int
    state["cols"]

fn tn_size(state: dict) -> int
    state["rows"] * state["cols"]

fn tn_add(a: dict, b: dict) -> Result
    if a["rows"] != b["rows"]
        return err("shape mismatch")
    if a["cols"] != b["cols"]
        return err("shape mismatch")
    let result = tn_new(a["rows"], a["cols"])
    let av = split(a["data"], ",")
    let bv = split(b["data"], ",")
    let rv = [str(int(av[i]) + int(bv[i])) for i in 0..len(av)]
    result["data"] = join(rv, ",")
    ok(result)

fn tn_scale(state: dict, factor: int) -> dict
    let vals = split(state["data"], ",")
    let rv = [str(int(vals[i]) * factor) for i in 0..len(vals)]
    state["data"] = join(rv, ",")
    state

fn tn_sum(state: dict) -> int
    let vals = split(state["data"], ",")
    let total = 0
    for i in 0..len(vals)
        total += int(vals[i])
    total

fn tn_shape(state: dict) -> string
    let r = state["rows"]
    let c = state["cols"]
    "{r},{c}"
