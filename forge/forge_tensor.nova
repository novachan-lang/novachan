// forge_tensor — Basic CPU tensor operations (1D/2D), pure-NOVA.
// Values stored as a flat comma-separated string (row-major layout).

fn tn_new(rows: int, cols: int) -> dict
    let t = {}
    t["rows"] = rows
    t["cols"] = cols
    let n = rows * cols
    let vals = []
    let i = 0
    while i < n
        push(vals, "0")
        i = i + 1
    t["data"] = join(vals, ",")
    t

fn tn_set(state: dict, row: int, col: int, value: int) -> Result
    if row < 0
        return err("row out of bounds: " + str(row))
    if row >= state["rows"]
        return err("row out of bounds: " + str(row))
    if col < 0
        return err("col out of bounds: " + str(col))
    if col >= state["cols"]
        return err("col out of bounds: " + str(col))
    let idx = row * state["cols"] + col
    let vals = split(state["data"], ",")
    let rv = []
    let i = 0
    while i < len(vals)
        if i == idx
            push(rv, str(value))
        else
            push(rv, vals[i])
        i = i + 1
    state["data"] = join(rv, ",")
    ok(value)

fn tn_get(state: dict, row: int, col: int) -> Result
    if row < 0
        return err("row out of bounds: " + str(row))
    if row >= state["rows"]
        return err("row out of bounds: " + str(row))
    if col < 0
        return err("col out of bounds: " + str(col))
    if col >= state["cols"]
        return err("col out of bounds: " + str(col))
    let idx = row * state["cols"] + col
    let vals = split(state["data"], ",")
    ok(int(vals[idx]))

fn tn_rows(state: dict) -> int
    state["rows"]

fn tn_cols(state: dict) -> int
    state["cols"]

fn tn_size(state: dict) -> int
    state["rows"] * state["cols"]

fn tn_add(a: dict, b: dict) -> Result
    if a["rows"] != b["rows"]
        return err("shape mismatch")
    if a["cols"] != b["cols"]
        return err("shape mismatch")
    let result = tn_new(a["rows"], a["cols"])
    let av = split(a["data"], ",")
    let bv = split(b["data"], ",")
    let rv = []
    let i = 0
    while i < len(av)
        let sum = int(av[i]) + int(bv[i])
        push(rv, str(sum))
        i = i + 1
    result["data"] = join(rv, ",")
    ok(result)

fn tn_scale(state: dict, factor: int) -> dict
    let vals = split(state["data"], ",")
    let rv = []
    let i = 0
    while i < len(vals)
        push(rv, str(int(vals[i]) * factor))
        i = i + 1
    state["data"] = join(rv, ",")
    state

fn tn_sum(state: dict) -> int
    let vals = split(state["data"], ",")
    let total = 0
    let i = 0
    while i < len(vals)
        total = total + int(vals[i])
        i = i + 1
    total

fn tn_shape(state: dict) -> string
    str(state["rows"]) + "," + str(state["cols"])
