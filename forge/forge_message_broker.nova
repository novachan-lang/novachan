// forge_message_broker — message broker with queues and Result API.

fn mb_new() -> dict
    {"queues": {}, "queue_count": 0, "total_enqueued": 0, "total_dequeued": 0}

fn mb_create_queue(m: dict, name: string) -> Result
    let qk = "q_{name}"
    if qk in m["queues"]
        return err("queue exists: {name}")
    m["queues"][qk] = 1
    m["queues"]["{qk}_head"] = 0
    m["queues"]["{qk}_tail"] = 0
    m["queue_count"] += 1
    ok(m)

fn mb_enqueue(m: dict, queue: string, message: string) -> Result
    let qk = "q_{queue}"
    if qk not in m["queues"]
        return err("unknown queue: {queue}")
    let tail_key = "{qk}_tail"
    let tail = m["queues"][tail_key]
    let mk = "{qk}_msg_{tail}"
    m["queues"][mk] = message
    m["queues"][tail_key] = tail + 1
    m["total_enqueued"] += 1
    ok(m)

fn mb_dequeue(m: dict, queue: string) -> Result
    let qk = "q_{queue}"
    if qk not in m["queues"]
        return err("unknown queue: {queue}")
    let head_key = "{qk}_head"
    let tail_key = "{qk}_tail"
    let head = m["queues"][head_key]
    let tail = m["queues"][tail_key]
    if head >= tail
        return err("queue empty: {queue}")
    let mk = "{qk}_msg_{head}"
    let msg = m["queues"][mk]
    m["queues"][head_key] = head + 1
    m["total_dequeued"] += 1
    ok(msg)

fn mb_queue_size(m: dict, queue: string) -> int
    let qk = "q_{queue}"
    if qk not in m["queues"]
        return 0
    m["queues"]["{qk}_tail"] - m["queues"]["{qk}_head"]

fn mb_queue_count(m: dict) -> int
    m["queue_count"]

fn mb_total_enqueued(m: dict) -> int
    m["total_enqueued"]

fn mb_total_dequeued(m: dict) -> int
    m["total_dequeued"]
