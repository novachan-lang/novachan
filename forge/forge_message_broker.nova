// forge_message_broker — message broker with queues and Result API.

fn mb_new() -> dict
    let m = {}
    m["queues"] = {}
    m["queue_count"] = 0
    m["total_enqueued"] = 0
    m["total_dequeued"] = 0
    m

fn mb_create_queue(m: dict, name: string) -> Result
    let qk = "q_" + name
    let has = contains(m["queues"], qk)
    if has == true
        return err("queue exists: " + name)
    m["queues"][qk] = 1
    m["queues"][qk + "_head"] = 0
    m["queues"][qk + "_tail"] = 0
    m["queue_count"] = m["queue_count"] + 1
    ok(m)

fn mb_enqueue(m: dict, queue: string, message: string) -> Result
    let qk = "q_" + queue
    let has = contains(m["queues"], qk)
    if has != true
        return err("unknown queue: " + queue)
    let tail = m["queues"][qk + "_tail"]
    let mk = qk + "_msg_" + str(tail)
    m["queues"][mk] = message
    m["queues"][qk + "_tail"] = tail + 1
    m["total_enqueued"] = m["total_enqueued"] + 1
    ok(m)

fn mb_dequeue(m: dict, queue: string) -> Result
    let qk = "q_" + queue
    let has = contains(m["queues"], qk)
    if has != true
        return err("unknown queue: " + queue)
    let head = m["queues"][qk + "_head"]
    let tail = m["queues"][qk + "_tail"]
    if head >= tail
        return err("queue empty: " + queue)
    let mk = qk + "_msg_" + str(head)
    let msg = m["queues"][mk]
    m["queues"][qk + "_head"] = head + 1
    m["total_dequeued"] = m["total_dequeued"] + 1
    ok(msg)

fn mb_queue_size(m: dict, queue: string) -> int
    let qk = "q_" + queue
    let has = contains(m["queues"], qk)
    if has != true
        return 0
    m["queues"][qk + "_tail"] - m["queues"][qk + "_head"]

fn mb_queue_count(m: dict) -> int
    m["queue_count"]

fn mb_total_enqueued(m: dict) -> int
    m["total_enqueued"]

fn mb_total_dequeued(m: dict) -> int
    m["total_dequeued"]
