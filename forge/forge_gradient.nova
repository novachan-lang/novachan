// forge_gradient -- generate a color GRADIENT: a list of `steps` hex colors interpolating from start to end
// (data viz, heatmaps, progress bars, chart series, UI backgrounds). Composes forge_color_blend. Imports it.
import forge_color_blend

// `steps` colors from `start` to `end` inclusive. gradient("#000000","#ffffff",3) -> black, gray, white.
fn gradient(start: string, end: string, steps: int) -> list
    let out = []
    if steps <= 1
        push(out, start)
        return out
    let i = 0
    while i < steps
        push(out, color_blend(start, end, i * 100 / (steps - 1)))
        i = i + 1
    out

// Pick the gradient color for a value in [min,max] (heatmap lookup). value clamped.
fn gradient_at(start: string, end: string, value: int, min_v: int, max_v: int) -> string
    if max_v <= min_v
        return start
    let pct = (value - min_v) * 100 / (max_v - min_v)
    if pct < 0
        pct = 0
    if pct > 100
        pct = 100
    color_blend(start, end, pct)
