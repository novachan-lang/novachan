// forge_dist -- distribution protocol (the encode/decode + the fn-id registry behind remote_spawn). The
// KEY insight for cross-node spawn: functions can't serialize as closures, so they ship BY NAME -- each
// node registers its top-level fns under stable names, and remote_spawn sends a name + args; the remote
// node looks the name up in its registry and spawns it. This module is the pure, unit-testable protocol
// layer (registry + wire encode/decode via JSON). The LIVE 2-node link (real remote_spawn over a TCP
// link + cross-node monitor/DOWN) builds on the runtime remote_* primitives -- deferred (needs 2 nodes).

// fn-id registry: map a stable name -> a local function value.
fn dist_registry() -> any
    {}

fn dist_register(reg, name: string, f) -> any
    reg[name] = f
    reg

fn dist_lookup(reg, name: string) -> any
    reg[name]

// remote_spawn REQUEST wire form: {"op":"spawn","fn":<name>,"args":[...]} as JSON.
fn dist_encode_spawn(fn_name: string, args) -> string
    json_encode({"op": "spawn", "fn": fn_name, "args": args})

// -> [fn_name, args]
fn dist_decode_spawn(s: string) -> any
    let d = json_decode(s)
    [d["fn"], d["args"]]

// MESSAGE envelope to a remote pid: {"op":"msg","pid":<n>,"body":<v>} as JSON.
fn dist_encode_msg(pid, body) -> string
    json_encode({"op": "msg", "pid": pid, "body": body})

// -> [pid, body]
fn dist_decode_msg(s: string) -> any
    let d = json_decode(s)
    [d["pid"], d["body"]]
