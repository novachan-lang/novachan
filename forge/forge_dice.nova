// forge_dice -- parse and evaluate DICE NOTATION like "2d6+3", the compact language tabletop games, RPGs, and
// procedural systems use to describe a random amount: roll two six-sided dice and add three. It reads the count,
// die size, and flat modifier out of a spec string, tells you the possible range (min/max) and the expected
// average, and rolls it. Rolls go through the SEEDABLE generator (forge_prng), so the same spec and seed always
// produce the same result -- reproducible loot tables, deterministic combat replays, shareable procedural seeds --
// while different seeds vary. Handy for game logic, simulations, random stat/damage generation, and quick "roll a
// number in this shape" utilities. Supports "NdS", "dS" (count 1), and an optional "+M" or "-M" modifier.
// Imports forge_prng.

import forge_prng

// PRIVATE: parse a run of decimal digits to an int (0 for empty).
fn _di_int(s: string) -> int
    let v = 0
    for i in 0..len(s)
        v = v * 10 + (ord(char_at(s, i)) - 48)
    v

// Parse a dice spec into [count, sides, modifier]. "2d6+3" -> [2,6,3], "d20" -> [1,20,0], "3d8-2" -> [3,8,-2].
fn dice_parse(spec: string) -> list
    // locate 'd'
    let dpos = 0 - 1
    let i = 0
    while i < len(spec) and dpos < 0
        if char_at(spec, i) == "d"
            dpos = i
        i += 1
    let count = 1
    if dpos > 0
        count = _di_int(slice(spec, 0, dpos))
    // sides: digits after 'd' until +/-/end
    let j = dpos + 1
    let sides_str_parts = []
    while j < len(spec) and char_at(spec, j) != "+" and char_at(spec, j) != "-"
        push(sides_str_parts, char_at(spec, j))
        j += 1
    let sides_str = join(sides_str_parts, "")
    let sides = _di_int(sides_str)
    let modifier = 0
    if j < len(spec)
        let sign = char_at(spec, j)
        let m = _di_int(slice(spec, j + 1, len(spec)))
        if sign == "-"
            m = 0 - m
        modifier = m
    [count, sides, modifier]

// The minimum possible total for a spec (all dice show 1, plus the modifier).
fn dice_min(spec: string) -> int
    let d = dice_parse(spec)
    d[0] + d[2]

// The maximum possible total for a spec (all dice show their max face, plus the modifier).
fn dice_max(spec: string) -> int
    let d = dice_parse(spec)
    d[0] * d[1] + d[2]

// TWICE the expected (average) total, kept as an integer (each die averages (sides+1)/2). Divide by 2 for the
// mean; using 2x avoids fractions. For "2d6+3" this is 20 (mean 10).
fn dice_mean_x2(spec: string) -> int
    let d = dice_parse(spec)
    d[0] * (d[1] + 1) + 2 * d[2]

// Roll a spec deterministically from `seed`: the sum of `count` dice each uniform in [1, sides], plus the modifier.
// Same spec + seed always gives the same total.
fn dice_roll(spec: string, seed: int) -> int
    let d = dice_parse(spec)
    let rng = prng_new(seed)
    let total = d[2]
    let i = 0
    while i < d[0]
        total += prng_int(rng, 1, d[1])
        i += 1
    total
