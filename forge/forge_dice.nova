// forge_dice -- thin wrapper over std/random/dice (canonical implementation).
import std/random/dice

fn dice_parse(spec: string) -> list
    return dc_parse(spec)

fn dice_min(spec: string) -> int
    return dc_min(spec)

fn dice_max(spec: string) -> int
    return dc_max(spec)

fn dice_mean_x2(spec: string) -> int
    let d = dice_parse(spec)
    d[0] * (d[1] + 1) + 2 * d[2]

// Roll a spec deterministically from `seed`: the sum of `count` dice each uniform in [1, sides], plus the modifier.
// Same spec + seed always gives the same total.

fn dice_roll(spec: string, seed: int) -> int
    return dc_roll(spec, seed)

