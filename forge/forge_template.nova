// forge_template -- S17: a server-side template engine (Django-templates / Thymeleaf / ERB parity), the
// rendering depth FORGE_FEATURE_AUDIT §G flagged missing beyond raw HTML builders. Two core operations:
//   * template_render(source, ctx)  -- {{ key }} interpolation, AUTO-ESCAPED (XSS-safe by default).
//   * template_layout(layout, blocks) -- LAYOUT INHERITANCE: {{ blockname }} in a layout is replaced with a
//     block's already-rendered HTML (raw, since it's trusted rendered content) -> base-layout + page-body.
// Templates are runtime strings (loaded from a file / a string), so their { } braces are NOT NOVA string
// literals -- no interpolation-escaping trap. Control flow ({% for %}/{% if %}) is a documented follow-up;
// interpolation + layout composition are the 80% every server-rendered app needs.
//
// Imports forge_html for esc() (single-level; forge_html is a leaf).
import forge_html

// find `sub` in `s` starting at index `from`; -1 if absent.
fn _find_from(s: string, sub: string, from: int) -> int
    let rest = slice(s, from, len(s))
    let idx = find(rest, sub)
    if idx < 0
        return -1
    from + idx

// Scan `source` for {{ key }} spans, replacing each with values[key] (esc()'d when do_escape==1, else raw).
// Text outside {{ }} is copied verbatim. An unclosed {{ is emitted literally (lenient).
fn _template_scan(source: string, values: dict, do_escape: int) -> string
    let out_parts = []
    let i = 0
    let n = len(source)
    let op = chr(123) + chr(123)
    let cl = chr(125) + chr(125)
    while i < n
        let start = _find_from(source, op, i)
        if start < 0
            push(out_parts, slice(source, i, n))
            i = n
        else
            push(out_parts, slice(source, i, start))
            let vend = _find_from(source, cl, start + 2)
            if vend < 0
                push(out_parts, slice(source, start, n))
                i = n
            else
                let key = trim(slice(source, start + 2, vend))
                let val = ""
                if key in values
                    val = str(values[key])
                push(out_parts, esc(val) if do_escape == 1 else val)
                i = vend + 2
    let out = join(out_parts, "")
    out

// Render a template: {{ key }} -> HTML-escaped ctx[key] (a missing key -> ""). The safe default (auto-escape
// defeats XSS; a value with <script> renders inert).
fn template_render(source: string, ctx: dict) -> string
    _template_scan(source, ctx, 1)

// Compose a layout with named blocks: {{ blockname }} in `layout` -> blocks[blockname] RAW (trusted rendered
// HTML). Layout inheritance: base-layout with {{ title }} + {{ content }}, blocks = {title: "...", content:
// renderedPage}. Blocks are already-rendered fragments (escape their data with template_render first).
fn template_layout(layout: string, blocks: dict) -> string
    _template_scan(layout, blocks, 0)
