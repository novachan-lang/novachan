// forge_movingavg -- smoothing for a stream of numbers: the Simple Moving Average (mean of the last N values)
// and the Exponential Moving Average (a weighted mean that fades older values). Where forge_onlinestat keeps
// CUMULATIVE stats over everything seen, moving averages track a LOCAL trend -- the metric you actually plot on
// a dashboard, the smoothed sensor reading, the price line in a trading chart, the load figure a rate limiter
// reacts to. SMA holds a fixed window and updates in O(1) via a ring buffer + running sum (no re-summing the
// window); EMA holds a single number and needs no history at all. Both stream one value at a time. LEAF.

// ---- Simple Moving Average (window of the last N values) ----

// A new SMA over a window of `window` values. Representation: [window, ringbuf, sum, count, pos].
fn sma_new(window: int) -> list
    let buf = []
    let i = 0
    while i < window
        push(buf, 0.0)
        i = i + 1
    [window, buf, 0.0, 0, 0]

// Observe x; returns the current moving average (mean of the last <=window values). O(1).
fn sma_add(s: list, x) -> float
    let xf = x * 1.0
    let window = s[0]
    let buf = s[1]
    let pos = s[4]
    let old = buf[pos] * 1.0
    buf[pos] = xf
    s[2] = (s[2] * 1.0) - old + xf
    s[4] = (pos + 1) % window
    if s[3] < window
        s[3] = s[3] + 1
    let avg = 0.0
    let n = s[3]
    if n > 0
        avg = (s[2] * 1.0) / (n * 1.0)
    avg

// The current moving average without adding a value.
fn sma_value(s: list) -> float
    let avg = 0.0
    let n = s[3]
    if n > 0
        avg = (s[2] * 1.0) / (n * 1.0)
    avg

// Number of values currently in the window (<= window).
fn sma_count(s: list) -> int
    s[3]

// True once the window has filled.
fn sma_full(s: list) -> bool
    s[3] >= s[0]

// ---- Exponential Moving Average ----

// A new EMA with smoothing factor alpha in (0,1]: higher alpha = reacts faster / less smoothing.
// Representation: [alpha, value, initialized].
fn ema_new(alpha: float) -> list
    [alpha, 0.0, 0]

// A new EMA specified by a "span" of N periods (the common convention): alpha = 2 / (N + 1).
fn ema_new_span(span: int) -> list
    let a = 2.0 / ((span + 1) * 1.0)
    [a, 0.0, 0]

// Observe x; returns the updated EMA. The first value seeds the average. O(1).
fn ema_add(s: list, x) -> float
    let xf = x * 1.0
    if s[2] == 0
        s[1] = xf
        s[2] = 1
    else
        let a = s[0] * 1.0
        let prev = s[1] * 1.0
        let term1 = a * xf
        let term2 = (1.0 - a) * prev
        s[1] = term1 + term2
    let v = s[1] * 1.0
    v

// The current EMA without adding a value.
fn ema_value(s: list) -> float
    let v = s[1] * 1.0
    v
