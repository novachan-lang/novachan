// forge_poly -- work with polynomials represented as coefficient lists [a0, a1, a2, ...] meaning
// a0 + a1*x + a2*x^2 + .... Evaluate one at a point (Horner's method: fewest multiplications, numerically
// steady), add and multiply polynomials, and differentiate. Polynomials are everywhere once you look: curve and
// trend fitting, interpolation, the transfer functions of filters and control systems, computer-algebra and
// symbolic math, cheap approximations of expensive functions, and the CRC/error-coding view of bytes as
// polynomials. poly_eval takes/returns floats; the algebraic operations keep integer coefficients exact. LEAF.

// Evaluate the polynomial at x using Horner's method: (((a_n*x + a_{n-1})*x + ...)*x + a0).
fn poly_eval(coeffs: list, x) -> float
    let xf = x * 1.0
    let result = 0.0
    let i = len(coeffs) - 1
    while i >= 0
        result = result * xf + coeffs[i] * 1.0
        i -= 1
    result

// The highest power with a non-zero coefficient (a constant is degree 0; the zero polynomial is degree 0).
fn poly_degree(coeffs: list) -> int
    let deg = 0
    for i in 0..len(coeffs)
        if coeffs[i] != 0
            deg = i
    deg

// Sum of two polynomials (coefficient-wise, shorter one zero-padded).
fn poly_add(p: list, q: list) -> list
    let n = len(p)
    if len(q) > n
        n = len(q)
    let out = []
    for i in 0..n
        let a = 0
        if i < len(p)
            a = p[i]
        let b = 0
        if i < len(q)
            b = q[i]
        push(out, a + b)
    out

// Product of two polynomials (discrete convolution of the coefficients).
fn poly_mul(p: list, q: list) -> list
    let out = []
    if len(p) > 0 and len(q) > 0
        let n = len(p) + len(q) - 1
        for k in 0..n
            push(out, 0)
        let i = 0
        while i < len(p)
            for j in 0..len(q)
                out[i + j] = out[i + j] + p[i] * q[j]
            i += 1
    out

// The derivative polynomial: coefficient i becomes i * coefficient i, dropping the constant term.
fn poly_derivative(coeffs: list) -> list
    let out = []
    for i in 1..len(coeffs)
        push(out, i * coeffs[i])
    out

// Scale every coefficient by a constant.
fn poly_scale(coeffs: list, s) -> list
    let out = [coeffs[i] * s for i in 0..len(coeffs)]
    out
