// forge_multipart_build -- build a multipart/form-data request body (the OUTBOUND side of file upload, for an
// HTTP client posting to another service / a webhook with an attachment). Forge already PARSES inbound
// multipart; this composes one: text fields + file parts under a single boundary, returning the exact
// Content-Type (with the boundary) and the body so they always agree. CRLF line endings per RFC 7578.
// LEAF -- imports NOTHING (caller supplies a random boundary token, e.g. from forge_ulid / secure_bytes).

// PRIVATE: CRLF.
fn _mp_crlf() -> string
    chr(13) + chr(10)

// Build the body from a fields dict (name -> value text parts) and a files list (each [name, filename,
// content_type, content]). Returns [content_type_header, body]. Pass the SAME boundary you embed in neither --
// it's generated here from `boundary`.
fn multipart_build(boundary: string, fields: dict, files: list) -> list
    let crlf = _mp_crlf()
    let dash = "--"
    let body = ""
    let ks = keys(fields)
    for i in 0..len(ks)
        let k = ks[i]
        body += dash + boundary + crlf
        body += "Content-Disposition: form-data; name=" + chr(34) + k + chr(34) + crlf + crlf
        body += str(fields[k]) + crlf
    for f in 0..len(files)
        let part = files[f]
        body += dash + boundary + crlf
        body += "Content-Disposition: form-data; name=" + chr(34) + part[0] + chr(34)
        body += "; filename=" + chr(34) + part[1] + chr(34) + crlf
        body += "Content-Type: " + part[2] + crlf + crlf
        body += part[3] + crlf
    body += dash + boundary + dash + crlf
    let ct = "multipart/form-data; boundary=" + boundary
    [ct, body]
