// forge_egyptian -- write a fraction as a sum of distinct UNIT fractions (numerator 1), the way the ancient
// Egyptians recorded all fractions: 2/3 = 1/2 + 1/6, 3/4 = 1/2 + 1/4. The Fibonacci-Sylvester GREEDY algorithm does
// it mechanically: repeatedly subtract off the largest unit fraction that still fits (1/ceil(b/a)) and continue
// with what remains. Remarkably this always terminates -- each step strictly shrinks the numerator -- and yields
// strictly increasing, hence distinct, denominators. Egyptian fractions are a classic number-theory and
// recreational-math subject, a neat exact-rational exercise (no floating point, no repeating decimals), and a
// worked example of a greedy algorithm that is provably correct yet can produce surprisingly large denominators
// (the notorious 5/121 and 31/311 blow-ups). egyptian_fraction returns the list of denominators and
// egyptian_check verifies a decomposition sums exactly back to the original fraction using integer arithmetic only.
// Inputs are a proper positive fraction a/b (0 < a < b); denominators can grow quickly, so keep a/b modest to stay
// inside 64-bit. Pairs with forge_rational. LEAF -- imports NOTHING.

// PRIVATE: gcd (non-negative).
fn _eg_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

// Decompose the proper fraction a/b (with 0 < a < b) into a sum of distinct unit fractions, returned as the list of
// their denominators in increasing order. Returns an empty list if the fraction is not a proper positive fraction.
fn egyptian_fraction(a: int, b: int) -> list
    let out = []
    if a > 0 and b > 0 and a < b
        let num = a
        let den = b
        // reduce first
        let g0 = _eg_gcd(num, den)
        num = num / g0
        den = den / g0
        while num != 0
            // largest unit fraction 1/x that is <= num/den : x = ceil(den/num)
            let x = (den + num - 1) / num
            push(out, x)
            // num/den - 1/x = (num*x - den) / (den*x)
            let nn = num * x - den
            let dd = den * x
            let g = _eg_gcd(nn, dd)
            if g == 0
                num = 0
            else
                num = nn / g
                den = dd / g
    out

// True if the unit fractions 1/denoms[0] + 1/denoms[1] + ... sum EXACTLY to a/b. Uses integer fraction arithmetic
// (accumulate a running numerator/denominator, then cross-multiply) so there is no rounding.
fn egyptian_check(denoms: list, a: int, b: int) -> bool
    let snum = 0
    let sden = 1
    for i in 0..len(denoms)
        let d = denoms[i]
        // snum/sden + 1/d = (snum*d + sden) / (sden*d)
        snum = snum * d + sden
        sden = sden * d
        let g = _eg_gcd(snum, sden)
        if g > 0
            snum = snum / g
            sden = sden / g
    // snum/sden == a/b  <=>  snum*b == a*sden
    snum * b == a * sden

// True if every denominator in the list is distinct (the list is strictly increasing after the greedy build, so
// this also confirms distinctness). A small helper for validating decompositions.
fn all_distinct(denoms: list) -> bool
    let out = true
    for i in 0..len(denoms)
        let j = i + 1
        while j < len(denoms)
            if denoms[i] == denoms[j]
                out = false
            j += 1
    out
