// forge_egyptian -- thin wrapper over std/math/egyptian (canonical implementation).
import std/math/egyptian

fn _egyp_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

// Decompose the proper fraction a/b (with 0 < a < b) into a sum of distinct unit fractions, returned as the list of
// their denominators in increasing order. Returns an empty list if the fraction is not a proper positive fraction.

fn egyptian_fraction(a: int, b: int) -> list
    let out = []
    if a > 0 and a < b
        out = eg_decompose(a, b)
    out

fn egyptian_check(denoms: list, a: int, b: int) -> bool
    let snum = 0
    let sden = 1
    for i in 0..len(denoms)
        let d = denoms[i]
        // snum/sden + 1/d = (snum*d + sden) / (sden*d)
        snum = snum * d + sden
        sden = sden * d
        let g = _egyp_gcd(snum, sden)
        if g > 0
            snum = snum / g
            sden = sden / g
    // snum/sden == a/b  <=>  snum*b == a*sden
    snum * b == a * sden

// True if every denominator in the list is distinct (the list is strictly increasing after the greedy build, so
// this also confirms distinctness). A small helper for validating decompositions.

fn all_distinct(denoms: list) -> bool
    let out = true
    for i in 0..len(denoms)
        for j in (i + 1)..len(denoms)
            if denoms[i] == denoms[j]
                out = false
    out

