// forge_regexmatch -- a small but real regular-expression matcher supporting the four operators that cover most
// everyday pattern needs: '.' (any single character), '*' (zero or more of the preceding item), '+' (one or more),
// and '?' (zero or one). It answers "does this whole string match this pattern" -- the heart of grep-style
// filtering, input validation, routing/glob rules, and log matching -- without pulling in a full regex engine.
// The match is a clean recursive backtracker: at each step it decides whether the current pattern item consumes a
// character now and whether a quantifier should take more, exploring alternatives until one path consumes the
// entire input. '+' is desugared to "item item*" up front, so the core only has to reason about '*' and '?'. This
// is the classic textbook regex-matching problem, exact and allocation-light. (For literal wildcards like shell
// globs, see the glob utilities; this is the '.'/'*'/'+'/'?' dialect.) LEAF -- imports NOTHING.

// PRIVATE: rewrite each `X+` as `XX*` so the matcher only needs to handle `*` and `?`.
fn _rx_desugar(p: string) -> string
    let out_parts = []
    let i = 0
    let n = len(p)
    while i < n
        let c = char_at(p, i)
        if i + 1 < n and char_at(p, i + 1) == "+"
            push(out_parts, c + c + "*")
            i += 2
        else
            push(out_parts, c)
            i += 1
    let out = join(out_parts, "")
    out

// PRIVATE: does pattern p (from index pi) match text t (from index ti), consuming to the end? Returns 1/0.
fn _rx(t: string, ti: int, p: string, pi: int) -> int
    if pi == len(p)
        if ti == len(t)
            return 1
        return 0
    let first = 0
    if ti < len(t) and (char_at(p, pi) == "." or char_at(p, pi) == char_at(t, ti))
        first = 1
    if pi + 1 < len(p) and char_at(p, pi + 1) == "*"
        // zero occurrences, or consume one and stay on the same item
        if _rx(t, ti, p, pi + 2) == 1
            return 1
        if first == 1 and _rx(t, ti + 1, p, pi) == 1
            return 1
        return 0
    if pi + 1 < len(p) and char_at(p, pi + 1) == "?"
        // zero or one occurrence
        if _rx(t, ti, p, pi + 2) == 1
            return 1
        if first == 1 and _rx(t, ti + 1, p, pi + 2) == 1
            return 1
        return 0
    if first == 1 and _rx(t, ti + 1, p, pi + 1) == 1
        return 1
    return 0

// True if the ENTIRE string matches the pattern (operators: . * + ?).
fn is_match(text: string, pattern: string) -> bool
    let p = _rx_desugar(pattern)
    let out = false
    if _rx(text, 0, p, 0) == 1
        out = true
    out
