// forge_graph_builder — Build directed graphs (nodes + edges).

fn gb_new() -> dict
    let g = {}
    g["nodes"] = {}
    g["edges"] = {}
    g["node_count"] = 0
    g["edge_count"] = 0
    g

fn gb_add_node(g: dict, name: string) -> dict
    let has = contains(g["nodes"], name)
    if has == true
        return g
    g["nodes"][name] = g["node_count"]
    g["node_count"] = g["node_count"] + 1
    g

fn gb_add_edge(g: dict, from_node: string, to_node: string) -> dict
    let k = str(g["edge_count"])
    g["edges"][k + "_from"] = from_node
    g["edges"][k + "_to"] = to_node
    g["edge_count"] = g["edge_count"] + 1
    g

fn gb_has_node(g: dict, name: string) -> int
    let has = contains(g["nodes"], name)
    if has == true
        return 1
    0

fn gb_node_count(g: dict) -> int
    g["node_count"]

fn gb_edge_count(g: dict) -> int
    g["edge_count"]

fn gb_out_degree(g: dict, node: string) -> int
    let count = 0
    let i = 0
    while i < g["edge_count"]
        if g["edges"][str(i) + "_from"] == node
            count = count + 1
        i = i + 1
    count

fn gb_in_degree(g: dict, node: string) -> int
    let count = 0
    let i = 0
    while i < g["edge_count"]
        if g["edges"][str(i) + "_to"] == node
            count = count + 1
        i = i + 1
    count

fn gb_has_edge(g: dict, from_node: string, to_node: string) -> int
    let i = 0
    while i < g["edge_count"]
        let k = str(i)
        if g["edges"][k + "_from"] == from_node
            if g["edges"][k + "_to"] == to_node
                return 1
        i = i + 1
    0
