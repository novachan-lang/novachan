// forge_graphmetrics -- basic structural measurements of an UNDIRECTED graph: the degree of each node (how many
// connections it has), the degree sequence, and the graph's density (how close it is to fully connected). These
// are the first things you look at to characterize a network: who are the hubs (highest degree), is the graph
// sparse or dense, what's the average connectivity, and does the degree sequence match a known pattern (e.g.
// scale-free social networks have a few very-high-degree hubs). Useful for social/network analysis, sanity-
// checking a generated graph, load/centrality heuristics, and picking algorithms (dense vs sparse). Edges are
// [u, v] undirected, string ids; a self-loop counts twice toward a node's degree. LEAF -- imports NOTHING.

// PRIVATE.
fn _gm_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    let i = 0
    while i < len(edges)
        let u = edges[i][0]
        if contains(seen, u) == false
            seen[u] = 1
            push(nodes, u)
        let v = edges[i][1]
        if contains(seen, v) == false
            seen[v] = 1
            push(nodes, v)
        i = i + 1
    nodes

// Degree of each node as a dict node -> count (number of incident edges).
fn degrees(edges: list) -> dict
    let deg = {}
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        deg[u] = get(deg, u, 0) + 1
        deg[v] = get(deg, v, 0) + 1
        e = e + 1
    deg

// The degree of a single node.
fn node_degree(edges: list, node) -> int
    let deg = degrees(edges)
    get(deg, node, 0)

// The degree sequence: every node's degree, sorted descending.
fn degree_sequence(edges: list) -> list
    let deg = degrees(edges)
    let nodes = _gm_nodes(edges)
    let seq = []
    let i = 0
    while i < len(nodes)
        push(seq, get(deg, nodes[i], 0))
        i = i + 1
    // insertion sort descending
    let a = 1
    while a < len(seq)
        let cur = seq[a]
        let b = a - 1
        while b >= 0 and seq[b] < cur
            seq[b + 1] = seq[b]
            b = b - 1
        seq[b + 1] = cur
        a = a + 1
    seq

// The maximum degree (the biggest hub). 0 for an empty graph.
fn max_degree(edges: list) -> int
    let seq = degree_sequence(edges)
    let out = 0
    if len(seq) > 0
        out = seq[0]
    out

// The minimum degree. 0 for an empty graph.
fn min_degree(edges: list) -> int
    let seq = degree_sequence(edges)
    let out = 0
    if len(seq) > 0
        out = seq[len(seq) - 1]
    out

// The average degree = 2*edges / nodes.
fn avg_degree(edges: list) -> float
    let n = len(_gm_nodes(edges))
    let out = 0.0
    if n > 0
        out = (2 * len(edges) * 1.0) / (n * 1.0)
    out

// Graph density in [0,1]: actual edges / possible edges = 2E / (V*(V-1)). 1.0 = complete graph, ~0 = sparse.
fn graph_density(edges: list) -> float
    let n = len(_gm_nodes(edges))
    let out = 0.0
    if n > 1
        out = (2 * len(edges) * 1.0) / ((n * 1.0) * ((n - 1) * 1.0))
    out
