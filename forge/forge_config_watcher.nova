// forge_config_watcher — configuration change detection and notification with Result API.

fn cw_new() -> dict
    let c = {}
    c["key_count"] = 0
    c["changes"] = 0
    c["watches"] = 0
    c

fn cw_set(c: dict, key: string, value: string) -> dict
    let vk = "cfg_" + key + "_val"
    let changed = 0
    if vk in c == true
        if c[vk] != value
            changed = 1
    else
        c["key_count"] = c["key_count"] + 1
    c[vk] = value
    c["cfg_" + key + "_ver"] = c["changes"] + changed
    if changed == 1
        c["changes"] = c["changes"] + 1
    c

fn cw_get(c: dict, key: string) -> Result
    c["watches"] = c["watches"] + 1
    let vk = "cfg_" + key + "_val"
    if vk in c != true
        return err("config key not found: " + key)
    ok(c[vk])

fn cw_version(c: dict, key: string) -> Result
    let vk = "cfg_" + key + "_ver"
    if vk in c != true
        return err("config key not found: " + key)
    ok(c[vk])

fn cw_has(c: dict, key: string) -> int
    let vk = "cfg_" + key + "_val"
    if vk in c == true
        return 1
    0

fn cw_key_count(c: dict) -> int
    c["key_count"]

fn cw_change_count(c: dict) -> int
    c["changes"]

fn cw_watch_count(c: dict) -> int
    c["watches"]
