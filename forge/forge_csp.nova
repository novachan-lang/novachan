// forge_csp -- Content-Security-Policy header builder (XSS defense-in-depth). Compose a CSP from directives,
// or use a strict default. Emit as the Content-Security-Policy response header. LEAF -- imports NOTHING.

// One directive: "name src1 src2".
fn csp_directive(name: string, sources: list) -> string
    name + " " + join(sources, " ")

// directives = list of [name, sources_list]; join with "; " into the full policy.
fn csp_build(directives: list) -> string
    let parts = []
    let i = 0
    while i < len(directives)
        push(parts, csp_directive(directives[i][0], directives[i][1]))
        i = i + 1
    join(parts, "; ")

// A sane strict default: only same-origin, no inline objects, no framing.
fn csp_strict() -> string
    let d = []
    push(d, ["default-src", ["'self'"]])
    push(d, ["script-src", ["'self'"]])
    push(d, ["object-src", ["'none'"]])
    push(d, ["base-uri", ["'self'"]])
    push(d, ["frame-ancestors", ["'none'"]])
    csp_build(d)
