// forge_html_to_text -- convert HTML to readable plain text (email plain-text fallback, search indexing,
// notification previews). Strips tags, turns block-closing tags (</p>, <br>, </div>, </li>, </h1>, </tr>) into
// newlines, and decodes HTML entities. More complete than a raw tag-strip. Composes forge_htmlentities.
import forge_htmlentities

fn html_to_text(html: string) -> string
    let out_parts = []
    let i = 0
    let n = len(html)
    let in_tag = false
    let tag = ""
    while i < n
        let c = char_at(html, i)
        if c == "<"
            in_tag = true
            tag = ""
        else
            if c == ">"
                in_tag = false
                let lt = lower(tag)
                if starts_with(lt, "br") or starts_with(lt, "/p") or starts_with(lt, "/div") or starts_with(lt, "/li") or starts_with(lt, "/h") or starts_with(lt, "/tr")
                    push(out_parts, chr(10))
            else
                if in_tag
                    tag += c
                else
                    push(out_parts, c)
        i += 1
    let out = join(out_parts, "")
    html_decode(out)
