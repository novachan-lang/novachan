// forge_security_headers -- the security response-header bundle every app should send (Helmet.js / Spring
// Security headers / Django SecurityMiddleware). One call returns a dict of hardening headers: HSTS (force
// HTTPS), X-Content-Type-Options (no MIME sniffing), X-Frame-Options (clickjacking), Referrer-Policy, COOP/CORP
// isolation, and (strict variant) Permissions-Policy. CSP is built separately by forge_csp. LEAF.

// A sensible-default set. hsts_seconds=0 omits HSTS (only send it over HTTPS). frame = "DENY" or "SAMEORIGIN".
// Note X-XSS-Protection is set to "0": the legacy auditor caused its own vulnerabilities and modern guidance
// is to DISABLE it and rely on CSP instead.
fn security_headers(hsts_seconds: int, frame: string) -> dict
    let h = {}
    h["X-Content-Type-Options"] = "nosniff"
    h["X-Frame-Options"] = frame
    h["Referrer-Policy"] = "strict-origin-when-cross-origin"
    h["X-XSS-Protection"] = "0"
    h["Cross-Origin-Opener-Policy"] = "same-origin"
    h["Cross-Origin-Resource-Policy"] = "same-origin"
    if hsts_seconds > 0
        h["Strict-Transport-Security"] = "max-age=" + str(hsts_seconds) + "; includeSubDomains"
    h

// Production-recommended defaults: 2-year HSTS + preload, DENY framing, locked-down Permissions-Policy.
fn security_headers_strict() -> dict
    let h = security_headers(63072000, "DENY")
    h["Strict-Transport-Security"] = "max-age=63072000; includeSubDomains; preload"
    h["Permissions-Policy"] = "geolocation=(), microphone=(), camera=()"
    h

// Merge a header dict onto a target header dict (later wins). Returns the target for chaining.
fn apply_headers(target: dict, headers: dict) -> dict
    let ks = keys(headers)
    for i in 0..len(ks)
        target[ks[i]] = headers[ks[i]]
    target
