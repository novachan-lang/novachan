// forge_httpdate -- RFC 7231 §7.1.1.1 IMF-fixdate, the required format for HTTP Date / Expires / Last-Modified
// / If-Modified-Since headers: "Sun, 06 Nov 1994 08:49:37 GMT". Formats an epoch-seconds instant (UTC) and
// parses one back to epoch seconds. Pairs with forge_etag (conditional requests) and forge_date (civil math).
import forge_date

fn _day_abbr(wd: int) -> string
    let d = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    if wd < 0 or wd > 6
        return ""
    d[wd]

fn _mon_abbr(m: int) -> string
    let mm = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    if m < 1 or m > 12
        return ""
    mm[m]

fn _mon_num(abbr: string) -> int
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let i = 0
    while i < 12
        if names[i] == abbr
            return i + 1
        i = i + 1
    0

fn _hz2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

// Format epoch-seconds (UTC) as an IMF-fixdate string for a Date/Expires/Last-Modified header.
fn httpdate_format(epoch_seconds: int) -> string
    let days = epoch_seconds / 86400
    let secs = epoch_seconds % 86400
    let ymd = date_from_epoch_days(days)
    let wd = date_weekday(ymd[0], ymd[1], ymd[2])
    let hh = secs / 3600
    let mm = (secs % 3600) / 60
    let ss = secs % 60
    _day_abbr(wd) + ", " + _hz2(ymd[2]) + " " + _mon_abbr(ymd[1]) + " " + str(ymd[0]) + " " + _hz2(hh) + ":" + _hz2(mm) + ":" + _hz2(ss) + " GMT"

// Parse an IMF-fixdate ("Sun, 06 Nov 1994 08:49:37 GMT") -> epoch seconds, or -1 if malformed. Only the modern
// fixed-length IMF form is accepted (the two obsolete RFC 850 / asctime forms are intentionally not parsed).
fn httpdate_parse(s: string) -> int
    if len(s) < 25
        return -1
    let mon = _mon_num(slice(s, 8, 11))
    if mon < 1
        return -1
    let day = parse_int(slice(s, 5, 7))
    let year = parse_int(slice(s, 12, 16))
    let hh = parse_int(slice(s, 17, 19))
    let mm = parse_int(slice(s, 20, 22))
    let ss = parse_int(slice(s, 23, 25))
    date_to_epoch_days(year, mon, day) * 86400 + hh * 3600 + mm * 60 + ss
