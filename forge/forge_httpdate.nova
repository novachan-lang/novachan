// forge_httpdate -- RFC 7231 §7.1.1.1 IMF-fixdate, the required format for HTTP Date / Expires / Last-Modified
// / If-Modified-Since headers: "Sun, 06 Nov 1994 08:49:37 GMT". Formats an epoch-seconds instant (UTC) and
// parses one back to epoch seconds. Pairs with forge_etag (conditional requests) and forge_date (civil math).
//
// RAISED 2026-08-05. httpdate_parse returned -1 for every kind of malformed input, so a caller handling a
// conditional request could not tell a truncated header from a bad month from a non-numeric field -- and -1
// is itself a representable instant (one second before the epoch). The parse now returns Result and names
// the failure; httpdate_parse keeps its exact -1 contract as a thin adapter over it.
import forge_date

// Why a header failed to parse. An ADT, so the CAUSE is a value a caller can match on rather than a
// sentinel that every failure collapses into.
enum DateFail
    TooShort(int)
    BadMonth(string)
    BadField(string)

// NAMED _hd_fail_text, not _fail_text: a leading underscore is a SOURCE-level privacy convention only -- the
// backend emits `define @_fail_text`, one flat global symbol per function name. forge_jsonpointer already
// defines `_fail_text`, so importing both modules in one program failed the whole link with
// "invalid redefinition of function '_fail_text'". A private helper still needs a module-unique name.
fn _hd_fail_text(f) -> string
    match f
        TooShort(n) => "IMF-fixdate must be at least 25 characters, got {n}"
        BadMonth(a) => "'{a}' is not a month abbreviation"
        BadField(w) => "{w} field is not numeric"

fn _day_abbr(wd: int) -> string
    let d = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    "" if wd < 0 or wd > 6 else d[wd]

// The month table, defined ONCE. Formatting and parsing used to carry separate literals -- two lists
// that had to stay in step by hand.
fn _months() -> list
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

fn _mon_abbr(m: int) -> string
    "" if m < 1 or m > 12 else _months()[m - 1]

// 1-based month number, or 0 when the abbreviation is not one of the twelve.
// index_of over the shared table states "which of these is it" directly, replacing a scan loop.
fn _mon_num(abbr: string) -> int
    index_of(_months(), abbr) + 1

// Zero-padded two-digit field -- the format spec does the padding.
// SAFE only because _imf_split below guarantees every field handed here is non-negative: "{n:02d}"
// renders -1 as "-1", NOT "0-1" (forge_date's _z4 carries the same warning). Do not call this with a
// value that can go negative without re-checking that.
fn _hz2(n: int) -> string
    "{n:02d}"

// Split epoch seconds into [whole days since the epoch, seconds within that day].
// FLOOR semantics, which is the whole point: integer `/` truncates toward ZERO and `%` keeps the sign
// of the dividend, so a pre-1970 instant needs correcting -- epoch -1 is day -1 second 86399, not day 0
// second -1. Doing it here lets httpdate_format assume 0 <= secs < 86400 so hour/minute/second can
// never be negative.
fn _imf_split(epoch_seconds: int) -> list
    let d = epoch_seconds / 86400
    let r = epoch_seconds % 86400
    [(d - 1) if r < 0 else d, (r + 86400) if r < 0 else r]

// Format epoch-seconds (UTC) as an IMF-fixdate string for a Date/Expires/Last-Modified header.
// One interpolated template instead of thirteen concatenations: the header format now reads as the
// header format.
//
// FIXED 2026-08-05: a NEGATIVE (pre-1970) instant produced a malformed header, because the day/second
// split truncated toward zero and the second field then rendered negative --
//   httpdate_format(-1) -> "Thu, 01 Jan 1970 00:00:-1 GMT"   (and "...00:00:0-1 GMT" before the raise)
// It is now "Wed, 31 Dec 1969 23:59:59 GMT", which is what httpdate_parse already accepted for that
// instant -- so format and parse finally round-trip below the epoch. Output for epoch >= 0 is
// UNCHANGED (r is then never negative, so both arms are the plain quotient and remainder).
fn httpdate_format(epoch_seconds: int) -> string
    let split = _imf_split(epoch_seconds)
    let secs = split[1]
    let ymd = date_from_epoch_days(split[0])
    let wd = date_weekday(ymd[0], ymd[1], ymd[2])
    "{_day_abbr(wd)}, {_hz2(ymd[2])} {_mon_abbr(ymd[1])} {ymd[0]} {_hz2(secs / 3600)}:{_hz2((secs % 3600) / 60)}:{_hz2(secs % 60)} GMT"

// Every numeric field is fixed-width at a fixed offset, so they are described as DATA -- name plus
// slice bounds -- instead of five near-identical parse lines.
fn _imf_fields() -> list
    [["day", 5, 7], ["year", 12, 16], ["hour", 17, 19], ["minute", 20, 22], ["second", 23, 25]]

fn _all_digits(t: string) -> bool
    if len(t) == 0
        return false
    all_match([char_at(t, i) for i in 0..len(t)], (c) => find("0123456789", c) >= 0)

// Parse an IMF-fixdate KEEPING the reason. Only the modern fixed-length IMF form is accepted (the two
// obsolete RFC 850 / asctime forms are intentionally not parsed).
fn httpdate_parse_checked(s: string) -> Result
    if len(s) < 25
        return err(_hd_fail_text(TooShort(len(s))))
    let abbr = slice(s, 8, 11)
    let mon = _mon_num(abbr)
    if mon < 1
        return err(_hd_fail_text(BadMonth(abbr)))
    // A non-numeric field used to slip through silently: parse_int returns 0, so "Sun, xx Nov 1994 ..."
    // parsed as day 0 and produced a plausible-looking WRONG instant rather than reporting malformed
    // input. Each fixed-width field is now validated before conversion.
    for f in _imf_fields()
        if not _all_digits(slice(s, f[1], f[2]))
            return err(_hd_fail_text(BadField(f[0])))
    let day = parse_int(slice(s, 5, 7))
    let year = parse_int(slice(s, 12, 16))
    let hh = parse_int(slice(s, 17, 19))
    let mm = parse_int(slice(s, 20, 22))
    let ss = parse_int(slice(s, 23, 25))
    ok(date_to_epoch_days(year, mon, day) * 86400 + hh * 3600 + mm * 60 + ss)

// Parse an IMF-fixdate ("Sun, 06 Nov 1994 08:49:37 GMT") -> epoch seconds, or -1 if malformed.
// Contract UNCHANGED -- a thin adapter over the checked form.
// NOTE: the digit validation above makes this STRICTER than before for a malformed numeric field
// ("Sun, xx Nov ..." now yields -1 where it previously yielded a wrong instant). That is a bug fix,
// and it is called out here rather than buried.
fn httpdate_parse(s: string) -> int
    unwrap_or(httpdate_parse_checked(s), 0 - 1)
