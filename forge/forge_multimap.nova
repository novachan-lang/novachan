// forge_multimap -- a multi-map: each key maps to a LIST of values (group records by a field, build inverted
// indexes, collect duplicates under one key). mm_add appends; mm_get returns the bucket; mm_group_by builds a
// multimap from a list of records keyed by a field. LEAF -- imports NOTHING.

fn mm_new() -> dict
    let m = {}
    m

// Append `value` under `key` (creating the bucket on first use). Fluent.
fn mm_add(mm: dict, key: string, value) -> dict
    if key not in mm
        mm[key] = []
    push(mm[key], value)
    mm

// The list of values under `key` ([] if none).
fn mm_get(mm: dict, key: string) -> list
    if key in mm
        return mm[key]
    []

// How many values under `key`.
fn mm_count(mm: dict, key: string) -> int
    len(mm_get(mm, key))

fn mm_keys(mm: dict) -> list
    keys(mm)

// Group a list of record dicts by the value of `field` -> multimap of field-value -> list of records.
fn mm_group_by(records: list, field: string) -> dict
    let mm = mm_new()
    for i in 0..len(records)
        let rec = records[i]
        if field in rec
            mm_add(mm, str(rec[field]), rec)
    mm
