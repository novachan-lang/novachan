// forge_editops -- not just HOW DIFFERENT two strings are (forge_levenshtein gives the distance), but the exact
// list of EDITS that turns one into the other: keep, substitute, insert, delete, character by character. This
// is what powers a visual diff ("this letter changed, that one was inserted"), autocorrect suggestions that
// explain the fix, spell-checker highlighting, and simple sequence alignment (text or DNA). It fills the same
// Levenshtein dynamic-programming table, then BACKTRACES the cheapest path from end to start to recover the
// operations. Each op is a readable string: "keep X", "sub X Y" (X->Y), "del X", "ins Y". The number of
// non-keep ops equals the edit distance. Integer DP, fully reliable. LEAF -- imports NOTHING.

// PRIVATE: min of three ints.
fn _eo_min3(a: int, b: int, c: int) -> int
    let m = a
    if b < m
        m = b
    if c < m
        m = c
    m

// The edit distance (Levenshtein) between a and b.
fn edit_distance(a: string, b: string) -> int
    let n = len(a)
    let m = len(b)
    let cols = m + 1
    let sz = (n + 1) * cols
    let dp = [0 for z in 0..sz]
    let j0 = 0
    while j0 <= m
        dp[j0] = j0
        j0 += 1
    let i = 1
    while i <= n
        dp[i * cols] = i
        let j = 1
        while j <= m
            let cost = 1
            if char_at(a, i - 1) == char_at(b, j - 1)
                cost = 0
            dp[i * cols + j] = _eo_min3(dp[(i - 1) * cols + (j - 1)] + cost, dp[(i - 1) * cols + j] + 1, dp[i * cols + (j - 1)] + 1)
            j += 1
        i += 1
    dp[n * cols + m]

// The list of edit operations transforming a into b (each a string: "keep X" / "sub X Y" / "del X" / "ins Y"),
// in left-to-right order.
fn edit_operations(a: string, b: string) -> list
    let n = len(a)
    let m = len(b)
    let cols = m + 1
    let sz = (n + 1) * cols
    let dp = [0 for z in 0..sz]
    let j0 = 0
    while j0 <= m
        dp[j0] = j0
        j0 += 1
    let i0 = 1
    while i0 <= n
        dp[i0 * cols] = i0
        let jj = 1
        while jj <= m
            let cost = 1
            if char_at(a, i0 - 1) == char_at(b, jj - 1)
                cost = 0
            dp[i0 * cols + jj] = _eo_min3(dp[(i0 - 1) * cols + (jj - 1)] + cost, dp[(i0 - 1) * cols + jj] + 1, dp[i0 * cols + (jj - 1)] + 1)
            jj += 1
        i0 += 1
    // backtrace from (n, m)
    let rev = []
    let i = n
    let j = m
    while i > 0 or j > 0
        let step_done = false
        if i > 0 and j > 0 and not step_done
            let same = char_at(a, i - 1) == char_at(b, j - 1)
            let diag = dp[(i - 1) * cols + (j - 1)]
            if same and dp[i * cols + j] == diag
                push(rev, "keep " + char_at(a, i - 1))
                i -= 1
                j -= 1
                step_done = true
            else
                if dp[i * cols + j] == diag + 1
                    push(rev, "sub " + char_at(a, i - 1) + " " + char_at(b, j - 1))
                    i -= 1
                    j -= 1
                    step_done = true
        if not step_done and i > 0 and dp[i * cols + j] == dp[(i - 1) * cols + j] + 1
            push(rev, "del " + char_at(a, i - 1))
            i -= 1
            step_done = true
        if not step_done
            push(rev, "ins " + char_at(b, j - 1))
            j -= 1
    // reverse
    let ops = []
    let r = len(rev) - 1
    while r >= 0
        push(ops, rev[r])
        r -= 1
    ops
