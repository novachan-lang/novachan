// forge_cqrs_handler — Command/Query separation with Result types.

fn cq_new() -> dict
    let c = {}
    c["commands"] = {}
    c["queries"] = {}
    c["cmd_count"] = 0
    c["query_count"] = 0
    c["cmd_log"] = {}
    c["cmd_log_count"] = 0
    c

fn cq_register_command(c: dict, name: string, handler: string) -> dict
    c["commands"][name] = handler
    c["cmd_count"] = c["cmd_count"] + 1
    c

fn cq_register_query(c: dict, name: string, handler: string) -> dict
    c["queries"][name] = handler
    c["query_count"] = c["query_count"] + 1
    c

fn cq_execute_command(c: dict, name: string, payload: string) -> Result
    let has = contains(c["commands"], name)
    if has != true
        return err("unknown command: " + name)
    let k = str(c["cmd_log_count"])
    c["cmd_log"][k + "_name"] = name
    c["cmd_log"][k + "_payload"] = payload
    c["cmd_log_count"] = c["cmd_log_count"] + 1
    ok(c["commands"][name])

fn cq_execute_query(c: dict, name: string) -> Result
    let has = contains(c["queries"], name)
    if has != true
        return err("unknown query: " + name)
    ok(c["queries"][name])

fn cq_command_count(c: dict) -> int
    c["cmd_count"]

fn cq_query_count(c: dict) -> int
    c["query_count"]

fn cq_log_count(c: dict) -> int
    c["cmd_log_count"]

fn cq_log_entry(c: dict, idx: int) -> Result
    if idx < 0
        return err("invalid index")
    if idx >= c["cmd_log_count"]
        return err("index out of range")
    ok(c["cmd_log"][str(idx) + "_name"])
