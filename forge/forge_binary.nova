// forge_binary -- integer <-> binary string conversion + bit helpers. LEAF -- imports NOTHING.

fn to_binary(n: int) -> string
    if n <= 0
        return "0"
    let v = n
    let digits = []
    while v > 0
        push(digits, str(v % 2))
        v = v / 2
    join(reverse(digits), "")

fn to_binary_padded(n: int, width: int) -> string
    let out = to_binary(n)
    let deficit = width - len(out)
    if deficit > 0
        out = repeat("0", deficit) + out
    out

fn from_binary(s: string) -> int
    let v = 0
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == "1"
            v = v * 2 + 1
        else if c == "0"
            v = v * 2
        else
            return 0
    v

fn popcount(n: int) -> int
    let v = n
    let count = 0
    while v > 0
        count += (v % 2)
        v = v / 2
    count
