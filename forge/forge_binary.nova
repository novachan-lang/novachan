// forge_binary -- integer <-> binary string conversion + bit helpers (flag/bitmask display, protocol field
// debugging, teaching). to_binary(10)->"1010"; from_binary; popcount (set-bit count). LEAF -- imports NOTHING.

fn to_binary(n: int) -> string
    if n <= 0
        return "0"
    let v = n
    let out = ""
    while v > 0
        out = str(v % 2) + out
        v = v / 2
    out

// Zero-padded to at least `width` bits.
fn to_binary_padded(n: int, width: int) -> string
    let out = to_binary(n)
    while len(out) < width
        out = "0" + out
    out

// Parse a binary string to an int (0 on any non-0/1 char).
fn from_binary(s: string) -> int
    let v = 0
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == "1"
            v = v * 2 + 1
        else
            if c == "0"
                v = v * 2
            else
                return 0
    v

// Population count (number of set bits).
fn popcount(n: int) -> int
    let v = n
    let count = 0
    while v > 0
        count += (v % 2)
        v = v / 2
    count
