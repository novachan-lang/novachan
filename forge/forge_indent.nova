// forge_indent -- indent / dedent multi-line text blocks (code generation, nested log output, quoting a
// message). indent adds N spaces to each non-empty line; dedent removes up to N leading spaces. LEAF.

fn indent(text: string, spaces: int) -> string
    let pad = ""
    let p = 0
    while p < spaces
        pad = pad + " "
        p = p + 1
    let nl = chr(10)
    let lines = split(text, nl)
    let out = ""
    let i = 0
    while i < len(lines)
        if i > 0
            out = out + nl
        if len(lines[i]) > 0
            out = out + pad + lines[i]
        else
            out = out + lines[i]
        i = i + 1
    out

// Remove up to `spaces` leading spaces from each line.
fn dedent(text: string, spaces: int) -> string
    let nl = chr(10)
    let lines = split(text, nl)
    let out = ""
    let i = 0
    while i < len(lines)
        if i > 0
            out = out + nl
        let line = lines[i]
        let removed = 0
        while removed < spaces and len(line) > 0 and char_at(line, 0) == " "
            line = slice(line, 1, len(line))
            removed = removed + 1
        out = out + line
        i = i + 1
    out
