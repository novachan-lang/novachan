// forge_ansi -- ANSI terminal escape codes for colored + styled CLI output (red errors, green success, bold
// headers). Wraps text in an SGR code with an auto-reset. For CLI tools, logs, and test runners; ansi_strip
// removes the codes for non-TTY / log output. LEAF -- imports NOTHING.

fn _esc() -> string
    chr(27) + "["

// Wrap `text` in an SGR color code + reset. 31 red, 32 green, 33 yellow, 34 blue, 35 magenta, 36 cyan.
fn ansi_color(text: string, code: int) -> string
    _esc() + str(code) + "m" + text + _esc() + "0m"

fn ansi_red(text: string) -> string
    ansi_color(text, 31)

fn ansi_green(text: string) -> string
    ansi_color(text, 32)

fn ansi_yellow(text: string) -> string
    ansi_color(text, 33)

fn ansi_blue(text: string) -> string
    ansi_color(text, 34)

fn ansi_bold(text: string) -> string
    _esc() + "1m" + text + _esc() + "0m"

// Strip ANSI escape sequences (for logging / non-TTY output).
fn ansi_strip(s: string) -> string
    let esc = chr(27)
    let out_parts = []
    let i = 0
    let n = len(s)
    while i < n
        if char_at(s, i) == esc
            while i < n and char_at(s, i) != "m"
                i += 1
            i += 1
        else
            push(out_parts, char_at(s, i))
            i += 1
    let out = join(out_parts, "")
    out
