    push(s, 13)
    push(s, 14)
    push(s, 15)
    // round 11 (== round 1)
    push(s, 14)
    push(s, 10)
    push(s, 4)
    push(s, 8)
    push(s, 9)
    push(s, 15)
    push(s, 13)
    push(s, 6)
    push(s, 1)
    push(s, 12)
    push(s, 0)
    push(s, 2)
    push(s, 11)
    push(s, 7)
    push(s, 5)
    push(s, 3)
    s

// The G mixing function, applied to working vector v (a 16-element list) in place. a,b,c,d are indices.
fn _blake2b_g(v: list, a: int, b: int, c: int, d: int, x: int, y: int)
    v[a] = (v[a] + v[b] + x) & 0xFFFFFFFFFFFFFFFF
    v[d] = _rotr64((v[d] ^ v[a]) & 0xFFFFFFFFFFFFFFFF, 32)
    v[c] = (v[c] + v[d]) & 0xFFFFFFFFFFFFFFFF
    v[b] = _rotr64((v[b] ^ v[c]) & 0xFFFFFFFFFFFFFFFF, 24)
    v[a] = (v[a] + v[b] + y) & 0xFFFFFFFFFFFFFFFF
    v[d] = _rotr64((v[d] ^ v[a]) & 0xFFFFFFFFFFFFFFFF, 16)
    v[c] = (v[c] + v[d]) & 0xFFFFFFFFFFFFFFFF
    v[b] = _rotr64((v[b] ^ v[c]) & 0xFFFFFFFFFFFFFFFF, 63)

// The compression function F. h = 8-word state (mutated in place). block = 16 message words (list of ints).
// t0/t1 = 128-bit byte counter (low/high). last = true on the final block (inverts v[14]).
fn _blake2b_compress(h: list, block: list, t0: int, t1: int, last: bool)
    let iv = _blake2b_iv()
    let sigma = _blake2b_sigma()
    let v = []
    let i = 0
    while i < 8
        push(v, h[i])
        i = i + 1
    i = 0
    while i < 8
        push(v, iv[i])
        i = i + 1
    v[12] = (v[12] ^ t0) & 0xFFFFFFFFFFFFFFFF
    v[13] = (v[13] ^ t1) & 0xFFFFFFFFFFFFFFFF
    if last
        v[14] = (v[14] ^ 0xFFFFFFFFFFFFFFFF) & 0xFFFFFFFFFFFFFFFF
    let r = 0
    while r < 12
        let so = r * 16
        _blake2b_g(v, 0, 4, 8, 12, block[sigma[so + 0]], block[sigma[so + 1]])
        _blake2b_g(v, 1, 5, 9, 13, block[sigma[so + 2]], block[sigma[so + 3]])
        _blake2b_g(v, 2, 6, 10, 14, block[sigma[so + 4]], block[sigma[so + 5]])
        _blake2b_g(v, 3, 7, 11, 15, block[sigma[so + 6]], block[sigma[so + 7]])
        _blake2b_g(v, 0, 5, 10, 15, block[sigma[so + 8]], block[sigma[so + 9]])
        _blake2b_g(v, 1, 6, 11, 12, block[sigma[so + 10]], block[sigma[so + 11]])
        _blake2b_g(v, 2, 7, 8, 13, block[sigma[so + 12]], block[sigma[so + 13]])
        _blake2b_g(v, 3, 4, 9, 14, block[sigma[so + 14]], block[sigma[so + 15]])
        r = r + 1
    i = 0
    while i < 8
        h[i] = (h[i] ^ v[i] ^ v[i + 8]) & 0xFFFFFFFFFFFFFFFF
        i = i + 1

// Read 8 little-endian bytes from `data` starting at offset `off` into a 64-bit word.
// Missing bytes (past end) are treated as zero (final-block padding).
fn _blake2b_load64(data, off: int, n: int) -> int
    let w = 0
    let i = 0
    while i < 8
        let b = 0
        if (off + i) < n
            b = bytes_get(data, off + i)
        w = w | ((b & 255) << (i * 8))
        i = i + 1
    w & 0xFFFFFFFFFFFFFFFF

// Core BLAKE2b over `data` (bytes) and `key` (bytes, may be empty) producing out_len bytes (1..64).
fn _blake2b_core(data, key, out_len: int) -> list
    // VALIDATION: RFC 7693 fixes the digest length at 1..64 bytes. Out of range used to write a
    // malformed digest (out_len>64 read past the 64-byte state; out_len<1 emitted an empty digest).
    // Reject loudly so misuse is a hard stop rather than a silent wrong hash.
    if out_len < 1
        print("blake2b: out_len must be 1..64 (got " + str(out_len) + ")")
        exit(1)
    if out_len > 64
        print("blake2b: out_len must be 1..64 (got " + str(out_len) + ")")
        exit(1)
    // VALIDATION: the key (MAC mode) is at most 64 bytes -- only the first 64 fit the padded key block,
    // so a longer key would silently diverge from every reference implementation. Reject it.
    if bytes_len(key) > 64
        print("blake2b: key must be 0..64 bytes (got " + str(bytes_len(key)) + ")")
        exit(1)

    // parameter block: h[0] ^= 0x01010000 ^ (keylen << 8) ^ out_len
    let h = _blake2b_iv()
    let keylen = bytes_len(key)
    h[0] = (h[0] ^ 0x01010000 ^ (keylen << 8) ^ out_len) & 0xFFFFFFFFFFFFFFFF

    // If keyed, the first data block is the key padded to 128 bytes.
    let msg = bytes(0)
    if keylen > 0
        let ki = 0
        while ki < 128
            let kb = 0
            if ki < keylen
                kb = bytes_get(key, ki)
            msg = bytes_append(msg, kb)
            ki = ki + 1
    let dn = bytes_len(data)
    let di = 0
    while di < dn
        msg = bytes_append(msg, bytes_get(data, di))
        di = di + 1

    let mlen = bytes_len(msg)
    // Number of 128-byte blocks; BLAKE2b always processes at least one block (even for empty unkeyed input).
    let nblocks = mlen / 128
    if (mlen % 128) != 0
        nblocks = nblocks + 1
    if nblocks == 0
        nblocks = 1

    let counter = 0
    let bi = 0
    while bi < nblocks
        let base = bi * 128
        // bytes consumed so far after this block
        let consumed = base + 128
        let is_last = false
        if bi == (nblocks - 1)
            is_last = true
            consumed = mlen
        counter = consumed
        // build the 16-word little-endian block
        let block = []
        let w = 0
        while w < 16
            push(block, _blake2b_load64(msg, base + w * 8, mlen))
            w = w + 1
        // t0 = low 64 bits of the byte counter, t1 = high (0 for our sizes)
        _blake2b_compress(h, block, counter & 0xFFFFFFFFFFFFFFFF, 0, is_last)
        bi = bi + 1

    // Serialize first out_len bytes of h, little-endian.
    let out = bytes(0)
    let oi = 0
    while oi < out_len
        let word = h[oi / 8]
        let shift = (oi % 8) * 8
        out = bytes_append(out, (word >> shift) & 255)
        oi = oi + 1
    out

// PUBLIC: BLAKE2b of `data` (bytes) producing `out_len` bytes (1..64). No key.
fn blake2b(data, out_len: int) -> list
    _blake2b_core(data, bytes(0), out_len)

// PUBLIC: keyed BLAKE2b (MAC mode). `key` up to 64 bytes.
fn blake2b_keyed(data, key, out_len: int) -> list
    // VALIDATION (guarded here too so misuse is caught at the public boundary, not only deep in _core):
    // a key longer than 64 bytes is rejected loudly. RFC 7693 caps the key at 64 bytes.
    if bytes_len(key) > 64
        print("blake2b_keyed: key must be 0..64 bytes (got " + str(bytes_len(key)) + ")")
        exit(1)
    _blake2b_core(data, key, out_len)

// PUBLIC: lowercase-hex string of blake2b(data, out_len).
fn blake2b_hex(data, out_len: int) -> string
    let digest = _blake2b_core(data, bytes(0), out_len)
    let digs = "0123456789abcdef"
    let out = ""
    let n = bytes_len(digest)
    let i = 0
    while i < n
        let b = bytes_get(digest, i)
        out = out + char_at(digs, (b >> 4) & 15) + char_at(digs, b & 15)
        i = i + 1
    out
