// forge_blake2b -- BLAKE2b cryptographic hash (RFC 7693). The modern fast hash used by Argon2,
// libsodium, and many blockchains (Zcash, Polkadot, ...). Pure NOVA, binary-safe: it operates on the
// first-class `bytes` type so digests -- which contain 0x00 octets -- are never truncated the way a
// NUL-terminated string would truncate them.
//
// NOVA-WAY: the whole state machine is expressed with plain 64-bit int arithmetic. NOVA ints are 64-bit
// two's-complement and ADD WRAPS exactly like u64 (0xFFFFFFFFFFFFFFFF + 1 == 0), so the compression
// function needs no bignum -- we just mask with & 0xFFFFFFFFFFFFFFFF after each add and get modular u64.
//
// DRAWBACK-AVOIDED: every other ecosystem FFI-binds libb2 (a native C dependency) to get BLAKE2b, which
// means a different compiled artifact per platform and an out-of-language attack surface. NOVA's is pure,
// so the SAME binary hashes identically on every OS/arch, and there is no unsafe C boundary to audit.
//
// GOTCHA baked in below: NOVA's `>>` is ARITHMETIC (sign-extending) -- 0x8000000000000000 >> 4 yields
// 0xf800000000000000, not 0x0800000000000000. BLAKE2b's G-mixing needs LOGICAL right rotation, so
// _rotr64 masks off the sign-extended high bits with & ((1 << (64 - n)) - 1) before OR-ing the wrap-around
// bits back in. The four rotation amounts (32, 24, 16, 63) are all in 1..63 so 1 << (64 - n) never hits
// the 1<<64 == 0 edge case.
//
// INPUT VALIDATION (added): RFC 7693 fixes the BLAKE2b digest length at 1..64 bytes and the key at 0..64
// bytes. Feeding an out-of-range out_len used to emit a MALFORMED digest silently (out_len=100 wrote 100
// bytes reading past the 64-byte state; out_len=0 emitted an empty digest), and a >64-byte key silently
// diverged from every reference implementation because only the first 64 bytes fit the padded key block.
// Both are now REJECTED LOUDLY (print a one-line error + exit 1) so misuse is a hard stop, never a
// silent wrong hash. The correct-path output is byte-for-byte unchanged.

// Mask a value to unsigned 64-bit (identity on the bit pattern; NOVA ints are already 64-bit).
fn _u64(x: int) -> int
    x & 0xFFFFFFFFFFFFFFFF

// Right-rotate a 64-bit word by n (n in 1..63). Uses a LOGICAL right shift (masked) so the sign bit does
// not leak into the low half -- NOVA's >> is arithmetic.
fn _rotr64(x: int, n: int) -> int
    let low = (x >> n) & ((1 << (64 - n)) - 1)
    let high = (x << (64 - n)) & 0xFFFFFFFFFFFFFFFF
    (low | high) & 0xFFFFFFFFFFFFFFFF

// The 8 BLAKE2b IV words (fractional parts of sqrt of the first 8 primes) -- same as SHA-512.
fn _blake2b_iv() -> list
    let iv = []
    push(iv, 0x6a09e667f3bcc908)
    push(iv, 0xbb67ae8584caa73b)
    push(iv, 0x3c6ef372fe94f82b)
    push(iv, 0xa54ff53a5f1d36f1)
    push(iv, 0x510e527fade682d1)
    push(iv, 0x9b05688c2b3e6c1f)
    push(iv, 0x1f83d9abfb41bd6b)
    push(iv, 0x5be0cd19137e2179)
    iv

// SIGMA[round][k] message-word permutation, 12 rounds x 16 indices, flattened (row-major).
fn _blake2b_sigma() -> list
    let s = []
    // round 0
    push(s, 0)
    push(s, 1)
    push(s, 2)
    push(s, 3)
    push(s, 4)
    push(s, 5)
    push(s, 6)
    push(s, 7)
    push(s, 8)
    push(s, 9)
    push(s, 10)
    push(s, 11)
    push(s, 12)
    push(s, 13)
    push(s, 14)
    push(s, 15)
    // round 1
    push(s, 14)
    push(s, 10)
    push(s, 4)
    push(s, 8)
    push(s, 9)
    push(s, 15)
    push(s, 13)
    push(s, 6)
    push(s, 1)
    push(s, 12)
    push(s, 0)
    push(s, 2)
    push(s, 11)
    push(s, 7)
    push(s, 5)
    push(s, 3)
    // round 2
    push(s, 11)
    push(s, 8)
    push(s, 12)
    push(s, 0)
    push(s, 5)
    push(s, 2)
    push(s, 15)
    push(s, 13)
    push(s, 10)
    push(s, 14)
    push(s, 3)
    push(s, 6)
    push(s, 7)
    push(s, 1)
    push(s, 9)
    push(s, 4)
    // round 3
    push(s, 7)
    push(s, 9)
    push(s, 3)
    push(s, 1)
    push(s, 13)
    push(s, 12)
    push(s, 11)
    push(s, 14)
    push(s, 2)
    push(s, 6)
    push(s, 5)
    push(s, 10)
    push(s, 4)
    push(s, 0)
    push(s, 15)
    push(s, 8)
    // round 4
    push(s, 9)
    push(s, 0)
    push(s, 5)
    push(s, 7)
    push(s, 2)
    push(s, 4)
    push(s, 10)
    push(s, 15)
    push(s, 14)
    push(s, 1)
    push(s, 11)
    push(s, 12)
    push(s, 6)
    push(s, 8)
    push(s, 3)
    push(s, 13)
    // round 5
    push(s, 2)
    push(s, 12)
    push(s, 6)
    push(s, 10)
    push(s, 0)
    push(s, 11)
    push(s, 8)
    push(s, 3)
    push(s, 4)
    push(s, 13)
    push(s, 7)
    push(s, 5)
    push(s, 15)
    push(s, 14)
    push(s, 1)
    push(s, 9)
    // round 6
    push(s, 12)
    push(s, 5)
    push(s, 1)
    push(s, 15)
    push(s, 14)
    push(s, 13)
    push(s, 4)
    push(s, 10)
    push(s, 0)
    push(s, 7)
    push(s, 6)
    push(s, 3)
    push(s, 9)
    push(s, 2)
    push(s, 8)
    push(s, 11)
    // round 7
    push(s, 13)
    push(s, 11)
    push(s, 7)
    push(s, 14)
    push(s, 12)
    push(s, 1)
    push(s, 3)
    push(s, 9)
    push(s, 5)
    push(s, 0)
    push(s, 15)
    push(s, 4)
    push(s, 8)
    push(s, 6)
    push(s, 2)
    push(s, 10)
    // round 8
    push(s, 6)
    push(s, 15)
    push(s, 14)
    push(s, 9)
    push(s, 11)
    push(s, 3)
    push(s, 0)
    push(s, 8)
    push(s, 12)
    push(s, 2)
    push(s, 13)
    push(s, 7)
    push(s, 1)
    push(s, 4)
    push(s, 10)
    push(s, 5)
    // round 9
    push(s, 10)
    push(s, 2)
    push(s, 8)
    push(s, 4)
    push(s, 7)
    push(s, 6)
    push(s, 1)
    push(s, 5)
    push(s, 15)
    push(s, 11)
    push(s, 9)
    push(s, 14)
    push(s, 3)
    push(s, 12)
    push(s, 13)
    push(s, 0)
    // round 10 (== round 0)
    push(s, 0)
    push(s, 1)
    push(s, 2)
    push(s, 3)
    push(s, 4)
    push(s, 5)
    push(s, 6)
    push(s, 7)
    push(s, 8)
    push(s, 9)
