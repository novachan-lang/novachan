// forge_traffic_mirror — Traffic mirroring for testing.
// Mirror a percentage of traffic to shadow endpoints, compare responses.

fn tm_new() -> dict
    {"rules": [], "mirrored": 0, "skipped": 0, "mismatches": 0}

fn tm_add_rule(tm: dict, path_prefix: string, mirror_pct: int, target: string) -> dict
    push(tm["rules"], {"path_prefix": path_prefix, "mirror_pct": mirror_pct, "target": target, "enabled": 1, "count": 0})
    tm

fn tm_should_mirror(tm: dict, path: string, request_id: int) -> dict
    let result = {"mirror": 0, "target": ""}
    for i in 0..len(tm["rules"])
        let r = tm["rules"][i]
        if r["enabled"] == 1
            let plen = len(r["path_prefix"])
            if len(path) >= plen
                let prefix = slice(path, 0, plen)
                if prefix == r["path_prefix"]
                    let hash = request_id % 100
                    if hash < r["mirror_pct"]
                        result["mirror"] = 1
                        result["target"] = r["target"]
                        tm["rules"][i]["count"] += 1
                        tm["mirrored"] += 1
                        return result
                    else
                        tm["skipped"] += 1
                        return result
    result

fn tm_record_mismatch(tm: dict) -> dict
    tm["mismatches"] += 1
    tm

fn tm_disable_rule(tm: dict, path_prefix: string) -> dict
    for i in 0..len(tm["rules"])
        if tm["rules"][i]["path_prefix"] == path_prefix
            tm["rules"][i]["enabled"] = 0
            return tm
    tm

fn tm_rule_count(tm: dict) -> int
    len(tm["rules"])

fn tm_total_mirrored(tm: dict) -> int
    tm["mirrored"]

fn tm_total_skipped(tm: dict) -> int
    tm["skipped"]

fn tm_total_mismatches(tm: dict) -> int
    tm["mismatches"]

fn tm_rule_mirror_count(tm: dict, path_prefix: string) -> int
    for i in 0..len(tm["rules"])
        if tm["rules"][i]["path_prefix"] == path_prefix
            return tm["rules"][i]["count"]
    0
