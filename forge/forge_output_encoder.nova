// forge_output_encoder — Encode output for safe display (HTML/URL/JSON).

fn oe_html_encode(input: string) -> string
    let result = ""
    for i in 0..len(input)
        let c = input[i]
        if c == "<"
            result += "&lt;"
        else
            if c == ">"
                result += "&gt;"
            else
                if c == "&"
                    result += "&amp;"
                else
                    if c == "\""
                        result += "&quot;"
                    else
                        result += c
    result

fn oe_url_encode_char(c: string) -> string
    if c == " "
        return "%20"
    if c == "&"
        return "%26"
    if c == "="
        return "%3D"
    if c == "?"
        return "%3F"
    if c == "#"
        return "%23"
    if c == "+"
        return "%2B"
    c

fn oe_url_encode(input: string) -> string
    let result = ""
    for i in 0..len(input)
        result += oe_url_encode_char(input[i])
    result

fn oe_json_escape(input: string) -> string
    let result = ""
    for i in 0..len(input)
        let c = input[i]
        if c == "\\"
            result += "\\\\"
        else
            if c == "\""
                result += "\\\""
            else
                result += c
    result

fn oe_csv_escape(input: string) -> string
    let needs_quote = 0
    for i in 0..len(input)
        let c = input[i]
        if c == ","
            needs_quote = 1
        if c == "\""
            needs_quote = 1
    if needs_quote == 0
        return input
    let result = "\""
    for j in 0..len(input)
        let c = input[j]
        if c == "\""
            result += "\"\""
        else
            result += c
    result += "\""
    result
