// forge_output_encoder — Encode output for safe display (HTML/URL/JSON).

fn oe_html_encode(input: string) -> string
    let result = ""
    let i = 0
    while i < len(input)
        let c = input[i]
        if c == "<"
            result = result + "&lt;"
        else
            if c == ">"
                result = result + "&gt;"
            else
                if c == "&"
                    result = result + "&amp;"
                else
                    if c == "\""
                        result = result + "&quot;"
                    else
                        result = result + c
        i = i + 1
    result

fn oe_url_encode_char(c: string) -> string
    if c == " "
        return "%20"
    if c == "&"
        return "%26"
    if c == "="
        return "%3D"
    if c == "?"
        return "%3F"
    if c == "#"
        return "%23"
    if c == "+"
        return "%2B"
    c

fn oe_url_encode(input: string) -> string
    let result = ""
    let i = 0
    while i < len(input)
        result = result + oe_url_encode_char(input[i])
        i = i + 1
    result

fn oe_json_escape(input: string) -> string
    let result = ""
    let i = 0
    while i < len(input)
        let c = input[i]
        if c == "\\"
            result = result + "\\\\"
        else
            if c == "\""
                result = result + "\\\""
            else
                result = result + c
        i = i + 1
    result

fn oe_csv_escape(input: string) -> string
    let needs_quote = 0
    let i = 0
    while i < len(input)
        let c = input[i]
        if c == ","
            needs_quote = 1
        if c == "\""
            needs_quote = 1
        i = i + 1
    if needs_quote == 0
        return input
    let result = "\""
    let j = 0
    while j < len(input)
        let c = input[j]
        if c == "\""
            result = result + "\"\""
        else
            result = result + c
        j = j + 1
    result = result + "\""
    result
