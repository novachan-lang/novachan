// forge_api_gateway_router — API gateway with path-based routing to backends.

fn gw_new() -> dict
    let g = {}
    g["routes"] = {}
    g["count"] = 0
    g["requests"] = 0
    g["misses"] = 0
    g

fn gw_add_route(g: dict, prefix: string, backend: string) -> dict
    let k = str(g["count"])
    g["routes"][k + "_prefix"] = prefix
    g["routes"][k + "_backend"] = backend
    g["routes"][k + "_enabled"] = 1
    g["routes"][k + "_hits"] = 0
    g["count"] = g["count"] + 1
    g

fn gw_prefix_match(path: string, prefix: string) -> int
    let plen = len(prefix)
    if plen > len(path)
        return 0
    for j in 0..plen
        if path[j] != prefix[j]
            return 0
    1

fn gw_route(g: dict, path: string) -> dict
    let result = {}
    g["requests"] = g["requests"] + 1
    let best_idx = -1
    let best_len = 0
    let i = 0
    while i < g["count"]
        let k = str(i)
        if g["routes"][k + "_enabled"] == 1
            let prefix = g["routes"][k + "_prefix"]
            let plen = len(prefix)
            let matched = gw_prefix_match(path, prefix)
            if matched == 1
                if plen > best_len
                    best_len = plen
                    best_idx = i
        i += 1
    if best_idx >= 0
        let bk = str(best_idx)
        g["routes"][bk + "_hits"] = g["routes"][bk + "_hits"] + 1
        result["found"] = 1
        result["backend"] = g["routes"][bk + "_backend"]
    else
        g["misses"] = g["misses"] + 1
        result["found"] = 0
        result["backend"] = ""
    result["g"] = g
    result

fn gw_disable_route(g: dict, index: int) -> dict
    if index >= 0
        if index < g["count"]
            g["routes"][str(index) + "_enabled"] = 0
    g

fn gw_route_count(g: dict) -> int
    g["count"]

fn gw_total_requests(g: dict) -> int
    g["requests"]

fn gw_total_misses(g: dict) -> int
    g["misses"]
