// forge_api_gateway_router -- API gateway with path-based routing to backends: longest-prefix match,
// per-route hit counters, route disable. State is a flat dict with indexed route keys. LEAF -- imports
// NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. THE ROUTE KEY `str(i) + "_prefix"` (and _backend/_enabled/_hits) was built by concatenation at
//      NINE sites. One typo reads a non-existent key and silently returns 0/nil. _gw_rkey owns the
//      scheme.
//   2. gw_prefix_match manually compared characters in a for loop -- that is `starts_with`.
//   3. gw_route used a `while i < g["count"]` loop -- for-in over a range.
//   4. `g["count"] = g["count"] + 1` and similar -- compound assignment.

fn gw_new() -> dict
    {"routes": {}, "count": 0, "requests": 0, "misses": 0}

// PRIVATE: the indexed route key scheme. Nine sites previously concatenated it.
fn _gw_rkey(idx: int, field: string) -> string
    "{idx}_{field}"

fn gw_add_route(g: dict, prefix: string, backend: string) -> dict
    let k = int(g["count"])
    g["routes"][_gw_rkey(k, "prefix")] = prefix
    g["routes"][_gw_rkey(k, "backend")] = backend
    g["routes"][_gw_rkey(k, "enabled")] = 1
    g["routes"][_gw_rkey(k, "hits")] = 0
    g["count"] += 1
    g

fn gw_prefix_match(path: string, prefix: string) -> int
    1 if starts_with(path, prefix) else 0

fn gw_route(g: dict, path: string) -> dict
    g["requests"] += 1
    let best_idx = -1
    let best_len = 0
    for i in 0..int(g["count"])
        if g["routes"][_gw_rkey(i, "enabled")] == 1
            let prefix = str(g["routes"][_gw_rkey(i, "prefix")])
            if starts_with(path, prefix) and len(prefix) > best_len
                best_len = len(prefix)
                best_idx = i
    if best_idx >= 0
        g["routes"][_gw_rkey(best_idx, "hits")] += 1
        return {"found": 1, "backend": g["routes"][_gw_rkey(best_idx, "backend")], "g": g}
    g["misses"] += 1
    {"found": 0, "backend": "", "g": g}

fn gw_disable_route(g: dict, index: int) -> dict
    if index >= 0 and index < int(g["count"])
        g["routes"][_gw_rkey(index, "enabled")] = 0
    g

fn gw_route_count(g: dict) -> int
    g["count"]

fn gw_total_requests(g: dict) -> int
    g["requests"]

fn gw_total_misses(g: dict) -> int
    g["misses"]
