// NOVA FORGE — minimal pure-NOVA web framework.
// Stage 2b adoption-engine #1 per FRAMEWORK_ECOSYSTEM_STRATEGY.md.
// Built on NOVA's tcp_* primitives + spawn + first-class functions.
//
// API surface (public):
//   forge.text(status, body)        -> raw HTTP response (text/plain)
//   forge.html(status, body)        -> raw HTTP response (text/html)
//   forge.json(status, body)        -> raw HTTP response (application/json)
//   forge.parse_method(req)         -> "GET", "POST", ...
//   forge.parse_path(req)           -> "/api/users"
//   forge.parse_body(req)           -> request body (string)
//   forge.serve(port, handler)      -> infinite accept loop, spawn per conn
//   forge.serve_n(port, handler, n) -> serve exactly N requests, then close
//                                       (testable + deterministic)
//
// The handler is a function (method, path, body) -> response string.
// Use the response builders to construct the response string with proper
// headers + Content-Length.

// forge_live (pure, no imports) supplies the LiveView wire helpers (live_conn/live_diff/patch_json/
// live_mount_json) used by the WebSocket live runner below. The dependency is acyclic -- forge_live
// imports nothing -- so forge may layer on it the way it would a dependency-free stdlib module.
import forge_live

fn _status_line(status: int) -> string
    if status == 200
        return "200 OK"
    if status == 201
        return "201 Created"
    if status == 204
        return "204 No Content"
    if status == 301
        return "301 Moved Permanently"
    if status == 302
        return "302 Found"
    if status == 400
        return "400 Bad Request"
    if status == 401
        return "401 Unauthorized"
    if status == 403
        return "403 Forbidden"
    if status == 404
        return "404 Not Found"
    if status == 303
        return "303 See Other"
    if status == 307
        return "307 Temporary Redirect"
    if status == 308
        return "308 Permanent Redirect"
    if status == 405
        return "405 Method Not Allowed"
    if status == 409
        return "409 Conflict"
    if status == 413
        return "413 Payload Too Large"
    if status == 415
        return "415 Unsupported Media Type"
    if status == 422
        return "422 Unprocessable Entity"
    if status == 429
        return "429 Too Many Requests"
    if status == 500
        return "500 Internal Server Error"
    if status == 502
        return "502 Bad Gateway"
    if status == 503
        return "503 Service Unavailable"
    // Unknown code: emit the number with no reason phrase (RFC-legal) rather than a misleading "OK".
    str(status)

fn _build(status: int, ctype: string, body: string) -> string
    let r = "HTTP/1.1 " + _status_line(status) + "\r\n"
    r = r + "Content-Type: " + ctype + "\r\n"
    r = r + "Content-Length: " + str(len(body)) + "\r\n"
    r = r + "Connection: close\r\n"
    r = r + "Server: NOVA Forge\r\n"
    r = r + "\r\n"
    r = r + body
    r

fn text(status: int, body: string) -> string
    _build(status, "text/plain; charset=utf-8", body)

fn html(status: int, body: string) -> string
    _build(status, "text/html; charset=utf-8", body)

fn json(status: int, body: string) -> string
    _build(status, "application/json", body)

// json_of: serialize ANY value (struct/list/dict/scalar) into a JSON response. A struct
// passed here renders as a JSON OBJECT via the hash-keyed RTTI keystone -- even when its
// static type is erased to `any` through this param -- so a handler can
// `return forge.json_of(200, user)` and the client gets {"id":7,...}, zero annotation.
// The "return your domain type, get JSON" win (Phase 0a keystone).
fn json_of(status: int, value) -> string
    json(status, json_stringify(value))

// Truncate a string at the first CR or LF. Used to keep a parsed request-line URI from carrying
// an embedded CR/LF into req.path / req.query (an attacker-controlled "GET /a\r\nX: b HTTP/1.1"
// would otherwise land a CRLF in the path that a handler could reflect into a response header).
fn _cut_at_crlf(s: string) -> string
    let i = 0
    while i < len(s)
        if s[i] == "\r" or s[i] == "\n"
            return slice(s, 0, i)
        i = i + 1
    s

// Strip CR / LF / NUL from a header name or value -- the single defense against response splitting
// / header injection. Applied at the serialization boundary (finalize, redirect) so EVERY header,
// including any built from request data (req.query reflected via resp_set_header), is safe by
// construction. We strip rather than reject so a serve loop never dies on hostile input, and a
// stripped value can never break framing.
fn _safe_header(value: string) -> string
    let out = ""
    let i = 0
    while i < len(value)
        let c = value[i]
        if c != "\r" and c != "\n" and c != chr(0)
            out = out + c
        i = i + 1
    out

fn parse_method(req: string) -> string
    let sp = find(req, " ")
    if sp < 0
        return "GET"
    // terminate at the first CR/LF (mirrors parse_path): a request line with no space before the CRLF,
    // e.g. "GET\r\nHost:...", would otherwise carry CR/LF into req.method and inject/forge log lines.
    _cut_at_crlf(slice(req, 0, sp))

fn parse_path(req: string) -> string
    let sp1 = find(req, " ")
    if sp1 < 0
        return "/"
    let rest = slice(req, sp1 + 1, len(req))
    let sp2 = find(rest, " ")
    if sp2 < 0
        return _cut_at_crlf(rest)
    _cut_at_crlf(slice(rest, 0, sp2))

fn parse_body(req: string) -> string
    let sep = find(req, "\r\n\r\n")
    if sep < 0
        return ""
    let start = sep + 4
    let cl = _content_length(req)
    // -2 = AMBIGUOUS framing (Transfer-Encoding / duplicate Content-Length / overflow-length): refuse, since
    // the body boundary is unsafe to guess (smuggling). Oversized CL (> _max_body): refuse.
    if cl == -2 or cl > _max_body()
        return ""
    // -1 = NO Content-Length: there is no length to clamp to and no pipelined-body boundary to over-read
    // past (the string serve paths are one-shot), so the trailing bytes ARE the body (lenient, original
    // behavior; matches how constructed/test requests carry a body).
    if cl < 0
        return slice(req, start, len(req))
    // Valid CL: clamp the body to EXACTLY Content-Length so trailing/pipelined bytes the recv overshot are
    // NOT folded into the handler's body (mirrors the binary path _build_req_from_bytes).
    let endp = start + cl
    if endp > len(req)
        endp = len(req)
    slice(req, start, endp)

// Query string from "/path?key=value&k2=v2" -> "key=value&k2=v2", "" if none
fn parse_query(req: string) -> string
    let p = parse_path(req)
    let q = find(p, "?")
    if q < 0
        return ""
    slice(p, q + 1, len(p))

// Path without query string
fn parse_path_clean(req: string) -> string
    let p = parse_path(req)
    let q = find(p, "?")
    if q < 0
        return p
    slice(p, 0, q)

// Get a single query param value. "" if not present (or present with no value). Splits on '&' and matches
// the key EXACTLY, so a param whose name merely ends with `key` (e.g. "notadmin=1" when asked for "admin")
// can no longer shadow or hide the real param -- the old substring-find approach false-matched and bailed,
// silently missing a present param (a parameter-parsing confusion an attacker could exploit). First match
// wins on duplicate keys.
fn query_get(req: string, key: string) -> string
    let q = parse_query(req)
    let pairs = split(q, "&")
    let i = 0
    while i < len(pairs)
        let p = pairs[i]
        let eq = find(p, "=")
        if eq >= 0 and slice(p, 0, eq) == key
            return slice(p, eq + 1, len(p))
        i = i + 1
    ""

// ALL values for a repeated query key, in order -> a list (empty if the key is absent). A multi-select /
// checkbox form submits "?tag=a&tag=b&tag=c"; query_get returns only the first ("a"), so this is the way to
// read every value. Exact key match (same anti-shadowing as query_get); a valueless "&key&" is skipped.
fn query_all(req: string, key: string) -> list
    let out = []
    let q = parse_query(req)
    let pairs = split(q, "&")
    let i = 0
    while i < len(pairs)
        let p = pairs[i]
        let eq = find(p, "=")
        if eq >= 0 and slice(p, 0, eq) == key
            push(out, slice(p, eq + 1, len(p)))
        i = i + 1
    out

// Header value, matched CASE-INSENSITIVELY on the header name (HTTP header names are case-insensitive, so
// "Content-Type" and "content-type" are the same header -- a case-sensitive match silently misses a
// differently-cased header, which can defeat a header-gate check). Anchored to a "\r\n<name>: " line
// boundary, so "X-Foo-Bar" cannot be matched by asking for "Bar". Returns "" if not found. Matches the typed
// req_header (which is already case-insensitive).
fn header_get(req: string, name: string) -> string
    let hdr_end = find(req, "\r\n\r\n")
    let region = req
    if hdr_end >= 0
        region = slice(req, 0, hdr_end)
    // search a lowercased copy for the name; extract the value from the ORIGINAL region (case preserved).
    // lower() is length-preserving for ASCII header names, so the match index maps across unchanged.
    let low = lower(region)
    let needle = "\r\n" + lower(name) + ": "
    let i = find(low, needle)
    if i < 0
        return ""
    let rest = slice(region, i + len(needle), len(region))
    let nl = find(rest, "\r\n")
    if nl < 0
        return rest
    slice(rest, 0, nl)

// Builds an application/json response body from a list of [key, value]
// pairs. Values are strings; if you want raw (number/bool/object), pass
// the string already serialized. Quotes inside values must already be
// escaped by the caller — MVP, not a full JSON encoder.
// Redirect response (301/302/303/307/308). Includes the Location header.
fn redirect(status: int, url: string) -> string
    let r = "HTTP/1.1 " + _status_line(status) + "\r\n"
    r = r + "Location: " + _safe_header(url) + "\r\n"
    r = r + "Content-Length: 0\r\n"
    r = r + "Connection: close\r\n"
    r = r + "Server: NOVA Forge\r\n"
    r = r + "\r\n"
    r

// Returns 1 iff `url` is a SAFE same-origin redirect target -- a local absolute PATH that cannot send the
// browser off-site. This is the open-redirect guard for the "?next=..." / "return to" pattern (a raw
// user-supplied target passed to redirect() is an open-redirect: phishing). A safe target must start with a
// single "/" (so it resolves under the current origin) and must NOT be protocol-relative "//host" nor the
// backslash bypass "/\host" (browsers normalize "\" to "/"), and must contain no backslash or CR/LF/NUL.
// Rejects absolute ("http://evil"), scheme ("javascript:"), and host-relative targets. "/" is allowed.
fn is_local_redirect(url: string) -> int
    let n = len(url)
    if n == 0
        return 0
    if url[0] != "/"
        return 0
    if n >= 2
        if url[1] == "/" or url[1] == "\\"
            return 0
    let i = 0
    while i < n
        let c = url[i]
        if c == "\\" or c == "\r" or c == "\n" or c == chr(0)
            return 0
        i = i + 1
    1

// Redirect to `url` ONLY if it is a safe local target (is_local_redirect), else to `fallback`. The
// secure-by-default "return to" helper: redirect_local(303, query_get(req, "next"), "/") can never be
// turned into an off-site (open) redirect by a crafted `next`.
fn redirect_local(status: int, url: string, fallback: string) -> string
    if is_local_redirect(url) == 1
        return redirect(status, url)
    redirect(status, fallback)

fn _ext_ctype(path: string) -> string
    if ends_with(path, ".html") or ends_with(path, ".htm")
        return "text/html; charset=utf-8"
    if ends_with(path, ".css")
        return "text/css; charset=utf-8"
    if ends_with(path, ".js")
        return "application/javascript; charset=utf-8"
    if ends_with(path, ".json")
        return "application/json"
    if ends_with(path, ".png")
        return "image/png"
    if ends_with(path, ".jpg") or ends_with(path, ".jpeg")
        return "image/jpeg"
    if ends_with(path, ".svg")
        return "image/svg+xml"
    if ends_with(path, ".wasm")
        return "application/wasm"
    "application/octet-stream"

// Is this content-type textual? Text assets serve as a STRING (string body -- inspectable by middleware
// and tests); everything else serves as BYTES (read_bytes, NUL-safe binary wire path). Covers text/*,
// JSON, JavaScript, and XML/SVG; image/png, application/wasm, octet-stream, etc. fall through to binary.
fn _ct_is_text(ct: string) -> bool
    if starts_with(ct, "text/")
        return true
    if find(ct, "json") >= 0
        return true
    if find(ct, "javascript") >= 0
        return true
    if find(ct, "xml") >= 0
        return true
    false

// Serve a file from disk by reading it and producing a 200 response.
// Returns a 404 response if the file is missing or empty.
fn serve_file(path: string) -> string
    let content = read_file(path)
    if len(content) == 0
        return text(404, "file not found: " + path)
    _build(200, _ext_ctype(path), content)

// Build a JSON object response from a list of [k, v] string pairs. Serializes through the runtime
// json_stringify (the same escaping as the struct-RTTI keystone) so a key/value containing a quote,
// backslash, or control char produces VALID JSON -- the hand-rolled `"k":"v"` concatenation it
// replaced did not escape and emitted broken JSON.
fn json_obj(status: int, pairs: list) -> string
    let d = {}
    let i = 0
    while i < len(pairs)
        let kv = pairs[i]
        d[kv[0]] = kv[1]
        i = i + 1
    _build(status, "application/json", json_stringify(d))

// Maximum request header region (64 KiB) and body (8 MiB). Defaults that BOUND arena growth so a
// lying / oversized / never-terminated request cannot exhaust memory. Functions (not globals) =
// one source of truth; a larger upload path arrives with a length-delimited bytes Response.
fn _max_header() -> int
    65536

fn _max_body() -> int
    8388608

fn _is_digits(s: string) -> bool
    if len(s) == 0
        return false
    let i = 0
    while i < len(s)
        if find("0123456789", s[i]) < 0
            return false
        i = i + 1
    true

// Content-Length from the HEADER REGION only, case-insensitive, anchored to a header-line boundary
// (so "X-Foo-Content-Length:" cannot match). Returns: -1 absent; -2 malformed/ambiguous -- non-
// numeric, MORE THAN ONE Content-Length, or ANY Transfer-Encoding (Forge does not implement
// chunked, so it REFUSES rather than mis-frame, closing a request-smuggling vector); else the length.
fn _content_length(raw)
    let sep = find(raw, "\r\n\r\n")
    let head = raw
    if sep >= 0
        head = slice(raw, 0, sep)
    let lines = split(head, "\r\n")
    let cl = -1
    let seen = 0
    let te = 0
    let i = 1
    while i < len(lines)
        let line = lines[i]
        let c = find(line, ":")
        if c >= 0
            let nm = lower(trim(slice(line, 0, c)))
            let vl = trim(slice(line, c + 1, len(line)))
            if nm == "content-length"
                seen = seen + 1
                // Strict: all-digits AND short enough that parse_int cannot overflow i64. A 19+ digit value
                // passes _is_digits but could wrap parse_int to a small number -> the body would be
                // under-read / mis-framed (a smuggling desync if a proxy reads the true huge length). 15
                // digits is far below i64 (10^15 << 9.2*10^18) yet far above any real <= _max_body length.
                if _is_digits(vl) and len(vl) <= 15
                    cl = parse_int(vl)
                else
                    cl = -2
            else if nm == "transfer-encoding"
                te = 1
        i = i + 1
    if te == 1
        return -2
    if seen > 1
        return -2
    if seen == 0
        return -1
    cl

// Read a COMPLETE HTTP request: a single tcp_recv may return only the first TCP segment
// (headers, or a partial body), so reading once silently drops POST bodies that arrive in
// a later segment. Read full headers, then the body per Content-Length. PUBLIC so servers
// built directly on tcp_* (not just forge.serve) can read requests correctly too.
fn recv_request(conn)
    let req = tcp_recv(conn)
    if len(req) == 0
        return req
    let sep = find(req, "\r\n\r\n")
    while sep < 0
        // Bound the header region: a client that never sends the blank line (Slowloris) or an
        // oversized header block cannot grow memory without limit.
        if len(req) > _max_header()
            return req
        let more = tcp_recv(conn)
        if len(more) == 0
            return req
        req = req + more
        sep = find(req, "\r\n\r\n")
    let cl = _content_length(req)
    // Refuse to read a body for an absent (-1), malformed/chunked/ambiguous (-2), or oversized
    // (> MAX_BODY) Content-Length: return what arrived rather than mis-frame or grow unbounded.
    if cl < 0 or cl > _max_body()
        return req
    while (len(req) - (sep + 4)) < cl
        let more = tcp_recv(conn)
        if len(more) == 0
            return req
        req = req + more
    req

// ── Binary-safe request reading (file uploads / multipart) ───────────────────────────────────────────
// Scan a bytes buffer for the 4-byte header terminator \r\n\r\n from `start`; returns the offset of the
// first \r, or -1. `start` lets the caller skip already-scanned bytes (with a small overlap for a split).
fn _find_header_end(buf, start: int) -> int
    let n = bytes_len(buf)
    let i = start
    if i < 0
        i = 0
    while i + 3 < n
        if bytes_get(buf, i) == 13 and bytes_get(buf, i + 1) == 10 and bytes_get(buf, i + 2) == 13 and bytes_get(buf, i + 3) == 10
            return i
        i = i + 1
    -1

// Append every byte of `chunk` to `buf` (amortized-doubling bytes_append); returns the grown buffer.
// O(len(chunk)) amortized -- avoids the O(n^2)-under-arena cost of repeated bytes_concat for accumulation.
fn _append_chunk(buf, chunk)
    let m = bytes_len(chunk)
    let j = 0
    while j < m
        buf = bytes_append(buf, bytes_get(chunk, j))
        j = j + 1
    buf

// Binary-safe request read (parallel to recv_request; the string path is untouched). Reads headers + body
// as a NovaBytes via tcp_recv_bytes so a multipart/binary body with embedded NULs is NOT truncated. Bounds
// headers (_max_header) and body (_max_body) exactly like recv_request. Returns the full raw message bytes.
// Per-request read DEADLINE (ms) -> Slowloris defense: a connection that does not deliver a COMPLETE
// request within the budget is dropped (returns empty -> _serve_conn closes). Default 30s (security by
// default); forge.read_timeout(app, ms) overrides; 0 disables (then the read is byte-identical to the
// original untimed blocking read). The WS frame loop uses its OWN keepalive (ws_keepalive), so this only
// bounds the initial HTTP request read + any keep-alive idle gap, never an upgraded WebSocket.
fn _read_timeout_ms(a) -> int
    if contains(a, "read_timeout_ms")
        return a["read_timeout_ms"]
    30000

fn read_timeout(a, ms: int)
    a["read_timeout_ms"] = ms
    a

// Wait for `conn` to become readable before `deadline` (ms epoch). Returns >0 readable, 0 timed out
// (deadline reached or no data in the remaining window), <0 on error. Parks the green task on the
// netpoller (yields the carrier, no busy-poll). Clock = clock_ns()/1e6.
fn _wait_or_timeout(conn, deadline) -> int
    let now = clock_ns() / 1000000
    let remaining = deadline - now
    if remaining <= 0
        return 0
    tcp_wait_readable(conn, remaining)

fn recv_request_bin(conn, timeout_ms)
    let use_to = timeout_ms > 0
    let deadline = (clock_ns() / 1000000) + timeout_ms
    if use_to
        if _wait_or_timeout(conn, deadline) <= 0
            return bytes(0)
    let buf = _append_chunk(bytes(0), tcp_recv_bytes(conn))
    if bytes_len(buf) == 0
        return buf
    let sep = _find_header_end(buf, 0)
    while sep < 0
        if bytes_len(buf) > _max_header()
            return buf
        if use_to
            if _wait_or_timeout(conn, deadline) <= 0
                return bytes(0)
        let more = tcp_recv_bytes(conn)
        if bytes_len(more) == 0
            return buf
        let scanned = bytes_len(buf) - 3
        if scanned < 0
            scanned = 0
        buf = _append_chunk(buf, more)
        sep = _find_header_end(buf, scanned)
    let cl = _content_length(bytes_to_str(bytes_slice(buf, 0, sep)))
    if cl < 0 or cl > _max_body()
        return buf
    while (bytes_len(buf) - (sep + 4)) < cl
        if use_to
            if _wait_or_timeout(conn, deadline) <= 0
                return bytes(0)
        let more = tcp_recv_bytes(conn)
        if bytes_len(more) == 0
            return buf
        buf = _append_chunk(buf, more)
    buf

// Build a Request from the raw message BYTES. Text content-types route through the existing string
// build_request (byte-identical for NUL-free bodies -> the string-body test suite is unaffected).
// multipart/form-data and application/octet-stream build from the header region (body stays "") and the
// binary body is attached as req.raw_body (a NovaBytes). Binary bodies never flow through the string field.
fn _build_req_from_bytes(raw, conn: int) -> Request
    let sep = _find_header_end(raw, 0)
    if sep < 0
        return build_request(bytes_to_str(raw), conn)
    let hdrstr = bytes_to_str(bytes_slice(raw, 0, sep))
    let ctl = lower(hdrstr)
    let is_bin = find(ctl, "multipart/form-data") >= 0 or find(ctl, "application/octet-stream") >= 0
    if is_bin == false
        // Truncate the text body to Content-Length (symmetric with the binary path below) so bytes that
        // arrived past the body -- an over-read or a pipelined next request -- are not folded into req.body.
        let tcl = _content_length(hdrstr)
        if tcl >= 0 and tcl <= _max_body()
            let tend = sep + 4 + tcl
            if tend > bytes_len(raw)
                tend = bytes_len(raw)
            return build_request(bytes_to_str(bytes_slice(raw, 0, tend)), conn)
        return build_request(bytes_to_str(raw), conn)
    let cl = _content_length(hdrstr)
    let req = build_request(bytes_to_str(bytes_slice(raw, 0, sep + 4)), conn)
    if cl >= 0 and cl <= _max_body()
        let bend = sep + 4 + cl
        if bend > bytes_len(raw)
            bend = bytes_len(raw)
        req.raw_body = bytes_slice(raw, sep + 4, bend)
    req

// ── Multipart/form-data parsing (RFC 7578) ────────────────────────────────────────────────────────────
// One decoded part of a multipart body. `data` is a NovaBytes holding the EXACT part payload (the leading
// part headers stripped, the trailing CRLF-before-delimiter excluded). For file parts `filename` is set;
// for plain form fields it is "". `content_type` defaults to "" (text) when the part omits its own.
type Part
    name: string
    filename: string
    content_type: string
    data: any

// Convert an (ASCII) string into a list of its byte codes -- so a hot scan compares ints, not freshly
// allocated 1-char strings. HTTP delimiters/boundaries are ASCII, so ord(char_at) is exact here.
fn _str_codes(s: string) -> list
    let codes = []
    let i = 0
    let n = len(s)
    while i < n
        push(codes, ord(char_at(s, i)))
        i = i + 1
    codes

// find `needle` (an ASCII string) inside `hay` (a string) starting at `start`; -1 if absent. NOVA's `find`
// has no start offset, so slice-then-find and re-add the offset.
fn _find_from(hay: string, needle: string, start: int) -> int
    let s = start
    if s < 0
        s = 0
    if s > len(hay)
        return -1
    let rel = find(slice(hay, s, len(hay)), needle)
    if rel < 0
        return -1
    s + rel

// Find `needle` (an ASCII string) inside the bytes `hay` starting at `start`; returns the byte offset of
// the match or -1. Naive O(n*m) -- fine for HTTP delimiters (boundary ~40B) over an 8MB cap.
fn _bytes_find(hay, needle: string, start: int) -> int
    let nc = _str_codes(needle)
    let m = len(nc)
    let n = bytes_len(hay)
    if m == 0
        return start
    let i = start
    if i < 0
        i = 0
    while i + m <= n
        let j = 0
        let ok = true
        while j < m and ok
            if bytes_get(hay, i + j) != nc[j]
                ok = false
            j = j + 1
        if ok
            return i
        i = i + 1
    -1

// Pull the boundary token out of the RAW (case-preserved) Content-Type header. Boundaries are
// case-SENSITIVE, so this must NOT use the lowercased content_type(req). Returns "" if absent.
fn _extract_boundary(ct_raw: string) -> string
    let key = "boundary="
    let at = find(ct_raw, key)
    if at < 0
        return ""
    let rest = slice(ct_raw, at + len(key), len(ct_raw))
    // boundary runs to the next ';' or end; a quoted boundary ("...") has the quotes stripped.
    let semi = find(rest, ";")
    if semi >= 0
        rest = slice(rest, 0, semi)
    rest = trim(rest)
    // Strip surrounding quotes -- but only drop the TRAILING quote if one is actually there, else an
    // opening-quote-without-close ("abc) would lose its last real byte.
    if len(rest) >= 2 and ord(char_at(rest, 0)) == 34
        if ord(char_at(rest, len(rest) - 1)) == 34
            rest = slice(rest, 1, len(rest) - 1)
        else
            rest = slice(rest, 1, len(rest))
    rest

// Read a quoted attribute (name="value") out of a part's header string. Returns "" if absent.
fn _mp_attr(hdr: string, key: string) -> string
    let needle = key + "=\""
    let at = find(hdr, needle)
    if at < 0
        return ""
    let s = at + len(needle)
    let e = _find_from(hdr, "\"", s)
    if e < 0
        return ""
    slice(hdr, s, e)

// True if any byte in body[a, e) is NUL. A part header carrying an embedded NUL would be truncated by
// bytes_to_str (a C string), letting an attacker hide the real name/filename/content-type after the NUL.
fn _bytes_range_has_nul(body, a: int, e: int) -> bool
    let i = a
    while i < e
        if bytes_get(body, i) == 0
            return true
        i = i + 1
    false

// Parse a multipart/form-data body (a NovaBytes) into a list of Part. The body is split on the delimiter
// "\r\n--{boundary}" (the leading CRLF belongs to the delimiter, NOT the payload -- the #1 multipart bug).
// The first delimiter has no leading CRLF, so we seed the scan with "--{boundary}". The closing delimiter
// is "--{boundary}--". Each part = headers \r\n\r\n payload; payload excludes the trailing CRLF.
fn parse_multipart(body, boundary: string) -> list
    let parts = []
    if bytes_len(body) == 0 or len(boundary) == 0
        return parts
    let dash = "--" + boundary
    // locate the first boundary (may be at offset 0, no leading CRLF)
    let pos = _bytes_find(body, dash, 0)
    if pos < 0
        return parts
    pos = pos + len(dash)
    let mid = "\r\n" + dash
    let guard = 0
    while guard < 100000
        guard = guard + 1
        // after a boundary token comes either "--" (final) or "\r\n" (another part)
        if pos + 2 <= bytes_len(body) and bytes_get(body, pos) == 45 and bytes_get(body, pos + 1) == 45
            return parts
        // skip the CRLF after the boundary token
        let hstart = pos
        if hstart + 2 <= bytes_len(body) and bytes_get(body, hstart) == 13 and bytes_get(body, hstart + 1) == 10
            hstart = hstart + 2
        // part headers end at \r\n\r\n
        let hend = _bytes_find(body, "\r\n\r\n", hstart)
        if hend < 0
            return parts
        // A NUL in the part header truncates bytes_to_str -> name/filename/content-type confusion; reject.
        if _bytes_range_has_nul(body, hstart, hend)
            return parts
        let hdr = bytes_to_str(bytes_slice(body, hstart, hend))
        let body_start = hend + 4
        // payload runs up to the NEXT delimiter "\r\n--{boundary}" (the leading CRLF is excluded)
        let delim = _bytes_find(body, mid, body_start)
        if delim < 0
            return parts
        let p = Part(_mp_attr(hdr, "name"), _mp_attr(hdr, "filename"), _part_ct(hdr), bytes_slice(body, body_start, delim))
        push(parts, p)
        pos = delim + len(mid)
    parts

// Content-Type of a single part ("" if it declares none).
fn _part_ct(hdr: string) -> string
    let low = lower(hdr)
    let at = find(low, "content-type:")
    if at < 0
        return ""
    let s = at + len("content-type:")
    let nl = _find_from(hdr, "\r\n", s)
    let e = nl
    if e < 0
        e = len(hdr)
    trim(slice(hdr, s, e))

// PUBLIC: decode the uploaded parts of a multipart/form-data request. Returns [] for non-multipart
// requests or when the body was not captured (text serve path). Each Part has name / filename /
// content_type / data (a NovaBytes). Available on the typed serve path (serve_req_n / serve_safe_req_n).
fn uploads(req: Request) -> list
    if find(content_type(req), "multipart/form-data") < 0
        return []
    if type_name(req.raw_body) != "bytes"
        return []
    let boundary = _extract_boundary(req_header(req, "content-type"))
    if len(boundary) == 0
        return []
    parse_multipart(req.raw_body, boundary)

// ══ WebSocket (RFC 6455) — pure-NOVA ════════════════════════════════════════════════════════════════════
// The whole protocol is pure NOVA over the already-green-aware byte primitives (tcp_recv_bytes /
// tcp_send_bytes park on the netpoller), so a WS connection is a parked green task — no carrier blocking,
// no new C runtime, no reconverge. NOVA's "channels across ALL boundaries" reaches the live browser wire.
//
// --- SHA-1 (RFC 3174) + base64 for the handshake accept (used ONLY for the WS handshake, never security) ---
fn _ws_m32(x: int) -> int
    x & 4294967295

fn _ws_rotl32(x: int, n: int) -> int
    ((x << n) | (x >> (32 - n))) & 4294967295

// SHA-1 over a byte list (0..255) -> 20-byte digest as a byte list. KAT-verified vs openssl/certutil.
fn ws_sha1_bytes(msg: list) -> list
    let ml = len(msg)
    let m = []
    let i = 0
    while i < ml
        push(m, msg[i] & 255)
        i = i + 1
    push(m, 128)
    while (len(m) % 64) != 56
        push(m, 0)
    let bitlen = ml * 8
    let j = 7
    while j >= 0
        push(m, (bitlen >> (j * 8)) & 255)
        j = j - 1
    let h0 = 1732584193
    let h1 = 4023233417
    let h2 = 2562383102
    let h3 = 271733878
    let h4 = 3285377520
    let nchunks = len(m) / 64
    let c = 0
    while c < nchunks
        let base = c * 64
        let w = []
        let t = 0
        while t < 16
            let o = base + t * 4
            let word = (m[o] << 24) | (m[o + 1] << 16) | (m[o + 2] << 8) | m[o + 3]
            push(w, word & 4294967295)
            t = t + 1
        while t < 80
            let x = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]
            push(w, _ws_rotl32(x, 1))
            t = t + 1
        let a = h0
        let b = h1
        let cc = h2
        let d = h3
        let e = h4
        let r = 0
        while r < 80
            let f = 0
            let k = 0
            if r < 20
                f = (b & cc) | ((b ^ 4294967295) & d)
                k = 1518500249
            else
                if r < 40
                    f = b ^ cc ^ d
                    k = 1859775393
                else
                    if r < 60
                        f = (b & cc) | (b & d) | (cc & d)
                        k = 2400959708
                    else
                        f = b ^ cc ^ d
                        k = 3395469782
            let temp = (_ws_rotl32(a, 5) + (f & 4294967295) + e + k + w[r]) & 4294967295
            e = d
            d = cc
            cc = _ws_rotl32(b, 30)
            b = a
            a = temp
            r = r + 1
        h0 = (h0 + a) & 4294967295
        h1 = (h1 + b) & 4294967295
        h2 = (h2 + cc) & 4294967295
        h3 = (h3 + d) & 4294967295
        h4 = (h4 + e) & 4294967295
        c = c + 1
    let out = []
    let hs = [h0, h1, h2, h3, h4]
    let q = 0
    while q < 5
        let hv = hs[q]
        push(out, (hv >> 24) & 255)
        push(out, (hv >> 16) & 255)
        push(out, (hv >> 8) & 255)
        push(out, hv & 255)
        q = q + 1
    out

fn _ws_b64char(v: int) -> string
    char_at("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", v)

// base64 of a byte list (NUL/high-byte safe).
fn ws_b64_bytes(data: list) -> string
    let n = len(data)
    let out = ""
    let i = 0
    while i + 3 <= n
        let trip = ((data[i] & 255) << 16) | ((data[i + 1] & 255) << 8) | (data[i + 2] & 255)
        out = out + _ws_b64char((trip >> 18) & 63) + _ws_b64char((trip >> 12) & 63) + _ws_b64char((trip >> 6) & 63) + _ws_b64char(trip & 63)
        i = i + 3
    let rem = n - i
    if rem == 1
        let trip = (data[i] & 255) << 16
        out = out + _ws_b64char((trip >> 18) & 63) + _ws_b64char((trip >> 12) & 63) + "=="
    if rem == 2
        let trip = ((data[i] & 255) << 16) | ((data[i + 1] & 255) << 8)
        out = out + _ws_b64char((trip >> 18) & 63) + _ws_b64char((trip >> 12) & 63) + _ws_b64char((trip >> 6) & 63) + "="
    out

// Sec-WebSocket-Accept = base64(sha1(key + RFC6455-GUID)). The GUID ends ...85B11 (NOT 85B16 -- a one-char
// error makes every browser reject the handshake). KAT-verified against the two canonical RFC 6455 examples.
fn ws_compute_accept(key: string) -> string
    ws_b64_bytes(ws_sha1_bytes(_str_codes(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")))

// Reject a malformed/overlong Sec-WebSocket-Key (a valid one is base64 of 16 bytes = 24 chars).
fn ws_key_ok(key: string) -> bool
    len(key) >= 16 and len(key) <= 24

// --- Frame codec (RFC 6455 §5.2) ---
// A decoded frame. status: 0 = need more bytes; 1 = a complete frame is in opcode/fin/payload, `consumed`
// bytes used; negative = a protocol error whose magnitude is the WS close code (1002 protocol, 1009 too big).
type WsFrame
    status: int
    fin: int
    opcode: int
    consumed: int
    payload: any

fn _ws_max_frame() -> int
    16777216

// Build a frame. fin: 1=final. opcode: 1 text, 2 binary, 8 close, 9 ping, 10 pong. mask: [] = server
// (unmasked, per RFC); a 4-byte list = client (masked). Returns the wire bytes (NUL-safe).
fn ws_encode_frame(fin: int, opcode: int, payload, mask: list) -> any
    let n = bytes_len(payload)
    let f = bytes(0)
    let b0 = opcode & 15
    if fin != 0
        b0 = b0 | 128
    f = bytes_append(f, b0)
    let maskbit = 0
    if len(mask) == 4
        maskbit = 128
    if n < 126
        f = bytes_append(f, maskbit | n)
    else
        if n < 65536
            f = bytes_append(f, maskbit | 126)
            f = bytes_append(f, (n >> 8) & 255)
            f = bytes_append(f, n & 255)
        else
            f = bytes_append(f, maskbit | 127)
            let j = 7
            while j >= 0
                f = bytes_append(f, (n >> (j * 8)) & 255)
                j = j - 1
    if len(mask) == 4
        f = bytes_append(f, mask[0] & 255)
        f = bytes_append(f, mask[1] & 255)
        f = bytes_append(f, mask[2] & 255)
        f = bytes_append(f, mask[3] & 255)
    let i = 0
    while i < n
        let bb = bytes_get(payload, i)
        if len(mask) == 4
            bb = bb ^ mask[i & 3]
        f = bytes_append(f, bb)
        i = i + 1
    f

// Try to decode ONE frame from `buf` starting at `start`. Pure parse: handles 7/16/64-bit length, the
// client mask (unmasks in place), the 64-bit MSB-must-be-zero rule (CRIT-5), and the 16MB cap. Returns a
// WsFrame; status 0 means the caller must read more bytes and retry.
fn ws_try_decode(buf, start: int) -> WsFrame
    ws_try_decode_n(buf, start, bytes_len(buf) - start)

// Length-aware decode: `avail` is the count of valid bytes from `start` (decoupled from bytes_len(buf) so
// it works on the fixed over-allocated connection scratch). The payload is sliced (copied) out of buf.
fn ws_try_decode_n(buf, start: int, avail: int) -> WsFrame
    if avail < 2
        return WsFrame(0, 0, 0, 0, 0)
    let b0 = bytes_get(buf, start)
    let b1 = bytes_get(buf, start + 1)
    let fin = 0
    if (b0 & 128) != 0
        fin = 1
    let opcode = b0 & 15
    let masked = (b1 & 128) != 0
    let len7 = b1 & 127
    // RFC 6455 5.2/5.5 validation (rejects only illegal frames -> safe for both the server decode of masked
    // client frames AND a client decode of unmasked server frames, which are always well-formed):
    //   - RSV bits must be 0 (no extension negotiated)
    //   - opcode must be a defined one (0 cont, 1 text, 2 binary, 8 close, 9 ping, 10 pong)
    //   - control frames (opcode>=8) must be <=125 bytes and never fragmented (FIN=1)
    // -1002 = protocol error; _ws_read_message maps a negative status to a Close(abs(status)).
    if (b0 & 112) != 0
        return WsFrame(0 - 1002, 0, 0, 0, 0)
    if opcode != 0 and opcode != 1 and opcode != 2 and opcode != 8 and opcode != 9 and opcode != 10
        return WsFrame(0 - 1002, 0, 0, 0, 0)
    if opcode >= 8
        if len7 > 125 or fin == 0
            return WsFrame(0 - 1002, 0, 0, 0, 0)
    let hdr = 2
    let plen = len7
    if len7 == 126
        if avail < 4
            return WsFrame(0, 0, 0, 0, 0)
        plen = (bytes_get(buf, start + 2) << 8) | bytes_get(buf, start + 3)
        hdr = 4
    else
        if len7 == 127
            if avail < 10
                return WsFrame(0, 0, 0, 0, 0)
            plen = 0
            let kk = 0
            while kk < 8
                plen = (plen << 8) | bytes_get(buf, start + 2 + kk)
                kk = kk + 1
            hdr = 10
    if plen < 0
        return WsFrame(0 - 1002, 0, 0, 0, 0)
    if plen > _ws_max_frame()
        return WsFrame(0 - 1009, 0, 0, 0, 0)
    let maskoff = hdr
    if masked
        hdr = hdr + 4
    let total = hdr + plen
    if avail < total
        return WsFrame(0, 0, 0, 0, 0)
    let payload = bytes_slice(buf, start + hdr, start + hdr + plen)
    if masked
        let m0 = bytes_get(buf, start + maskoff)
        let m1 = bytes_get(buf, start + maskoff + 1)
        let m2 = bytes_get(buf, start + maskoff + 2)
        let m3 = bytes_get(buf, start + maskoff + 3)
        let i = 0
        while i < plen
            let rr = i & 3
            let mk = m0
            if rr == 1
                mk = m1
            if rr == 2
                mk = m2
            if rr == 3
                mk = m3
            bytes_set(payload, i, bytes_get(payload, i) ^ mk)
            i = i + 1
    WsFrame(1, fin, opcode, total, payload)

// --- WebSocket connection: a live, parked green task speaking the framed protocol over the raw fd ---
// A WS connection. open: 1 while live (reference-semantic struct -> mutating open=0 is visible to _ws_run).
// buf: a FIXED-capacity connection-lived scratch (allocated ONCE in Regime B), mutated in place via
// bytes_set (NEVER reallocated) so it survives the per-message arena_exit -- it holds unparsed bytes
// across reads (partial/pipelined frames). blen: count of valid bytes in buf. closed: 1 once we've sent a
// Close frame (idempotency). Per-message allocations live in a per-message arena and are freed wholesale;
// the fixed buf is the only connection-lived heap -> FLAT memory across millions of messages.
type Ws
    fd: int
    open: int
    path: string
    buf: any
    blen: int
    closed: int
    outbound: any
    ka: int          // keepalive interval in ms (0 = disabled); idle reads wake to send a ping
    pings: int       // consecutive unanswered keepalive pings; >2 -> the peer is dead, reap it
    assigns: any     // per-connection scratch dict (ws_assign/ws_get); always a dict {}

fn _ws_bufcap() -> int
    262144

// Per-app WebSocket keepalive interval (ms), read from the app dict (forge.ws_keepalive sets it). 0 = off
// (the default -> the frame read loop is byte-identical to no-keepalive). A server enables dead-client
// detection / proxy-warming with forge.ws_keepalive(app, 30000).
fn _ws_app_ka(a) -> int
    if contains(a, "ws_ka_ms")
        return a["ws_ka_ms"]
    0

// Enable WebSocket keepalive for this app: every connection that goes `ms` idle gets a ping; a peer that
// fails to answer 3 pings is reaped (the read returns EOF, the handler ends, the socket closes).
fn ws_keepalive(a, ms: int)
    a["ws_ka_ms"] = ms

// Is this request a WebSocket upgrade? (RFC 6455 §4.2.1: Upgrade: websocket, Connection contains upgrade,
// a valid Sec-WebSocket-Key, Version 13.)
fn ws_is_upgrade(req: Request) -> bool
    if lower(req_header(req, "upgrade")) != "websocket"
        return false
    if find(lower(req_header(req, "connection")), "upgrade") < 0
        return false
    if req_header(req, "sec-websocket-version") != "13"
        return false
    ws_key_ok(req_header(req, "sec-websocket-key"))

// Register a WebSocket route. handler: fn(ws: Ws, msg) -> unit, called once per inbound message (the msg
// bytes are arena-scoped to the call). Stored in a SEPARATE a["ws_routes"] table so
// the HTTP dispatch path stays byte-identical. The pattern + handler are registered at app-config time
// (active_arena == NULL) so they are connection-lived (non-arena) -- safe to hold across a request arena.
fn ws(a, pattern: string, handler)
    let routes = []
    if contains(a, "ws_routes")
        routes = a["ws_routes"]
    push(routes, [pattern, handler])
    a["ws_routes"] = routes

// Register a BROADCAST/room WebSocket route bound to a `hub` (forge.hub()). handler: fn(ws, msg, hub),
// called per inbound message -- typically calls room_say(hub, ...) to fan a message out to EVERY connection
// on that hub. The framework runs the dual-task model (reader + single writer) and auto-subscribes /
// unsubscribes the connection. A 3-element route [pattern, handler, hub] selects _ws_run_room.
fn ws_room(a, pattern: string, hub, handler)
    let routes = []
    if contains(a, "ws_routes")
        routes = a["ws_routes"]
    push(routes, [pattern, handler, hub])
    a["ws_routes"] = routes

// A room route WITH lifecycle hooks for presence: on_join(ws, hub) fires when a client joins (e.g.
// room_say(hub, "* a user joined *")), on_msg(ws, msg, hub) per message, on_leave(ws, hub) when it
// disconnects. The join broadcast reaches the joiner too; the leave broadcast reaches the rest of the room.
// Route = [pattern, on_msg, hub, on_join, on_leave] (length 5 selects the hook path in _ws_run_room).
fn ws_room_ex(a, pattern: string, hub, on_join, on_msg, on_leave)
    let routes = []
    if contains(a, "ws_routes")
        routes = a["ws_routes"]
    push(routes, [pattern, on_msg, hub, on_join, on_leave])
    a["ws_routes"] = routes

// Find the route ([pattern,handler] or [pattern,handler,hub]) for a ws-upgrade request, or [] if none.
fn _ws_lookup(a, req: Request) -> list
    if not ws_is_upgrade(req)
        return []
    if not contains(a, "ws_routes")
        return []
    let routes = a["ws_routes"]
    let i = 0
    while i < len(routes)
        let rt = routes[i]
        if is_ok(_fr_match(rt[0], req.path))
            return rt
        i = i + 1
    []

// ââ WebSocket join authorization (PRE-101) âââââââââââââââââââââââ
// Authorize a ws upgrade BEFORE the 101 handshake, so an UNAUTHORIZED client never obtains an open
// socket (rejecting pre-upgrade is a clean HTTP 401; revoking an established WS is expensive and racey
// with the reader/writer tasks). This is the MECHANISM only -- crypto-free, so forge.nova stays out of a
// forge_crypto module diamond. The battery authorizers (ws_require_bearer / ws_require_session) live in
// forge_auth and reuse the existing jwt/session/oauth2 helpers. authorizer: fn(req: Request) -> bool.
//
// Stored in a["ws_authz"] (a dict pattern->authorizer) PARALLEL to ws_routes, so the load-bearing
// route-length dispatch ([p,h]=2 plain, [p,h,hub]=3 room, len-5 hooks) is completely untouched.
fn ws_guard(a, pattern: string, authorizer)
    let m = {}
    if contains(a, "ws_authz")
        m = a["ws_authz"]
    m[pattern] = authorizer
    a["ws_authz"] = m

// Secure-by-default (Phoenix-style): after this, any ws upgrade whose pattern has NO registered authorizer
// is REJECTED. Off by default so existing routes keep working; one call opts the whole app in.
fn ws_default_deny(a)
    a["ws_deny_default"] = 1

// True iff the upgrade to `pattern` is allowed: run its authorizer if registered; else reject when
// default-deny is on; else allow (preserves current behavior for unguarded routes). Public so an app can
// pre-check and so the mechanism is unit-testable without a live socket.
fn ws_authz_ok(a, req: Request, pattern: string) -> bool
    if contains(a, "ws_authz")
        let m = a["ws_authz"]
        if contains(m, pattern)
            let authz = m[pattern]
            return authz(req)
    if contains(a, "ws_deny_default")
        return false
    true

// Send the 101 handshake (reads NOTHING from the socket -- the request was already parsed). Returns 1 on
// success, 0 (after a 400) on a bad key. Runs inside the request arena; the 101 bytes are consumed by
// tcp_send before arena_exit.
fn ws_handshake(conn: int, req: Request) -> int
    let key = req_header(req, "sec-websocket-key")
    if ws_key_ok(key) == false
        tcp_send(conn, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
        return 0
    let accept = ws_compute_accept(key)
    let resp = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n"
    tcp_send(conn, resp)
    1

// Fill ws.buf until it holds >= one complete frame, then return that frame DECODED (status 1; the payload
// is sliced -- arena-allocated when called inside the per-message arena). status<0 = EOF (-1) or protocol
// error (-1002 bad frame / -1009 frame exceeds the fixed buffer). Reads via the green-aware (netpoller-
// parking) tcp_recv_bytes and copies into the FIXED buffer via bytes_set (NO reallocation, so ws.buf stays
// connection-lived across the per-message arena boundary). Does NOT consume -- caller calls _ws_consume.
fn _ws_fill_frame(ws: Ws) -> WsFrame
    let guard = 0
    while guard < 2000000000
        guard = guard + 1
        let fr = ws_try_decode_n(ws.buf, 0, ws.blen)
        if fr.status != 0
            return fr
        let do_recv = true
        // KEEPALIVE (opt-in, ws.ka>0): wait for data up to ws.ka ms (parks the green task on the netpoller
        // -- yields the carrier, no busy-poll). On idle, send a ping; a peer that ignores 3 pings is dead ->
        // EOF. When ws.ka==0 this whole block is skipped -> identical to a plain blocking read.
        if ws.ka > 0
            let wr = tcp_wait_readable(ws.fd, ws.ka)
            if wr < 0
                return WsFrame(0 - 1, 0, 0, 0, bytes(0))
            if wr == 0
                ws.pings = ws.pings + 1
                if ws.pings > 2
                    return WsFrame(0 - 1, 0, 0, 0, bytes(0))
                _ws_send_frame(ws, 9, bytes(0))
                do_recv = false
        if do_recv
            let chunk = tcp_recv_bytes(ws.fd)
            let cn = bytes_len(chunk)
            if cn == 0
                return WsFrame(0 - 1, 0, 0, 0, bytes(0))
            if ws.blen + cn > _ws_bufcap()
                return WsFrame(0 - 1009, 0, 0, 0, bytes(0))
            let k = 0
            while k < cn
                bytes_set(ws.buf, ws.blen + k, bytes_get(chunk, k))
                k = k + 1
            ws.blen = ws.blen + cn
            ws.pings = 0   // got data (incl. a pong) -> the peer is alive; reset the keepalive counter
    WsFrame(0 - 1, 0, 0, 0, bytes(0))

// Drop the first `n` bytes of ws.buf, compacting the leftover to the front IN PLACE (bytes_set, no alloc).
fn _ws_consume(ws: Ws, n: int)
    let rem = ws.blen - n
    let k = 0
    while k < rem
        bytes_set(ws.buf, k, bytes_get(ws.buf, n + k))
        k = k + 1
    ws.blen = rem

// Read ONE complete frame and consume it from the buffer. status 1 = frame in opcode/fin/payload; <0 sentinel.
fn _ws_next_frame(ws: Ws) -> WsFrame
    let fr = _ws_fill_frame(ws)
    if fr.status == 1
        _ws_consume(ws, fr.consumed)
    fr

// Send a server frame (FIN, unmasked per RFC). In room/broadcast mode (ws.outbound set) ALL writes are
// routed to the single writer task via the outbound channel -- the SOLE socket writer -- so concurrent
// broadcasts and the reader's own pong/close frames can never interleave on the wire (the single-writer
// rule). channel send deep-copies, so routing an arena-scoped payload to the writer is sound. In basic
// mode (outbound==0) the reader writes the socket directly.
fn _ws_send_frame(ws: Ws, opcode: int, payload) -> int
    if ws.outbound != 0
        send(ws.outbound, [opcode, payload])
        return 0
    tcp_send_bytes(ws.fd, ws_encode_frame(1, opcode, payload, []))

// Send a Close frame with a 2-byte status code (idempotent: only the first call sends).
fn _ws_send_close(ws: Ws, code: int) -> int
    if ws.closed == 1
        return 0
    ws.closed = 1
    let p = bytes(0)
    p = bytes_append(p, (code >> 8) & 255)
    p = bytes_append(p, code & 255)
    _ws_send_frame(ws, 8, p)

// Read the next complete application message (reassembling fragments, answering pings, bounding control
// frames -- CRIT-2 a bounded WHILE loop, never recursion). Returns the message bytes; sets ws.open=0 and
// returns whatever is assembled on close/EOF/error. On a protocol error or oversize, replies Close.
fn _ws_read_message(ws: Ws) -> any
    if ws.open == 0
        return bytes(0)
    let assembled = bytes(0)
    let ctrl = 0
    let maxm = _ws_max_frame()
    let guard = 0
    while guard < 2000000000
        guard = guard + 1
        let fr = _ws_next_frame(ws)
        if fr.status != 1
            ws.open = 0
            if fr.status < 0 and fr.status != (0 - 1)
                _ws_send_close(ws, 0 - fr.status)
            return assembled
        let op = fr.opcode
        if op == 8
            ws.open = 0
            _ws_send_close(ws, 1000)
            return assembled
        if op == 9
            _ws_send_frame(ws, 10, fr.payload)
            ctrl = ctrl + 1
            if ctrl > 32
                ws.open = 0
                _ws_send_close(ws, 1008)
                return assembled
        else
            if op == 10
                ctrl = ctrl + 1
                if ctrl > 32
                    ws.open = 0
                    _ws_send_close(ws, 1008)
                    return assembled
            else
                ctrl = 0
                if bytes_len(assembled) + bytes_len(fr.payload) > maxm
                    ws.open = 0
                    _ws_send_close(ws, 1009)
                    return assembled
                assembled = bytes_concat(assembled, fr.payload)
                if fr.fin == 1
                    return assembled
    assembled

// ── Public WS handler verbs (distinct names from the C ws_* builtins to avoid resolution collisions) ──
// Messages are PUSHED to the handler fn(ws, msg_bytes) per inbound message (Phoenix-style), so there is no
// pull verb -- the per-message arena needs the message lifetime bounded by the callback.
// Send a text message.
fn ws_emit(ws: Ws, msg: string) -> int
    _ws_send_frame(ws, 1, str_to_bytes(msg))

// Send a binary message (NUL-safe).
fn ws_emit_bin(ws: Ws, data) -> int
    _ws_send_frame(ws, 2, data)

// Is the connection still open?
fn ws_open(ws: Ws) -> bool
    ws.open == 1

// Initiate a clean close (send Close 1000); the drain + fd close happen in _ws_finish.
fn ws_done(ws: Ws)
    _ws_send_close(ws, 1000)
    ws.open = 0

// ── Socket assigns (T5.3): per-connection scratch storage on the Ws value ───────────────────────
// Stored in ws.assigns (a dict {}), which is a reference-semantic field on the reference-semantic Ws
// struct -- mutations are visible everywhere the Ws is held. Set at any point in a handler;
// retrieved with ws_get (returns "" if the key was never set).
fn ws_assign(ws: Ws, key: string, val: string)
    ws.assigns[key] = val

// Retrieve a value previously set with ws_assign. Returns "" when the key is absent.
fn ws_get(ws: Ws, key: string) -> string
    if contains(ws.assigns, key)
        return ws.assigns[key]
    ""

// Create a mock Ws with an empty assigns dict and an invalid (zero) fd. The fd is unusable for
// actual I/O (no open socket); only ws_assign/ws_get are safe to call on the result. Intended for
// unit tests that want to verify assigns logic without opening a real socket connection.
fn ws_mock() -> Ws
    Ws(0, 0, "", bytes(0), 0, 0, 0, 0, 0, {})

// Two-phase close (CRIT-4): send Close, drain a bounded number of frames awaiting the peer's Close (so the
// peer's buffered data isn't RST-dropped), then close the fd EXACTLY once (CONCERN-3: _ws_run is the sole
// owner of tcp_close -- _serve_conn returns without falling through to its tcp_close).
fn _ws_finish(ws: Ws)
    _ws_send_close(ws, 1000)
    let tries = 0
    while tries < 8
        let fr = _ws_next_frame(ws)
        if fr.status != 1
            tries = 8
        else
            if fr.opcode == 8
                tries = 8
            else
                tries = tries + 1
    tcp_close(ws.fd)

// Own the connection for its lifetime. PRECONDITION: active_arena == NULL (the caller arena_exit'd before
// this). EACH inbound message is processed inside its OWN per-message arena: the message bytes, decoded
// frame payloads, the reassembly buffer, and the handler's response frame are ALL arena-allocated and
// freed wholesale at arena_exit -> FLAT memory across millions of messages (the only connection-lived heap
// is the fixed ws.buf scratch). route[0]=pattern (sets ws.path), route[1]=handler fn(ws, msg_bytes).
// Single owner of the fd close. The msg is valid ONLY during the handler call (arena-scoped); to retain
// it, send it on a channel (deep-copied) or emit it immediately.
fn _ws_run(conn: int, route, ka: int)
    // route of length 6 [pattern,view_fn,update_fn,init_fn,statics,"live"] = a LiveView route.
    if len(route) == 6
        _ws_run_live(conn, route, ka)
        return
    // route of length 3 ([pattern,handler,hub]) OR 5 ([pattern,on_msg,hub,on_join,on_leave]) = a room route.
    if len(route) >= 3
        _ws_run_room(conn, route, ka)
        return
    // CONNECTION-scoped arena (plain path only -- this path is fully self-contained: no hub/writer-task
    // references the connection's state, so everything it allocates can be freed wholesale at close). The
    // connection-lived Ws + ws.buf live here and SURVIVE the nested per-message arena_exits (verified: an
    // inner arena_exit frees only inner allocations). _ws_finish (close + frame drain) also runs in this
    // arena. At connection close, arena_exit(cprev) reclaims ALL of it -> flat memory across connection
    // churn (fixes the ~90-objects/connection leak: _ws_run/_ws_finish previously ran with NO arena, and
    // scope-exit RC is unimplemented, so connection-lived allocations were never reclaimed). The room/live
    // paths are NOT wrapped: their per-connection `outbound` channel is referenced by the hub/writer task
    // and MUST outlive the frame loop, so a connection arena there would free a still-referenced channel.
    let cprev = arena_enter()
    let ws = Ws(conn, 1, route[0], bytes(_ws_bufcap()), 0, 0, 0, ka, 0, {})
    let handler = route[1]
    while ws.open == 1
        let prev = arena_enter()
        let msg = _ws_read_message(ws)
        if ws.open == 1
            handler(ws, msg)
        arena_exit(prev)
    _ws_finish(ws)
    arena_exit(cprev)

// ── LiveView WebSocket runner (per-connection live view over the socket) ──────────────────────────────
// Register a LiveView route: on connect the server PUSHES a mount frame (statics once + initial
// dynamics); thereafter each inbound client event (a text frame, a string) drives update_fn -> view_fn
// -> a minimal patch frame. view_fn(state) -> dynamics list; update_fn(state, ev) -> the next (FRESH)
// state; init_fn() -> the initial state; statics = the constant markup parts (len == len(dynamics)+1).
// The route is length 6 so _ws_run dispatches it to _ws_run_live (distinct from basic(2)/room(3)/ex(5)).
fn live_ws(a, pattern: string, view_fn, update_fn, init_fn, statics)
    let routes = []
    if contains(a, "ws_routes")
        routes = a["ws_routes"]
    push(routes, [pattern, view_fn, update_fn, init_fn, statics, "live"])
    a["ws_routes"] = routes

// Bridge the driver's STRING wire frames to the single socket writer (as text frames). The driver +
// this pump are the only producers for `outbound` besides the close sentinel. Stops on "__pump_stop__"
// (sent once after the reader loop ends); a real wire frame is JSON and never equals that sentinel.
fn _live_frame_pump(frames, outbound)
    let running = 1
    while running == 1
        let f = receive(frames)
        if f == "__pump_stop__"
            running = 0
        else
            send(outbound, [1, str_to_bytes(f)])

// Own a LiveView connection for its lifetime. The connection's STATE lives inside the spawned live_conn
// process (NOT this reader's per-message arena, which is freed each arena_exit). A single writer task
// owns the socket + the fd close (single-writer rule); live_conn emits string frames; _live_frame_pump
// bridges them to the writer. This reader forwards each client message (an event string) to live_conn.
fn _ws_run_live(conn: int, route, ka: int)
    let outbound = channel_bounded(256)
    let ws = Ws(conn, 1, route[0], bytes(_ws_bufcap()), 0, 0, outbound, ka, 0, {})
    let view_fn = route[1]
    let update_fn = route[2]
    let init_fn = route[3]
    let statics = route[4]
    spawn _ws_writer(conn, outbound)
    let events = channel()
    let frames = channel()
    let init_state = init_fn()
    spawn live_conn(statics, view_fn, update_fn, init_state, events, frames)
    spawn _live_frame_pump(frames, outbound)
    while ws.open == 1
        let prev = arena_enter()
        let msg = _ws_read_message(ws)
        if ws.open == 1
            send(events, bytes_to_str(msg))
        arena_exit(prev)
    send(events, "__stop__")
    send(frames, "__pump_stop__")
    send(outbound, [0 - 1, 0])

// ── WebSocket broadcast / rooms (dual-task fan-out) ─────────────────────────────────────────────────
// The single writer task for a connection: the SOLE socket writer. It drains the outbound channel (fed by
// the hub's broadcasts AND the reader's routed pong/close frames) and writes each as a WS frame. An item is
// [opcode, payload] (opcode 1 text / 2 binary / 8 close / 10 pong), or [-1, 0] = stop -> close the fd once.
fn _ws_writer(fd: int, outbound)
    let running = true
    while running
        let item = recv(outbound)
        if item[0] == (0 - 1)
            running = false
        else
            let prev = arena_enter()
            tcp_send_bytes(fd, ws_encode_frame(1, item[0], item[1], []))
            arena_exit(prev)
    tcp_close(fd)

// Room runner: a per-connection READER (this task) + a spawned WRITER, joined by the hub. The reader reads
// frames and calls handler(ws, msg, hub) (which typically broadcasts via hub_pub); every outbound frame is
// routed through ws.outbound to the single writer (no interleaving). On disconnect: unsubscribe from the
// hub and stop the writer (which owns the fd close). route = [pattern, handler, hub].
fn _ws_run_room(conn: int, route, ka: int)
    let hub = route[2]
    // bounded outbound: caps how many broadcasts can queue for THIS connection's writer. If the client
    // stops reading, its writer stalls, the queue fills, and the hub's try_send drops further broadcasts
    // to it -- so one slow client can't grow memory unbounded or stall the room.
    let outbound = channel_bounded(256)
    let ws = Ws(conn, 1, route[0], bytes(_ws_bufcap()), 0, 0, outbound, ka, 0, {})
    let handler = route[1]
    let has_hooks = len(route) >= 5
    hub_sub(hub, conn, outbound)
    spawn fn()
        _ws_writer(conn, outbound)
    // lifecycle: on_join fires AFTER subscribe + writer spawn (so its broadcast reaches this client too)
    if has_hooks
        let pj = arena_enter()
        let on_join = route[3]
        on_join(ws, hub)
        arena_exit(pj)
    while ws.open == 1
        let prev = arena_enter()
        let msg = _ws_read_message(ws)
        if ws.open == 1
            handler(ws, msg, hub)
        arena_exit(prev)
    // lifecycle: on_leave fires while still subscribed (its broadcast reaches the rest of the room)
    if has_hooks
        let pl = arena_enter()
        let on_leave = route[4]
        on_leave(ws, hub)
        arena_exit(pl)
    // disconnect: stop receiving broadcasts, then tell the writer to flush + close the socket (single owner)
    hub_unsub(hub, conn)
    send(outbound, [0 - 1, 0])

// Broadcast a TEXT message to every subscriber of `hub` (each connection's writer sends it as a text frame).
fn room_say(hub, text: string)
    hub_pub(hub, [1, str_to_bytes(text)])

// Broadcast BINARY bytes to every subscriber of `hub`.
fn room_say_bin(hub, data)
    hub_pub(hub, [2, data])

// ── Server-Sent Events (SSE) ────────────────────────────────────────────────────────────────────────
// HTTP server->client streaming (live dashboards / notifications), powered by the SAME pub/sub hub. A GET
// to an sse route becomes a long-lived text/event-stream: the connection subscribes to the hub and writes
// every published STRING as "data: <msg>\n\n". Simpler than WebSockets (no handshake/framing, one-way), no
// new protocol. NOTE: give SSE its own hub (it publishes plain strings; ws_room publishes [opcode,bytes]).
// Register an SSE endpoint bound to `hub`. publish with sse_send(hub, text).
fn sse(a, pattern: string, hub)
    sse_every(a, pattern, hub, 15000)

// Register an SSE endpoint with an explicit keepalive interval (ms, 0 = none). On `ka_ms` of idle the stream
// emits an SSE comment line: it keeps proxies from dropping the connection AND reaps a silently-dead client
// (the comment send fails -> the stream exits + unsubscribes). Route = [pattern, hub, ka_ms].
fn sse_every(a, pattern: string, hub, ka_ms: int)
    let routes = []
    if contains(a, "sse_routes")
        routes = a["sse_routes"]
    push(routes, [pattern, hub, ka_ms])
    a["sse_routes"] = routes

// A sentinel value the per-connection keepalive ticker sends on the outbound channel -- distinguished from
// real published events (which are plain text). The leading NUL makes a collision with real data impossible.
fn _sse_ka_marker() -> string
    chr(0) + "__forge_sse_keepalive__"

// Per-connection keepalive ticker: every `ka` ms, nudge the stream's outbound channel so the (otherwise
// idle) stream loop wakes to emit a comment (and thereby notices a dead peer). sleep() PARKS the green task
// (yields the carrier -- no busy-poll, no netpoller starvation). Stops when the stream loop signals `stopch`.
fn _sse_ticker(outbound, stopch, ka: int)
    let alive = true
    while alive
        sleep(ka)
        let s = try_recv(stopch)
        if s[0] == 1
            alive = false
        else
            try_send(outbound, _sse_ka_marker())

// Find the route [pattern, hub, ka_ms] for a GET matching an sse route, or [] if none. Returned is non-arena.
fn _sse_lookup(a, req: Request) -> list
    if req.method != "GET"
        return []
    if not contains(a, "sse_routes")
        return []
    let routes = a["sse_routes"]
    let i = 0
    while i < len(routes)
        let rt = routes[i]
        if is_ok(_fr_match(rt[0], req.path))
            return rt
        i = i + 1
    []

// Run an SSE stream: send the event-stream headers, subscribe to the hub, then stream each published string
// as an SSE event. The sole socket writer (server->client only). PRECONDITION: active_arena == NULL (caller
// arena_exit'd). On a failed send (client gone) it unsubscribes and closes the fd (single owner). A client
// disconnect is detected on the NEXT publish (recv blocks on the hub) -- keepalive/idle-timeout is a tracked
// follow-up (needs the timed netpoller park). Per-message arena keeps the format+send buffers flat.
fn _sse_run(conn: int, route)
    let hub = route[1]
    let ka = route[2]
    tcp_send(conn, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\n\r\n")
    let outbound = channel_bounded(256)
    let stopch = channel()
    hub_sub(hub, conn, outbound)
    // keepalive ticker (opt-in, ka>0): wakes the idle stream every ka ms so it emits a comment and notices
    // a dead peer. The marker is sent on the SAME outbound channel and filtered out below.
    if ka > 0
        spawn fn()
            _sse_ticker(outbound, stopch, ka)
    let alive = true
    while alive
        let prev = arena_enter()
        let msg = recv(outbound)
        let n = 1
        if msg == _sse_ka_marker()
            n = tcp_send(conn, ":ka" + chr(10) + chr(10))
        else
            n = tcp_send(conn, sse_format(msg))
        arena_exit(prev)
        if n <= 0
            alive = false
    hub_unsub(hub, conn)
    if ka > 0
        send(stopch, 1)
    tcp_close(conn)

// Publish a plain-text SSE event to all subscribers of `hub`.
fn sse_send(hub, msg: string)
    hub_pub(hub, msg)

// Format a message as a complete SSE event's data block, INJECTION-SAFELY: each line of `msg` gets its own
// "data: " prefix (per the EventSource spec), then a blank line terminates the event. A newline embedded in
// `msg` (e.g. user data echoed into a stream) therefore becomes another data line -- it can NOT split the
// event early or inject SSE fields (event:/id:/retry:). CR, LF and CRLF are each treated as one line break.
fn sse_format(msg: string) -> string
    let out = "data: "
    let i = 0
    let n = len(msg)
    while i < n
        let c = msg[i]
        if c == "\r"
            out = out + "\ndata: "
            if i + 1 < n and msg[i + 1] == "\n"
                i = i + 1
        else if c == "\n"
            out = out + "\ndata: "
        else
            out = out + c
        i = i + 1
    out + "\n\n"

// ── Chunked / streaming HTTP responses (Transfer-Encoding: chunked, RFC 7230) ─────────────────────────
// Stream a response whose total length isn't known up front (a generated report, a large or incremental
// body) without buffering it all in memory. A GET to a stream route hijacks the connection (like ws/sse),
// sends chunked headers, runs the producer -- which calls forge.send_chunk(conn, data) any number of times
// -- then writes the terminating 0-chunk and closes. Pure-NOVA chunk framing (no runtime add).
fn _hexdigit(d: int) -> string
    char_at("0123456789abcdef", d)

// bare lowercase hex of a non-negative int (the chunk-size line; no "0x" prefix per the spec)
fn _to_hex(n: int) -> string
    if n == 0
        return "0"
    let s = ""
    let v = n
    while v > 0
        s = _hexdigit(v & 15) + s
        v = v >> 4
    s

// Register a chunked-streaming route. ctype = Content-Type. producer: fn(conn) -> unit, which calls
// forge.send_chunk(conn, data) to emit each chunk. Route = [pattern, producer, ctype].
fn stream(a, pattern: string, ctype: string, producer)
    let routes = []
    if contains(a, "stream_routes")
        routes = a["stream_routes"]
    push(routes, [pattern, producer, ctype])
    a["stream_routes"] = routes

// Find the [pattern, producer, ctype] for a GET matching a stream route, or [] if none.
fn _stream_lookup(a, req: Request) -> list
    if req.method != "GET"
        return []
    if not contains(a, "stream_routes")
        return []
    let routes = a["stream_routes"]
    let i = 0
    while i < len(routes)
        let rt = routes[i]
        if is_ok(_fr_match(rt[0], req.path))
            return rt
        i = i + 1
    []

// Emit one chunk: "<hexlen>\r\n<data>\r\n" (RFC 7230). Empty data is skipped (a 0-length chunk would end
// the response prematurely). Returns the tcp_send result (<= 0 means the client is gone).
fn send_chunk(conn: int, data: string) -> int
    if len(data) == 0
        return 1
    tcp_send(conn, _to_hex(len(data)) + "\r\n" + data + "\r\n")

// Emit one BINARY chunk. The chunk length is byte-exact (bytes_len), so this streams arbitrary binary --
// generated files, images, NUL bytes included (which a string cannot hold). The whole frame is built as one
// bytes buffer and sent atomically. Empty data skipped. Returns the tcp_send_bytes result.
fn send_chunk_bin(conn: int, data) -> int
    let n = bytes_len(data)
    if n == 0
        return 1
    let frame = str_to_bytes(_to_hex(n) + "\r\n")
    frame = bytes_concat(frame, data)
    frame = bytes_concat(frame, str_to_bytes("\r\n"))
    tcp_send_bytes(conn, frame)

// Run a chunked stream: send the chunked headers, run the producer (it emits chunks via send_chunk), then
// the terminating 0-chunk, then close. PRECONDITION: active_arena == NULL (caller arena_exit'd). Sole owner
// of tcp_close.
fn _stream_run(conn: int, route)
    let producer = route[1]
    let ctype = route[2]
    tcp_send(conn, "HTTP/1.1 200 OK\r\nContent-Type: " + ctype + "\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n")
    producer(conn)
    tcp_send(conn, "0\r\n\r\n")
    tcp_close(conn)

// ── Pub/sub hub ─────────────────────────────────────────────────────────────────────────────────────
// A general fan-out hub: a daemon green task owns a registry of subscriber channels (NOT shared memory --
// green tasks are deep-copy isolated; the registry lives inside the hub task and is mutated only there).
// Subscribers register/unregister and publish by SENDING commands to the hub's command channel (which IS
// shared across tasks, like any channel). A command is [op, id, payload]: ["sub", id, outbound_channel]
// (channel-of-channels), ["pub", from_id, msg] (msg fanned out to every subscriber's outbound channel),
// ["unsub", id, 0]. This is the spine of WS broadcast and is reusable for SSE / internal eventing.
fn _hub_loop(cmd)
    let ids = []
    let subs = []
    let alive = true
    while alive
        let c = recv(cmd)
        let op = c[0]
        if op == "pub"
            // try_send (non-blocking): a slow/dead subscriber whose bounded outbound is FULL gets the
            // message DROPPED rather than back-pressuring the hub and stalling broadcasts to everyone else
            // (the standard slow-consumer policy). Fast subscribers never fill -> identical to a blocking send.
            let i = 0
            while i < len(subs)
                try_send(subs[i], c[2])
                i = i + 1
        else
            if op == "sub"
                push(ids, c[1])
                push(subs, c[2])
            else
                if op == "unsub"
                    let nids = []
                    let nsubs = []
                    let j = 0
                    while j < len(ids)
                        if ids[j] != c[1]
                            push(nids, ids[j])
                            push(nsubs, subs[j])
                        j = j + 1
                    ids = nids
                    subs = nsubs
                else
                    if op == "count"
                        // request/reply: c[1] is a reply channel; answer with the live subscriber count
                        send(c[1], len(ids))
                    else
                        if op == "stop"
                            alive = false

// Create a hub. Returns its command channel (pass to hub_sub/hub_pub/hub_unsub).
fn hub()
    let cmd = channel()
    spawn fn()
        _hub_loop(cmd)
    cmd

// Subscribe `outbound` (a channel the subscriber recv's on) under `id`. The hub will send every published
// message to `outbound`.
fn hub_sub(h, id: int, outbound)
    send(h, ["sub", id, outbound])

// Publish `msg` to every current subscriber.
fn hub_pub(h, msg)
    send(h, ["pub", 0, msg])

// Unsubscribe `id` (its channel is dropped from the registry).
fn hub_unsub(h, id: int)
    send(h, ["unsub", id, 0])

// Current subscriber count (request/reply over the hub command channel). Useful for presence -- a chat's
// "N users online", or monitoring an SSE fan-out. Blocks briefly until the hub answers.
fn hub_count(h) -> int
    let reply = channel()
    send(h, ["count", reply, 0])
    recv(reply)

// Stop the hub daemon task (for clean shutdown / tests).
fn hub_stop(h)
    send(h, ["stop", 0, 0])

// ── Pubsub topic bus (T5.1/T5.2): topic-isolated fan-out ────────────────────────────────────────
// A general-purpose publish/subscribe bus where each subscriber registers for a NAMED topic. A
// publish to "room:a" reaches ONLY subscribers for "room:a" -- never those for "room:b". Isolation
// is the fundamental correctness invariant. Backed by a single-owner actor (same pattern as _hub_loop):
// all state lives inside the daemon task; callers communicate via channel messages. This means the
// topic registry is never shared memory and requires no locks even under N>1 carriers.
//
// State inside the actor:
//   topics: dict  topic_name -> list of outbound channels
//
// Command protocol: [op, topic, payload]
//   ["sub",   topic, outbound_channel]   -- add subscriber
//   ["pub",   topic, msg]               -- fan-out msg to all subs of topic
//   ["unsub", topic, outbound_channel]  -- remove specific subscriber (by identity)
//   ["topics",reply_channel, 0]         -- reply with list of known topic names
//   ["count", [topic, reply_ch], 0]     -- reply with subscriber count for a topic
//   ["stop",  0, 0]                     -- shut down the actor
fn _pubsub_loop(cmd)
    let topics = {}
    let alive = true
    while alive
        let c = recv(cmd)
        let op = c[0]
        if op == "pub"
            let t = c[1]
            let msg = c[2]
            if contains(topics, t)
                let subs = topics[t]
                let i = 0
                while i < len(subs)
                    try_send(subs[i], msg)
                    i = i + 1
        else
            if op == "sub"
                let t = c[1]
                let outbound = c[2]
                let subs = []
                if contains(topics, t)
                    subs = topics[t]
                push(subs, outbound)
                topics[t] = subs
            else
                if op == "unsub"
                    let t = c[1]
                    let outbound = c[2]
                    if contains(topics, t)
                        let cur = topics[t]
                        let nxt = []
                        let j = 0
                        while j < len(cur)
                            if cur[j] != outbound
                                push(nxt, cur[j])
                            j = j + 1
                        topics[t] = nxt
                else
                    if op == "topics"
                        let reply = c[1]
                        let names = keys(topics)
                        send(reply, names)
                    else
                        if op == "count"
                            let pair = c[1]
                            let t = pair[0]
                            let reply = pair[1]
                            let cnt = 0
                            if contains(topics, t)
                                cnt = len(topics[t])
                            send(reply, cnt)
                        else
                            if op == "stop"
                                alive = false

// Create a pubsub bus. Returns its command channel (pass to pubsub_sub/pubsub_pub/pubsub_unsub).
fn pubsub() -> any
    let cmd = channel()
    spawn fn()
        _pubsub_loop(cmd)
    cmd

// Subscribe `outbound` channel to `topic`. Future pubsub_pub(ps, topic, msg) will deliver msg here.
fn pubsub_sub(ps, topic: string, outbound)
    send(ps, ["sub", topic, outbound])

// Publish `msg` to ONLY the subscribers of `topic`. Subscribers on other topics are NOT reached.
fn pubsub_pub(ps, topic: string, msg)
    send(ps, ["pub", topic, msg])

// Unsubscribe `outbound` from `topic`.
fn pubsub_unsub(ps, topic: string, outbound)
    send(ps, ["unsub", topic, outbound])

// Returns the list of all known topic names (request/reply).
fn pubsub_topics(ps) -> any
    let reply = channel()
    send(ps, ["topics", reply, 0])
    recv(reply)

// Returns the subscriber count for `topic` (request/reply).
fn pubsub_count(ps, topic: string) -> int
    let reply = channel()
    send(ps, ["count", [topic, reply], 0])
    recv(reply)

// Stop the pubsub daemon task.
fn pubsub_stop(ps)
    send(ps, ["stop", 0, 0])

// ── Presence with metadata (T5.7/T5.8) ──────────────────────────────────────────────────────────
// Track who is present in each topic WITH associated metadata. More capable than forge_otp.presence
// (which tracks only a bare who-string). Here each entry is keyed by (topic, key) and carries an
// arbitrary meta dict. Useful for "user u1 is in room X, meta={name:'Ada', color:'blue'}".
//
// State inside the actor:
//   topics: dict  topic_name -> dict { key -> meta }
//
// Command protocol: [op, [topic, key, meta/reply]]
//   ["track",   [topic, key, meta], 0]
//   ["untrack", [topic, key, 0], 0]
//   ["list",    [topic, reply], 0]       -- reply with dict of key->meta for topic
//   ["stop",    0, 0]
fn _presence_meta_loop(cmd)
    let topics = {}
    let alive = true
    while alive
        let c = recv(cmd)
        let op = c[0]
        if op == "track"
            let args = c[1]
            let t = args[0]
            let k = args[1]
            let meta = args[2]
            let entries = {}
            if contains(topics, t)
                entries = topics[t]
            entries[k] = meta
            topics[t] = entries
        else
            if op == "untrack"
                let args = c[1]
                let t = args[0]
                let k = args[1]
                if contains(topics, t)
                    let entries = topics[t]
                    del(entries, k)
                    topics[t] = entries
            else
                if op == "list"
                    let args = c[1]
                    let t = args[0]
                    let reply = args[1]
                    let result = {}
                    if contains(topics, t)
                        result = topics[t]
                    send(reply, result)
                else
                    if op == "stop"
                        alive = false

// Create a presence tracker with metadata. Returns its command channel.
fn presence() -> any
    let cmd = channel()
    spawn fn()
        _presence_meta_loop(cmd)
    cmd

// Track key in topic with associated meta dict. Idempotent: re-tracking updates the meta.
fn presence_track(pr, topic: string, key: string, meta)
    send(pr, ["track", [topic, key, meta], 0])

// Remove key from topic.
fn presence_untrack(pr, topic: string, key: string)
    send(pr, ["untrack", [topic, key, 0], 0])

// Returns the dict of { key -> meta } for all present entries in topic. Empty dict if nobody present.
fn presence_list(pr, topic: string) -> any
    let reply = channel()
    send(pr, ["list", [topic, reply], 0])
    recv(reply)

// Stop the presence actor.
fn presence_stop(pr)
    send(pr, ["stop", 0, 0])

fn _handle_one(conn: int, handler)
    let req = recv_request(conn)
    let m = parse_method(req)
    let p = parse_path(req)
    let b = parse_body(req)
    let resp = handler(m, p, b)
    tcp_send(conn, resp)
    tcp_close(conn)

fn serve(port: int, handler)
    let listener = tcp_listen(port)
    while true
        let conn = tcp_accept(listener)
        _handle_one(conn, handler)

fn serve_n(port: int, handler, n: int)
    let listener = tcp_listen(port)
    let i = 0
    while i < n
        let conn = tcp_accept(listener)
        _handle_one(conn, handler)
        i = i + 1
    tcp_close(listener)

// Arena-scoped per-request handling. Everything a request allocates (the raw request,
// the parsed parts, and everything the handler builds) lives in a per-request arena
// that is freed WHOLESALE after the response is written -- flat memory, zero per-object
// RC, cycle-immune. arena_exit comes AFTER tcp_send because tcp_send copies the response
// bytes into the socket, so `resp` is not needed past the send. The arena is per-task
// (NovaTaskState), so this is safe even when the server runs as a green task that parks
// on tcp_recv while other tasks run.
//
// CONTRACT: sound ONLY for handlers that do not RETAIN request-derived values in
// longer-lived storage (e.g. a module-global cache or another process's state without
// copying). A handler that stashes a built value in a global would leave a dangling
// pointer after arena_exit. Stateless / pure-response handlers (the common case) are
// safe; stateful handlers should use serve_n (RC) or copy escaping values out first.
fn _handle_one_arena(conn: int, handler)
    let prev = arena_enter()
    let req = recv_request(conn)
    let m = parse_method(req)
    let p = parse_path(req)
    let b = parse_body(req)
    let resp = handler(m, p, b)
    tcp_send(conn, resp)
    arena_exit(prev)
    tcp_close(conn)

fn serve_n_arena(port: int, handler, n: int)
    let listener = tcp_listen(port)
    let i = 0
    while i < n
        let conn = tcp_accept(listener)
        _handle_one_arena(conn, handler)
        i = i + 1
    tcp_close(listener)

fn serve_arena(port: int, handler)
    let listener = tcp_listen(port)
    while true
        let conn = tcp_accept(listener)
        _handle_one_arena(conn, handler)

// ── v0.2 additions ───────────────────────────────────────────────────────

// CORS wrapper. Inserts Access-Control-* headers before the blank-line
// boundary in a response built by text/html/json. Returns the new
// response string. Safe to chain.
fn with_cors(resp: string, origin: string) -> string
    let marker = "\r\n\r\n"
    let i = find(resp, marker)
    if i < 0
        return resp
    let head = slice(resp, 0, i)
    let body = slice(resp, i + 4, len(resp))
    let extra = "\r\nAccess-Control-Allow-Origin: " + origin + "\r\nAccess-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS\r\nAccess-Control-Allow-Headers: Content-Type"
    head + extra + marker + body

// Status helpers - common cases without remembering codes.
fn ok_text(body: string) -> string
    text(200, body)

fn ok_json(body: string) -> string
    json(200, body)

fn ok_html(body: string) -> string
    html(200, body)

fn bad_request(msg: string) -> string
    text(400, msg)

fn not_found(msg: string) -> string
    text(404, msg)

fn internal_error(msg: string) -> string
    text(500, msg)

// CORS preflight responder. Use for OPTIONS requests.
fn cors_preflight(origin: string) -> string
    let r = text(204, "")
    with_cors(r, origin)

// ── Forge Router (v0.3 increment 1) ─────────────────────────────────────────
// A real method + path router with :param extraction, dispatched INSIDE an arena
// scope (serve_app_n -> serve_n_arena) so each request holds flat per-request memory.
//
//   let a = forge.app()
//   forge.get(a, "/users/:id", fn(req) forge.json_obj(200, [["id", req["params"]["id"]]]))
//   forge.serve_app_n(a, 8080, 100)
//
// Handler = fn(req) -> response string, where req is a dict:
//   req["method"]  req["path"]  req["body"]  req["params"]["id"]
//
// HONEST SCOPE (FORGE_DESIGN.md s4.3): responses use the WORKING serialization paths
// (forge.json / json_obj / text). Returning a BARE STRUCT ("return user") is NOT yet
// supported -- it needs the auto-JSON-on-return compiler hook (the "correctness cliff":
// a struct erased through `any` serializes as a JSON ARRAY, not an object). Use
// forge.json_obj(...) / forge.json(dict-string) until that hook lands (next increment).
// The Request is a dict here, not the design's struct, for the same reason -- dicts
// serialize correctly today; the struct model arrives with the compiler hook.

fn app()
    let a = {}
    a["routes"] = []
    a["mws"] = []
    a["statics"] = []
    a

// Register a middleware. Middleware = fn(next_handler) -> new_handler, composed by
// function-wrapping. Applied OUTSIDE-IN: the first use() is the OUTERMOST wrapper (sees
// the request first, the response last). `use` is a free identifier in NOVA (import is
// the module keyword), so this name is safe.
fn use(a, mw)
    push(a["mws"], mw)
    a

// Route group: a lightweight handle that shares the app's routes + mws but PREFIXES every
// path registered through it. `let api = forge.group(app, "/api/v1"); forge.get(api, "/users", h)`
// registers GET /api/v1/users. Works for BOTH the typed (dispatch_req) and dict (dispatch)
// paths since both register via _fr_route. API versioning / sub-route mounting with zero ceremony.
fn group(a, prefix: string)
    let g = {}
    g["routes"] = a["routes"]
    g["mws"] = a["mws"]
    g["statics"] = a["statics"]
    g["prefix"] = prefix
    g

// Internal route registrar. NOTE: named _fr_route (not `route`) because NOVA module
// functions are FLAT symbols -- a bare `route` collides at link with user/demo code that
// defines its own fn route(...) (the demo_*_test handlers do exactly that). Public API is
// get/post/put/delete/patch. Prepends a group's prefix when registered through forge.group.
fn _fr_route(a, method: string, pattern: string, handler)
    let full = pattern
    if contains(a, "prefix")
        full = a["prefix"] + pattern
    push(a["routes"], [method, full, handler])
    a

fn get(a, pattern: string, handler)
    _fr_route(a, "GET", pattern, handler)

fn post(a, pattern: string, handler)
    _fr_route(a, "POST", pattern, handler)

fn put(a, pattern: string, handler)
    _fr_route(a, "PUT", pattern, handler)

fn delete(a, pattern: string, handler)
    _fr_route(a, "DELETE", pattern, handler)

fn patch(a, pattern: string, handler)
    _fr_route(a, "PATCH", pattern, handler)

// Match a route pattern against a path, extracting :params. Result of a params dict.
fn _fr_match(pattern: string, path: string)
    let pat_parts = split(pattern, "/")
    let path_parts = split(path, "/")
    let params = {}
    let i = 0
    let np = len(pat_parts)
    while i < np
        let pp = pat_parts[i]
        // Catch-all "*name" (must be the last pattern segment): binds the ENTIRE remaining path
        // (joined by "/") -- e.g. "/files/*p" matches "/files/a/b/c" with p="a/b/c". Empty if none.
        if len(pp) > 0 and starts_with(pp, "*")
            let cn = slice(pp, 1, len(pp))
            let rest = ""
            if i < len(path_parts)
                rest = path_parts[i]
                let j = i + 1
                while j < len(path_parts)
                    rest = rest + "/" + path_parts[j]
                    j = j + 1
            // T1.4 (B2): percent-decode the catch-all tail. plus_space=false (path '+' is literal, not
            // space); literal '/' joiners are untouched (only %XX is decoded), so "/files/x%2Fy" -> "x/y".
            params[cn] = _pct_decode(rest, false)
            return ok(params)
        // Every non-catch-all pattern segment needs a corresponding path segment.
        if i >= len(path_parts)
            return err("length mismatch")
        let vp = path_parts[i]
        if len(pp) > 0 and starts_with(pp, ":")
            // A :param must bind a NON-EMPTY segment: "/users/:id" must NOT match "/users/" with
            // id="" (which would hand a handler an empty id, e.g. db.get("")). Empty -> no match -> 404.
            if len(vp) == 0
                return err("empty param segment")
            let pn = slice(pp, 1, len(pp))
            // T1.4 (B2): percent-decode the :param segment. "/u/:id" vs "/u/a%20b" binds id="a b".
            params[pn] = _pct_decode(vp, false)
        else if pp != vp
            return err("mismatch")
        i = i + 1
    // All pattern segments matched and there was no catch-all -> the path must be fully consumed.
    if len(path_parts) != np
        return err("length mismatch")
    ok(params)

// Strip a "?query" suffix from a path for matching.
fn _fr_path_clean(path: string) -> string
    let q = find(path, "?")
    if q < 0
        return path
    slice(path, 0, q)

// The route TERMINAL: match a built Request against the routes, bind :params, call the
// handler. 404 if no route matches the path; 405 if the path matches a different method.
fn _fr_route_dispatch(a, req)
    let routes = a["routes"]
    let other = 0
    let i = 0
    while i < len(routes)
        let rt = routes[i]
        let mr = _fr_match(rt[1], req["path"])
        if is_ok(mr)
            if rt[0] == req["method"] or rt[0] == "*"
                req["params"] = unwrap(mr)
                let h = rt[2]
                return h(req)
            else
                other = 1
        i = i + 1
    if other == 1
        return text(405, "method not allowed")
    not_found("no route: " + req["method"] + " " + req["path"])

// Pure dispatch: build the Request, run the middleware chain (outside-in) around the
// route terminal, return the response string. Pure (no socket) -> testable via mock.
fn dispatch(a, method: string, path: string, body: string) -> string
    let req = {}
    req["method"] = method
    req["path"] = _fr_path_clean(path)
    req["body"] = body
    req["params"] = {}
    // Fold the middleware around the terminal. Wrapping the LAST-registered mw first
    // makes it innermost (closest to the route) and the FIRST-registered outermost.
    // Middleware shape is fn(req, next) -> string (composition-friendly; _fr_wrap turns
    // each into a fn(req) by binding `next`, avoiding triple-curried lambdas).
    let h = fn(r) _fr_route_dispatch(a, r)
    let mws = a["mws"]
    let i = len(mws) - 1
    while i >= 0
        h = _fr_wrap(mws[i], h)
        i = i - 1
    h(req)

// Serve exactly N requests with routing, each handled INSIDE an arena scope (flat
// per-request memory via serve_n_arena). Deterministic -> testable.
//
// (The iter-99 arena split-corruption bug -- arena objects fell outside the tracked
// heap range so find_tag misclassified any-typed arena strings -- was ROOT-CAUSED and
// FIXED: nova_arena_new_chunk now tracks chunk bounds. split/parse inside the scope are
// correct again, so routed serving runs arena-scoped for flat per-request memory. See
// NOVA_DESIGN/ARENA_SPLIT_BUG.md.)
fn serve_app_n(a, port: int, n: int)
    serve_n_arena(port, fn(m, p, b) dispatch(a, m, p, b), n)

// Infinite routed serve, arena-scoped per request.
fn serve_app(a, port: int)
    serve_arena(port, fn(m, p, b) dispatch(a, m, p, b))

// ── Middleware ───────────────────────────────────────────────────────────────
// A middleware is fn(req, next) -> response-string: it may inspect/modify req, call
// next(req) for the downstream response, and modify that response. Composed by the
// dispatch fold (outside-in). _fr_wrap binds `next` so a mw becomes a fn(req).
fn _fr_wrap(mw, next)
    return fn(req) mw(req, next)

// Insert `name: value` before a built response's blank-line boundary (passthrough if none).
fn _fr_add_header(resp: string, name: string, value: string) -> string
    let marker = "\r\n\r\n"
    let i = find(resp, marker)
    if i < 0
        return resp
    let head = slice(resp, 0, i)
    let body = slice(resp, i + 4, len(resp))
    head + "\r\n" + name + ": " + value + marker + body

// CORS middleware: adds Access-Control-* headers to every response.
fn mw_cors(origin: string)
    return fn(req, next) with_cors(next(req), origin)

// Header-injecting middleware: adds `name: value` to every response.
fn mw_header(name: string, value: string)
    return fn(req, next) _fr_add_header(next(req), name, value)

// Logging middleware: prints method + path, then runs next (side effect; pass-through).
fn _fr_log_next(req, next)
    print("[forge] " + req["method"] + " " + req["path"])
    next(req)

fn mw_logger()
    return fn(req, next) _fr_log_next(req, next)

// ── Request data ─────────────────────────────────────────────────────────────
// Parse the request body as JSON -> dict/list (untyped, via json_decode).
// TYPED deserialization WORKS today via the from_json typed-let keystone (Phase 0a):
//   let u: User = from_json(req["body"])   -- the compiler dispatches to User__from_json
//   (flat / nested / list<struct>; proven by from_json_test). Use this for typed bodies.
// The ONLY remaining gap is the ergonomic WRAPPER `let u: User = forge.body_as(req)`: a
// library fn returning T needs let-site -> callee specialization (tracked as query_as<T>,
// Phase 0c). NOTE: a BARE `from_json(s)` with no `: Type` target still has no dispatch
// target and must not be used. body_json gives untyped dict access.
fn body_json(req)
    return json_decode(req["body"])

// Parse an application/x-www-form-urlencoded string ("a=1&b=2") -> dict of string->string.
// (MVP: no percent-decoding yet; tracked.)
fn form_decode(s: string)
    let d = {}
    if len(s) == 0
        return d
    let pairs = split(s, "&")
    let i = 0
    while i < len(pairs)
        let kv = pairs[i]
        let eq = find(kv, "=")
        if eq >= 0
            d[_pct_decode(slice(kv, 0, eq), true)] = _pct_decode(slice(kv, eq + 1, len(kv)), true)
        i = i + 1
    d

// Parse the request body as a form -> dict.
fn body_form(req)
    return form_decode(req["body"])

// ── DB row helpers ───────────────────────────────────────────────────────────
// Map a DB row (list of column values) to a dict keyed by column names. Bridges
// sqlitex db_query rows -> named dicts. NOTE: forge cannot `import sqlitex` and call its
// externs directly (cross-import extern resolution is a tracked compiler gap), so a
// program fetches rows via sqlitex SAME-FILE and passes (columns, rows) to these helpers.
// The TYPED row->struct form (query_as<struct>) needs the struct<-row compiler dispatch
// (the same keystone as typed JSON), deferred.
fn row_dict(columns: list, row: list)
    let d = {}
    let i = 0
    while i < len(columns) and i < len(row)
        d[columns[i]] = row[i]
        i = i + 1
    d

fn rows_dicts(columns: list, rows: list)
    let out = []
    let i = 0
    while i < len(rows)
        push(out, row_dict(columns, rows[i]))
        i = i + 1
    out

// ── Typed core (Phase 1) ─ Request / Response structs ────────────────────────
// The typed model the dict-based router above will migrate onto: a Handler is
// fn(Request) -> Response. Added ADDITIVELY -- the dict router + serve keep working while
// typed dispatch is built incrementally, so the gate stays green throughout. The
// struct<->JSON keystone (Phase 0a) makes a handler return a domain struct as JSON for
// free (resp_json below): the "return your type, get JSON" win, end to end.

type Request
    method: string      // "GET"
    path: string        // "/users/42" (clean, query stripped)
    raw_path: string    // "/users/42?tab=x" (original)
    params: dict        // ":id" -> "42", filled by the router at match time
    query: dict         // "tab" -> "x", parsed once
    headers: dict       // LOWERCASED header name -> value (case-insensitive for free)
    body: string
    state: dict         // middleware scratch: state["session"], state["user"], ...
    conn: int           // raw fd (streaming / upgrade)
    raw_body: any       // binary request body as a NovaBytes (multipart/octet-stream); 0 for text requests

type Response
    status: int         // 200
    headers: dict       // header name -> value (middleware mutates; finalize serializes once)
    body: string
    halted: bool        // a guard set the response; downstream skips, no exceptions
    cookies: list       // Set-Cookie values; each emitted as its OWN header line by _finalize2
                        // (Set-Cookie is the one header that legitimately repeats per response)

// Hex digit -> 0..15, or -1. Case-insensitive (lower() folds A-F).
fn _fr_hexval(c: string) -> int
    find("0123456789abcdef", lower(c))

// Percent-decode a query/form token: "%XX" -> the raw byte (chr is byte-safe, so multi-byte UTF-8
// like %C3%A9 reconstructs correctly), and (when plus_space) "+" -> space, per the application/
// x-www-form-urlencoded convention. A malformed "%" with non-hex following is left literal.
fn _pct_decode(s: string, plus_space: bool) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = s[i]
        if c == "%" and i + 2 < n
            let hi = _fr_hexval(s[i + 1])
            let lo = _fr_hexval(s[i + 2])
            if hi >= 0 and lo >= 0
                out = out + chr(hi * 16 + lo)
                i = i + 3
            else
                out = out + c
                i = i + 1
        else if plus_space and c == "+"
            out = out + " "
            i = i + 1
        else
            out = out + c
            i = i + 1
    out

// Percent-ENCODE a string for safe transport in a URL or cookie value: every byte outside the RFC 3986
// unreserved set (A-Z a-z 0-9 - _ . ~) becomes %XX (uppercase hex). The encode counterpart to _pct_decode;
// _pct_decode(_pct_encode(s), false) == s.
fn _hexup2(n: int) -> string
    let d = "0123456789ABCDEF"
    char_at(d, (n >> 4) & 15) + char_at(d, n & 15)

fn _pct_encode(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = s[i]
        let o = ord(c)
        if (o >= 65 and o <= 90) or (o >= 97 and o <= 122) or (o >= 48 and o <= 57) or o == 45 or o == 95 or o == 46 or o == 126
            out = out + c
        else
            out = out + "%" + _hexup2(o)
        i = i + 1
    out

// PUBLIC: percent-ENCODE a string for safe use as a URL path or query-component value -- every byte outside
// the RFC 3986 unreserved set (A-Za-z0-9 - _ . ~) becomes %XX (uppercase). Use it when BUILDING a URL or
// query string from data so a value containing & = ; / ? # space (etc.) can't break the URL structure
// (e.g. "/search?q=" + url_encode(term)). url_decode is the inverse.
fn url_encode(s: string) -> string
    _pct_encode(s)

// PUBLIC: percent-DECODE a URL component -- %XX -> the raw byte (byte-safe, so %C3%A9 reconstructs the UTF-8
// for é). '+' is LITERAL here (a generic component); the form-body parser decodes '+' as space per
// x-www-form-urlencoded. url_decode(url_encode(s)) == s for every s (uppercase %XX decodes fine: the hex
// reader is case-insensitive).
fn url_decode(s: string) -> string
    _pct_decode(s, false)

// Parse "k=v&k2=v2" (the ?query) into a dict, percent-decoding keys and values. Empty dict if none.
fn _query_dict(raw_path: string) -> dict
    let d = {}
    let q = find(raw_path, "?")
    if q < 0
        return d
    let qs = slice(raw_path, q + 1, len(raw_path))
    let pairs = split(qs, "&")
    let i = 0
    while i < len(pairs)
        let kv = pairs[i]
        let eq = find(kv, "=")
        if eq >= 0
            d[_pct_decode(slice(kv, 0, eq), true)] = _pct_decode(slice(kv, eq + 1, len(kv)), true)
        i = i + 1
    d

// Parse request headers into a dict with LOWERCASED keys (HTTP header names are
// case-insensitive). Skips the request line; stops at the blank-line boundary.
fn _headers_dict(raw: string) -> dict
    let d = {}
    let hdr_end = find(raw, "\r\n\r\n")
    let region = raw
    if hdr_end >= 0
        region = slice(raw, 0, hdr_end)
    let first_nl = find(region, "\r\n")
    if first_nl < 0
        return d
    let block = slice(region, first_nl + 2, len(region))
    let lines = split(block, "\r\n")
    let i = 0
    while i < len(lines)
        let line = lines[i]
        let colon = find(line, ":")
        if colon >= 0
            let name = lower(trim(slice(line, 0, colon)))
            let val = trim(slice(line, colon + 1, len(line)))
            d[name] = val
        i = i + 1
    d

// Parse a complete raw HTTP request into a typed Request (parse-ONCE: query + headers are
// dicts, O(1) access). PUBLIC: the typed serve path + tests build requests with this.
fn build_request(raw: string, conn: int) -> Request
    let rp = parse_path(raw)
    let q = _query_dict(rp)
    let h = _headers_dict(raw)
    Request(parse_method(raw), parse_path_clean(raw), rp, {}, q, h, parse_body(raw), {}, conn, 0)

// Case-insensitive header lookup ("" if absent). Keys are stored lowercased.
fn req_header(req: Request, name: string) -> string
    let k = lower(name)
    if contains(req.headers, k)
        return req.headers[k]
    ""

// Read a query-string parameter from a typed Request ("" if absent). The typed counterpart to the
// dict path's query_get.
fn req_query(req: Request, key: string) -> string
    if contains(req.query, key)
        return req.query[key]
    ""

// ALL values for a repeated query key on a typed Request, in order -> a list ([] if absent). req.query is a
// single-value dict (it keeps only one value per key), so a multi-select / checkbox form "?tag=a&tag=b" is
// only fully readable here -- this re-parses req.raw_path (which preserves the original query). Exact key
// match (no prefix shadowing); the typed counterpart of query_all.
fn req_query_all(req: Request, key: string) -> list
    let out = []
    let rp = req.raw_path
    let q = find(rp, "?")
    if q < 0
        return out
    let qs = slice(rp, q + 1, len(rp))
    let pairs = split(qs, "&")
    let i = 0
    while i < len(pairs)
        let p = pairs[i]
        let eq = find(p, "=")
        if eq >= 0 and slice(p, 0, eq) == key
            push(out, slice(p, eq + 1, len(p)))
        i = i + 1
    out

// ── Content negotiation (one route, any client) ───────────────────────────────────────────────────────
// The ordinal position (entry index) of the first Accept media-range whose type EQUALS `mt` (ignoring its
// ;q= and other params), or -1. TOKEN-EXACT -- so "application/json" does NOT match "application/json-seq"
// or "application/json-patch+json", and the index lets callers compare relative preference order.
fn _accept_pos(a: string, mt: string) -> int
    let parts = split(a, ",")
    let i = 0
    while i < len(parts)
        let entry = trim(parts[i])
        let semi = find(entry, ";")
        if semi >= 0
            entry = trim(slice(entry, 0, semi))
        if entry == mt
            return i
        i = i + 1
    0 - 1

// Does the request's Accept header allow `ctype`? Token-exact match, the "type/*" subtype wildcard
// (e.g. "text/*" allows "text/html"), or the "*/*" catch-all. Absent Accept = "accept anything" (RFC 7231).
fn accepts(req: Request, ctype: string) -> bool
    let a = lower(req_header(req, "accept"))
    if a == ""
        return true
    let ct = lower(ctype)
    let typewild = ""
    let slash = find(ct, "/")
    if slash > 0
        typewild = slice(ct, 0, slash) + "/*"
    let parts = split(a, ",")
    let i = 0
    while i < len(parts)
        let entry = trim(parts[i])
        let semi = find(entry, ";")
        if semi >= 0
            entry = trim(slice(entry, 0, semi))
        if entry == ct or entry == "*/*"
            return true
        if typewild != "" and entry == typewild
            return true
        i = i + 1
    false

// Does the client prefer JSON over HTML? True when the Accept header names application/json AND either
// does not name text/html, or names json BEFORE html (a coarse but reliable q-order proxy). This is the
// API-client-vs-browser test: a browser sends "text/html,...,*/*" (-> false); fetch/curl with
// "application/json" (-> true). An X-Requested-With: XMLHttpRequest also forces JSON (the XHR convention).
// Token-exact (via _accept_pos) so "application/json-seq" etc. don't false-trigger.
fn wants_json(req: Request) -> bool
    if lower(req_header(req, "x-requested-with")) == "xmlhttprequest"
        return true
    let a = lower(req_header(req, "accept"))
    let j = _accept_pos(a, "application/json")
    if j < 0
        return false
    let h = _accept_pos(a, "text/html")
    if h < 0
        return true
    j < h

// Does the client prefer HTML (the browser-page case)? True when Accept names text/html and the client is
// not asking for JSON first. The complement used to branch between forge_html views and resp_json.
fn wants_html(req: Request) -> bool
    if wants_json(req)
        return false
    accepts(req, "text/html")

// The PRIMARY language subtag of a tag, lowercased ("en-US" -> "en", "FR" -> "fr", "*" -> "*").
fn _lang_primary(tag: string) -> string
    let t = lower(trim(tag))
    let d = find(t, "-")
    if d < 0
        return t
    slice(t, 0, d)

// Pick the best `supported` language for the request's Accept-Language, else supported[0] as the default.
// Matches on the primary subtag (so a client "en-US"/"en-GB" both match a supported "en"); "*" -> default.
// Uses Accept-Language ENTRY ORDER as the preference (consistent with the framework's Accept negotiation,
// which also ignores ;q -- browsers send languages in preference order). `supported` is your offered set,
// e.g. negotiate_lang(req, ["en","fr","de"]). Returns "" only if `supported` is empty.
fn negotiate_lang(req: Request, supported: list) -> string
    if len(supported) == 0
        return ""
    let al = req_header(req, "accept-language")
    if len(al) == 0
        return supported[0]
    let parts = split(al, ",")
    let i = 0
    while i < len(parts)
        let entry = trim(parts[i])
        let semi = find(entry, ";")
        if semi >= 0
            entry = trim(slice(entry, 0, semi))
        let prim = _lang_primary(entry)
        if prim == "*"
            return supported[0]
        let j = 0
        while j < len(supported)
            if lower(supported[j]) == prim
                return supported[j]
            j = j + 1
        i = i + 1
    supported[0]

// ── Conditional GET / HTTP caching for DYNAMIC responses ──────────────────────────────────────────────
// A strong ETag (quoted sha256 content hash) for a response body. Same scheme the static path uses, but
// for handler-generated JSON/HTML so dynamic routes also get cache revalidation.
fn etag_for(body: string) -> string
    chr(34) + sha256(body) + chr(34)

// Conditional GET for a dynamic response: hash the body into a strong ETag, attach the ETag header, and if
// the client's If-None-Match already matches, return 304 Not Modified (empty body) -- the client keeps its
// cached copy and you save re-sending the payload. Pass-through for non-GET/HEAD, non-200, or binary bodies
// (which carry their own validators). Idempotent: an ETag the caller already set is recomputed identically.
fn conditional(req: Request, resp: Response) -> Response
    if req.method != "GET" and req.method != "HEAD"
        return resp
    if resp.status != 200
        return resp
    if type_name(resp.body) != "string"
        return resp
    let tag = etag_for(resp.body)
    resp.headers["ETag"] = tag
    if req_header(req, "if-none-match") == tag
        // RFC 7232 4.1: a 304 SHOULD carry the same validator + freshness headers a 200 would -- crucially
        // Cache-Control and Vary, or a shared cache revalidating a negotiated entry loses the Accept keying.
        // Carry those (and Set-Cookie) forward; drop the body + body-specific headers.
        let h = {}
        h["ETag"] = tag
        if contains(resp.headers, "Cache-Control")
            h["Cache-Control"] = resp.headers["Cache-Control"]
        if contains(resp.headers, "Vary")
            h["Vary"] = resp.headers["Vary"]
        if contains(resp.headers, "Expires")
            h["Expires"] = resp.headers["Expires"]
        return Response(304, h, "", false, resp.cookies)
    resp

// Middleware: apply conditional() to every response -- drop-in HTTP caching for dynamic GET routes.
//   forge.use(app, forge.mw_etag())
// A repeat request with the matching If-None-Match then gets a 304 instead of the full body.
fn mw_etag()
    return fn(req, next) conditional(req, next(req))

// ── Cache-Control + Vary (freshness directives; correctness for negotiated/compressed responses) ───────
// Set the Cache-Control header to an explicit directive string.
fn cache_control(resp: Response, value: string) -> Response
    resp.headers["Cache-Control"] = value
    resp

// Publicly cacheable for `seconds` (browsers + shared caches / CDNs).
fn cache(resp: Response, seconds: int) -> Response
    cache_control(resp, "public, max-age=" + str(seconds))

// Never store this response (sensitive data, per-user pages).
fn no_store(resp: Response) -> Response
    cache_control(resp, "no-store")

// Append a request-header name to Vary (idempotent) so a shared cache keys on it. ESSENTIAL when one URL
// returns different representations by request header: Vary: Accept for content negotiation (resp_json vs
// HTML off the same route), or Vary: Accept-Encoding for gzip -- without it a cache may hand a client the
// wrong representation.
fn vary(resp: Response, hdr: string) -> Response
    if contains(resp.headers, "Vary")
        let cur = resp.headers["Vary"]
        if trim(cur) == "*"
            return resp
        // TOKEN-exact membership (NOT a raw substring -- else adding "Accept" when "Accept-Encoding" is
        // already present would be wrongly skipped, and the negotiated representation would not be keyed).
        let want = lower(hdr)
        let toks = split(cur, ",")
        let i = 0
        let present = false
        while i < len(toks)
            if lower(trim(toks[i])) == want
                present = true
            i = i + 1
        if not present
            resp.headers["Vary"] = cur + ", " + hdr
    else
        resp.headers["Vary"] = hdr
    resp

// Lowercased Content-Type of the request ("" if absent).
fn content_type(req: Request) -> string
    lower(req_header(req, "content-type"))

// Parse an application/x-www-form-urlencoded request body into a dict (percent-decoded). For a
// handler reading several fields, call this ONCE. HTML <form> POSTs (login / signup) land here.
fn req_form_all(req: Request) -> dict
    form_decode(req.body)

// Read a single form field from the request body ("" if absent). Sugar over req_form_all -- for
// multiple fields prefer req_form_all to parse once.
fn req_form(req: Request, key: string) -> string
    let f = form_decode(req.body)
    if contains(f, key)
        return f[key]
    ""

// Serialize a Response struct to the HTTP wire string ONCE (status line + headers +
// Content-Length + body). The single point where a Response becomes bytes.
// Serialize a Response to the HTTP wire ONCE, with an explicit Connection disposition and
// HEAD-aware body. The single serialization boundary: framework-reserved headers (content-length
// / connection / server) are emitted exactly once from here (skipped in the user-header loop so a
// handler cannot create a DUPLICATE -- a smuggling vector), and every name/value is CRLF/NUL-
// sanitized so reflected request data cannot split the response. For HEAD, the Content-Length the
// GET would have is emitted but NO body follows (RFC 9110).
fn _finalize2(resp: Response, method: string, keep_alive: bool) -> string
    // A binary (bytes) body rides in the string body field; it must NOT be string-concatenated here
    // (would NUL-truncate). For binary, we emit the HEADER ONLY with a bytes_len Content-Length, and
    // _serve_conn sends the body separately via tcp_send_bytes. type_name discriminates at runtime.
    let is_bin = type_name(resp.body) == "bytes"
    let r = "HTTP/1.1 " + _status_line(resp.status) + "\r\n"
    let ks = keys(resp.headers)
    let i = 0
    while i < len(ks)
        let k = ks[i]
        let kl = lower(k)
        if kl != "content-length" and kl != "connection" and kl != "server"
            r = r + _safe_header(k) + ": " + _safe_header(resp.headers[k]) + "\r\n"
        i = i + 1
    if is_bin
        r = r + "Content-Length: " + str(bytes_len(resp.body)) + "\r\n"
    else
        r = r + "Content-Length: " + str(len(resp.body)) + "\r\n"
    if keep_alive
        r = r + "Connection: keep-alive\r\n"
    else
        r = r + "Connection: close\r\n"
    r = r + "Server: NOVA Forge\r\n"
    // Each cookie gets its OWN Set-Cookie line (sanitized so a value cannot inject a header).
    let ci = 0
    while ci < len(resp.cookies)
        r = r + "Set-Cookie: " + _safe_header(resp.cookies[ci]) + "\r\n"
        ci = ci + 1
    r = r + "\r\n"
    if method != "HEAD" and not is_bin
        r = r + resp.body
    r

// Public, backward-compatible: serialize as a full-body, Connection: close response (the form
// callers and tests expect). The keep-alive serve loop uses _finalize2 directly.
fn finalize(resp: Response) -> string
    _finalize2(resp, "GET", false)

// ── Typed Response builders (return a Response struct, not a wire string) ──────
fn resp_new(status: int, body: string) -> Response
    Response(status, {}, body, false, [])

fn resp_text(status: int, body: string) -> Response
    let h = {}
    h["Content-Type"] = "text/plain; charset=utf-8"
    Response(status, h, body, false, [])

fn resp_html(status: int, body: string) -> Response
    let h = {}
    h["Content-Type"] = "text/html; charset=utf-8"
    Response(status, h, body, false, [])

// Binary response: `raw` is a NovaBytes handle (from bytes()/read_bytes/gzip/etc.). It rides in the
// string-typed body field (NOVA's uniform i64); _finalize2 + _serve_conn discriminate by
// type_name(body)=="bytes" and send the bytes length-exact via tcp_send_bytes (no NUL truncation).
// Lets a handler `return forge.resp_bytes(200, png, "image/png")`. NOTE: a binary body must NOT be passed
// through string-inspecting middleware (find/len on it are bytes-aware now, but string ops are not).
fn resp_bytes(status: int, raw, ctype: string) -> Response
    let h = {}
    h["Content-Type"] = ctype
    Response(status, h, raw, false, [])

// Structured JSON error: resp_error(404, "not found") -> {"error":"not found"} with that status.
// Consistent machine-readable API errors (vs a bare text body).
type ErrorBody
    error: string

fn resp_error(status: int, msg: string) -> Response
    resp_json(status, ErrorBody(msg))

// ── Typed response projection (drop sensitive fields BY CONSTRUCTION) ─────────────────────────────────
// resp_model(status, value, model_sample) serializes `value` through a developer-declared OUTPUT type:
// only the fields named by the model are read, everything else (password_hash, internal_id, is_admin) is
// NEVER read -> cannot reach the wire. This is a WHITELIST (the inverse of DRF exclude=[...]): you say what
// MAY be exposed, not what to hide, so a newly-added secret field defaults to hidden. The model is an
// ordinary NOVA struct; pass a zero-value sample (as the OpenAPI doc routes already do) to carry its type.
//
// HONEST SCOPE (designed + adversary-reviewed -- see [[project-forge-openapi-design]] sibling notes):
//  - NESTED structs ARE deep-projected: a struct-typed model field recurses through its nested model type,
//    so a subset nested type (ProfOut without ssn) drops nested secrets too. A list field (incl list<struct>)
//    is still copied WHOLE -- list ELEMENTS are not projected (a documented gap; use resp_model_list at top
//    level, but a list nested inside a projected struct passes through unprojected).
//  - SINGLE value only. A list<struct> return is NOT projected here; call resp_model per item, or a plain
//    `return value` still serializes the full struct (UNPROJECTED). resp_model protects ONLY what you hand
//    it -- there is no automatic interception, so do not assume bulk/list endpoints are covered.
//  - A `bytes` field would mis-serialize (json_stringify has no bytes case) -- models must be scalar/string.
//  - COMPUTED output fields (a field on the model but not on the source) are rejected as drift (see below);
//    v1 projection is strictly a SUBSET of the source struct's real fields.
//  - The drift guard is RUNTIME and fail-closed (a 500 the first time that route returns a mismatched
//    struct), NOT a build-time/startup check. A true compile-time guarantee needs the Path-C compiler hook.

// Copy ONLY the model's declared fields out of the domain value into a fresh dict (the whitelist). Returns
// a dict because NOVA has no generic runtime struct constructor; json_stringify renders a dict as a JSON
// object identically to a struct, so the wire bytes match a hand-written DTO minus the dropped fields.
// DEEP: when a model field is itself a struct (its sample carries nested fields), the nested value is
// RECURSIVELY projected through that nested model -- so declaring a SUBSET nested type (e.g. ProfOut without
// ssn) drops nested secrets too. A zero/null nested source -> the nested model's keys mapped to null (the
// recursion bottoms out: field_get on a non-struct returns null, field_names on it is empty). A list field
// (incl list-of-struct) is copied WHOLE -- list elements are not projected (a documented gap).
fn _project(value, model_sample)
    let out = {}
    let names = field_names(model_sample)
    let i = 0
    while i < len(names)
        let nm = names[i]
        let mfield = field_get(model_sample, nm)
        if len(field_names(mfield)) > 0
            out[nm] = _project(field_get(value, nm), mfield)
        else
            out[nm] = field_get(value, nm)
        i = i + 1
    out

// Drift defense (opposite of the leak defense): every model field MUST exist on the source struct. A model
// field the source lacks (typo / renamed / computed) is a hard error -- caught, never silently nulled.
// The message names only the developer's own MODEL field (not the source type) so logging it leaks nothing.
fn _model_check(value, model_sample)
    let src = field_names(value)
    let want = field_names(model_sample)
    let i = 0
    while i < len(want)
        let nm = want[i]
        if not contains(src, nm)
            return err("response model field not present on returned value: " + nm)
        i = i + 1
    ok(value)

// Public: project `value` through the model type and emit JSON. Fail-closed on drift (generic 500, never
// echoes the raw struct). Mirrors resp_json with the model interposed; zero overhead for routes not using it.
fn resp_model(status: int, value, model_sample) -> Response
    if is_err(_model_check(value, model_sample))
        return resp_error(500, "response model mismatch")
    resp_json(status, _project(value, model_sample))

// Collection variant: project EVERY item of a list<struct> through the model -> a JSON array of objects.
// This is the common REST shape (GET /users): without it, a bare `return list_of_users` serializes every
// struct WHOLE (bulk secret leak). resp_model_list applies the same whitelist + fail-closed drift per item
// (a non-struct or mismatched item -> generic 500, no partial leak). FLAT-only in v1, same as resp_model.
fn resp_model_list(status: int, values, model_sample) -> Response
    let out = []
    let i = 0
    while i < len(values)
        let v = values[i]
        if is_err(_model_check(v, model_sample))
            return resp_error(500, "response model mismatch")
        push(out, _project(v, model_sample))
        i = i + 1
    resp_json(status, out)

// Register a custom 404 handler: on_not_found(app, fn(req) -> Response|value). Used when no route
// matches (after static). Lets an app return a branded 404 page or a JSON error.
fn on_not_found(a, handler)
    a["not_found"] = handler
    a

// Serve a HANDLER-CHOSEN file as a Response (content-type by extension) -- `return forge.file(
// "templates/page.html")`. For app-controlled paths (NOT user input -- use static() for URL-mapped
// trees, which is traversal-safe). 404 if the file is missing. TEXT assets (text/*, json, js, xml) read
// via read_file as a string body; BINARY assets (wasm, png, octet-stream, ...) read via read_bytes as a
// NovaBytes Response (resp_bytes) so embedded NULs are NOT truncated (read_file stops at the first NUL).
fn file(path: string) -> Response
    if not file_exists(path)
        return resp_text(404, "not found")
    let ct = _ext_ctype(path)
    if _ct_is_text(ct)
        let h = {}
        h["Content-Type"] = ct
        return Response(200, h, read_file(path), false, [])
    let raw = read_bytes(path)
    if bytes_len(raw) == 0
        return resp_text(404, "not found")
    resp_bytes(200, raw, ct)

// ── Pure test surface ─ test handlers without a socket ────────────────────────
// mock_request builds a Request from method/path/body (no hand-written HTTP); dispatch runs the
// full middleware+route pipeline; status_of/body_of read the result. So a handler test reads:
//   let r = forge.dispatch(app, forge.mock_request("POST", "/todos", body))
//   assert(forge.status_of(r) == 201)
fn mock_request(method: string, path: string, body: string) -> Request
    build_request(method + " " + path + " HTTP/1.1\r\nContent-Length: " + str(len(body)) + "\r\n\r\n" + body, 0)

fn dispatch_test(a, req: Request) -> Response
    dispatch_req(a, req)

fn status_of(resp: Response) -> int
    resp.status

fn body_of(resp: Response) -> string
    resp.body

// resp_json: serialize ANY value (struct via the RTTI keystone / list / dict / scalar) into
// a JSON Response. A handler can `return forge.resp_json(200, user)` and the client gets a
// JSON object -- zero annotation.
fn resp_json(status: int, value) -> Response
    let h = {}
    h["Content-Type"] = "application/json"
    Response(status, h, json_stringify(value), false, [])

// Set/overwrite a header on a Response (returns it for chaining). O(1) dict write -- the
// typed answer to the dict router's string-surgery _fr_add_header.
fn resp_set_header(resp: Response, name: string, value: string) -> Response
    resp.headers[name] = value
    resp

// Redirect Response for the typed path (the dict path's `redirect` returns a wire string). Pairs
// with sessions for auth flows: verify -> session_set -> resp_redirect(303, "/dashboard"). The
// Location value is sanitized at the _finalize2 boundary (no header injection).
fn resp_redirect(status: int, url: string) -> Response
    resp_set_header(resp_new(status, ""), "Location", url)

// ── Cookies ───────────────────────────────────────────────────────────────────
// Read a cookie from the request's Cookie header ("" if absent). Splits "a=1; b=2" on ';' and
// matches the name exactly (whitespace-trimmed).
fn cookie_get(req: Request, name: string) -> string
    let raw = req_header(req, "cookie")
    if len(raw) == 0
        return ""
    let parts = split(raw, ";")
    let i = 0
    while i < len(parts)
        let p = trim(parts[i])
        let eq = find(p, "=")
        if eq > 0
            if slice(p, 0, eq) == name
                return slice(p, eq + 1, len(p))
        i = i + 1
    ""

// Set a cookie with secure-by-default attributes: HttpOnly (no JS access -> XSS-resistant),
// SameSite=Lax (CSRF-resistant), Path=/. Multiple cookies per response are supported -- each is
// emitted as its own Set-Cookie line by _finalize2. Returns the Response for chaining. (Add
// `; Secure` under TLS once HTTPS serving lands.)
fn resp_set_cookie(resp: Response, name: string, value: string) -> Response
    push(resp.cookies, name + "=" + value + "; Path=/; HttpOnly; SameSite=Lax")
    resp

// Like resp_set_cookie but with lifetime + transport control: max_age seconds (>0 -> a PERSISTENT cookie via
// Max-Age; <=0 -> a session cookie, no Max-Age) and secure (1 -> add "; Secure" so the cookie is sent only
// over HTTPS -- set this for any cookie carrying a session/auth token once you serve over TLS). Keeps the
// secure defaults Path=/; HttpOnly; SameSite=Lax. NOTE: a user-controlled `value` should be url_encode'd by
// the caller (a raw ';' would inject a cookie attribute); app tokens/signed values are already safe.
fn resp_set_cookie_ex(resp: Response, name: string, value: string, max_age: int, secure: int) -> Response
    let c = name + "=" + value + "; Path=/; HttpOnly; SameSite=Lax"
    if max_age > 0
        c = c + "; Max-Age=" + str(max_age)
    if secure == 1
        c = c + "; Secure"
    push(resp.cookies, c)
    resp

// ── Flash messages (one-time notifications across a redirect) ─────────────────────────────────────────
// The POST-redirect-GET pattern: after handling a form, stash a message and redirect (303); the next page
// shows it exactly ONCE. Backed by a short HttpOnly cookie holding the percent-encoded message. flash() sets
// it on the redirect response; get_flash() reads it on the next request; it is consumed by clear_flash() or,
// automatically, by mw_flash().
//   return forge.flash(forge.resp_redirect(303, "/home"), "Saved!")     // in the POST handler
//   let msg = forge.get_flash(req)                                       // in the GET handler
fn flash(resp: Response, msg: string) -> Response
    resp_set_cookie(resp, "flash", _pct_encode(msg))

// Read the flash message ("" if none), decoding the percent-encoded cookie value.
fn get_flash(req: Request) -> string
    let v = cookie_get(req, "flash")
    if v == ""
        return ""
    _pct_decode(v, false)

// Expire the flash cookie so the message is shown only once.
fn clear_flash(resp: Response) -> Response
    push(resp.cookies, "flash=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0")
    resp

// True if `resp` already sets a NEW (non-empty) flash cookie, so mw_flash won't clobber a freshly-set one.
fn _sets_flash(resp: Response) -> bool
    let i = 0
    while i < len(resp.cookies)
        let c = resp.cookies[i]
        if starts_with(c, "flash=") and not starts_with(c, "flash=;")
            return true
        i = i + 1
    false

// Middleware: auto-consume the flash. If the request carried a flash AND the handler did not set a fresh
// one, expire it on the way out -- so any flash is displayed exactly once.  forge.use(app, forge.mw_flash())
fn _mw_flash_run(req, next) -> Response
    let resp = next(req)
    if cookie_get(req, "flash") != "" and not _sets_flash(resp)
        return clear_flash(resp)
    resp

fn mw_flash()
    return fn(req, next) _mw_flash_run(req, next)

// ── Signed sessions ───────────────────────────────────────────────────────────
// Stateless, tamper-evident sessions: a value the app chooses (a user id, a small JSON blob) is
// HMAC-SHA256-signed with a server secret and carried in the `session` cookie. A client can read
// it but cannot FORGE or MUTATE it without the secret. No server-side store, no DB -- the moat is
// the bundled hmac_sha256 primitive. (A server-side store is the later long-lived-state variant.)

// Constant-time string compare (no early exit on mismatch) -- prevents a timing side-channel on
// signature verification. Length is leaked but HMAC-SHA256 hex is fixed-width, so that is safe.
fn _ct_eq(a: string, b: string) -> bool
    if len(a) != len(b)
        return false
    // Branchless OR-accumulate of per-byte XOR: no data-dependent branch in the loop, so timing does not
    // leak WHERE two equal-length secrets first differ. diff stays 0 iff every byte matches.
    let diff = 0
    let i = 0
    while i < len(a)
        diff = diff | (ord(a[i]) ^ ord(b[i]))
        i = i + 1
    diff == 0

// Sign a value as "<value>.<hmac-hex>". The signature has no dots, so the LAST dot separates them.
fn sign_value(secret: string, value: string) -> string
    value + "." + hmac_sha256(secret, value)

// Verify a signed value and recover the original; "" if the signature is missing or invalid.
fn unsign_value(secret: string, signed: string) -> string
    let dot = -1
    let i = 0
    while i < len(signed)
        if signed[i] == "."
            dot = i
        i = i + 1
    if dot < 0
        return ""
    let value = slice(signed, 0, dot)
    let sig = slice(signed, dot + 1, len(signed))
    if _ct_eq(hmac_sha256(secret, value), sig)
        return value
    ""

// Set a tamper-proof session cookie carrying `value`, signed with `secret`.
fn session_set(resp: Response, secret: string, value: string) -> Response
    resp_set_cookie(resp, "session", sign_value(secret, value))

// Read + verify the session cookie. "" if absent or tampered (forged/edited cookies are rejected).
fn session_get(req: Request, secret: string) -> string
    let c = cookie_get(req, "session")
    if len(c) == 0
        return ""
    unsign_value(secret, c)

// ── CSRF protection (signed double-submit) ──────────────────────────────────────
// Designed + adversarially reviewed (workflow wf_eed6a7a3): a SIGNED, SESSION-BOUND, double-submit
// token over the existing hmac_sha256 + _ct_eq primitives. Stateless (no server store -- works across
// serve_app_n carriers). Strictly stronger than naive double-submit (Spring's default): the cookie
// carries "sid|nonce.HMAC(secret,sid|nonce)", so a cookie-injection attacker (sibling subdomain / CRLF)
// can overwrite the cookie but CANNOT produce a valid HMAC without the server secret -> forgery requires
// breaking HMAC-SHA256, not setting a cookie. The nonce is from the OS CSPRNG (secure_bytes ->
// CryptGenRandom//dev/urandom), NOT the time-seeded random_int (which would make the nonce predictable
// and the whole scheme worthless -- the #1 finding from the adversary pass). NOT BREACH-sensitive: the
// transmitted value is an HMAC (a PRF output), not a recoverable stable secret, so no XOR masking layer
// is needed (unlike Django/Rails/Spring). SECURITY CONTRACT: GET/HEAD/OPTIONS/TRACE are NOT checked --
// a safe-method handler MUST NOT mutate state (GET /logout is a bug; make it POST). If you use cookie
// sessions you MUST add mw_csrf. If a method-override middleware is ever added it MUST run AFTER this one.

// 16 CSPRNG bytes -> 32-char NUL-free hex. secure_bytes is CryptGenRandom//dev/urandom (NOT time-seeded).
// hex by hand via bytes_get (hex_encode would strlen-truncate raw bytes at the first NUL).
fn _csrf_rand_hex() -> string
    let b = secure_bytes(16)
    let n = bytes_len(b)
    let digits = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < n
        let byte = bytes_get(b, i)
        out = out + digits[byte / 16] + digits[byte % 16]
        i = i + 1
    out

// Split "sid|nonce" on the LAST "|" (the nonce is 32-hex, "|"-free; the session value may itself contain
// "|"). Returns [sid, nonce]; ["",""] if no "|".
fn _csrf_split_payload(payload: string) -> list
    let bar = -1
    let i = 0
    while i < len(payload)
        if payload[i] == "|"
            bar = i
        i = i + 1
    if bar < 0
        return ["", ""]
    [slice(payload, 0, bar), slice(payload, bar + 1, len(payload))]

// Safe (CSRF-exempt) methods: the four RFC 9110 read-only methods. Allowlist of exemptions, so any
// other / non-standard / lowercased method is CHECKED (fail-closed). req.method is the on-the-wire
// method (no _method override honored), so a POST cannot masquerade as a safe GET.
fn _csrf_is_safe(method: string) -> bool
    method == "GET" or method == "HEAD" or method == "OPTIONS" or method == "TRACE"

// Count how many `csrf=` cookies the request carries. 2+ => cookie shadowing (an injected duplicate from
// a sibling subdomain trying to steer which cookie is trusted) -> treat as tampering. (Adversary finding.)
fn _csrf_cookie_count(req: Request) -> int
    let raw = req_header(req, "cookie")
    if len(raw) == 0
        return 0
    let parts = split(raw, ";")
    let c = 0
    let i = 0
    while i < len(parts)
        let p = trim(parts[i])
        let eq = find(p, "=")
        if eq > 0 and slice(p, 0, eq) == "csrf"
            c = c + 1
        i = i + 1
    c

// The CSRF cookie line: SameSite=Strict (no legitimate cross-site use -> also blunts login-CSRF, the
// cookie is not sent on a cross-site POST) and deliberately NOT HttpOnly (the SPA header pattern needs JS
// to read the nonce and echo it as X-CSRF-Token; the session cookie stays HttpOnly -- two cookies, opposite
// needs). The signed value confers no standalone authority (only useful with the HttpOnly session cookie),
// so a JS-readable CSRF cookie does not widen the XSS blast radius. (Add "; Secure" when TLS serving lands.)
fn _csrf_set_cookie(resp: Response, signed: string) -> Response
    push(resp.cookies, "csrf=" + signed + "; Path=/; SameSite=Strict")
    resp

// Mint a fresh signed, session-bound token; stash the bare nonce in req.state["csrf"] so csrf_token(req)
// returns the matching nonce in the SAME render (the cookie set here carries that nonce).
fn _csrf_issue(req: Request, secret: string) -> string
    let session_id = session_get(req, secret)
    let nonce = _csrf_rand_hex()
    req.state["csrf"] = nonce
    sign_value(secret, session_id + "|" + nonce)

fn _t_csrf(req: Request, next, secret: string, app_origin: string) -> Response
    if _csrf_is_safe(req.method)
        // SAFE: never checked; lazily ISSUE the cookie when absent/tampered/session-changed, else reuse.
        let cur_sid = session_get(req, secret)
        let existing = unsign_value(secret, cookie_get(req, "csrf"))
        let need_issue = false
        if existing == ""
            need_issue = true
        else
            let parts = _csrf_split_payload(existing)
            if not _ct_eq(parts[0], cur_sid)
                need_issue = true
            else
                req.state["csrf"] = parts[1]
        if need_issue
            let signed = _csrf_issue(req, secret)
            return _csrf_set_cookie(next(req), signed)
        return next(req)
    // UNSAFE: full verification, fail-closed. Any failure -> 403 WITHOUT calling next.
    // (a) Origin defense-in-depth: a present-and-mismatched Origin is rejected; a MISSING Origin is
    //     allowed (same-origin form posts may omit it). app_origin="" disables the check.
    if len(app_origin) > 0
        let origin = req_header(req, "origin")
        if len(origin) > 0 and origin != app_origin
            return resp_error(403, "CSRF token invalid")
    // (b) cookie-shadowing: a duplicate csrf cookie is tampering.
    if _csrf_cookie_count(req) > 1
        return resp_error(403, "CSRF token invalid")
    // (c) cookie present + signature valid -> recover payload (the line that defeats cookie injection:
    //     an injector cannot produce a valid MAC).
    let payload = unsign_value(secret, cookie_get(req, "csrf"))
    if payload == ""
        return resp_error(403, "CSRF token invalid")
    let parts = _csrf_split_payload(payload)
    let bound_sid = parts[0]
    let cookie_nonce = parts[1]
    // (d) submitted token: header first, _csrf form field fallback (forms cannot set custom headers).
    let submitted = req_header(req, "x-csrf-token")
    if len(submitted) == 0
        submitted = req_form(req, "_csrf")
    if len(submitted) == 0
        return resp_error(403, "CSRF token invalid")
    // (e) constant-time: submitted == cookie-trusted nonce.
    if not _ct_eq(submitted, cookie_nonce)
        return resp_error(403, "CSRF token invalid")
    // (f) session-binding, LENGTH-BLINDED (HMAC both sides to fixed width so _ct_eq's length early-return
    //     cannot leak the session-id length). Rejects an authed attacker replaying their OWN token at a
    //     different user's session. Anonymous flows ("") match and rely on the CSPRNG nonce secrecy.
    if not _ct_eq(hmac_sha256(secret, bound_sid), hmac_sha256(secret, session_get(req, secret)))
        return resp_error(403, "CSRF token invalid")
    next(req)

// CSRF middleware. Add it FIRST (outermost, sees the real wire method):
//   forge.use(app, forge.mw_csrf(secret, "https://yourapp.com"))   // app_origin "" disables Origin check
fn mw_csrf(secret: string, app_origin: string)
    return fn(req, next) _t_csrf(req, next, secret, app_origin)

// The nonce to embed in a form / meta tag for THIS request (set by mw_csrf on the safe-method pass).
//   <input type=hidden name=_csrf value="{forge.csrf_token(req)}">   (HTML form)
//   <meta name=csrf-token content="{forge.csrf_token(req)}">         (SPA reads -> X-CSRF-Token header)
// "" if mw_csrf did not run (renders tokenless; the POST then 403s, surfacing the misconfig).
fn csrf_token(req: Request) -> string
    if contains(req.state, "csrf")
        return req.state["csrf"]
    ""

// Ready-made hidden input for server-rendered forms.
fn csrf_field(req: Request) -> string
    let q = chr(34)
    "<input type=" + q + "hidden" + q + " name=" + q + "_csrf" + q + " value=" + q + csrf_token(req) + q + ">"

// Rotate the CSRF token after an auth state change (login/logout), binding it to the NEW session so any
// pre-login token is invalidated (login-CSRF defense-in-depth). Call in the auth handler AFTER session_set:
//   let r = forge.session_set(forge.resp_redirect(303, "/dashboard"), secret, user_id)
//   return forge.csrf_rotate(r, secret, user_id)
fn csrf_rotate(resp: Response, secret: string, new_session_id: string) -> Response
    let nonce = _csrf_rand_hex()
    _csrf_set_cookie(resp, sign_value(secret, new_session_id + "|" + nonce))

// ── JWT (HS256) + Bearer auth ───────────────────────────────────────────────────
// STANDARD HS256: signature = base64url(RAW HMAC-SHA256 bytes), from hex-decoding the hmac_sha256 builtin
// over byte lists. This is fully interoperable with jwt.io / jsonwebtoken / PyJWT. Previously the
// signature was the bare 64-char hex string (B6 bug); that is now fixed. The signing input is
// unchanged: base64url(header) + "." + base64url(payload). Security properties retained: alg
// pinned HS256 only, kid rejected, constant-time compare, exp/nbf enforced.

// base64url (RFC 7515, no padding) over the base64 builtins. Private to forge.
fn _jwt_b64url_enc(data: string) -> string
    let b = base64_encode(data)
    let out = ""
    let i = 0
    while i < len(b)
        let ch = b[i]
        if ch == "+"
            out = out + "-"
        else if ch == "/"
            out = out + "_"
        else if ch != "="
            out = out + ch
        i = i + 1
    out

fn _jwt_b64url_dec(data: string) -> string
    let out = ""
    let i = 0
    while i < len(data)
        let ch = data[i]
        if ch == "-"
            out = out + "+"
        else if ch == "_"
            out = out + "/"
        else
            out = out + ch
        i = i + 1
    let rem = len(out) % 4
    if rem == 2
        out = out + "=="
    else if rem == 3
        out = out + "="
    base64_decode(out)

// base64url of a raw byte list (RFC 7515 §2): standard base64 of the bytes, then
// `+`->`-`, `/`->`_`, strip `=` padding. Used for the HMAC signature segment.
// Hex string (from the hex-returning hmac_sha256 builtin) -> raw byte list, so JWT can base64url the
// RAW HMAC bytes (standard HS256) WITHOUT importing forge_crypto (which would pull forge into a diamond
// import via forge_compress -> module resolution break). Uses forge's own hmac_sha256 + ws_b64_bytes.
fn _jwt_hex_to_blist(hex: string) -> list
    let out = []
    let i = 0
    while i + 1 < len(hex)
        push(out, _fr_hexval(hex[i:i + 1]) * 16 + _fr_hexval(hex[i + 1:i + 2]))
        i = i + 2
    out

fn _jwt_b64url_enc_bytes(blist: list) -> string
    let b = ws_b64_bytes(blist)
    let out = ""
    let i = 0
    while i < len(b)
        let ch = b[i]
        if ch == "+"
            out = out + "-"
        else if ch == "/"
            out = out + "_"
        else if ch != "="
            out = out + ch
        i = i + 1
    out

// Current epoch SECONDS -- for setting jwt "exp" (e.g. now_secs() + 3600 for a 1-hour token).
fn now_secs() -> int
    time_ms() / 1000

// jwt_encode(claims, secret) -> a signed HS256 token. Set "exp" (now_secs()+N) in claims for expiry.
// alg is pinned at the source (never derived from input). Signature = base64url(RAW HMAC-SHA256 bytes)
// -- interoperable with all standard JWT libraries (jwt.io, jsonwebtoken, PyJWT, etc.).
fn jwt_encode(claims: dict, secret: string) -> string
    let q = chr(34)
    let header = "\{" + q + "alg" + q + ":" + q + "HS256" + q + "," + q + "typ" + q + ":" + q + "JWT" + q + "\}"
    let signing_input = _jwt_b64url_enc(header) + "." + _jwt_b64url_enc(json_stringify(claims))
    let mac = _jwt_hex_to_blist(hmac_sha256(secret, signing_input))
    signing_input + "." + _jwt_b64url_enc_bytes(mac)

// jwt_verify(token, secret) -> Result<dict>. Hardened per the adversary review: STRICT exact alg=="HS256"
// (reject none/RS256/substrings), reject a `kid` header (single-secret HS256 never uses it -> no kid
// injection), CONSTANT-TIME signature compare, and exp/nbf claim validation with type + plausibility
// checks. Rejects a token with NO exp by default (a non-expiring bearer credential is an account-takeover
// risk -- use _jwt_verify_opts to allow it). Fail-closed + total (returns err, never crashes).
fn jwt_verify(token: string, secret: string) -> Result<dict>
    return _jwt_verify_opts(token, secret, true, 60)

fn _jwt_verify_opts(token: string, secret: string, require_exp: bool, leeway: int) -> Result<dict>
    let parts = split(token, ".")
    if len(parts) != 3
        return err("malformed token")
    if len(parts[2]) == 0
        return err("missing signature")
    // (1) STRICT alg pin -- the security control. EXACT equality, BEFORE any crypto. Reject kid.
    let header = json_decode(_jwt_b64url_dec(parts[0]))
    if type_name(header) != "dict" or not contains(header, "alg")
        return err("bad header")
    if header["alg"] != "HS256"
        return err("unsupported alg")
    if contains(header, "kid")
        return err("unsupported header")
    // (2) CONSTANT-TIME signature check over the ORIGINAL encoded segments (never re-encode).
    // Recompute base64url(RAW HMAC bytes) and constant-time compare against the token's 3rd segment.
    let signing_input = parts[0] + "." + parts[1]
    let expected_mac = _jwt_hex_to_blist(hmac_sha256(secret, signing_input))
    let expected_sig = _jwt_b64url_enc_bytes(expected_mac)
    if not _ct_eq(expected_sig, parts[2])
        return err("invalid signature")
    // (3) claims -- only AFTER the signature is proven.
    let claims = json_decode(_jwt_b64url_dec(parts[1]))
    if type_name(claims) != "dict"
        return err("bad payload")
    let now = time_ms() / 1000
    // (4) exp: typed int, plausible (year-2000 floor blocks exp=0/negative "never expires"), unexpired.
    if contains(claims, "exp")
        if type_name(claims["exp"]) != "int"
            return err("invalid exp")
        if claims["exp"] <= 946684800
            return err("invalid exp")
        if now > claims["exp"] + leeway
            return err("token expired")
    else
        if require_exp
            return err("missing exp")
    // (5) nbf (optional): not-before window.
    if contains(claims, "nbf")
        if type_name(claims["nbf"]) != "int"
            return err("invalid nbf")
        if now + leeway < claims["nbf"]
            return err("token not yet valid")
    ok(claims)

// Extract the token from "Authorization: Bearer <token>". "" if absent / not a Bearer scheme.
fn bearer_token(req: Request) -> string
    let h = req_header(req, "authorization")
    if len(h) < 7
        return ""
    if slice(h, 0, 7) != "Bearer "
        return ""
    trim(slice(h, 7, len(h)))

// Bearer guard middleware. Verifies BEFORE next; opaque 401 on ANY failure (no signature-vs-expiry oracle);
// on success sets req.state["user"] = the verified claims dict for the handler. Structured with
// is_err/unwrap + a trailing next(req) (NOT `match { Ok => return next(req) }`): a `return next(req)`
// inside a match arm whose subject is a complex fn like jwt_verify hit a codegen bug that zeroed the
// downstream response body -- see [[project-forge-phase3-security]]. Bearer-auth APIs are not cookie-CSRF-
// vulnerable, so this composes with (does not need) mw_csrf.
fn _t_require_auth(req: Request, next, secret: string) -> Response
    let tok = bearer_token(req)
    if len(tok) == 0
        return resp_error(401, "unauthorized")
    let r = jwt_verify(tok, secret)
    if is_err(r)
        return resp_error(401, "unauthorized")
    req.state["user"] = unwrap(r)
    next(req)

fn mw_require_auth(secret: string)
    return fn(req, next) _t_require_auth(req, next, secret)

// ── Input validation (Moat 7) ───────────────────────────────────────────────────
// forge.validate(dict, rules) -> Result<dict, list<FieldError>>: rule validation that COLLECTS ALL field
// errors (form UX -- one round-trip). Designed + adversarially reviewed (workflow wf_819de960). NOVA has
// no type annotations to hang constraints on (Pydantic) and no schema-builder (Zod): rules are plain
// VALUES -- a dict of field -> list of [kind,arg,code] rule triples built by tiny constructor fns, a
// first-class reusable value. Validates the RAW request dict by name (cross-module-safe; no struct RTTI),
// then pair with form_as/from_json_safe to produce the typed struct. Canonical handler:
//   let body = json_decode(req.body)              // or forge.req_form_all(req) for a form
//   let r = forge.validate(body, {"name":[forge.required(),forge.min_len(1)], "age":[forge.min(13)]})
//   if is_err(r): return forge.errors_response(unwrap_err(r))   // ALL rule errors -> 422 JSON
//   let user: User = from_json_safe(req.body)     // ... then coerce to the typed struct
// (Use is_err/unwrap + a trailing call in guards -- never `match {Ok=>return next}` after a complex fn:
//  the codegen bug -- see [[project-forge-phase3-security]]. A type-aware validate over the post-coercion
//  struct is a tracked follow-up, gated on wiring field_names/field_get through `any` cross-module.)

type FieldError
    field: string         // the field that failed, e.g. "email"
    code: string          // STABLE machine code (i18n / client key), e.g. "too_short"
    rule: string          // the rule kind checked, e.g. "min_len"
    param: string         // the violated constraint, e.g. "3" -- NEVER the failing input (no reflection/PII)
    message: string       // default English; dev convenience, not the source of truth

// Rule constructors -- no new syntax, just functions returning a [kind, arg, code] triple. Reusable values.
fn required()      ["required", "", "required"]
fn min_len(n: int) ["min_len", str(n), "too_short"]
fn max_len(n: int) ["max_len", str(n), "too_long"]
fn min(n: int)     ["min", str(n), "too_small"]
fn max(n: int)     ["max", str(n), "too_big"]
fn pattern(re: string) ["pattern", re, "pattern"]      // re MUST be a developer literal (ReDoS: never request data)
fn email()         ["email", "", "email"]
fn one_of(vals: list)
    let s = ""
    let i = 0
    while i < len(vals)
        if i > 0
            s = s + "|"
        s = s + vals[i]
        i = i + 1
    ["one_of", s, "one_of"]

fn _re_cap() -> int
    4096

// Structural, NON-regex (linear) email check -- no ReDoS surface.
fn _is_email(s: string) -> bool
    let at = find(s, "@")
    if at <= 0 or at >= len(s) - 1
        return false
    let domain = slice(s, at + 1, len(s))
    if find(domain, ".") < 0
        return false
    if find(s, " ") >= 0
        return false
    true

fn _one_of_has(param: string, val: string) -> bool
    for o in split(param, "|")
        if o == val
            return true
    false

fn _fail(field: string, rule: list, msg: string) -> FieldError
    FieldError(field, rule[2], rule[0], rule[1], msg)

// Is s a (possibly signed) numeric literal (int OR float)? Guards the numeric range rules on raw string
// input so a non-numeric value fails with "must be a number" rather than a silent parse-to-0.
fn _is_num(s: string) -> bool
    if len(s) == 0
        return false
    let i = 0
    if s[0] == "-"
        if len(s) == 1
            return false
        i = 1
    let dots = 0
    let digits = 0
    while i < len(s)
        let c = s[i]
        if c == "."
            dots = dots + 1
        else if find("0123456789", c) >= 0
            digits = digits + 1
        else
            return false
        i = i + 1
    dots <= 1 and digits >= 1

// Apply ONE rule to a field's STRING value -> a list of 0 (pass) or 1 (fail) FieldError. A list (not an
// in-band sentinel) so a genuine failure can never be read as success (adversary finding). An ABSENT/empty
// value passes every rule EXCEPT `required` (optional fields skip format/range checks -- the Pydantic/Zod
// optional semantics); `required` is the only rule that fails on empty.
fn _apply_rule(fname: string, fval: string, rule: list) -> list
    let kind = rule[0]
    let arg = rule[1]
    if kind == "required"
        if len(trim(fval)) == 0
            return [_fail(fname, rule, fname + " is required")]
        return []
    // optional + absent/empty -> skip every non-required rule.
    if len(fval) == 0
        return []
    if kind == "min_len"
        if len(fval) < parse_int(arg)
            return [_fail(fname, rule, fname + " must be at least " + arg + " characters")]
        return []
    if kind == "max_len"
        if len(fval) > parse_int(arg)
            return [_fail(fname, rule, fname + " must be at most " + arg + " characters")]
        return []
    if kind == "min"
        if not _is_num(fval)
            return [_fail(fname, rule, fname + " must be a number")]
        if float(fval) < float(arg)
            return [_fail(fname, rule, fname + " must be >= " + arg)]
        return []
    if kind == "max"
        if not _is_num(fval)
            return [_fail(fname, rule, fname + " must be a number")]
        if float(fval) > float(arg)
            return [_fail(fname, rule, fname + " must be <= " + arg)]
        return []
    if kind == "one_of"
        if not _one_of_has(arg, fval)
            return [_fail(fname, rule, fname + " must be one of: " + arg)]
        return []
    if kind == "email"
        if not _is_email(fval)
            return [_fail(fname, rule, fname + " must be a valid email")]
        return []
    if kind == "pattern"
        if len(fval) > _re_cap()
            return [_fail(fname, rule, fname + " is too long to validate")]
        if not regex_match(fval, arg)
            return [_fail(fname, rule, fname + " has an invalid format")]
        return []
    // unknown rule kind -> fail CLOSED (a typo'd rule must never silently pass).
    [_fail(fname, rule, fname + " failed an unknown rule '" + kind + "'")]

// validate a request DICT (`d` = req_form_all(req) for forms, or json_decode(req.body) for JSON) against
// `rules` ({field -> [rule, ...]}). Collects ALL failures (form UX, one round-trip), returning
// Result<dict, list<FieldError>>. Runs on the RAW input by NAME -- cross-module-safe (no struct RTTI) and
// fail-fast on bad input; pair with form_as/from_json_safe to then produce the typed struct.
// (A future type-aware `validate_typed` over the struct post-coercion is gated on RTTI-through-`any`,
// a tracked compiler follow-up -- see [[project-forge-phase3-security]].)
fn validate(d, rules)
    let errs = []
    for fname in keys(rules)
        let fval = ""
        if contains(d, fname)
            fval = str(d[fname])
        let rs = rules[fname]
        let j = 0
        while j < len(rs)
            for e in _apply_rule(fname, fval, rs[j])
                push(errs, e)
            j = j + 1
    if len(errs) > 0
        return err(errs)
    ok(d)

// validate_typed(value, rules): validation over a TYPED STRUCT (the value from from_json_safe<T>/form_as<T>),
// the Pydantic "validate the model" order. Uses the cross-module RTTI keystone (field_names/field_get now
// work through `any`) to walk the struct, so a forge fn can introspect an app-defined struct. Adds a
// FAIL-CLOSED coverage check the dict path cannot do: a rule key that is not a real struct field is a hard
// error (catches a typo'd / stale rule key -> never a silently-skipped rule). Same rules + collect-all.
//   let u: User = from_json_safe(req.body)   // ... if ok:
//   let r = forge.validate_typed(unwrap(u), {"name":[forge.required()], "age":[forge.min(13)]})
//   if is_err(r): return forge.errors_response(unwrap_err(r))
fn validate_typed(value, rules)
    let errs = []
    let fields = field_names(value)
    for rk in keys(rules)
        if not contains(fields, rk)
            push(errs, FieldError(rk, "unknown_field", "schema", "", "no such field: " + rk))
    let i = 0
    while i < len(fields)
        let fname = fields[i]
        if contains(rules, fname)
            let fval = str(field_get(value, fname))
            let rs = rules[fname]
            let j = 0
            while j < len(rs)
                for e in _apply_rule(fname, fval, rs[j])
                    push(errs, e)
                j = j + 1
        i = i + 1
    if len(errs) > 0
        return err(errs)
    ok(value)

// Map collected errors to a 422 JSON Response: {"errors":[{field,code,rule,param,message}, ...]}. Each
// FieldError auto-JSONs via the RTTI keystone; json_stringify escapes (JSON-injection-safe). Never echoes
// the failing input value (no reflected XSS/PII).
fn errors_response(errs) -> Response
    let body = {}
    body["errors"] = errs
    resp_json(422, body)

// ── OpenAPI 3.0 generation (Moat: live API docs from declared types) ─────────────────────────────────
// HONEST SCOPE (designed + adversary-reviewed, workflow wbu20zrcn). Routes opt INTO docs by passing
// zero-value SAMPLE instances of their request/response struct types to *_doc registrars. openapi(a,info)
// walks the route table and builds an OpenAPI 3.0 spec by introspecting the samples via the cross-module
// RTTI keystone (field_names/field_types/field_get through `any` -> the runtime struct-meta registry).
// CAVEATS (stated plainly): the sample type is DEVELOPER-ASSERTED, not compiler-bound to the handler's
// from_json<T>/resp_json (within-type no-drift only; true no-drift needs a compiler hook = future Path-C).
// A nested struct field is documented only if the sample carries a populated nested instance; list-of-
// struct elements and unknown types render as {"type":"object"}. The ONE genuine no-drift NOVA delivers
// here: when a route also supplies its validate `rules`, the documented constraints (minLength/maximum/
// pattern/enum) are folded from the SAME rules dict that validate() enforces -> docs and validation cannot
// disagree on constraints. A DJB2 type-name-hash collision (rare) yields a wrong schema (pre-existing RTTI
// limit). Dispatch reads route indices [0..2] only, so doc routes dispatch identically to plain routes.

// doc-variant registrars: store [method, full, handler, req_sample, resp_sample, rules]. req/resp samples
// are live struct instances (null when absent); rules is the validate rules dict (empty {} when absent).
fn _fr_route_doc(a, method: string, pattern: string, handler, req_s, resp_s, rules)
    let full = pattern
    if contains(a, "prefix")
        full = a["prefix"] + pattern
    push(a["routes"], [method, full, handler, req_s, resp_s, rules])
    a

fn post_doc(a, pattern: string, handler, req_s, resp_s, rules)
    _fr_route_doc(a, "POST", pattern, handler, req_s, resp_s, rules)
fn put_doc(a, pattern: string, handler, req_s, resp_s, rules)
    _fr_route_doc(a, "PUT", pattern, handler, req_s, resp_s, rules)
fn patch_doc(a, pattern: string, handler, req_s, resp_s, rules)
    _fr_route_doc(a, "PATCH", pattern, handler, req_s, resp_s, rules)
fn get_doc(a, pattern: string, handler, resp_s)
    let empty = {}
    _fr_route_doc(a, "GET", pattern, handler, null, resp_s, empty)
fn delete_doc(a, pattern: string, handler, resp_s)
    let empty = {}
    _fr_route_doc(a, "DELETE", pattern, handler, null, resp_s, empty)

// Map one declared field type-name -> a JSON Schema fragment. Lowercasing folds the boxed `Float` cliff to
// "number" (correct for schema purposes). list/dict/unknown -> object; a struct name -> a $ref into comps,
// reserved-before-recurse (cycle guard) and populated only if fval is a live nested struct sample.
fn _oapi_schema_of_type(tname: string, fval, comps)
    let t = lower(tname)
    let s = {}
    if t == "int" or t == "i64" or t == "i32" or t == "long"
        s["type"] = "integer"
        return s
    if t == "float" or t == "f64" or t == "f32" or t == "double"
        s["type"] = "number"
        return s
    if t == "string" or t == "str"
        s["type"] = "string"
        return s
    if t == "bool" or t == "boolean"
        s["type"] = "boolean"
        return s
    if len(t) >= 4 and slice(t, 0, 4) == "list"
        s["type"] = "array"
        let it = {}
        s["items"] = it
        return s
    if len(t) >= 4 and slice(t, 0, 4) == "dict"
        s["type"] = "object"
        return s
    // treat as a struct reference
    if contains(comps, tname) == false
        let placeholder = {}
        placeholder["type"] = "object"
        comps[tname] = placeholder
        if len(field_names(fval)) > 0
            comps[tname] = _oapi_schema_of_value(fval, comps)
    let r = {}
    r["$ref"] = "#/components/schemas/" + tname
    return r

// Build an object schema from a live struct sample: every field -> a property, all fields required.
fn _oapi_schema_of_value(v, comps)
    let names = field_names(v)
    let types = field_types(v)
    let props = {}
    let req = []
    let i = 0
    while i < len(names)
        let nm = names[i]
        props[nm] = _oapi_schema_of_type(types[i], field_get(v, nm), comps)
        push(req, nm)
        i = i + 1
    let s = {}
    s["type"] = "object"
    s["properties"] = props
    s["required"] = req
    return s

// Fold validate rules (the SAME dict validate() enforces) into the object schema's property constraints.
fn _oapi_fold_rules(obj_schema, rules)
    let props = obj_schema["properties"]
    for fld in keys(rules)
        if contains(props, fld)
            let ps = props[fld]
            for r in rules[fld]
                let k = r[0]
                let arg = r[1]
                if k == "min_len"
                    ps["minLength"] = parse_int(arg)
                else if k == "max_len"
                    ps["maxLength"] = parse_int(arg)
                else if k == "min"
                    ps["minimum"] = parse_int(arg)
                else if k == "max"
                    ps["maximum"] = parse_int(arg)
                else if k == "pattern"
                    ps["pattern"] = arg
                else if k == "email"
                    ps["format"] = "email"
                else if k == "one_of"
                    ps["enum"] = split(arg, "|")
            props[fld] = ps
    obj_schema["properties"] = props
    return obj_schema

// "/users/:id" -> "/users/{id}" (OpenAPI path-template syntax).
fn _oapi_path(pat: string) -> string
    let parts = split(pat, "/")
    let out = ""
    let i = 0
    while i < len(parts)
        let seg = parts[i]
        if i > 0
            out = out + "/"
        if len(seg) > 0 and slice(seg, 0, 1) == ":"
            out = out + chr(123) + slice(seg, 1, len(seg)) + chr(125)
        else
            out = out + seg
        i = i + 1
    return out

// Each ":name" segment -> a required string path parameter object.
fn _oapi_path_params(pat: string)
    let ps = []
    let parts = split(pat, "/")
    let i = 0
    while i < len(parts)
        let seg = parts[i]
        if len(seg) > 0 and slice(seg, 0, 1) == ":"
            let p = {}
            p["name"] = slice(seg, 1, len(seg))
            p["in"] = "path"
            p["required"] = true
            let sc = {}
            sc["type"] = "string"
            p["schema"] = sc
            push(ps, p)
        i = i + 1
    return ps

// Register a top-level request/response struct sample as a NAMED component (keyed by its real struct name
// via type_name) and return a $ref to it -- so request/response/nested models all share one components
// section (FastAPI-style). Reserve-before-recurse cycle guard. Folds validate rules into the component.
// LIMIT (documented): a type reused across routes with DIFFERENT rules keeps the first route's constraints.
fn _oapi_register_value(v, comps, rules)
    let nm = type_name(v)
    if contains(comps, nm) == false
        let placeholder = {}
        placeholder["type"] = "object"
        comps[nm] = placeholder
        let sc = _oapi_schema_of_value(v, comps)
        if len(keys(rules)) > 0
            sc = _oapi_fold_rules(sc, rules)
        comps[nm] = sc
    let r = {}
    r["$ref"] = "#/components/schemas/" + nm
    return r

// Build the full OpenAPI 3.0 spec dict from the app's documented routes (those registered via *_doc).
fn openapi(a, info)
    let comps = {}
    let paths = {}
    for rt in a["routes"]
        if len(rt) >= 6
            let method = lower(rt[0])
            let path = _oapi_path(rt[1])
            let op = {}
            // requestBody from the request sample, as a named component (+ folded validate constraints)
            if len(field_names(rt[3])) > 0
                let aj = {}
                aj["schema"] = _oapi_register_value(rt[3], comps, rt[5])
                let ct = {}
                ct["application/json"] = aj
                let rb = {}
                rb["required"] = true
                rb["content"] = ct
                op["requestBody"] = rb
            // 200 response from the response sample, as a named component
            let r200 = {}
            r200["description"] = "OK"
            if len(field_names(rt[4])) > 0
                let norules = {}
                let raj = {}
                raj["schema"] = _oapi_register_value(rt[4], comps, norules)
                let rc = {}
                rc["application/json"] = raj
                r200["content"] = rc
            let resp = {}
            resp["200"] = r200
            op["responses"] = resp
            // path parameters
            let pp = _oapi_path_params(rt[1])
            if len(pp) > 0
                op["parameters"] = pp
            // attach as paths[path][method]
            let pmap = {}
            if contains(paths, path)
                pmap = paths[path]
            pmap[method] = op
            paths[path] = pmap
    let spec = {}
    spec["openapi"] = "3.0.3"
    spec["info"] = info
    spec["paths"] = paths
    let cs = {}
    cs["schemas"] = comps
    spec["components"] = cs
    return spec

// Swagger UI page (loaded from CDN) pointed at the spec URL. Braces via chr() to dodge interpolation.
fn _swagger_html(spec_url: string) -> string
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let head = "<!doctype html><html><head><meta charset=" + q + "utf-8" + q + "><title>API Docs</title><link rel=" + q + "stylesheet" + q + " href=" + q + "https://cdn.jsdelivr.net/npm/swagger-ui-dist/swagger-ui.css" + q + "></head>"
    let body = "<body><div id=" + q + "swagger-ui" + q + "></div><script src=" + q + "https://cdn.jsdelivr.net/npm/swagger-ui-dist/swagger-ui-bundle.js" + q + "></script>"
    let js = "<script>window.onload=function()" + lb + "SwaggerUIBundle(" + lb + "url:" + q + spec_url + q + ",dom_id:" + q + "#swagger-ui" + q + rb + ")" + rb + "</script></body></html>"
    return head + body + js

// Closures capture the prebuilt spec/html (long-lived; built at startup, read-only inside request arenas).
fn _oapi_serve_spec(spec)
    return fn(req) resp_json(200, spec)
fn _oapi_serve_docs(page: string)
    return fn(req) resp_html(200, page)

// Build the spec ONCE from the routes registered so far, then serve GET /openapi.json + GET /docs.
// Call AFTER all *_doc routes are registered (it snapshots the route table at call time).
fn enable_docs(a, title: string, version: string)
    let info = {}
    info["title"] = title
    info["version"] = version
    let spec = openapi(a, info)
    get(a, "/openapi.json", _oapi_serve_spec(spec))
    let page = _swagger_html("/openapi.json")
    get(a, "/docs", _oapi_serve_docs(page))
    a

// Coerce a handler's return value into a Response: a Response passes through; a string -> 200
// text/plain; anything else (struct / list / dict / scalar) -> 200 JSON via the RTTI keystone.
// Lets a handler return a BARE domain value -- `return user`, `return notes`, `return "hi"` --
// and Forge produces the right Response. "Return your type, get JSON", zero ceremony.
fn _coerce(v) -> Response
    let tn = type_name(v)
    if tn == "Response"
        return v
    if tn == "string"
        return resp_text(200, v)
    if tn == "bytes"
        return resp_bytes(200, v, "application/octet-stream")
    resp_json(200, v)

// Model-aware coercion: a doc route that declared a response model (resp_s) auto-projects a bare-struct
// return through it -- so the SAME sample drives the wire body AND the OpenAPI 200 schema (no-drift, no
// closure, no compiler hook). A Response/string return passes through unchanged (the handler took control),
// and an empty/absent model degrades to plain _coerce. Reads the long-lived sample at coerce time -- there
// is no captured closure crossing the spawn/arena boundary (the lifetime hazard the _wrap_model design had).
fn _coerce_model(v, model_sample) -> Response
    let tn = type_name(v)
    if tn == "Response"
        return v
    if tn == "string"
        return resp_text(200, v)
    if tn == "bytes"
        return resp_bytes(200, v, "application/octet-stream")
    if len(field_names(model_sample)) == 0
        return resp_json(200, v)
    resp_model(200, v, model_sample)

// ── Typed dispatch (Phase 1) ─ fn(Request) -> Response handlers ───────────────
// The TYPED handler model on the same app()/get()/routes: a handler is fn(Request) -> Response
// and receives the parsed Request (params filled at match), returning a Response struct.
// dispatch_req is pure (no socket) -> testable. serve_req_n serves it arena-scoped. The dict
// dispatch above stays for backward compat; a given app uses ONE style (typed handlers here).
//
// Handlers take `req: Request` as a TYPED PARAMETER -> field access resolves per-struct
// (sound; see the cross-module field-resolution fix). Return a Response via resp_json/
// resp_text/resp_html -- e.g. `return forge.resp_json(200, user)` for "return your type, get JSON".
// ── Static file serving (Phase 1) ─ traversal-safe by path-segment whitelist ──
// static(a, url_prefix, root_dir) mounts a directory: a GET/HEAD whose path begins with
// url_prefix (at a segment boundary) is served from root_dir. _safe_subpath whitelists path
// segments so no "..", no absolute / backslash / drive path, and no dotfile (.env / .git / ...)
// can be reached TEXTUALLY -- the served path string cannot escape root_dir, and unlike most
// frameworks Forge never serves dotfiles. CAVEAT (not yet closed): the whitelist is textual and
// does NOT resolve symlinks, so a symlink placed inside root_dir that points outside it would be
// followed; realpath-containment is a tracked follow-up. Do not mount a directory containing
// untrusted symlinks until then.
fn static(a, url_prefix: string, root_dir: string)
    push(a["statics"], [url_prefix, root_dir])
    a

// A single path segment is UNSAFE if it is "..", a dotfile (leading "."), or contains a
// backslash or colon (Windows separator / drive-letter / NTFS alternate-data-stream). "."
// and empty segments are skipped by the caller before this check.
fn _unsafe_segment(seg: string) -> bool
    if seg == ".."
        return true
    if starts_with(seg, ".")
        return true
    if find(seg, "\\") >= 0
        return true
    if find(seg, ":") >= 0
        return true
    false

// Sanitize a URL subpath into a safe relative filesystem path. err on ANY traversal attempt.
// The segment whitelist makes TEXTUAL escape impossible: every surviving segment is an ordinary
// name, so root_dir + "/" + result stays inside root_dir as a string (symlink resolution is a
// separate, tracked containment check -- see static()).
fn _safe_subpath(rel: string)
    // Percent-decode FIRST (plus_space=false: '+' is literal in a path), so encoded traversal like
    // %2e%2e%2f -> ../ is normalised and then caught by the segment whitelist below.
    let r = _pct_decode(rel, false)
    if starts_with(r, "/")
        r = slice(r, 1, len(r))
    let parts = split(r, "/")
    let clean = ""
    let i = 0
    while i < len(parts)
        let seg = parts[i]
        if seg == "" or seg == "."
            i = i + 1
        else if _unsafe_segment(seg)
            return err("unsafe path segment")
        else
            if clean == ""
                clean = seg
            else
                clean = clean + "/" + seg
            i = i + 1
    ok(clean)

// A static mount matches the request path only at a SEGMENT boundary: exactly the prefix, under
// it as "<prefix>/...", or the root mount "/". So mount "/app" does NOT shadow "/application".
// Returns ok(subpath-after-prefix) on a match, err otherwise.
fn _static_match(path: string, prefix: string)
    if prefix == "/"
        return ok(slice(path, 1, len(path)))
    if path == prefix
        return ok("")
    if starts_with(path, prefix + "/")
        return ok(slice(path, len(prefix), len(path)))
    err("no prefix match")

// Parse a single "Range: bytes=START-END" header against a known total size. Returns [start, end]
// (inclusive, 0-based, clamped) when satisfiable; [-2, -2] present-but-unsatisfiable (caller -> 416);
// [-1, -1] absent/unsupported (non-bytes, multi-range, or malformed -> caller serves the full 200).
// Forms: "2-5" (explicit), "2-" (from 2 to end), "-5" (the last 5 bytes / suffix).
fn _parse_range(rv: string, total: int) -> list
    if not starts_with(rv, "bytes=")
        return [-1, -1]
    let spec = trim(slice(rv, 6, len(rv)))
    if find(spec, ",") >= 0
        return [-1, -1]
    let dash = find(spec, "-")
    if dash < 0
        return [-1, -1]
    let lhs = trim(slice(spec, 0, dash))
    let rhs = trim(slice(spec, dash + 1, len(spec)))
    if total <= 0
        return [-2, -2]
    let start = 0
    let end = total - 1
    if lhs == ""
        if not _is_digits(rhs)
            return [-1, -1]
        // a suffix length with 16+ digits is >= any servable file -> "the whole file"; cap BEFORE parse_int
        // so an overflowing value cannot wrap i64 to a small/negative (wrong) length.
        let n = total
        if len(rhs) <= 15
            n = parse_int(rhs)
        if n <= 0
            return [-2, -2]
        if n > total
            n = total
        start = total - n
        end = total - 1
    else
        if not _is_digits(lhs)
            return [-1, -1]
        // a start with 16+ digits is beyond any servable file (and would overflow parse_int -> a wrapped,
        // possibly negative start) -> unsatisfiable.
        if len(lhs) > 15
            return [-2, -2]
        start = parse_int(lhs)
        if rhs == ""
            end = total - 1
        else
            if not _is_digits(rhs)
                return [-1, -1]
            // a 16+ digit end is past the file end -> clamp to the last byte (avoids the parse_int overflow)
            if len(rhs) > 15
                end = total - 1
            else
                end = parse_int(rhs)
        if end > total - 1
            end = total - 1
        if start > end or start >= total
            return [-2, -2]
    [start, end]

// Serve a 206 Partial Content (or 416) for a binary static file given a Range header value. Uses
// seek + file_read_bytes so only the requested slice is read -- a 1MB range of a 4GB video never
// loads the whole file. Returns ok(Response 206/416) on a range, err("no range") to fall through to
// the full 200 path. Weak size+mtime validator (the full path keeps its strong content-hash ETag).
fn _range_response(fpath: string, ct: string, rh: string)
    let total = file_size(fpath)
    let rng = _parse_range(rh, total)
    let rstart = rng[0]
    let rend = rng[1]
    if rstart == -2
        let h416 = {}
        h416["Content-Type"] = ct
        h416["Content-Range"] = "bytes */" + str(total)
        h416["Accept-Ranges"] = "bytes"
        return ok(Response(416, h416, "", false, []))
    if rstart < 0
        return err("no range")
    let rlen = rend - rstart + 1
    // file_read_bytes hard-rejects n > 512MB (returns empty). Cap the read so a huge requested range
    // (e.g. "bytes=0-" on a 4GB file) yields a VALID 206 SUB-range rather than an empty body whose
    // Content-Range lies. Serving fewer bytes than requested is legal HTTP; a client just asks for more.
    let cap = 536870912
    if rlen > cap
        rlen = cap
    let fh = file_open(fpath, "rb")
    if fh == 0
        return err("open failed")
    file_seek(fh, rstart)
    let part = file_read_bytes(fh, rlen)
    file_close(fh)
    // Re-derive the END from the bytes ACTUALLY read, so Content-Range + Content-Length always agree even
    // after a cap or a short read (file truncated between stat and read). 0 bytes -> representation gone.
    let got = bytes_len(part)
    if got <= 0
        return err("empty read")
    let aend = rstart + got - 1
    let hr = {}
    hr["Content-Type"] = ct
    hr["Accept-Ranges"] = "bytes"
    hr["Content-Range"] = "bytes " + str(rstart) + "-" + str(aend) + "/" + str(total)
    hr["Cache-Control"] = "no-cache"
    hr["ETag"] = "W/" + chr(34) + str(total) + "-" + str(file_mtime(fpath)) + chr(34)
    ok(Response(206, hr, part, false, []))

// Try to serve req.path from a registered static mount: ok(Response) if a mount matched at a
// segment boundary AND the sanitized file exists; err otherwise (caller falls through to 404). An
// empty subpath (the mount root) serves index.html. Text-correct; binary assets (read_file stops
// at an embedded NUL) await the bytes/streaming Response.
fn _try_static(a, req: Request)
    let mounts = a["statics"]
    let i = 0
    while i < len(mounts)
        let m = mounts[i]
        let prefix = m[0]
        let root = m[1]
        let mp = _static_match(req.path, prefix)
        if is_ok(mp)
            let safe = _safe_subpath(unwrap(mp))
            if is_ok(safe)
                let cleanrel = unwrap(safe)
                if cleanrel == ""
                    cleanrel = "index.html"
                let fpath = root + "/" + cleanrel
                if file_exists(fpath)
                    let ct = _ext_ctype(cleanrel)
                    let h = {}
                    h["Content-Type"] = ct
                    h["Cache-Control"] = "no-cache"
                    // TEXT assets serve as a string (existing path: string body, inspectable). BINARY assets
                    // (image/pdf/wasm/...) serve via read_bytes -- read_file truncates at the first NUL -- and
                    // the bytes body flows through the type_name(body)=="bytes" wire path (S3, tcp_send_bytes).
                    // ETag is a strong content hash either way (a browser echoes it in If-None-Match -> 304).
                    if _ct_is_text(ct)
                        let tcontent = read_file(fpath)
                        let tetag = chr(34) + sha256(tcontent) + chr(34)
                        h["ETag"] = tetag
                        if req_header(req, "if-none-match") == tetag
                            return ok(Response(304, h, "", false, []))
                        return ok(Response(200, h, tcontent, false, []))
                    // Range request (browser video/audio seeking, resumable downloads): serve a 206
                    // Partial Content via seek + partial read, never loading the whole file. A valid
                    // range short-circuits here; absent/unsupported ranges fall through to the full 200.
                    h["Accept-Ranges"] = "bytes"
                    let rh = req_header(req, "range")
                    if rh != ""
                        let rr = _range_response(fpath, ct, rh)
                        if is_ok(rr)
                            return rr
                    let bcontent = read_bytes(fpath)
                    let betag = chr(34) + sha256_of_bytes(bcontent) + chr(34)
                    h["ETag"] = betag
                    if req_header(req, "if-none-match") == betag
                        return ok(Response(304, h, "", false, []))
                    return ok(Response(200, h, bcontent, false, []))
        i = i + 1
    err("no static match")

// The route-match TERMINAL of the typed chain: find the matching route, bind path params,
// run the handler through _coerce. 404/405 exactly as before. This is the innermost layer --
// the middleware fold wraps around it.
fn _dispatch_terminal(a, req: Request) -> Response
    let routes = a["routes"]
    let allowed = ""
    let i = 0
    while i < len(routes)
        let rt = routes[i]
        let mr = _fr_match(rt[1], req.path)
        if is_ok(mr)
            // HEAD is routed like GET (same handler); _finalize2 drops the body on the way out.
            if rt[0] == req.method or rt[0] == "*" or (req.method == "HEAD" and rt[0] == "GET")
                req.params = unwrap(mr)
                req.state["route"] = rt[1]
                let h = rt[2]
                // A doc route (6-tuple) with a declared response model auto-projects a bare-struct return
                // through it -> wire body and OpenAPI 200 schema come from ONE sample (no-drift). Plain
                // routes (3-tuple) and Response/string returns are byte-identical to before (zero overhead).
                if len(rt) >= 6
                    return _coerce_model(h(req), rt[4])
                return _coerce(h(req))
            else
                // Path matches but method differs -> collect the allowed methods for the Allow header.
                if allowed == ""
                    allowed = rt[0]
                else
                    allowed = allowed + ", " + rt[0]
        i = i + 1
    // No route matched the (path, method). Try static mounts (GET/HEAD only) before 404.
    if req.method == "GET" or req.method == "HEAD"
        let sr = _try_static(a, req)
        if is_ok(sr)
            return unwrap(sr)
    if allowed != ""
        // 405 Method Not Allowed MUST advertise the allowed methods (RFC 9110 requires the Allow header).
        return resp_set_header(resp_text(405, "method not allowed"), "Allow", allowed)
    // Custom 404 handler if the app registered one (on_not_found); else the default text 404.
    if contains(a, "not_found")
        let nf = a["not_found"]
        return _coerce(nf(req))
    resp_text(404, "no route: " + req.method + " " + req.path)

// Typed middleware wrapper: bind `next` so a fn(req: Request, next) -> Response middleware
// becomes a plain fn(Request) -> Response. _coerce lets a middleware short-circuit by
// returning a bare string/struct (e.g. a 401 body) just like a handler.
fn _t_wrap(mw, next)
    return fn(req) _coerce(mw(req, next))

// Typed dispatch: fold the app's middleware OUTSIDE-IN around the route terminal, then run.
// First-registered middleware is outermost (sees the request first, the response last). The
// fold closures are created and consumed INSIDE this function -- which runs in the SPAWNED
// child on the concurrent/crash-isolated serve paths -- so no fold closure ever crosses a
// process boundary. Only the plain middleware fn values (stored in the app's "mws" list) are
// deep-copied across spawn, exactly as route handlers already are; capturing-closure
// middleware (e.g. mw_set_header(name,value)) survives that copy intact (verified).
fn dispatch_req(a, req: Request) -> Response
    let h = fn(r) _dispatch_terminal(a, r)
    let mws = a["mws"]
    let i = len(mws) - 1
    while i >= 0
        h = _t_wrap(mws[i], h)
        i = i - 1
    h(req)

// ── Typed middleware (Phase 1) ─ fn(req: Request, next) -> Response ────────────
// Typed middleware operates on the Request / Response STRUCTS (the typed handler model),
// distinct from the dict-request middleware above. Register with use(a, mw); dispatch_req
// folds them outside-in around the route terminal. A middleware calls next(req) to obtain
// the downstream Response, may modify it, or may short-circuit by returning its own value
// (string / struct / Response -- coerced). A middleware may be a plain top-level fn(req,
// next) or a builder-returned capturing closure; both fold identically and both survive the
// spawn boundary on the concurrent / crash-isolated serve paths.

// Inject a response header on every response (capturing closure over name/value).
fn mw_set_header(name: string, value: string)
    return fn(req, next) resp_set_header(next(req), name, value)

// CORS middleware. Adds Access-Control-Allow-Origin to every response AND answers the browser
// PREFLIGHT (an OPTIONS request the browser sends before any cross-origin call) with 204 + the
// allowed methods/headers, short-circuiting before the route terminal. Without preflight handling
// a browser frontend on a different origin cannot call the API at all.
fn _t_cors(req: Request, next, origin: string) -> Response
    if req.method == "OPTIONS"
        let p = resp_new(204, "")
        p = resp_set_header(p, "Access-Control-Allow-Origin", origin)
        p = resp_set_header(p, "Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
        p = resp_set_header(p, "Access-Control-Allow-Headers", "Content-Type, Authorization")
        p = resp_set_header(p, "Access-Control-Max-Age", "86400")
        return p
    resp_set_header(next(req), "Access-Control-Allow-Origin", origin)

fn mw_cors_origin(origin: string)
    return fn(req, next) _t_cors(req, next, origin)

// Security headers: defense-in-depth defaults added to every response (what helmet / Spring
// Security / Django's SecurityMiddleware provide). nosniff stops MIME-confusion attacks;
// SAMEORIGIN blocks cross-origin framing (clickjacking) while allowing same-origin; no-referrer
// avoids leaking the URL on outbound navigation. Non-breaking defaults; an app overrides per-route.
fn _t_sec_headers(req: Request, next) -> Response
    let r = next(req)
    r = resp_set_header(r, "X-Content-Type-Options", "nosniff")
    r = resp_set_header(r, "X-Frame-Options", "SAMEORIGIN")
    r = resp_set_header(r, "Referrer-Policy", "no-referrer")
    r

fn mw_security_headers()
    return fn(req, next) _t_sec_headers(req, next)

// Per-route request body size limit: reject with 413 before the handler runs if the (already-read)
// body exceeds maxBytes. Complements the global recv cap (SEC-2) with a configurable per-route bound.
fn _t_limit_body(req: Request, next, maxBytes: int) -> Response
    if len(req.body) > maxBytes
        return resp_text(413, "payload too large")
    next(req)

fn mw_limit_body(maxBytes: int)
    return fn(req, next) _t_limit_body(req, next, maxBytes)

// Request-ID middleware: honor an incoming X-Request-Id (trace propagation across services) or
// mint a fresh one, expose it to the handler via req.state["request_id"], and echo it on the
// response. The basis for correlated logging/tracing.
fn _t_request_id(req: Request, next) -> Response
    let rid = req_header(req, "x-request-id")
    if rid == ""
        rid = "req-" + str(random_int(1, 2147483647)) + "-" + str(random_int(1, 2147483647))
    req.state["request_id"] = rid
    resp_set_header(next(req), "X-Request-Id", rid)

fn mw_request_id()
    return fn(req, next) _t_request_id(req, next)

// Fixed-window rate limit: at most `max` requests per `window_ms` per client (keyed by
// X-Forwarded-For -- the reverse-proxy norm -- or a shared "global" bucket if absent). Over the
// limit -> 429. State is a dict captured by the middleware closure (persists across requests);
// safe under the default single-carrier cooperative scheduler. (The lock-free owner-actor variant
// for N>1 carriers is a later refinement.)
fn _t_rate_limit(req: Request, next, state, lim: int, window_ms: int) -> Response
    let key = req_header(req, "x-forwarded-for")
    if key == ""
        key = "global"
    let now = time_ms()
    let start = now
    let count = 0
    if contains(state, key)
        let cur = state[key]
        count = cur[0]
        start = cur[1]
        if now - start >= window_ms
            count = 0
            start = now
    count = count + 1
    state[key] = [count, start]
    if count > lim
        return resp_text(429, "rate limit exceeded")
    next(req)

fn mw_rate_limit(lim: int, window_ms: int)
    let state = {}
    return fn(req, next) _t_rate_limit(req, next, state, lim, window_ms)

// Built-in health endpoint. forge.health_route(app) registers GET /health -> 200 {"status":"ok"}
// (+ HEAD via the GET path), the liveness probe orchestrators (k8s, load balancers) expect.
type Health
    status: string

fn _health_handler(req: Request) -> Health
    Health("ok")

fn health_route(a)
    get(a, "/health", _health_handler)
    a

// Logging: print method + path, then pass through (typed Request).
fn _t_log_next(req: Request, next)
    print("[forge] " + req.method + " " + req.path)
    next(req)

fn mw_log()
    return fn(req, next) _t_log_next(req, next)

// Access log: log "METHOD path -> status" AFTER the response (the status is the useful part vs
// mw_log's request-only line) -- the standard access-log line, paired with request-id for tracing.
fn _t_access_log(req: Request, next) -> Response
    let resp = next(req)
    print("[forge] " + req.method + " " + req.path + " -> " + str(resp.status))
    resp

fn mw_access_log()
    return fn(req, next) _t_access_log(req, next)

// Per-request arena-scoped typed handling: build the Request, dispatch to a typed handler,
// finalize the Response to wire ONCE, send, free the arena wholesale. Runs as the body of a
// per-connection green task (spawn-per-connection below). The arena is PER-TASK (NovaTaskState),
// so concurrent connections each hold an independent arena -- flat per-request memory under
// concurrency, proven sound (forge_spawn_test: N concurrent, per-task arena, ASAN-clean).
// Max requests served on a single kept-alive connection before forcing a close -- bounds
// per-connection work and guarantees the connection eventually frees, even for a well-behaved
// client that keeps reusing it.
fn _max_keepalive() -> int
    100

// Keep a connection alive unless the client asked to close or the cap is reached. Default is
// keep-alive (treat as HTTP/1.1); a 1.0 client that does not reuse simply closes, and our next
// read returns empty -> we close too, so defaulting to keep-alive is safe for both.
fn _want_keep_alive(req: Request, count: int) -> bool
    if count >= _max_keepalive()
        return false
    lower(req_header(req, "connection")) != "close"

fn _dispatch_pick(a, req: Request, safe: int) -> Response
    if safe == 1
        return dispatch_safe(a, req)
    dispatch_req(a, req)

// Handle ONE connection with HTTP/1.1 keep-alive: loop request->response on the SAME socket. Each
// iteration is bracketed by arena_enter/arena_exit (the per-request arena -- flat memory freed
// wholesale), while the socket fd and the request counter live OUTSIDE the arena. The loop ends
// on client close (empty read), an explicit `Connection: close`, or the max-requests cap. safe=1
// routes each request through the crash-isolated dispatch. (Non-pipelined keep-alive: a client
// that sends the next request only after reading the prior response -- the common case.)
fn _serve_conn(conn: int, a, safe: int)
    let count = 0
    let alive = true
    while alive
        let prev = arena_enter()
        let raw = recv_request_bin(conn, _read_timeout_ms(a))
        if bytes_len(raw) == 0
            arena_exit(prev)
            alive = false
        else
            let req: Request = _build_req_from_bytes(raw, conn)
            // WebSocket upgrade: if a ws route matches, do the 101 handshake, exit the REQUEST arena
            // (Regime A -> B: the long frame loop runs with active_arena==NULL), hand the socket to the
            // frame loop, and RETURN -- _ws_run is the SOLE owner of tcp_close (never fall through).
            let route = _ws_lookup(a, req)
            if len(route) >= 2
                if not ws_authz_ok(a, req, route[0])
                    // Pre-101 rejection: an unauthorized client never gets an open socket. The 401 bytes
                    // are sent BEFORE arena_exit (same arena discipline as ws_handshake's 400 path).
                    tcp_send(conn, "HTTP/1.1 401 Unauthorized\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                    arena_exit(prev)
                    alive = false
                else
                    let kams = _ws_app_ka(a)
                    if ws_handshake(conn, req) == 1
                        arena_exit(prev)
                        _ws_run(conn, route, kams)
                        return
                    arena_exit(prev)
                    alive = false
            else
                // Server-Sent Events: a GET matching an sse route hijacks the connection into a long-lived
                // text/event-stream (like ws, exit the request arena BEFORE the stream loop and RETURN --
                // _sse_run is the sole owner of tcp_close).
                let sroute = _sse_lookup(a, req)
                if len(sroute) >= 2
                    arena_exit(prev)
                    _sse_run(conn, sroute)
                    return
                // chunked streaming: a GET matching a stream route hijacks the connection into a chunked
                // response (exit the request arena BEFORE the producer runs, RETURN -- _stream_run owns close)
                let xroute = _stream_lookup(a, req)
                if len(xroute) >= 2
                    arena_exit(prev)
                    _stream_run(conn, xroute)
                    return
                let ka = _want_keep_alive(req, count)
                let resp: Response = _dispatch_pick(a, req, safe)
                tcp_send(conn, _finalize2(resp, req.method, ka))
                // Binary body: _finalize2 returned header-only; send the bytes length-exact (NUL-safe) BEFORE
                // arena_exit reclaims an arena-allocated buffer (e.g. read_bytes inside this request arena).
                if type_name(resp.body) == "bytes" and req.method != "HEAD"
                    tcp_send_bytes(conn, resp.body)
                count = count + 1
                arena_exit(prev)
                if not ka
                    alive = false
    tcp_close(conn)

fn _handle_req_arena(conn: int, a)
    _serve_conn(conn, a, 0)

// done-signaling wrapper for the deterministic serve_req_n.
fn _handle_req_done(conn: int, a, done)
    _handle_req_arena(conn, a)
    send(done, 1)

// SPAWN-PER-CONNECTION (the G1 fix): each accepted connection runs in its own green task, so
// the accept loop never blocks on a slow handler -- 10k concurrent connections, straight-line
// handlers, no async coloring. Serve exactly N requests, waiting for all N handlers to finish
// before closing (deterministic -> testable).
fn serve_req_n(a, port: int, n: int)
    let listener = tcp_listen(port)
    let done = channel()
    let i = 0
    while i < n
        let conn = tcp_accept(listener)
        if conn >= 0
            let c = conn
            let ap = a
            let dc = done
            sched_spawn(fn(z) _handle_req_done(c, ap, dc))
        i = i + 1
    let j = 0
    while j < n
        recv(done)
        j = j + 1
    tcp_close(listener)

// T1.3: accept-side connection cap. A semaphore channel pre-filled with N permits bounds the number of
// concurrent in-flight connections -- so an accept storm can never spawn unbounded handlers (which would
// exhaust memory/FDs). The acceptor recv()s a permit before spawning (parks at the cap -> natural
// backpressure: excess connections wait in the OS backlog) and the handler send()s it back when the
// connection closes. Same channel-as-semaphore shape as the DB pool. Default cap = _max_conns().
fn _max_conns() -> int
    10000

fn _conn_sem(n: int)
    let ch = channel()
    let i = 0
    while i < n
        send(ch, 1)
        i = i + 1
    ch

// Per-connection handler that RELEASES its cap permit when the connection finally closes (keep-alive
// included, since _serve_conn loops until the connection ends). Always runs -> no permit leak.
fn _handle_req_capped(conn: int, a, sem)
    _serve_conn(conn, a, 0)
    send(sem, 1)

// S-c (FORGE_ACCEPT_POLLER_PLAN.md): one acceptor loop. Each accepts ONE connection, ACQUIRES a cap permit,
// spawns its handler (UNPINNED via sched_spawn -> work-steals across carriers), and re-parks -- so a backlog
// fans out across acceptors (the poller's wake-one wakes the oldest acceptor FIFO). tcp_accept returns <0
// when the listener is closed (graceful shutdown) -> the acceptor exits cleanly (N1-exit delivers -1); the
// <0 check is BEFORE recv(sem) so shutdown never leaks a permit.
fn _acceptor(listener: int, a, sem)
    while true
        let conn = tcp_accept(listener)
        if conn < 0
            return
        recv(sem)
        let c = conn
        let ap = a
        let s = sem
        sched_spawn(fn(z) _handle_req_capped(c, ap, s))

// Infinite spawn-per-connection serve. At N>1 fans out one PINNED acceptor per carrier (sched_spawn_on) so
// accept + dispatch parallelize across cores; the server task then parks forever (the acceptors serve). At
// N=1 it runs a single acceptor inline (the original single-loop behavior, byte-identical).
fn serve_req(a, port: int)
    let listener = tcp_listen(port)
    let sem = _conn_sem(_max_conns())
    let nc = sched_carrier_count()
    if nc <= 1
        _acceptor(listener, a, sem)
    else
        let i = 0
        while i < nc
            let li = listener
            let ai = a
            let se = sem
            sched_spawn_on(i, fn(z) _acceptor(li, ai, se))
            i = i + 1
        let block = channel()
        recv(block)

// ── Crash isolation (Phase 1) ─ recover: handler panic -> 500, the server lives ──────────
// NOVA's "let it crash": dispatch_safe runs the routed handler in a MONITORED process. On a
// normal return it channels the Response back (deep-copied across the process boundary). On a
// PANIC the monitor reports the crash and dispatch_safe returns a clean 500 -- the request
// fails, the server survives. Erlang-class fault tolerance at native (AOT) speed: Go/Node/
// Spring cannot contain a handler crash to a single request without ceremony. (Proven by the
// recover probe: good -> 200 Response intact, panic -> 500, program survived.)
fn _dispatch_run(a, req, rc)
    let r: Response = dispatch_req(a, req)
    send(rc, r)

fn dispatch_safe(a, req: Request) -> Response
    let rc = channel()
    let ap = a
    let rq = req
    let c = rc
    let p = spawn _dispatch_run(ap, rq, c)
    let m = monitor(p)
    let st = receive(m)
    if st == 0
        return receive(rc)
    resp_text(500, "Internal Server Error")

// Crash-isolated per-connection handling: a handler panic returns a clean 500 to the client
// (not a dropped connection), and the accept loop keeps serving. Also fixes the serve_req_n
// hang-on-panic (the done signal is always sent, since dispatch_safe never panics).
fn _handle_req_safe(conn: int, a)
    _serve_conn(conn, a, 1)

fn _handle_req_safe_done(conn: int, a, done)
    _handle_req_safe(conn, a)
    send(done, 1)

// Spawn-per-connection + crash-isolated serve. Each connection -> own green task; each handler
// -> monitored sub-process; a handler panic -> 500 + server lives. serve_safe_req_n waits N.
fn serve_safe_req_n(a, port: int, n: int)
    let listener = tcp_listen(port)
    let done = channel()
    let i = 0
    while i < n
        let conn = tcp_accept(listener)
        if conn >= 0
            let c = conn
            let ap = a
            let dc = done
            sched_spawn(fn(z) _handle_req_safe_done(c, ap, dc))
        i = i + 1
    let j = 0
    while j < n
        recv(done)
        j = j + 1
    tcp_close(listener)

// Capped + crash-isolated per-connection handler (releases its permit on close).
fn _handle_req_safe_capped(conn: int, a, sem)
    _serve_conn(conn, a, 1)
    send(sem, 1)

fn serve_safe_req(a, port: int)
    let listener = tcp_listen(port)
    let sem = _conn_sem(_max_conns())
    while true
        let conn = tcp_accept(listener)
        if conn < 0
            return
        recv(sem)
        let c = conn
        let ap = a
        let s = sem
        sched_spawn(fn(z) _handle_req_safe_capped(c, ap, s))

