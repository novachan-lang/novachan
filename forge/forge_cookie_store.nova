// forge_cookie_store — HTTP cookie management with expiry and Result API.

fn cs_new() -> dict
    {"cookie_count": 0, "total_reads": 0}

fn cs_set(c: dict, name: string, value: string, max_age: int) -> dict
    let ck = "c_{name}"
    if ck + "_val" not in c
        c["cookie_count"] += 1
    c[ck + "_val"] = value
    c[ck + "_age"] = max_age
    c[ck + "_remaining"] = max_age
    c

fn cs_get(c: dict, name: string) -> Result
    c["total_reads"] += 1
    let ck = "c_{name}_val"
    if ck not in c
        return err("cookie not found: {name}")
    let rk = "c_{name}_remaining"
    if c[rk] <= 0
        return err("cookie expired: {name}")
    ok(c[ck])

fn cs_tick(c: dict, name: string, elapsed: int) -> Result
    let rk = "c_{name}_remaining"
    if rk not in c
        return err("cookie not found: {name}")
    c[rk] -= elapsed
    ok(c)

fn cs_is_expired(c: dict, name: string) -> int
    let rk = "c_{name}_remaining"
    if rk not in c
        return 1
    1 if c[rk] <= 0 else 0

fn cs_cookie_count(c: dict) -> int
    c["cookie_count"]

fn cs_total_reads(c: dict) -> int
    c["total_reads"]
