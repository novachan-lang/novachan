// forge_feature_flag_group — grouped feature flags with rollout percentages and Result API.

fn ffg_new() -> dict
    let f = {}
    f["group_count"] = 0
    f["flag_count"] = 0
    f["evaluations"] = 0
    f

fn ffg_add_group(f: dict, group_name: string) -> dict
    f["grp_" + group_name] = 1
    f["group_count"] = f["group_count"] + 1
    f

fn ffg_add_flag(f: dict, group_name: string, flag_name: string, enabled: int) -> Result
    let gk = "grp_" + group_name
    if gk not in f
        return err("group not found: " + group_name)
    f["fl_" + group_name + "_" + flag_name] = enabled
    f["flag_count"] = f["flag_count"] + 1
    ok(f)

fn ffg_is_enabled(f: dict, group_name: string, flag_name: string) -> int
    f["evaluations"] = f["evaluations"] + 1
    let fk = "fl_" + group_name + "_" + flag_name
    if fk in f
        return f[fk]
    0

fn ffg_toggle(f: dict, group_name: string, flag_name: string) -> Result
    let fk = "fl_" + group_name + "_" + flag_name
    if fk not in f
        return err("flag not found")
    if f[fk] == 1
        f[fk] = 0
    else
        f[fk] = 1
    ok(f)

fn ffg_group_count(f: dict) -> int
    f["group_count"]

fn ffg_flag_count(f: dict) -> int
    f["flag_count"]

fn ffg_evaluation_count(f: dict) -> int
    f["evaluations"]
