// forge_stopwatch -- monotonic timing for profiling, micro-benchmarks, and latency measurement. Uses clock_ns
// (a monotonic clock immune to wall-clock/NTP adjustments), so intervals are always non-negative and accurate.
// sw_start captures a start; sw_elapsed_ms/us return the interval since. LEAF -- imports NOTHING.

// Start: returns the start timestamp in nanoseconds.
fn sw_start() -> int
    clock_ns()

// Milliseconds elapsed since `start`.
fn sw_elapsed_ms(start: int) -> int
    (clock_ns() - start) / 1000000

// Microseconds elapsed since `start`.
fn sw_elapsed_us(start: int) -> int
    (clock_ns() - start) / 1000

// Nanoseconds elapsed since `start`.
fn sw_elapsed_ns(start: int) -> int
    clock_ns() - start
