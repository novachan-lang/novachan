// forge_outbox_pattern — Transactional outbox for reliable messaging.

fn ob_new() -> dict
    {"entries": {}, "count": 0, "published": 0, "failed": 0}

fn ob_add(o: dict, event_type: string, payload: string) -> dict
    let k = str(o["count"])
    o["entries"]["{k}_type"] = event_type
    o["entries"]["{k}_payload"] = payload
    o["entries"]["{k}_status"] = "pending"
    o["count"] += 1
    o

fn ob_mark_published(o: dict, idx: int) -> Result
    if idx < 0
        return err("invalid index")
    if idx >= o["count"]
        return err("index out of range")
    let k = str(idx)
    o["entries"]["{k}_status"] = "published"
    o["published"] += 1
    ok(o)

fn ob_mark_failed(o: dict, idx: int) -> Result
    if idx < 0
        return err("invalid index")
    if idx >= o["count"]
        return err("index out of range")
    let k = str(idx)
    o["entries"]["{k}_status"] = "failed"
    o["failed"] += 1
    ok(o)

fn ob_entry_type(o: dict, idx: int) -> Result
    if idx < 0
        return err("invalid index")
    if idx >= o["count"]
        return err("index out of range")
    let k = str(idx)
    ok(o["entries"]["{k}_type"])

fn ob_entry_payload(o: dict, idx: int) -> Result
    if idx < 0
        return err("invalid index")
    if idx >= o["count"]
        return err("index out of range")
    let k = str(idx)
    ok(o["entries"]["{k}_payload"])

fn ob_entry_status(o: dict, idx: int) -> string
    let k = str(idx)
    o["entries"]["{k}_status"]

fn ob_pending_count(o: dict) -> int
    o["count"] - o["published"] - o["failed"]

fn ob_total_count(o: dict) -> int
    o["count"]

fn ob_publish_rate(o: dict) -> int
    if o["count"] == 0
        return 0
    o["published"] * 100 / o["count"]
