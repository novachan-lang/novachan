// forge_pwpolicy -- password STRENGTH policy + entropy estimate (OWASP ASVS, NIST 800-63B, zxcvbn-lite).
// Complements forge_auth (which HASHES/verifies a stored password); this decides whether to ACCEPT one at
// signup/change: length, character-class diversity, a common-password blocklist, and an entropy estimate from
// the character pool actually used. Returns human-readable failures for the UI. LEAF -- imports NOTHING.

fn _has_class(pw: string, cls: string) -> bool
    for i in 0..len(pw)
        if find(cls, char_at(pw, i)) >= 0
            return true
    false

// PRIVATE: the symbol pool, built with chr() so no literal { } appears in a NOVA string literal.
fn _pw_symbols() -> string
    "!@#$%^&*()-_=+[];:,.<>?/|~" + chr(123) + chr(125)

// How many of the four classes (lower/upper/digit/symbol) appear.
fn pw_classes(pw: string) -> int
    let n = 0
    if _has_class(pw, "abcdefghijklmnopqrstuvwxyz")
        n += 1
    if _has_class(pw, "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
        n += 1
    if _has_class(pw, "0123456789")
        n += 1
    if _has_class(pw, _pw_symbols())
        n += 1
    n

fn _floor_log2(x: int) -> int
    let n = 0
    let v = x
    while v > 1
        v = v / 2
        n += 1
    n

// Conservative entropy estimate in bits: length * floor(log2(pool size of the classes used)). Floor keeps it
// an underestimate. Guidance: >= 60 strong, < 28 weak.
fn pw_entropy(pw: string) -> int
    let pool = 0
    if _has_class(pw, "abcdefghijklmnopqrstuvwxyz")
        pool += 26
    if _has_class(pw, "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
        pool += 26
    if _has_class(pw, "0123456789")
        pool += 10
    if _has_class(pw, _pw_symbols())
        pool += 33
    if pool == 0
        return 0
    len(pw) * _floor_log2(pool)

// PRIVATE: a small common-weak-password blocklist (extend from a file/DB in production).
fn _pw_common(pw: string) -> bool
    let bad = ["password", "123456", "123456789", "qwerty", "111111", "12345678", "abc123", "password1", "letmein", "welcome", "admin", "iloveyou", "monkey", "dragon"]
    contains(bad, lower(pw))

// Validate against a policy. [] if acceptable, else a list of human-readable failure messages.
fn pw_check(pw: string, min_len: int, min_classes: int) -> list
    let errs = []
    if len(pw) < min_len
        push(errs, "too short (min {min_len} chars)")
    if pw_classes(pw) < min_classes
        push(errs, "needs at least {min_classes} character types (lower/upper/digit/symbol)")
    if _pw_common(pw)
        push(errs, "too common / easily guessed")
    errs

// True iff the password passes the policy AND meets a minimum entropy.
fn pw_ok(pw: string, min_len: int, min_classes: int, min_bits: int) -> bool
    if len(pw_check(pw, min_len, min_classes)) > 0
        return false
    pw_entropy(pw) >= min_bits

// A 0..4 strength score (zxcvbn-style) from entropy: <28->0, <36->1, <60->2, <128->3, else 4.
fn pw_score(pw: string) -> int
    let e = pw_entropy(pw)
    if e < 28
        return 0
    if e < 36
        return 1
    if e < 60
        return 2
    if e < 128
        return 3
    4
