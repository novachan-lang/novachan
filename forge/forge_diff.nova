// forge_diff -- field-level diff between two record versions, for audit logs / change history ("field X
// changed from A to B"). dict_diff(before, after) -> a list of {field, old, new} changes (added / changed /
// removed). Pair with forge_hooks (before_save) + admin_audit to record WHAT changed on every mutation.
// LEAF -- imports NOTHING.

fn dict_diff(before: dict, after: dict) -> list
    let changes = []
    for k in keys(after)
        let oldv = ""
        let had = 0
        if k in before
            oldv = str(before[k])
            had = 1
        let newv = str(after[k])
        if had == 0 or oldv != newv
            push(changes, {"field": k, "old": oldv, "new": newv})
    for k in keys(before)
        if k not in after
            push(changes, {"field": k, "old": str(before[k]), "new": ""})
    changes

// True iff anything changed between the two versions.
fn dict_changed(before: dict, after: dict) -> bool
    len(dict_diff(before, after)) > 0
