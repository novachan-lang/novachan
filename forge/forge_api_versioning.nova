// forge_api_versioning — API version management.
// Register versions, deprecation, routing by version header/path.

fn apiv_new() -> dict
    let a = {}
    a["versions"] = {}
    a["current"] = ""
    a["deprecated"] = []
    a

fn apiv_register(av: dict, version: string, status: string) -> dict
    let v = {}
    v["status"] = status
    v["endpoints"] = []
    v["sunset_date"] = ""
    av["versions"][version] = v
    if status == "current"
        av["current"] = version
    av

fn apiv_add_endpoint(av: dict, version: string, method: string, path: string) -> dict
    let has_ver = contains(av["versions"], version)
    if has_ver == true
        let ep = {}
        ep["method"] = method
        ep["path"] = path
        push(av["versions"][version]["endpoints"], ep)
    av

fn apiv_deprecate(av: dict, version: string, sunset: string) -> dict
    let has_ver = contains(av["versions"], version)
    if has_ver == true
        av["versions"][version]["status"] = "deprecated"
        av["versions"][version]["sunset_date"] = sunset
        push(av["deprecated"], version)
    av

fn apiv_is_deprecated(av: dict, version: string) -> bool
    let i = 0
    while i < len(av["deprecated"])
        if av["deprecated"][i] == version
            return true
        i += 1
    false

fn apiv_current(av: dict) -> string
    av["current"]

fn apiv_list_versions(av: dict) -> list
    keys(av["versions"])

fn apiv_endpoint_count(av: dict, version: string) -> int
    let has_ver = contains(av["versions"], version)
    if has_ver != true
        return 0
    len(av["versions"][version]["endpoints"])

fn apiv_resolve(av: dict, requested: string) -> string
    let has_ver = contains(av["versions"], requested)
    if has_ver == true
        let st = av["versions"][requested]["status"]
        if st != "retired"
            return requested
    av["current"]
