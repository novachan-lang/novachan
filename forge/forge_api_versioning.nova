// forge_api_versioning -- API version management: register versions with status, add endpoints per
// version, deprecate with sunset dates, resolve requested version to the active handler. LEAF --
// imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. apiv_new / apiv_register / apiv_add_endpoint built dicts as individual assignments. Dict
//      literals.
//   2. `contains(...) == true` / `!= true` at FIVE sites -- `in` / `not in`.
//   3. apiv_is_deprecated iterated the deprecated list with a while loop to find a match -- that is
//      `version in av["deprecated"]` (one expression, no loop).
//   4. apiv_resolve had a nested if (exists AND not retired). One compound `and` with short-circuit.

fn apiv_new() -> dict
    {"versions": {}, "current": "", "deprecated": []}

fn apiv_register(av: dict, version: string, status: string) -> dict
    av["versions"][version] = {"status": status, "endpoints": [], "sunset_date": ""}
    if status == "current"
        av["current"] = version
    av

fn apiv_add_endpoint(av: dict, version: string, method: string, path: string) -> dict
    if version in av["versions"]
        push(av["versions"][version]["endpoints"], {"method": method, "path": path})
    av

fn apiv_deprecate(av: dict, version: string, sunset: string) -> dict
    if version in av["versions"]
        av["versions"][version]["status"] = "deprecated"
        av["versions"][version]["sunset_date"] = sunset
        push(av["deprecated"], version)
    av

fn apiv_is_deprecated(av: dict, version: string) -> bool
    version in av["deprecated"]

fn apiv_current(av: dict) -> string
    av["current"]

fn apiv_list_versions(av: dict) -> list
    keys(av["versions"])

fn apiv_endpoint_count(av: dict, version: string) -> int
    if version not in av["versions"]
        return 0
    len(av["versions"][version]["endpoints"])

fn apiv_resolve(av: dict, requested: string) -> string
    if requested in av["versions"] and str(av["versions"][requested]["status"]) != "retired"
        return requested
    str(av["current"])
