// forge_api_throttle — per-client API throttling with Result API.

fn at_new(default_limit: int, window: int) -> dict
    let a = {}
    a["default_limit"] = default_limit
    a["window"] = window
    a["clients"] = {}
    a["timestamps"] = {}
    a["total_allowed"] = 0
    a["total_denied"] = 0
    a

fn at_request(a: dict, client: string, now: int) -> Result
    let ck = "c_" + client
    let tk = "t_" + client
    if contains(a["clients"], ck) != true
        a["clients"][ck] = 1
        a["timestamps"][tk] = now
        a["total_allowed"] = a["total_allowed"] + 1
        return ok(a)
    let elapsed = now - a["timestamps"][tk]
    if elapsed >= a["window"]
        a["clients"][ck] = 1
        a["timestamps"][tk] = now
        a["total_allowed"] = a["total_allowed"] + 1
        return ok(a)
    let count = a["clients"][ck]
    if count >= a["default_limit"]
        a["total_denied"] = a["total_denied"] + 1
        return err("rate limit exceeded")
    a["clients"][ck] = count + 1
    a["total_allowed"] = a["total_allowed"] + 1
    ok(a)

fn at_remaining(a: dict, client: string) -> int
    let ck = "c_" + client
    if contains(a["clients"], ck) != true
        return a["default_limit"]
    a["default_limit"] - a["clients"][ck]

fn at_total_allowed(a: dict) -> int
    a["total_allowed"]

fn at_total_denied(a: dict) -> int
    a["total_denied"]

fn at_denial_rate(a: dict) -> int
    let total = a["total_allowed"] + a["total_denied"]
    if total == 0
        return 0
    a["total_denied"] * 100 / total
