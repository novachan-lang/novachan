// forge_api_throttle -- per-client API throttling: track requests per client within a time window,
// allow or deny based on a default limit. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. at_new built the state dict as six individual assignments. Dict literal.
//   2. `contains(...) != true` at TWO sites -- `not in`. Key construction `"c_" + client` at FOUR
//      sites -- interpolation.
//   3. `a["total_allowed"] = a["total_allowed"] + 1` at THREE sites -- compound assignment.

fn at_new(default_limit: int, window: int) -> dict
    {"default_limit": default_limit, "window": window, "clients": {}, "timestamps": {}, "total_allowed": 0, "total_denied": 0}

fn at_request(a: dict, client: string, now: int) -> Result
    let ck = "c_{client}"
    let tk = "t_{client}"
    if ck not in a["clients"]
        a["clients"][ck] = 1
        a["timestamps"][tk] = now
        a["total_allowed"] += 1
        return ok(a)
    let elapsed = now - a["timestamps"][tk]
    if elapsed >= a["window"]
        a["clients"][ck] = 1
        a["timestamps"][tk] = now
        a["total_allowed"] += 1
        return ok(a)
    let count = a["clients"][ck]
    if count >= a["default_limit"]
        a["total_denied"] += 1
        return err("rate limit exceeded")
    a["clients"][ck] = count + 1
    a["total_allowed"] += 1
    ok(a)

fn at_remaining(a: dict, client: string) -> int
    let ck = "c_{client}"
    if ck not in a["clients"]
        return a["default_limit"]
    a["default_limit"] - a["clients"][ck]

fn at_total_allowed(a: dict) -> int
    a["total_allowed"]

fn at_total_denied(a: dict) -> int
    a["total_denied"]

fn at_denial_rate(a: dict) -> int
    let total = a["total_allowed"] + a["total_denied"]
    0 if total == 0 else a["total_denied"] * 100 / total
