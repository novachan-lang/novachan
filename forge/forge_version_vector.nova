// forge_version_vector — causal ordering via version vectors with Result API.

fn vv_new() -> dict
    let v = {}
    v["clocks"] = {}
    v["node_count"] = 0
    v["total_increments"] = 0
    v

fn vv_increment(v: dict, node: string) -> dict
    let ck = "c_" + node
    if contains(v["clocks"], ck) == true
        v["clocks"][ck] = v["clocks"][ck] + 1
    else
        v["clocks"][ck] = 1
        v["node_count"] = v["node_count"] + 1
    v["total_increments"] = v["total_increments"] + 1
    v

fn vv_get(v: dict, node: string) -> Result
    let ck = "c_" + node
    if contains(v["clocks"], ck) != true
        return err("node not found: " + node)
    ok(v["clocks"][ck])

fn vv_merge(a: dict, b: dict) -> dict
    let ks = keys(b["clocks"])
    let i = 0
    while i < len(ks)
        let k = ks[i]
        let bval = b["clocks"][k]
        if contains(a["clocks"], k) == true
            if bval > a["clocks"][k]
                a["clocks"][k] = bval
        else
            a["clocks"][k] = bval
            a["node_count"] = a["node_count"] + 1
        i = i + 1
    a

fn vv_dominates(a: dict, b: dict) -> int
    let ks = keys(b["clocks"])
    let i = 0
    let dominated = 1
    while i < len(ks)
        let k = ks[i]
        let bval = b["clocks"][k]
        if contains(a["clocks"], k) == true
            if a["clocks"][k] < bval
                dominated = 0
        else
            dominated = 0
        i = i + 1
    dominated

fn vv_node_count(v: dict) -> int
    v["node_count"]

fn vv_total_increments(v: dict) -> int
    v["total_increments"]
