// forge_version_vector — causal ordering via version vectors with Result API.

fn vv_new() -> dict
    {"clocks": {}, "node_count": 0, "total_increments": 0}

fn vv_increment(v: dict, node: string) -> dict
    let ck = "c_" + node
    if ck in v["clocks"]
        v["clocks"][ck] += 1
    else
        v["clocks"][ck] = 1
        v["node_count"] += 1
    v["total_increments"] += 1
    v

fn vv_get(v: dict, node: string) -> Result
    let ck = "c_" + node
    if ck not in v["clocks"]
        return err("node not found: " + node)
    ok(v["clocks"][ck])

fn vv_merge(a: dict, b: dict) -> dict
    let ks = keys(b["clocks"])
    for i in 0..len(ks)
        let k = ks[i]
        let bval = b["clocks"][k]
        if k in a["clocks"]
            if bval > a["clocks"][k]
                a["clocks"][k] = bval
        else
            a["clocks"][k] = bval
            a["node_count"] += 1
    a

fn vv_dominates(a: dict, b: dict) -> int
    let ks = keys(b["clocks"])
    let dominated = 1
    for i in 0..len(ks)
        let k = ks[i]
        let bval = b["clocks"][k]
        if k not in a["clocks"] or a["clocks"][k] < bval
            dominated = 0
    dominated

fn vv_node_count(v: dict) -> int
    v["node_count"]

fn vv_total_increments(v: dict) -> int
    v["total_increments"]
