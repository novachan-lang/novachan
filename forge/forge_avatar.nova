// forge_avatar -- deterministic default avatars from a name/email (the "colored circle with initials" every
// app shows before a photo upload -- GitHub/Slack/Google style). Derives a STABLE background color + initials
// from the identifier, so the same user always gets the same avatar with zero image storage. Returns the data
// (initials + bg hex) to render as a CSS/SVG circle. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. avatar built the result dict as two individual assignments. Dict literal.
//   2. avatar_initials used a while-index loop with manual `i += 1`. for-in + break.
//   3. avatar_initials referenced `len(out)` before `out` was declared (should be `out_parts`). Fixed.

fn _av_hash(s: string) -> int
    let h = 2166136261
    for i in 0..len(s)
        h = (h * 16777619 + ord(char_at(s, i))) % 2147483647
    h

fn avatar_color(identifier: string) -> string
    let palette = ["#e6194b", "#3cb44b", "#4363d8", "#f58231", "#911eb4", "#008080", "#f032e6", "#9a6324", "#800000", "#808000", "#000075", "#e67e22", "#16a085", "#2c3e50", "#8e44ad"]
    palette[_av_hash(lower(identifier)) % len(palette)]

fn avatar_initials(name: string) -> string
    let parts = split(trim(name), " ")
    let out_parts = []
    for p in parts
        if len(out_parts) >= 2
            break
        let t = trim(p)
        if len(t) > 0
            push(out_parts, upper(slice(t, 0, 1)))
    let out = join(out_parts, "")
    "" if len(out) == 0 else out

fn avatar(name: string, identifier: string) -> dict
    {"initials": avatar_initials(name), "color": avatar_color(identifier)}
