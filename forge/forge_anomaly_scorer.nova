fn as_new(window_size)
    let state = {}
    state["window_size"] = window_size
    state["point_count"] = 0
    state["anomaly_count"] = 0
    state["total_value"] = 0
    state["metric_count"] = 0
    return state

fn as_add_metric(state, metric_name)
    let idx = state["metric_count"]
    let key = "metric_" + str(idx)
    state[key] = metric_name
    state["met_" + metric_name + "_count"] = 0
    state["met_" + metric_name + "_sum"] = 0
    state["met_" + metric_name + "_min"] = 999999999
    state["met_" + metric_name + "_max"] = -999999999
    state["met_" + metric_name + "_anomalies"] = 0
    state["metric_count"] = idx + 1
    return state

fn as_record(state, metric_name, value)
    let ckey = "met_" + metric_name + "_count"
    if ckey in state != true
        return err("unknown metric: " + metric_name)
    let cnt = state[ckey] + 1
    state[ckey] = cnt
    let skey = "met_" + metric_name + "_sum"
    state[skey] = state[skey] + value
    let minkey = "met_" + metric_name + "_min"
    if value < state[minkey]
        state[minkey] = value
    let maxkey = "met_" + metric_name + "_max"
    if value > state[maxkey]
        state[maxkey] = value
    state["point_count"] = state["point_count"] + 1
    state["total_value"] = state["total_value"] + value
    return ok(state)

fn as_score(state, metric_name, value)
    let ckey = "met_" + metric_name + "_count"
    if ckey in state != true
        return err("unknown metric")
    let cnt = state[ckey]
    if cnt < 2
        return ok(0)
    let skey = "met_" + metric_name + "_sum"
    let avg = state[skey] / cnt
    let diff = value - avg
    if diff < 0
        diff = 0 - diff
    let rng = state["met_" + metric_name + "_max"] - state["met_" + metric_name + "_min"]
    if rng == 0
        if diff > 0
            return ok(100)
        return ok(0)
    let score = (diff * 100) / rng
    if score > 100
        score = 100
    return ok(score)

fn as_is_anomaly(state, metric_name, value, threshold)
    let s = as_score(state, metric_name, value)
    if is_err(s)
        return s
    let sc = unwrap(s)
    if sc >= threshold
        return ok(1)
    return ok(0)

fn as_flag_anomaly(state, metric_name)
    let akey = "met_" + metric_name + "_anomalies"
    if akey in state != true
        return err("unknown metric")
    state[akey] = state[akey] + 1
    state["anomaly_count"] = state["anomaly_count"] + 1
    return ok(state)

fn as_point_count(state)
    return state["point_count"]

fn as_anomaly_count(state)
    return state["anomaly_count"]

fn as_metric_count(state)
    return state["metric_count"]

fn as_metric_avg(state, metric_name)
    let ckey = "met_" + metric_name + "_count"
    if ckey in state != true
        return err("unknown metric")
    let cnt = state[ckey]
    if cnt == 0
        return err("no data")
    return ok(state["met_" + metric_name + "_sum"] / cnt)

fn as_metric_range(state, metric_name)
    let ckey = "met_" + metric_name + "_count"
    if ckey in state != true
        return err("unknown metric")
    return ok(state["met_" + metric_name + "_max"] - state["met_" + metric_name + "_min"])
