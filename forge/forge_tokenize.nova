// forge_tokenize -- text search preprocessing: split free text into normalized word tokens, drop common
// English stop words, and generate n-grams. Together with the Porter stemmer (forge_stemmer) this is the full
// classic search-indexing pipeline: text_tokenize -> remove_stopwords -> stem each token -> index. n-grams
// add phrase matching. Tokens are lowercased and reduced to [a-z0-9] runs (punctuation is a boundary). LEAF.

// Split text into lowercase alphanumeric word tokens. Any non-[a-z0-9] character is a token boundary.
fn text_tokenize(text: string) -> list
    let t = lower(text)
    let out = []
    let cur = ""
    let i = 0
    while i < len(t)
        let c = char_at(t, i)
        if (c >= "a" and c <= "z") or (c >= "0" and c <= "9")
            cur = cur + c
        else
            if len(cur) > 0
                push(out, cur)
                cur = ""
        i = i + 1
    if len(cur) > 0
        push(out, cur)
    out

// Is `w` a common English stop word (a low-information term worth dropping from a search index)?
fn is_stopword(w: string) -> bool
    let sw = ["the", "a", "an", "and", "or", "but", "is", "are", "was", "were", "be", "been", "being", "to", "of", "in", "on", "at", "for", "with", "by", "from", "as", "it", "its", "this", "that", "these", "those", "i", "you", "he", "she", "we", "they", "them", "his", "her", "their", "not", "no", "so", "if", "then", "than", "too", "very", "can", "will", "just", "do", "does", "did", "has", "have", "had", "what", "which", "who", "when", "where", "why", "how", "all", "any", "both", "each", "more", "most", "other", "some", "such", "only", "own", "same", "up", "down", "out", "off", "over", "under", "again", "there", "here", "about", "into", "through"]
    contains(sw, w)

// Drop stop words from a token list.
fn remove_stopwords(tokens: list) -> list
    let out = []
    let i = 0
    while i < len(tokens)
        if is_stopword(tokens[i]) == false
            push(out, tokens[i])
        i = i + 1
    out

// Contiguous n-grams of a token list, each joined by a single space. n<=0 or n>len -> empty list.
fn ngrams(tokens: list, n: int) -> list
    let out = []
    if n <= 0
        return out
    let i = 0
    while i + n <= len(tokens)
        let g = tokens[i]
        let j = 1
        while j < n
            g = g + " " + tokens[i + j]
            j = j + 1
        push(out, g)
        i = i + 1
    out
