// forge_priority_queue — Priority queue (min-heap simulation via sorted insert).
// Enqueue with priority, dequeue lowest priority first, peek.

fn pq_new() -> dict
    let pq = {}
    pq["items"] = []
    pq

fn pq_enqueue(pq: dict, value: string, priority: int) -> dict
    let item = {}
    item["value"] = value
    item["priority"] = priority
    let items = pq["items"]
    let pos = len(items)
    let i = 0
    while i < len(items)
        if priority < items[i]["priority"]
            pos = i
            i = len(items)
        else
            i = i + 1
    let new_items = []
    let j = 0
    while j < pos
        push(new_items, items[j])
        j = j + 1
    push(new_items, item)
    while j < len(items)
        push(new_items, items[j])
        j = j + 1
    pq["items"] = new_items
    pq

fn pq_dequeue(pq: dict) -> dict
    let items = pq["items"]
    if len(items) == 0
        let empty = {}
        empty["value"] = ""
        empty["found"] = 0
        return empty
    let first = items[0]
    let new_items = []
    let i = 1
    while i < len(items)
        push(new_items, items[i])
        i = i + 1
    pq["items"] = new_items
    first["found"] = 1
    first

fn pq_peek(pq: dict) -> dict
    let items = pq["items"]
    if len(items) == 0
        let empty = {}
        empty["value"] = ""
        empty["found"] = 0
        return empty
    let first = items[0]
    first["found"] = 1
    first

fn pq_size(pq: dict) -> int
    len(pq["items"])

fn pq_is_empty(pq: dict) -> int
    if len(pq["items"]) == 0
        return 1
    0
