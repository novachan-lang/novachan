// forge_priority_queue — simple priority queue with Result API.

fn pq_new() -> dict
    let q = {}
    q["items"] = {}
    q["count"] = 0
    q

fn pq_push(q: dict, value: string, priority: int) -> dict
    let key = "pq_" + str(q["count"])
    q["items"][key + "_val"] = value
    q["items"][key + "_pri"] = priority
    q["items"][key + "_popped"] = 0
    q["count"] = q["count"] + 1
    q

fn pq_peek(q: dict) -> Result
    let best_idx = -1
    let best_pri = -1
    let i = 0
    while i < q["count"]
        let key = "pq_" + str(i)
        if q["items"][key + "_popped"] == 0
            if q["items"][key + "_pri"] > best_pri
                best_pri = q["items"][key + "_pri"]
                best_idx = i
        i = i + 1
    if best_idx == -1
        return err("queue empty")
    let key = "pq_" + str(best_idx)
    ok(q["items"][key + "_val"])

fn pq_pop(q: dict) -> Result
    let best_idx = -1
    let best_pri = -1
    let i = 0
    while i < q["count"]
        let key = "pq_" + str(i)
        if q["items"][key + "_popped"] == 0
            if q["items"][key + "_pri"] > best_pri
                best_pri = q["items"][key + "_pri"]
                best_idx = i
        i = i + 1
    if best_idx == -1
        return err("queue empty")
    let key = "pq_" + str(best_idx)
    q["items"][key + "_popped"] = 1
    ok(q["items"][key + "_val"])

fn pq_size(q: dict) -> int
    let active = 0
    let i = 0
    while i < q["count"]
        let key = "pq_" + str(i)
        if q["items"][key + "_popped"] == 0
            active = active + 1
        i = i + 1
    active

fn pq_is_empty(q: dict) -> int
    if pq_size(q) == 0
        return 1
    0
