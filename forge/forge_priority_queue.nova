// forge_priority_queue — simple priority queue with Result API.

fn pq_new() -> dict
    {"items": {}, "count": 0}

fn pq_push(q: dict, value: string, priority: int) -> dict
    let cs = str(q["count"])
    let key = "pq_{cs}"
    q["items"]["{key}_val"] = value
    q["items"]["{key}_pri"] = priority
    q["items"]["{key}_popped"] = 0
    q["count"] += 1
    q

fn pq_peek(q: dict) -> Result
    let best_idx = -1
    let best_pri = -1
    for i in 0..q["count"]
        let ks = str(i)
        let key = "pq_{ks}"
        if q["items"]["{key}_popped"] == 0
            if q["items"]["{key}_pri"] > best_pri
                best_pri = q["items"]["{key}_pri"]
                best_idx = i
    if best_idx == -1
        return err("queue empty")
    let bks = str(best_idx)
    let bkey = "pq_{bks}"
    ok(q["items"]["{bkey}_val"])

fn pq_pop(q: dict) -> Result
    let best_idx = -1
    let best_pri = -1
    for i in 0..q["count"]
        let ks = str(i)
        let key = "pq_{ks}"
        if q["items"]["{key}_popped"] == 0
            if q["items"]["{key}_pri"] > best_pri
                best_pri = q["items"]["{key}_pri"]
                best_idx = i
    if best_idx == -1
        return err("queue empty")
    let bks = str(best_idx)
    let bkey = "pq_{bks}"
    q["items"]["{bkey}_popped"] = 1
    ok(q["items"]["{bkey}_val"])

fn pq_size(q: dict) -> int
    let active = 0
    for i in 0..q["count"]
        let ks = str(i)
        let key = "pq_{ks}"
        if q["items"]["{key}_popped"] == 0
            active += 1
    active

fn pq_is_empty(q: dict) -> int
    1 if pq_size(q) == 0 else 0
