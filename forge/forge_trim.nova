// forge_trim -- strip whitespace (or any chosen characters) from the ENDS of a string. trim removes leading AND
// trailing whitespace, ltrim and rtrim just the left or right side, and trim_chars removes any of a given set of
// characters from both ends. This is one of the most-used string operations there is: cleaning up user input
// before validating or storing it, tidying a line read from a file, dropping the newline off a fetched record,
// stripping surrounding quotes or slashes, and normalizing tokens so " yes " and "yes" compare equal. It only
// touches the ends -- interior whitespace is left intact -- and whitespace means the usual space, tab, newline,
// carriage return, form feed, and vertical tab. (forge_ascii.strip_control removes control bytes anywhere; this is
// end-trimming.) Byte-oriented. LEAF -- imports NOTHING.

// PRIVATE: is c ASCII whitespace?
fn _tr_ws(c: string) -> bool
    let o = ord(c)
    let out = false
    if o == 32 or (o >= 9 and o <= 13)
        out = true
    out

// PRIVATE: does the single character c appear in the set string `chars`?
fn _tr_inset(c: string, chars: string) -> bool
    let out = false
    let i = 0
    while i < len(chars) and out == false
        if char_at(chars, i) == c
            out = true
        i = i + 1
    out

// Remove leading and trailing whitespace. trim("  hello  ") = "hello".
fn trim(s: string) -> string
    let start = 0
    while start < len(s) and _tr_ws(char_at(s, start))
        start = start + 1
    let end = len(s)
    while end > start and _tr_ws(char_at(s, end - 1))
        end = end - 1
    slice(s, start, end)

// Remove leading (left) whitespace only.
fn ltrim(s: string) -> string
    let start = 0
    while start < len(s) and _tr_ws(char_at(s, start))
        start = start + 1
    slice(s, start, len(s))

// Remove trailing (right) whitespace only.
fn rtrim(s: string) -> string
    let end = len(s)
    while end > 0 and _tr_ws(char_at(s, end - 1))
        end = end - 1
    slice(s, 0, end)

// Remove any of the characters in `chars` from both ends of s. trim_chars("xxhelloxx", "x") = "hello".
fn trim_chars(s: string, chars: string) -> string
    let start = 0
    while start < len(s) and _tr_inset(char_at(s, start), chars)
        start = start + 1
    let end = len(s)
    while end > start and _tr_inset(char_at(s, end - 1), chars)
        end = end - 1
    slice(s, start, end)
