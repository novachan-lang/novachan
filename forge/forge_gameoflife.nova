// forge_gameoflife -- Conway's Game of Life, the most famous CELLULAR AUTOMATON: a grid of cells that are alive (1)
// or dead (0) evolves in lock-step by four tiny rules based only on each cell's eight neighbours -- a live cell
// with 2 or 3 live neighbours survives, one with fewer dies of loneliness or with more dies of overcrowding, and a
// dead cell with exactly 3 live neighbours is born. From those trivial local rules astonishingly complex global
// behaviour emerges (blinkers, gliders, guns), which is why "Life" is the canonical example of emergence and a
// staple of simulation. Cellular automata like this are used for real work too: procedural cave/terrain generation
// in games (run a few Life-like steps to smooth random noise into organic caverns), image erosion/dilation,
// crowd/traffic and epidemic toy models, and generative art. This computes the next generation of a 0/1 grid (and
// can run several steps); boundaries are treated as dead (a finite board). LEAF -- imports NOTHING.

// PRIVATE: the number of live (value 1) cells among the eight neighbours of (r, c); off-board counts as dead.
fn _life_neighbors(grid: list, r: int, c: int) -> int
    let rows = len(grid)
    let cols = len(grid[0])
    let count = 0
    let dr = 0 - 1
    while dr <= 1
        let dc = 0 - 1
        while dc <= 1
            if dr != 0 or dc != 0
                let nr = r + dr
                let nc = c + dc
                if nr >= 0 and nr < rows and nc >= 0 and nc < cols
                    if grid[nr][nc] == 1
                        count += 1
            dc += 1
        dr += 1
    count

// The next generation of a 0/1 grid under Conway's rules. Returns a new grid; the input is unchanged.
fn next_generation(grid: list) -> list
    let rows = len(grid)
    let out = []
    if rows > 0
        let cols = len(grid[0])
        for r in 0..rows
            let row = []
            let c = 0
            while c < cols
                let n = _life_neighbors(grid, r, c)
                let alive = 0
                if grid[r][c] == 1
                    if n == 2 or n == 3
                        alive = 1
                else
                    if n == 3
                        alive = 1
                push(row, alive)
                c += 1
            push(out, row)
    out

// Advance the grid `steps` generations.
fn life_run(grid: list, steps: int) -> list
    let g = grid
    for i in 0..steps
        g = next_generation(g)
    g

// The number of live cells in a grid.
fn life_population(grid: list) -> int
    let total = 0
    for r in 0..len(grid)
        let c = 0
        while c < len(grid[r])
            total += grid[r][c]
            c += 1
    total
