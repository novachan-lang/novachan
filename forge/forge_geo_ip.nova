// forge_geo_ip — IP-to-country mapping with Result API.

fn geo_new() -> dict
    let g = {}
    g["entry_count"] = 0
    g["lookups"] = 0
    g["hits"] = 0
    g

fn geo_add(g: dict, ip_prefix: string, country: string, city: string) -> dict
    let idx = g["entry_count"]
    g["g_" + str(idx) + "_prefix"] = ip_prefix
    g["g_" + str(idx) + "_country"] = country
    g["g_" + str(idx) + "_city"] = city
    g["entry_count"] = idx + 1
    g

fn geo_lookup(g: dict, ip: string) -> Result
    g["lookups"] = g["lookups"] + 1
    let i = 0
    let best_idx = -1
    let best_len = -1
    while i < g["entry_count"]
        let prefix = g["g_" + str(i) + "_prefix"]
        let plen = len(prefix)
        if plen <= len(ip)
            if slice(ip, 0, plen) == prefix
                if plen > best_len
                    best_len = plen
                    best_idx = i
        i += 1
    if best_idx == -1
        return err("no geo data for: " + ip)
    g["hits"] = g["hits"] + 1
    ok(g["g_" + str(best_idx) + "_country"])

fn geo_city(g: dict, ip: string) -> Result
    let i = 0
    let best_idx = -1
    let best_len = -1
    while i < g["entry_count"]
        let prefix = g["g_" + str(i) + "_prefix"]
        let plen = len(prefix)
        if plen <= len(ip)
            if slice(ip, 0, plen) == prefix
                if plen > best_len
                    best_len = plen
                    best_idx = i
        i += 1
    if best_idx == -1
        return err("no geo data for: " + ip)
    ok(g["g_" + str(best_idx) + "_city"])

fn geo_entry_count(g: dict) -> int
    g["entry_count"]

fn geo_total_lookups(g: dict) -> int
    g["lookups"]

fn geo_hit_count(g: dict) -> int
    g["hits"]
