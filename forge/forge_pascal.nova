// forge_pascal -- Pascal's triangle: the grid of binomial coefficients where each number is the sum of the two
// above it. Row n is exactly the coefficients of (a+b)^n and the values C(n,k) = "n choose k", so it's the quick
// way to expand a binomial, read off combination counts, or build a binomial probability distribution without
// factorials. It also encodes the hockey-stick and other combinatorial identities, and its diagonals are the
// triangular and tetrahedral numbers. Where forge_combinatorics computes a single C(n,k), this lays out whole
// ROWS and the full triangle efficiently (each row built from the previous by an exact running multiply/divide).
// Integer, exact. LEAF -- imports NOTHING.

// Row n of Pascal's triangle: [C(n,0), C(n,1), ..., C(n,n)] (n+1 values). Built by the multiplicative recurrence
// so no factorial ever overflows unnecessarily.
fn pascal_row(n: int) -> list
    let row = []
    if n >= 0
        push(row, 1)
        for k in 1..(n + 1)
            let prev = row[k - 1]
            push(row, prev * (n - k + 1) / k)
    row

// The first `rows` rows of Pascal's triangle as a list of rows (row 0 is [1]).
fn pascal_triangle(rows: int) -> list
    let out = [pascal_row(i) for i in 0..rows]
    out

// A single entry C(n, k) = "n choose k". 0 if k < 0 or k > n.
fn pascal_value(n: int, k: int) -> int
    let out = 0
    if k >= 0 and k <= n
        let r = 1
        let kk = k
        if kk > n - kk
            kk = n - kk
        for i in 1..(kk + 1)
            r = r * (n - kk + i) / i
        out = r
    out

// The sum of row n (which is always 2^n).
fn pascal_row_sum(n: int) -> int
    let s = 1
    for i in 0..n
        s *= 2
    s
