// forge_plural -- CLDR plural-category selection for correct pluralized translations (the rules ICU
// MessageFormat / gettext ngettext / Rails I18n.pluralize encode). "1 item" vs "2 items" is trivial in English
// but Russian has 3 forms, Arabic 6, French treats 0 as singular, and CJK has none -- getting it wrong reads as
// broken localization. plural_category(locale, n) returns the CLDR category ("zero"/"one"/"two"/"few"/"many"/
// "other"); plural_select picks the matching message form. Complements forge_i18n. LEAF -- imports NOTHING.

// PRIVATE: the primary language subtag, lowercased ("en-US" / "en_GB" -> "en").
fn _pl_lang(locale: string) -> string
    let l = lower(locale)
    let dash = find(l, "-")
    if dash >= 0
        l = slice(l, 0, dash)
    let us = find(l, "_")
    if us >= 0
        l = slice(l, 0, us)
    l

// The CLDR plural category for a count `n` in `locale`. Covers the major families; unknown locales fall back
// to the English rule (one/other). `n` is a non-negative integer count.
fn plural_category(locale: string, n: int) -> string
    let lang = _pl_lang(locale)
    let m10 = n % 10
    let m100 = n % 100
    // CJK + a few others: no plural distinction.
    if lang == "ja" or lang == "zh" or lang == "ko" or lang == "vi" or lang == "th" or lang == "id"
        return "other"
    // French/Portuguese-BR style: 0 and 1 are singular.
    if lang == "fr" or lang == "hy"
        if n == 0 or n == 1
            return "one"
        return "other"
    // West/East Slavic (Russian, Ukrainian) 3-form rule.
    if lang == "ru" or lang == "uk"
        if m10 == 1 and m100 != 11
            return "one"
        if m10 >= 2 and m10 <= 4 and (m100 < 12 or m100 > 14)
            return "few"
        return "many"
    // Polish 3-form (different boundaries).
    if lang == "pl"
        if n == 1
            return "one"
        if m10 >= 2 and m10 <= 4 and (m100 < 12 or m100 > 14)
            return "few"
        return "many"
    // Arabic 6-form.
    if lang == "ar"
        if n == 0
            return "zero"
        if n == 1
            return "one"
        if n == 2
            return "two"
        if m100 >= 3 and m100 <= 10
            return "few"
        if m100 >= 11 and m100 <= 99
            return "many"
        return "other"
    // Czech/Slovak.
    if lang == "cs" or lang == "sk"
        if n == 1
            return "one"
        if n >= 2 and n <= 4
            return "few"
        return "other"
    // Default (English, Germanic, most Romance): one for exactly 1, else other.
    if n == 1
        return "one"
    "other"

// Pick the message form for `n` from a forms dict (keys are CLDR categories). Falls back to "other", then "".
fn plural_select(forms: dict, locale: string, n: int) -> string
    let cat = plural_category(locale, n)
    if cat in forms
        return forms[cat]
    if "other" in forms
        return forms["other"]
    ""
