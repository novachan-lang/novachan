// forge_shadow_deploy — Shadow traffic to new version without affecting production.

fn sd_new() -> dict
    let s = {}
    s["primary_ver"] = ""
    s["shadow_ver"] = ""
    s["total_requests"] = 0
    s["shadow_matches"] = 0
    s["shadow_mismatches"] = 0
    s["active"] = 0
    s

fn sd_start(s: dict, primary: string, shadow: string) -> dict
    s["primary_ver"] = primary
    s["shadow_ver"] = shadow
    s["active"] = 1
    s

fn sd_stop(s: dict) -> dict
    s["active"] = 0
    s

fn sd_request(s: dict, primary_result: string, shadow_result: string) -> dict
    let result = {}
    s["total_requests"] = s["total_requests"] + 1
    if primary_result == shadow_result
        s["shadow_matches"] = s["shadow_matches"] + 1
        result["match"] = 1
    else
        s["shadow_mismatches"] = s["shadow_mismatches"] + 1
        result["match"] = 0
    result["s"] = s
    result

fn sd_match_rate(s: dict) -> int
    if s["total_requests"] == 0
        return 100
    s["shadow_matches"] * 100 / s["total_requests"]

fn sd_is_active(s: dict) -> int
    s["active"]

fn sd_total_requests(s: dict) -> int
    s["total_requests"]

fn sd_mismatch_count(s: dict) -> int
    s["shadow_mismatches"]

fn sd_is_safe_to_promote(s: dict, min_requests: int, min_match_pct: int) -> int
    if s["total_requests"] < min_requests
        return 0
    if sd_match_rate(s) >= min_match_pct
        return 1
    0
