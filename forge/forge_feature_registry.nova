fn fr_new()
    let state = {}
    state["feature_count"] = 0
    state["enabled_count"] = 0
    state["deprecated_count"] = 0
    return state

fn fr_register(state, feature_name, owner, phase)
    let idx = state["feature_count"]
    state["f_" + feature_name + "_owner"] = owner
    state["f_" + feature_name + "_phase"] = phase
    state["f_" + feature_name + "_status"] = "registered"
    state["f_" + feature_name + "_idx"] = idx
    state["feature_count"] = idx + 1
    return state

fn fr_enable(state, feature_name)
    let skey = "f_" + feature_name + "_status"
    if contains(state, skey) != true
        return err("unknown feature: " + feature_name)
    if state[skey] == "enabled"
        return err("already enabled")
    state[skey] = "enabled"
    state["enabled_count"] = state["enabled_count"] + 1
    return ok(state)

fn fr_deprecate(state, feature_name)
    let skey = "f_" + feature_name + "_status"
    if contains(state, skey) != true
        return err("unknown feature")
    if state[skey] == "deprecated"
        return err("already deprecated")
    if state[skey] == "enabled"
        state["enabled_count"] = state["enabled_count"] - 1
    state[skey] = "deprecated"
    state["deprecated_count"] = state["deprecated_count"] + 1
    return ok(state)

fn fr_status(state, feature_name)
    let skey = "f_" + feature_name + "_status"
    if contains(state, skey) != true
        return err("unknown feature")
    return ok(state[skey])

fn fr_owner(state, feature_name)
    let okey = "f_" + feature_name + "_owner"
    if contains(state, okey) != true
        return err("unknown feature")
    return ok(state[okey])

fn fr_phase(state, feature_name)
    let pkey = "f_" + feature_name + "_phase"
    if contains(state, pkey) != true
        return err("unknown feature")
    return ok(state[pkey])

fn fr_feature_count(state)
    return state["feature_count"]

fn fr_enabled_count(state)
    return state["enabled_count"]

fn fr_deprecated_count(state)
    return state["deprecated_count"]

fn fr_has_feature(state, feature_name)
    let skey = "f_" + feature_name + "_status"
    if contains(state, skey) == true
        return 1
    return 0
