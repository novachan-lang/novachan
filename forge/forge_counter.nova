// forge_counter -- a frequency counter (like Python collections.Counter): tally occurrences of keys, read a
// count, find the most common. For word frequencies, tag/label counts, top-N analytics, and histogram
// building. Counts are plain ints in a dict. LEAF -- imports NOTHING.

fn counter_new() -> dict
    let c = {}
    c

// Increment the count for `key` by 1. Fluent.
fn counter_add(c: dict, key: string) -> dict
    if contains(c, key)
        c[key] = c[key] + 1
    else
        c[key] = 1
    c

// Increment by `n`. Fluent.
fn counter_add_n(c: dict, key: string, n: int) -> dict
    if contains(c, key)
        c[key] = c[key] + n
    else
        c[key] = n
    c

fn counter_get(c: dict, key: string) -> int
    if contains(c, key)
        return c[key]
    0

// The key with the highest count ("" if empty; ties -> first in keys()).
fn counter_most_common(c: dict) -> string
    let ks = keys(c)
    if len(ks) == 0
        return ""
    let best = ks[0]
    let best_n = c[best]
    let i = 1
    while i < len(ks)
        if c[ks[i]] > best_n
            best_n = c[ks[i]]
            best = ks[i]
        i = i + 1
    best

// Tally a list of string values into a counter.
fn counter_of(values: list) -> dict
    let c = counter_new()
    let i = 0
    while i < len(values)
        counter_add(c, values[i])
        i = i + 1
    c

// Number of distinct keys.
fn counter_distinct(c: dict) -> int
    len(keys(c))

// The sum of all counts (the grand total of tallied occurrences).
fn counter_total(c: dict) -> int
    let total = 0
    let ks = keys(c)
    let i = 0
    while i < len(ks)
        total = total + c[ks[i]]
        i = i + 1
    total

// Decrement `key` by `n` (won't create a new key if absent unless it results from an existing one). Fluent.
fn counter_subtract(c: dict, key: string, n: int) -> dict
    if contains(c, key)
        c[key] = c[key] - n
    else
        c[key] = 0 - n
    c

// PRIVATE: is string a lexicographically greater than b?
fn _ct_strgt(a: string, b: string) -> bool
    let n = len(a)
    if len(b) < n
        n = len(b)
    let out = false
    let decided = false
    let i = 0
    while i < n and decided == false
        let ca = ord(char_at(a, i))
        let cb = ord(char_at(b, i))
        if ca > cb
            out = true
            decided = true
        else
            if ca < cb
                decided = true
        i = i + 1
    if decided == false and len(a) > len(b)
        out = true
    out

// The `k` most common items as a list of [key, count] pairs, highest count first (ties broken by key ascending).
// Unlike counter_most_common (which returns the single top key), this ranks the whole counter.
fn counter_top_k(c: dict, k: int) -> list
    let ks = keys(c)
    // insertion sort by count desc, then key asc
    let a = 1
    while a < len(ks)
        let key = ks[a]
        let kc = c[key]
        let b = a - 1
        while b >= 0 and (c[ks[b]] < kc or (c[ks[b]] == kc and _ct_strgt(ks[b], key)))
            ks[b + 1] = ks[b]
            b = b - 1
        ks[b + 1] = key
        a = a + 1
    let out = []
    let i = 0
    while i < len(ks) and i < k
        push(out, [ks[i], c[ks[i]]])
        i = i + 1
    out

// Merge two counters into a NEW counter, adding counts key by key.
fn counter_merge(x: dict, y: dict) -> dict
    let out = {}
    let kx = keys(x)
    let i = 0
    while i < len(kx)
        out[kx[i]] = get(out, kx[i], 0) + x[kx[i]]
        i = i + 1
    let ky = keys(y)
    let j = 0
    while j < len(ky)
        out[ky[j]] = get(out, ky[j], 0) + y[ky[j]]
        j = j + 1
    out
