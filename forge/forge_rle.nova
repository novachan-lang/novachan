// forge_rle -- run-length encoding: collapse runs of a repeated character into count+char (simple lossless
// compression for sparse bitmaps, telemetry streams, terminal/sprite data, and quick change-run summaries).
// rle_encode("aaabbc") -> "3a2b1c"; rle_decode reverses it. LEAF -- imports NOTHING.

fn rle_encode(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        let count = 1
        while i + count < n and char_at(s, i + count) == c
            count = count + 1
        out = out + str(count) + c
        i = i + count
    out

fn rle_decode(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let num = 0
        while i < n and char_at(s, i) >= "0" and char_at(s, i) <= "9"
            num = num * 10 + (ord(char_at(s, i)) - 48)
            i = i + 1
        if i < n
            let c = char_at(s, i)
            let k = 0
            while k < num
                out = out + c
                k = k + 1
            i = i + 1
    out
