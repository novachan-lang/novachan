// forge_articulation -- find the ARTICULATION POINTS (cut vertices) and BRIDGES (cut edges) of an undirected graph
// via Tarjan's single-DFS algorithm. An articulation point is a node whose removal disconnects the graph; a bridge
// is an edge whose removal does. These are exactly the single points of failure in a network: the routers/links,
// power lines, or roads that, if they go down, split the system in two. Tarjan finds them in one O(V+E) DFS using
// "discovery time" and "low-link" (the earliest node reachable from a subtree via a back edge): a subtree that
// can't reach above its entry node is hanging off a cut vertex/edge. Used for network-reliability and
// redundancy analysis, finding weak spots in infrastructure/dependency graphs, and as a step in biconnected-
// component decomposition. Graph = adjacency list (adj[u] = list of neighbors), undirected, simple (no parallel
// edges). LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. `0 - 1` was used for -1 at EIGHT sites -- unary negation is now fixed, so `-1` directly.
//   2. The low-link update `if low[v] < low[u]: low[u] = low[v]` (and the back-edge variant) is a
//      min -- `min` builtin.
//   3. The bridge-pair normalization was `let a = u; let b = v; if b < a: a = v; b = u` -- that is
//      `[min(u, v), max(u, v)]`.
//   4. Array init `for z in 0..n: push(disc, -1)` -- comprehension.
//   5. Nested `else: if v != parent` -- `else if`.

// PRIVATE: the recursive DFS. Shared state (disc, low, timer, is_ap, bridges) is mutated in place.
fn _art_dfs(u: int, parent: int, adj: list, disc: list, low: list, timer: list, is_ap: list, bridges: list)
    timer[0] += 1
    disc[u] = timer[0]
    low[u] = timer[0]
    let children = 0
    let nbrs = adj[u]
    for i in 0..len(nbrs)
        let v = nbrs[i]
        if disc[v] == -1
            children += 1
            _art_dfs(v, u, adj, disc, low, timer, is_ap, bridges)
            low[u] = min(low[u], low[v])
            if parent != -1 and low[v] >= disc[u]
                is_ap[u] = 1
            if low[v] > disc[u]
                push(bridges, [min(u, v), max(u, v)])
        else if v != parent
            low[u] = min(low[u], disc[v])
    if parent == -1 and children > 1
        is_ap[u] = 1

// PRIVATE: run Tarjan over all components, returning [articulation_point_list, bridge_list].
fn _art_run(n: int, adj: list) -> list
    let disc = [-1 for z in 0..n]
    let low = [0 for z in 0..n]
    let is_ap = [0 for z in 0..n]
    let timer = [0]
    let bridges = []
    for u in 0..n
        if disc[u] == -1
            _art_dfs(u, -1, adj, disc, low, timer, is_ap, bridges)
    [[k for k in 0..n if is_ap[k] == 1], bridges]

fn articulation_points(n: int, adj: list) -> list
    _art_run(n, adj)[0]

fn find_bridges(n: int, adj: list) -> list
    _art_run(n, adj)[1]
