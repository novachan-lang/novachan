// forge_peakfind -- locate a PEAK (a local maximum) or VALLEY in an array in O(log n), without scanning it all.
// Binary search normally needs SORTED data; the surprising fact here is that you can find a peak far faster than
// linearly even in an UNSORTED array, as long as you only need SOME peak: at any midpoint, whichever neighbour is
// higher must lead to a peak, so you can always halve the search toward "uphill". For a "mountain" array (strictly
// rising then strictly falling) this pinpoints the single summit -- the classic use behind finding the maximum of
// a unimodal cost/latency curve, the brightest sample in a scan line, the turning point of a trajectory, or the
// best setting when a metric rises then falls. Also included: valley finding (the dual, for a dip/minimum) and a
// mountain-shape validator. Works on integer arrays; boundaries are treated as negative infinity so an end can be
// a peak. LEAF -- imports NOTHING.

// The index of A peak: an element greater than or equal to its neighbours (ends count, treating off-array as
// -infinity). O(log n) via "always climb toward the higher neighbour". Returns -1 for an empty array.
fn find_peak(arr: list) -> int
    let n = len(arr)
    let out = 0 - 1
    if n > 0
        let lo = 0
        let hi = n - 1
        while lo < hi
            let mid = (lo + hi) / 2
            if arr[mid] < arr[mid + 1]
                lo = mid + 1
            else
                hi = mid
        out = lo
    out

// The index of A valley: an element less than or equal to its neighbours. The dual of find_peak. -1 if empty.
fn find_valley(arr: list) -> int
    let n = len(arr)
    let out = 0 - 1
    if n > 0
        let lo = 0
        let hi = n - 1
        while lo < hi
            let mid = (lo + hi) / 2
            if arr[mid] > arr[mid + 1]
                lo = mid + 1
            else
                hi = mid
        out = lo
    out

// True if arr is a MOUNTAIN: strictly increasing up to a single peak (not at either end) then strictly decreasing.
fn is_mountain(arr: list) -> bool
    let n = len(arr)
    let out = false
    if n >= 3
        let i = 0
        while i + 1 < n and arr[i] < arr[i + 1]
            i += 1
        // peak must exist and not be at the first or last index
        if i > 0 and i < n - 1
            while i + 1 < n and arr[i] > arr[i + 1]
                i += 1
            if i == n - 1
                out = true
    out

// The summit index of a mountain array (strictly up then down), or -1 if the array is not a valid mountain.
fn mountain_peak(arr: list) -> int
    let out = 0 - 1
    if is_mountain(arr)
        out = find_peak(arr)
    out
