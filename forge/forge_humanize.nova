// forge_humanize -- human-friendly number + byte-size formatting (Rails number_to_human / number_to_human_size,
// Django intcomma / filesizeformat). comma_int(1234567)->"1,234,567"; humanize_int(1500000)->"1.5M";
// humanize_bytes(1536)->"1.5 KB". Integer-only (one decimal via integer division by scale/10, no floats and no
// overflow). LEAF -- imports NOTHING.

// Thousands separators: 1234567 -> "1,234,567" (handles negatives).
fn comma_int(n: int) -> string
    let v = n
    let neg = n < 0
    if neg
        v = 0 - v
    let s = str(v)
    let out = ""
    let cnt = 0
    let i = len(s) - 1
    while i >= 0
        out = char_at(s, i) + out
        cnt += 1
        if cnt % 3 == 0 and i > 0
            out = "," + out
        i -= 1
    if neg
        return "-" + out
    out

// Compact magnitude: 1234 -> "1.2K", 1500000 -> "1.5M", 999 -> "999". Suffixes K/M/B/T, one decimal (dropped
// when .0). tenths = v/(scale/10) keeps the arithmetic in i64 range.
fn humanize_int(n: int) -> string
    let v = n
    let sign = ""
    if n < 0
        v = 0 - v
        sign = "-"
    if v < 1000
        return sign + str(v)
    let suffixes = ["K", "M", "B", "T"]
    let scale = 1000
    let idx = 0
    let result = sign + str(v)
    let done = false
    while idx < 4 and done == false
        let nxt = scale * 1000
        if v < nxt or idx == 3
            let tenths = v / (scale / 10)
            let whole = tenths / 10
            let frac = tenths % 10
            if frac == 0
                result = sign + str(whole) + suffixes[idx]
            else
                result = sign + str(whole) + "." + str(frac) + suffixes[idx]
            done = true
        else
            scale = nxt
            idx += 1
    result

// Byte size (base 1024): 1536 -> "1.5 KB", 1048576 -> "1.0 MB". Suffixes B/KB/MB/GB/TB/PB.
fn humanize_bytes(n: int) -> string
    let v = n
    if v < 1024
        return str(v) + " B"
    let units = ["KB", "MB", "GB", "TB", "PB"]
    let scale = 1024
    let idx = 0
    let result = str(v) + " B"
    let done = false
    while idx < 5 and done == false
        let nxt = scale * 1024
        if v < nxt or idx == 4
            let tenths = v / (scale / 10)
            let whole = tenths / 10
            let frac = tenths % 10
            result = str(whole) + "." + str(frac) + " " + units[idx]
            done = true
        else
            scale = nxt
            idx += 1
    result
