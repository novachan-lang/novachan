// forge_etl_runner — ETL pipeline runner with Result.

fn etl_new() -> dict
    {"steps": {}, "step_count": 0, "status": "idle", "current": 0, "extracted": 0, "transformed": 0, "loaded": 0}

fn etl_add_step(e: dict, name: string, step_type: string) -> dict
    let k = str(e["step_count"])
    e["steps"][k + "_name"] = name
    e["steps"][k + "_type"] = step_type
    e["steps"][k + "_status"] = "pending"
    e["step_count"] += 1
    e

fn etl_run_step(e: dict) -> Result
    if e["current"] >= e["step_count"]
        return err("no more steps")
    let k = str(e["current"])
    let stype = e["steps"][k + "_type"]
    e["steps"][k + "_status"] = "done"
    if stype == "extract"
        e["extracted"] += 1
    if stype == "transform"
        e["transformed"] += 1
    if stype == "load"
        e["loaded"] += 1
    e["current"] += 1
    e["status"] = "done" if e["current"] >= e["step_count"] else "running"
    ok(e)

fn etl_fail_step(e: dict, reason: string) -> dict
    let k = str(e["current"])
    e["steps"][k + "_status"] = "failed"
    e["status"] = "failed"
    e

fn etl_step_name(e: dict, idx: int) -> Result
    if idx >= e["step_count"]
        return err("index out of range")
    ok(e["steps"][str(idx) + "_name"])

fn etl_status(e: dict) -> string
    e["status"]

fn etl_progress(e: dict) -> int
    if e["step_count"] == 0
        return 100
    e["current"] * 100 / e["step_count"]

fn etl_step_count(e: dict) -> int
    e["step_count"]
