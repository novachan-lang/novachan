// forge_rolling_deploy — Rolling deployment orchestrator.
// Deploy to instances in batches, track progress, pause/resume/rollback.

fn rd_new(total_instances: int, batch_size: int) -> dict
    let rd = {}
    rd["total"] = total_instances
    rd["batch_size"] = batch_size
    rd["deployed"] = 0
    rd["failed"] = 0
    rd["version"] = ""
    rd["status"] = "idle"
    rd["batches_done"] = 0
    rd

fn rd_start(rd: dict, version: string) -> dict
    rd["version"] = version
    rd["status"] = "deploying"
    rd["deployed"] = 0
    rd["failed"] = 0
    rd["batches_done"] = 0
    rd

fn rd_advance_batch(rd: dict, successes: int, failures: int) -> dict
    rd["deployed"] = rd["deployed"] + successes
    rd["failed"] = rd["failed"] + failures
    rd["batches_done"] = rd["batches_done"] + 1
    if rd["deployed"] + rd["failed"] >= rd["total"]
        rd["status"] = "complete"
    rd

fn rd_pause(rd: dict) -> dict
    if rd["status"] == "deploying"
        rd["status"] = "paused"
    rd

fn rd_resume(rd: dict) -> dict
    if rd["status"] == "paused"
        rd["status"] = "deploying"
    rd

fn rd_rollback(rd: dict) -> dict
    rd["status"] = "rolling-back"
    rd

fn rd_progress_pct(rd: dict) -> int
    if rd["total"] == 0
        return 0
    (rd["deployed"] * 100) / rd["total"]

fn rd_failure_rate(rd: dict) -> int
    let attempted = rd["deployed"] + rd["failed"]
    if attempted == 0
        return 0
    (rd["failed"] * 100) / attempted

fn rd_remaining(rd: dict) -> int
    let done = rd["deployed"] + rd["failed"]
    if done >= rd["total"]
        return 0
    rd["total"] - done

fn rd_status(rd: dict) -> string
    rd["status"]

fn rd_version(rd: dict) -> string
    rd["version"]

fn rd_batches_done(rd: dict) -> int
    rd["batches_done"]
