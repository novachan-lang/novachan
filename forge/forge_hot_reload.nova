// forge_hot_reload — Hot-reload module tracking.

fn hr_new() -> dict
    {"modules": {}, "versions": {}, "last_reload": {}, "reload_count": 0, "total_reloads": 0}

fn hr_register(h: dict, module: string, version: int) -> dict
    h["modules"][module] = 1
    h["versions"][module] = version
    h["last_reload"][module] = 0
    h

fn hr_reload(h: dict, module: string, new_version: int, timestamp: int) -> dict
    if module not in h["modules"]
        return h
    let old = h["versions"][module]
    if new_version <= old
        return h
    h["versions"][module] = new_version
    h["last_reload"][module] = timestamp
    h["reload_count"] += 1
    h["total_reloads"] += 1
    h

fn hr_version(h: dict, module: string) -> int
    if module not in h["versions"]
        return 0
    h["versions"][module]

fn hr_needs_reload(h: dict, module: string, latest_version: int) -> int
    if module not in h["versions"]
        return 0
    1 if h["versions"][module] < latest_version else 0

fn hr_module_count(h: dict) -> int
    len(keys(h["modules"]))

fn hr_total_reloads(h: dict) -> int
    h["total_reloads"]

fn hr_last_reload_time(h: dict, module: string) -> int
    if module not in h["last_reload"]
        return 0
    h["last_reload"][module]
