// forge_object_store — Object storage abstraction (S3-like).
// Buckets, put/get/delete objects, metadata, listing.

fn os_new() -> dict
    let os = {}
    os["buckets"] = {}
    os

fn os_create_bucket(os: dict, name: string) -> dict
    let has = contains(os["buckets"], name)
    if has == true
        return os
    os["buckets"][name] = {}
    os

fn os_put(os: dict, bucket: string, key: string, data: string, content_type: string) -> dict
    let has = contains(os["buckets"], bucket)
    if has != true
        return os
    let obj = {}
    obj["data"] = data
    obj["content_type"] = content_type
    obj["size"] = len(data)
    os["buckets"][bucket][key] = obj
    os

fn os_get(os: dict, bucket: string, key: string) -> string
    let has_b = contains(os["buckets"], bucket)
    if has_b != true
        return ""
    let has_k = contains(os["buckets"][bucket], key)
    if has_k != true
        return ""
    os["buckets"][bucket][key]["data"]

fn os_delete(os: dict, bucket: string, key: string) -> dict
    let has_b = contains(os["buckets"], bucket)
    if has_b != true
        return os
    let has_k = contains(os["buckets"][bucket], key)
    if has_k != true
        return os
    let new_bucket = {}
    let all_keys = keys(os["buckets"][bucket])
    let i = 0
    while i < len(all_keys)
        if all_keys[i] != key
            new_bucket[all_keys[i]] = os["buckets"][bucket][all_keys[i]]
        i = i + 1
    os["buckets"][bucket] = new_bucket
    os

fn os_list_keys(os: dict, bucket: string) -> list
    let has = contains(os["buckets"], bucket)
    if has != true
        return []
    keys(os["buckets"][bucket])

fn os_object_count(os: dict, bucket: string) -> int
    let has = contains(os["buckets"], bucket)
    if has != true
        return 0
    len(keys(os["buckets"][bucket]))

fn os_bucket_count(os: dict) -> int
    len(keys(os["buckets"]))

fn os_exists(os: dict, bucket: string, key: string) -> int
    let has_b = contains(os["buckets"], bucket)
    if has_b != true
        return 0
    let has_k = contains(os["buckets"][bucket], key)
    if has_k == true
        return 1
    0
