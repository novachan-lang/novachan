// forge_object_store — Object storage abstraction (S3-like).
// Buckets, put/get/delete objects, metadata, listing.

fn os_new() -> dict
    {"buckets": {}}

fn os_create_bucket(os: dict, name: string) -> dict
    if name in os["buckets"]
        return os
    os["buckets"][name] = {}
    os

fn os_put(os: dict, bucket: string, key: string, data: string, content_type: string) -> dict
    if bucket not in os["buckets"]
        return os
    os["buckets"][bucket][key] = {"data": data, "content_type": content_type, "size": len(data)}
    os

fn os_get(os: dict, bucket: string, key: string) -> string
    if bucket not in os["buckets"]
        return ""
    if key not in os["buckets"][bucket]
        return ""
    os["buckets"][bucket][key]["data"]

fn os_delete(os: dict, bucket: string, key: string) -> dict
    if bucket not in os["buckets"]
        return os
    if key not in os["buckets"][bucket]
        return os
    let new_bucket = {}
    for k in keys(os["buckets"][bucket]) if k != key
        new_bucket[k] = os["buckets"][bucket][k]
    os["buckets"][bucket] = new_bucket
    os

fn os_list_keys(os: dict, bucket: string) -> list
    if bucket not in os["buckets"]
        return []
    keys(os["buckets"][bucket])

fn os_object_count(os: dict, bucket: string) -> int
    if bucket not in os["buckets"]
        return 0
    len(keys(os["buckets"][bucket]))

fn os_bucket_count(os: dict) -> int
    len(keys(os["buckets"]))

fn os_exists(os: dict, bucket: string, key: string) -> int
    if bucket not in os["buckets"]
        return 0
    let has_k = key in os["buckets"][bucket]
    1 if has_k else 0
