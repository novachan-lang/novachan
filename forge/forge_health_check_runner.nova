// forge_health_check_runner — scheduled health check executor with Result API.

fn hcr_new() -> dict
    {"check_count": 0, "runs": 0, "healthy_count": 0, "unhealthy_count": 0}

fn hcr_add_check(h: dict, name: string, endpoint: string) -> dict
    let idx = h["check_count"]
    h["hc_" + str(idx) + "_name"] = name
    h["hc_" + str(idx) + "_ep"] = endpoint
    h["hc_" + str(idx) + "_status"] = "unknown"
    h["check_count"] += 1
    h

fn hcr_report(h: dict, name: string, healthy: int) -> Result
    for i in 0..h["check_count"]
        if h["hc_" + str(i) + "_name"] == name
            h["runs"] += 1
            if healthy == 1
                h["hc_" + str(i) + "_status"] = "healthy"
                h["healthy_count"] += 1
            else
                h["hc_" + str(i) + "_status"] = "unhealthy"
                h["unhealthy_count"] += 1
            return ok(h)
    err("check not found: " + name)

fn hcr_status(h: dict, name: string) -> Result
    for i in 0..h["check_count"]
        if h["hc_" + str(i) + "_name"] == name
            return ok(h["hc_" + str(i) + "_status"])
    err("check not found: " + name)

fn hcr_endpoint(h: dict, index: int) -> Result
    if index < 0 or index >= h["check_count"]
        return err("check index out of range")
    ok(h["hc_" + str(index) + "_ep"])

fn hcr_check_count(h: dict) -> int
    h["check_count"]

fn hcr_total_runs(h: dict) -> int
    h["runs"]

fn hcr_healthy_runs(h: dict) -> int
    h["healthy_count"]

fn hcr_unhealthy_runs(h: dict) -> int
    h["unhealthy_count"]
