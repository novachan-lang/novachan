// forge_scale -- feature scaling for machine learning. Distance-based methods (forge_knn, forge_kmeans) and
// gradient methods are DOMINATED by whichever feature has the largest raw range: mix "age" (0-100) with "income"
// (0-1,000,000) unscaled and the model effectively ignores age. Scaling puts every feature on a comparable
// footing. Three standard transforms: MIN-MAX (rescale to [0,1]), Z-SCORE / standardization (mean 0, standard
// deviation 1 -- the usual default), and UNIT-VECTOR (L2-normalize a vector to length 1, for cosine-style
// comparisons). Fit-then-transform helpers let you learn the parameters on training data and apply the SAME
// scaling to new inputs (never re-fit on test data). LEAF -- imports NOTHING.

// Min and max of a value list as [min, max] (both 0.0 if empty).
fn scale_bounds(values: list) -> list
    let mn = 0.0
    let mx = 0.0
    if len(values) > 0
        mn = values[0] * 1.0
        mx = values[0] * 1.0
        for i in 1..len(values)
            let v = values[i] * 1.0
            if v < mn
                mn = v
            if v > mx
                mx = v
    [mn, mx]

// Rescale a list to [0,1] via (x - min) / (max - min). A constant list maps to all 0.0.
fn scale_minmax(values: list) -> list
    let b = scale_bounds(values)
    let mn = b[0] * 1.0
    let mx = b[1] * 1.0
    let range = mx - mn
    let out = []
    for i in 0..len(values)
        let s = 0.0
        if range > 0.0
            s = (values[i] * 1.0 - mn) / range
        push(out, s)
    out

// Apply a min-max scaling learned elsewhere (bounds = [min, max]) to a single value.
fn scale_minmax_apply(bounds: list, x) -> float
    let mn = bounds[0] * 1.0
    let mx = bounds[1] * 1.0
    let range = mx - mn
    let out = 0.0
    if range > 0.0
        out = (x * 1.0 - mn) / range
    out

// Mean and population standard deviation as [mean, std] (both 0.0 if empty).
fn scale_stats(values: list) -> list
    let n = len(values)
    let mean = 0.0
    let std = 0.0
    if n > 0
        let sum = 0.0
        for i in 0..n
            sum += values[i] * 1.0
        mean = sum / (n * 1.0)
        let sumsq = 0.0
        for j in 0..n
            let d = values[j] * 1.0 - mean
            sumsq += d * d
        let variance = sumsq / (n * 1.0)
        if variance > 0.0
            std = sqrt(variance)
    [mean, std]

// Standardize a list to mean 0, standard deviation 1: (x - mean) / std. A constant list maps to all 0.0.
fn scale_zscore(values: list) -> list
    let s = scale_stats(values)
    let mean = s[0] * 1.0
    let std = s[1] * 1.0
    let out = []
    for i in 0..len(values)
        let z = 0.0
        if std > 0.0
            z = (values[i] * 1.0 - mean) / std
        push(out, z)
    out

// Apply a z-score scaling learned elsewhere (stats = [mean, std]) to a single value.
fn scale_zscore_apply(stats: list, x) -> float
    let mean = stats[0] * 1.0
    let std = stats[1] * 1.0
    let out = 0.0
    if std > 0.0
        out = (x * 1.0 - mean) / std
    out

// L2-normalize a vector so its Euclidean length is 1 (a zero vector stays zero). For cosine-style similarity.
// NOTE: sqrt(sumsq) is used INLINE in the division, not stored in a local -- a stored/returned sqrt of a local
// accumulator hits a layout-dependent float-repr codegen edge (returns ~3e-156). Inline sqrt is unaffected.
fn scale_unit(vector: list) -> list
    let sumsq = 0.0
    for i in 0..len(vector)
        let v = vector[i] * 1.0
        sumsq += v * v
    let out = []
    for j in 0..len(vector)
        let s = 0.0
        if sumsq > 0.0
            s = (vector[j] * 1.0) / sqrt(sumsq)
        push(out, s)
    out
