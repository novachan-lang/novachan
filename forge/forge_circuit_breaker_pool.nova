// forge_circuit_breaker_pool — pool of named circuit breakers with Result API.

fn cbp_new(default_threshold: int) -> dict
    let c = {}
    c["default_threshold"] = default_threshold
    c["breaker_count"] = 0
    c["total_calls"] = 0
    c["total_trips"] = 0
    c

fn cbp_add(c: dict, name: string) -> dict
    c["cb_" + name + "_failures"] = 0
    c["cb_" + name + "_state"] = "closed"
    c["cb_" + name + "_calls"] = 0
    c["breaker_count"] = c["breaker_count"] + 1
    c

fn cbp_call(c: dict, name: string, success: int) -> Result
    let sk = "cb_" + name + "_state"
    if sk in c != true
        return err("breaker not found: " + name)
    if c[sk] == "open"
        return err("circuit open: " + name)
    c["cb_" + name + "_calls"] = c["cb_" + name + "_calls"] + 1
    c["total_calls"] = c["total_calls"] + 1
    if success == 1
        c["cb_" + name + "_failures"] = 0
    else
        c["cb_" + name + "_failures"] = c["cb_" + name + "_failures"] + 1
        if c["cb_" + name + "_failures"] >= c["default_threshold"]
            c[sk] = "open"
            c["total_trips"] = c["total_trips"] + 1
    ok(c)

fn cbp_reset(c: dict, name: string) -> Result
    let sk = "cb_" + name + "_state"
    if sk in c != true
        return err("breaker not found: " + name)
    c[sk] = "closed"
    c["cb_" + name + "_failures"] = 0
    ok(c)

fn cbp_state(c: dict, name: string) -> Result
    let sk = "cb_" + name + "_state"
    if sk in c != true
        return err("breaker not found: " + name)
    ok(c[sk])

fn cbp_breaker_count(c: dict) -> int
    c["breaker_count"]

fn cbp_total_calls(c: dict) -> int
    c["total_calls"]

fn cbp_total_trips(c: dict) -> int
    c["total_trips"]
