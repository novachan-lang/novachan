// forge_search_engine — Full-text search index (inverted index).
// Tokenize, index, query with TF scoring.

fn se_char_lower(ch: string) -> string
    if ch == "A"
        return "a"
    if ch == "B"
        return "b"
    if ch == "C"
        return "c"
    if ch == "D"
        return "d"
    if ch == "E"
        return "e"
    if ch == "F"
        return "f"
    if ch == "G"
        return "g"
    if ch == "H"
        return "h"
    if ch == "I"
        return "i"
    if ch == "J"
        return "j"
    if ch == "K"
        return "k"
    if ch == "L"
        return "l"
    if ch == "M"
        return "m"
    if ch == "N"
        return "n"
    if ch == "O"
        return "o"
    if ch == "P"
        return "p"
    if ch == "Q"
        return "q"
    if ch == "R"
        return "r"
    if ch == "S"
        return "s"
    if ch == "T"
        return "t"
    if ch == "U"
        return "u"
    if ch == "V"
        return "v"
    if ch == "W"
        return "w"
    if ch == "X"
        return "x"
    if ch == "Y"
        return "y"
    if ch == "Z"
        return "z"
    ch

fn se_lower(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        out = out + se_char_lower(s[i])
        i = i + 1
    out

fn se_new() -> dict
    let s = {}
    s["index"] = {}
    s["docs"] = {}
    s["doc_count"] = 0
    s

fn se_tokenize(text: string) -> list
    let tokens = []
    let word = ""
    let i = 0
    while i < len(text)
        let ch = text[i]
        if ch == " " or ch == "\n" or ch == "\t" or ch == "," or ch == "." or ch == "!" or ch == "?"
            if len(word) > 0
                push(tokens, se_lower(word))
                word = ""
        else
            word = word + ch
        i = i + 1
    if len(word) > 0
        push(tokens, se_lower(word))
    tokens

fn se_add_doc(engine: dict, doc_id: string, content: string) -> dict
    let tokens = se_tokenize(content)
    engine["docs"][doc_id] = content
    engine["doc_count"] = engine["doc_count"] + 1
    let idx = engine["index"]
    let i = 0
    while i < len(tokens)
        let tok = tokens[i]
        let has_tok = contains(idx, tok)
        if has_tok != true
            idx[tok] = {}
        let posting = idx[tok]
        let has_doc = contains(posting, doc_id)
        if has_doc == true
            posting[doc_id] = posting[doc_id] + 1
        else
            posting[doc_id] = 1
        i = i + 1
    engine["index"] = idx
    engine

fn se_search(engine: dict, query: string) -> list
    let qtokens = se_tokenize(query)
    let scores = {}
    let i = 0
    while i < len(qtokens)
        let tok = qtokens[i]
        let has_tok = contains(engine["index"], tok)
        if has_tok == true
            let posting = engine["index"][tok]
            let doc_ids = keys(posting)
            let j = 0
            while j < len(doc_ids)
                let did = doc_ids[j]
                let freq = posting[did]
                let has_did = contains(scores, did)
                if has_did == true
                    scores[did] = scores[did] + freq
                else
                    scores[did] = freq
                j = j + 1
        i = i + 1
    let result = []
    let scored_ids = keys(scores)
    i = 0
    while i < len(scored_ids)
        let entry = {}
        entry["doc_id"] = scored_ids[i]
        entry["score"] = scores[scored_ids[i]]
        push(result, entry)
        i = i + 1
    se_sort_results(result)

fn se_sort_results(results: list) -> list
    let i = 0
    while i < len(results)
        let j = i + 1
        while j < len(results)
            if results[j]["score"] > results[i]["score"]
                let tmp = results[i]
                results[i] = results[j]
                results[j] = tmp
            j = j + 1
        i = i + 1
    results

fn se_doc_count(engine: dict) -> int
    engine["doc_count"]

fn se_has_doc(engine: dict, doc_id: string) -> bool
    let has_it = contains(engine["docs"], doc_id)
    if has_it == true
        return true
    false
