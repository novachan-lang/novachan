// forge_metric_store — Centralized metric storage: record timestamped
// values under a metric name, query latest/count/sum/mean.
//
// STATE SHAPE (flat dict, no nesting):
//   state["metrics"]            — string, comma-separated list of every
//                                  distinct metric_name recorded.
//   state["count_"+name]        — int, number of recordings for `name`.
//   state["sum_"+name]          — int, running sum of values for `name`.
//   state["latest_"+name]       — int, most recently recorded value.
//   state["latest_time_"+name]  — int, timestamp of the most recent
//                                  recording.
//   state["metric_count"]       — int, number of distinct metric names.
//   state["total_records"]      — int, total recordings across all
//                                  metrics.
//
// LEAF MODULE — imports NOTHING; only NOVA builtins: contains/split/ok/err.

// _ms_has(state, metric_name) -> int — PRIVATE. 1 if the metric has ever
// been recorded.
fn _ms_has(state: dict, metric_name: string) -> int
    if contains(state, "count_" + metric_name) == true
        return 1
    0

// ms_new() -> dict
// Create an empty metric store.
fn ms_new() -> dict
    let state = {}
    state["metrics"] = ""
    state["metric_count"] = 0
    state["total_records"] = 0
    state

// ms_record(state, metric_name, value, timestamp) -> dict
// Record a value for `metric_name` at `timestamp`.
fn ms_record(state: dict, metric_name: string, value: int, timestamp: int) -> dict
    if _ms_has(state, metric_name) == 0
        if state["metrics"] == ""
            state["metrics"] = metric_name
        else
            state["metrics"] = state["metrics"] + "," + metric_name
        state["count_" + metric_name] = 0
        state["sum_" + metric_name] = 0
        state["metric_count"] = state["metric_count"] + 1
    state["count_" + metric_name] = state["count_" + metric_name] + 1
    state["sum_" + metric_name] = state["sum_" + metric_name] + value
    state["latest_" + metric_name] = value
    state["latest_time_" + metric_name] = timestamp
    state["total_records"] = state["total_records"] + 1
    state

// ms_latest(state, metric_name) -> Result
// ok(latest value), or err("metric not found").
fn ms_latest(state: dict, metric_name: string) -> Result
    if _ms_has(state, metric_name) == 0
        return err("metric not found")
    ok(state["latest_" + metric_name])

// ms_latest_time(state, metric_name) -> Result
// ok(timestamp of latest recording), or err("metric not found").
fn ms_latest_time(state: dict, metric_name: string) -> Result
    if _ms_has(state, metric_name) == 0
        return err("metric not found")
    ok(state["latest_time_" + metric_name])

// ms_count(state, metric_name) -> Result
// ok(number of recordings), or err("metric not found").
fn ms_count(state: dict, metric_name: string) -> Result
    if _ms_has(state, metric_name) == 0
        return err("metric not found")
    ok(state["count_" + metric_name])

// ms_sum(state, metric_name) -> Result
// ok(sum of all recorded values), or err("metric not found").
fn ms_sum(state: dict, metric_name: string) -> Result
    if _ms_has(state, metric_name) == 0
        return err("metric not found")
    ok(state["sum_" + metric_name])

// ms_mean(state, metric_name) -> Result
// ok(mean of all recorded values, integer division), or err("metric not
// found").
fn ms_mean(state: dict, metric_name: string) -> Result
    if _ms_has(state, metric_name) == 0
        return err("metric not found")
    ok(state["sum_" + metric_name] / state["count_" + metric_name])

// ms_metric_count(state) -> int
// Number of distinct metric names recorded.
fn ms_metric_count(state: dict) -> int
    state["metric_count"]

// ms_total_records(state) -> int
// Total recordings across all metrics.
fn ms_total_records(state: dict) -> int
    state["total_records"]

// ms_metric_list(state) -> string
// Comma-separated list of every distinct metric name recorded.
fn ms_metric_list(state: dict) -> string
    state["metrics"]
