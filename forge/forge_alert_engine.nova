fn ae_new()
    let s = {}
    s["rule_count"] = 0
    s["rule_names"] = ""
    s["alert_count"] = 0
    s["check_count"] = 0
    return s

fn ae_add_rule(s, rule_name, metric_name, op, threshold)
    let idx = int(s["rule_count"])
    s["rule_" + str(idx) + "_name"] = rule_name
    s["rule_" + str(idx) + "_metric"] = metric_name
    s["rule_" + str(idx) + "_op"] = op
    s["rule_" + str(idx) + "_threshold"] = threshold
    s["rule_" + str(idx) + "_alerts"] = 0
    s["rule_count"] = idx + 1
    if s["rule_names"] == ""
        s["rule_names"] = rule_name
    else
        s["rule_names"] = str(s["rule_names"]) + "," + rule_name
    return s

fn ae_check(s, metric_name, value) -> Result
    let count = int(s["rule_count"])
    let triggered = ""
    for i in 0..count
        let rmetric = str(s["rule_" + str(i) + "_metric"])
        if rmetric == metric_name
            let op = str(s["rule_" + str(i) + "_op"])
            let thresh = int(s["rule_" + str(i) + "_threshold"])
            let fire = 0
            if op == "gt" and value > thresh
                fire = 1
            if op == "lt" and value < thresh
                fire = 1
            if op == "eq" and value == thresh
                fire = 1
            if op == "gte" and value >= thresh
                fire = 1
            if op == "lte" and value <= thresh
                fire = 1
            if fire == 1
                let rname = str(s["rule_" + str(i) + "_name"])
                s["rule_" + str(i) + "_alerts"] = int(s["rule_" + str(i) + "_alerts"]) + 1
                s["alert_count"] = int(s["alert_count"]) + 1
                if triggered == ""
                    triggered = rname
                else
                    triggered += "," + rname
    s["check_count"] = int(s["check_count"]) + 1
    if triggered == ""
        return ok(s)
    s["last_triggered"] = triggered
    return ok(s)

fn ae_alert_count(s)
    return int(s["alert_count"])

fn ae_rule_count(s)
    return int(s["rule_count"])

fn ae_check_count(s)
    return int(s["check_count"])

fn ae_rule_alerts(s, rule_name) -> Result
    let count = int(s["rule_count"])
    for i in 0..count
        let rname = str(s["rule_" + str(i) + "_name"])
        if rname == rule_name
            return ok(int(s["rule_" + str(i) + "_alerts"]))
    return err("rule not found: " + rule_name)

fn ae_last_triggered(s) -> Result
    if "last_triggered" in s != true
        return err("no alerts triggered")
    return ok(str(s["last_triggered"]))

fn ae_rule_names(s)
    return str(s["rule_names"])
