// forge_trie_router — prefix-based route matching with Result API.

fn tr_new() -> dict
    {"routes": {}, "route_count": 0, "match_count": 0, "miss_count": 0}

fn tr_add(t: dict, path: string, handler: string) -> dict
    let rk = "r_{path}"
    t["routes"][rk] = handler
    t["route_count"] += 1
    t

fn tr_match(t: dict, path: string) -> Result
    let rk = "r_{path}"
    if rk in t["routes"]
        t["match_count"] += 1
        return ok(t["routes"][rk])
    let best = ""
    let best_len = 0
    let ks = keys(t["routes"])
    for i in 0..len(ks)
        let k = ks[i]
        let prefix = slice(k, 2, len(k))
        let plen = len(prefix)
        if plen <= len(path)
            if slice(path, 0, plen) == prefix
                if plen > best_len
                    best = t["routes"][k]
                    best_len = plen
    if best != ""
        t["match_count"] += 1
        return ok(best)
    t["miss_count"] += 1
    err("no matching route")

fn tr_route_count(t: dict) -> int
    t["route_count"]

fn tr_match_count(t: dict) -> int
    t["match_count"]

fn tr_miss_count(t: dict) -> int
    t["miss_count"]
