// forge_trie_router — prefix-based route matching with Result API.

fn tr_new() -> dict
    let t = {}
    t["routes"] = {}
    t["route_count"] = 0
    t["match_count"] = 0
    t["miss_count"] = 0
    t

fn tr_add(t: dict, path: string, handler: string) -> dict
    let rk = "r_" + path
    t["routes"][rk] = handler
    t["route_count"] = t["route_count"] + 1
    t

fn tr_match(t: dict, path: string) -> Result
    let rk = "r_" + path
    if contains(t["routes"], rk) == true
        t["match_count"] = t["match_count"] + 1
        return ok(t["routes"][rk])
    let best = ""
    let best_len = 0
    let ks = keys(t["routes"])
    let i = 0
    while i < len(ks)
        let k = ks[i]
        let prefix = slice(k, 2, len(k))
        let plen = len(prefix)
        if plen <= len(path)
            if slice(path, 0, plen) == prefix
                if plen > best_len
                    best = t["routes"][k]
                    best_len = plen
        i = i + 1
    if best != ""
        t["match_count"] = t["match_count"] + 1
        return ok(best)
    t["miss_count"] = t["miss_count"] + 1
    err("no matching route")

fn tr_route_count(t: dict) -> int
    t["route_count"]

fn tr_match_count(t: dict) -> int
    t["match_count"]

fn tr_miss_count(t: dict) -> int
    t["miss_count"]
