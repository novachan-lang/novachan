// forge_progress -- render an ASCII progress bar ("[#####-----] 50%") from current/total. For CLI progress
// output, log status lines, and deployment/job dashboards. Clamps to 0..100%. LEAF -- imports NOTHING.

fn progress_bar(current: int, total: int, width: int) -> string
    let pct = 0
    if total > 0
        pct = current * 100 / total
    if pct > 100
        pct = 100
    if pct < 0
        pct = 0
    let filled = pct * width / 100
    let bar = join(["#" if i < filled else "-" for i in 0..width], "")
    "[{bar}] {pct}%"

// Just the percentage (clamped 0..100).
fn progress_percent(current: int, total: int) -> int
    if total <= 0
        return 0
    let pct = current * 100 / total
    if pct > 100
        return 100
    if pct < 0
        return 0
    pct
