// forge_color_blend -- blend/mix two RGB colors + lighten/darken (gradients, tints, hover/active states,
// overlays). Linear interpolation in RGB space at a percentage. Composes forge_color. Imports forge_color.
import forge_color

// Blend hex1 -> hex2 at `pct` (0 = hex1, 100 = hex2). color_blend("#000000","#ffffff",50) -> "#808080".
fn color_blend(hex1: string, hex2: string, pct: int) -> string
    let a = color_hex_to_rgb(hex1)
    let b = color_hex_to_rgb(hex2)
    let r = a[0] + (b[0] - a[0]) * pct / 100
    let g = a[1] + (b[1] - a[1]) * pct / 100
    let bl = a[2] + (b[2] - a[2]) * pct / 100
    color_rgb_to_hex(r, g, bl)

// Lighten toward white by `pct`.
fn color_lighten(hex: string, pct: int) -> string
    color_blend(hex, "#ffffff", pct)

// Darken toward black by `pct`.
fn color_darken(hex: string, pct: int) -> string
    color_blend(hex, "#000000", pct)
