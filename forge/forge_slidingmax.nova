// forge_slidingmax -- the maximum (or minimum) of every sliding window of width k over a sequence, computed in
// O(n) TOTAL rather than O(n*k). The naive way re-scans each window; this keeps a "monotonic deque" of candidate
// indices so each element is added and removed at most once. It's the workhorse behind rolling highs/lows on a
// price or sensor series, peak detection over a moving window, moving-max in signal processing, and bounded
// look-back "best so far in the last k" queries. Returns one value per full window: for input length n and
// window k, that's n-k+1 results. Composes forge_deque (O(1) both-ended queue). Integer values. Imports
// forge_deque.

import forge_deque

// The maximum of each contiguous window of size k. Returns n-k+1 values (empty if k<=0 or k>len).
fn sliding_max(arr: list, k: int) -> list
    let out = []
    let n = len(arr)
    if k > 0 and k <= n
        // deque holds indices; the values at those indices are kept strictly decreasing front->back
        let dq = deque_new()
        for i in 0..n
            // drop indices that have fallen out of the window on the left
            while not deque_is_empty(dq) and deque_peek_front(dq) <= i - k
                deque_pop_front(dq)
            // drop back indices whose value is <= arr[i] (they can never be the max while i is in window)
            while not deque_is_empty(dq) and arr[deque_peek_back(dq)] <= arr[i]
                deque_pop_back(dq)
            deque_push_back(dq, i)
            if i >= k - 1
                let fi = deque_peek_front(dq)
                push(out, arr[fi])
    out

// The minimum of each contiguous window of size k (same technique, monotonic increasing).
fn sliding_min(arr: list, k: int) -> list
    let out = []
    let n = len(arr)
    if k > 0 and k <= n
        let dq = deque_new()
        for i in 0..n
            while not deque_is_empty(dq) and deque_peek_front(dq) <= i - k
                deque_pop_front(dq)
            while not deque_is_empty(dq) and arr[deque_peek_back(dq)] >= arr[i]
                deque_pop_back(dq)
            deque_push_back(dq, i)
            if i >= k - 1
                let fi = deque_peek_front(dq)
                push(out, arr[fi])
    out
