// forge_service_mesh — Service mesh: registry + health + routing.

fn sm_new() -> dict
    let m = {}
    m["services"] = {}
    m["health"] = {}
    m["routes"] = {}
    m["svc_count"] = 0
    m["total_routed"] = 0
    m

fn sm_register(m: dict, name: string, address: string) -> dict
    m["services"][name] = address
    m["health"][name] = "healthy"
    m["svc_count"] = m["svc_count"] + 1
    m

fn sm_deregister(m: dict, name: string) -> dict
    m["services"][name] = ""
    m["health"][name] = "removed"
    m

fn sm_set_health(m: dict, name: string, status: string) -> dict
    m["health"][name] = status
    m

fn sm_add_route(m: dict, from_svc: string, to_svc: string) -> dict
    m["routes"][from_svc] = to_svc
    m

fn sm_resolve(m: dict, name: string) -> dict
    let r = {}
    let has = contains(m["services"], name)
    if has != true
        r["found"] = 0
        r["address"] = ""
        return r
    let addr = m["services"][name]
    if addr == ""
        r["found"] = 0
        r["address"] = ""
        return r
    r["found"] = 1
    r["address"] = addr
    r

fn sm_route(m: dict, from_svc: string) -> dict
    let r = {}
    let has = contains(m["routes"], from_svc)
    if has != true
        r["found"] = 0
        r["target"] = ""
        r["m"] = m
        return r
    let target = m["routes"][from_svc]
    let health = m["health"][target]
    if health != "healthy"
        r["found"] = 0
        r["target"] = target
        r["m"] = m
        return r
    m["total_routed"] = m["total_routed"] + 1
    r["found"] = 1
    r["target"] = target
    r["m"] = m
    r

fn sm_healthy_count(m: dict) -> int
    let ks = keys(m["health"])
    let count = 0
    for i in 0..len(ks)
        if m["health"][ks[i]] == "healthy"
            count += 1
    count

fn sm_service_count(m: dict) -> int
    m["svc_count"]

fn sm_total_routed(m: dict) -> int
    m["total_routed"]
