// forge_union_find -- Union-Find / Disjoint-Set: track which elements share a group under merges and answer
// "are these two connected?" in near-O(1). Behind connected-components, clustering / record dedup grouping,
// Kruskal's minimum spanning tree, and network-connectivity queries. Path compression + union by size.
// String-keyed; elements auto-register on first use. LEAF -- imports NOTHING.

fn uf_new() -> dict
    {"parent": {}, "size": {}}

fn _uf_ensure(u: dict, x: string)
    let parent = u["parent"]
    if x not in parent
        parent[x] = x
        let size = u["size"]
        size[x] = 1

// The root/representative of x's set, compressing the path to the root as it goes.
fn uf_find(u: dict, x: string) -> string
    _uf_ensure(u, x)
    let parent = u["parent"]
    let root = x
    while parent[root] != root
        root = parent[root]
    let cur = x
    while parent[cur] != root
        let nxt = parent[cur]
        parent[cur] = root
        cur = nxt
    root

// Merge the sets containing a and b (union by size: the smaller tree hangs under the larger). Fluent.
fn uf_union(u: dict, a: string, b: string) -> dict
    let ra = uf_find(u, a)
    let rb = uf_find(u, b)
    if ra != rb
        let parent = u["parent"]
        let size = u["size"]
        if size[ra] < size[rb]
            parent[ra] = rb
            size[rb] += size[ra]
        else
            parent[rb] = ra
            size[ra] += size[rb]
    u

// Are a and b in the same set?
fn uf_connected(u: dict, a: string, b: string) -> bool
    uf_find(u, a) == uf_find(u, b)

// The size of the set containing x.
fn uf_size(u: dict, x: string) -> int
    let size = u["size"]
    size[uf_find(u, x)]
