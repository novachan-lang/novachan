// forge_slug -- URL slug generation (Rails friendly_id / Django slugify). "Hello World! 2024" -> "hello-
// world-2024": lowercase, non-alnum runs collapse to a single hyphen, no leading/trailing hyphen. LEAF.

fn slugify(title: string) -> string
    let out_parts = []
    let prev_dash = 1
    let i = 0
    let n = len(title)
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789"
    while i < n
        let c = lower(char_at(title, i))
        if find(allowed, c) >= 0
            push(out_parts, c)
            prev_dash = 0
        else
            if prev_dash == 0
                push(out_parts, "-")
                prev_dash = 1
        i += 1
    let out = join(out_parts, "")
    if len(out) > 0 and char_at(out, len(out) - 1) == "-"
        out = slice(out, 0, len(out) - 1)
    out

// Slug + a uniqueness suffix (append "-<n>" so duplicate titles get distinct slugs: "post", "post-2", ...).
fn slugify_n(title: string, n: int) -> string
    let base = slugify(title)
    if n <= 1
        return base
    base + "-" + str(n)
