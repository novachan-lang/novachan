// forge_error_handler — Centralized error handling/reporting.
// Collect, categorize, deduplicate errors, track frequency.

fn eh_new() -> dict
    let eh = {}
    eh["errors"] = []
    eh["categories"] = {}
    eh["total"] = 0
    eh

fn eh_report(eh: dict, category: string, message: string, source: string) -> dict
    let err = {}
    err["category"] = category
    err["message"] = message
    err["source"] = source
    err["count"] = 1
    let dedup_key = category + ":" + message
    let found = 0
    let i = 0
    while i < len(eh["errors"])
        let existing_key = eh["errors"][i]["category"] + ":" + eh["errors"][i]["message"]
        if existing_key == dedup_key
            eh["errors"][i]["count"] = eh["errors"][i]["count"] + 1
            found = 1
        i = i + 1
    if found != 1
        push(eh["errors"], err)
    eh["total"] = eh["total"] + 1
    let has_cat = contains(eh["categories"], category)
    if has_cat != true
        eh["categories"][category] = 0
    eh["categories"][category] = eh["categories"][category] + 1
    eh

fn eh_total(eh: dict) -> int
    eh["total"]

fn eh_unique_count(eh: dict) -> int
    len(eh["errors"])

fn eh_by_category(eh: dict, category: string) -> list
    let result = []
    let i = 0
    while i < len(eh["errors"])
        if eh["errors"][i]["category"] == category
            push(result, eh["errors"][i])
        i = i + 1
    result

fn eh_category_count(eh: dict, category: string) -> int
    let has = contains(eh["categories"], category)
    if has != true
        return 0
    eh["categories"][category]

fn eh_top_errors(eh: dict, n: int) -> list
    let sorted = []
    let i = 0
    while i < len(eh["errors"])
        push(sorted, eh["errors"][i])
        i = i + 1
    let j = 0
    while j < len(sorted)
        let k = j + 1
        while k < len(sorted)
            if sorted[k]["count"] > sorted[j]["count"]
                let tmp = sorted[j]
                sorted[j] = sorted[k]
                sorted[k] = tmp
            k = k + 1
        j = j + 1
    let result = []
    let m = 0
    while m < n
        if m >= len(sorted)
            return result
        push(result, sorted[m])
        m = m + 1
    result

fn eh_categories(eh: dict) -> list
    keys(eh["categories"])
