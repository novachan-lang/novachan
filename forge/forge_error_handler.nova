// forge_error_handler — Centralized error handling/reporting.
// Collect, categorize, deduplicate errors, track frequency.

fn eh_new() -> dict
    {"errors": [], "categories": {}, "total": 0}

fn eh_report(eh: dict, category: string, message: string, source: string) -> dict
    let err = {"category": category, "message": message, "source": source, "count": 1}
    let dedup_key = category + ":" + message
    let found = 0
    for i in 0..len(eh["errors"])
        let existing_key = eh["errors"][i]["category"] + ":" + eh["errors"][i]["message"]
        if existing_key == dedup_key
            eh["errors"][i]["count"] += 1
            found = 1
    if found != 1
        push(eh["errors"], err)
    eh["total"] += 1
    if category not in eh["categories"]
        eh["categories"][category] = 0
    eh["categories"][category] += 1
    eh

fn eh_total(eh: dict) -> int
    eh["total"]

fn eh_unique_count(eh: dict) -> int
    len(eh["errors"])

fn eh_by_category(eh: dict, category: string) -> list
    [eh["errors"][i] for i in 0..len(eh["errors"]) if eh["errors"][i]["category"] == category]

fn eh_category_count(eh: dict, category: string) -> int
    if category not in eh["categories"]
        return 0
    eh["categories"][category]

fn eh_top_errors(eh: dict, n: int) -> list
    let sorted = [eh["errors"][i] for i in 0..len(eh["errors"])]
    for j in 0..len(sorted)
        for k in (j + 1)..len(sorted)
            if sorted[k]["count"] > sorted[j]["count"]
                let tmp = sorted[j]
                sorted[j] = sorted[k]
                sorted[k] = tmp
    let result = []
    for m in 0..n
        if m >= len(sorted)
            return result
        push(result, sorted[m])
    result

fn eh_categories(eh: dict) -> list
    keys(eh["categories"])
