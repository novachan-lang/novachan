// forge_contfrac -- continued fractions: express a fraction p/q as [a0; a1, a2, ...] (p/q = a0 + 1/(a1 + 1/(a2 +
// ...))) and compute its CONVERGENTS, the successive best rational approximations. This is the mathematically
// optimal way to approximate a number by a simple fraction: the convergents of pi are 3, then 22/7, then 355/113
// -- each the closest fraction to pi with a denominator that small, which is why 355/113 (accurate to 7 digits) is
// famous. Continued fractions drive best rational approximation (gear ratios, musical intervals, screen aspect
// ratios), the design of calendar leap rules, and number-theory algorithms. Everything here is exact integer
// arithmetic on non-negative p/q, and it composes with forge_rational (each convergent is a reduced [num,den]).
// LEAF -- imports NOTHING.

// The continued-fraction terms [a0, a1, a2, ...] of p/q (the Euclidean quotients). E.g. 415/93 -> [4,2,6,7],
// 355/113 -> [3,7,16].
fn cf_expand(p: int, q: int) -> list
    let out = []
    let a = p
    let b = q
    while b != 0
        push(out, a / b)
        let r = a % b
        a = b
        b = r
    out

// The convergents of a continued fraction as a list of reduced [numerator, denominator] pairs -- the successive
// best rational approximations. For [3,7,16] this is [[3,1],[22,7],[355,113]].
fn cf_convergents(terms: list) -> list
    let out = []
    let hprev2 = 0
    let hprev1 = 1
    let kprev2 = 1
    let kprev1 = 0
    for i in 0..len(terms)
        let a = terms[i]
        let h = a * hprev1 + hprev2
        let k = a * kprev1 + kprev2
        push(out, [h, k])
        hprev2 = hprev1
        hprev1 = h
        kprev2 = kprev1
        kprev1 = k
    out

// Reconstruct the [numerator, denominator] value of a continued fraction (its last convergent) -- the original
// fraction in lowest terms.
fn cf_to_rational(terms: list) -> list
    let cs = cf_convergents(terms)
    let out = [0, 1]
    if len(cs) > 0
        out = cs[len(cs) - 1]
    out

// The best rational approximation of p/q using at most `max_terms` continued-fraction terms, as [num, den].
// Fewer terms -> simpler fraction, larger error. cf_best_approx(355,113,2) = [22,7] (the pi -> 22/7 truncation).
fn cf_best_approx(p: int, q: int, max_terms: int) -> list
    let terms = cf_expand(p, q)
    let use = [terms[i] for i in 0..min(len(terms), max_terms)]
    cf_to_rational(use)
