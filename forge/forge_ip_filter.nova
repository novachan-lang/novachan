// forge_ip_filter — IP whitelist/blacklist filtering.
// Allow/deny lists with CIDR-like prefix matching.

fn ipf_new() -> dict
    let f = {}
    f["allow"] = []
    f["deny"] = []
    f["mode"] = "allow-all"
    f["log"] = []
    f

fn ipf_set_mode(f: dict, mode: string) -> dict
    f["mode"] = mode
    f

fn ipf_allow(f: dict, ip: string) -> dict
    push(f["allow"], ip)
    f

fn ipf_deny(f: dict, ip: string) -> dict
    push(f["deny"], ip)
    f

fn _ipf_prefix_match(ip: string, pattern: string) -> int
    if pattern == "*"
        return 1
    if ip == pattern
        return 1
    let plen = len(pattern)
    if plen == 0
        return 0
    let last_char = pattern[plen - 1]
    if last_char != "*"
        return 0
    let prefix = ""
    let i = 0
    while i < plen - 1
        prefix = prefix + pattern[i]
        i = i + 1
    if len(ip) < len(prefix)
        return 0
    let j = 0
    while j < len(prefix)
        if ip[j] != prefix[j]
            return 0
        j = j + 1
    1

fn _ipf_in_list(lst: list, ip: string) -> int
    let i = 0
    while i < len(lst)
        let matched = _ipf_prefix_match(ip, lst[i])
        if matched == 1
            return 1
        i = i + 1
    0

fn ipf_check(f: dict, ip: string) -> dict
    let denied = _ipf_in_list(f["deny"], ip)
    if denied == 1
        let entry = {}
        entry["ip"] = ip
        entry["action"] = "denied"
        push(f["log"], entry)
        let r = {}
        r["filter"] = f
        r["allowed"] = 0
        return r
    if f["mode"] == "allow-list"
        let allowed = _ipf_in_list(f["allow"], ip)
        if allowed != 1
            let entry = {}
            entry["ip"] = ip
            entry["action"] = "denied"
            push(f["log"], entry)
            let r = {}
            r["filter"] = f
            r["allowed"] = 0
            return r
    let entry = {}
    entry["ip"] = ip
    entry["action"] = "allowed"
    push(f["log"], entry)
    let r = {}
    r["filter"] = f
    r["allowed"] = 1
    r

fn ipf_log(f: dict) -> list
    f["log"]

fn ipf_log_count(f: dict) -> int
    len(f["log"])
