// forge_ip_filter -- IP-based access filtering (Sentinel). Allow/deny lists of glob-style IP patterns
// (e.g. "10.0.0.*", "192.168.1.1", "*"), matched via forge_wildcard. DENY WINS OVER ALLOW: an address
// matching any deny pattern is denied even if it also matches an allow pattern. When the allow list is
// non-empty it acts as a WHITELIST (an address must match at least one allow pattern to pass); when empty,
// every address not explicitly denied is allowed. Flat-key dict state (no nested dicts/lists), matching
// forge_session_store's convention -- state is mutated in place; callers do not need to reassign.
import forge_wildcard

fn ipf_new() -> dict
    let s = {}
    s["allow_count"] = 0
    s["deny_count"] = 0
    s["total_checks"] = 0
    s["denied_count"] = 0
    s["allowed_count"] = 0
    s

// Append a pattern to the allow list. Fluent (returns state).
fn ipf_allow(state: dict, ip_pattern: string) -> dict
    let idx = int(state["allow_count"])
    state["allow_" + str(idx)] = ip_pattern
    state["allow_count"] = idx + 1
    state

// Append a pattern to the deny list. Fluent (returns state).
fn ipf_deny(state: dict, ip_pattern: string) -> dict
    let idx = int(state["deny_count"])
    state["deny_" + str(idx)] = ip_pattern
    state["deny_count"] = idx + 1
    state

// PRIVATE: does `ip` match any of the `count` patterns stored under key prefix `prefix + "<index>"`?
fn _ipf_matches_any(state: dict, prefix: string, count: int, ip: string) -> bool
    let i = 0
    while i < count
        let pattern = str(state[prefix + str(i)])
        if wildcard_match(pattern, ip)
            return true
        i = i + 1
    false

// ipf_check(state, ip_address) -> Result: always ok("allowed") or ok("denied"). Deny list is checked
// first (deny wins). If the allow list is non-empty, ip_address must also match one of its patterns.
fn ipf_check(state: dict, ip_address: string) -> Result
    state["total_checks"] = int(state["total_checks"]) + 1
    let deny_n = int(state["deny_count"])
    if _ipf_matches_any(state, "deny_", deny_n, ip_address)
        state["denied_count"] = int(state["denied_count"]) + 1
        return ok("denied")
    let allow_n = int(state["allow_count"])
    if allow_n == 0
        state["allowed_count"] = int(state["allowed_count"]) + 1
        return ok("allowed")
    if _ipf_matches_any(state, "allow_", allow_n, ip_address)
        state["allowed_count"] = int(state["allowed_count"]) + 1
        return ok("allowed")
    state["denied_count"] = int(state["denied_count"]) + 1
    ok("denied")

fn ipf_allow_count(state: dict) -> int
    int(state["allow_count"])

fn ipf_deny_count(state: dict) -> int
    int(state["deny_count"])

fn ipf_total_checks(state: dict) -> int
    int(state["total_checks"])

fn ipf_denied_count(state: dict) -> int
    int(state["denied_count"])

fn ipf_allowed_count(state: dict) -> int
    int(state["allowed_count"])

// 1 if ip_pattern is present (verbatim) in the allow list, else 0.
fn ipf_has_allow(state: dict, ip_pattern: string) -> int
    let n = int(state["allow_count"])
    let i = 0
    while i < n
        if str(state["allow_" + str(i)]) == ip_pattern
            return 1
        i = i + 1
    0
