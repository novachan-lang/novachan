// forge_canary_monitor — Canary deployment monitoring.
// Tracks a canary vs. baseline success-rate split per deployment and
// drives promote/rollback decisions off the comparison. (Constructor is
// `can_new`, not `cm_new` — every other function in this module already
// uses the `can_` prefix; `cm_new` would collide with forge_cache_manager's
// constructor when both modules are imported together.)
//
// STATE SHAPE (flat dict, no nesting):
//   state["dep_count"]            — int, number of deployments ever started.
//   state["status_"+id]           — string, "running"/"promoted"/"rolled_back".
//   state["pct_"+id]              — int, canary traffic percentage.
//   state["c_succ_"+id]           — int, successful canary records.
//   state["c_total_"+id]          — int, total canary records.
//   state["b_succ_"+id]           — int, successful baseline records.
//   state["b_total_"+id]          — int, total baseline records.

// can_new() -> dict
// Create an empty canary monitor.
fn can_new() -> dict
    let s = {}
    s["dep_count"] = 0
    s

// can_start(state, deployment_id, canary_pct) -> dict
// Start (or restart) a canary deployment at `canary_pct`% traffic.
fn can_start(state: dict, deployment_id: string, canary_pct: int) -> dict
    let sk = "status_" + deployment_id
    if sk not in state
        state["dep_count"] = state["dep_count"] + 1
    state[sk] = "running"
    state["pct_" + deployment_id] = canary_pct
    state["c_succ_" + deployment_id] = 0
    state["c_total_" + deployment_id] = 0
    state["b_succ_" + deployment_id] = 0
    state["b_total_" + deployment_id] = 0
    state

// can_record_canary(state, deployment_id, success) -> Result
// Record one canary-path result (success = 1/0). err if unknown or not running.
fn can_record_canary(state: dict, deployment_id: string, success: int) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    if state[sk] != "running"
        return err("deployment not running: " + deployment_id)
    state["c_total_" + deployment_id] = state["c_total_" + deployment_id] + 1
    if success == 1
        state["c_succ_" + deployment_id] = state["c_succ_" + deployment_id] + 1
    ok(deployment_id)

// can_record_baseline(state, deployment_id, success) -> Result
// Record one baseline-path result (success = 1/0). err if unknown or not running.
fn can_record_baseline(state: dict, deployment_id: string, success: int) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    if state[sk] != "running"
        return err("deployment not running: " + deployment_id)
    state["b_total_" + deployment_id] = state["b_total_" + deployment_id] + 1
    if success == 1
        state["b_succ_" + deployment_id] = state["b_succ_" + deployment_id] + 1
    ok(deployment_id)

// can_canary_rate(state, deployment_id) -> Result
// ok(canary success percentage 0-100), or err if unknown / no records yet.
fn can_canary_rate(state: dict, deployment_id: string) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    let total = state["c_total_" + deployment_id]
    if total == 0
        return err("no canary records")
    ok(state["c_succ_" + deployment_id] * 100 / total)

// can_baseline_rate(state, deployment_id) -> Result
// ok(baseline success percentage 0-100), or err if unknown / no records yet.
fn can_baseline_rate(state: dict, deployment_id: string) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    let total = state["b_total_" + deployment_id]
    if total == 0
        return err("no baseline records")
    ok(state["b_succ_" + deployment_id] * 100 / total)

// can_should_promote(state, deployment_id) -> Result
// ok(1) if canary rate >= baseline rate, ok(0) otherwise; err if unknown
// or either side lacks enough data to compare.
fn can_should_promote(state: dict, deployment_id: string) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    let cr = can_canary_rate(state, deployment_id)
    let br = can_baseline_rate(state, deployment_id)
    if is_err(cr) == true
        return err("insufficient canary data")
    if is_err(br) == true
        return err("insufficient baseline data")
    let cv = unwrap(cr)
    let bv = unwrap(br)
    if cv >= bv
        return ok(1)
    ok(0)

// can_promote(state, deployment_id) -> Result
// Mark the deployment "promoted". err if unknown or not running.
fn can_promote(state: dict, deployment_id: string) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    if state[sk] != "running"
        return err("deployment not running: " + deployment_id)
    state[sk] = "promoted"
    ok(deployment_id)

// can_rollback(state, deployment_id) -> Result
// Mark the deployment "rolled_back". err if unknown or not running.
fn can_rollback(state: dict, deployment_id: string) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    if state[sk] != "running"
        return err("deployment not running: " + deployment_id)
    state[sk] = "rolled_back"
    ok(deployment_id)

// can_status(state, deployment_id) -> Result
// ok("running"/"promoted"/"rolled_back"), or err if unknown.
fn can_status(state: dict, deployment_id: string) -> Result
    let sk = "status_" + deployment_id
    if sk not in state
        return err("unknown deployment: " + deployment_id)
    ok(state[sk])

// can_deployment_count(state) -> int
fn can_deployment_count(state: dict) -> int
    state["dep_count"]
