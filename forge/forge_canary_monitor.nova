// forge_canary_monitor — Canary deployment monitoring.

fn can_new() -> dict
    {"dep_count": 0}

fn can_start(state: dict, deployment_id: string, canary_pct: int) -> dict
    let sk = "status_{deployment_id}"
    if sk not in state
        state["dep_count"] += 1
    state[sk] = "running"
    state["pct_{deployment_id}"] = canary_pct
    state["c_succ_{deployment_id}"] = 0
    state["c_total_{deployment_id}"] = 0
    state["b_succ_{deployment_id}"] = 0
    state["b_total_{deployment_id}"] = 0
    state

fn can_record_canary(state: dict, deployment_id: string, success: int) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    if state[sk] != "running"
        return err("deployment not running: {deployment_id}")
    state["c_total_{deployment_id}"] += 1
    if success == 1
        state["c_succ_{deployment_id}"] += 1
    ok(deployment_id)

fn can_record_baseline(state: dict, deployment_id: string, success: int) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    if state[sk] != "running"
        return err("deployment not running: {deployment_id}")
    state["b_total_{deployment_id}"] += 1
    if success == 1
        state["b_succ_{deployment_id}"] += 1
    ok(deployment_id)

fn can_canary_rate(state: dict, deployment_id: string) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    let total = state["c_total_{deployment_id}"]
    if total == 0
        return err("no canary records")
    ok(state["c_succ_{deployment_id}"] * 100 / total)

fn can_baseline_rate(state: dict, deployment_id: string) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    let total = state["b_total_{deployment_id}"]
    if total == 0
        return err("no baseline records")
    ok(state["b_succ_{deployment_id}"] * 100 / total)

fn can_should_promote(state: dict, deployment_id: string) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    let cr = can_canary_rate(state, deployment_id)
    let br = can_baseline_rate(state, deployment_id)
    if is_err(cr)
        return err("insufficient canary data")
    if is_err(br)
        return err("insufficient baseline data")
    let cv = unwrap(cr)
    let bv = unwrap(br)
    ok(1 if cv >= bv else 0)

fn can_promote(state: dict, deployment_id: string) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    if state[sk] != "running"
        return err("deployment not running: {deployment_id}")
    state[sk] = "promoted"
    ok(deployment_id)

fn can_rollback(state: dict, deployment_id: string) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    if state[sk] != "running"
        return err("deployment not running: {deployment_id}")
    state[sk] = "rolled_back"
    ok(deployment_id)

fn can_status(state: dict, deployment_id: string) -> Result
    let sk = "status_{deployment_id}"
    if sk not in state
        return err("unknown deployment: {deployment_id}")
    ok(state[sk])

fn can_deployment_count(state: dict) -> int
    state["dep_count"]
