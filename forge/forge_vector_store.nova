// forge_vector_store — Vector similarity search (Cortex).
// Fixed-dimension integer vectors stored as CSV strings. Similarity is
// computed via dot product (cosine-style ranking without floats): the
// caller supplies pre-normalized integer components if true cosine
// similarity is required; raw dot product is exposed directly, and
// vs_magnitude exposes the squared magnitude (sum of squares) so a
// caller can normalize externally without the compiler needing sqrt.

fn vs_new(dimensions: int) -> dict
    let s = {}
    s["dims"] = dimensions
    s["vectors"] = {}
    s["count"] = 0
    s

fn _vs_key(vec_id: string) -> string
    "v_" + vec_id

fn _vs_parse_values(values_csv: string) -> list
    let parts = split(values_csv, ",")
    let result = []
    let i = 0
    while i < len(parts)
        push(result, parse_int(parts[i]))
        i = i + 1
    result

fn vs_add(s: dict, vec_id: string, values_csv: string) -> Result
    let values = _vs_parse_values(values_csv)
    if len(values) != s["dims"]
        return err("dimension mismatch: expected " + str(s["dims"]) + " got " + str(len(values)))
    let key = _vs_key(vec_id)
    let already = contains(s["vectors"], key)
    s["vectors"][key] = values_csv
    if already != true
        s["count"] = s["count"] + 1
    ok(s)

fn vs_get(s: dict, vec_id: string) -> Result
    let key = _vs_key(vec_id)
    let has = contains(s["vectors"], key)
    if has != true
        return err("vector not found: " + vec_id)
    ok(s["vectors"][key])

fn vs_dot(s: dict, id_a: string, id_b: string) -> Result
    let ka = _vs_key(id_a)
    let has_a = contains(s["vectors"], ka)
    if has_a != true
        return err("vector not found: " + id_a)
    let kb = _vs_key(id_b)
    let has_b = contains(s["vectors"], kb)
    if has_b != true
        return err("vector not found: " + id_b)
    let va = _vs_parse_values(s["vectors"][ka])
    let vb = _vs_parse_values(s["vectors"][kb])
    let n = len(va)
    if len(vb) < n
        n = len(vb)
    let total = 0
    let i = 0
    while i < n
        total = total + (va[i] * vb[i])
        i = i + 1
    ok(total)

fn vs_magnitude(s: dict, vec_id: string) -> Result
    let key = _vs_key(vec_id)
    let has = contains(s["vectors"], key)
    if has != true
        return err("vector not found: " + vec_id)
    let values = _vs_parse_values(s["vectors"][key])
    let total = 0
    let i = 0
    while i < len(values)
        total = total + (values[i] * values[i])
        i = i + 1
    ok(total)

fn vs_count(s: dict) -> int
    s["count"]

fn vs_dimensions(s: dict) -> int
    s["dims"]

fn vs_has(s: dict, vec_id: string) -> int
    let key = _vs_key(vec_id)
    let has = contains(s["vectors"], key)
    if has == true
        return 1
    0

fn vs_remove(s: dict, vec_id: string) -> Result
    let key = _vs_key(vec_id)
    let has = contains(s["vectors"], key)
    if has != true
        return err("vector not found: " + vec_id)
    del(s["vectors"], key)
    s["count"] = s["count"] - 1
    ok(s)

fn vs_nearest(s: dict, query_id: string, candidate_csv: string) -> Result
    let qkey = _vs_key(query_id)
    let has_q = contains(s["vectors"], qkey)
    if has_q != true
        return err("vector not found: " + query_id)
    let candidates = split(candidate_csv, ",")
    if len(candidates) == 0
        return err("no candidates")
    let best_id = ""
    let best_score = 0
    let found = 0
    let i = 0
    while i < len(candidates)
        let cand = candidates[i]
        let ckey = _vs_key(cand)
        let has_c = contains(s["vectors"], ckey)
        if has_c == true
            let score_r = vs_dot(s, query_id, cand)
            if is_ok(score_r)
                let score = unwrap(score_r)
                if found == 0
                    best_id = cand
                    best_score = score
                    found = 1
                else
                    if score > best_score
                        best_id = cand
                        best_score = score
        i = i + 1
    if found == 0
        return err("no valid candidates")
    ok(best_id)
