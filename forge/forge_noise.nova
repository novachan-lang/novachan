// forge_noise -- smooth pseudo-random "value noise" for procedural generation. Ordinary random() gives jagged,
// uncorrelated numbers; noise gives a value that changes SMOOTHLY as you move through space, so nearby points
// look related. That smoothness is what makes it the go-to for generating terrain heightmaps, cloud/marble/wood
// textures, organic wobble on paths and animations, natural-looking scatter, and world generation in a game
// engine (the planned Reactor). It hashes an integer lattice to random values and smoothly interpolates between
// them (smoothstep), in 1D and 2D; the FRACTAL variant layers several octaves (fractional Brownian motion) for
// richer detail. Deterministic for a given seed, so worlds are reproducible. Outputs are in [0,1). No square
// roots or transcendentals. LEAF -- imports NOTHING.

// PRIVATE: hash a 1D integer lattice coordinate + seed to a float in [0,1).
fn _noise_hash1(i: int, seed: int) -> int
    let mask = 2147483647
    let h = (i * 374761393 + seed * 668265263 + 1013904223) & mask
    h = (h ^ (h / 65536)) & mask
    h = (h * 1274126177) & mask
    h = (h ^ (h / 8192)) & mask
    h & mask

// PRIVATE: hash a 2D lattice coordinate + seed.
fn _noise_hash2(x: int, y: int, seed: int) -> int
    let mask = 2147483647
    let h = (x * 374761393 + y * 668265263 + seed * 2147483647 + 1013904223) & mask
    h = (h ^ (h / 65536)) & mask
    h = (h * 1274126177) & mask
    h = (h ^ (h / 8192)) & mask
    h & mask

// PRIVATE: an integer hash reduced to [0,1).
fn _noise_unit(h: int) -> float
    let m = h % 1000000
    let out = (m * 1.0) / 1000000.0
    out

// Smooth 1D value noise at position x (in [0,1)). Deterministic for a given seed.
fn value_noise_1d(x: float, seed: int) -> float
    let xf = x * 1.0
    let xi = int(floor(xf))
    let frac = xf - (xi * 1.0)
    let v0 = _noise_unit(_noise_hash1(xi, seed))
    let v1 = _noise_unit(_noise_hash1(xi + 1, seed))
    let u = frac * frac * (3.0 - 2.0 * frac)
    let out = v0 + u * (v1 - v0)
    out

// Smooth 2D value noise at (x, y), bilinearly interpolated. In [0,1).
fn value_noise_2d(x: float, y: float, seed: int) -> float
    let xf = x * 1.0
    let yf = y * 1.0
    let xi = int(floor(xf))
    let yi = int(floor(yf))
    let fx = xf - (xi * 1.0)
    let fy = yf - (yi * 1.0)
    let ux = fx * fx * (3.0 - 2.0 * fx)
    let uy = fy * fy * (3.0 - 2.0 * fy)
    let v00 = _noise_unit(_noise_hash2(xi, yi, seed))
    let v10 = _noise_unit(_noise_hash2(xi + 1, yi, seed))
    let v01 = _noise_unit(_noise_hash2(xi, yi + 1, seed))
    let v11 = _noise_unit(_noise_hash2(xi + 1, yi + 1, seed))
    let top = v00 + ux * (v10 - v00)
    let bot = v01 + ux * (v11 - v01)
    let out = top + uy * (bot - top)
    out

// Fractal (fBm) 1D noise: sum `octaves` layers of increasing frequency and halving amplitude, normalized to
// [0,1). More octaves = more fine detail. octaves >= 1.
fn fractal_noise_1d(x: float, seed: int, octaves: int) -> float
    let total = 0.0
    let amp = 1.0
    let freq = 1.0
    let maxamp = 0.0
    for o in 0..octaves
        total += value_noise_1d(x * freq, seed + o) * amp
        maxamp += amp
        amp *= 0.5
        freq *= 2.0
    let out = (total / maxamp) if maxamp > 0.0 else 0.0
    out
