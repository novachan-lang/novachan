// forge_hyperloglog — cardinality estimation with Result API.

fn hll_new(precision: int) -> dict
    {"precision": precision, "registers": {}, "filled": 0, "total_added": 0}

fn hll_add(h: dict, key: string) -> dict
    let hv = hash(key)
    if hv < 0
        hv = -hv
    let idx = hv % h["precision"]
    let rk = "r_" + str(idx)
    if rk not in h["registers"]
        h["registers"][rk] = 1
        h["filled"] += 1
    else
        h["registers"][rk] += 1
    h["total_added"] += 1
    h

fn hll_estimate(h: dict) -> int
    if h["filled"] == 0
        return 0
    if h["filled"] < h["precision"]
        let empty = h["precision"] - h["filled"]
        let est = h["precision"] * 10 / (empty + 1)
        if est < h["filled"]
            return h["filled"]
        return est
    h["filled"]

fn hll_total_added(h: dict) -> int
    h["total_added"]

fn hll_filled_registers(h: dict) -> int
    h["filled"]
