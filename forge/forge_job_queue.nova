// forge_job_queue — priority job queue with Result API.

fn jq_new() -> dict
    let q = {}
    q["jobs"] = {}
    q["count"] = 0
    q["processed"] = 0
    q["failed"] = 0
    q

fn jq_enqueue(q: dict, job_id: string, payload: string, priority: int) -> dict
    let key = "job_" + str(q["count"])
    q["jobs"][key + "_id"] = job_id
    q["jobs"][key + "_payload"] = payload
    q["jobs"][key + "_priority"] = priority
    q["jobs"][key + "_status"] = "queued"
    q["count"] = q["count"] + 1
    q

fn jq_dequeue(q: dict) -> Result
    let best_idx = -1
    let best_pri = -1
    let i = 0
    while i < q["count"]
        let key = "job_" + str(i)
        if q["jobs"][key + "_status"] == "queued"
            if q["jobs"][key + "_priority"] > best_pri
                best_pri = q["jobs"][key + "_priority"]
                best_idx = i
        i = i + 1
    if best_idx == -1
        return err("queue empty")
    let key = "job_" + str(best_idx)
    q["jobs"][key + "_status"] = "processing"
    ok(q["jobs"][key + "_id"])

fn jq_complete(q: dict, job_id: string) -> Result
    let i = 0
    while i < q["count"]
        let key = "job_" + str(i)
        if q["jobs"][key + "_id"] == job_id and q["jobs"][key + "_status"] == "processing"
            q["jobs"][key + "_status"] = "done"
            q["processed"] = q["processed"] + 1
            return ok(q)
        i = i + 1
    err("job not found or not processing")

fn jq_fail_job(q: dict, job_id: string) -> Result
    let i = 0
    while i < q["count"]
        let key = "job_" + str(i)
        if q["jobs"][key + "_id"] == job_id and q["jobs"][key + "_status"] == "processing"
            q["jobs"][key + "_status"] = "failed"
            q["failed"] = q["failed"] + 1
            return ok(q)
        i = i + 1
    err("job not found or not processing")

fn jq_queued_count(q: dict) -> int
    q["count"] - q["processed"] - q["failed"]

fn jq_processed_count(q: dict) -> int
    q["processed"]

fn jq_total_count(q: dict) -> int
    q["count"]

fn jq_success_rate(q: dict) -> int
    let done = q["processed"] + q["failed"]
    if done == 0
        return 0
    q["processed"] * 100 / done
