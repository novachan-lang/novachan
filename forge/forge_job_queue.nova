// forge_job_queue — Persistent job queue with retry and status.

fn jq_new(max_retries: int) -> dict
    let j = {}
    j["jobs"] = {}
    j["job_count"] = 0
    j["max_retries"] = max_retries
    j["completed"] = 0
    j["failed_permanent"] = 0
    j

fn jq_enqueue(j: dict, name: string, payload: string) -> dict
    let k = str(j["job_count"])
    j["jobs"][k + "_name"] = name
    j["jobs"][k + "_payload"] = payload
    j["jobs"][k + "_status"] = "pending"
    j["jobs"][k + "_retries"] = 0
    j["job_count"] = j["job_count"] + 1
    j

fn jq_dequeue(j: dict) -> dict
    let result = {}
    let i = 0
    while i < j["job_count"]
        let k = str(i)
        if j["jobs"][k + "_status"] == "pending"
            j["jobs"][k + "_status"] = "running"
            result["found"] = 1
            result["idx"] = i
            result["name"] = j["jobs"][k + "_name"]
            result["payload"] = j["jobs"][k + "_payload"]
            result["j"] = j
            return result
        i = i + 1
    result["found"] = 0
    result["idx"] = -1
    result["name"] = ""
    result["payload"] = ""
    result["j"] = j
    result

fn jq_complete(j: dict, idx: int) -> dict
    j["jobs"][str(idx) + "_status"] = "completed"
    j["completed"] = j["completed"] + 1
    j

fn jq_fail(j: dict, idx: int) -> dict
    let k = str(idx)
    let retries = j["jobs"][k + "_retries"] + 1
    j["jobs"][k + "_retries"] = retries
    if retries >= j["max_retries"]
        j["jobs"][k + "_status"] = "failed"
        j["failed_permanent"] = j["failed_permanent"] + 1
    else
        j["jobs"][k + "_status"] = "pending"
    j

fn jq_pending_count(j: dict) -> int
    let count = 0
    let i = 0
    while i < j["job_count"]
        if j["jobs"][str(i) + "_status"] == "pending"
            count = count + 1
        i = i + 1
    count

fn jq_total_completed(j: dict) -> int
    j["completed"]

fn jq_total_failed(j: dict) -> int
    j["failed_permanent"]

fn jq_success_rate(j: dict) -> int
    let done = j["completed"] + j["failed_permanent"]
    if done == 0
        return 0
    j["completed"] * 100 / done
