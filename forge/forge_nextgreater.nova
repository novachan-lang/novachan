// forge_nextgreater -- the "monotonic stack" family: for each element, quickly find the nearest LARGER (or smaller)
// element to its right or left. Scanning outward from every position is O(n^2); a monotonic stack answers all of
// them together in a single O(n) pass by keeping only the elements that could still be someone's answer and
// discarding any that a newcomer has made irrelevant. This is the engine behind the "daily temperatures" problem
// (how many days until it gets warmer), the stock-span problem (how many consecutive prior days had a price no
// higher than today), rendering skylines and histograms, and computing spans/nearest-boundaries for range
// analytics. Provided: next-greater and next-smaller (to the right), previous-greater (to the left), and the
// stock-span calculation. All return -1 (or a count of 0) where no such element exists. Integer arrays. LEAF.

// For each element, the next element to its RIGHT that is strictly greater, or -1. next_greater([2,1,2,4,3]) =
// [4,2,4,-1,-1].
fn next_greater(arr: list) -> list
    let n = len(arr)
    let result = []
    for z in 0..n
        push(result, 0 - 1)
    let stack = []
    for i in 0..n
        let go = true
        while go
            if len(stack) > 0 and arr[stack[len(stack) - 1]] < arr[i]
                result[pop(stack)] = arr[i]
            else
                go = false
        push(stack, i)
    result

// For each element, the next element to its RIGHT that is strictly smaller, or -1.
fn next_smaller(arr: list) -> list
    let n = len(arr)
    let result = []
    for z in 0..n
        push(result, 0 - 1)
    let stack = []
    for i in 0..n
        let go = true
        while go
            if len(stack) > 0 and arr[stack[len(stack) - 1]] > arr[i]
                result[pop(stack)] = arr[i]
            else
                go = false
        push(stack, i)
    result

// For each element, the previous element to its LEFT that is strictly greater, or -1.
fn previous_greater(arr: list) -> list
    let n = len(arr)
    let result = [0 - 1 for z in 0..n]
    let stack = []
    for i in 0..n
        let go = true
        while go
            if len(stack) > 0 and arr[stack[len(stack) - 1]] <= arr[i]
                pop(stack)
            else
                go = false
        if len(stack) > 0
            result[i] = arr[stack[len(stack) - 1]]
        push(stack, i)
    result

// The stock span: for each day, the count of consecutive days up to and including today whose price is <= today's.
// stock_span([100,80,60,70,60,75,85]) = [1,1,1,2,1,4,6].
fn stock_span(prices: list) -> list
    let n = len(prices)
    let span = [1 for z in 0..n]
    let stack = []
    for i in 0..n
        let go = true
        while go
            if len(stack) > 0 and prices[stack[len(stack) - 1]] <= prices[i]
                pop(stack)
            else
                go = false
        if len(stack) > 0
            span[i] = i - stack[len(stack) - 1]
        else
            span[i] = i + 1
        push(stack, i)
    span
