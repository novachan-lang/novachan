// forge_response_cache — HTTP response caching middleware.
// Cache-Control directives, ETag support, conditional responses.

fn rc_new(max_entries: int) -> dict
    let c = {}
    c["entries"] = {}
    c["max_entries"] = max_entries
    c["hits"] = 0
    c["misses"] = 0
    c

fn rc_store(cache: dict, url: string, body: string, etag: string, max_age: int) -> dict
    let entry = {}
    entry["body"] = body
    entry["etag"] = etag
    entry["max_age"] = max_age
    entry["age"] = 0
    cache["entries"][url] = entry
    cache

fn rc_lookup(cache: dict, url: string) -> dict
    let has_url = contains(cache["entries"], url)
    if has_url == true
        cache["hits"] = cache["hits"] + 1
        let result = {}
        result["found"] = true
        result["body"] = cache["entries"][url]["body"]
        result["etag"] = cache["entries"][url]["etag"]
        return result
    cache["misses"] = cache["misses"] + 1
    let result = {}
    result["found"] = false
    result["body"] = ""
    result["etag"] = ""
    result

fn rc_check_etag(cache: dict, url: string, client_etag: string) -> string
    let has_url = contains(cache["entries"], url)
    if has_url != true
        return "miss"
    let entry = cache["entries"][url]
    if entry["etag"] == client_etag
        return "not_modified"
    "stale"

fn rc_invalidate(cache: dict, url: string) -> dict
    let has_url = contains(cache["entries"], url)
    if has_url == true
        cache["entries"][url]["age"] = cache["entries"][url]["max_age"] + 1
    cache

fn rc_is_fresh(cache: dict, url: string) -> bool
    let has_url = contains(cache["entries"], url)
    if has_url != true
        return false
    let entry = cache["entries"][url]
    if entry["age"] < entry["max_age"]
        return true
    false

fn rc_hit_rate(cache: dict) -> int
    let total = cache["hits"] + cache["misses"]
    if total == 0
        return 0
    (cache["hits"] * 100) / total

fn rc_size(cache: dict) -> int
    len(keys(cache["entries"]))

fn rc_clear(cache: dict) -> dict
    cache["entries"] = {}
    cache
