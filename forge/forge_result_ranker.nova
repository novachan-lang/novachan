// forge_result_ranker — Score and rank results with Result.

fn rr_new() -> dict
    let r = {}
    r["items"] = {}
    r["scores"] = {}
    r["count"] = 0
    r

fn rr_add(r: dict, item_id: string, score: int) -> dict
    let k = str(r["count"])
    r["items"][k] = item_id
    r["scores"][item_id] = score
    r["count"] = r["count"] + 1
    r

fn rr_score(r: dict, item_id: string) -> Result
    let has = contains(r["scores"], item_id)
    if has != true
        return err("unknown item: " + item_id)
    ok(r["scores"][item_id])

fn rr_boost(r: dict, item_id: string, amount: int) -> Result
    let has = contains(r["scores"], item_id)
    if has != true
        return err("unknown item: " + item_id)
    r["scores"][item_id] = r["scores"][item_id] + amount
    ok(r)

fn rr_top(r: dict) -> Result
    if r["count"] == 0
        return err("no items")
    let best = ""
    let best_score = -1
    let i = 0
    while i < r["count"]
        let id = r["items"][str(i)]
        let s = r["scores"][id]
        if s > best_score
            best_score = s
            best = id
        i += 1
    ok(best)

fn rr_count(r: dict) -> int
    r["count"]

fn rr_total_score(r: dict) -> int
    let total = 0
    let i = 0
    while i < r["count"]
        let id = r["items"][str(i)]
        total += r["scores"][id]
        i += 1
    total
