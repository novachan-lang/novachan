// forge_result_ranker — Score and rank results with Result.

fn rr_new() -> dict
    {"items": {}, "scores": {}, "count": 0}

fn rr_add(r: dict, item_id: string, score: int) -> dict
    let k = str(r["count"])
    r["items"][k] = item_id
    r["scores"][item_id] = score
    r["count"] += 1
    r

fn rr_score(r: dict, item_id: string) -> Result
    if item_id not in r["scores"]
        return err("unknown item: " + item_id)
    ok(r["scores"][item_id])

fn rr_boost(r: dict, item_id: string, amount: int) -> Result
    if item_id not in r["scores"]
        return err("unknown item: " + item_id)
    r["scores"][item_id] += amount
    ok(r)

fn rr_top(r: dict) -> Result
    if r["count"] == 0
        return err("no items")
    let best = ""
    let best_score = -1
    for i in 0..r["count"]
        let id = r["items"][str(i)]
        let s = r["scores"][id]
        if s > best_score
            best_score = s
            best = id
    ok(best)

fn rr_count(r: dict) -> int
    r["count"]

fn rr_total_score(r: dict) -> int
    let total = 0
    for i in 0..r["count"]
        let id = r["items"][str(i)]
        total += r["scores"][id]
    total
