// forge_gf2 -- linear algebra over GF(2), the two-element field where addition is XOR and multiplication is AND.
// A huge family of real problems reduces to "solve a system of XOR equations": the Lights Out puzzle and its
// relatives, decoding linear error-correcting codes, finding a subset of numbers that XORs to a target (the final
// stage of the quadratic sieve / Dixon factoring), toggling-switch and parity puzzles, and computing the rank or
// null space of a boolean matrix. Over GF(2) Gaussian elimination is dramatically faster and simpler than over the
// reals -- there are no fractions, no pivoting for stability, and an entire matrix ROW packs into a single integer
// so eliminating one variable from another row is a single XOR of two ints. gf2_solve returns one solution of
// A x = b (or reports there is none), gf2_rank gives the number of independent equations via an XOR basis, and
// gf2_xor_subset finds a subset of a list that XORs to a target. Variables are bit positions; keep the variable
// count n <= 62 so the augmented bit (the right-hand side, stored at bit n) stays inside a positive signed 64-bit
// integer. Integers only. LEAF -- imports NOTHING.

// PRIVATE: index of the highest set bit of a positive integer v (>=1); -1 if v is 0.
fn _gf2_highbit(v: int) -> int
    let x = v
    let b = 0 - 1
    let i = 0
    while x != 0
        if (x & 1) == 1
            b = i
        x = x >> 1
        i = i + 1
    b

// The rank of a boolean matrix over GF(2): the number of linearly independent rows, where each row is given as an
// integer bitmask of its 1-coefficients. Built by inserting each row into an XOR basis (keyed by highest set bit).
fn gf2_rank(rows: list) -> int
    let bybit = {}
    let count = 0
    let i = 0
    while i < len(rows)
        let v = rows[i]
        while v != 0
            let hb = _gf2_highbit(v)
            let key = str(hb)
            let existing = get(bybit, key, 0)
            if existing == 0
                bybit[key] = v
                count = count + 1
                v = 0
            else
                v = v ^ existing
        i = i + 1
    count

// Solve the linear system A x = b over GF(2). `coeffs` is a list of integer bitmasks (bit j set means variable j
// appears in that equation), `rhs` is the parallel list of 0/1 right-hand sides, and n is the number of variables.
// Returns a list of n bits giving ONE solution (free variables set to 0), or an EMPTY list if the system is
// inconsistent (no solution exists). Underdetermined systems succeed and return a particular solution.
fn gf2_solve(coeffs: list, rhs: list, n: int) -> list
    let m = len(coeffs)
    // augmented rows: bit n holds the right-hand side
    let aug = []
    let i = 0
    while i < m
        let row = coeffs[i]
        if rhs[i] == 1
            row = row | (1 << n)
        push(aug, row)
        i = i + 1
    // where[c] = the pivot row for variable/column c, or -1
    let where = []
    let c = 0
    while c < n
        push(where, 0 - 1)
        c = c + 1
    let prow = 0
    let col = 0
    while col < n and prow < m
        // find a row at or below prow with bit col set
        let sel = 0 - 1
        let r = prow
        while r < m and sel < 0
            if ((aug[r] >> col) & 1) == 1
                sel = r
            r = r + 1
        if sel >= 0
            let tmp = aug[prow]
            aug[prow] = aug[sel]
            aug[sel] = tmp
            where[col] = prow
            // reduce this column out of every OTHER row (full reduced row echelon form)
            let rr = 0
            while rr < m
                if rr != prow and ((aug[rr] >> col) & 1) == 1
                    aug[rr] = aug[rr] ^ aug[prow]
                rr = rr + 1
            prow = prow + 1
        col = col + 1
    // consistency: a row with no coefficients but a set RHS bit is 0 = 1, impossible
    let mask = (1 << n) - 1
    let bad = false
    let k = 0
    while k < m and bad == false
        if (aug[k] & mask) == 0 and ((aug[k] >> n) & 1) == 1
            bad = true
        k = k + 1
    let out = []
    if bad == false
        let x = []
        let z = 0
        while z < n
            push(x, 0)
            z = z + 1
        // with free variables at 0, each pivot variable equals its pivot row's RHS bit
        let cc = 0
        while cc < n
            if where[cc] >= 0
                x[cc] = (aug[where[cc]] >> n) & 1
            cc = cc + 1
        out = x
    out

// Find a subset of `nums` whose XOR equals `target`, returned as a list of the chosen values, or an empty list if
// no subset works (note: the empty subset legitimately reaches target 0). Solved as a GF(2) system where each bit
// position of the numbers is an equation.
fn gf2_xor_subset(nums: list, target: int) -> list
    let cnt = len(nums)
    // highest bit used across nums and target -> number of equations
    let maxbit = _gf2_highbit(target)
    let i = 0
    while i < cnt
        let hb = _gf2_highbit(nums[i])
        if hb > maxbit
            maxbit = hb
        i = i + 1
    let out = []
    if maxbit < 0
        // target 0 and all nums 0 -> empty subset works
        out = []
    else
        // equation for bit p: sum over j of bit_p(nums[j]) * x_j = bit_p(target)
        let coeffs = []
        let rhs = []
        let p = 0
        while p <= maxbit
            let cmask = 0
            let j = 0
            while j < cnt
                if ((nums[j] >> p) & 1) == 1
                    cmask = cmask | (1 << j)
                j = j + 1
            push(coeffs, cmask)
            push(rhs, (target >> p) & 1)
            p = p + 1
        let sol = gf2_solve(coeffs, rhs, cnt)
        if len(sol) == 0
            out = []
        else
            // a nonzero target forces at least one bit-equation RHS to 1, so a consistent solution is never
            // all-zero; gather the values the solution selects
            let chosen = []
            let s = 0
            while s < cnt
                if sol[s] == 1
                    push(chosen, nums[s])
                s = s + 1
            out = chosen
    out
