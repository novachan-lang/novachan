// forge_frobenius -- the "coin problem" (Frobenius / Chicken McNugget): given coin denominations that you can use
// any number of times, which amounts CANNOT be made, and what is the LARGEST such amount? With McDonald's original
// 6-, 9-, and 20-piece boxes the answer is 43 -- every total above 43 is reachable, 43 is not. This is the same
// question as which postage values a set of stamps can cover, which run-lengths a set of tile sizes can tile, and
// which sums a set of note/token values can pay exactly; it is the additive cousin of forge_diophantine (there:
// exact integer solutions to one equation; here: which targets have a NON-NEGATIVE combination at all). A largest
// unreachable amount exists only when the denominations share no common factor greater than 1 -- otherwise
// infinitely many amounts (all non-multiples of that factor) are unreachable forever. frobenius_number returns that
// largest gap, is_representable tests a single amount, and count_non_representable (the "genus") counts every
// unreachable amount. Found by a reachability sweep that provably stops once it sees min-coin consecutive reachable
// values. Positive integer coins, kept moderate. Pairs with forge_diophantine. LEAF -- imports NOTHING.

// PRIVATE: gcd (non-negative).
fn _fr_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

// PRIVATE: gcd of a whole list of coins.
fn _fr_gcd_list(coins: list) -> int
    let g = 0
    for i in 0..len(coins)
        g = _fr_gcd(g, coins[i])
    g

// PRIVATE: the smallest coin.
fn _fr_min(coins: list) -> int
    let m = coins[0]
    for i in 1..len(coins)
        if coins[i] < m
            m = coins[i]
    m

// True if `amount` can be formed as a non-negative integer combination of the coins (amount 0 is always true, the
// empty combination). Reachability DP up to `amount`.
fn is_representable(coins: list, amount: int) -> bool
    let out = false
    if amount == 0
        out = true
    else
        if amount > 0
            let reach = []
            let v = 0
            while v <= amount
                push(reach, false)
                v += 1
            reach[0] = true
            let a = 1
            while a <= amount
                for c in 0..len(coins)
                    let coin = coins[c]
                    if coin <= a and reach[a - coin]
                        reach[a] = true
                a += 1
            out = reach[amount]
    out

// The Frobenius number: the largest non-negative integer that CANNOT be formed from non-negative combinations of
// the coins. Returns -1 when there is no such largest value -- either the coins share a common factor > 1 (so
// infinitely many amounts are unreachable) or they already reach every non-negative integer (e.g. a coin of 1).
fn frobenius_number(coins: list) -> int
    let out = 0 - 1
    if len(coins) > 0 and _fr_gcd_list(coins) == 1
        let m = _fr_min(coins)
        if m > 1
            // sweep upward; stop once we have seen m consecutive reachable values
            let reach = [true]
            let consec = 1
            let last_false = 0 - 1
            let v = 1
            while consec < m
                let r = false
                for c in 0..len(coins)
                    let coin = coins[c]
                    if coin <= v and reach[v - coin]
                        r = true
                push(reach, r)
                if r
                    consec += 1
                else
                    consec = 0
                    last_false = v
                v += 1
            out = last_false
    out

// The number of non-negative integers that cannot be formed from the coins (the "genus" of the numerical
// semigroup). Returns -1 if that count is infinite (the coins share a common factor > 1).
fn count_non_representable(coins: list) -> int
    let out = 0 - 1
    if len(coins) > 0 and _fr_gcd_list(coins) == 1
        let frob = frobenius_number(coins)
        if frob < 0
            out = 0
        else
            // count unreachable values in [1, frob]; beyond frob everything is reachable
            let count = 0
            let reach = []
            let v = 0
            while v <= frob
                push(reach, false)
                v += 1
            reach[0] = true
            let a = 1
            while a <= frob
                for c in 0..len(coins)
                    let coin = coins[c]
                    if coin <= a and reach[a - coin]
                        reach[a] = true
                if reach[a] == false
                    count += 1
                a += 1
            out = count
    out
