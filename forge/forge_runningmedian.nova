// forge_runningmedian -- keep the MEDIAN of a growing stream of numbers, updated in O(log n) per value with O(1)
// median lookup, using the classic two-heap trick. The median is the robust middle -- unlike the mean (forge
// onlinestat) it shrugs off outliers, so it's the right summary for latency percentiles (p50), sensor readings
// with spikes, and any "typical value so far" over a live feed where re-sorting everything on each new sample would
// be far too slow. The idea: hold the smaller half of the numbers in a MAX-heap and the larger half in a MIN-heap,
// kept balanced in size; then the median is either the top of the bigger heap (odd count) or sits between the two
// tops (even count). This module reports the median for even counts as either the lower middle or as twice the
// true median (an exact integer, avoiding fractions). Integer values. LEAF -- imports NOTHING.

// PRIVATE: push x onto a binary MIN-heap array and sift up.
fn _rm_push(h: list, x: int)
    push(h, x)
    let i = len(h) - 1
    let done = false
    while i > 0 and done == false
        let parent = (i - 1) / 2
        if h[parent] > h[i]
            let t = h[parent]
            h[parent] = h[i]
            h[i] = t
            i = parent
        else
            done = true

// PRIVATE: pop the minimum from a min-heap array, sift down, and return it.
fn _rm_pop(h: list) -> int
    let root = h[0]
    let last = h[len(h) - 1]
    pop(h)
    if len(h) > 0
        h[0] = last
        let n = len(h)
        let i = 0
        let done = false
        while done == false
            let l = 2 * i + 1
            let r = 2 * i + 2
            let smallest = i
            if l < n and h[l] < h[smallest]
                smallest = l
            if r < n and h[r] < h[smallest]
                smallest = r
            if smallest != i
                let t = h[i]
                h[i] = h[smallest]
                h[smallest] = t
                i = smallest
            else
                done = true
    root

// A new empty running-median tracker: [lo_maxheap, hi_minheap]. lo stores NEGATED values so a min-heap acts as a
// max-heap.
fn rm_new() -> list
    [[], []]

// Add a value to the stream.
fn rm_add(rm: list, x: int)
    let lo = rm[0]
    let hi = rm[1]
    // lo holds the smaller half as a max-heap (negated); hi the larger half as a min-heap
    if len(lo) == 0 or x <= -lo[0]
        _rm_push(lo, -x)
    else
        _rm_push(hi, x)
    // rebalance so |lo| == |hi| or |lo| == |hi|+1
    if len(lo) > len(hi) + 1
        _rm_push(hi, -_rm_pop(lo))
    else if len(hi) > len(lo)
        _rm_push(lo, -_rm_pop(hi))

// The number of values seen so far.
fn rm_size(rm: list) -> int
    len(rm[0]) + len(rm[1])

// Twice the exact median (always an integer): for an odd count that's 2*median; for an even count it's the sum of
// the two middle values. Divide by 2 for the median. 0 for an empty stream.
fn rm_median_x2(rm: list) -> int
    let lo = rm[0]
    let hi = rm[1]
    if len(lo) + len(hi) == 0
        return 0
    2 * -lo[0] if len(lo) > len(hi) else -lo[0] + hi[0]

// The lower-middle value: the median for odd counts, or the smaller of the two central values for even counts.
fn rm_median_lower(rm: list) -> int
    let lo = rm[0]
    -lo[0] if len(lo) > 0 else 0
