// forge_pwstrength -- password STRENGTH estimation (a 0-4 score + label), the real-time meter shown on a
// registration form. This is distinct from forge_pwpolicy (hard accept/reject rules) and forge_pwgen
// (generation): it scores how resistant a password is, blending length and character-class diversity and
// penalizing degenerate cases (too short, all one character). A zxcvbn-lite heuristic -- fast, no wordlist.
// LEAF -- imports NOTHING.

// PRIVATE: are all characters identical (e.g. "aaaaaa")?
fn _pw_all_same(pw: string) -> bool
    let n = len(pw)
    if n < 2
        return true
    let first = char_at(pw, 0)
    for i in 1..n
        if char_at(pw, i) != first
            return false
    true

// PRIVATE: count of distinct character classes present (lower, upper, digit, symbol).
fn _pw_classes(pw: string) -> int
    let has_lower = false
    let has_upper = false
    let has_digit = false
    let has_symbol = false
    for i in 0..len(pw)
        let c = char_at(pw, i)
        if c >= "a" and c <= "z"
            has_lower = true
        else
            if c >= "A" and c <= "Z"
                has_upper = true
            else
                if c >= "0" and c <= "9"
                    has_digit = true
                else
                    has_symbol = true
    let classes = 0
    if has_lower
        classes += 1
    if has_upper
        classes += 1
    if has_digit
        classes += 1
    if has_symbol
        classes += 1
    classes

// Strength score 0 (very weak) .. 4 (very strong). < 6 chars or all-same -> 0.
fn password_strength(pw: string) -> int
    let n = len(pw)
    if n < 6
        return 0
    if _pw_all_same(pw)
        return 0
    let classes = _pw_classes(pw)
    let score = 1
    if n >= 8 and classes >= 2
        score = 2
    if n >= 10 and classes >= 3
        score = 3
    if n >= 12 and classes >= 4
        score = 4
    score

// Human label for the score.
fn password_strength_label(pw: string) -> string
    let s = password_strength(pw)
    if s == 0
        return "very weak"
    if s == 1
        return "weak"
    if s == 2
        return "fair"
    if s == 3
        return "good"
    "strong"
