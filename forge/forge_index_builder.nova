// forge_index_builder — inverted index builder with Result API.

fn ib_new() -> dict
    let b = {}
    b["index"] = {}
    b["doc_count"] = 0
    b["term_count"] = 0
    b["total_entries"] = 0
    b

fn ib_add_doc(b: dict, doc_id: string, term: string) -> dict
    let tk = "t_" + term
    if contains(b["index"], tk) != true
        b["index"][tk] = ""
        b["term_count"] = b["term_count"] + 1
    let existing = b["index"][tk]
    if existing == ""
        b["index"][tk] = doc_id
    else
        b["index"][tk] = existing + "," + doc_id
    b["total_entries"] = b["total_entries"] + 1
    b

fn ib_search(b: dict, term: string) -> Result
    let tk = "t_" + term
    if contains(b["index"], tk) != true
        return err("term not found")
    ok(b["index"][tk])

fn ib_has_term(b: dict, term: string) -> int
    let tk = "t_" + term
    if contains(b["index"], tk) == true
        return 1
    0

fn ib_register_doc(b: dict) -> dict
    b["doc_count"] = b["doc_count"] + 1
    b

fn ib_doc_count(b: dict) -> int
    b["doc_count"]

fn ib_term_count(b: dict) -> int
    b["term_count"]

fn ib_total_entries(b: dict) -> int
    b["total_entries"]
