// forge_index_builder — inverted index builder with Result API.

fn ib_new() -> dict
    {"index": {}, "doc_count": 0, "term_count": 0, "total_entries": 0}

fn ib_add_doc(b: dict, doc_id: string, term: string) -> dict
    let tk = "t_" + term
    if tk not in b["index"]
        b["index"][tk] = ""
        b["term_count"] += 1
    let existing = b["index"][tk]
    b["index"][tk] = doc_id if existing == "" else existing + "," + doc_id
    b["total_entries"] += 1
    b

fn ib_search(b: dict, term: string) -> Result
    let tk = "t_" + term
    if tk not in b["index"]
        return err("term not found")
    ok(b["index"][tk])

fn ib_has_term(b: dict, term: string) -> int
    let tk = "t_" + term
    1 if tk in b["index"] else 0

fn ib_register_doc(b: dict) -> dict
    b["doc_count"] += 1
    b

fn ib_doc_count(b: dict) -> int
    b["doc_count"]

fn ib_term_count(b: dict) -> int
    b["term_count"]

fn ib_total_entries(b: dict) -> int
    b["total_entries"]
