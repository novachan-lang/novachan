// forge_pg -- a pure-NOVA PostgreSQL driver. v1 = the wire-protocol ENCODING/PARSING (PG frontend/backend
// protocol v3 = length-prefixed big-endian binary messages). This slice builds the client messages and
// parses the key server replies; it is fully unit-testable WITHOUT a live PG server. The live connection
// (TCP + the auth handshake incl. SCRAM-SHA-256 + the typed-query/pool integration parallel to forge_db)
// is specified in NOVA_DESIGN/POSTGRES_DRIVER_DESIGN.md and built in a focused session (the test harness
// has no PG server to gate against).

// Big-endian int32 / int16 (PG is big-endian on the wire). Lengths are non-negative; the NULL marker (-1)
// is emitted as four 0xFF bytes by the wire and read back as 0xFFFFFFFF, handled on parse.
import forge_crypto

fn pg_be32(n: int) -> any
    let b = bytes(0)
    b = bytes_append(b, (n / 16777216) % 256)
    b = bytes_append(b, (n / 65536) % 256)
    b = bytes_append(b, (n / 256) % 256)
    b = bytes_append(b, n % 256)
    b

fn pg_be16(n: int) -> any
    let b = bytes(0)
    b = bytes_append(b, (n / 256) % 256)
    b = bytes_append(b, n % 256)
    b

fn pg_rd_be32(b, off: int) -> int
    (bytes_get(b, off) * 16777216) + (bytes_get(b, off + 1) * 65536) + (bytes_get(b, off + 2) * 256) + bytes_get(b, off + 3)

fn pg_rd_be16(b, off: int) -> int
    (bytes_get(b, off) * 256) + bytes_get(b, off + 1)

// A C string (NUL-terminated) as bytes.
fn _cstr(s: string) -> any
    bytes_append(str_to_bytes(s), 0)

// Read a C string from `b` at `p` -> [string, next_offset_after_NUL].
fn _rd_cstr(b, p: int) -> any
    let s = ""
    let i = p
    while bytes_get(b, i) != 0
        s = s + chr(bytes_get(b, i))
        i = i + 1
    let r = []
    push(r, s)
    push(r, i + 1)
    r

// StartupMessage: int32 length (incl. itself) + int32 protocol (196608 = v3.0) + "user\0<u>\0database\0<d>\0"
// + a final \0 (empty key terminates the parameter list).
fn pg_startup_message(user: string, db: string) -> any
    let body = pg_be32(196608)
    body = bytes_concat(body, _cstr("user"))
    body = bytes_concat(body, _cstr(user))
    body = bytes_concat(body, _cstr("database"))
    body = bytes_concat(body, _cstr(db))
    body = bytes_append(body, 0)
    bytes_concat(pg_be32(bytes_len(body) + 4), body)

// Simple-query message: 'Q' + int32 length (excludes the tag, includes itself) + sql + \0.
fn pg_query_message(sql: string) -> any
    let payload = _cstr(sql)
    let msg = bytes(0)
    msg = bytes_append(msg, 81)
    msg = bytes_concat(msg, pg_be32(bytes_len(payload) + 4))
    bytes_concat(msg, payload)

// Parse a RowDescription ('T') message at `off` -> the list of column names. Layout: tag(1) + len(4) +
// int16 field-count, then per field a C-string name + 18 metadata bytes (table oid 4, col 2, type oid 4,
// type size 2, type mod 4, format 2).
fn pg_parse_row_description(b, off: int) -> any
    let count = pg_rd_be16(b, off + 5)
    let names = []
    let p = off + 7
    let i = 0
    while i < count
        let r = _rd_cstr(b, p)
        push(names, r[0])
        p = r[1] + 18
        i = i + 1
    names

// Parse a DataRow ('D') message at `off` -> the list of column value strings ("" for SQL NULL). Layout:
// tag(1) + len(4) + int16 column-count, then per column an int32 value-length (-1 = NULL) + that many bytes.
fn pg_parse_data_row(b, off: int) -> any
    let count = pg_rd_be16(b, off + 5)
    let vals = []
    let p = off + 7
    let i = 0
    while i < count
        let vlen = pg_rd_be32(b, p)
        p = p + 4
        if vlen > 2147483647
            push(vals, "")
        else
            let s = ""
            let j = 0
            while j < vlen
                s = s + chr(bytes_get(b, p + j))
                j = j + 1
            push(vals, s)
            p = p + vlen
        i = i + 1
    vals

// ── SCRAM-SHA-256 client (RFC 5802 / RFC 7677), pure-NOVA via forge_crypto ─────────────────────────
// The auth handshake Postgres uses by default. All pure computation (no socket): given the user, the
// password, the client nonce, and the server-first message, produce the client-final message (with the
// ClientProof) and the expected ServerSignature (to verify the server-final). gs2 header "n,," -> "biws".

fn pg_scram_client_first(user: string, cnonce: string) -> string
    "n,,n=" + user + ",r=" + cnonce

// Parse "r=<rnonce>,s=<b64salt>,i=<iter>" -> [rnonce, salt_b64, iter].
fn _pg_scram_parse_sf(sf: string) -> any
    let parts = split(sf, ",")
    let rnonce = ""
    let salt_b64 = ""
    let iter = 0
    let i = 0
    while i < len(parts)
        let p = parts[i]
        if len(p) >= 2
            let tag = slice(p, 0, 2)
            let val = slice(p, 2, len(p))
            if tag == "r="
                rnonce = val
            else if tag == "s="
                salt_b64 = val
            else if tag == "i="
                iter = parse_int(val)
        i = i + 1
    let out = []
    push(out, rnonce)
    push(out, salt_b64)
    push(out, iter)
    out

// Finish the exchange: returns [client_final_message, expected_server_signature_b64]. The caller sends
// out[0] and checks the server-final "v=" against out[1].
fn pg_scram_finish(user: string, password: string, cnonce: string, server_first: string) -> any
    let sf = _pg_scram_parse_sf(server_first)
    let rnonce = sf[0]
    let salt = b64_decode_blist(sf[1])
    let iter = sf[2]
    // RFC 5802: the server nonce MUST begin with (and extend) the client nonce -- this proves our nonce was
    // incorporated and defends against a server/MITM substituting its own. Also reject a non-positive
    // iteration count (a malformed or hostile server-first that would make PBKDF2 trivial). On any failure
    // return [] (empty) so the caller aborts the handshake instead of authenticating to an unverified server.
    if not starts_with(rnonce, cnonce)
        return []
    if len(rnonce) <= len(cnonce)
        return []
    if iter < 1
        return []
    let client_first_bare = "n=" + user + ",r=" + cnonce
    let client_final_noproof = "c=biws,r=" + rnonce
    let auth_message = client_first_bare + "," + server_first + "," + client_final_noproof
    let am = str_to_blist(auth_message)
    let salted = pbkdf2_sha256(str_to_blist(password), salt, iter, 32)
    let client_key = hmac_sha256_bytes(salted, str_to_blist("Client Key"))
    let stored_key = sha256_bytes(client_key)
    let client_sig = hmac_sha256_bytes(stored_key, am)
    let proof = []
    let j = 0
    while j < len(client_key)
        push(proof, client_key[j] ^ client_sig[j])
        j = j + 1
    let client_final = client_final_noproof + ",p=" + b64_encode_blist(proof)
    let server_key = hmac_sha256_bytes(salted, str_to_blist("Server Key"))
    let server_sig = hmac_sha256_bytes(server_key, am)
    let out = []
    push(out, client_final)
    push(out, b64_encode_blist(server_sig))
    out

// PG MD5 auth (legacy AuthenticationMD5Password). The client sends "md5" + md5(md5(password + user) +
// salt), where `salt` is the 4 random bytes the server sent. SCRAM (above) is the modern default; this is
// only for old servers. PG MD5 is structurally weak by design -- compatibility, not security.
fn pg_md5_auth(user: string, password: string, salt) -> string
    let inner = md5_hex(password + user)
    let outer_in = str_to_blist(inner)
    let i = 0
    while i < len(salt)
        push(outer_in, salt[i])
        i = i + 1
    "md5" + hex_of(md5_bytes(outer_in))

// ── v2: LIVE driver (real socket; PLAINTEXT over tcp_* OR TLS via SChannel/OpenSSL) ──────────────────
// A connection is [kind, handle]: kind 0 = plaintext (handle = tcp sock fd), 1 = TLS (handle = tls handle).
// ALL wire I/O goes through _pg_send / _pg_recv_chunk, so the startup+auth+query logic is transport-agnostic.
extern fn nova_rt_os_random(n: int) -> bytes
extern fn nova_rt_tls_upgrade(sock: int, host: string, verify: int) -> int
extern fn nova_rt_tls_send_bytes(handle: int, b: bytes) -> int
extern fn nova_rt_tls_recv_bytes(handle: int) -> bytes
// (tls_close is already a compiler builtin -- used directly below, NOT re-declared as extern.)

// A SCRAM client nonce: 18 CSPRNG bytes, base64'd (its alphabet excludes ',' so it is a valid nonce as-is).
fn _pg_gen_nonce() -> string
    let rb = unsafe nova_rt_os_random(18)
    let bl = []
    let i = 0
    while i < bytes_len(rb)
        push(bl, bytes_get(rb, i))
        i = i + 1
    b64_encode_blist(bl)

// Tagged frontend message: tag(1) + int32 len(payload+4) + payload.
fn _pg_msg(tag: int, payload) -> any
    let m = bytes(0)
    m = bytes_append(m, tag)
    m = bytes_concat(m, pg_be32(bytes_len(payload) + 4))
    bytes_concat(m, payload)

// Transport-agnostic send (conn = [kind, handle]).
fn _pg_send(conn, data)
    if conn[0] == 1
        unsafe nova_rt_tls_send_bytes(conn[1], data)
    else
        tcp_send_bytes(conn[1], data)

// Transport-agnostic recv of the next chunk; empty bytes on EOF.
fn _pg_recv_chunk(conn) -> any
    if conn[0] == 1
        return unsafe nova_rt_tls_recv_bytes(conn[1])
    tcp_recv_bytes(conn[1])

fn _pg_close_transport(conn)
    if conn[0] == 1
        tls_close(conn[1])
    else
        tcp_close(conn[1])

// Read exactly ONE backend message off the transport (accumulating across chunks). Returns
// [tag(int), full_message_bytes (tag+len+body -> pg_parse_* take off=0), leftover_bytes]. tag -1 = EOF.
fn _pg_recv_msg(conn, buf) -> any
    while bytes_len(buf) < 5
        let chunk = _pg_recv_chunk(conn)
        if bytes_len(chunk) == 0
            let e = []
            push(e, 0 - 1)
            push(e, bytes(0))
            push(e, buf)
            return e
        buf = bytes_concat(buf, chunk)
    let tag = bytes_get(buf, 0)
    let total = 1 + pg_rd_be32(buf, 1)
    while bytes_len(buf) < total
        let chunk = _pg_recv_chunk(conn)
        if bytes_len(chunk) == 0
            let e = []
            push(e, 0 - 1)
            push(e, bytes(0))
            push(e, buf)
            return e
        buf = bytes_concat(buf, chunk)
    let r = []
    push(r, tag)
    push(r, bytes_slice(buf, 0, total))
    push(r, bytes_slice(buf, total, bytes_len(buf)))
    r

// Parse an ErrorResponse ('E') / NoticeResponse ('N') -> the primary human message (field 'M').
fn _pg_parse_error(msg) -> string
    let p = 5
    let out = "unknown error"
    while bytes_get(msg, p) != 0
        let ftype = bytes_get(msg, p)
        let r = _rd_cstr(msg, p + 1)
        p = r[1]
        if ftype == 77
            out = r[0]
    out

// Shared startup + auth handshake over an established transport. Returns ok(conn) ready for queries, or err.
fn _pg_handshake(conn, user: string, db: string, password: string) -> any
    _pg_send(conn, pg_startup_message(user, db))
    let buf = bytes(0)
    let cnonce = ""
    let expected_sig = ""
    let done = 0
    while done == 0
        let m = _pg_recv_msg(conn, buf)
        let tag = m[0]
        let msg = m[1]
        buf = m[2]
        if tag == 0 - 1
            _pg_close_transport(conn)
            return err("pg: connection closed during startup/auth")
        else if tag == 82
            let code = pg_rd_be32(msg, 5)
            if code == 0
                done = 0
            else if code == 3
                _pg_send(conn, _pg_msg(112, _cstr(password)))
            else if code == 5
                let salt = []
                let si = 0
                while si < 4
                    push(salt, bytes_get(msg, 9 + si))
                    si = si + 1
                _pg_send(conn, _pg_msg(112, _cstr(pg_md5_auth(user, password, salt))))
            else if code == 10
                cnonce = _pg_gen_nonce()
                let cfb = str_to_bytes(pg_scram_client_first(user, cnonce))
                let payload = _cstr("SCRAM-SHA-256")
                payload = bytes_concat(payload, pg_be32(bytes_len(cfb)))
                payload = bytes_concat(payload, cfb)
                _pg_send(conn, _pg_msg(112, payload))
            else if code == 11
                let sf = bytes_to_str(bytes_slice(msg, 9, bytes_len(msg)))
                let fin = pg_scram_finish(user, password, cnonce, sf)
                if len(fin) == 0
                    _pg_close_transport(conn)
                    return err("pg: SCRAM server-first rejected (nonce/iteration check)")
                expected_sig = fin[1]
                _pg_send(conn, _pg_msg(112, str_to_bytes(fin[0])))
            else if code == 12
                let svf = bytes_to_str(bytes_slice(msg, 9, bytes_len(msg)))
                if svf != "v=" + expected_sig
                    _pg_close_transport(conn)
                    return err("pg: SCRAM server signature mismatch (possible MITM)")
            else
                _pg_close_transport(conn)
                return err("pg: unsupported auth code " + str(code))
        else if tag == 69
            let e = _pg_parse_error(msg)
            _pg_close_transport(conn)
            return err("pg: " + e)
        else if tag == 90
            done = 1
    ok(conn)

// Plaintext connect -> ok([0, sock]) ready for queries, or err.
fn pg_connect(host: string, port: int, user: string, db: string, password: string) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("pg: cannot connect to " + host + ":" + str(port))
    let conn = []
    push(conn, 0)
    push(conn, sock)
    _pg_handshake(conn, user, db, password)

// TLS connect: PG SSLRequest ([int32 8][int32 80877103]); on 'S' upgrade the socket to TLS and run the SAME
// startup+auth over the encrypted transport. `sslmode`: "require" = encrypt only (no cert check -- works
// with a self-signed dev server); "verify-full" (or "verify-ca") = validate the cert chain to a trusted
// root AND the hostname (MITM-safe). On 'N' the server declined TLS -> fail closed.
fn pg_connect_tls(host: string, port: int, user: string, db: string, password: string, sslmode: string) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("pg: cannot connect to " + host + ":" + str(port))
    let req = pg_be32(8)
    req = bytes_concat(req, pg_be32(80877103))
    tcp_send_bytes(sock, req)
    let reply = tcp_recv_bytes(sock)
    if bytes_len(reply) < 1
        tcp_close(sock)
        return err("pg: no reply to SSLRequest")
    if bytes_get(reply, 0) != 83
        tcp_close(sock)
        return err("pg: server declined TLS (SSLRequest reply was not 'S')")
    let verify = 0
    if sslmode == "verify-full" or sslmode == "verify-ca"
        verify = 1
    let tls = unsafe nova_rt_tls_upgrade(sock, host, verify)
    if tls == 0
        tcp_close(sock)
        return err("pg: TLS handshake/verification failed (sslmode=" + sslmode + ")")
    let conn = []
    push(conn, 1)
    push(conn, tls)
    _pg_handshake(conn, user, db, password)

// Run a simple-protocol query -> ok(list of name-keyed row dicts; "" for SQL NULL) or err.
fn pg_exec(conn, sql: string) -> any
    _pg_send(conn, pg_query_message(sql))
    let buf = bytes(0)
    let names = []
    let rows = []
    let done = 0
    let errmsg = ""
    let had_err = 0
    while done == 0
        let m = _pg_recv_msg(conn, buf)
        let tag = m[0]
        let msg = m[1]
        buf = m[2]
        if tag == 0 - 1
            done = 1
        else if tag == 84
            names = pg_parse_row_description(msg, 0)
        else if tag == 68
            let vals = pg_parse_data_row(msg, 0)
            let row = {}
            let i = 0
            while i < len(names)
                if i < len(vals)
                    row[names[i]] = vals[i]
                i = i + 1
            push(rows, row)
        else if tag == 69
            errmsg = _pg_parse_error(msg)
            had_err = 1
        else if tag == 90
            done = 1
    if had_err == 1
        return err("pg: " + errmsg)
    ok(rows)

// Close cleanly: Terminate ('X') then close the transport.
fn pg_close(conn)
    _pg_send(conn, _pg_msg(88, bytes(0)))
    _pg_close_transport(conn)

// ── PARAMETERIZED queries (extended protocol) — INJECTION-SAFE ──────────────────────────────────────
// The SQL uses $1,$2,... placeholders; the values are sent as SEPARATE Bind parameters and are NEVER
// concatenated into the SQL string, so a value like "x'; DROP TABLE t; --" is bound as a literal, never
// parsed as SQL. This is the production-grade, injection-safe path (vs pg_exec's simple-query string).
// All params are sent in TEXT format; the server coerces per the column/placeholder type.

// Parse ('P'): unnamed statement + query + int16(0 param-type OIDs -> server infers).
fn _pg_parse_msg(sql: string) -> any
    let payload = _cstr("")
    payload = bytes_concat(payload, _cstr(sql))
    payload = bytes_concat(payload, pg_be16(0))
    _pg_msg(80, payload)

// Bind ('B'): unnamed portal + unnamed statement + int16(0 param fmt codes = all text) + int16(nparams)
// + per param [int32 len + bytes] + int16(0 result fmt codes = all text).
fn _pg_bind_msg(params: list) -> any
    let payload = _cstr("")
    payload = bytes_concat(payload, _cstr(""))
    payload = bytes_concat(payload, pg_be16(0))
    payload = bytes_concat(payload, pg_be16(len(params)))
    let i = 0
    while i < len(params)
        let pb = str_to_bytes(params[i])
        payload = bytes_concat(payload, pg_be32(bytes_len(pb)))
        payload = bytes_concat(payload, pb)
        i = i + 1
    payload = bytes_concat(payload, pg_be16(0))
    _pg_msg(66, payload)

// Describe ('D') the unnamed PORTAL ('P') -> the server returns RowDescription so we get column names.
fn _pg_describe_portal_msg() -> any
    let payload = bytes(0)
    payload = bytes_append(payload, 80)
    payload = bytes_concat(payload, _cstr(""))
    _pg_msg(68, payload)

// Execute ('E') the unnamed portal, int32 max_rows = 0 (all).
fn _pg_execute_msg() -> any
    let payload = _cstr("")
    payload = bytes_concat(payload, pg_be32(0))
    _pg_msg(69, payload)

// Run a parameterized query. `params` = a list of string values bound to $1,$2,... (text format; NULL
// params are not yet supported -- a tracked limitation). Returns ok(list of name-keyed row dicts) or err.
// Sends Parse/Bind/Describe/Execute/Sync as one batch, then reads to ReadyForQuery (Sync's error recovery
// guarantees a 'Z' even on error).
fn pg_query_params(conn, sql: string, params: list) -> any
    _pg_send(conn, _pg_parse_msg(sql))
    _pg_send(conn, _pg_bind_msg(params))
    _pg_send(conn, _pg_describe_portal_msg())
    _pg_send(conn, _pg_execute_msg())
    _pg_send(conn, _pg_msg(83, bytes(0)))
    let buf = bytes(0)
    let names = []
    let rows = []
    let done = 0
    let errmsg = ""
    let had_err = 0
    while done == 0
        let m = _pg_recv_msg(conn, buf)
        let tag = m[0]
        let msg = m[1]
        buf = m[2]
        if tag == 0 - 1
            done = 1
        else if tag == 84
            names = pg_parse_row_description(msg, 0)
        else if tag == 68
            let vals = pg_parse_data_row(msg, 0)
            let row = {}
            let i = 0
            while i < len(names)
                if i < len(vals)
                    row[names[i]] = vals[i]
                i = i + 1
            push(rows, row)
        else if tag == 69
            errmsg = _pg_parse_error(msg)
            had_err = 1
        else if tag == 90
            done = 1
    if had_err == 1
        return err("pg: " + errmsg)
    ok(rows)

// ── connection POOL + transactions (parallel to forge_db pool_*/with_tx) ─────────────────────────────
// A pool is a channel of authenticated connections; acquire = recv (parks until one frees), release = send.
// Opens n plaintext connections; on ANY failure cleanly closes those already opened and returns the err.
fn pg_pool_open(host: string, port: int, user: string, db: string, password: string, n: int) -> any
    let ch = channel()
    let opened = 0
    let i = 0
    while i < n
        let r = pg_connect(host, port, user, db, password)
        // is_ok/unwrap (runtime Result-tag checks) -- NOT `match Ok/Err`. A match on the any-typed
        // pg_connect() result mis-resolves the constructor inside this module (tracked compiler bug); the
        // runtime tag ops are unaffected. On failure, return r (already an Err Result) after closing opened.
        if is_ok(r)
            send(ch, unwrap(r))
            opened = opened + 1
        else
            let j = 0
            while j < opened
                pg_close(recv(ch))
                j = j + 1
            return r
        i = i + 1
    ok(ch)

fn pg_acquire(pool)
    recv(pool)

fn pg_release(pool, conn)
    send(pool, conn)

// Acquire -> query -> release. Returns ok(list of name-keyed row dicts) or err.
fn pg_query(pool, sql: string) -> any
    let conn = recv(pool)
    let r = pg_exec(conn, sql)
    send(pool, conn)
    r

// Parameterized (injection-safe) pooled query: acquire -> pg_query_params -> release.
fn pg_query_params_pool(pool, sql: string, params: list) -> any
    let conn = recv(pool)
    let r = pg_query_params(conn, sql, params)
    send(pool, conn)
    r

// Run body_fn(conn) in a transaction on ONE pooled connection: BEGIN, then COMMIT if body returns ok(..)
// or ROLLBACK if it returns err(..). The connection is released either way. Returns the body's Result.
fn pg_with_tx(pool, body_fn) -> any
    let conn = recv(pool)
    pg_exec(conn, "BEGIN")
    let r = body_fn(conn)
    if is_ok(r)
        pg_exec(conn, "COMMIT")
    else
        pg_exec(conn, "ROLLBACK")
    send(pool, conn)
    r

// Close all n pooled connections (drain + Terminate + close each).
fn pg_pool_close(pool, n: int)
    let i = 0
    while i < n
        pg_close(recv(pool))
        i = i + 1
