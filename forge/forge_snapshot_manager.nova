// forge_snapshot_manager — versioned state snapshots with restore and Result API.

fn snap_new() -> dict
    let s = {}
    s["snap_count"] = 0
    s["restore_count"] = 0
    s

fn snap_save(s: dict, name: string, data: string) -> dict
    let idx = s["snap_count"]
    s["sn_" + str(idx) + "_name"] = name
    s["sn_" + str(idx) + "_data"] = data
    s["snap_count"] = idx + 1
    s

fn snap_get(s: dict, index: int) -> Result
    if index < 0 or index >= s["snap_count"]
        return err("snapshot index out of range")
    ok(s["sn_" + str(index) + "_data"])

fn snap_name(s: dict, index: int) -> Result
    if index < 0 or index >= s["snap_count"]
        return err("snapshot index out of range")
    ok(s["sn_" + str(index) + "_name"])

fn snap_restore(s: dict, index: int) -> Result
    if index < 0 or index >= s["snap_count"]
        return err("snapshot index out of range")
    s["restore_count"] = s["restore_count"] + 1
    ok(s["sn_" + str(index) + "_data"])

fn snap_latest(s: dict) -> Result
    if s["snap_count"] == 0
        return err("no snapshots")
    let idx = s["snap_count"] - 1
    ok(s["sn_" + str(idx) + "_data"])

fn snap_count(s: dict) -> int
    s["snap_count"]

fn snap_restore_count(s: dict) -> int
    s["restore_count"]
