// forge_www_authenticate -- build the WWW-Authenticate response header that a 401 MUST carry (RFC 7235), with
// the Bearer-token challenge params of RFC 6750 (realm + the OAuth2 error / error_description / scope). This is
// the piece that tells a client WHY its token was rejected and what scope it needs, so an SPA can decide to
// silently refresh vs. bounce to login. The Basic-auth challenge (RFC 7617) is here too for completeness.
// Auth-param values are quoted-strings; embedded '"' and '\' are backslash-escaped. LEAF -- imports NOTHING.

// PRIVATE: a quoted auth-param `name="value"` with '"'/'\' escaped inside the value.
fn _wa_param(name: string, value: string) -> string
    let bs = chr(92)
    let q = chr(34)
    let esc = ""
    let i = 0
    while i < len(value)
        let c = char_at(value, i)
        if c == bs
            esc = esc + bs + bs
        else
            if c == q
                esc = esc + bs + q
            else
                esc = esc + c
        i = i + 1
    name + "=" + q + esc + q

// Bare `Bearer realm="<realm>"` challenge (the minimal 401 for a protected resource with no specific error).
fn bearer_challenge(realm: string) -> string
    "Bearer " + _wa_param("realm", realm)

// Full Bearer challenge with an OAuth2 error code (e.g. "invalid_token", "insufficient_scope"), a human
// description, and the required scope. Empty optional args are omitted. Params are comma-separated per the ABNF.
fn bearer_error(realm: string, error: string, description: string, scope: string) -> string
    let out = "Bearer " + _wa_param("realm", realm)
    if len(error) > 0
        out = out + ", " + _wa_param("error", error)
    if len(description) > 0
        out = out + ", " + _wa_param("error_description", description)
    if len(scope) > 0
        out = out + ", " + _wa_param("scope", scope)
    out

// Basic-auth challenge (RFC 7617): `Basic realm="<realm>"` -- prompts the browser's native login dialog.
fn basic_challenge(realm: string) -> string
    "Basic " + _wa_param("realm", realm)
