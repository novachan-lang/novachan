// forge_semver_bump -- bump a semantic version (major/minor/patch), the release-tooling counterpart to
// forge_semver (parse/compare). Semver rules: a major bump zeros minor+patch; a minor bump zeros patch; a
// prerelease/build suffix is dropped on any bump. Composes forge_semver. Imports forge_semver.
import forge_semver

fn _sb_join(maj: int, min: int, pat: int) -> string
    "{maj}.{min}.{pat}"

// x.y.z -> (x+1).0.0
fn bump_major(version: string) -> string
    let p = semver_parse(version)
    _sb_join(p[0] + 1, 0, 0)

// x.y.z -> x.(y+1).0
fn bump_minor(version: string) -> string
    let p = semver_parse(version)
    _sb_join(p[0], p[1] + 1, 0)

// x.y.z -> x.y.(z+1)
fn bump_patch(version: string) -> string
    let p = semver_parse(version)
    _sb_join(p[0], p[1], p[2] + 1)
