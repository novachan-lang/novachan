// forge_tag_manager — Tagging system with Result.

fn tag_new() -> dict
    {"tags": {}, "items": {}, "tag_count": 0, "assignment_count": 0}

fn tag_create(t: dict, name: string) -> Result
    if name in t["tags"]
        return err("tag exists: {name}")
    t["tags"][name] = 1
    t["tag_count"] += 1
    ok(t)

fn tag_assign(t: dict, item: string, tag_name: string) -> Result
    if tag_name not in t["tags"]
        return err("unknown tag: {tag_name}")
    t["items"]["{item}:{tag_name}"] = 1
    t["assignment_count"] += 1
    ok(t)

fn tag_remove(t: dict, item: string, tag_name: string) -> dict
    t["items"]["{item}:{tag_name}"] = 0
    t

fn tag_has(t: dict, item: string, tag_name: string) -> int
    let key = "{item}:{tag_name}"
    if key in t["items"]
        if t["items"][key] == 1
            return 1
    0

fn tag_count_for_item(t: dict, item: string, all_tags: dict, tag_count: int) -> int
    let c = 0
    for i in 0..tag_count
        let tag_name = all_tags[str(i)]
        if tag_has(t, item, tag_name) == 1
            c += 1
    c

fn tag_total_tags(t: dict) -> int
    t["tag_count"]

fn tag_total_assignments(t: dict) -> int
    t["assignment_count"]
