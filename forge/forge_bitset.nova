// forge_bitset -- a compact bit set / bit vector: pack thousands of boolean flags into a handful of integers
// (per-user feature flags, permission masks, sieve/set membership, presence tracking). 63 bits per word (bit
// index 63 is avoided -- NOVA's 1<<64 is broken and this keeps every word in non-negative signed range).
// set/clear/test + popcount + union/intersect. LEAF -- imports NOTHING.

fn bitset_new() -> dict
    let b = {}
    b["words"] = []
    b

fn _bitset_ensure(words: list, wi: int)
    while len(words) <= wi
        push(words, 0)

fn bitset_set(b: dict, i: int) -> dict
    let words = b["words"]
    let wi = i / 63
    _bitset_ensure(words, wi)
    words[wi] = words[wi] | (1 << (i % 63))
    b

fn bitset_test(b: dict, i: int) -> bool
    let words = b["words"]
    let wi = i / 63
    if wi >= len(words)
        return false
    (words[wi] & (1 << (i % 63))) != 0

fn bitset_clear(b: dict, i: int) -> dict
    if bitset_test(b, i)
        let words = b["words"]
        let wi = i / 63
        words[wi] = words[wi] ^ (1 << (i % 63))
    b

// The number of set bits (population count).
fn bitset_count(b: dict) -> int
    let words = b["words"]
    let total = 0
    let i = 0
    while i < len(words)
        let w = words[i]
        while w != 0
            total = total + (w & 1)
            w = w / 2
        i = i + 1
    total

fn _bitset_word(words: list, i: int) -> int
    if i < len(words)
        return words[i]
    0

// A new bitset = the union (OR) of a and b.
fn bitset_union(a: dict, b: dict) -> dict
    let out = bitset_new()
    let ow = out["words"]
    let aw = a["words"]
    let bw = b["words"]
    let n = len(aw)
    if len(bw) > n
        n = len(bw)
    let i = 0
    while i < n
        push(ow, _bitset_word(aw, i) | _bitset_word(bw, i))
        i = i + 1
    out

// A new bitset = the intersection (AND) of a and b.
fn bitset_intersect(a: dict, b: dict) -> dict
    let out = bitset_new()
    let ow = out["words"]
    let aw = a["words"]
    let bw = b["words"]
    let n = len(aw)
    if len(bw) < n
        n = len(bw)
    let i = 0
    while i < n
        push(ow, _bitset_word(aw, i) & _bitset_word(bw, i))
        i = i + 1
    out
