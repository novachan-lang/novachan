// forge_bitset -- compact bit set / bit vector: 63 bits per word (bit 63 avoided for signed range).
// set/clear/test + popcount + union/intersect. LEAF -- imports NOTHING.

fn bitset_new() -> dict
    {"words": []}

fn _bitset_ensure(words: list, wi: int)
    while len(words) <= wi
        push(words, 0)

fn bitset_set(b: dict, i: int) -> dict
    let words = b["words"]
    let wi = i / 63
    _bitset_ensure(words, wi)
    words[wi] = words[wi] | (1 << (i % 63))
    b

fn bitset_test(b: dict, i: int) -> bool
    let words = b["words"]
    let wi = i / 63
    if wi >= len(words)
        return false
    (words[wi] & (1 << (i % 63))) != 0

fn bitset_clear(b: dict, i: int) -> dict
    if bitset_test(b, i)
        let words = b["words"]
        let wi = i / 63
        words[wi] = words[wi] ^ (1 << (i % 63))
    b

fn bitset_count(b: dict) -> int
    let words = b["words"]
    let total = 0
    for i in 0..len(words)
        let w = words[i]
        while w != 0
            total += (w & 1)
            w = w / 2
    total

fn _bitset_word(words: list, i: int) -> int
    if i < len(words)
        return words[i]
    0

fn bitset_union(a: dict, b: dict) -> dict
    let out = bitset_new()
    let ow = out["words"]
    let aw = a["words"]
    let bw = b["words"]
    let n = max(len(aw), len(bw))
    for i in 0..n
        push(ow, _bitset_word(aw, i) | _bitset_word(bw, i))
    out

fn bitset_intersect(a: dict, b: dict) -> dict
    let out = bitset_new()
    let ow = out["words"]
    let aw = a["words"]
    let bw = b["words"]
    let n = min(len(aw), len(bw))
    for i in 0..n
        push(ow, _bitset_word(aw, i) & _bitset_word(bw, i))
    out
