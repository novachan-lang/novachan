// forge_backpressure — Backpressure controller for producer/consumer systems.

fn bp_new(high_watermark: int, low_watermark: int) -> dict
    let bp = {}
    bp["high"] = high_watermark
    bp["low"] = low_watermark
    bp["level"] = 0
    bp["paused"] = 0
    bp["pause_count"] = 0
    bp["resume_count"] = 0
    bp

fn bp_produce(bp: dict, amount: int) -> dict
    bp["level"] = bp["level"] + amount
    if bp["level"] >= bp["high"]
        if bp["paused"] == 0
            bp["paused"] = 1
            bp["pause_count"] = bp["pause_count"] + 1
    bp

fn bp_consume(bp: dict, amount: int) -> dict
    bp["level"] = bp["level"] - amount
    if bp["level"] < 0
        bp["level"] = 0
    if bp["level"] <= bp["low"]
        if bp["paused"] == 1
            bp["paused"] = 0
            bp["resume_count"] = bp["resume_count"] + 1
    bp

fn bp_is_paused(bp: dict) -> int
    bp["paused"]

fn bp_level(bp: dict) -> int
    bp["level"]

fn bp_utilization(bp: dict) -> int
    if bp["high"] == 0
        return 0
    bp["level"] * 100 / bp["high"]

fn bp_pause_count(bp: dict) -> int
    bp["pause_count"]

fn bp_resume_count(bp: dict) -> int
    bp["resume_count"]
