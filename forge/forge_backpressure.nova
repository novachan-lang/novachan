// forge_backpressure — Backpressure controller for producer/consumer systems.
//
// RAISED 2026-08-05. Four problems:
//
//   1. bp_new built the state dict as six individual assignments. Dict literal.
//   2. bp_produce / bp_consume used `bp["x"] = bp["x"] + n`. Compound `+=`.
//   3. bp_produce / bp_consume had nested ifs. Merged with `and`.
//   4. bp_consume used `if bp["level"] < 0: bp["level"] = 0`. `max(0, ...)`.

fn bp_new(high_watermark: int, low_watermark: int) -> dict
    {"high": high_watermark, "low": low_watermark, "level": 0, "paused": 0, "pause_count": 0, "resume_count": 0}

fn bp_produce(bp: dict, amount: int) -> dict
    bp["level"] += amount
    if bp["level"] >= bp["high"] and bp["paused"] == 0
        bp["paused"] = 1
        bp["pause_count"] += 1
    bp

fn bp_consume(bp: dict, amount: int) -> dict
    bp["level"] = max(0, bp["level"] - amount)
    if bp["level"] <= bp["low"] and bp["paused"] == 1
        bp["paused"] = 0
        bp["resume_count"] += 1
    bp

fn bp_is_paused(bp: dict) -> int
    bp["paused"]

fn bp_level(bp: dict) -> int
    bp["level"]

fn bp_utilization(bp: dict) -> int
    0 if bp["high"] == 0 else bp["level"] * 100 / bp["high"]

fn bp_pause_count(bp: dict) -> int
    bp["pause_count"]

fn bp_resume_count(bp: dict) -> int
    bp["resume_count"]
