// forge_request_context — Per-request context bag (key-value store with metadata).

fn ctx_new(request_id: string) -> dict
    let c = {}
    c["request_id"] = request_id
    c["values"] = {}
    c["start_time"] = 0
    c["cancelled"] = 0
    c

fn ctx_set(c: dict, key: string, value: string) -> dict
    c["values"][key] = value
    c

fn ctx_get(c: dict, key: string) -> string
    let has = contains(c["values"], key)
    if has != true
        return ""
    c["values"][key]

fn ctx_has(c: dict, key: string) -> int
    let has = contains(c["values"], key)
    if has == true
        return 1
    0

fn ctx_request_id(c: dict) -> string
    c["request_id"]

fn ctx_cancel(c: dict) -> dict
    c["cancelled"] = 1
    c

fn ctx_is_cancelled(c: dict) -> int
    c["cancelled"]

fn ctx_set_start(c: dict, t: int) -> dict
    c["start_time"] = t
    c

fn ctx_elapsed(c: dict, now: int) -> int
    now - c["start_time"]

fn ctx_size(c: dict) -> int
    len(keys(c["values"]))
