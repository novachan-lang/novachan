// forge_rsa — RSA PKCS#1 v1.5 SHA-256 signature VERIFY (e=65537). Big integers as base-2^16 LE limb lists,
// reusing forge_crypto's _p_* helpers. Verify-only: s^e mod n is ~17 modmuls (e=65537); signing with a
// 2048-bit private exponent is intentionally out of scope (too slow in the list bigint).
import forge_crypto

// big-endian bytes -> LE 16-bit limb list
fn rsa_be_to_num(b) -> list
    let f = []
    let i = len(b) - 1
    while i >= 0
        let lo = b[i]
        let hi = 0
        if i - 1 >= 0
            hi = b[i - 1]
        push(f, lo | (hi << 8))
        i = i - 2
    f

// LE limb list -> k big-endian bytes
fn rsa_num_to_be(v, k: int) -> list
    let out = []
    let j = 0
    while j < k
        let sig = k - 1 - j
        let li = sig / 2
        let limb = 0
        if li < len(v)
            limb = v[li]
        if (sig & 1) == 0
            push(out, limb & 255)
        else
            push(out, (limb >> 8) & 255)
        j = j + 1
    out

// x mod m by binary long division (m a limb list); result < m
fn rsa_mod(x, m) -> list
    let xn = _p_norm(x)
    let nbits = len(xn) * 16
    let rem = []
    push(rem, 0)
    let i = nbits - 1
    while i >= 0
        rem = _shl1(rem)
        let bit = (xn[i / 16] >> (i & 15)) & 1
        if bit == 1
            rem[0] = rem[0] | 1
        if _p_cmp(rem, m) >= 0
            rem = _p_sub(rem, m)
        i = i - 1
    rem

// base^e mod m, e given as a limb list scanned over ebits bits (MSB first)
fn rsa_modexp(base, e, m, ebits: int) -> list
    let result = []
    push(result, 1)
    let i = ebits - 1
    while i >= 0
        result = rsa_mod(_p_mul(result, result), m)
        let bit = (e[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = rsa_mod(_p_mul(result, base), m)
        i = i - 1
    result

// RSASSA-PKCS1-v1_5 verify with SHA-256 and e=65537.
// n_bytes/sig_bytes are big-endian (k = modulus byte length); hash_bytes is the 32-byte SHA-256 of the message.
fn rsa_pkcs1_sha256_verify(n_bytes, hash_bytes, sig_bytes) -> int
    let n = rsa_be_to_num(n_bytes)
    let sig = rsa_be_to_num(sig_bytes)
    let e = []
    push(e, 1)
    push(e, 1)
    let m = rsa_modexp(sig, e, n, 17)
    let k = len(n_bytes)
    let em = rsa_num_to_be(m, k)
    if em[0] != 0
        return 0
    if em[1] != 1
        return 0
    if em[k - 52] != 0
        return 0
    let i = 2
    while i < k - 52
        if em[i] != 255
            return 0
        i = i + 1
    let di = []
    push(di, 48)
    push(di, 49)
    push(di, 48)
    push(di, 13)
    push(di, 6)
    push(di, 9)
    push(di, 96)
    push(di, 134)
    push(di, 72)
    push(di, 1)
    push(di, 101)
    push(di, 3)
    push(di, 4)
    push(di, 2)
    push(di, 1)
    push(di, 5)
    push(di, 0)
    push(di, 4)
    push(di, 32)
    let j = 0
    while j < 19
        if em[k - 51 + j] != di[j]
            return 0
        j = j + 1
    let h = 0
    while h < 32
        if em[k - 32 + h] != hash_bytes[h]
            return 0
        h = h + 1
    1

// MGF1 with SHA-256 (RFC 8017): mask of `masklen` bytes from `seed`.
fn _rsa_mgf1(seed, masklen: int) -> list
    let out = []
    let counter = 0
    while len(out) < masklen
        let inp = []
        let i = 0
        while i < len(seed)
            push(inp, seed[i])
            i = i + 1
        push(inp, (counter >> 24) & 255)
        push(inp, (counter >> 16) & 255)
        push(inp, (counter >> 8) & 255)
        push(inp, counter & 255)
        let h = sha256_bytes(inp)
        let j = 0
        while j < 32 and len(out) < masklen
            push(out, h[j])
            j = j + 1
        counter = counter + 1
    out

// RSASSA-PSS verify with SHA-256 / MGF1-SHA-256 / salt length 32 (TLS 1.3 rsa_pss_rsae_sha256), e=65537.
// n_bytes/sig_bytes big-endian; mhash = the 32-byte SHA-256 of the signed message.
fn rsa_pss_sha256_verify(n_bytes, mhash, sig_bytes) -> int
    let n = rsa_be_to_num(n_bytes)
    let sig = rsa_be_to_num(sig_bytes)
    let e = []
    push(e, 1)
    push(e, 1)
    let m = rsa_modexp(sig, e, n, 17)
    let k = len(n_bytes)
    let em = rsa_num_to_be(m, k)
    let hlen = 32
    let slen = 32
    // trailer 0xbc and the single high bit (8*emLen - emBits = 1 for 2048-bit) must be clear
    if em[k - 1] != 188
        return 0
    if (em[0] & 128) != 0
        return 0
    let dblen = k - hlen - 1
    let hh = []
    let i = 0
    while i < hlen
        push(hh, em[dblen + i])
        i = i + 1
    let dbmask = _rsa_mgf1(hh, dblen)
    let db = []
    let j = 0
    while j < dblen
        push(db, em[j] ^ dbmask[j])
        j = j + 1
    db[0] = db[0] & 127
    let ps = dblen - slen - 1
    let p = 0
    while p < ps
        if db[p] != 0
            return 0
        p = p + 1
    if db[ps] != 1
        return 0
    let salt = []
    let s = 0
    while s < slen
        push(salt, db[ps + 1 + s])
        s = s + 1
    let mp = []
    let z = 0
    while z < 8
        push(mp, 0)
        z = z + 1
    let a = 0
    while a < len(mhash)
        push(mp, mhash[a])
        a = a + 1
    let b = 0
    while b < slen
        push(mp, salt[b])
        b = b + 1
    let hp = sha256_bytes(mp)
    let diff = 0
    let q = 0
    while q < hlen
        diff = diff | (hp[q] ^ hh[q])
        q = q + 1
    if diff != 0
        return 0
    1
