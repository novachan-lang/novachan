// forge_template_engine — Simple template rendering with Result.

fn te_new() -> dict
    let t = {}
    t["templates"] = {}
    t["count"] = 0
    t["renders"] = 0
    t

fn te_register(t: dict, name: string, body: string) -> dict
    t["templates"][name] = body
    t["count"] = t["count"] + 1
    t

fn te_is_var_char(ch: string) -> int
    if ch >= "a"
        if ch <= "z"
            return 1
    if ch >= "A"
        if ch <= "Z"
            return 1
    if ch >= "0"
        if ch <= "9"
            return 1
    if ch == "_"
        return 1
    0

fn te_render(t: dict, name: string, vars: dict) -> Result
    let has = contains(t["templates"], name)
    if has != true
        return err("template not found: " + name)
    let body = t["templates"][name]
    let result = ""
    let i = 0
    while i < len(body)
        if body[i] == "$"
            let varname = ""
            i = i + 1
            while i < len(body)
                if te_is_var_char(body[i]) == 1
                    varname = varname + body[i]
                    i = i + 1
                else
                    break
            let has_var = contains(vars, varname)
            if has_var == true
                result = result + vars[varname]
            else
                result = result + "$" + varname
        else
            result = result + body[i]
            i = i + 1
    t["renders"] = t["renders"] + 1
    ok(result)

fn te_count(t: dict) -> int
    t["count"]

fn te_total_renders(t: dict) -> int
    t["renders"]
