// forge_template_engine -- thin wrapper over std/text/template_engine (canonical implementation).
import std/text/template_engine

fn te_new() -> dict
    {"templates": {}, "count": 0, "renders": 0}

fn te_register(t: dict, name: string, body: string) -> dict
    t["templates"][name] = body
    t["count"] += 1
    t

fn te_is_var_char(ch: string) -> int
    if ch >= "a"
        if ch <= "z"
            return 1
    if ch >= "A"
        if ch <= "Z"
            return 1
    if ch >= "0"
        if ch <= "9"
            return 1
    if ch == "_"
        return 1
    0

fn te_render(t: dict, name: string, vars: dict) -> Result
    return tme_render(t, name, vars)

fn te_count(t: dict) -> int
    t["count"]

fn te_total_renders(t: dict) -> int
    t["renders"]

