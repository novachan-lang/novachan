// forge_template_engine — Simple template rendering with Result.

fn te_new() -> dict
    {"templates": {}, "count": 0, "renders": 0}

fn te_register(t: dict, name: string, body: string) -> dict
    t["templates"][name] = body
    t["count"] += 1
    t

fn te_is_var_char(ch: string) -> int
    if ch >= "a"
        if ch <= "z"
            return 1
    if ch >= "A"
        if ch <= "Z"
            return 1
    if ch >= "0"
        if ch <= "9"
            return 1
    if ch == "_"
        return 1
    0

fn te_render(t: dict, name: string, vars: dict) -> Result
    if name not in t["templates"]
        return err("template not found: {name}")
    let body = t["templates"][name]
    let result_parts = []
    let i = 0
    while i < len(body)
        if body[i] == "$"
            let varname = ""
            i += 1
            while i < len(body)
                if te_is_var_char(body[i]) == 1
                    varname += body[i]
                    i += 1
                else
                    break
            if varname in vars
                push(result_parts, vars[varname])
            else
                push(result_parts, "${varname}")
        else
            push(result_parts, body[i])
            i += 1
    let result = join(result_parts, "")
    t["renders"] += 1
    ok(result)

fn te_count(t: dict) -> int
    t["count"]

fn te_total_renders(t: dict) -> int
    t["renders"]
