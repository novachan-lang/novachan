// forge_semaphore — Counting semaphore for resource limiting.

fn sem_new(permits: int) -> dict
    let s = {}
    s["max_permits"] = permits
    s["available"] = permits
    s["waiters"] = 0
    s["acquires"] = 0
    s["releases"] = 0
    s

fn sem_try_acquire(s: dict) -> dict
    let result = {}
    if s["available"] > 0
        s["available"] = s["available"] - 1
        s["acquires"] = s["acquires"] + 1
        result["acquired"] = 1
    else
        s["waiters"] = s["waiters"] + 1
        result["acquired"] = 0
    result["s"] = s
    result

fn sem_release(s: dict) -> dict
    if s["available"] < s["max_permits"]
        s["available"] = s["available"] + 1
        s["releases"] = s["releases"] + 1
    s

fn sem_available(s: dict) -> int
    s["available"]

fn sem_max_permits(s: dict) -> int
    s["max_permits"]

fn sem_total_acquires(s: dict) -> int
    s["acquires"]

fn sem_total_releases(s: dict) -> int
    s["releases"]

fn sem_waiter_count(s: dict) -> int
    s["waiters"]
