// forge_cosine -- cosine similarity between two documents represented as token lists. This is the relevance/
// similarity score at the end of the search-indexing pipeline (forge_tokenize -> forge_stemmer -> here): each
// document becomes a term-frequency vector, and cosine similarity = (A . B) / (|A| |B|) measures how aligned
// they are, from 1.0 (identical term mix) to 0.0 (no shared terms), independent of document length. Used for
// "more like this", near-duplicate detection, and clustering. LEAF -- imports NOTHING (uses sqrt).
//
// NOTE: the vector norms compute the sum-of-squares into a `let` accumulator BEFORE sqrt -- a bare
// `sqrt(big-inline-sum)` return hits a NOVA float-return codegen edge (see the memory note); the accumulator
// form is sound.

// PRIVATE: term-frequency dict for a token list (term -> count).
fn _cos_tf(tokens: list) -> dict
    let d = {}
    let i = 0
    while i < len(tokens)
        let t = tokens[i]
        if contains(d, t)
            d[t] = d[t] + 1
        else
            d[t] = 1
        i = i + 1
    d

// Cosine similarity of two token lists in [0.0, 1.0]. Returns 0.0 if either document is empty.
fn cosine_similarity(a: list, b: list) -> float
    let ta = _cos_tf(a)
    let tb = _cos_tf(b)
    let ka = keys(ta)
    let kb = keys(tb)
    // dot product over shared terms
    let dot = 0.0
    let i = 0
    while i < len(ka)
        let t = ka[i]
        if contains(tb, t)
            dot = dot + (ta[t] * 1.0) * (tb[t] * 1.0)
        i = i + 1
    // squared norms (accumulate, then sqrt)
    let sa = 0.0
    let j = 0
    while j < len(ka)
        let va = ta[ka[j]] * 1.0
        sa = sa + va * va
        j = j + 1
    let sb = 0.0
    let k = 0
    while k < len(kb)
        let vb = tb[kb[k]] * 1.0
        sb = sb + vb * vb
        k = k + 1
    let na = sqrt(sa)
    let nb = sqrt(sb)
    if na == 0.0 or nb == 0.0
        return 0.0
    dot / (na * nb)
