// forge_utm -- UTM campaign-parameter parsing + building (marketing attribution: which source/medium/campaign
// drove a visit). Parse a URL query into the standard utm_* fields (prefix stripped); build a campaign-tagged
// URL. The bookkeeping every analytics/attribution pipeline needs. LEAF -- imports NOTHING.

// Parse "utm_source=google&utm_medium=cpc&utm_campaign=spring" -> dict {source, medium, campaign, ...}.
fn utm_parse(query: string) -> dict
    let out = {}
    if len(query) == 0
        return out
    let q = query
    if starts_with(q, "?")
        q = slice(q, 1, len(q))
    let parts = split(q, "&")
    for i in 0..len(parts)
        let p = parts[i]
        let eq = find(p, "=")
        if eq > 0
            let k = slice(p, 0, eq)
            if starts_with(k, "utm_")
                out[slice(k, 4, len(k))] = slice(p, eq + 1, len(p))
    out

// Build a campaign-tagged URL from a base + the core utm fields.
fn utm_build(base_url: string, source: string, medium: string, campaign: string) -> string
    let sep = "?"
    if find(base_url, "?") >= 0
        sep = "&"
    base_url + sep + "utm_source=" + source + "&utm_medium=" + medium + "&utm_campaign=" + campaign

// Convenience: the source (or "" if absent) from a parsed utm dict.
fn utm_source(utm: dict) -> string
    if "source" in utm
        return utm["source"]
    ""
