// forge_query_canon -- canonicalize a URL query string by sorting its parameters, so "?b=2&a=1" and "?a=1&b=2"
// produce the SAME canonical form. For cache keys, request signatures (SigV4-style canonical query), dedup, and
// canonical URLs. Complements forge_qs. LEAF -- imports NOTHING.

// Sort the "k=v&k2=v2" pairs (by their k=v string, so key-primary) -> a stable canonical query string.
fn query_canon(query: string) -> string
    let q = query
    if starts_with(q, "?")
        q = slice(q, 1, len(q))
    if len(q) == 0
        return ""
    let pairs = split(q, "&")
    let sorted = []
    let i = 0
    while i < len(pairs)
        let v = pairs[i]
        push(sorted, v)
        let j = len(sorted) - 1
        while j > 0 and sorted[j - 1] > v
            sorted[j] = sorted[j - 1]
            j = j - 1
        sorted[j] = v
        i = i + 1
    let out = ""
    let k = 0
    while k < len(sorted)
        if k > 0
            out = out + "&"
        out = out + sorted[k]
        k = k + 1
    out

// Do two query strings canonicalize to the same thing (order-insensitive equality)?
fn query_equal(a: string, b: string) -> bool
    query_canon(a) == query_canon(b)
