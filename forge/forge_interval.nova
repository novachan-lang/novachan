// forge_interval -- operations on INTEGER intervals [start, end] (inclusive): merge overlapping ranges,
// insert-and-coalesce, test overlap/containment, intersect, measure total coverage, and find the free GAPS
// in a window. This is the toolkit behind calendars and booking systems (which meeting slots are free?),
// resource scheduling, rate/time windows, byte-range requests (HTTP Range), line-range annotations, and any
// "merge overlapping ranges" task. Intervals are 2-element lists [start, end] with start <= end; two touching
// integer ranges ([0,30] and [30,60]) coalesce (they share the endpoint). Values are INTEGERS (timestamps,
// minutes, indices, byte offsets) -- float intervals would hit NOVA's float-var-vs-int compare caveat, so
// keep endpoints integer. LEAF -- imports NOTHING.

// PRIVATE: insertion sort a list of [start,end] intervals by start ascending (n is small for typical use).
fn _iv_sort(ivs: list) -> list
    let out = []
    let i = 0
    while i < len(ivs)
        push(out, ivs[i])
        i = i + 1
    let a = 1
    while a < len(out)
        let cur = out[a]
        let b = a - 1
        while b >= 0 and out[b][0] > cur[0]
            out[b + 1] = out[b]
            b = b - 1
        out[b + 1] = cur
        a = a + 1
    out

// True if intervals a and b share any point (inclusive endpoints).
fn interval_overlaps(a: list, b: list) -> bool
    a[0] <= b[1] and b[0] <= a[1]

// True if point p lies within [iv.start, iv.end] inclusive.
fn interval_contains(iv: list, p: int) -> bool
    p >= iv[0] and p <= iv[1]

// The overlapping region of a and b as [start, end], or null if they do not overlap.
fn interval_intersect(a: list, b: list)
    let r = null
    if a[0] <= b[1] and b[0] <= a[1]
        let s = a[0]
        if b[0] > s
            s = b[0]
        let e = a[1]
        if b[1] < e
            e = b[1]
        r = [s, e]
    r

// Merge a list of intervals into the minimal set of disjoint intervals, sorted by start.
// Touching integer ranges coalesce ([1,3] + [3,5] -> [1,5]).
fn interval_merge(ivs: list) -> list
    let out = []
    if len(ivs) == 0
        return out
    let sorted = _iv_sort(ivs)
    let cur = [sorted[0][0], sorted[0][1]]
    let i = 1
    while i < len(sorted)
        let nx = sorted[i]
        if nx[0] <= cur[1]
            // overlap or touch -> extend the current run
            if nx[1] > cur[1]
                cur[1] = nx[1]
        else
            push(out, cur)
            cur = [nx[0], nx[1]]
        i = i + 1
    push(out, cur)
    out

// Insert one interval into a set and return the re-merged disjoint set.
fn interval_insert(ivs: list, iv: list) -> list
    let all = []
    let i = 0
    while i < len(ivs)
        push(all, ivs[i])
        i = i + 1
    push(all, iv)
    interval_merge(all)

// Total number of integer points covered by the union of the intervals (double-counting removed via merge).
// For [start,end] inclusive, one interval covers (end - start + 1) points.
fn interval_total_coverage(ivs: list) -> int
    let merged = interval_merge(ivs)
    let total = 0
    let i = 0
    while i < len(merged)
        total = total + (merged[i][1] - merged[i][0] + 1)
        i = i + 1
    total

// The free GAPS (uncovered [start,end] ranges) inside the window [lo, hi], given busy intervals.
// Returns disjoint gap intervals in order; empty list if the window is fully covered.
fn interval_gaps(ivs: list, lo: int, hi: int) -> list
    let gaps = []
    let merged = interval_merge(ivs)
    let cursor = lo
    let i = 0
    while i < len(merged)
        let s = merged[i][0]
        let e = merged[i][1]
        if e >= lo and s <= hi
            if s > cursor
                push(gaps, [cursor, s - 1])
            if e + 1 > cursor
                cursor = e + 1
        i = i + 1
    if cursor <= hi
        push(gaps, [cursor, hi])
    gaps
