// forge_lzw -- LZW (Lempel-Ziv-Welch) dictionary compression, the algorithm inside GIF, TIFF, PDF and the old
// Unix `compress`. Where run-length encoding (forge_runlength) only collapses repeats of ONE character, LZW finds
// repeated SUBSTRINGS: it builds a dictionary of sequences it has seen on the fly, so the second time a phrase
// appears it is sent as a single code. Both encoder and decoder grow the SAME dictionary from the data itself, so
// no table needs to be transmitted -- the decoder reconstructs it as it goes (including the famous "KwKwK" edge
// case where a code is used the instant before it is defined). It compresses text, logs, and structured data with
// repeated tokens far better than RLE. Encoding turns a string into a list of integer codes; decoding turns them
// back. The dictionary is seeded with the 256 single-byte values. (NUL bytes aren't supported -- see the string
// NUL note; use forge on ordinary text/UTF-8.) LEAF -- imports NOTHING.

// Compress a string into a list of integer LZW codes. Codes 0..255 are single bytes; codes 256+ are learned
// multi-character sequences.
fn lzw_encode(s: string) -> list
    let dict = {}
    for i in 0..256
        dict[chr(i)] = i
    let next_code = 256
    let w = ""
    let result = []
    for p in 0..len(s)
        let c = char_at(s, p)
        let wc = w + c
        if wc in dict
            w = wc
        else
            push(result, dict[w])
            dict[wc] = next_code
            next_code += 1
            w = c
    if len(w) > 0
        push(result, dict[w])
    result

// Decompress a list of LZW codes back into the original string.
fn lzw_decode(codes: list) -> string
    let out = ""
    if len(codes) > 0
        let dict = {}
        for i in 0..256
            dict[str(i)] = chr(i)
        let next_code = 256
        let w = chr(codes[0])
        out = w
        for k in 1..len(codes)
            let code = codes[k]
            let entry = ""
            if contains(dict, str(code))
                entry = dict[str(code)]
            else
                // KwKwK case: the code is the one we are about to define
                entry = w + char_at(w, 0)
            out += entry
            dict[str(next_code)] = w + char_at(entry, 0)
            next_code += 1
            w = entry
    out

// The number of codes LZW produces for s (its compressed length in symbols). Lower is better compression.
fn lzw_compressed_size(s: string) -> int
    len(lzw_encode(s))
