// forge_lzw -- thin wrapper over std/compress/lzw (canonical implementation).
import std/compress/lzw

fn lzw_encode(s: string) -> list
    return lzw_compress(s)

fn lzw_decode(codes: list) -> string
    return lzw_decompress(codes)

fn lzw_compressed_size(s: string) -> int
    len(lzw_encode(s))

