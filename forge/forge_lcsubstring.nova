// forge_lcsubstring -- the Longest Common SUBSTRING of two strings: the longest run of characters that appears
// CONTIGUOUSLY in both. This is a different question from the longest common SUBSEQUENCE (which may skip
// characters): here the match must be an unbroken stretch, so "abcdef" and "zabcf" share "abc" (length 3), not a
// scattered subsequence. The dynamic program is a clean O(n*m) grid: dp[i][j] is the length of the common
// substring ENDING at a[i-1] and b[j-1] -- if those characters match, extend the diagonal (dp[i-1][j-1] + 1),
// otherwise the run breaks and it resets to 0 -- and the answer is the largest value anywhere in the grid. It's a
// core similarity/overlap primitive: near-duplicate and plagiarism detection, finding the shared portion of two
// filenames/URLs/DNA reads, fuzzy joins, and diff/merge heuristics. Returns both the length and the actual shared
// substring. LEAF -- imports NOTHING.

// The length of the longest common substring (contiguous) of a and b. O(n*m) dynamic program.
fn longest_common_substring(a: string, b: string) -> int
    let n = len(a)
    let m = len(b)
    let best = 0
    if n > 0 and m > 0
        let w = m + 1
        let dp = []
        let z = 0
        while z < (n + 1) * w
            push(dp, 0)
            z = z + 1
        let i = 1
        while i <= n
            let j = 1
            while j <= m
                if char_at(a, i - 1) == char_at(b, j - 1)
                    let v = dp[(i - 1) * w + (j - 1)] + 1
                    dp[i * w + j] = v
                    if v > best
                        best = v
                j = j + 1
            i = i + 1
    best

// The actual longest common substring text (the FIRST one, on ties), or "" if none.
fn longest_common_substring_str(a: string, b: string) -> string
    let n = len(a)
    let m = len(b)
    let best = 0
    let end_i = 0
    if n > 0 and m > 0
        let w = m + 1
        let dp = []
        let z = 0
        while z < (n + 1) * w
            push(dp, 0)
            z = z + 1
        let i = 1
        while i <= n
            let j = 1
            while j <= m
                if char_at(a, i - 1) == char_at(b, j - 1)
                    let v = dp[(i - 1) * w + (j - 1)] + 1
                    dp[i * w + j] = v
                    if v > best
                        best = v
                        end_i = i
                j = j + 1
            i = i + 1
    slice(a, end_i - best, end_i)
