// forge_deadletter — Dead letter queue.
// Failed messages go here for inspection, retry, or discard.

fn dlq_new(max_retries: int) -> dict
    let dlq = {}
    dlq["messages"] = []
    dlq["max_retries"] = max_retries
    dlq["discarded"] = 0
    dlq

fn dlq_add(dlq: dict, msg_id: string, payload: string, error: string) -> dict
    let m = {}
    m["id"] = msg_id
    m["payload"] = payload
    m["error"] = error
    m["retries"] = 0
    m["status"] = "pending"
    push(dlq["messages"], m)
    dlq

fn dlq_retry(dlq: dict, msg_id: string) -> dict
    let i = 0
    while i < len(dlq["messages"])
        if dlq["messages"][i]["id"] == msg_id
            if dlq["messages"][i]["retries"] < dlq["max_retries"]
                dlq["messages"][i]["retries"] = dlq["messages"][i]["retries"] + 1
                dlq["messages"][i]["status"] = "retried"
                return dlq
            else
                dlq["messages"][i]["status"] = "exhausted"
                return dlq
        i += 1
    dlq

fn dlq_discard(dlq: dict, msg_id: string) -> dict
    let new_msgs = []
    let i = 0
    while i < len(dlq["messages"])
        if dlq["messages"][i]["id"] != msg_id
            push(new_msgs, dlq["messages"][i])
        else
            dlq["discarded"] = dlq["discarded"] + 1
        i += 1
    dlq["messages"] = new_msgs
    dlq

fn dlq_count(dlq: dict) -> int
    len(dlq["messages"])

fn dlq_pending_count(dlq: dict) -> int
    let count = 0
    let i = 0
    while i < len(dlq["messages"])
        if dlq["messages"][i]["status"] == "pending"
            count += 1
        i += 1
    count

fn dlq_get(dlq: dict, msg_id: string) -> dict
    let i = 0
    while i < len(dlq["messages"])
        if dlq["messages"][i]["id"] == msg_id
            return dlq["messages"][i]
        i += 1
    let empty = {}
    empty["id"] = ""
    empty

fn dlq_total_discarded(dlq: dict) -> int
    dlq["discarded"]
