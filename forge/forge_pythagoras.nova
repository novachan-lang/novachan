// forge_pythagoras -- generate Pythagorean triples: whole-number side lengths (a,b,c) of a right triangle, where
// a*a + b*b = c*c. Rather than the O(limit^2) brute search of testing every pair, this uses Euclid's parametric
// formula, which produces each PRIMITIVE triple exactly once from two seed integers m > n: a = m*m - n*n,
// b = 2*m*n, c = m*m + n*n (primitive when m,n are coprime and of opposite parity). Every other triple is a whole
// multiple of a primitive one, so scaling fills in the rest. Triples show up in construction and layout (exact
// right angles without measuring), computer graphics (integer-exact distances), number-theory exercises, lattice
// geometry, and puzzle generation. pythagorean_triples returns every triple up to a hypotenuse limit; the
// primitive variant returns only the "irreducible" ones (a,b,c share no common factor). Output is a FLAT list
// [a0,b0,c0, a1,b1,c1, ...] with a < b < c, sorted by (c, b, a) -- flat and int-sorted to sidestep any
// list-of-lists sorting hazard. Integers only. LEAF -- imports NOTHING.

// PRIVATE: gcd (non-negative).
fn _py_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = -x
    x

// True if a*a + b*b == c*c with all sides positive (a valid right-triangle side triple).
fn is_pythagorean(a: int, b: int, c: int) -> bool
    a > 0 and b > 0 and c > 0 and a * a + b * b == c * c

// PRIVATE: insertion-sort an integer list ascending in place, returning it.
fn _py_sort(keys: list) -> list
    let n = len(keys)
    for i in 1..n
        let kv = keys[i]
        let j = i - 1
        while j >= 0 and keys[j] > kv
            keys[j + 1] = keys[j]
            j -= 1
        keys[j + 1] = kv
    keys

// PRIVATE: decode sorted composite keys (c*big + b)*big + a into a flat [a,b,c,...] list.
fn _py_decode(keys: list, big: int) -> list
    let out = []
    for z in 0..len(keys)
        let key = keys[z]
        let a = key % big
        let rest = key / big
        let b = rest % big
        let c = rest / big
        push(out, a)
        push(out, b)
        push(out, c)
    out

// PRIVATE: core generator. If primitive_only is true, emit only primitive triples (k=1); else all scalings.
fn _py_gen(max_c: int, primitive_only: bool) -> list
    let keys = []
    let big = max_c + 1
    let m = 2
    while m * m < max_c
        for n in 1..m
            if ((m - n) % 2 == 1) and _py_gcd(m, n) == 1
                let a0 = m * m - n * n
                let b0 = 2 * m * n
                let c0 = m * m + n * n
                let k = 1
                while k * c0 <= max_c
                    let a = k * a0
                    let b = k * b0
                    let c = k * c0
                    let lo = a
                    let hi = b
                    if lo > hi
                        lo = b
                        hi = a
                    let key = (c * big + hi) * big + lo
                    push(keys, key)
                    if primitive_only
                        k = max_c + 1
                    else
                        k += 1
        m += 1
    _py_decode(_py_sort(keys), big)

// Every Pythagorean triple with hypotenuse c <= max_c, as a flat list [a,b,c,...] with a < b < c, sorted by
// (c, b, a). Includes both primitive triples and their multiples (so 3,4,5 and 6,8,10 both appear).
fn pythagorean_triples(max_c: int) -> list
    _py_gen(max_c, false)

// Only the PRIMITIVE Pythagorean triples with c <= max_c (those whose three sides share no common factor), as a
// flat list [a,b,c,...] with a < b < c, sorted by (c, b, a).
fn primitive_pythagorean_triples(max_c: int) -> list
    _py_gen(max_c, true)
