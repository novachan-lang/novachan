// forge_changelog_gen — Auto changelog generation.
// Categorize commits, generate release notes, semantic versioning.

fn cg_new(version: string) -> dict
    let cg = {}
    cg["version"] = version
    cg["entries"] = []
    cg["categories"] = {}
    cg

fn cg_add_entry(cg: dict, category: string, message: string, author: string) -> dict
    let entry = {}
    entry["category"] = category
    entry["message"] = message
    entry["author"] = author
    push(cg["entries"], entry)
    let has = contains(cg["categories"], category)
    if has != true
        cg["categories"][category] = 0
    cg["categories"][category] = cg["categories"][category] + 1
    cg

fn cg_entry_count(cg: dict) -> int
    len(cg["entries"])

fn cg_by_category(cg: dict, category: string) -> list
    let result = []
    let i = 0
    while i < len(cg["entries"])
        if cg["entries"][i]["category"] == category
            push(result, cg["entries"][i])
        i = i + 1
    result

fn cg_categories(cg: dict) -> list
    keys(cg["categories"])

fn cg_render(cg: dict) -> string
    let out = "# " + cg["version"] + "\n"
    let cats = keys(cg["categories"])
    let ci = 0
    while ci < len(cats)
        let cat = cats[ci]
        out = out + "\n## " + cat + "\n"
        let entries = cg_by_category(cg, cat)
        let ei = 0
        while ei < len(entries)
            out = out + "- " + entries[ei]["message"] + " (" + entries[ei]["author"] + ")\n"
            ei = ei + 1
        ci = ci + 1
    out

fn cg_has_breaking(cg: dict) -> int
    let has = contains(cg["categories"], "breaking")
    if has == true
        return 1
    0

fn cg_suggest_bump(cg: dict) -> string
    if cg_has_breaking(cg) == 1
        return "major"
    let has_feat = contains(cg["categories"], "feat")
    if has_feat == true
        return "minor"
    "patch"
