// forge_barrier — Synchronization barrier for N parties.

fn bar_new(parties: int) -> dict
    let b = {}
    b["parties"] = parties
    b["arrived"] = 0
    b["generation"] = 0
    b["broken"] = 0
    b

fn bar_arrive(b: dict) -> dict
    let result = {}
    b["arrived"] = b["arrived"] + 1
    if b["arrived"] >= b["parties"]
        b["generation"] = b["generation"] + 1
        b["arrived"] = 0
        result["released"] = 1
    else
        result["released"] = 0
    result["b"] = b
    result

fn bar_arrived_count(b: dict) -> int
    b["arrived"]

fn bar_parties(b: dict) -> int
    b["parties"]

fn bar_generation(b: dict) -> int
    b["generation"]

fn bar_remaining(b: dict) -> int
    b["parties"] - b["arrived"]

fn bar_break(b: dict) -> dict
    b["broken"] = 1
    b

fn bar_is_broken(b: dict) -> int
    b["broken"]

fn bar_reset(b: dict) -> dict
    b["arrived"] = 0
    b["broken"] = 0
    b
