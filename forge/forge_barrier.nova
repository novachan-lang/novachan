// forge_barrier — Synchronization barrier for N parties.
//
// RAISED 2026-08-05. Three problems:
//
//   1. bar_new built the state dict as four individual assignments. Dict literal.
//   2. bar_arrive built the result dict incrementally + used `b["x"] = b["x"] + 1`. Dict literal + compound `+=`.
//   3. bar_arrive had implicit flow merging result["released"] across both branches. Explicit dict returns.

fn bar_new(parties: int) -> dict
    {"parties": parties, "arrived": 0, "generation": 0, "broken": 0}

fn bar_arrive(b: dict) -> dict
    b["arrived"] += 1
    if b["arrived"] >= b["parties"]
        b["generation"] += 1
        b["arrived"] = 0
        return {"released": 1, "b": b}
    {"released": 0, "b": b}

fn bar_arrived_count(b: dict) -> int
    b["arrived"]

fn bar_parties(b: dict) -> int
    b["parties"]

fn bar_generation(b: dict) -> int
    b["generation"]

fn bar_remaining(b: dict) -> int
    b["parties"] - b["arrived"]

fn bar_break(b: dict) -> dict
    b["broken"] = 1
    b

fn bar_is_broken(b: dict) -> int
    b["broken"]

fn bar_reset(b: dict) -> dict
    b["arrived"] = 0
    b["broken"] = 0
    b
