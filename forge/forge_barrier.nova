// forge_barrier -- thin wrapper over std/concurrency/barrier (canonical implementation).
import std/concurrency/barrier

fn bar_new(parties: int) -> dict
    return br_new(parties)

fn bar_arrive(b: dict) -> dict
    return br_arrive(b)

fn bar_arrived_count(b: dict) -> int
    return br_count(b)

fn bar_parties(b: dict) -> int
    b["parties"]

fn bar_generation(b: dict) -> int
    b["generation"]

fn bar_remaining(b: dict) -> int
    b["parties"] - b["arrived"]

fn bar_break(b: dict) -> dict
    b["broken"] = 1
    b

fn bar_is_broken(b: dict) -> int
    b["broken"]

fn bar_reset(b: dict) -> dict
    return br_reset(b)

