// forge_changelog -- build a Keep-a-Changelog CHANGELOG.md section (release-notes tooling, paired with
// forge_semver_bump). Collect entries under the standard categories (Added/Changed/Deprecated/Removed/Fixed/
// Security) and render a versioned markdown section with only the non-empty subsections. LEAF -- imports NOTHING.

fn changelog_new() -> dict
    {"Added": [], "Changed": [], "Deprecated": [], "Removed": [], "Fixed": [], "Security": []}

// Add an entry under a category. Fluent.
fn changelog_add(c: dict, category: string, entry: string) -> dict
    if category in c
        push(c[category], entry)
    c

// Render "## [version] - date" + each non-empty "### Category" with "- entry" bullets.
fn changelog_render(c: dict, version: string, date: string) -> string
    let nl = chr(10)
    let out = "## [{version}] - {date}" + nl
    let cats = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
    for cat in cats
        let entries = c[cat]
        if len(entries) > 0
            out += nl + "### {cat}" + nl
            for entry in entries
                out += "- {entry}" + nl
    out
