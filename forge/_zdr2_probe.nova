// PROVE: on_exit_send registration + bare `send` (no cancel_on_exit_val) => DOUBLE RELEASE at task exit
fn acquire_to(pool, ms: int) -> any
    let r = select_timeout(pool, ms)
    if r[0] == 0
        on_exit_send(pool, r[1])
        return ok(r[1])
    err("pool acquire timeout")

fn borrow_wrong(pool) -> int
    let r = acquire_to(pool, 1000)
    if is_err(r)
        return 0 - 1
    let c = unwrap(r)
    // exactly what forge_orm.orm_all / orm_exec do: bare send, no cancel_on_exit_val
    send(pool, c)
    c

fn worker(pool, done)
    borrow_wrong(pool)
    send(done, 1)

fn main()
    let pool = channel()
    send(pool, 111)
    send(pool, 222)
    print("pool starts with 2 connections: [111, 222]")
    let done = channel()
    spawn worker(pool, done)
    recv(done)
    let got = []
    let i = 0
    while i < 8
        let r = select_timeout(pool, 300)
        if r[0] != 0
            i = 99
        else
            push(got, r[1])
            i += 1
    print("after ONE task borrowed+released ONCE, pool contains:")
    print(got)
    print("count = {len(got)}  (expected 2)")
