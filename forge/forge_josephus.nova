// forge_josephus -- the Josephus problem: n people stand in a circle and, starting the count, every k-th person is
// eliminated until one remains -- who survives, and in what order does everyone go out? It's a classic with real
// uses: fair round-robin elimination and tournament seeding, choosing a leader by counting-out, deterministic load
// shedding / which connection to drop under a fixed rotation, and modeling any "skip k, remove, repeat" process.
// There are two views here. The survivor alone is found in O(n) with no simulation, via the elegant recurrence
// J(1)=0, J(i) = (J(i-1) + k) mod i -- each time you add a person, the answer just shifts by k around the new,
// larger circle. The full elimination ORDER is produced by directly simulating the circle. Positions are 0-based;
// k is the step (every k-th counted person is removed). LEAF -- imports NOTHING.

// The 0-based position of the sole survivor when every k-th person is eliminated from a circle of n. O(n), no
// simulation. josephus(7,3) = 3.
fn josephus(n: int, k: int) -> int
    let r = 0
    let i = 2
    while i <= n
        r = (r + k) % i
        i += 1
    r

// The full elimination order (0-based positions) as a list; the LAST element is the survivor. Simulates the
// circle directly.
fn josephus_order(n: int, k: int) -> list
    let people = [e for e in 0..n]
    let order = []
    let idx = 0
    while len(people) > 0
        idx = (idx + k - 1) % len(people)
        push(order, people[idx])
        // remove people[idx] by shifting left then popping
        let s = idx
        while s < len(people) - 1
            people[s] = people[s + 1]
            s += 1
        pop(people)
    order

// The survivor via full simulation (should equal josephus(n,k)); handy as a self-check and when you also want the
// order.
fn josephus_survivor_sim(n: int, k: int) -> int
    let order = josephus_order(n, k)
    let out = 0 - 1
    if len(order) > 0
        out = order[len(order) - 1]
    out
