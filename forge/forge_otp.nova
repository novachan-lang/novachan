// forge_otp -- OTP-style fault tolerance for Forge: supervisor trees, GenServers, agents, and
// background jobs, PROMOTED from NOVA's shipped runtime primitives (spawn, monitor, contained panic,
// channels). "Let it crash" with Erlang-class recovery -- at native (AOT) speed, no BEAM.
//
// Substrate (all shipped + tested by green_supervisor_test / supcrash_test / green_monitor_test):
//   spawn <call>          -> a process handle
//   monitor(p)            -> a channel that fires 0 (child exited normally) or 1 (child crashed/panic)
//   a panic is CONTAINED to its process (exit_status=1); it never takes down the supervisor
//   channel()/send/recv   -> the supervision rendezvous

// ── Supervisor ──────────────────────────────────────────────────────────────────────────────────
// Restart policies (per child): "permanent" (always restart), "transient" (restart only on a CRASH,
// not a normal exit), "temporary" (never restart). Strategy "one_for_one" restarts ONLY the failed
// child (one_for_all / rest_for_one land in T4.3). A Sup is an opaque dict handle (like the app object).

fn sup_new(strategy: string, max_restarts: int, in_seconds: int) -> any
    let s = {}
    s["strategy"] = strategy
    s["max_restarts"] = max_restarts
    s["in_seconds"] = in_seconds
    s["specs"] = []
    s

// Add a child spec: name, a NO-ARG start_fn (the child's entry point), restart policy, and a
// shutdown budget (ms, advisory -- NOVA has no preemptive kill, so it bounds a cooperative drain
// only). Returns the new child count.
fn child_add(sup, name: string, start_fn, restart: string, shutdown_ms: int) -> int
    let specs = sup["specs"]
    push(specs, [name, start_fn, restart, shutdown_ms])
    sup["specs"] = specs
    len(specs)

fn sup_child_count(sup) -> int
    len(sup["specs"])

// Runs a child's start_fn. MUST be a top-level named fn spawned DIRECTLY (`spawn _run_child(f)`):
// from a SPAWNED process (the supervision loop is itself spawned), `spawn fn() f()` (a closure form)
// does NOT deliver the child's monitor signal, but `spawn named_fn(args)` does (the same reason
// dispatch_safe uses `spawn _dispatch_run(args)`). Spawning a closure works only from the main task.
fn _run_child(start_fn)
    start_fn()

// one_for_one supervision of ONE child (each child gets its own independent supervision loop):
// spawn -> monitor -> on exit, decide by (exit kind, policy). A CRASH restarts permanent+transient;
// a NORMAL exit restarts only permanent (transient/temporary retire); temporary never restarts.
// Exceeding max_restarts retires the child (a simple intensity cap; T4.4 adds the time window).
// Windowed restart intensity (T4.4): true when MORE THAN max_restarts of the given restart timestamps
// fall within window_ms of now -> a crash LOOP. Occasional crashes spread over time stay under the
// limit (each ages out of the window), so they restart indefinitely -- the correct OTP behaviour, and
// why this replaces a naive cumulative counter. Pure + public -> directly testable with a fake clock.
fn restart_intensity_exceeded(stamps, now_ms: int, max_restarts: int, window_ms: int) -> bool
    let count = 0
    let i = 0
    while i < len(stamps)
        if (now_ms - stamps[i]) <= window_ms
            count = count + 1
        i = i + 1
    count > max_restarts

fn _supervise_one(sup, idx)
    let spec = sup["specs"][idx]
    let start_fn = spec[1]
    let restart = spec[2]
    let max_r = sup["max_restarts"]
    let window_ms = sup["in_seconds"] * 1000
    let stamps = []
    let running = 1
    while running == 1
        let p = spawn _run_child(start_fn)
        let m = monitor(p)
        let st = receive(m)
        let did_restart = 0
        if st == 0
            // normal exit: only a permanent child restarts
            if restart != "permanent"
                running = 0
            else
                did_restart = 1
        else
            // crash / panic (contained): permanent + transient restart; temporary never
            if restart == "temporary"
                running = 0
            else
                did_restart = 1
        if did_restart == 1
            push(stamps, time_ms())
            if restart_intensity_exceeded(stamps, time_ms(), max_r, window_ms)
                running = 0

// Start the supervisor: spawn an independent one_for_one supervision loop per child. Returns the
// child count. The supervisor itself never blocks the caller; the loops run until each child retires.
fn sup_start(sup) -> int
    let specs = sup["specs"]
    let n = len(specs)
    let i = 0
    while i < n
        spawn _supervise_one(sup, i)
        i = i + 1
    n

// ── GenServer (typed-message dispatch over a request channel) ─────────────────────────────────────
// A stateful server process. Messages are dispatched to handlers by their RUNTIME TYPE (type_of(msg),
// NOT string keys), and state is threaded FUNCTIONALLY: a call handler returns [new_state, reply], a
// cast handler returns new_state -- no shared-mutable cell (matches NOVA's value semantics; cleaner
// than an implicit set_state, which would need an ambient server context). A `call` blocks for the
// reply; a `cast` is fire-and-forget but still ordered. The loop is a SPAWNED process, so messages
// serialize through its request channel -> race-free state by construction (the actor model).

// A server is created with its initial state + ONE handler. The handler MATCHES on the message to
// dispatch by type -- this is Erlang's handle_call shape, and it is the ONLY way to type-dispatch in
// NOVA: type_of(struct) returns the generic "struct" (not the type name) and __type_hash isn't
// readable from user code, but `match msg { TypeA(..) => .. TypeB(..) => .. }` dispatches correctly
// on an any-typed value (verified). handler: fn(state, msg) -> [new_state, reply].
fn server(initial_state, handler) -> any
    let srv = {}
    srv["req"] = channel()
    srv["handler"] = handler
    srv["state"] = initial_state
    srv["terminate"] = 0
    srv

// Register a cleanup callback run when the server stops cleanly: terminate(state, reason). Set BEFORE
// gen_start (it's captured into the spawned loop's snapshot). Used for releasing resources / dropping
// presence on shutdown. (Crash-time terminate via a monitoring wrapper is a later refinement.)
fn on_terminate(srv, tfn) -> any
    srv["terminate"] = tfn
    srv

// The server loop: receive an envelope, run the handler (it matches on the message), thread state.
// A call sends the handler's reply back; a cast ignores it (still advances state, in arrival order).
// Frozen envelope: {kind:"call"|"cast"|"stop", msg:<value>, reply:<chan|0>}.
fn _gen_loop(srv)
    let running = 1
    while running == 1
        let env = receive(srv["req"])
        let kind = env["kind"]
        if kind == "stop"
            running = 0
            if srv["terminate"] != 0
                let tf = srv["terminate"]
                tf(srv["state"], "normal")
        else
            let h = srv["handler"]
            let r = h(srv["state"], env["msg"])
            srv["state"] = r[0]
            if kind == "call"
                send(env["reply"], r[1])

// Start the server's loop. Spawned DIRECTLY (the monitor/spawn rule -- a closure spawn would not work).
fn gen_start(srv) -> any
    spawn _gen_loop(srv)
    srv

// Synchronous request: send {call, msg} and BLOCK for the handler's reply (the actor serializes it).
fn call(srv, msg) -> any
    let rc = channel()
    let env = {}
    env["kind"] = "call"
    env["msg"] = msg
    env["reply"] = rc
    send(srv["req"], env)
    receive(rc)

// Asynchronous request: send {cast, msg}, return immediately. State still advances in arrival order.
fn cast(srv, msg) -> any
    let env = {}
    env["kind"] = "cast"
    env["msg"] = msg
    env["reply"] = 0
    send(srv["req"], env)
    0

// Stop the server loop (after any already-queued messages).
fn gen_stop(srv) -> any
    let env = {}
    env["kind"] = "stop"
    env["msg"] = 0
    env["reply"] = 0
    send(srv["req"], env)
    0

// ── Agent (a serialized single-value state cell) ─────────────────────────────────────────────────
// The simplest stateful process: hold ONE value, serialize get/update through an actor loop -> no
// locks, no lost updates. agent_update/agent_get_and take a FUNCTION applied to the state INSIDE the
// loop (sent over the channel, deep-copied, still callable). Like Elixir's Agent.

fn _agent_loop(ag)
    let running = 1
    while running == 1
        let env = receive(ag["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "get"
            send(env["reply"], ag["state"])
        else if op == "update"
            let fu = env["fn"]
            ag["state"] = fu(ag["state"])
        else if op == "getand"
            let fg = env["fn"]
            let r = fg(ag["state"])
            ag["state"] = r[0]
            send(env["reply"], r[1])

// Create an agent holding `init` and start its loop (spawned directly per the monitor/spawn rule).
fn agent(init) -> any
    let ag = {}
    ag["req"] = channel()
    ag["state"] = init
    spawn _agent_loop(ag)
    ag

fn agent_get(ag) -> any
    let rc = channel()
    let env = {}
    env["op"] = "get"
    env["reply"] = rc
    send(ag["req"], env)
    receive(rc)

// Apply `f: fn(v)->v` to the state (serialized -> concurrent updaters never lose an update).
fn agent_update(ag, f) -> any
    let env = {}
    env["op"] = "update"
    env["fn"] = f
    env["reply"] = 0
    send(ag["req"], env)
    0

// Apply `f: fn(v)->[new_v, reply]` and return `reply` (read-modify-write in one serialized step).
fn agent_get_and(ag, f) -> any
    let rc = channel()
    let env = {}
    env["op"] = "getand"
    env["fn"] = f
    env["reply"] = rc
    send(ag["req"], env)
    receive(rc)

fn agent_stop(ag) -> any
    let env = {}
    env["op"] = "stop"
    env["reply"] = 0
    send(ag["req"], env)
    0

// ── Task / async-await (crash-safe futures) ──────────────────────────────────────────────────────
// async(f) runs f in a MONITORED process + returns a Future. await(f) BLOCKS and returns ok(value)
// on success, or err("task crashed") if the task PANICKED -- a crashed task becomes an err, it never
// crashes the awaiter (the crash-safe upgrade over a raw spawn). Like Elixir Task.async/await.

fn _async_run(f, rc)
    send(rc, f())

// Spawn `f` (a no-arg fn) as a monitored task. Returns a Future handle.
fn async(f) -> any
    let fut = {}
    let rc = channel()
    fut["rc"] = rc
    let p = spawn _async_run(f, rc)
    fut["mon"] = monitor(p)
    fut

// Block for the task's result. ok(value) on normal completion; err on a panic (crash-safe).
// Annotate the binding (`let r: Result<any> = await(f)`) so the match dispatches (a bare Result
// without a type arg silently falls through both arms -- a known compiler footgun).
fn await(fut) -> Result<any>
    let st = receive(fut["mon"])
    if st == 0
        ok(receive(fut["rc"]))
    else
        err("task crashed")

// Await a list of futures -> a list of Results (each ok/err), preserving order.
fn await_all(futs) -> any
    let out = []
    let i = 0
    while i < len(futs)
        let r: Result<any> = await(futs[i])
        push(out, r)
        i = i + 1
    out

// ── Nursery (structured concurrency) ─────────────────────────────────────────────────────────────
// A scope that spawns child tasks and JOINS them ALL before returning -> no orphans, no leaked tasks.
// Each child is monitored (crash-safe): nursery_join returns a list of Results (ok(value), or err for
// a child that panicked) -- one bad child never aborts the others. Like Trio's nursery.

fn nursery() -> any
    let nur = {}
    nur["futs"] = []
    nur

// Launch a child (a no-arg fn) into the nursery scope (monitored via async).
fn nursery_go(nur, f) -> any
    let futs = nur["futs"]
    push(futs, async(f))
    nur["futs"] = futs
    nur

// Block until every child finishes -> a list of Results in launch order (crash-safe).
fn nursery_join(nur) -> any
    await_all(nur["futs"])

// ── Registry (name -> pid, serialized) ───────────────────────────────────────────────────────────
// A process-name registry: register pids by name + look them up by name. A dedicated actor loop
// serializes all ops (race-free); names + pids travel as DATA (no closures over the channel).
// reg_get of an absent (or dropped) name -> 0. The basis for service discovery + the application root.

// The map is created INSIDE the loop (a fresh dict). RUNTIME CONSTRAINT: adding a NEW key to a dict
// that was deep-copied across `spawn` updates keys() but NOT the hash index (contains/index then fail);
// reassigning a PRE-EXISTING key is fine. So dynamic-key dicts must be born in the loop's own process,
// never passed in through the spawned handle. (Verified; tracked for a runtime deep-copy fix.)
fn _reg_loop(reg)
    let m = {}
    let running = 1
    while running == 1
        let env = receive(reg["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "put"
            m[env["name"]] = env["pid"]
        else if op == "get"
            let pid = 0
            if contains(m, env["name"])
                pid = m[env["name"]]
            send(env["reply"], pid)
        else if op == "drop"
            m[env["name"]] = 0

fn registry() -> any
    let reg = {}
    reg["req"] = channel()
    spawn _reg_loop(reg)
    reg

fn reg_put(reg, name: string, pid) -> any
    let env = {}
    env["op"] = "put"
    env["name"] = name
    env["pid"] = pid
    env["reply"] = 0
    send(reg["req"], env)
    0

fn reg_get(reg, name: string) -> any
    let rc = channel()
    let env = {}
    env["op"] = "get"
    env["name"] = name
    env["reply"] = rc
    send(reg["req"], env)
    receive(rc)

fn reg_drop(reg, name: string) -> any
    let env = {}
    env["op"] = "drop"
    env["name"] = name
    env["reply"] = 0
    send(reg["req"], env)
    0

// ── Application (the OTP app root: a supervisor + a registry) ─────────────────────────────────────
// The top of an app: one supervisor (its children) + one registry (name->pid lookup). Declare children
// with app_child, then app_start brings up the registry and the supervised children. The single handle
// you boot + query -- like an Elixir Application / OTP application callback.

fn application(name: string) -> any
    let app = {}
    app["name"] = name
    app["sup"] = sup_new("one_for_one", 5, 10)
    app["reg"] = 0
    app

fn app_supervisor(app) -> any
    app["sup"]

fn app_registry(app) -> any
    app["reg"]

// Declare a supervised child of the application (delegates to the supervisor's child_add).
fn app_child(app, name: string, start_fn, restart: string, shutdown_ms: int) -> int
    child_add(app["sup"], name, start_fn, restart, shutdown_ms)

// Boot the app: bring up the registry, then start the supervised children. Returns the app.
fn app_start(app) -> any
    app["reg"] = registry()
    sup_start(app["sup"])
    app

// ── Jobs (background queue + worker pool) ─────────────────────────────────────────────────────────
// A bounded job queue + N workers draining it concurrently. enqueue puts a {kind,payload} job (blocks
// if the queue is full -> natural back-pressure); jobs_run spawns `num_workers` workers, each calling
// handler(kind, payload) per job. Zero-infra background processing (no Redis/Celery) -- on the runtime.

fn jobs(capacity: int) -> any
    let jq = {}
    jq["ch"] = channel_bounded(capacity)
    jq

fn enqueue(jq, kind: string, payload) -> int
    let job = {}
    job["kind"] = kind
    job["payload"] = payload
    send(jq["ch"], job)
    1

fn _job_worker(jq, handler)
    let running = 1
    while running == 1
        let job = receive(jq["ch"])
        if job["kind"] == "__stop__"
            running = 0
        else
            handler(job["kind"], job["payload"])

// Spawn `num_workers` workers draining the queue. Each runs handler(kind, payload) per job.
fn jobs_run(jq, num_workers: int, handler) -> int
    let i = 0
    while i < num_workers
        spawn _job_worker(jq, handler)
        i = i + 1
    num_workers

// Tell `num_workers` workers to stop (enqueue that many stop sentinels) -- for clean shutdown/tests.
fn jobs_stop(jq, num_workers: int) -> int
    let i = 0
    while i < num_workers
        enqueue(jq, "__stop__", 0)
        i = i + 1
    num_workers

// ── monitor_into (out-of-band DOWN -> a server's handler; the on_info / LiveView+Presence hook) ────
// Run `child_fn` as a monitored task; when it EXITS (normal or crash), cast `down_msg` into `srv` so
// the server's handler reacts (e.g. drop a presence entry, restart a view). This is "on_info" for the
// match-handler GenServer: an out-of-band message arrives via cast and the handler matches on it.
// The runner spawns the child via the direct-spawn path (_run_child) so its monitor signal is delivered.
fn _monitor_run(srv, child_fn, down_msg)
    let p = spawn _run_child(child_fn)
    let m = monitor(p)
    receive(m)
    cast(srv, down_msg)

// Monitor `child_fn` and forward `down_msg` to `srv` when it exits. Returns immediately.
fn monitor_into(srv, child_fn, down_msg) -> any
    spawn _monitor_run(srv, child_fn, down_msg)
    0

// ── Cron (T4.18): match a 5-field cron expression against a wall-clock minute ──────────────────────
// Fields: minute hour day month weekday. Each field is "*" (any), "N" (exact), or "*/N" (every N).
// cron_parse(expr) -> a list of [kind, n] specs; cron_due(parsed, min, hour, day, month, weekday) ->
// true when ALL fields match. Pure + deterministic (the caller supplies the clock fields -> testable
// with a simulated clock). The real-clock ticker (cron(jq, expr, ...) enqueuing on a match) is a thin
// follow-up over jobs + a minute clock.
fn _cron_field(f: string)
    if f == "*"
        return ["any", 0]
    if len(f) >= 2 and ord(char_at(f, 0)) == 42 and ord(char_at(f, 1)) == 47
        return ["step", parse_int(slice(f, 2, len(f)))]
    ["exact", parse_int(f)]

fn _cron_field_due(spec, val: int) -> bool
    if spec[0] == "any"
        return true
    if spec[0] == "step"
        if spec[1] <= 0
            return false
        return (val % spec[1]) == 0
    spec[1] == val

fn cron_parse(expr: string)
    let parts = split(expr, " ")
    let out = []
    let i = 0
    while i < len(parts)
        push(out, _cron_field(parts[i]))
        i = i + 1
    out

fn cron_due(parsed, minute: int, hour: int, day: int, month: int, weekday: int) -> bool
    if len(parsed) != 5
        return false
    if _cron_field_due(parsed[0], minute) == false
        return false
    if _cron_field_due(parsed[1], hour) == false
        return false
    if _cron_field_due(parsed[2], day) == false
        return false
    if _cron_field_due(parsed[3], month) == false
        return false
    if _cron_field_due(parsed[4], weekday) == false
        return false
    true

// ── Presence (S5 real-time): who is in each topic, tracked by a single-owner actor ────────────────
// presence_join/leave/list over a topic->members map BORN IN THE LOOP (race-free, dict-bug-free).
// join is idempotent (no duplicate member). The building block for Phoenix-style channel presence +
// LiveView "who's online". Members + topics travel as DATA over the request channel.
fn _presence_loop(pr)
    let topics = {}
    let running = 1
    while running == 1
        let env = receive(pr["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "join"
            let t = env["topic"]
            let members = []
            if contains(topics, t)
                members = topics[t]
            if contains(members, env["who"]) == false
                push(members, env["who"])
            topics[t] = members
        else if op == "leave"
            let t = env["topic"]
            if contains(topics, t)
                let cur = topics[t]
                let out = []
                let i = 0
                while i < len(cur)
                    if cur[i] != env["who"]
                        push(out, cur[i])
                    i = i + 1
                topics[t] = out
        else if op == "list"
            let t = env["topic"]
            let members = []
            if contains(topics, t)
                members = topics[t]
            send(env["reply"], members)

fn presence() -> any
    let pr = {}
    pr["req"] = channel()
    spawn _presence_loop(pr)
    pr

fn presence_join(pr, topic: string, who: string) -> any
    let env = {}
    env["op"] = "join"
    env["topic"] = topic
    env["who"] = who
    env["reply"] = 0
    send(pr["req"], env)
    0

fn presence_leave(pr, topic: string, who: string) -> any
    let env = {}
    env["op"] = "leave"
    env["topic"] = topic
    env["who"] = who
    env["reply"] = 0
    send(pr["req"], env)
    0

fn presence_list(pr, topic: string) -> any
    let rc = channel()
    let env = {}
    env["op"] = "list"
    env["topic"] = topic
    env["reply"] = rc
    send(pr["req"], env)
    receive(rc)
