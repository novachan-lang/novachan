// forge_deep_equal -- deep structural equality of two values (nested dicts/lists/scalars). For test assertions,
// change detection, cache-key comparison, and idempotency checks. Dicts compare key-by-key (order-insensitive);
// lists compare index-by-index (order-sensitive); scalars by string value. LEAF -- imports NOTHING.

fn deep_equal(a: any, b: any) -> bool
    let ta = type_of(a)
    let tb = type_of(b)
    if ta == "dict" and tb == "dict"
        let ka = keys(a)
        if len(ka) != len(keys(b))
            return false
        let i = 0
        while i < len(ka)
            let k = ka[i]
            if contains(b, k) == false
                return false
            if deep_equal(a[k], b[k]) == false
                return false
            i = i + 1
        return true
    if ta == "list" and tb == "list"
        if len(a) != len(b)
            return false
        let i = 0
        while i < len(a)
            if deep_equal(a[i], b[i]) == false
                return false
            i = i + 1
        return true
    str(a) == str(b)
