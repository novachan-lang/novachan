// forge_path -- POSIX-style path manipulation (basename/dirname/extname/join/normalize) for URL paths, storage
// keys, and route segments. Uses "/" separators; normalize resolves "." and ".." and collapses duplicate
// slashes. LEAF -- imports NOTHING.

fn _path_last_slash(s: string) -> int
    let idx = 0 - 1
    for i in 0..len(s)
        if char_at(s, i) == "/"
            idx = i
    idx

// The last segment: "/a/b/c.txt" -> "c.txt" (a trailing slash is ignored).
fn path_basename(path: string) -> string
    let p = path
    while len(p) > 1 and char_at(p, len(p) - 1) == "/"
        p = slice(p, 0, len(p) - 1)
    let idx = _path_last_slash(p)
    if idx < 0
        return p
    slice(p, idx + 1, len(p))

// The directory portion: "/a/b/c.txt" -> "/a/b"; no slash -> "."; root child -> "/".
fn path_dirname(path: string) -> string
    let p = path
    while len(p) > 1 and char_at(p, len(p) - 1) == "/"
        p = slice(p, 0, len(p) - 1)
    let idx = _path_last_slash(p)
    if idx < 0
        return "."
    if idx == 0
        return "/"
    slice(p, 0, idx)

// The extension including the dot: "a.tar.gz" -> ".gz"; a dotfile or no dot -> "".
fn path_extname(path: string) -> string
    let base = path_basename(path)
    let idx = 0 - 1
    for i in 0..len(base)
        if char_at(base, i) == "."
            idx = i
    if idx <= 0
        return ""
    slice(base, idx, len(base))

// Join two segments with a single "/" (trims a trailing slash on a, a leading slash on b).
fn path_join(a: string, b: string) -> string
    if len(a) == 0
        return b
    if len(b) == 0
        return a
    let aa = a
    while len(aa) > 0 and char_at(aa, len(aa) - 1) == "/"
        aa = slice(aa, 0, len(aa) - 1)
    let bb = b
    while len(bb) > 0 and char_at(bb, 0) == "/"
        bb = slice(bb, 1, len(bb))
    aa + "/" + bb

fn _path_pop(stack: list) -> list
    let out = [stack[i] for i in 0..(len(stack) - 1)]
    out

fn _path_join_list(parts: list) -> string
    let out_parts = []
    for i in 0..len(parts)
        if i > 0
            push(out_parts, "/")
        push(out_parts, parts[i])
    let out = join(out_parts, "")
    out

// Normalize: resolve "." and ".." and collapse duplicate/trailing slashes. Preserves a leading "/".
fn path_normalize(path: string) -> string
    let absolute = len(path) > 0 and char_at(path, 0) == "/"
    let parts = split(path, "/")
    let stack = []
    let i = 0
    while i < len(parts)
        let seg = parts[i]
        if seg == "" or seg == "."
            i += 1
        else
            if seg == ".."
                if len(stack) > 0 and stack[len(stack) - 1] != ".."
                    stack = _path_pop(stack)
                else
                    if absolute == false
                        push(stack, "..")
                i += 1
            else
                push(stack, seg)
                i += 1
    let out = _path_join_list(stack)
    if absolute
        return "/" + out
    if len(out) == 0
        return "."
    out
