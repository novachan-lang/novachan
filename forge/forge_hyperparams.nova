// forge_hyperparams — Hyperparameter management: named string-valued
// params with optional [min,max] validation ranges.
//
// STATE SHAPE (flat dict, no nesting):
//   state["params"]           — string, comma-separated list of every
//                                param name ever set (may include
//                                params later removed).
//   state["present_"+name]    — int, 1 if `name` is currently set, 0 if
//                                it was removed. There is no dict-delete
//                                builtin, so membership is a tri-state
//                                tracked explicitly: KEY ABSENT (never
//                                set) / 1 (present) / 0 (removed).
//   state["val_"+name]        — string, current value of `name` (only
//                                meaningful while present).
//   state["has_range_"+name]  — int, 1 if a [min,max] range was defined
//                                for `name` via hp_set_range.
//   state["min_"+name]        — float, lower bound (when has_range).
//   state["max_"+name]        — float, upper bound (when has_range).
//   state["count"]            — int, number of currently present params.
//
// LEAF MODULE — imports NOTHING; only NOVA builtins:
// contains/split/parse_float/ok/err.

// _hp_is_present(state, name) -> int — PRIVATE. 1 if `name` is currently
// a set (not removed) hyperparameter.
fn _hp_is_present(state: dict, name: string) -> int
    if "present_" + name in state == true
        if state["present_" + name] == 1
            return 1
    0

// hp_new() -> dict
// Create an empty hyperparameter store.
fn hp_new() -> dict
    let state = {}
    state["params"] = ""
    state["count"] = 0
    state

// hp_set(state, name, value) -> dict
// Set (or overwrite) the value of hyperparameter `name`.
fn hp_set(state: dict, name: string, value: string) -> dict
    let already = _hp_is_present(state, name)
    if already == 0
        if "present_" + name in state == false
            if state["params"] == ""
                state["params"] = name
            else
                state["params"] = state["params"] + "," + name
        state["count"] = state["count"] + 1
        state["present_" + name] = 1
    state["val_" + name] = value
    state

// hp_get(state, name) -> Result
// ok(value), or err("parameter not found").
fn hp_get(state: dict, name: string) -> Result
    if _hp_is_present(state, name) == 0
        return err("parameter not found")
    ok(state["val_" + name])

// hp_has(state, name) -> int
// Return 1 if `name` is currently set, 0 otherwise.
fn hp_has(state: dict, name: string) -> int
    _hp_is_present(state, name)

// hp_remove(state, name) -> Result
// Remove hyperparameter `name`. err("parameter not found") if it was
// never set or already removed.
fn hp_remove(state: dict, name: string) -> Result
    if _hp_is_present(state, name) == 0
        return err("parameter not found")
    state["present_" + name] = 0
    state["count"] = state["count"] - 1
    ok(state)

// hp_count(state) -> int
// Number of currently set hyperparameters.
fn hp_count(state: dict) -> int
    state["count"]

// hp_param_list(state) -> string
// Comma-separated list of currently set param names.
fn hp_param_list(state: dict) -> string
    let toks = split(state["params"], ",")
    let out = ""
    for t in toks
        if t != ""
            if _hp_is_present(state, t) == 1
                if out == ""
                    out = t
                else
                    out += "," + t
    out

// hp_set_range(state, name, min_val, max_val) -> dict
// Define the valid [min_val, max_val] range for `name`. Does not require
// `name` to already be set.
fn hp_set_range(state: dict, name: string, min_val: float, max_val: float) -> dict
    state["has_range_" + name] = 1
    state["min_" + name] = min_val
    state["max_" + name] = max_val
    state

// hp_validate(state, name, value) -> Result
// ok(1) if `value` parses as a number within `name`'s configured range
// (inclusive), ok(0) if it is out of range, or err("no range defined")
// if hp_set_range was never called for `name`.
fn hp_validate(state: dict, name: string, value: string) -> Result
    if "has_range_" + name in state == false
        return err("no range defined")
    if state["has_range_" + name] == 0
        return err("no range defined")
    let v = parse_float(value)
    if v < state["min_" + name]
        return ok(0)
    if v > state["max_" + name]
        return ok(0)
    ok(1)

// hp_defaults(state) -> string
// Comma-separated "name=value" pairs for every currently set param, in
// the order they were first set.
fn hp_defaults(state: dict) -> string
    let toks = split(state["params"], ",")
    let out = ""
    for t in toks
        if t != ""
            if _hp_is_present(state, t) == 1
                let pair = t + "=" + state["val_" + t]
                if out == ""
                    out = pair
                else
                    out += "," + pair
    out
