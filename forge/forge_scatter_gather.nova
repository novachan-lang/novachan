// forge_scatter_gather — Scatter work, gather results.

fn sg_new() -> dict
    {"tasks": {}, "results": {}, "task_count": 0, "gathered": 0, "errors": 0}

fn sg_scatter(s: dict, task_id: string, payload: string) -> dict
    let k = str(s["task_count"])
    s["tasks"][k + "_id"] = task_id
    s["tasks"][k + "_payload"] = payload
    s["tasks"][k + "_status"] = "scattered"
    s["task_count"] += 1
    s

fn sg_gather_ok(s: dict, task_id: string, result: string) -> dict
    s["results"][task_id] = result
    s["results"][task_id + "_status"] = "ok"
    s["gathered"] += 1
    s

fn sg_gather_err(s: dict, task_id: string, err: string) -> dict
    s["results"][task_id] = err
    s["results"][task_id + "_status"] = "error"
    s["gathered"] += 1
    s["errors"] += 1
    s

fn sg_is_complete(s: dict) -> int
    1 if s["gathered"] == s["task_count"] else 0

fn sg_result_for(s: dict, task_id: string) -> string
    if task_id not in s["results"]
        return ""
    s["results"][task_id]

fn sg_success_count(s: dict) -> int
    s["gathered"] - s["errors"]

fn sg_error_count(s: dict) -> int
    s["errors"]

fn sg_progress(s: dict) -> int
    if s["task_count"] == 0
        return 100
    s["gathered"] * 100 / s["task_count"]
