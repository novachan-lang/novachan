// forge_metric_gauge — Named gauges (set/inc/dec) for metrics collection.

fn mg_new() -> dict
    let m = {}
    m["gauges"] = {}
    m

fn mg_set(m: dict, name: string, value: int) -> dict
    m["gauges"][name] = value
    m

fn mg_inc(m: dict, name: string) -> dict
    let has = contains(m["gauges"], name)
    if has == true
        m["gauges"][name] = m["gauges"][name] + 1
    else
        m["gauges"][name] = 1
    m

fn mg_dec(m: dict, name: string) -> dict
    let has = contains(m["gauges"], name)
    if has == true
        m["gauges"][name] = m["gauges"][name] - 1
    else
        m["gauges"][name] = -1
    m

fn mg_get(m: dict, name: string) -> int
    let has = contains(m["gauges"], name)
    if has != true
        return 0
    m["gauges"][name]

fn mg_gauge_count(m: dict) -> int
    len(keys(m["gauges"]))

fn mg_add(m: dict, name: string, delta: int) -> dict
    let has = contains(m["gauges"], name)
    if has == true
        m["gauges"][name] = m["gauges"][name] + delta
    else
        m["gauges"][name] = delta
    m
