// forge_checksum -- CRC-32 (IEEE 802.3) checksum for DATA INTEGRITY: file/blob verification, network-frame
// checks, and cheap change-detection / dedup. Standard reflected polynomial 0xEDB88320, computed bitwise (no
// 8KB lookup table -- small and dependency-free). Operates on a string's bytes. NOT cryptographic (use SHA for
// tamper resistance); CRC catches accidental corruption. LEAF -- imports NOTHING.

fn crc32(s: string) -> int
    let crc = 4294967295
    let poly = 3988292384
    for i in 0..len(s)
        crc = crc ^ ord(char_at(s, i))
        for bit in 0..8
            if (crc & 1) != 0
                crc = (crc / 2) ^ poly
            else
                crc = crc / 2
    crc ^ 4294967295

// CRC-32 as an 8-char lowercase hex string (the conventional display form).
fn crc32_hex(s: string) -> string
    let v = crc32(s)
    let alpha = "0123456789abcdef"
    let out = ""
    for j in 0..8
        out = char_at(alpha, v % 16) + out
        v = v / 16
    out
