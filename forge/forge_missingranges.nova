// forge_missingranges -- given a sorted set of numbers you HAVE and a full span [lo, hi] you care about, report the
// gaps: the contiguous ranges of values that are MISSING. Walking the sorted list once and noting each jump of two
// or more between consecutive present values (and the edges at lo and hi) yields every hole in O(n). This is the
// everyday "what's not covered" question: unallocated blocks in an IP/port/ID range, missing sequence numbers or
// pages (which packets/records didn't arrive), free slots between busy time ranges, and gaps in a coverage map.
// missing_ranges returns the holes as inclusive [start, end] pairs; count_missing totals how many individual
// values are absent; and is_fully_covered says whether the span has no gaps at all. The input must be sorted
// ascending with values inside [lo, hi]. Integer values. LEAF -- imports NOTHING.

// The inclusive [start, end] ranges within [lo, hi] that are NOT present in the sorted list `nums`.
// missing_ranges([0,1,3,50,75], 0, 99) = [[2,2],[4,49],[51,74],[76,99]].
fn missing_ranges(nums: list, lo: int, hi: int) -> list
    let result = []
    let prev = lo - 1
    let i = 0
    let n = len(nums)
    while i <= n
        let x = hi + 1
        if i < n
            x = nums[i]
        if x - prev >= 2
            push(result, [prev + 1, x - 1])
        prev = x
        i += 1
    result

// The total number of individual values in [lo, hi] that are missing from `nums`.
fn count_missing(nums: list, lo: int, hi: int) -> int
    let ranges = missing_ranges(nums, lo, hi)
    let total = 0
    for i in 0..len(ranges)
        total += (ranges[i][1] - ranges[i][0] + 1)
    total

// True if [lo, hi] is fully covered by `nums` (no missing values).
fn is_fully_covered(nums: list, lo: int, hi: int) -> bool
    let out = false
    if len(missing_ranges(nums, lo, hi)) == 0
        out = true
    out
