// forge_zeckendorf -- Zeckendorf's theorem and Fibonacci coding. Zeckendorf proved that EVERY positive integer is
// a unique sum of NON-CONSECUTIVE Fibonacci numbers (10 = 8 + 2, 100 = 89 + 8 + 3) -- a "Fibonacci base" you build
// greedily by repeatedly subtracting the largest Fibonacci number that fits. Turn that representation into bits and
// you get Fibonacci coding: a variable-length, prefix-free UNIVERSAL code for integers that ends every codeword
// with "11" (which never appears inside, since consecutive Fibonacci numbers are never both used). Fibonacci codes
// are more robust to bit errors than plain binary (a flipped bit can't cascade past the next "11" boundary) and
// self-synchronizing, which is why they're used in data compression of small-ish integers and in some
// fault-tolerant formats. This module gives the Zeckendorf decomposition of a number and the encode/decode of
// Fibonacci codes. Positive integers. LEAF -- imports NOTHING.

// PRIVATE: Fibonacci numbers 1, 2, 3, 5, 8, ... up to at least `limit` (the Zeckendorf-usable Fibonaccis).
fn _zk_fibs(limit: int) -> list
    let fibs = []
    push(fibs, 1)
    push(fibs, 2)
    while fibs[len(fibs) - 1] <= limit
        let a = fibs[len(fibs) - 1]
        let b = fibs[len(fibs) - 2]
        push(fibs, a + b)
    fibs

// The Zeckendorf representation of n: the non-consecutive Fibonacci numbers that sum to n, largest first.
// zeckendorf(10) = [8, 2].
fn zeckendorf(n: int) -> list
    let out = []
    if n >= 1
        let fibs = _zk_fibs(n)
        let remaining = n
        let i = len(fibs) - 1
        while i >= 0
            if fibs[i] <= remaining
                push(out, fibs[i])
                remaining -= fibs[i]
            i -= 1
    out

// Encode n as a Fibonacci code: a bit string (Zeckendorf bits from the smallest Fibonacci up, then a terminating
// "1" so the code ends in "11"). fib_encode(10) = "010011".
fn fib_encode(n: int) -> string
    let out = "1"
    if n >= 1
        let fibs = _zk_fibs(n)
        // greedily mark which Fibonacci numbers are used
        let used = [0 for z in 0..len(fibs)]
        let remaining = n
        let i = len(fibs) - 1
        while i >= 0
            if fibs[i] <= remaining
                used[i] = 1
                remaining -= fibs[i]
            i -= 1
        // highest used index
        let hi = 0
        for j in 0..len(fibs)
            if used[j] == 1
                hi = j
        // bits smallest-first up to hi, then terminator "1"
        let bits_parts = []
        let b = 0
        while b <= hi
            push(bits_parts, str(used[b]))
            b += 1
        let bits = join(bits_parts, "")
        out = bits + "1"
    out

// Decode a Fibonacci code back to the integer (reads value bits until the terminating "11").
fn fib_decode(bits: string) -> int
    let fibs = _zk_fibs(1)
    // extend fibs to cover the bit length
    while len(fibs) < len(bits)
        let a = fibs[len(fibs) - 1]
        let b = fibs[len(fibs) - 2]
        push(fibs, a + b)
    let total = 0
    let prev = 0
    let i = 0
    let stop = false
    while i < len(bits) and stop == false
        if char_at(bits, i) == "1"
            if prev == 1
                stop = true
            else
                total += fibs[i]
                prev = 1
        else
            prev = 0
        if stop == false
            i += 1
    total
