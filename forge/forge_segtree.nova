// forge_segtree -- an iterative segment tree for Range Minimum Query with point updates, both O(log n). This
// complements forge_fenwick (which does range SUMS): a Fenwick tree cannot answer range-min/max because min is
// not invertible. Use this for sliding-window minima, "cheapest option in a range", nearest-smaller queries,
// and RMQ-based algorithms. Array is 0-indexed; queries are inclusive [l, r]. LEAF -- imports NOTHING.

fn _seg_big() -> int
    1000000000

fn _seg_min(a: int, b: int) -> int
    if a < b
        return a
    b

// Build a range-min segment tree from `arr`. The returned list has 2*n slots (leaves at [n..2n), internal at
// [1..n)); derive n as len(tree)/2 in the query/update calls.
fn segtree_build(arr: list) -> list
    let n = len(arr)
    let tree = []
    let i = 0
    while i < 2 * n
        push(tree, 0)
        i = i + 1
    i = 0
    while i < n
        tree[n + i] = arr[i]
        i = i + 1
    i = n - 1
    while i > 0
        tree[i] = _seg_min(tree[2 * i], tree[2 * i + 1])
        i = i - 1
    tree

// Minimum over inclusive range [l, r] (0-based).
fn segtree_query_min(tree: list, l: int, r: int) -> int
    let n = len(tree) / 2
    let res = _seg_big()
    let lo = l + n
    let hi = r + n + 1
    while lo < hi
        if lo % 2 == 1
            res = _seg_min(res, tree[lo])
            lo = lo + 1
        if hi % 2 == 1
            hi = hi - 1
            res = _seg_min(res, tree[hi])
        lo = lo / 2
        hi = hi / 2
    res

// Point-update index `i` (0-based) to `val`, refreshing the path to the root.
fn segtree_update(tree: list, i: int, val: int) -> list
    let n = len(tree) / 2
    let idx = i + n
    tree[idx] = val
    idx = idx / 2
    while idx >= 1
        tree[idx] = _seg_min(tree[2 * idx], tree[2 * idx + 1])
        idx = idx / 2
    tree
