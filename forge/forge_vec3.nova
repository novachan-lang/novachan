// forge_vec3 -- 3D vector math: add/sub/scale, dot & cross products, length & normalize. The core of any 3D
// graphics, physics, or game engine (the NOVA Reactor plan), and of geometric ML. A vector is a 3-element list
// [x, y, z] of numbers; results are float where a division/sqrt is involved. Companion to forge_matrix (a mat
// times a vec is the standard transform). LEAF -- imports NOTHING (uses the sqrt builtin).

// Component-wise sum.
fn vec3_add(a: list, b: list) -> list
    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]

// Component-wise difference a - b.
fn vec3_sub(a: list, b: list) -> list
    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]

// Scalar multiple.
fn vec3_scale(a: list, s: float) -> list
    [a[0] * s, a[1] * s, a[2] * s]

// Dot (scalar) product a . b.
fn vec3_dot(a: list, b: list) -> float
    a[0] * 1.0 * b[0] + a[1] * 1.0 * b[1] + a[2] * 1.0 * b[2]

// Cross (vector) product a x b -- perpendicular to both, right-handed.
fn vec3_cross(a: list, b: list) -> list
    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]

// Euclidean length |a|.
fn vec3_length(a: list) -> float
    sqrt(vec3_dot(a, a))

// Unit vector in the direction of a. A zero vector is returned unchanged (length 0 -> no division).
fn vec3_normalize(a: list) -> list
    let len = vec3_length(a)
    if len == 0.0
        return [a[0] * 1.0, a[1] * 1.0, a[2] * 1.0]
    [a[0] / len, a[1] / len, a[2] / len]
