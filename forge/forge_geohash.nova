// forge_geohash -- geohash encoding: interleave latitude/longitude bits into a short base32 string so nearby
// points share a prefix (proximity search, map-tile indexing, the encoding behind Redis GEO). Longer hash =
// finer cell. Complements forge_geo (haversine distance). LEAF -- imports NOTHING.

// Encode (lat,lon) to a `precision`-char geohash. Standard interleave: even bits refine longitude, odd bits
// latitude; every 5 bits emit one base32 (geohash alphabet, no a/i/l/o) char.
fn geohash_encode(lat: float, lon: float, precision: int) -> string
    let base32 = "0123456789bcdefghjkmnpqrstuvwxyz"
    let lat_lo = 0.0 - 90.0
    let lat_hi = 90.0
    let lon_lo = 0.0 - 180.0
    let lon_hi = 180.0
    let out_parts = []
    let bit = 0
    let ch = 0
    let even = true
    while len(out) < precision
        if even
            let mid = (lon_lo + lon_hi) / 2.0
            if lon >= mid
                ch = ch * 2 + 1
                lon_lo = mid
            else
                ch = ch * 2
                lon_hi = mid
        else
            let mid = (lat_lo + lat_hi) / 2.0
            if lat >= mid
                ch = ch * 2 + 1
                lat_lo = mid
            else
                ch = ch * 2
                lat_hi = mid
        even = even == false
        bit += 1
        if bit == 5
            push(out_parts, char_at(base32, ch))
            bit = 0
            ch = 0
    let out = join(out_parts, "")
    out
