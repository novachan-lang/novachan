// forge_data_partitioner — hash-based data partitioning with Result API.

fn dp_new(partition_count: int) -> dict
    let d = {"partitions": partition_count, "counts": {}, "total": 0}
    for i in 0..partition_count
        let pk = "p_" + str(i)
        d["counts"][pk] = 0
    d

fn dp_assign(d: dict, key: string) -> int
    let hv = hash(key)
    if hv < 0
        hv = -hv
    let part = hv % d["partitions"]
    let pk = "p_" + str(part)
    d["counts"][pk] += 1
    d["total"] += 1
    part

fn dp_partition_size(d: dict, partition: int) -> Result
    if partition < 0 or partition >= d["partitions"]
        return err("invalid partition")
    let pk = "p_" + str(partition)
    ok(d["counts"][pk])

fn dp_largest_partition(d: dict) -> int
    let max_val = 0
    let max_idx = 0
    for i in 0..d["partitions"]
        let pk = "p_" + str(i)
        if d["counts"][pk] > max_val
            max_val = d["counts"][pk]
            max_idx = i
    max_idx

fn dp_total(d: dict) -> int
    d["total"]

fn dp_partition_count(d: dict) -> int
    d["partitions"]

fn dp_balance_ratio(d: dict) -> int
    if d["total"] == 0
        return 100
    let expected = d["total"] / d["partitions"]
    if expected == 0
        return 100
    let max_dev = 0
    for i in 0..d["partitions"]
        let pk = "p_" + str(i)
        let dev = d["counts"][pk] - expected
        if dev < 0
            dev = -dev
        if dev > max_dev
            max_dev = dev
    100 - (max_dev * 100 / expected)
