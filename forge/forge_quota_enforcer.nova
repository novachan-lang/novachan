// forge_quota_enforcer — Enforce per-user resource quotas.

fn qe_new() -> dict
    let q = {}
    q["quotas"] = {}
    q["usage"] = {}
    q["violations"] = 0
    q["checks"] = 0
    q

fn qe_set_quota(q: dict, user: string, limit: int) -> dict
    q["quotas"][user] = limit
    let has = contains(q["usage"], user)
    if has != true
        q["usage"][user] = 0
    q

fn qe_use(q: dict, user: string, amount: int) -> dict
    let result = {}
    q["checks"] = q["checks"] + 1
    let has = contains(q["quotas"], user)
    if has != true
        result["ok"] = 0
        result["reason"] = "no_quota"
        result["q"] = q
        return result
    let current = q["usage"][user]
    let limit = q["quotas"][user]
    if current + amount > limit
        q["violations"] = q["violations"] + 1
        result["ok"] = 0
        result["reason"] = "exceeded"
        result["q"] = q
        return result
    q["usage"][user] = current + amount
    result["ok"] = 1
    result["reason"] = ""
    result["q"] = q
    result

fn qe_remaining(q: dict, user: string) -> int
    let has_q = contains(q["quotas"], user)
    if has_q != true
        return 0
    let has_u = contains(q["usage"], user)
    if has_u != true
        return q["quotas"][user]
    q["quotas"][user] - q["usage"][user]

fn qe_utilization(q: dict, user: string) -> int
    let has = contains(q["quotas"], user)
    if has != true
        return 0
    if q["quotas"][user] == 0
        return 100
    q["usage"][user] * 100 / q["quotas"][user]

fn qe_reset(q: dict, user: string) -> dict
    let has = contains(q["usage"], user)
    if has == true
        q["usage"][user] = 0
    q

fn qe_total_violations(q: dict) -> int
    q["violations"]
