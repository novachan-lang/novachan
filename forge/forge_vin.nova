// forge_vin -- VIN (Vehicle Identification Number, ISO 3779 / US FMVSS 115) validation via its position-9
// check digit. A VIN is 17 characters; the letters I, O, Q are forbidden (they look like 1/0). Each character
// transliterates to a value, is multiplied by a fixed positional weight, and the weighted sum mod 11 gives the
// check digit at position 9 (10 -> the letter 'X'). Useful for automotive/logistics/insurance intake -- joins
// forge's ISIN/CUSIP/IBAN/card validators. LEAF -- imports NOTHING.

// PRIVATE: transliterated value of a VIN character, or -1 if it is not a legal VIN character (I/O/Q rejected).
fn _vin_val(c: string) -> int
    if c >= "0" and c <= "9"
        return ord(c) - 48
    if c == "A" or c == "J"
        return 1
    if c == "B" or c == "K" or c == "S"
        return 2
    if c == "C" or c == "L" or c == "T"
        return 3
    if c == "D" or c == "M" or c == "U"
        return 4
    if c == "E" or c == "N" or c == "V"
        return 5
    if c == "F" or c == "W"
        return 6
    if c == "G" or c == "P" or c == "X"
        return 7
    if c == "H" or c == "Y"
        return 8
    if c == "R" or c == "Z"
        return 9
    0 - 1

// PRIVATE: the positional weight for VIN position i (0-indexed). Position 9 (index 8) has weight 0 (the check
// digit does not weight itself).
fn _vin_weight(i: int) -> int
    let w = [8, 7, 6, 5, 4, 3, 2, 10, 0, 9, 8, 7, 6, 5, 4, 3, 2]
    w[i]

// The computed check character for a 17-char VIN ("0".."9" or "X"), or "" if the VIN has a bad length/char.
fn vin_check_char(vin: string) -> string
    if len(vin) != 17
        return ""
    let sum = 0
    let i = 0
    while i < 17
        let v = _vin_val(char_at(vin, i))
        if v < 0
            return ""
        sum = sum + v * _vin_weight(i)
        i = i + 1
    let r = sum % 11
    if r == 10
        return "X"
    str(r)

// True iff `vin` is 17 valid characters AND its position-9 character matches the computed check digit.
fn vin_valid(vin: string) -> bool
    let cc = vin_check_char(vin)
    if len(cc) == 0
        return false
    cc == char_at(vin, 8)
