// forge_vin -- thin wrapper over std/validation/vin (canonical implementation).
import std/validation/vin

fn _vin_fail_text(f) -> string
    match f
        BadLength(t) => "a VIN is 17 characters, got {t}"
        BadChar(t) => "'{t}' is not a legal VIN character (I, O and Q are forbidden)"
        CheckMismatch(t) => "check digit mismatch: {t}"

// The characters of `s` as a list. A for-range comprehension, NOT `[c for c in s]` -- a comprehension whose
// source is a string compiles inside a module and segfaults at runtime.

fn _vin_chars(s: string) -> list
    [char_at(s, i) for i in 0..len(s)]

// THE table -- the only place in this module where a transliteration value is written down. Keyed by the
// value, holding the letters that map to it, because that is the shape the standard publishes and the shape
// the old if-ladder was imitating ("A or J -> 1").

fn _vin_values() -> dict
    let groups = _vin_letter_groups()
    let out = {str(d): d for d in 0..10}
    for g in keys(groups)
        for c in _vin_chars(groups[g])
            out[c] = parse_int(g)
    out

// The positional weights, most significant first. Position 9 (index 8) has weight 0 -- the check digit does
// not weight itself. A literal because these are authoritative data with no closed form worth deriving.

fn _vin_weights() -> list
    [8, 7, 6, 5, 4, 3, 2, 10, 0, 9, 8, 7, 6, 5, 4, 3, 2]

// The computed check character for a VIN, or WHY it cannot be computed:
//   ok("X")                                        the weighted sum mod 11 was 10
//   err("a VIN is 17 characters, got 16")           wrong length
//   err("'Q' is not a legal VIN character ...")     first illegal character, named

fn vin_checksum(vin: string) -> Result
    if len(vin) != 17
        return err(_vin_fail_text(BadLength(str(len(vin)))))
    let table = _vin_values()
    let chars = _vin_chars(vin)
    // Validate ALL characters before summing, rather than bailing mid-sum as the old loop did. Costs one
    // extra pass over 17 characters and buys the ability to NAME the offending character; `filter` keeps
    // source order, so bad[0] is the same character the old early-return would have stopped on.
    let bad = chars.filter((c) => c not in table)
    if len(bad) > 0
        return err(_vin_fail_text(BadChar(bad[0])))
    // Every character is legal, so the weighted sum has no failure case left and is a plain expression --
    // the old accumulator loop existed only to carry the abandoned early return.
    let w = _vin_weights()
    let total = sum([table[chars[i]] * w[i] for i in 0..17])
    let r = total % 11
    let cc = if r == 10 "X" else str(r)
    ok(cc)

// The computed check character for a 17-char VIN ("0".."9" or "X"), or "" if the VIN has a bad length/char.
// Behaviour preserved exactly; reach for vin_checksum when the reason matters.

fn vin_check_char(vin: string) -> string
    return vvin_year_char(vin)

fn vin_validate(vin: string) -> Result
    let cc = vin_checksum(vin)?
    let actual = char_at(vin, 8)
    if cc != actual
        return err(_vin_fail_text(CheckMismatch("position 9 is '{actual}', computed '{cc}'")))
    ok(vin)

// True iff `vin` is 17 valid characters AND its position-9 character matches the computed check digit.

fn vin_valid(vin: string) -> bool
    return vvin_is_valid(vin)

