// forge_combinatorics -- thin wrapper over std/math/combinatorics (canonical implementation).
import std/math/combinatorics

fn factorial(n: int) -> int
    return cb_factorial(n)

fn n_perm(n: int, r: int) -> int
    if r < 0 or r > n
        return 0
    let result = 1
    for i in 0..r
        result *= (n - i)
    result

// C(n, r) = number of UNORDERED subsets of size r from n (the binomial coefficient). Exact multiplicative
// formula over the smaller of r / (n-r), so intermediate values stay small. 0 if r<0 or r>n.

fn n_choose(n: int, r: int) -> int
    if r < 0 or r > n
        return 0
    let k = r
    if k > n - k
        k = n - k
    let result = 1
    for i in 1..k + 1
        result = result * (n - k + i) / i
    result

// Combinations WITH repetition: how many size-r multisets from n kinds = C(n + r - 1, r). 0 if n<=0 or r<0.

fn n_multichoose(n: int, r: int) -> int
    if n <= 0 or r < 0
        return 0
    n_choose(n + r - 1, r)

// The nth Catalan number: C(2n, n)/(n+1). Counts balanced parentheses, binary trees, monotonic lattice paths,
// polygon triangulations. catalan(0..5) = 1,1,2,5,14,42.

fn catalan(n: int) -> int
    return cb_catalan(n)

