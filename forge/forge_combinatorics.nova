// forge_combinatorics -- counting: factorials, permutations, combinations (n-choose-r), and Catalan numbers.
// These answer "how many ways can this happen" -- lottery/poker odds, sampling and probability, A/B design,
// pagination-of-subsets, feature-combination counts, and the closed forms behind many algorithms. The star is
// n_choose (the binomial coefficient): it uses the EXACT multiplicative formula with the smaller of r / n-r,
// so it stays integer-exact and avoids the overflow you'd hit computing n!/(r!(n-r)!) directly -- e.g. it can
// return C(52,5)=2,598,960 without ever forming 52!. Results are i64: factorial is exact through 20! (21!
// overflows), and n_choose handles far larger n as long as the final value fits in i64. LEAF -- imports NOTHING.

// n! -- exact through 20! (21! exceeds i64). Returns 1 for 0!, 0 for negative n.
fn factorial(n: int) -> int
    if n < 0
        return 0
    let result = 1
    let i = 2
    while i <= n
        result = result * i
        i = i + 1
    result

// P(n, r) = number of ORDERED arrangements of r items from n = n*(n-1)*...*(n-r+1). 0 if r<0 or r>n.
fn n_perm(n: int, r: int) -> int
    if r < 0 or r > n
        return 0
    let result = 1
    let i = 0
    while i < r
        result = result * (n - i)
        i = i + 1
    result

// C(n, r) = number of UNORDERED subsets of size r from n (the binomial coefficient). Exact multiplicative
// formula over the smaller of r / (n-r), so intermediate values stay small. 0 if r<0 or r>n.
fn n_choose(n: int, r: int) -> int
    if r < 0 or r > n
        return 0
    let k = r
    if k > n - k
        k = n - k
    let result = 1
    let i = 1
    while i <= k
        result = result * (n - k + i) / i
        i = i + 1
    result

// Combinations WITH repetition: how many size-r multisets from n kinds = C(n + r - 1, r). 0 if n<=0 or r<0.
fn n_multichoose(n: int, r: int) -> int
    if n <= 0 or r < 0
        return 0
    n_choose(n + r - 1, r)

// The nth Catalan number: C(2n, n)/(n+1). Counts balanced parentheses, binary trees, monotonic lattice paths,
// polygon triangulations. catalan(0..5) = 1,1,2,5,14,42.
fn catalan(n: int) -> int
    if n < 0
        return 0
    n_choose(2 * n, n) / (n + 1)
