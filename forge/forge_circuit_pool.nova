// forge_circuit_pool — Connection pool management.
// Fixed-size pool with acquire/release, health tracking, max lifetime.

fn pool_new(max_size: int) -> dict
    let p = {}
    p["max_size"] = max_size
    p["connections"] = []
    p["available"] = []
    p["in_use"] = 0
    p["total_acquired"] = 0
    p["total_released"] = 0
    p["next_id"] = 1
    p

fn pool_create_conn(p: dict, label: string) -> dict
    if len(p["connections"]) >= p["max_size"]
        let r = {}
        r["pool"] = p
        r["conn_id"] = -1
        return r
    let conn = {}
    conn["id"] = p["next_id"]
    conn["label"] = label
    conn["status"] = "available"
    conn["uses"] = 0
    p["next_id"] = p["next_id"] + 1
    push(p["connections"], conn)
    push(p["available"], conn["id"])
    let r = {}
    r["pool"] = p
    r["conn_id"] = conn["id"]
    r

fn pool_acquire(p: dict) -> dict
    if len(p["available"]) == 0
        let r = {}
        r["pool"] = p
        r["conn_id"] = -1
        return r
    let conn_id = p["available"][0]
    let new_avail = []
    let i = 1
    while i < len(p["available"])
        push(new_avail, p["available"][i])
        i = i + 1
    p["available"] = new_avail
    p["in_use"] = p["in_use"] + 1
    p["total_acquired"] = p["total_acquired"] + 1
    let j = 0
    while j < len(p["connections"])
        if p["connections"][j]["id"] == conn_id
            p["connections"][j]["status"] = "in_use"
            p["connections"][j]["uses"] = p["connections"][j]["uses"] + 1
        j = j + 1
    let r = {}
    r["pool"] = p
    r["conn_id"] = conn_id
    r

fn pool_release(p: dict, conn_id: int) -> dict
    let j = 0
    while j < len(p["connections"])
        if p["connections"][j]["id"] == conn_id
            p["connections"][j]["status"] = "available"
        j = j + 1
    push(p["available"], conn_id)
    p["in_use"] = p["in_use"] - 1
    p["total_released"] = p["total_released"] + 1
    p

fn pool_size(p: dict) -> int
    len(p["connections"])

fn pool_available(p: dict) -> int
    len(p["available"])

fn pool_in_use(p: dict) -> int
    p["in_use"]

fn pool_stats(p: dict) -> dict
    let s = {}
    s["size"] = len(p["connections"])
    s["available"] = len(p["available"])
    s["in_use"] = p["in_use"]
    s["total_acquired"] = p["total_acquired"]
    s["total_released"] = p["total_released"]
    s
