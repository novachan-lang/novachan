// forge_access_log — HTTP access log with analysis.
// CLF-style entries, unique visitors, top paths, bandwidth.

fn al_new() -> dict
    let al = {}
    al["entries"] = []
    al["total_bytes"] = 0
    al

fn al_log(al: dict, ip: string, method: string, path: string, status: int, bytes_sent: int, user_agent: string) -> dict
    let entry = {}
    entry["ip"] = ip
    entry["method"] = method
    entry["path"] = path
    entry["status"] = status
    entry["bytes"] = bytes_sent
    entry["ua"] = user_agent
    push(al["entries"], entry)
    al["total_bytes"] = al["total_bytes"] + bytes_sent
    al

fn al_count(al: dict) -> int
    len(al["entries"])

fn al_total_bytes(al: dict) -> int
    al["total_bytes"]

fn al_unique_ips(al: dict) -> list
    let seen = {}
    let result = []
    let i = 0
    while i < len(al["entries"])
        let ip = al["entries"][i]["ip"]
        let has = contains(seen, ip)
        if has != true
            push(result, ip)
            seen[ip] = 1
        i += 1
    result

fn al_unique_ip_count(al: dict) -> int
    len(al_unique_ips(al))

fn al_by_path(al: dict, path: string) -> list
    let result = []
    let i = 0
    while i < len(al["entries"])
        if al["entries"][i]["path"] == path
            push(result, al["entries"][i])
        i += 1
    result

fn al_status_counts(al: dict) -> dict
    let counts = {}
    let i = 0
    while i < len(al["entries"])
        let s = str(al["entries"][i]["status"])
        let has = contains(counts, s)
        if has != true
            counts[s] = 0
        counts[s] = counts[s] + 1
        i += 1
    counts

fn al_error_rate(al: dict) -> int
    if len(al["entries"]) == 0
        return 0
    let errors = 0
    let i = 0
    while i < len(al["entries"])
        if al["entries"][i]["status"] >= 400
            errors += 1
        i += 1
    errors * 100 / len(al["entries"])
