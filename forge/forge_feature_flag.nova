// forge_feature_flag — Feature flag management.
// Percentage rollouts, user targeting, overrides, A/B testing.

fn ff_store() -> dict
    {"flags": {}, "overrides": {}}

fn ff_define(store: dict, name: string, enabled: bool) -> dict
    store["flags"][name] = {"enabled": enabled, "percentage": 100, "groups": [], "description": ""}
    store

fn ff_define_rollout(store: dict, name: string, percentage: int) -> dict
    store["flags"][name] = {"enabled": true, "percentage": percentage, "groups": [], "description": ""}
    store

fn ff_set_description(store: dict, name: string, desc: string) -> dict
    if contains(store["flags"], name)
        store["flags"][name]["description"] = desc
    store

fn ff_add_group(store: dict, name: string, group: string) -> dict
    if contains(store["flags"], name)
        push(store["flags"][name]["groups"], group)
    store

fn ff_override(store: dict, flag_name: string, user_id: string, enabled: bool) -> dict
    let key = flag_name + ":" + user_id
    store["overrides"][key] = enabled
    store

fn ff_is_enabled(store: dict, name: string) -> bool
    if not contains(store["flags"], name)
        return false
    let e = store["flags"][name]["enabled"]
    if e == true
        return true
    false

fn ff_is_enabled_for(store: dict, name: string, user_id: string) -> bool
    let override_key = name + ":" + user_id
    if contains(store["overrides"], override_key)
        let ov = store["overrides"][override_key]
        if ov == true
            return true
        return false
    if not contains(store["flags"], name)
        return false
    let flag = store["flags"][name]
    if flag["enabled"] != true
        return false
    let pct = flag["percentage"]
    if pct < 100
        let hash = _ff_hash(user_id)
        let bucket = hash % 100
        return bucket < pct
    true

fn ff_is_in_group(store: dict, name: string, group: string) -> bool
    if not contains(store["flags"], name)
        return false
    let groups = store["flags"][name]["groups"]
    let i = 0
    while i < len(groups)
        if groups[i] == group
            return true
        i = i + 1
    false

fn ff_toggle(store: dict, name: string) -> dict
    if contains(store["flags"], name)
        let cur = store["flags"][name]["enabled"]
        if cur == true
            store["flags"][name]["enabled"] = false
        else
            store["flags"][name]["enabled"] = true
    store

fn ff_list(store: dict) -> list
    let result = []
    let names = keys(store["flags"])
    let i = 0
    while i < len(names)
        let f = store["flags"][names[i]]
        push(result, {"name": names[i], "enabled": f["enabled"], "percentage": f["percentage"]})
        i = i + 1
    result

fn ff_remove(store: dict, name: string) -> dict
    if contains(store["flags"], name)
        delete(store["flags"], name)
    store

fn _ff_hash(s: string) -> int
    let h = 5381
    let i = 0
    while i < len(s)
        h = h * 33 + char_code(s, i)
        i = i + 1
    if h < 0
        h = 0 - h
    h
