// forge_levenshtein -- Levenshtein edit distance + similarity: the backbone of fuzzy search, "did you mean?"
// suggestions, typo-tolerant lookups, and near-duplicate detection. Classic DP distance (min single-char
// insert/delete/substitute edits to turn a into b), a normalized 0..100 similarity, and a best-match picker.
// O(len(a)*len(b)) time, O(len(b)) space (rolling row). LEAF -- imports NOTHING.

fn _lev_min3(a: int, b: int, c: int) -> int
    let m = a
    if b < m
        m = b
    if c < m
        m = c
    m

// Edit distance between two strings.
fn levenshtein(a: string, b: string) -> int
    let la = len(a)
    let lb = len(b)
    if la == 0
        return lb
    if lb == 0
        return la
    let prev = []
    let j = 0
    while j <= lb
        push(prev, j)
        j = j + 1
    let i = 1
    while i <= la
        let cur = []
        push(cur, i)
        let ca = char_at(a, i - 1)
        let k = 1
        while k <= lb
            let cost = 1
            if ca == char_at(b, k - 1)
                cost = 0
            push(cur, _lev_min3(prev[k] + 1, cur[k - 1] + 1, prev[k - 1] + cost))
            k = k + 1
        prev = cur
        i = i + 1
    prev[lb]

// Normalized similarity 0..100 (100 = identical): (maxlen - distance) / maxlen * 100.
fn levenshtein_similarity(a: string, b: string) -> int
    let mx = len(a)
    if len(b) > mx
        mx = len(b)
    if mx == 0
        return 100
    (mx - levenshtein(a, b)) * 100 / mx

// The candidate from `options` closest to `query` (lowest distance); "" if empty; ties -> first.
fn closest_match(query: string, options: list) -> string
    if len(options) == 0
        return ""
    let best = options[0]
    let best_d = levenshtein(query, options[0])
    let i = 1
    while i < len(options)
        let d = levenshtein(query, options[i])
        if d < best_d
            best_d = d
            best = options[i]
        i = i + 1
    best

// Typo-tolerant equality: is `a` within `max_dist` edits of `b`?
fn fuzzy_match(a: string, b: string, max_dist: int) -> bool
    levenshtein(a, b) <= max_dist
