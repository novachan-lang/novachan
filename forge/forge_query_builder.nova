// forge_query_builder — SQL query builder with Result.

fn qb_new(table: string) -> dict
    {"table": table, "selects": {}, "sel_count": 0, "wheres": {}, "where_count": 0, "order_by": "", "limit_val": 0}

fn qb_select(q: dict, field: string) -> dict
    q["selects"][str(q["sel_count"])] = field
    q["sel_count"] += 1
    q

fn qb_where(q: dict, field: string, op: string, value: string) -> dict
    let k = str(q["where_count"])
    q["wheres"]["{k}_field"] = field
    q["wheres"]["{k}_op"] = op
    q["wheres"]["{k}_value"] = value
    q["where_count"] += 1
    q

fn qb_order(q: dict, field: string) -> dict
    q["order_by"] = field
    q

fn qb_limit(q: dict, n: int) -> dict
    q["limit_val"] = n
    q

fn qb_build(q: dict) -> Result
    if q["sel_count"] == 0
        return err("no columns selected")
    let sql = "SELECT "
    for i in 0..q["sel_count"]
        if i > 0
            sql += ", "
        sql += q["selects"][str(i)]
    sql += " FROM " + q["table"]
    if q["where_count"] > 0
        sql += " WHERE "
        for i in 0..q["where_count"]
            if i > 0
                sql += " AND "
            let k = str(i)
            let field = q["wheres"]["{k}_field"]
            let op = q["wheres"]["{k}_op"]
            let value = q["wheres"]["{k}_value"]
            sql += "{field} {op} '{value}'"
    if q["order_by"] != ""
        sql += " ORDER BY " + q["order_by"]
    if q["limit_val"] > 0
        sql += " LIMIT " + str(q["limit_val"])
    ok(sql)
