// forge_query_builder — SQL query builder with Result.

fn qb_new(table: string) -> dict
    let q = {}
    q["table"] = table
    q["selects"] = {}
    q["sel_count"] = 0
    q["wheres"] = {}
    q["where_count"] = 0
    q["order_by"] = ""
    q["limit_val"] = 0
    q

fn qb_select(q: dict, field: string) -> dict
    q["selects"][str(q["sel_count"])] = field
    q["sel_count"] = q["sel_count"] + 1
    q

fn qb_where(q: dict, field: string, op: string, value: string) -> dict
    let k = str(q["where_count"])
    q["wheres"][k + "_field"] = field
    q["wheres"][k + "_op"] = op
    q["wheres"][k + "_value"] = value
    q["where_count"] = q["where_count"] + 1
    q

fn qb_order(q: dict, field: string) -> dict
    q["order_by"] = field
    q

fn qb_limit(q: dict, n: int) -> dict
    q["limit_val"] = n
    q

fn qb_build(q: dict) -> Result
    if q["sel_count"] == 0
        return err("no columns selected")
    let sql = "SELECT "
    let i = 0
    while i < q["sel_count"]
        if i > 0
            sql += ", "
        sql += q["selects"][str(i)]
        i += 1
    sql += " FROM " + q["table"]
    if q["where_count"] > 0
        sql += " WHERE "
        i = 0
        while i < q["where_count"]
            if i > 0
                sql += " AND "
            let k = str(i)
            sql += q["wheres"][k + "_field"] + " " + q["wheres"][k + "_op"] + " '" + q["wheres"][k + "_value"] + "'"
            i += 1
    if q["order_by"] != ""
        sql += " ORDER BY " + q["order_by"]
    if q["limit_val"] > 0
        sql += " LIMIT " + str(q["limit_val"])
    ok(sql)
