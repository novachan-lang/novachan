// forge_bigmath -- number theory on arbitrary-precision integers: GCD, LCM, and the MODULAR INVERSE, built on
// forge_bignum. The modular inverse (the x with a*x = 1 mod m) is the piece that unlocks real modular arithmetic:
// it's how RSA derives the private exponent from the public one, how you "divide" in modular fields, and how the
// Chinese Remainder Theorem and elliptic-curve math recombine results. It's computed with the extended Euclidean
// algorithm, but kept entirely in NON-NEGATIVE bignums by doing every subtraction MODULO m (so the coefficients
// never go negative -- forge_bignum has no sign). GCD/LCM are the classic Euclidean routines and work on numbers of
// any size (reducing fractions, finding common periods, simplifying ratios). Imports forge_bignum.

import forge_bignum

// The greatest common divisor of two non-negative bignums (Euclid). big_gcd(a,"0")=a.
fn big_gcd(a0: string, b0: string) -> string
    let x = a0
    let y = b0
    while big_cmp(y, "0") > 0
        let t = big_mod(x, y)
        x = y
        y = t
    _big_normish(x)

// PRIVATE: normalize by round-tripping through an add with zero (forge_bignum's _big_norm is private).
fn _big_normish(s: string) -> string
    big_add(s, "0")

// The least common multiple of two non-negative bignums: a / gcd(a,b) * b. big_lcm with a 0 operand is "0".
fn big_lcm(a0: string, b0: string) -> string
    let out = "0"
    if big_cmp(a0, "0") > 0 and big_cmp(b0, "0") > 0
        let g = big_gcd(a0, b0)
        out = big_mul(big_div(a0, g), b0)
    out

// PRIVATE: (x - y) mod m for x, y already in [0, m). Adds m when x < y so the result stays non-negative.
fn _bm_modsub(x: string, y: string, m: string) -> string
    let out = "0"
    if big_cmp(x, y) >= 0
        out = big_sub(x, y)
    else
        out = big_sub(big_add(x, m), y)
    out

// The modular inverse of a mod m: the value x in [1, m) with (a*x) mod m == 1, or "0" if a and m are not coprime
// (no inverse exists). Extended Euclidean kept in non-negative bignums via modular subtraction.
fn big_modinv(a0: string, m0: string) -> string
    let m = m0
    let t = "0"
    let newt = "1"
    let r = m
    let newr = big_mod(a0, m)
    while big_cmp(newr, "0") > 0
        let q = big_div(r, newr)
        // t, newt = newt, (t - q*newt) mod m
        let qn = big_mod(big_mul(q, newt), m)
        let tmp_t = _bm_modsub(t, qn, m)
        t = newt
        newt = tmp_t
        // r, newr = newr, r - q*newr
        let tmp_r = big_sub(r, big_mul(q, newr))
        r = newr
        newr = tmp_r
    let out = "0"
    if r == "1"
        out = t
    out
