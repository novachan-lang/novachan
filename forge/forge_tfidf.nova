// forge_tfidf -- thin wrapper over std/text/tfidf (canonical implementation).
import std/text/tfidf

fn tfidf_fit(documents: list) -> dict
    let n = len(documents)
    // document frequency: how many documents contain each term (count each term once per doc)
    let df = {}
    for d in 0..len(documents)
        let seen = {}
        let toks = documents[d]
        for t in 0..len(toks)
            let w = toks[t]
            if w not in seen
                seen[w] = 1
                df[w] = get(df, w, 0) + 1
    // idf = ln(N / df)
    let idf = {}
    let terms = keys(df)
    for i in 0..len(terms)
        let term = terms[i]
        let dfi = df[term]
        let val = 0.0
        if dfi > 0 and n > 0
            val = log((n * 1.0) / (dfi * 1.0))
        idf[term] = val
    idf

// Transform a document's tokens into its TF-IDF vector: a dict term -> weight (tf * idf). Terms unseen during
// fit (idf undefined) are treated as idf 0 and dropped.

// API MISMATCH, fixed. This delegated to std/text/tfidf's tf_vector(corpus, doc_index) -- which
// takes a CORPUS and an INDEX, not an idf map and a token list. So `corpus[doc_index]` evaluated
// `idf[tokens]`, a dict lookup keyed by a list, found nothing, and the function returned an
// EMPTY dict for every input. It never crashed, which is why it went unnoticed: keys(vec) was
// simply [] and the test's `contains(vec, "cat")` was legitimately false.
//
// Computed here instead, reusing tfidf_score -- every other function in this wrapper (fit,
// score, idf) is already implemented directly rather than delegating, so this is consistent
// with its siblings and cannot drift from std's signature again.
fn tfidf_vector(idf: dict, tokens: list) -> dict
    let out = {}
    let seen = {}
    for i in 0..len(tokens)
        let t = tokens[i]
        if t not in seen
            seen[t] = 1
            out[t] = tfidf_score(idf, tokens, t)
    out

fn tfidf_score(idf: dict, tokens: list, term: string) -> float
    let total = len(tokens)
    let out = 0.0
    if total > 0
        let count = 0
        for i in 0..len(tokens)
            if tokens[i] == term
                count += 1
        let tfv = (count * 1.0) / (total * 1.0)
        let idfv = get(idf, term, 0.0) * 1.0
        out = tfv * idfv
    out

// The IDF weight learned for a term (0.0 if unseen / appears in all documents).

fn tfidf_idf(idf: dict, term: string) -> float
    let v = get(idf, term, 0.0) * 1.0
    v

