// forge_tfidf -- TF-IDF term weighting: score how IMPORTANT a word is to a document within a collection. A word
// that appears often in one document but rarely across the collection is highly distinctive (high TF-IDF);
// a word like "the" that appears everywhere carries almost no signal (IDF -> 0). This is the backbone of search
// relevance ranking, keyword/tag extraction, "more like this" document similarity, and turning text into
// numeric vectors to feed forge_knn / forge_kmeans / forge_bayes. Two steps: fit the IDF weights over a corpus
// (a list of tokenized documents), then transform any document into its {term -> weight} vector. TF is the
// term's frequency within the document; IDF = ln(N / document-frequency). LEAF -- imports NOTHING.

// Fit inverse-document-frequency weights over a corpus (list of token lists). Returns a dict term -> idf.
// A term appearing in every document gets idf 0 (no discriminative value).
fn tfidf_fit(documents: list) -> dict
    let n = len(documents)
    // document frequency: how many documents contain each term (count each term once per doc)
    let df = {}
    for d in 0..len(documents)
        let seen = {}
        let toks = documents[d]
        for t in 0..len(toks)
            let w = toks[t]
            if w not in seen
                seen[w] = 1
                df[w] = get(df, w, 0) + 1
    // idf = ln(N / df)
    let idf = {}
    let terms = keys(df)
    for i in 0..len(terms)
        let term = terms[i]
        let dfi = df[term]
        let val = 0.0
        if dfi > 0 and n > 0
            val = log((n * 1.0) / (dfi * 1.0))
        idf[term] = val
    idf

// Transform a document's tokens into its TF-IDF vector: a dict term -> weight (tf * idf). Terms unseen during
// fit (idf undefined) are treated as idf 0 and dropped.
fn tfidf_vector(idf: dict, tokens: list) -> dict
    let vec = {}
    let total = len(tokens)
    if total > 0
        // term frequencies within the document
        let tf = {}
        for i in 0..len(tokens)
            let w = tokens[i]
            tf[w] = get(tf, w, 0) + 1
        let terms = keys(tf)
        for j in 0..len(terms)
            let term = terms[j]
            let tfv = (tf[term] * 1.0) / (total * 1.0)
            let idfv = get(idf, term, 0.0) * 1.0
            let weight = tfv * idfv
            vec[term] = weight
    vec

// The TF-IDF weight of a single term in a document (0.0 if absent or non-discriminative).
fn tfidf_score(idf: dict, tokens: list, term: string) -> float
    let total = len(tokens)
    let out = 0.0
    if total > 0
        let count = 0
        for i in 0..len(tokens)
            if tokens[i] == term
                count += 1
        let tfv = (count * 1.0) / (total * 1.0)
        let idfv = get(idf, term, 0.0) * 1.0
        out = tfv * idfv
    out

// The IDF weight learned for a term (0.0 if unseen / appears in all documents).
fn tfidf_idf(idf: dict, term: string) -> float
    let v = get(idf, term, 0.0) * 1.0
    v
