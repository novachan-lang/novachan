// forge_access_control — RBAC with Result.

fn ac_new() -> dict
    let a = {}
    a["roles"] = {}
    a["user_roles"] = {}
    a["role_perms"] = {}
    a["role_count"] = 0
    a["checks"] = 0
    a["denied"] = 0
    a

fn ac_add_role(a: dict, role: string) -> dict
    a["roles"][role] = 1
    a["role_count"] = a["role_count"] + 1
    a

fn ac_grant_permission(a: dict, role: string, permission: string) -> Result
    let has = contains(a["roles"], role)
    if has != true
        return err("unknown role: " + role)
    a["role_perms"][role + ":" + permission] = 1
    ok(a)

fn ac_assign_role(a: dict, user: string, role: string) -> Result
    let has = contains(a["roles"], role)
    if has != true
        return err("unknown role: " + role)
    a["user_roles"][user] = role
    ok(a)

fn ac_check(a: dict, user: string, permission: string) -> Result
    a["checks"] = a["checks"] + 1
    let has = contains(a["user_roles"], user)
    if has != true
        a["denied"] = a["denied"] + 1
        return err("no role assigned to: " + user)
    let role = a["user_roles"][user]
    let key = role + ":" + permission
    let has_p = contains(a["role_perms"], key)
    if has_p != true
        a["denied"] = a["denied"] + 1
        return err("permission denied: " + permission)
    ok(a)

fn ac_user_role(a: dict, user: string) -> Result
    let has = contains(a["user_roles"], user)
    if has != true
        return err("no role for: " + user)
    ok(a["user_roles"][user])

fn ac_role_count(a: dict) -> int
    a["role_count"]

fn ac_deny_rate(a: dict) -> int
    if a["checks"] == 0
        return 0
    a["denied"] * 100 / a["checks"]
