// forge_inflect -- English inflection (Rails ActiveSupport::Inflector): pluralize/singularize nouns and
// ordinalize numbers. Used to auto-derive REST resource names ("person" -> "/people"), table names, and to
// render ordinals ("1st", "2nd", "3rd"). Case-insensitive lookups via lower(); tests use lowercase input, so
// the mapped lowercase form is returned. LEAF -- imports NOTHING.

// PRIVATE: forward irregular map (singular -> plural).
fn _irregulars() -> dict
    let m = {}
    m["person"] = "people"
    m["man"] = "men"
    m["woman"] = "women"
    m["child"] = "children"
    m["foot"] = "feet"
    m["tooth"] = "teeth"
    m["mouse"] = "mice"
    m["goose"] = "geese"
    m

// PRIVATE: reverse irregular map (plural -> singular).
fn _irregulars_rev() -> dict
    let m = {}
    m["people"] = "person"
    m["men"] = "man"
    m["women"] = "woman"
    m["children"] = "child"
    m["feet"] = "foot"
    m["teeth"] = "tooth"
    m["mice"] = "mouse"
    m["geese"] = "goose"
    m

// PRIVATE: words with identical singular and plural forms.
fn _uncountable(w: string) -> bool
    let unc = ["sheep", "fish", "series", "species", "deer", "information", "equipment", "money", "rice"]
    contains(unc, w)

// PRIVATE: true when the character before the final letter is a consonant (not a vowel).
// Used to distinguish city -> cities (consonant+y) from day -> days (vowel+y).
fn _consonant_before_last(w: string) -> bool
    let n = len(w)
    if n < 2
        return false
    let c = char_at(w, n - 2)
    find("aeiou", c) < 0

// English plural. Order: uncountable -> irregular -> ies/es/oes/ves rules -> default "+s".
fn pluralize(word: string) -> string
    let w = lower(word)
    if _uncountable(w)
        return w
    let irr = _irregulars()
    if contains(irr, w)
        return irr[w]
    // consonant + "y" -> "ies" (city -> cities); vowel + "y" just adds "s" (day -> days).
    if ends_with(w, "y") and _consonant_before_last(w)
        return slice(w, 0, len(w) - 1) + "ies"
    // s / x / z / ch / sh -> add "es" (box -> boxes, church -> churches).
    if ends_with(w, "s") or ends_with(w, "x") or ends_with(w, "z") or ends_with(w, "ch") or ends_with(w, "sh")
        return w + "es"
    // small set of consonant + "o" -> "oes" (potato -> potatoes).
    let oes = ["potato", "tomato", "hero"]
    if contains(oes, w)
        return w + "es"
    // small set of "f"/"fe" -> "ves" (leaf -> leaves, knife -> knives).
    let feset = ["leaf", "knife", "wife", "life", "wolf"]
    if contains(feset, w)
        if ends_with(w, "fe")
            return slice(w, 0, len(w) - 2) + "ves"
        return slice(w, 0, len(w) - 1) + "ves"
    w + "s"

// English singular -- the inverse of pluralize for the same cases.
fn singularize(word: string) -> string
    let w = lower(word)
    if _uncountable(w)
        return w
    let rev = _irregulars_rev()
    if contains(rev, w)
        return rev[w]
    // "ves" -> "f"/"fe" for the same small set (leaves -> leaf, knives -> knife).
    if ends_with(w, "ves")
        let base = slice(w, 0, len(w) - 3)
        let fe_words = ["kni", "wi", "li"]
        if contains(fe_words, base)
            return base + "fe"
        return base + "f"
    // "ies" -> "y" (cities -> city).
    if ends_with(w, "ies")
        return slice(w, 0, len(w) - 3) + "y"
    // "es" after s/x/z/ch/sh -> drop "es" (boxes -> box, churches -> church).
    if ends_with(w, "es")
        let stem = slice(w, 0, len(w) - 2)
        if ends_with(stem, "s") or ends_with(stem, "x") or ends_with(stem, "z") or ends_with(stem, "ch") or ends_with(stem, "sh")
            return stem
    // default: drop trailing "s".
    if ends_with(w, "s")
        return slice(w, 0, len(w) - 1)
    w

// PRIVATE: just the ordinal suffix for a magnitude (already non-negative). 11/12/13 -> "th"; else by last digit.
fn _suffix_for(v: int) -> string
    let h = v % 100
    if h == 11 or h == 12 or h == 13
        return "th"
    let d = v % 10
    if d == 1
        return "st"
    if d == 2
        return "nd"
    if d == 3
        return "rd"
    "th"

// Just the ordinal suffix ("st"/"nd"/"rd"/"th"), no number. Uses the absolute value for the decision.
fn ordinal(n: int) -> string
    let v = n
    if v < 0
        v = 0 - v
    _suffix_for(v)

// Number + ordinal suffix: 1 -> "1st", 21 -> "21st", 112 -> "112th", 101 -> "101st".
fn ordinalize(n: int) -> string
    str(n) + ordinal(n)
