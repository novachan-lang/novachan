// forge_inflect -- English inflection (Rails ActiveSupport::Inflector): pluralize/singularize nouns and
// ordinalize numbers. Used to auto-derive REST resource names ("person" -> "/people"), table names, and to
// render ordinals ("1st", "2nd", "3rd"). Case-insensitive lookups via lower(); tests use lowercase input, so
// the mapped lowercase form is returned. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four changes, all behaviour-preserving:
//   1. The irregular tables were eight `m[k] = v` statements each; the forward table is now a dict LITERAL,
//      and the reverse table is DERIVED from it by a dict comprehension instead of being a second hand-typed
//      copy. Two hand-maintained lists of the same eight pairs was a correctness hazard -- adding "ox"/"oxen"
//      to one and forgetting the other would have made pluralize and singularize disagree. Now it cannot.
//   2. The "does it end in s/x/z/ch/sh" test was spelled out as a five-way `or` chain in BOTH pluralize and
//      singularize. It is one `_ends_any(w, _sibilant_suffixes())` call over one shared suffix list.
//   3. `_suffix_for`'s if-ladder over the last digit is a list INDEXED by that digit -- the ladder was a
//      lookup table written as control flow.
//   4. `ordinal` uses the `abs` builtin instead of a hand-rolled negate, and `ordinalize` interpolates.
// No rule, no ordering, and no output changed.

// PRIVATE: forward irregular map (singular -> plural).
fn _irregulars() -> dict
    {"person": "people", "man": "men", "woman": "women", "child": "children", "foot": "feet", "tooth": "teeth", "mouse": "mice", "goose": "geese"}

// PRIVATE: reverse irregular map (plural -> singular) -- the forward map inverted, so the two can never drift.
fn _irregulars_rev() -> dict
    let fwd = _irregulars()
    {fwd[k]: k for k in keys(fwd)}

// PRIVATE: words with identical singular and plural forms.
fn _uncountable(w: string) -> bool
    let unc = ["sheep", "fish", "series", "species", "deer", "information", "equipment", "money", "rice"]
    contains(unc, w)

// PRIVATE: the sibilant endings that take "es" in the plural (box -> boxes, church -> churches).
// One list, used by BOTH pluralize (on the word) and singularize (on the de-"es"'d stem).
fn _sibilant_suffixes() -> list
    ["s", "x", "z", "ch", "sh"]

// PRIVATE: does w end with ANY of these suffixes? (`ends_with` is pure, so testing them all is the same
// answer the short-circuiting `or` chain gave.)
fn _ends_any(w: string, suffixes: list) -> bool
    any([ends_with(w, sfx) for sfx in suffixes])

// PRIVATE: true when the character before the final letter is a consonant (not a vowel).
// Used to distinguish city -> cities (consonant+y) from day -> days (vowel+y).
fn _consonant_before_last(w: string) -> bool
    let n = len(w)
    if n < 2
        return false
    let c = char_at(w, n - 2)
    find("aeiou", c) < 0

// English plural. Order: uncountable -> irregular -> ies/es/oes/ves rules -> default "+s".
fn pluralize(word: string) -> string
    let w = lower(word)
    if _uncountable(w)
        return w
    let irr = _irregulars()
    if w in irr
        return irr[w]
    // consonant + "y" -> "ies" (city -> cities); vowel + "y" just adds "s" (day -> days).
    if ends_with(w, "y") and _consonant_before_last(w)
        return slice(w, 0, len(w) - 1) + "ies"
    // s / x / z / ch / sh -> add "es" (box -> boxes, church -> churches).
    if _ends_any(w, _sibilant_suffixes())
        return w + "es"
    // small set of consonant + "o" -> "oes" (potato -> potatoes).
    let oes = ["potato", "tomato", "hero"]
    if w in oes
        return w + "es"
    // small set of "f"/"fe" -> "ves" (leaf -> leaves, knife -> knives).
    let feset = ["leaf", "knife", "wife", "life", "wolf"]
    if w in feset
        if ends_with(w, "fe")
            return slice(w, 0, len(w) - 2) + "ves"
        return slice(w, 0, len(w) - 1) + "ves"
    w + "s"

// English singular -- the inverse of pluralize for the same cases.
fn singularize(word: string) -> string
    let w = lower(word)
    if _uncountable(w)
        return w
    let rev = _irregulars_rev()
    if w in rev
        return rev[w]
    // "ves" -> "f"/"fe" for the same small set (leaves -> leaf, knives -> knife).
    if ends_with(w, "ves")
        let base = slice(w, 0, len(w) - 3)
        let fe_words = ["kni", "wi", "li"]
        if base in fe_words
            return base + "fe"
        return base + "f"
    // "ies" -> "y" (cities -> city).
    if ends_with(w, "ies")
        return slice(w, 0, len(w) - 3) + "y"
    // "es" after s/x/z/ch/sh -> drop "es" (boxes -> box, churches -> church).
    if ends_with(w, "es")
        let stem = slice(w, 0, len(w) - 2)
        if _ends_any(stem, _sibilant_suffixes())
            return stem
    // default: drop trailing "s".
    if ends_with(w, "s")
        return slice(w, 0, len(w) - 1)
    w

// PRIVATE: just the ordinal suffix for a magnitude (already non-negative). 11/12/13 -> "th"; else by last digit.
// The last-digit rule IS a lookup table, so it is written as one instead of as an if-ladder.
fn _suffix_for(v: int) -> string
    let h = v % 100
    if h == 11 or h == 12 or h == 13
        return "th"
    let by_last_digit = ["th", "st", "nd", "rd", "th", "th", "th", "th", "th", "th"]
    by_last_digit[v % 10]

// Just the ordinal suffix ("st"/"nd"/"rd"/"th"), no number. Uses the absolute value for the decision.
fn ordinal(n: int) -> string
    _suffix_for(abs(n))

// Number + ordinal suffix: 1 -> "1st", 21 -> "21st", 112 -> "112th", 101 -> "101st".
fn ordinalize(n: int) -> string
    let sfx = ordinal(n)
    "{n}{sfx}"
