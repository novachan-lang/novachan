// forge_closestpair -- find the two points that are CLOSEST together among a set, in O(n log n) via divide and
// conquer. The obvious approach compares all pairs (O(n^2)); the classic trick splits the points by x, solves each
// half, and then only has to check a thin vertical STRIP around the divide -- where, remarkably, each point can
// have at most a handful of neighbors closer than the best distance found so far, so the merge stays linear. This
// is a staple of computational geometry with very practical uses: collision/proximity detection, de-duplicating
// near-identical coordinates, finding the two nearest cities/stations/sensors, and clustering seeds. To stay exact
// and float-free it works in SQUARED distances (comparing d^2 avoids square roots and rounding); take the integer
// square root of the result for the actual distance. Points are [x, y] integer pairs. LEAF -- imports NOTHING.

// PRIVATE: large sentinel.
fn _cp_big() -> int
    4611686018427387904

// PRIVATE: squared Euclidean distance between two [x,y] points.
fn _cp_d2(a: list, b: list) -> int
    let dx = a[0] - b[0]
    let dy = a[1] - b[1]
    dx * dx + dy * dy

// PRIVATE: recursive closest pair over indices idx[lo..hi) (idx sorted by x). Returns min squared distance.
fn _cp_rec(points: list, idx: list, lo: int, hi: int) -> int
    let cnt = hi - lo
    let best = _cp_big()
    if cnt <= 3
        let i = lo
        while i < hi
            let j = i + 1
            while j < hi
                let d = _cp_d2(points[idx[i]], points[idx[j]])
                if d < best
                    best = d
                j += 1
            i += 1
    else
        let mid = (lo + hi) / 2
        let midx = points[idx[mid]][0]
        let dl = _cp_rec(points, idx, lo, mid)
        let dr = _cp_rec(points, idx, mid, hi)
        best = dl
        if dr < best
            best = dr
        // build the strip: indices whose x is within sqrt(best) of the divide
        let strip = []
        let k = lo
        while k < hi
            let dx = points[idx[k]][0] - midx
            if dx * dx < best
                push(strip, idx[k])
            k += 1
        // sort strip by y (index array -> scalar int moves, safe)
        for a in 1..len(strip)
            let key = strip[a]
            let b = a - 1
            while b >= 0 and points[strip[b]][1] > points[key][1]
                strip[b + 1] = strip[b]
                b -= 1
            strip[b + 1] = key
        // each point need only look at the next few in y until the y-gap alone exceeds best
        for s in 0..len(strip)
            let t = s + 1
            let stop = false
            while t < len(strip) and not stop
                let ddy = points[strip[t]][1] - points[strip[s]][1]
                if ddy * ddy < best
                    let dd = _cp_d2(points[strip[s]], points[strip[t]])
                    if dd < best
                        best = dd
                    t += 1
                else
                    stop = true
    best

// The squared distance between the two closest points (-1 if fewer than two points). Take the integer square root
// for the actual distance.
fn closest_pair_dist2(points: list) -> int
    let n = len(points)
    let out = -1
    if n >= 2
        // index array sorted by x
        let idx = [i for i in 0..n]
        for a in 1..n
            let key = idx[a]
            let b = a - 1
            while b >= 0 and points[idx[b]][0] > points[key][0]
                idx[b + 1] = idx[b]
                b -= 1
            idx[b + 1] = key
        out = _cp_rec(points, idx, 0, n)
    out
