// forge_log_analyzer — Log ingestion, level/source counting, pattern
// signals (Ops).
//
// STATE SHAPE (flat dict, no nesting):
//   state["total"]            — int, total entries ingested.
//   state["cnt_info"/"cnt_warn"/"cnt_error"/"cnt_fatal"] — int, per-level counts.
//   state["last_error"]       — string, message of the most recent error/fatal entry.
//   state["has_fatal"]        — int, 1 if any fatal entry was ever ingested.
//   state["src_"+source]      — int, entries ingested from `source`.
//   state["e_"+index]         — string, "level:message" for entry `index`.
//   state["entry_count"]      — int, number of stored entries (== total).
//
// LEAF MODULE — imports nothing; only NOVA builtins: contains/str/ok/err.

// la_new() -> dict
// Create an empty log analyzer.
fn la_new() -> dict
    {"total": 0, "cnt_info": 0, "cnt_warn": 0, "cnt_error": 0, "cnt_fatal": 0, "last_error": "", "has_fatal": 0, "entry_count": 0}

// la_ingest(state, level, message, source) -> dict
// Ingest a log entry. level: "info"/"warn"/"error"/"fatal" (anything else
// is counted in `total` and stored but not bucketed by level).
fn la_ingest(state: dict, level: string, message: string, source: string) -> dict
    state["total"] += 1
    if level == "info"
        state["cnt_info"] += 1
    else if level == "warn"
        state["cnt_warn"] += 1
    else if level == "error"
        state["cnt_error"] += 1
        state["last_error"] = message
    else if level == "fatal"
        state["cnt_fatal"] += 1
        state["last_error"] = message
        state["has_fatal"] = 1
    let sk = "src_{source}"
    if sk not in state
        state[sk] = 0
    state[sk] += 1
    let ec = state["entry_count"]
    let ek = "e_{ec}"
    state[ek] = "{level}:{message}"
    state["entry_count"] += 1
    state

// la_count_by_level(state, level) -> int
fn la_count_by_level(state: dict, level: string) -> int
    if level == "info"
        return state["cnt_info"]
    if level == "warn"
        return state["cnt_warn"]
    if level == "error"
        return state["cnt_error"]
    if level == "fatal"
        return state["cnt_fatal"]
    0

// la_total_entries(state) -> int
fn la_total_entries(state: dict) -> int
    state["total"]

// la_error_rate(state) -> Result
// ok(percentage of entries that were error or fatal), or err if empty.
fn la_error_rate(state: dict) -> Result
    if state["total"] == 0
        return err("no entries")
    let bad = state["cnt_error"] + state["cnt_fatal"]
    ok(bad * 100 / state["total"])

// la_last_error(state) -> Result
// ok(message of most recent error/fatal entry), or err if none seen.
fn la_last_error(state: dict) -> Result
    if state["last_error"] == ""
        return err("no errors recorded")
    ok(state["last_error"])

// la_source_count(state, source) -> int
fn la_source_count(state: dict, source: string) -> int
    let sk = "src_{source}"
    if sk not in state
        return 0
    state[sk]

// la_has_fatal(state) -> int
fn la_has_fatal(state: dict) -> int
    state["has_fatal"]

// la_entry_at(state, index) -> Result
// ok("level:message") for the entry ingested at position `index`
// (0-based, ingestion order), or err if out of bounds.
fn la_entry_at(state: dict, index: int) -> Result
    if index < 0
        return err("index out of bounds")
    if index >= state["entry_count"]
        return err("index out of bounds")
    ok(state["e_{index}"])
