// forge_data_classifier — Data sensitivity classification (Sentinel).
// Register classification levels (public/internal/confidential/restricted),
// tag data items against them, and query sensitivity.
//
// STATE SHAPE (flat dict, no nesting):
//   state["lvl_"+class_name]  — int, sensitivity level registered for class_name.
//   state["cls_"+data_id]     — string, class_name assigned to data_id.
//   state["ids"]              — string, comma-separated list of every
//                                classified data_id (enables level scans).
//   state["class_count"]      — int, number of distinct classes registered.
//   state["data_count"]       — int, number of distinct data items classified.
//
// LEAF MODULE — imports nothing; only NOVA builtins: contains/split/ok/err.

// dc_new() -> dict
// Create an empty classifier.
fn dc_new() -> dict
    let s = {}
    s["class_count"] = 0
    s["data_count"] = 0
    s["ids"] = ""
    s

// dc_add_class(state, class_name, level) -> dict
// Register a classification level (1=public, 2=internal, 3=confidential,
// 4=restricted). Re-adding an existing class_name updates its level.
fn dc_add_class(state: dict, class_name: string, level: int) -> dict
    let lk = "lvl_" + class_name
    if contains(state, lk) != true
        state["class_count"] = state["class_count"] + 1
    state[lk] = level
    state

// dc_classify(state, data_id, class_name) -> Result
// ok(state), or err("unknown class") if class_name was never registered.
fn dc_classify(state: dict, data_id: string, class_name: string) -> Result
    let lk = "lvl_" + class_name
    if contains(state, lk) != true
        return err("unknown class: " + class_name)
    let ck = "cls_" + data_id
    if contains(state, ck) != true
        state["data_count"] = state["data_count"] + 1
        if state["ids"] == ""
            state["ids"] = data_id
        else
            state["ids"] = state["ids"] + "," + data_id
    state[ck] = class_name
    ok(state)

// dc_get_class(state, data_id) -> Result
// ok(class_name), or err if data_id was never classified.
fn dc_get_class(state: dict, data_id: string) -> Result
    let ck = "cls_" + data_id
    if contains(state, ck) != true
        return err("not classified: " + data_id)
    ok(state[ck])

// dc_get_level(state, data_id) -> Result
// ok(level), or err if data_id was never classified.
fn dc_get_level(state: dict, data_id: string) -> Result
    let ck = "cls_" + data_id
    if contains(state, ck) != true
        return err("not classified: " + data_id)
    let cname = state[ck]
    ok(state["lvl_" + cname])

// dc_count_at_level(state, level) -> int
// Count classified items currently at exactly `level`.
fn dc_count_at_level(state: dict, level: int) -> int
    if state["data_count"] == 0
        return 0
    let ids = split(state["ids"], ",")
    let n = len(ids)
    let count = 0
    let i = 0
    while i < n
        let did = ids[i]
        let cname = state["cls_" + did]
        let lvl = state["lvl_" + cname]
        if lvl == level
            count = count + 1
        i = i + 1
    count

// dc_class_count(state) -> int
fn dc_class_count(state: dict) -> int
    state["class_count"]

// dc_data_count(state) -> int
fn dc_data_count(state: dict) -> int
    state["data_count"]

// dc_is_restricted(state, data_id) -> Result
// ok(1) if the item's level is >= 3 (confidential/restricted), ok(0)
// otherwise, or err if data_id was never classified.
fn dc_is_restricted(state: dict, data_id: string) -> Result
    let ck = "cls_" + data_id
    if contains(state, ck) != true
        return err("not classified: " + data_id)
    let cname = state[ck]
    let lvl = state["lvl_" + cname]
    if lvl >= 3
        return ok(1)
    ok(0)
