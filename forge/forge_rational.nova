// forge_rational -- EXACT rational-number (fraction) arithmetic. Floating point can't represent 1/3 or 1/10, so
// sums like 0.1 + 0.2 drift to 0.30000000000000004; rationals store a number as an exact numerator/denominator
// pair and stay perfectly precise -- 1/3 + 1/6 is exactly 1/2, never 0.4999999. Every result is automatically
// reduced to lowest terms with a positive denominator (the sign lives in the numerator), so equal values have one
// canonical form and comparisons are exact. Use this wherever rounding is unacceptable: money and tax splits,
// probabilities and odds, music/gear ratios, symbolic math, and anywhere NOVA's float edge cases would bite. A
// rational is a two-element list [numerator, denominator]. (Numerators/denominators are 64-bit; for astronomically
// large fractions compose with forge_bignum.) LEAF -- imports NOTHING.

// PRIVATE: gcd of the absolute values (>= 0).
fn _rat_gcd(a: int, b: int) -> int
    let x = a
    if x < 0
        x = -x
    let y = b
    if y < 0
        y = -y
    while y != 0
        let t = x % y
        x = y
        y = t
    x

// Construct the reduced fraction n/d (d must be non-zero). Sign is normalized onto the numerator.
fn rat(n: int, d: int) -> list
    let nn = n
    let dd = d
    if dd < 0
        nn = -nn
        dd = -dd
    let g = _rat_gcd(nn, dd)
    if g == 0
        g = 1
    [nn / g, dd / g]

// A whole number as a rational n/1.
fn rat_from_int(n: int) -> list
    [n, 1]

// Numerator and denominator accessors.
fn rat_num(r: list) -> int
    r[0]

fn rat_den(r: list) -> int
    r[1]

// a + b.
fn rat_add(a: list, b: list) -> list
    let g = _rat_gcd(a[1], b[1])
    let num = a[0] * (b[1] / g) + b[0] * (a[1] / g)
    let den = (a[1] / g) * b[1]
    rat(num, den)

// a - b.
fn rat_sub(a: list, b: list) -> list
    let g = _rat_gcd(a[1], b[1])
    let num = a[0] * (b[1] / g) - b[0] * (a[1] / g)
    let den = (a[1] / g) * b[1]
    rat(num, den)

// a * b.
fn rat_mul(a: list, b: list) -> list
    rat(a[0] * b[0], a[1] * b[1])

// a / b (b must be non-zero).
fn rat_div(a: list, b: list) -> list
    rat(a[0] * b[1], a[1] * b[0])

// -a.
fn rat_neg(a: list) -> list
    [-a[0], a[1]]

// |a|.
fn rat_abs(a: list) -> list
    let n = a[0]
    if n < 0
        n = -n
    [n, a[1]]

// 1/a (reciprocal; a must be non-zero).
fn rat_recip(a: list) -> list
    rat(a[1], a[0])

// Compare a and b: -1 if a<b, 0 if equal, 1 if a>b. Exact (cross-multiplies; denominators are positive).
fn rat_cmp(a: list, b: list) -> int
    let left = a[0] * b[1]
    let right = b[0] * a[1]
    if left < right
        return -1
    if left > right
        return 1
    0

// True if a == b.
fn rat_eq(a: list, b: list) -> bool
    rat_cmp(a, b) == 0

// Render as "n/d", or just "n" when the denominator is 1.
fn rat_to_str(r: list) -> string
    (str(r[0]) + "/" + str(r[1])) if r[1] != 1 else str(r[0])
