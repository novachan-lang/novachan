// forge_protocol_buffer — Simple protobuf-like message builder.

fn pb_new() -> dict
    let p = {}
    p["fields"] = {}
    p["field_count"] = 0
    p

fn pb_set_int(p: dict, field_num: int, value: int) -> dict
    let k = str(field_num)
    p["fields"][k + "_type"] = "int"
    p["fields"][k + "_int"] = value
    let already = contains(p["fields"], k + "_exists")
    if already != true
        p["field_count"] = p["field_count"] + 1
    p["fields"][k + "_exists"] = 1
    p

fn pb_set_string(p: dict, field_num: int, value: string) -> dict
    let k = str(field_num)
    p["fields"][k + "_type"] = "string"
    p["fields"][k + "_str"] = value
    let already = contains(p["fields"], k + "_exists")
    if already != true
        p["field_count"] = p["field_count"] + 1
    p["fields"][k + "_exists"] = 1
    p

fn pb_get_int(p: dict, field_num: int) -> int
    let k = str(field_num)
    let has = contains(p["fields"], k + "_exists")
    if has != true
        return 0
    p["fields"][k + "_int"]

fn pb_get_string(p: dict, field_num: int) -> string
    let k = str(field_num)
    let has = contains(p["fields"], k + "_exists")
    if has != true
        return ""
    p["fields"][k + "_str"]

fn pb_has_field(p: dict, field_num: int) -> int
    let has = contains(p["fields"], str(field_num) + "_exists")
    if has == true
        return 1
    0

fn pb_field_type(p: dict, field_num: int) -> string
    let has = contains(p["fields"], str(field_num) + "_exists")
    if has != true
        return ""
    p["fields"][str(field_num) + "_type"]

fn pb_field_count(p: dict) -> int
    p["field_count"]
