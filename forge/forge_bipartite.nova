// forge_bipartite -- can a graph be split into TWO groups so that every edge goes between the groups (never
// within one)? That's a bipartite graph, and the two-coloring that proves it. It answers real feasibility
// questions: can these tasks be scheduled in two shifts with no conflicts, can items be sorted into two bins so
// no forbidden pair shares a bin, is a "who-likes-whom" or job-applicant graph a clean two-sided matching, is a
// map two-colorable along its borders? A graph is bipartite exactly when it has NO odd-length cycle; this
// BFS-two-colors it, assigning each node 0 or 1 and flagging any edge whose endpoints would clash. Edges are
// [u, v] UNDIRECTED with string node ids. LEAF -- imports NOTHING.

// PRIVATE: distinct node ids.
fn _bp_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    for i in 0..len(edges)
        let u = edges[i][0]
        if u in seen == false
            seen[u] = 1
            push(nodes, u)
        let v = edges[i][1]
        if v in seen == false
            seen[v] = 1
            push(nodes, v)
    nodes

// PRIVATE: undirected adjacency (both directions).
fn _bp_adj(edges: list, nodes: list) -> dict
    let adj = {}
    for i in 0..len(nodes)
        adj[nodes[i]] = []
    for e in 0..len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        push(adj[u], v)
        push(adj[v], u)
    adj

// A 2-coloring of the graph as a dict node -> 0/1 such that no edge joins two same-colored nodes, or null if the
// graph is NOT bipartite (has an odd cycle).
fn bipartite_coloring(edges: list) -> dict
    let nodes = _bp_nodes(edges)
    let adj = _bp_adj(edges, nodes)
    let color = {}
    let ok = true
    for ni in 0..len(nodes)
        let start = nodes[ni]
        if start in color == false
            color[start] = 0
            let queue = []
            push(queue, start)
            let qi = 0
            while qi < len(queue)
                let v = queue[qi]
                qi += 1
                let cv = color[v]
                let nb = adj[v]
                let j = 0
                while j < len(nb)
                    let w = nb[j]
                    if w in color == false
                        color[w] = 1 - cv
                        push(queue, w)
                    else
                        if color[w] == cv
                            ok = false
                    j += 1
    let out = null
    if ok
        out = color
    out

// True if the graph is bipartite (two-colorable / has no odd cycle).
fn is_bipartite(edges: list) -> bool
    bipartite_coloring(edges) != null
