// forge_bipartite -- bipartite graph check via BFS two-coloring. Edges are [u, v] undirected with string
// node ids. LEAF -- imports NOTHING.

fn _bp_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    for edge in edges
        let u = edge[0]
        if u not in seen
            seen[u] = 1
            push(nodes, u)
        let v = edge[1]
        if v not in seen
            seen[v] = 1
            push(nodes, v)
    nodes

fn _bp_adj(edges: list, nodes: list) -> dict
    let adj = {}
    for nd in nodes
        adj[nd] = []
    for edge in edges
        let u = edge[0]
        let v = edge[1]
        push(adj[u], v)
        push(adj[v], u)
    adj

fn bipartite_coloring(edges: list) -> dict
    let nodes = _bp_nodes(edges)
    let adj = _bp_adj(edges, nodes)
    let color = {}
    let ok = true
    for ni in 0..len(nodes)
        let start = nodes[ni]
        if start not in color
            color[start] = 0
            let queue = [start]
            let qi = 0
            while qi < len(queue)
                let v = queue[qi]
                qi += 1
                let cv = color[v]
                for w in adj[v]
                    if w not in color
                        color[w] = 1 - cv
                        push(queue, w)
                    else if color[w] == cv
                        ok = false
    color if ok else null

fn is_bipartite(edges: list) -> bool
    bipartite_coloring(edges) != null
