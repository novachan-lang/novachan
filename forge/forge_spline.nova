// forge_spline -- Catmull-Rom spline interpolation. Unlike a Bezier (which is pulled TOWARD its control
// points), a Catmull-Rom spline passes exactly THROUGH its control points, which is what you want for camera
// paths, waypoint following, smoothing a series of sampled data points, and animation keyframes: give it the
// points and it makes a smooth curve that hits every one. A segment is defined by four consecutive points
// P0..P3 and interpolates between P1 (t=0) and P2 (t=1). Points are [x, y]. Companion to forge_bezier. LEAF.
//
// Per-axis value is accumulated into `let` locals before the final scale (sound near the float-return edge).

// PRIVATE: one-axis Catmull-Rom (uniform, tension 0.5): 0.5*(2b + (-a+c)t + (2a-5b+4c-d)t^2 + (-a+3b-3c+d)t^3).
fn _cr_axis(a: float, b: float, c: float, d: float, t: float) -> float
    let t2 = t * t
    let t3 = t2 * t
    let v0 = 2.0 * b
    let v1 = (-a + c) * t
    let v2 = (2.0 * a - 5.0 * b + 4.0 * c - d) * t2
    let v3 = (-a + 3.0 * b - 3.0 * c + d) * t3
    let sum = v0 + v1 + v2 + v3
    let result = 0.5 * sum
    result

// Interpolate a point on the Catmull-Rom segment through P1..P2 (with P0, P3 as the neighboring tangents),
// t in [0,1]. t=0 -> P1, t=1 -> P2.
fn catmull_rom(p0: list, p1: list, p2: list, p3: list, t: float) -> list
    let x = _cr_axis(p0[0] * 1.0, p1[0] * 1.0, p2[0] * 1.0, p3[0] * 1.0, t)
    let y = _cr_axis(p0[1] * 1.0, p1[1] * 1.0, p2[1] * 1.0, p3[1] * 1.0, t)
    [x, y]

// Sample a Catmull-Rom segment into `n` points (n>=2) evenly in t from P1 to P2 -- ready to draw as a polyline.
fn catmull_rom_path(p0: list, p1: list, p2: list, p3: list, n: int) -> list
    let out = []
    if n < 2
        push(out, [p1[0] * 1.0, p1[1] * 1.0])
        return out
    for i in 0..n
        let t = (i * 1.0) / ((n - 1) * 1.0)
        push(out, catmull_rom(p0, p1, p2, p3, t))
    out
