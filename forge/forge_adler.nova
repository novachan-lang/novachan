// forge_adler -- fast integrity checksums: Adler-32 (the one zlib/gzip use) and Fletcher-16. A checksum turns
// data into a short number so you can detect accidental corruption -- a flipped bit in a download, a garbled
// packet, a bad disk read -- by recomputing it and comparing. Adler-32 and Fletcher are position-sensitive (they
// catch reordering, unlike a plain byte sum) and much cheaper to compute than CRC-32 (forge_crc32) or a
// cryptographic hash, which is why zlib chose Adler-32 for every compressed block. Use them for cheap error
// detection on streams/files/messages where you need to notice damage, not defend against a malicious forger
// (for that use an HMAC). Input is a string (bytes via character codes). LEAF -- imports NOTHING.

// Adler-32 checksum of a string (the algorithm zlib appends to every deflate stream). Returns a 32-bit integer.
fn adler32(s: string) -> int
    let mod_adler = 65521
    let a = 1
    let b = 0
    let i = 0
    while i < len(s)
        a = (a + ord(char_at(s, i))) % mod_adler
        b = (b + a) % mod_adler
        i = i + 1
    (b << 16) + a

// Fletcher-16 checksum of a string. Returns a 16-bit integer.
fn fletcher16(s: string) -> int
    let sum1 = 0
    let sum2 = 0
    let i = 0
    while i < len(s)
        sum1 = (sum1 + ord(char_at(s, i))) % 255
        sum2 = (sum2 + sum1) % 255
        i = i + 1
    (sum2 << 8) + sum1

// True if `data` still matches a previously-computed Adler-32 checksum (an integrity check).
fn adler32_verify(s: string, expected: int) -> bool
    adler32(s) == expected
