// forge_blossom -- Edmonds' Blossom algorithm for MAXIMUM MATCHING in a GENERAL (non-bipartite) graph.
// forge_bimatch and forge_hopcroftkarp only handle BIPARTITE graphs; general graphs have ODD CYCLES,
// which break the augmenting-path search (Berge's lemma still holds -- a matching is maximum iff it has
// no augmenting path -- but naive BFS can get confused by odd cycles). Edmonds' 1965 insight (the first
// polynomial algorithm for a problem that looked exponential, and a founding result of combinatorial
// optimization) is the BLOSSOM: when the alternating-tree search finds an odd cycle, CONTRACT it to a
// single super-vertex, continue the search in the smaller graph, and later EXPAND it to recover the real
// augmenting path. This finds a maximum matching in O(V^3). Applications: pairing tasks/people with mutual
// (symmetric) compatibility, chemistry (perfect matchings = Kekule structures), round-robin tournament
// scheduling, sensor/network pairing, and any matching where no bipartite left/right split exists.
//
// Graph: n vertices 0..n-1, undirected edges [[a,b],...]. Returns match[] where match[v] = the vertex
// matched to v, or -1 if v is unmatched. This is the classic BFS-forest implementation (e-maxx style)
// using per-search arrays: p[] (parent in the alternating forest), base[] (blossom base of each vertex),
// used[] (vertex is an OUTER/even node of the forest). Blossoms are handled by relabeling bases via the
// LCA of the two endpoints of the odd edge -- no explicit graph contraction.
//
// API:
//   blossom_max_matching(n, edges) -> list   match[] array (match[v] = partner or -1)
//   blossom_matching_size(n, edges) -> int   number of matched EDGES (matched vertices / 2)
// LEAF (imports nothing).
//
// RAISED 2026-08-05. This is a stateful graph algorithm, so the raise is deliberately conservative: the
// SEARCH keeps its loops (they are worklists and data-dependent walks and are each labelled below), while
// every loop that was only ALLOCATING or COUNTING became the construct it actually is. Concretely:
// the six `let i = 0 / while i < n / i = i + 1` array initialisers are comprehensions
// (`[-1 for k in 0..n]`, `[[] for k in 0..n]`), the two edge scans are `for ed in edges` instead of
// index arithmetic, the counting loop in blossom_matching_size is a filtered comprehension, and the
// `done`/`searching` boolean flags in _bl_lca are gone -- the loop conditions now say directly what they
// were emulating. No traversal order, no tie-break, and no array contents changed.

fn _bl_build_adj(n: int, edges: list) -> list
    // one FRESH adjacency list per vertex (a comprehension evaluates `[]` per iteration, so these are
    // n independent lists, not n aliases of one)
    let adj = [[] for k in 0..n]
    for ed in edges
        let a = ed[0]
        let b = ed[1]
        if a != b
            push(adj[a], b)
            push(adj[b], a)
    return adj

// Find the LCA of vertices a and b in the alternating forest (over blossom bases).
// blockmark[] is a scratch bool array of length n (all 0 on entry, restored to 0 on exit).
// All three walks KEEP their `while`: each climbs the forest a data-dependent number of steps.
fn _bl_lca(base: list, matchv: list, p: list, a0: int, b0: int, blockmark: list) -> int
    // mark every base on a's path to the root
    let a = base[a0]
    blockmark[a] = 1
    while matchv[a] != -1
        a = base[p[matchv[a]]]
        blockmark[a] = 1
    let result = base[b0]
    while blockmark[result] != 1
        result = base[p[matchv[result]]]
    let a2 = base[a0]
    blockmark[a2] = 0
    while matchv[a2] != -1
        a2 = base[p[matchv[a2]]]
        blockmark[a2] = 0
    return result

// Mark the blossom path from v up to base `b`, flagging in_blossom[] and fixing parent links.
// KEPT as a `while`: it walks the alternating cycle until it reaches the base.
fn _bl_mark_path(base: list, matchv: list, p: list, in_blossom: list, v0: int, b: int, child0: int)
    let v = v0
    let child = child0
    while base[v] != b
        in_blossom[base[v]] = 1
        in_blossom[base[matchv[v]]] = 1
        p[v] = child
        child = matchv[v]
        v = p[matchv[v]]

// Try to find and apply one augmenting path from `root`. Returns true if the matching grew.
fn _bl_augment_from(n: int, adj: list, matchv: list, root: int, p: list, base: list, used: list, blockmark: list, in_blossom: list) -> bool
    // reset per-search arrays
    for i in 0..n
        p[i] = -1
        base[i] = i
        used[i] = 0
        blockmark[i] = 0
    used[root] = 1
    let queue = [root]
    let qi = 0
    let aug_end = -1
    // KEPT as a `while`: `queue` GROWS while it is being walked (a for-range bound is evaluated once,
    // which would truncate the BFS), and the scan short-circuits the instant an augmenting path is found.
    while qi < len(queue) and aug_end == -1
        let v = queue[qi]
        qi += 1
        let nbrs = adj[v]
        // KEPT: `j` is advanced from several different branches, and this too stops early on success.
        let j = 0
        while j < len(nbrs) and aug_end == -1
            let to = nbrs[j]
            if base[v] == base[to] or matchv[v] == to
                // same blossom or the matched edge of the tree -> ignore
                j += 1
            else
                if to == root or (matchv[to] != -1 and p[matchv[to]] != -1)
                    // `to` is an OUTER vertex of the forest (root, or its match has a tree-parent)
                    // -> odd cycle -> blossom. Contract via base relabeling.
                    let curbase = _bl_lca(base, matchv, p, v, to, blockmark)
                    for k in 0..n
                        in_blossom[k] = 0
                    _bl_mark_path(base, matchv, p, in_blossom, v, curbase, to)
                    _bl_mark_path(base, matchv, p, in_blossom, to, curbase, v)
                    // relabel every vertex of the blossom to the common base; newly-outer ones join
                    // the queue. The bound is `n`, not len(queue), so this one IS a for-range.
                    for m in 0..n
                        if in_blossom[base[m]] == 1
                            base[m] = curbase
                            if used[m] == 0
                                used[m] = 1
                                push(queue, m)
                    j += 1
                else
                    if p[to] == -1
                        // `to` is a NEW vertex not yet in the alternating tree
                        p[to] = v
                        if matchv[to] == -1
                            // `to` is FREE -> augmenting path found ending at `to`
                            aug_end = to
                        else
                            // extend: to (inner) -> matchv[to] (outer)
                            used[matchv[to]] = 1
                            push(queue, matchv[to])
                            j += 1
                    else
                        j += 1
    if aug_end == -1
        return false
    // augment along the path from aug_end back to root, flipping matched/unmatched edges.
    // KEPT: it follows parent links until it falls off the root.
    let u = aug_end
    while u != -1
        let pv = p[u]
        let nxt = matchv[pv]
        matchv[u] = pv
        matchv[pv] = u
        u = nxt
    return true

// Maximum matching via Edmonds' blossom algorithm.
fn blossom_max_matching(n: int, edges: list) -> list
    let adj = _bl_build_adj(n, edges)
    let matchv = [-1 for k0 in 0..n]
    // greedy initial matching (safe optimization)
    for ed in edges
        let a = ed[0]
        let b = ed[1]
        if a != b and matchv[a] == -1 and matchv[b] == -1
            matchv[a] = b
            matchv[b] = a
    // scratch arrays reused across searches
    let p = [-1 for k1 in 0..n]
    let base = [k2 for k2 in 0..n]
    let used = [0 for k3 in 0..n]
    let blockmark = [0 for k4 in 0..n]
    let in_blossom = [0 for k5 in 0..n]
    for v in 0..n
        if matchv[v] == -1
            _bl_augment_from(n, adj, matchv, v, p, base, used, blockmark, in_blossom)
    return matchv

fn blossom_matching_size(n: int, edges: list) -> int
    let m = blossom_max_matching(n, edges)
    len([v for v in m if v != -1]) / 2
