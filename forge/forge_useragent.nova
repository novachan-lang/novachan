// forge_useragent -- User-Agent string classification (browser / OS / device type / bot detection). A compact
// substring-based classifier in the spirit of ua-parser / DeviceDetector, but tiny and dependency-free: it
// lowercases the UA once and matches known substrings. Used for analytics, adaptive rendering, and bot
// filtering at the request edge. LEAF -- imports NOTHING.

// PRIVATE: true if lowercased string s contains ANY of the needle substrings.
fn _has_any(s: string, needles: list) -> bool
    for i in 0..len(needles)
        if find(s, needles[i]) >= 0
            return true
    false

// Browser family. Order matters: later engines embed earlier engine names in their UA, so the most specific
// token must be tested first (Edge UAs contain "chrome"/"safari"; Chrome UAs contain "safari").
fn ua_browser(ua: string) -> string
    let s = lower(ua)
    if find(s, "edg") >= 0
        return "Edge"
    if find(s, "opr") >= 0 or find(s, "opera") >= 0
        return "Opera"
    if find(s, "chrome") >= 0 or find(s, "crios") >= 0
        return "Chrome"
    if find(s, "firefox") >= 0 or find(s, "fxios") >= 0
        return "Firefox"
    if find(s, "safari") >= 0
        return "Safari"
    if find(s, "msie") >= 0 or find(s, "trident") >= 0
        return "IE"
    ""

// OS family. Android is tested before Linux because Android UAs also carry "Linux".
fn ua_os(ua: string) -> string
    let s = lower(ua)
    if find(s, "windows") >= 0
        return "Windows"
    if find(s, "android") >= 0
        return "Android"
    if find(s, "iphone") >= 0 or find(s, "ipad") >= 0 or find(s, "ios") >= 0
        return "iOS"
    if find(s, "mac os") >= 0 or find(s, "macintosh") >= 0
        return "macOS"
    if find(s, "linux") >= 0
        return "Linux"
    ""

fn ua_is_mobile(ua: string) -> bool
    let s = lower(ua)
    _has_any(s, ["mobile", "android", "iphone", "ipad", "ipod"])

fn ua_is_bot(ua: string) -> bool
    let s = lower(ua)
    _has_any(s, ["bot", "crawl", "spider", "slurp", "bingpreview", "curl", "wget", "python-requests", "facebookexternalhit"])

// Device type. Tablets: iPad, or Android WITHOUT the "mobile" token (Android phones carry "mobile", tablets
// do not). Bots win over everything for filtering. Falls through to Desktop.
fn ua_device(ua: string) -> string
    if ua_is_bot(ua)
        return "Bot"
    let s = lower(ua)
    if find(s, "ipad") >= 0 or (find(s, "android") >= 0 and find(s, "mobile") < 0)
        return "Tablet"
    if ua_is_mobile(ua)
        return "Mobile"
    "Desktop"

// Summary dict for logging/analytics: browser, os, device, and the mobile/bot booleans in one shot.
fn ua_info(ua: string) -> dict
    {"browser": ua_browser(ua), "os": ua_os(ua), "device": ua_device(ua), "mobile": ua_is_mobile(ua), "bot": ua_is_bot(ua)}
