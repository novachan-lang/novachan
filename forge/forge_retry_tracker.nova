// forge_retry_tracker — per-operation retry tracking with Result API.

fn rt_new(max_retries: int) -> dict
    let r = {}
    r["max"] = max_retries
    r["attempts"] = {}
    r["total_retries"] = 0
    r["total_exhausted"] = 0
    r

fn rt_attempt(r: dict, op_id: string) -> Result
    let ak = "a_" + op_id
    if contains(r["attempts"], ak) != true
        r["attempts"][ak] = 1
        return ok(1)
    let count = r["attempts"][ak]
    if count >= r["max"]
        r["total_exhausted"] = r["total_exhausted"] + 1
        return err("max retries exceeded")
    r["attempts"][ak] = count + 1
    r["total_retries"] = r["total_retries"] + 1
    ok(count + 1)

fn rt_attempts_for(r: dict, op_id: string) -> Result
    let ak = "a_" + op_id
    if contains(r["attempts"], ak) != true
        return err("operation not found")
    ok(r["attempts"][ak])

fn rt_reset(r: dict, op_id: string) -> Result
    let ak = "a_" + op_id
    if contains(r["attempts"], ak) != true
        return err("operation not found")
    r["attempts"][ak] = 0
    ok(r)

fn rt_can_retry(r: dict, op_id: string) -> int
    let ak = "a_" + op_id
    if contains(r["attempts"], ak) != true
        return 1
    if r["attempts"][ak] < r["max"]
        return 1
    0

fn rt_total_retries(r: dict) -> int
    r["total_retries"]

fn rt_total_exhausted(r: dict) -> int
    r["total_exhausted"]
