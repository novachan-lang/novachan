fn rm_new()
    let s = {}
    s["release_count"] = 0
    s["release_names"] = ""
    s["current_release"] = ""
    return s

fn rm_create(s, version, description)
    let idx = int(s["release_count"])
    s["rel_" + str(idx) + "_version"] = version
    s["rel_" + str(idx) + "_desc"] = description
    s["rel_" + str(idx) + "_status"] = "draft"
    s["rel_" + str(idx) + "_artifacts"] = 0
    s["release_count"] = idx + 1
    if s["release_names"] == ""
        s["release_names"] = version
    else
        s["release_names"] = str(s["release_names"]) + "," + version
    return s

fn _rm_find(s, version)
    let cnt = int(s["release_count"])
    for i in 0..cnt
        if str(s["rel_" + str(i) + "_version"]) == version
            return i
    return -1

fn rm_add_artifact(s, version, artifact_name) -> Result
    let ri = _rm_find(s, version)
    if ri < 0
        return err("release not found: " + version)
    let aidx = int(s["rel_" + str(ri) + "_artifacts"])
    s["rel_" + str(ri) + "_art_" + str(aidx)] = artifact_name
    s["rel_" + str(ri) + "_artifacts"] = aidx + 1
    return ok(s)

fn rm_publish(s, version) -> Result
    let ri = _rm_find(s, version)
    if ri < 0
        return err("release not found: " + version)
    if str(s["rel_" + str(ri) + "_status"]) == "published"
        return err("already published")
    s["rel_" + str(ri) + "_status"] = "published"
    s["current_release"] = version
    return ok(s)

fn rm_status(s, version) -> Result
    let ri = _rm_find(s, version)
    if ri < 0
        return err("release not found: " + version)
    return ok(str(s["rel_" + str(ri) + "_status"]))

fn rm_artifact_count(s, version) -> Result
    let ri = _rm_find(s, version)
    if ri < 0
        return err("release not found: " + version)
    return ok(int(s["rel_" + str(ri) + "_artifacts"]))

fn rm_current(s) -> Result
    let cur = str(s["current_release"])
    if cur == ""
        return err("no release published")
    return ok(cur)

fn rm_release_count(s)
    return int(s["release_count"])

fn rm_has_release(s, version)
    let ri = _rm_find(s, version)
    if ri >= 0
        return 1
    return 0

fn rm_release_list(s)
    return str(s["release_names"])

fn rm_description(s, version) -> Result
    let ri = _rm_find(s, version)
    if ri < 0
        return err("release not found: " + version)
    return ok(str(s["rel_" + str(ri) + "_desc"]))
