// forge_audit_chain — hash-chained audit log with Result API.

fn ac_new() -> dict
    let a = {}
    a["entries"] = {}
    a["count"] = 0
    a["prev_hash"] = 0
    a

fn ac_append(a: dict, action: string, actor: string) -> dict
    let idx = a["count"]
    let key = "a_" + str(idx)
    a["entries"][key] = actor + ":" + action
    let hk = "h_" + str(idx)
    let entry_hash = hash(action + actor + str(a["prev_hash"]))
    a["entries"][hk] = entry_hash
    a["prev_hash"] = entry_hash
    let ak = "actor_" + str(idx)
    a["entries"][ak] = actor
    let ack = "action_" + str(idx)
    a["entries"][ack] = action
    a["count"] = a["count"] + 1
    a

fn ac_get(a: dict, index: int) -> Result
    if index < 0 or index >= a["count"]
        return err("index out of range")
    let key = "a_" + str(index)
    ok(a["entries"][key])

fn ac_actor_at(a: dict, index: int) -> Result
    if index < 0 or index >= a["count"]
        return err("index out of range")
    let ak = "actor_" + str(index)
    ok(a["entries"][ak])

fn ac_action_at(a: dict, index: int) -> Result
    if index < 0 or index >= a["count"]
        return err("index out of range")
    let ack = "action_" + str(index)
    ok(a["entries"][ack])

fn ac_verify(a: dict, index: int) -> int
    if index < 0 or index >= a["count"]
        return 0
    let hk = "h_" + str(index)
    if contains(a["entries"], hk) == true
        return 1
    0

fn ac_count(a: dict) -> int
    a["count"]
