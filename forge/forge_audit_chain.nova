// forge_audit_chain -- hash-chained audit log: each entry's hash includes the previous entry's hash,
// forming a tamper-evident chain (any modification to a past entry invalidates all subsequent hashes).
// LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. ac_new built the state dict as three individual assignments. Dict literal.
//   2. Key construction `"a_" + str(idx)` (and h_, actor_, action_) at TEN sites -- interpolation.
//   3. `contains(...) == true` -- `in`.
//   4. `a["count"] = a["count"] + 1` -- compound assignment.

fn ac_new() -> dict
    {"entries": {}, "count": 0, "prev_hash": 0}

fn ac_append(a: dict, action: string, actor: string) -> dict
    let idx = a["count"]
    let ph = a["prev_hash"]
    a["entries"]["a_{idx}"] = "{actor}:{action}"
    let entry_hash = hash("{action}{actor}{ph}")
    a["entries"]["h_{idx}"] = entry_hash
    a["prev_hash"] = entry_hash
    a["entries"]["actor_{idx}"] = actor
    a["entries"]["action_{idx}"] = action
    a["count"] += 1
    a

fn ac_get(a: dict, index: int) -> Result
    if index < 0 or index >= a["count"]
        return err("index out of range")
    ok(a["entries"]["a_{index}"])

fn ac_actor_at(a: dict, index: int) -> Result
    if index < 0 or index >= a["count"]
        return err("index out of range")
    ok(a["entries"]["actor_{index}"])

fn ac_action_at(a: dict, index: int) -> Result
    if index < 0 or index >= a["count"]
        return err("index out of range")
    ok(a["entries"]["action_{index}"])

fn ac_verify(a: dict, index: int) -> int
    if index < 0 or index >= a["count"]
        return 0
    1 if "h_{index}" in a["entries"] else 0

fn ac_count(a: dict) -> int
    a["count"]
