// forge_route_planner — Route planning (waypoints) with Result.

fn rp_new() -> dict
    let r = {}
    r["waypoints"] = {}
    r["wp_count"] = 0
    r["distances"] = {}
    r

fn rp_add_waypoint(r: dict, name: string, x: int, y: int) -> dict
    let k = str(r["wp_count"])
    r["waypoints"][k + "_name"] = name
    r["waypoints"][k + "_x"] = x
    r["waypoints"][k + "_y"] = y
    r["wp_count"] = r["wp_count"] + 1
    r

fn rp_set_distance(r: dict, from_wp: string, to_wp: string, dist: int) -> dict
    r["distances"][from_wp + "->" + to_wp] = dist
    r

fn rp_distance(r: dict, from_wp: string, to_wp: string) -> Result
    let key = from_wp + "->" + to_wp
    let has = contains(r["distances"], key)
    if has != true
        return err("no route: " + from_wp + " to " + to_wp)
    ok(r["distances"][key])

fn rp_total_distance(r: dict, route: dict, stops: int) -> Result
    if stops < 2
        return err("need at least 2 stops")
    let total = 0
    let i = 0
    while i < stops - 1
        let from_wp = route[str(i)]
        let to_wp = route[str(i + 1)]
        let d = rp_distance(r, from_wp, to_wp)
        if is_err(d)
            return err("missing segment at stop " + str(i))
        total = total + unwrap(d)
        i = i + 1
    ok(total)

fn rp_waypoint_count(r: dict) -> int
    r["wp_count"]

fn rp_waypoint_name(r: dict, idx: int) -> Result
    if idx >= r["wp_count"]
        return err("index out of range")
    ok(r["waypoints"][str(idx) + "_name"])
