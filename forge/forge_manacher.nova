// forge_manacher -- Manacher's algorithm: find the LONGEST PALINDROMIC SUBSTRING in linear O(n) time. A palindrome
// reads the same forwards and backwards ("racecar", "level"). The obvious approach -- expand around every possible
// center -- is O(n^2); Manacher reuses the palindrome structure already discovered to the left (mirroring radii
// across the current center) so each position is processed in amortized O(1), giving O(n) overall. It handles
// BOTH odd- and even-length palindromes uniformly by conceptually inserting separators between characters. Use it
// for longest-palindrome queries, palindrome detection/counting, DNA reverse-complement-free symmetry, and text
// analysis. longest_palindrome returns the substring, its length, and there are helpers to count all palindromic
// substrings and test a whole string. LEAF -- imports NOTHING.

// PRIVATE: build the '#'-interleaved, guarded transform "^#a#b#...#$" so odd/even palindromes are handled
// uniformly and the distinct guards ^ and $ stop the expansion at the ends without explicit bounds checks.
fn _mn_transform(s: string) -> string
    let t = "^"
    for i in 0..len(s)
        t += "#" + char_at(s, i)
    t + "#$"

// PRIVATE: the per-center palindrome-radius array over the transformed string.
fn _mn_radii(t: string) -> list
    let n = len(t)
    let p = [0 for z in 0..n]
    let c = 0
    let r = 0
    for i in 1..(n - 1)
        let mirror = 2 * c - i
        if i < r
            let lim = r - i
            if p[mirror] < lim
                p[i] = p[mirror]
            else
                p[i] = lim
        while char_at(t, i + p[i] + 1) == char_at(t, i - p[i] - 1)
            p[i] = p[i] + 1
        if i + p[i] > r
            c = i
            r = i + p[i]
    p

// The longest palindromic substring of s (the first one, on ties). Empty string for empty input.
fn longest_palindrome(s: string) -> string
    let out = ""
    if len(s) > 0
        let t = _mn_transform(s)
        let p = _mn_radii(t)
        let best_len = 0
        let best_center = 0
        for i in 1..(len(t) - 1)
            if p[i] > best_len
                best_len = p[i]
                best_center = i
        // map transformed center/radius back to the original string
        let start = (best_center - best_len) / 2
        out = slice(s, start, start + best_len)
    out

// The length of the longest palindromic substring of s.
fn longest_palindrome_len(s: string) -> int
    let out = 0
    if len(s) > 0
        let p = _mn_radii(_mn_transform(s))
        for i in 1..(len(p) - 1)
            if p[i] > out
                out = p[i]
    out

// True if the whole string is a palindrome.
fn is_palindrome(s: string) -> bool
    let ok = true
    let i = 0
    let j = len(s) - 1
    while i < j
        if char_at(s, i) != char_at(s, j)
            ok = false
        i += 1
        j -= 1
    ok

// The total number of palindromic substrings in s (each center contributes radius-many palindromes in the
// transform). "aaa" has 6: a,a,a,aa,aa,aaa.
fn count_palindromes(s: string) -> int
    let total = 0
    if len(s) > 0
        let p = _mn_radii(_mn_transform(s))
        for i in 1..(len(p) - 1)
            total += (p[i] + 1) / 2
    total
