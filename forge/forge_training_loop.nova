// forge_training_loop — ML training loop management: start/end epochs,
// track loss history, and report the best (lowest-loss) epoch.
//
// Loss is tracked as `int` (a caller working with fractional loss should
// scale it, e.g. loss*10000, before recording — this sidesteps NOVA's
// known float-comparison soundness gaps and keeps every comparison exact).
//
// STATE SHAPE (flat dict, no nesting):
//   state["max_epochs"]     — int, epoch budget passed to tl_new.
//   state["current_epoch"]  — int, number of the most recently started
//                              epoch (0 = none started yet).
//   state["in_epoch"]       — int, 1 while an epoch is started but not
//                              yet ended, else 0.
//   state["total_epochs"]   — int, number of epochs fully completed.
//   state["loss_"+epoch]    — int, the loss recorded when epoch `epoch`
//                              ended (key is the decimal string of the
//                              epoch number).
//   state["has_best"]       — int, 1 once at least one epoch has ended.
//   state["best_loss"]      — int, lowest loss seen so far.
//   state["best_epoch"]     — int, epoch number that produced best_loss.
//   state["has_last"]       — int, 1 once at least one epoch has ended.
//   state["last_loss"]      — int, loss of the most recently ended epoch.
//   state["has_prev"]       — int, 1 once at least two epochs have ended.
//   state["prev_loss"]      — int, loss of the epoch before last_loss.
//
// LEAF MODULE — imports NOTHING; only NOVA builtins: contains/str/ok/err.

// tl_new(max_epochs) -> dict
// Create a training loop budgeted for `max_epochs` epochs.
fn tl_new(max_epochs: int) -> dict
    {"max_epochs": max_epochs, "current_epoch": 0, "in_epoch": 0, "total_epochs": 0, "has_best": 0, "best_loss": 0, "best_epoch": 0, "has_last": 0, "last_loss": 0, "has_prev": 0, "prev_loss": 0}

// tl_start_epoch(state) -> Result
// Start the next epoch. err("epoch already in progress") if the previous
// epoch was started but never ended; err("max epochs reached") if the
// budget is exhausted.
fn tl_start_epoch(state: dict) -> Result
    if state["in_epoch"] == 1
        return err("epoch already in progress")
    if state["total_epochs"] >= state["max_epochs"]
        return err("max epochs reached")
    state["current_epoch"] += 1
    state["in_epoch"] = 1
    ok(state)

// tl_end_epoch(state, loss) -> Result
// End the current epoch with the given `loss`. err("no epoch in
// progress") if tl_start_epoch was not called first.
fn tl_end_epoch(state: dict, loss: int) -> Result
    if state["in_epoch"] == 0
        return err("no epoch in progress")
    state["in_epoch"] = 0
    state["total_epochs"] += 1
    let ce = state["current_epoch"]
    state["loss_{ce}"] = loss
    if state["has_last"] == 1
        state["prev_loss"] = state["last_loss"]
        state["has_prev"] = 1
    state["last_loss"] = loss
    state["has_last"] = 1
    if state["has_best"] == 0
        state["best_loss"] = loss
        state["best_epoch"] = ce
        state["has_best"] = 1
    else if loss < state["best_loss"]
        state["best_loss"] = loss
        state["best_epoch"] = ce
    ok(state)

// tl_current_epoch(state) -> int
// The number of the most recently started epoch.
fn tl_current_epoch(state: dict) -> int
    state["current_epoch"]

// tl_best_loss(state) -> Result
// ok(lowest loss seen), or err("no epochs completed").
fn tl_best_loss(state: dict) -> Result
    if state["has_best"] == 0
        return err("no epochs completed")
    ok(state["best_loss"])

// tl_best_epoch(state) -> Result
// ok(epoch number that produced the lowest loss), or err("no epochs
// completed").
fn tl_best_epoch(state: dict) -> Result
    if state["has_best"] == 0
        return err("no epochs completed")
    ok(state["best_epoch"])

// tl_is_complete(state) -> int
// Return 1 once total_epochs has reached max_epochs.
fn tl_is_complete(state: dict) -> int
    if state["total_epochs"] >= state["max_epochs"]
        return 1
    0

// tl_total_epochs(state) -> int
// Number of epochs fully completed (started AND ended).
fn tl_total_epochs(state: dict) -> int
    state["total_epochs"]

// tl_loss_at(state, epoch) -> Result
// ok(loss recorded for `epoch`), or err("epoch not found") if that
// epoch never ended.
fn tl_loss_at(state: dict, epoch: int) -> Result
    let key = "loss_{epoch}"
    if key not in state
        return err("epoch not found")
    ok(state[key])

// tl_is_improving(state) -> Result
// ok(1) if the last completed epoch's loss is lower than the one
// before it, ok(0) otherwise. err("not enough epochs") if fewer than
// two epochs have completed.
fn tl_is_improving(state: dict) -> Result
    if state["has_prev"] == 0
        return err("not enough epochs")
    if state["last_loss"] < state["prev_loss"]
        return ok(1)
    ok(0)
