// forge_file_upload — File upload management.
// Track uploads, validate size/type, metadata, storage paths.

fn fu_new(max_size: int) -> dict
    let fu = {}
    fu["uploads"] = []
    fu["max_size"] = max_size
    fu["allowed_types"] = []
    fu["total_bytes"] = 0
    fu

fn fu_allow_type(fu: dict, mime_type: string) -> dict
    push(fu["allowed_types"], mime_type)
    fu

fn fu_validate(fu: dict, filename: string, size: int, mime_type: string) -> dict
    let r = {}
    r["valid"] = 1
    r["errors"] = []
    if size > fu["max_size"]
        r["valid"] = 0
        push(r["errors"], "file too large")
    if len(fu["allowed_types"]) > 0
        let type_ok = 0
        let i = 0
        while i < len(fu["allowed_types"])
            if fu["allowed_types"][i] == mime_type
                type_ok = 1
            i = i + 1
        if type_ok != 1
            r["valid"] = 0
            push(r["errors"], "type not allowed")
    if len(filename) == 0
        r["valid"] = 0
        push(r["errors"], "empty filename")
    r

fn fu_store(fu: dict, filename: string, size: int, mime_type: string, path: string) -> dict
    let upload = {}
    upload["filename"] = filename
    upload["size"] = size
    upload["mime_type"] = mime_type
    upload["path"] = path
    upload["id"] = len(fu["uploads"]) + 1
    push(fu["uploads"], upload)
    fu["total_bytes"] = fu["total_bytes"] + size
    let r = {}
    r["fu"] = fu
    r["upload_id"] = upload["id"]
    r

fn fu_get(fu: dict, upload_id: int) -> dict
    let i = 0
    while i < len(fu["uploads"])
        if fu["uploads"][i]["id"] == upload_id
            return fu["uploads"][i]
        i = i + 1
    let empty = {}
    empty["id"] = -1
    empty

fn fu_count(fu: dict) -> int
    len(fu["uploads"])

fn fu_total_bytes(fu: dict) -> int
    fu["total_bytes"]

fn fu_by_type(fu: dict, mime_type: string) -> list
    let result = []
    let i = 0
    while i < len(fu["uploads"])
        if fu["uploads"][i]["mime_type"] == mime_type
            push(result, fu["uploads"][i])
        i = i + 1
    result
