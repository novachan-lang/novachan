// forge_prometheus -- a general Prometheus text exposition format (0.0.4) FORMATTER: renders counter,
// gauge, and histogram metric families to the wire text that a Prometheus server scrapes over HTTP.
// This is deliberately a pure string formatter with NO registry/actor/route wiring of its own --
// forge_obs.nova already owns the single-owner RED-metrics actor (metrics_registry/metric_observe) and
// its own narrow metrics_prometheus() for the fixed http_requests_total/http_inflight_requests pair;
// THIS module is the general-purpose primitive any caller (forge_obs, a custom gauge, a latency
// histogram, a business metric) can call to render ARBITRARY metric families with arbitrary label
// sets, including histograms, which forge_obs does not attempt. LEAF -- imports nothing.
//
// Data shapes (plain dicts/lists -- no structs, so any caller can build them from whatever it tracks):
//   labels        : list of [key: string, value: string] pairs, IN THE ORDER to render them. A dict
//                   would silently reorder under iteration (keys() order is not guaranteed stable
//                   across builds) -- byte-exact exposition text needs a caller-controlled order, so
//                   this module takes label lists, never label dicts.
//   counter/gauge series : {"labels": labels, "value": <int|float>}
//   histogram series     : {"labels": labels (WITHOUT "le" -- it is injected per bucket),
//                            "buckets": list of [le: string, cumulative_count: int],
//                            "sum": <int|float>, "count": <int|float>}
//   `buckets` must be pre-accumulated CUMULATIVE counts (Prometheus histogram semantics: each bucket
//   counts every observation <= le, including all narrower buckets), typically ending in a
//   le="+Inf" bucket equal to `count`. prom_cumulative() below turns raw per-bucket tallies into that
//   cumulative form when a caller only has raw counts (e.g. from forge_histogram's equal-width bins --
//   note forge_histogram bins a fixed-width range for shape analysis, a DIFFERENT concept from
//   Prometheus's caller-chosen bucket BOUNDARIES; this module does not depend on it).
//
// Braces/quotes are built via chr() -- a literal `{` in a NOVA string interpolates, so it must never
// appear in a template string (see forge_obs.nova, forge_admin.nova for the same pattern).
//
// STRING BUILDING: every rendered block accumulates into a LIST joined ONCE. `out = out + line` in a
// loop reallocates and recopies the entire document per line -- quadratic in the series/bucket count,
// which is exactly the dimension a scrape endpoint grows in.

// ── Escaping (Prometheus text format spec) ────────────────────────────────────────────────────────
// ONE left-to-right character scan, parameterized by an escape TABLE keyed by the character's byte
// value (NOVA dicts are string-keyed, hence str(o)); anything not in the table passes through
// verbatim. Order within the table cannot matter because this is a single scan, not a sequence of
// global replaces -- an escape sequence produced for one input character is never re-scanned and
// double-escaped by a later rule. The two public escapers below differ ONLY in their table, so the
// scan itself is written once instead of twice.
fn _prom_escape(s: string, ent: dict) -> string
    let parts = []
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        push(parts, get(ent, str(ord(c)), c))
    join(parts, "")

// Within a quoted label value: backslash -> \\, double-quote -> \", newline -> \n.
fn prom_escape_label(s: string) -> string
    let bs = chr(92)
    let q = chr(34)
    _prom_escape(s, {"92": bs + bs, "34": bs + q, "10": bs + "n"})

// Escape HELP docstring text: backslash -> \\, newline -> \n. UNLIKE prom_escape_label, the
// double-quote is NOT escaped here -- a HELP line is not a quoted label value, so an embedded `"` is
// legal and must pass through verbatim. That single difference is the missing "34" table entry.
fn prom_escape_help(s: string) -> string
    let bs = chr(92)
    _prom_escape(s, {"92": bs + bs, "10": bs + "n"})

// Render a label-pair list as `{k1="v1",k2="v2"}`, or "" when there are no labels (a bare metric
// name+value line, valid Prometheus text for the unlabeled case).
fn prom_label_str(labels: list) -> string
    if len(labels) == 0
        return ""
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    lb + join([str(p[0]) + "=" + q + prom_escape_label(p[1]) + q for p in labels], ",") + rb

// A COPY of `labels` with (key, value) appended -- never mutates the caller's list (a histogram
// series's shared `labels` list is read once per bucket; appending "le" in place would corrupt it
// for every later bucket in the same series). Spread builds the copy in one step.
fn _prom_with_label(labels: list, key: string, value: string) -> list
    [...labels, [key, value]]

// PRIVATE: one exposition line -- `name{labels} value\n`. Shared by the counter/gauge series lines
// and by all three histogram line kinds (_bucket / _sum / _count), which differ only in the metric
// name suffix and which number they carry.
fn _prom_line(name: string, labels: list, value: any) -> string
    let lbl = prom_label_str(labels)
    let val = str(value)
    "{name}{lbl} {val}\n"

// `# HELP name help\n# TYPE name mtype\n` -- HELP text is opaque caller-supplied prose. Prometheus
// forbids a literal, unescaped newline in a HELP line (it would break the line-oriented exposition
// format), so any backslash or newline in `help` is escaped (prom_escape_help) before rendering --
// the caller may pass arbitrary prose, including text with embedded newlines, safely.
fn _prom_help_type(name: string, help: string, mtype: string) -> string
    let h = prom_escape_help(help)
    "# HELP {name} {h}\n# TYPE {name} {mtype}\n"

// One `name{labels} value\n` line per series.
fn _prom_series_lines(name: string, series: list) -> string
    join([_prom_line(name, s["labels"], s["value"]) for s in series], "")

// Render a counter metric family: HELP + TYPE counter + one line per series. `series` may be empty
// (renders just the HELP/TYPE header, a valid -- if pointless -- exposition for a metric with no
// observations yet).
fn prom_counter(name: string, help: string, series: list) -> string
    _prom_help_type(name, help, "counter") + _prom_series_lines(name, series)

// Render a gauge metric family: HELP + TYPE gauge + one line per series.
fn prom_gauge(name: string, help: string, series: list) -> string
    _prom_help_type(name, help, "gauge") + _prom_series_lines(name, series)

// Render a histogram metric family: HELP + TYPE histogram, then per series: one `name_bucket{...,
// le="..."} count` line per bucket (in the order given -- Prometheus requires buckets in ascending
// le order, which is the caller's responsibility to supply), then `name_sum{...} sum` and
// `name_count{...} count`.
fn prom_histogram(name: string, help: string, series: list) -> string
    let parts = [_prom_help_type(name, help, "histogram")]
    for s in series
        let labels = s["labels"]
        extend(parts, [_prom_line(name + "_bucket", _prom_with_label(labels, "le", b[0]), b[1]) for b in s["buckets"]])
        push(parts, _prom_line(name + "_sum", labels, s["sum"]))
        push(parts, _prom_line(name + "_count", labels, s["count"]))
    join(parts, "")

// Turn raw per-bucket tallies (how many observations landed in EACH bucket individually) into the
// cumulative counts Prometheus histograms require (how many observations are <= this bucket's le,
// i.e. a running sum). Empty input returns an empty list.
//
// NOT delegated to std/core/collect's `scan`: scan is a seeded scanl that returns len(xs)+1 entries
// with `init` prepended ([0] for empty input), so its edge cases do NOT agree with this contract --
// adapting it would cost a second list pass to drop the seed, and would turn a LEAF module into a
// dependent one.
fn prom_cumulative(raw_counts: list) -> list
    let out = []
    let running = 0
    for v in raw_counts
        running += v
        push(out, running)
    out

// Concatenate already-rendered metric-family blocks (each ending in "\n", as every function above
// produces) into one exposition document. Empty input returns "".
fn prom_document(blocks: list) -> string
    join(blocks, "")
