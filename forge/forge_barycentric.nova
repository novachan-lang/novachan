// forge_barycentric -- barycentric coordinates: express a point inside a triangle as a blend of its three
// corners, [u, v, w] with u+v+w = 1. This is THE tool for anything that varies smoothly across a triangle: it
// tells you if a point is inside (all three weights >= 0), and it's how graphics interpolate color, texture,
// depth, and lighting across a triangle's face during rasterization; it also drives finite-element
// interpolation, terrain-height lookup on a triangulated mesh, and mouse/hit-testing against triangular regions.
// interpolate blends three per-corner VALUES by the weights of a point. triangle_area uses the shoelace formula.
// All from dot/cross products and one division -- no square roots, reliable. Points are [x, y]. LEAF.
//
// RAISED 2026-08-05. Two problems:
//
//   1. triangle_area used `0.0 - area` for negation. Unary `-area`.
//   2. bary_interpolate had a dead binding `let out = ...; out`. Inlined.

fn barycentric(p: list, a: list, b: list, c: list) -> list
    let v0x = b[0] * 1.0 - a[0] * 1.0
    let v0y = b[1] * 1.0 - a[1] * 1.0
    let v1x = c[0] * 1.0 - a[0] * 1.0
    let v1y = c[1] * 1.0 - a[1] * 1.0
    let v2x = p[0] * 1.0 - a[0] * 1.0
    let v2y = p[1] * 1.0 - a[1] * 1.0
    let d00 = v0x * v0x + v0y * v0y
    let d01 = v0x * v1x + v0y * v1y
    let d11 = v1x * v1x + v1y * v1y
    let d20 = v2x * v0x + v2y * v0y
    let d21 = v2x * v1x + v2y * v1y
    let denom = d00 * d11 - d01 * d01
    let out = [0.0, 0.0, 0.0]
    if denom != 0.0
        let v = (d11 * d20 - d01 * d21) / denom
        let w = (d00 * d21 - d01 * d20) / denom
        let u = 1.0 - v - w
        out = [u, v, w]
    out

fn point_in_triangle(p: list, a: list, b: list, c: list) -> bool
    let bc = barycentric(p, a, b, c)
    bc[0] >= 0.0 and bc[1] >= 0.0 and bc[2] >= 0.0

fn triangle_area(a: list, b: list, c: list) -> float
    let cross = (b[0] * 1.0 - a[0] * 1.0) * (c[1] * 1.0 - a[1] * 1.0) - (b[1] * 1.0 - a[1] * 1.0) * (c[0] * 1.0 - a[0] * 1.0)
    let area = cross / 2.0
    if area < 0.0
        area = -area
    area

fn bary_interpolate(p: list, a: list, b: list, c: list, va, vb, vc) -> float
    let bc = barycentric(p, a, b, c)
    bc[0] * 1.0 * (va * 1.0) + bc[1] * 1.0 * (vb * 1.0) + bc[2] * 1.0 * (vc * 1.0)
