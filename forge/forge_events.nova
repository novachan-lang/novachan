// forge_events -- S18: an application EVENT BUS (Spring ApplicationEvent + @EventListener, Rails
// ActiveSupport::Notifications, NestJS EventEmitter). Publish a named event with a payload; every registered
// listener runs. Decouples producers from consumers: an "order.placed" event fans out to an email listener +
// an inventory listener + an audit listener, none of which knows the others exist. Delivery is SYNC (run in
// the caller, ordered) or ASYNC (each listener spawned, so a slow listener never blocks the producer). This
// is the "domain events" backbone the audit (§H) flagged missing.
//
// A listener is `fn(payload) -> any` (return ignored). The bus is a plain dict (built once, at startup).
// LEAF MODULE -- imports NOTHING. Built-ins: contains, push, len, spawn.

fn events_new() -> dict
    {"listeners": {}}

// Register a listener for `event` (many listeners per event, all run in registration order). Fluent.
fn on_event(bus: dict, event: string, listener) -> dict
    let ls = bus["listeners"]
    if event not in ls
        ls[event] = []
    push(ls[event], listener)
    bus

// Emit SYNCHRONOUSLY: run every listener for `event` in the caller, in order. Returns how many ran (0 if the
// event has no listeners). Use when the producer needs the side effects to complete before continuing.
fn emit(bus: dict, event: string, payload) -> int
    let ls = bus["listeners"]
    if event not in ls
        return 0
    let arr = ls[event]
    for i in 0..len(arr)
        let h = arr[i]
        h(payload)
    len(arr)

// PRIVATE: run one listener (spawn target for async delivery).
fn _emit_one(listener, payload)
    listener(payload)

// Emit ASYNCHRONOUSLY: spawn each listener so a slow/blocking listener does not stall the producer
// (fire-and-forget). Returns how many were spawned. The payload is deep-copied to each listener task
// (process isolation) -- listeners cannot corrupt the producer's state.
fn emit_async(bus: dict, event: string, payload) -> int
    let ls = bus["listeners"]
    if event not in ls
        return 0
    let arr = ls[event]
    for i in 0..len(arr)
        spawn _emit_one(arr[i], payload)
    len(arr)
