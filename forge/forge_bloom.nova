// forge_bloom -- a Bloom filter (probabilistic membership). bloom_maybe returns false = DEFINITELY absent
// (skip the expensive lookup), true = MAYBE present (a false positive is possible; a false negative is NOT).
// Sparse bit set stored as a dict of set-bit indices (string key -> 1) so no large preallocated array is
// needed. Uses k independent FNV-1a-style hash functions seeded differently. Classic use cases: Cassandra
// SSTables (skip disk reads for missing keys), CDN caches, spell-checkers, network dedup.
// "Verified by reasoning": bloom_add(b, x) then bloom_maybe(b, x) = true always; bloom_maybe for a never-
// added key = false most of the time (false-positive rate depends on size/k/item-count). LEAF.

// FNV-1a-style hash seeded by `seed`, mod `size`. Uses prime multiplier 16777619 and offset 2166136261
// (standard FNV-1a constants). Seed is mixed in up front so each of the k functions diverges from the
// others immediately. Result is bounded to [0, size-1] via two successive mods (post-loop and return).
fn _bloom_hash(s: string, seed: int, size: int) -> int
    let h = (2166136261 + seed * 7919) % 2147483647
    let i = 0
    while i < len(s)
        h = (h * 16777619 + ord(char_at(s, i))) % 2147483647
        i += 1
    h % size

// Create a new, empty Bloom filter. `size` is the number of virtual bits (try 1024–65536); `k` is the
// number of hash functions (3–7 is typical). Larger size and higher k reduce false-positive rate but
// increase memory/time cost per add/lookup.
fn bloom_new(size: int, k: int) -> dict
    let b = {}
    b["size"] = size
    b["k"] = k
    b["bits"] = {}
    b

// Add `item` to the Bloom filter. Sets k bit positions derived from k independent hash seeds. Mutates
// `bloom` in place (NOVA dicts are reference types) and also returns it for chaining.
fn bloom_add(bloom: dict, item: string) -> dict
    let bits = bloom["bits"]
    let size = bloom["size"]
    let k = bloom["k"]
    for j in 0..k
        let idx = _bloom_hash(item, j, size)
        bits[str(idx)] = 1
    bloom

// Test membership. Returns false = item is DEFINITELY NOT in the set (safe to skip the expensive lookup).
// Returns true = item MIGHT be in the set (false positives are possible; caller should do the real check).
// False negatives are impossible: every item ever bloom_add-ed will always return true here.
fn bloom_maybe(bloom: dict, item: string) -> bool
    let bits = bloom["bits"]
    let size = bloom["size"]
    let k = bloom["k"]
    for j in 0..k
        let idx = _bloom_hash(item, j, size)
        if contains(bits, str(idx)) == false
            return false
    true

// Number of set bits in the filter (i.e. how many individual bit positions have been turned on). This grows
// with each bloom_add but saturates as bits overlap. Useful for estimating saturation level.
fn bloom_count(bloom: dict) -> int
    len(keys(bloom["bits"]))
