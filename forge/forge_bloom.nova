// forge_bloom -- Bloom filter (probabilistic membership). bloom_maybe false = DEFINITELY absent,
// true = MAYBE present. FNV-1a-style hash with k seeds. LEAF.

fn _bloom_hash(s: string, seed: int, size: int) -> int
    let h = (2166136261 + seed * 7919) % 2147483647
    for i in 0..len(s)
        h = (h * 16777619 + ord(char_at(s, i))) % 2147483647
    h % size

fn bloom_new(size: int, k: int) -> dict
    {"size": size, "k": k, "bits": {}}

fn bloom_add(bloom: dict, item: string) -> dict
    let bits = bloom["bits"]
    let size = bloom["size"]
    for j in 0..bloom["k"]
        let idx = _bloom_hash(item, j, size)
        bits[str(idx)] = 1
    bloom

fn bloom_maybe(bloom: dict, item: string) -> bool
    let bits = bloom["bits"]
    let size = bloom["size"]
    for j in 0..bloom["k"]
        let idx = _bloom_hash(item, j, size)
        if str(idx) not in bits
            return false
    true

fn bloom_count(bloom: dict) -> int
    len(keys(bloom["bits"]))
