// forge_pipeline_stage — multi-stage data pipeline with Result API.

fn pipe_new() -> dict
    let p = {}
    p["stage_count"] = 0
    p["processed"] = 0
    p["failed"] = 0
    p

fn pipe_add_stage(p: dict, name: string) -> dict
    let idx = p["stage_count"]
    p["stg_" + str(idx) + "_name"] = name
    p["stg_" + str(idx) + "_count"] = 0
    p["stage_count"] = idx + 1
    p

fn pipe_process(p: dict, stage_index: int) -> Result
    if stage_index < 0 or stage_index >= p["stage_count"]
        return err("stage index out of range")
    p["stg_" + str(stage_index) + "_count"] = p["stg_" + str(stage_index) + "_count"] + 1
    p["processed"] = p["processed"] + 1
    ok(p)

fn pipe_fail(p: dict, stage_index: int) -> Result
    if stage_index < 0 or stage_index >= p["stage_count"]
        return err("stage index out of range")
    p["failed"] = p["failed"] + 1
    ok(p)

fn pipe_stage_name(p: dict, index: int) -> Result
    if index < 0 or index >= p["stage_count"]
        return err("stage index out of range")
    ok(p["stg_" + str(index) + "_name"])

fn pipe_stage_count_at(p: dict, index: int) -> Result
    if index < 0 or index >= p["stage_count"]
        return err("stage index out of range")
    ok(p["stg_" + str(index) + "_count"])

fn pipe_stage_count(p: dict) -> int
    p["stage_count"]

fn pipe_total_processed(p: dict) -> int
    p["processed"]

fn pipe_total_failed(p: dict) -> int
    p["failed"]
