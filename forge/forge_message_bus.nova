// forge_message_bus — In-process message bus (pub/sub).
// Topics, subscribers, publish, replay.

fn bus_new() -> dict
    let b = {}
    b["topics"] = {}
    b["messages"] = []
    b["subscribers"] = {}
    b

fn bus_create_topic(bus: dict, topic: string) -> dict
    let has_topic = contains(bus["topics"], topic)
    if has_topic != true
        bus["topics"][topic] = []
        bus["subscribers"][topic] = []
    bus

fn bus_subscribe(bus: dict, topic: string, subscriber_id: string) -> dict
    let has_topic = contains(bus["subscribers"], topic)
    if has_topic != true
        bus["subscribers"][topic] = []
    push(bus["subscribers"][topic], subscriber_id)
    bus

fn bus_publish(bus: dict, topic: string, payload: any) -> dict
    let has_topic = contains(bus["topics"], topic)
    if has_topic != true
        bus["topics"][topic] = []
    let msg = {}
    msg["topic"] = topic
    msg["payload"] = payload
    msg["seq"] = len(bus["messages"]) + 1
    push(bus["topics"][topic], msg)
    push(bus["messages"], msg)
    bus

fn bus_get_messages(bus: dict, topic: string) -> list
    let has_topic = contains(bus["topics"], topic)
    if has_topic != true
        return []
    bus["topics"][topic]

fn bus_get_subscribers(bus: dict, topic: string) -> list
    let has_topic = contains(bus["subscribers"], topic)
    if has_topic != true
        return []
    bus["subscribers"][topic]

fn bus_message_count(bus: dict, topic: string) -> int
    let msgs = bus_get_messages(bus, topic)
    len(msgs)

fn bus_total_messages(bus: dict) -> int
    len(bus["messages"])

fn bus_replay_since(bus: dict, topic: string, since_seq: int) -> list
    let result = []
    let msgs = bus_get_messages(bus, topic)
    let i = 0
    while i < len(msgs)
        if msgs[i]["seq"] > since_seq
            push(result, msgs[i])
        i = i + 1
    result

fn bus_list_topics(bus: dict) -> list
    keys(bus["topics"])
