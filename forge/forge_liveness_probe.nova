// forge_liveness_probe — Liveness/readiness probes for container orchestration.

fn lp_new(name: string) -> dict
    {"name": name, "live": 1, "ready": 0, "check_count": 0, "fail_count": 0, "consecutive_fails": 0, "fail_threshold": 3}

fn lp_check(p: dict) -> dict
    p["check_count"] += 1
    {"live": p["live"], "ready": p["ready"], "p": p}

fn lp_fail(p: dict) -> dict
    p["fail_count"] += 1
    p["consecutive_fails"] += 1
    if p["consecutive_fails"] >= p["fail_threshold"]
        p["live"] = 0
    p

fn lp_succeed(p: dict) -> dict
    p["consecutive_fails"] = 0
    p["live"] = 1
    p

fn lp_set_ready(p: dict, ready: int) -> dict
    p["ready"] = ready
    p

fn lp_is_live(p: dict) -> int
    p["live"]

fn lp_is_ready(p: dict) -> int
    p["ready"]

fn lp_fail_count(p: dict) -> int
    p["fail_count"]

fn lp_check_count(p: dict) -> int
    p["check_count"]

fn lp_set_threshold(p: dict, t: int) -> dict
    p["fail_threshold"] = t
    p

fn lp_name(p: dict) -> string
    p["name"]
