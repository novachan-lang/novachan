// forge_wrand -- weighted random selection: pick an index with probability proportional to its weight. This is
// the primitive behind A/B-test allocation (60/30/10 traffic split), canary rollouts (route 5% to the new
// build), weighted load balancing (send more to bigger backends), loot/drop tables, and sampling by frequency.
// A plain uniform random gives every option an EQUAL chance; forge_wrand honors the weights. Build a cumulative
// table once (O(n)), then each pick is an O(log n) binary search. Seeded (a deterministic 31-bit LCG) so tests
// and reproducible experiments get the SAME sequence for the same seed. Integer weights (traffic %, counts,
// ratios) -- all-integer math, no float rounding. LEAF -- imports NOTHING.

// PRIVATE: one step of a 31-bit linear congruential generator.
fn _wr_lcg(state: int) -> int
    (state * 1103515245 + 12345) & 2147483647

// Build a cumulative-weight table from per-index weights. cum[i] = weights[0] + ... + weights[i].
// Weights should be >= 0 and not all zero. O(n).
fn wrand_build(weights: list) -> list
    let cum = []
    let running = 0
    let i = 0
    while i < len(weights)
        running = running + weights[i]
        push(cum, running)
        i = i + 1
    cum

// Total weight (sum of all weights) = the last cumulative entry, or 0 if empty.
fn wrand_total(cum: list) -> int
    let n = len(cum)
    if n == 0
        return 0
    cum[n - 1]

// Map a target in [0, total) to its weighted index: the first index whose cumulative weight exceeds target.
// O(log n) binary search (upper_bound). Clamps target into range defensively.
fn wrand_sample_at(cum: list, target: int) -> int
    let total = wrand_total(cum)
    let t = target
    if t < 0
        t = 0
    if t >= total
        t = total - 1
    let lo = 0
    let hi = len(cum)
    while lo < hi
        let mid = (lo + hi) / 2
        if cum[mid] <= t
            lo = mid + 1
        else
            hi = mid
    lo

// Draw one weighted sample using `seed`, returning [index, next_seed]. Chain next_seed into the following call
// for a reproducible stream. O(log n).
fn wrand_sample_seeded(cum: list, seed: int) -> list
    let total = wrand_total(cum)
    let nxt = _wr_lcg(seed)
    let idx = 0
    if total > 0
        idx = wrand_sample_at(cum, nxt % total)
    [idx, nxt]

// Convenience: draw `count` weighted samples starting from `seed`; returns the list of chosen indices.
fn wrand_sample_n(cum: list, seed: int, count: int) -> list
    let out = []
    let s = seed
    let i = 0
    while i < count
        let r = wrand_sample_seeded(cum, s)
        push(out, r[0])
        s = r[1]
        i = i + 1
    out
