// forge_link_shortener — URL shortener.
// Create short links, resolve, track clicks, expire.

fn ls_new() -> dict
    let ls = {}
    ls["links"] = {}
    ls["next_id"] = 1000
    ls["total_clicks"] = 0
    ls

fn ls_create(ls: dict, url: string, slug: string) -> dict
    let link = {}
    link["url"] = url
    link["slug"] = slug
    link["clicks"] = 0
    link["active"] = 1
    ls["links"][slug] = link
    ls["next_id"] = ls["next_id"] + 1
    ls

fn ls_create_auto(ls: dict, url: string) -> dict
    let slug = "s" + str(ls["next_id"])
    ls_create(ls, url, slug)

fn ls_resolve(ls: dict, slug: string) -> string
    let has = contains(ls["links"], slug)
    if has != true
        return ""
    if ls["links"][slug]["active"] != 1
        return ""
    ls["links"][slug]["url"]

fn ls_click(ls: dict, slug: string) -> dict
    let has = contains(ls["links"], slug)
    if has != true
        return ls
    ls["links"][slug]["clicks"] = ls["links"][slug]["clicks"] + 1
    ls["total_clicks"] = ls["total_clicks"] + 1
    ls

fn ls_clicks(ls: dict, slug: string) -> int
    let has = contains(ls["links"], slug)
    if has != true
        return 0
    ls["links"][slug]["clicks"]

fn ls_deactivate(ls: dict, slug: string) -> dict
    let has = contains(ls["links"], slug)
    if has != true
        return ls
    ls["links"][slug]["active"] = 0
    ls

fn ls_link_count(ls: dict) -> int
    len(keys(ls["links"]))

fn ls_total_clicks(ls: dict) -> int
    ls["total_clicks"]
