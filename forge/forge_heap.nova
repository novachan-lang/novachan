// forge_heap -- a binary MIN-heap / priority queue (the structure behind priority scheduling, Dijkstra's
// algorithm, event-driven simulation, and top-K queries). Push a (priority, value); pop always returns the
// lowest-priority item in O(log n). Array-backed with an explicit logical size (stale slots are reused, so no
// list-shrink primitive is needed). Lower priority number = popped first. LEAF -- imports NOTHING.

fn heap_new() -> dict
    let h = {}
    h["items"] = []
    h["size"] = 0
    h

fn _heap_swap(items: list, i: int, j: int)
    let tmp = items[i]
    items[i] = items[j]
    items[j] = tmp

// Push `value` with integer `priority` (lower = higher priority). Sift-up. Fluent.
fn heap_push(h: dict, priority: int, value) -> dict
    let items = h["items"]
    let size = h["size"]
    if size < len(items)
        items[size] = [priority, value]
    else
        push(items, [priority, value])
    h["size"] = size + 1
    let i = size
    let done = false
    while i > 0 and done == false
        let parent = (i - 1) / 2
        if items[parent][0] <= items[i][0]
            done = true
        else
            _heap_swap(items, i, parent)
            i = parent
    h

// Pop and return the lowest-priority [priority, value] pair; [] if empty. Sift-down.
fn heap_pop(h: dict) -> list
    let items = h["items"]
    let size = h["size"]
    if size == 0
        return []
    let top = items[0]
    let newsize = size - 1
    items[0] = items[newsize]
    h["size"] = newsize
    let i = 0
    let done = false
    while done == false
        let l = 2 * i + 1
        let r = 2 * i + 2
        let smallest = i
        if l < newsize and items[l][0] < items[smallest][0]
            smallest = l
        if r < newsize and items[r][0] < items[smallest][0]
            smallest = r
        if smallest == i
            done = true
        else
            _heap_swap(items, i, smallest)
            i = smallest
    top

fn heap_size(h: dict) -> int
    h["size"]

fn heap_empty(h: dict) -> bool
    h["size"] == 0

// The lowest-priority pair without removing it; [] if empty.
fn heap_peek(h: dict) -> list
    if h["size"] == 0
        return []
    let items = h["items"]
    items[0]
