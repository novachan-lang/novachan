// forge_workflow_engine — Multi-step workflow with conditional branching.

fn wf_new(name: string) -> dict
    {"name": name, "step_count": 0, "current": 0, "status": "pending", "results": {}, "error": "", "steps": {}}

fn wf_add_step(wf: dict, step_name: string, step_type: string) -> dict
    let idx = wf["step_count"]
    let k = str(idx)
    wf["steps"][k + "_name"] = step_name
    wf["steps"][k + "_type"] = step_type
    wf["steps"][k + "_status"] = "pending"
    wf["step_count"] += 1
    wf

fn wf_start(wf: dict) -> dict
    if wf["step_count"] == 0
        wf["status"] = "completed"
        return wf
    wf["status"] = "running"
    wf["steps"]["0_status"] = "running"
    wf

fn wf_complete_step(wf: dict, result: string) -> dict
    if wf["status"] != "running"
        return wf
    let idx = wf["current"]
    if idx >= wf["step_count"]
        return wf
    let k = str(idx)
    wf["steps"][k + "_status"] = "completed"
    wf["results"][wf["steps"][k + "_name"]] = result
    wf["current"] += 1
    if wf["current"] >= wf["step_count"]
        wf["status"] = "completed"
    else
        let nk = str(wf["current"])
        wf["steps"][nk + "_status"] = "running"
    wf

fn wf_fail_step(wf: dict, error: string) -> dict
    if wf["status"] != "running"
        return wf
    let idx = wf["current"]
    let k = str(idx)
    wf["steps"][k + "_status"] = "failed"
    wf["status"] = "failed"
    wf["error"] = error
    wf

fn wf_current_step(wf: dict) -> string
    if wf["current"] >= wf["step_count"]
        return ""
    let k = str(wf["current"])
    wf["steps"][k + "_name"]

fn wf_progress(wf: dict) -> int
    if wf["step_count"] == 0
        return 100
    wf["current"] * 100 / wf["step_count"]

fn wf_step_count(wf: dict) -> int
    wf["step_count"]

fn wf_status(wf: dict) -> string
    wf["status"]

fn wf_result(wf: dict, step_name: string) -> string
    if step_name not in wf["results"]
        return ""
    wf["results"][step_name]
