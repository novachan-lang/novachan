// forge_deferred_executor — deferred task execution with scheduling and Result API.

fn de_new() -> dict
    let d = {}
    d["tasks"] = {}
    d["run_at"] = {}
    d["statuses"] = {}
    d["count"] = 0
    d["executed"] = 0
    d

fn de_schedule(d: dict, task_id: string, description: string, run_at: int) -> dict
    let tk = "t_" + task_id
    d["tasks"][tk] = description
    let rk = "r_" + task_id
    d["run_at"][rk] = run_at
    let sk = "s_" + task_id
    d["statuses"][sk] = "pending"
    d["count"] = d["count"] + 1
    d

fn de_execute_due(d: dict, now: int) -> int
    let executed = 0
    let i = 0
    let ks = keys(d["statuses"])
    while i < len(ks)
        let k = ks[i]
        if d["statuses"][k] == "pending"
            let task_id = slice(k, 2, len(k))
            let rk = "r_" + task_id
            if contains(d["run_at"], rk) == true
                if now >= d["run_at"][rk]
                    d["statuses"][k] = "executed"
                    d["executed"] = d["executed"] + 1
                    executed += 1
        i += 1
    executed

fn de_status(d: dict, task_id: string) -> Result
    let sk = "s_" + task_id
    if contains(d["statuses"], sk) != true
        return err("task not found")
    ok(d["statuses"][sk])

fn de_pending_count(d: dict) -> int
    d["count"] - d["executed"]

fn de_executed_count(d: dict) -> int
    d["executed"]
