// forge_rbac -- Role-Based Access Control (Spring Security roles/authorities, Django permissions, Casbin-lite).
// Grant permissions to roles, roles to users, with role INHERITANCE (admin inherits editor inherits viewer),
// then answer rbac_can(user, permission) by walking the role graph. The authorization model every app
// re-implements badly. Pure data (dicts) -- build one policy, query it per request. Cycle-safe. LEAF.

fn rbac_new() -> dict
    {"role_perms": {}, "role_parents": {}, "user_roles": {}}

// Grant `permission` to `role`. Fluent.
fn rbac_grant(r: dict, role: string, permission: string) -> dict
    let rp = r["role_perms"]
    if role not in rp
        rp[role] = []
    let ps = rp[role]
    if permission not in ps
        push(ps, permission)
    r

// `role` inherits everything `parent` grants (role hierarchy). Fluent.
fn rbac_inherit(r: dict, role: string, parent: string) -> dict
    let par = r["role_parents"]
    if role not in par
        par[role] = []
    let ps = par[role]
    if parent not in ps
        push(ps, parent)
    r

// Assign `role` to `user`. Fluent.
fn rbac_assign(r: dict, user: string, role: string) -> dict
    let ur = r["user_roles"]
    if user not in ur
        ur[user] = []
    let rs = ur[user]
    if role not in rs
        push(rs, role)
    r

// PRIVATE: does `role` (or any ancestor) grant `permission`? Cycle-safe via a visited set.
fn _role_grants(r: dict, role: string, permission: string, visited: dict) -> bool
    if role in visited
        return false
    visited[role] = 1
    let rp = r["role_perms"]
    if role in rp
        if permission in rp[role]
            return true
    let par = r["role_parents"]
    if role in par
        let parents = par[role]
        for i in 0..len(parents)
            if _role_grants(r, parents[i], permission, visited)
                return true
    false

// Can `user` perform `permission` via any assigned or inherited role?
fn rbac_can(r: dict, user: string, permission: string) -> bool
    let ur = r["user_roles"]
    if user not in ur
        return false
    let roles = ur[user]
    for i in 0..len(roles)
        let visited = {}
        if _role_grants(r, roles[i], permission, visited)
            return true
    false

// Does `user` hold `role` directly?
fn rbac_has_role(r: dict, user: string, role: string) -> bool
    let ur = r["user_roles"]
    if user not in ur
        return false
    role in ur[user]
