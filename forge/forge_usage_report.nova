// forge_usage_report — Generate usage reports with period tracking.

fn ur_new() -> dict
    let u = {}
    u["entries"] = {}
    u["entry_count"] = 0
    u["period_start"] = 0
    u["period_end"] = 0
    u

fn ur_set_period(u: dict, start_ts: int, end_ts: int) -> dict
    u["period_start"] = start_ts
    u["period_end"] = end_ts
    u

fn ur_add_entry(u: dict, resource: string, quantity: int, unit_cost: int) -> dict
    let idx = u["entry_count"]
    let k = str(idx)
    u["entries"][k + "_resource"] = resource
    u["entries"][k + "_quantity"] = quantity
    u["entries"][k + "_unit_cost"] = unit_cost
    u["entries"][k + "_total"] = quantity * unit_cost
    u["entry_count"] = idx + 1
    u

fn ur_entry_count(u: dict) -> int
    u["entry_count"]

fn ur_total_cost(u: dict) -> int
    let total = 0
    let i = 0
    while i < u["entry_count"]
        let k = str(i)
        total += u["entries"][k + "_total"]
        i += 1
    total

fn ur_entry_resource(u: dict, idx: int) -> string
    u["entries"][str(idx) + "_resource"]

fn ur_entry_total(u: dict, idx: int) -> int
    u["entries"][str(idx) + "_total"]

fn ur_average_cost(u: dict) -> int
    if u["entry_count"] == 0
        return 0
    ur_total_cost(u) / u["entry_count"]

fn ur_most_expensive(u: dict) -> string
    if u["entry_count"] == 0
        return ""
    let best = ""
    let best_cost = 0
    let i = 0
    while i < u["entry_count"]
        let k = str(i)
        let t = u["entries"][k + "_total"]
        if t > best_cost
            best_cost = t
            best = u["entries"][k + "_resource"]
        i += 1
    best
