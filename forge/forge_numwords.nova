// forge_numwords -- spell an integer out in English words ("one thousand two hundred thirty-four"). This is the
// everyday need behind writing the amount on a cheque, printing invoice/legal totals in words to prevent
// tampering, generating accessible/screen-reader text, and voice interfaces. The structure of English number
// names is regular once you see it: split the number into 3-digit groups from the right, name each group
// (hundreds + a special-cased 0-99), and tack on the group's scale word -- thousand, million, billion, and so on.
// Handles zero, negatives, and the full 64-bit range (up to quintillions). Groups of hundreds use "and"-free
// American style and hyphenate compound tens ("forty-two"). LEAF -- imports NOTHING.

// PRIVATE: name a number 1..999 (returns "" for 0).
fn _nw_below_1000(n: int) -> string
    let ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
    let teens = ["ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    let tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    let out = ""
    let h = n / 100
    let rem = n % 100
    if h > 0
        out = ones[h] + " hundred"
    if rem > 0
        if out != ""
            out += " "
        if rem < 10
            out += ones[rem]
        else
            if rem < 20
                out += teens[rem - 10]
            else
                let t = rem / 10
                let o = rem % 10
                out += tens[t]
                if o > 0
                    out += "-" + ones[o]
    out

// The English words for an integer (any 64-bit value). number_to_words(1234) = "one thousand two hundred
// thirty-four", number_to_words(0) = "zero", number_to_words(-42) = "negative forty-two".
fn number_to_words(n: int) -> string
    let out = "zero"
    if n != 0
        let scales = ["", "thousand", "million", "billion", "trillion", "quadrillion", "quintillion"]
        let neg = false
        let v = n
        if v < 0
            neg = true
            v = 0 - v
        // split into 3-digit groups, least significant first
        let groups = []
        while v > 0
            push(groups, v % 1000)
            v /= 1000
        out = ""
        let i = len(groups) - 1
        while i >= 0
            let g = groups[i]
            if g > 0
                let gw = _nw_below_1000(g)
                if scales[i] != ""
                    gw += " " + scales[i]
                if out != ""
                    out += " "
                out += gw
            i -= 1
        if neg
            out = "negative {out}"
    out
