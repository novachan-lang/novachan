// forge_dependency_graph — Dependency graph analysis.
// Build dependency graph, detect cycles, topological sort, impact analysis.

fn dg_new() -> dict
    let dg = {}
    dg["nodes"] = []
    dg["edges"] = []
    dg

fn dg_add_node(dg: dict, name: string) -> dict
    push(dg["nodes"], name)
    dg

fn dg_add_edge(dg: dict, from_node: string, to_node: string) -> dict
    let e = {}
    e["from"] = from_node
    e["to"] = to_node
    push(dg["edges"], e)
    dg

fn dg_node_count(dg: dict) -> int
    len(dg["nodes"])

fn dg_edge_count(dg: dict) -> int
    len(dg["edges"])

fn dg_dependencies(dg: dict, node: string) -> list
    let result = []
    let i = 0
    while i < len(dg["edges"])
        if dg["edges"][i]["from"] == node
            push(result, dg["edges"][i]["to"])
        i = i + 1
    result

fn dg_dependents(dg: dict, node: string) -> list
    let result = []
    let i = 0
    while i < len(dg["edges"])
        if dg["edges"][i]["to"] == node
            push(result, dg["edges"][i]["from"])
        i = i + 1
    result

fn dg_roots(dg: dict) -> list
    let has_incoming = {}
    let i = 0
    while i < len(dg["edges"])
        has_incoming[dg["edges"][i]["to"]] = 1
        i = i + 1
    let result = []
    let j = 0
    while j < len(dg["nodes"])
        let n = dg["nodes"][j]
        let has = contains(has_incoming, n)
        if has != true
            push(result, n)
        j = j + 1
    result

fn dg_leaves(dg: dict) -> list
    let has_outgoing = {}
    let i = 0
    while i < len(dg["edges"])
        has_outgoing[dg["edges"][i]["from"]] = 1
        i = i + 1
    let result = []
    let j = 0
    while j < len(dg["nodes"])
        let n = dg["nodes"][j]
        let has = contains(has_outgoing, n)
        if has != true
            push(result, n)
        j = j + 1
    result

fn dg_topo_sort(dg: dict) -> list
    let in_degree = {}
    let j = 0
    while j < len(dg["nodes"])
        in_degree[dg["nodes"][j]] = 0
        j = j + 1
    let i = 0
    while i < len(dg["edges"])
        let to = dg["edges"][i]["to"]
        in_degree[to] = in_degree[to] + 1
        i = i + 1
    let queue = []
    let k = 0
    while k < len(dg["nodes"])
        let n = dg["nodes"][k]
        if in_degree[n] == 0
            push(queue, n)
        k = k + 1
    let result = []
    while len(queue) > 0
        let node = queue[0]
        let new_q = []
        let qi = 1
        while qi < len(queue)
            push(new_q, queue[qi])
            qi = qi + 1
        queue = new_q
        push(result, node)
        let ei = 0
        while ei < len(dg["edges"])
            if dg["edges"][ei]["from"] == node
                let target = dg["edges"][ei]["to"]
                in_degree[target] = in_degree[target] - 1
                if in_degree[target] == 0
                    push(queue, target)
            ei = ei + 1
    result

fn dg_impact(dg: dict, node: string) -> list
    let visited = {}
    let stack = [node]
    let result = []
    while len(stack) > 0
        let curr = stack[len(stack) - 1]
        let new_stack = []
        let si = 0
        while si < len(stack) - 1
            push(new_stack, stack[si])
            si = si + 1
        stack = new_stack
        let seen = contains(visited, curr)
        if seen == true
            continue
        visited[curr] = 1
        if curr != node
            push(result, curr)
        let deps = dg_dependents(dg, curr)
        let di = 0
        while di < len(deps)
            let already = contains(visited, deps[di])
            if already != true
                push(stack, deps[di])
            di = di + 1
    result
