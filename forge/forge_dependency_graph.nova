// forge_dependency_graph — dependency tracking with cycle detection, Result API.

fn dg_new() -> dict
    {"nodes": {}, "edges": {}, "node_count": 0, "edge_count": 0}

fn dg_add_node(g: dict, name: string) -> Result
    let key = "nd_" + name
    if key in g["nodes"]
        return err("node already exists: " + name)
    g["nodes"][key] = 1
    g["node_count"] += 1
    ok(g)

fn dg_add_edge(g: dict, from: string, to: string) -> Result
    let fk = "nd_" + from
    let tk = "nd_" + to
    if fk not in g["nodes"]
        return err("unknown node: " + from)
    if tk not in g["nodes"]
        return err("unknown node: " + to)
    let ek = "eg_" + from + "_" + to
    g["edges"][ek] = 1
    g["edge_count"] += 1
    ok(g)

fn dg_has_edge(g: dict, from: string, to: string) -> int
    let ek = "eg_" + from + "_" + to
    1 if ek in g["edges"] else 0

fn dg_has_cycle_pair(g: dict, a: string, b: string) -> int
    1 if dg_has_edge(g, a, b) == 1 and dg_has_edge(g, b, a) == 1 else 0

fn dg_node_count(g: dict) -> int
    g["node_count"]

fn dg_edge_count(g: dict) -> int
    g["edge_count"]
