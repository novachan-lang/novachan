// forge_dependency_graph — dependency tracking with cycle detection, Result API.

fn dg_new() -> dict
    let g = {}
    g["nodes"] = {}
    g["edges"] = {}
    g["node_count"] = 0
    g["edge_count"] = 0
    g

fn dg_add_node(g: dict, name: string) -> Result
    let key = "nd_" + name
    let has = contains(g["nodes"], key)
    if has == true
        return err("node already exists: " + name)
    g["nodes"][key] = 1
    g["node_count"] = g["node_count"] + 1
    ok(g)

fn dg_add_edge(g: dict, from: string, to: string) -> Result
    let fk = "nd_" + from
    let tk = "nd_" + to
    let has_f = contains(g["nodes"], fk)
    if has_f != true
        return err("unknown node: " + from)
    let has_t = contains(g["nodes"], tk)
    if has_t != true
        return err("unknown node: " + to)
    let ek = "eg_" + from + "_" + to
    g["edges"][ek] = 1
    g["edge_count"] = g["edge_count"] + 1
    ok(g)

fn dg_has_edge(g: dict, from: string, to: string) -> int
    let ek = "eg_" + from + "_" + to
    let has = contains(g["edges"], ek)
    if has == true
        return 1
    0

fn dg_has_cycle_pair(g: dict, a: string, b: string) -> int
    if dg_has_edge(g, a, b) == 1 and dg_has_edge(g, b, a) == 1
        return 1
    0

fn dg_node_count(g: dict) -> int
    g["node_count"]

fn dg_edge_count(g: dict) -> int
    g["edge_count"]
