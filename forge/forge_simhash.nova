// forge_simhash -- thin wrapper over std/sketch/simhash (canonical implementation).
import std/sketch/simhash

fn _sh_bit(b: int) -> int
    1 << b

// PRIVATE: FNV-1a 32-bit hash of a token string.

fn _sh_hash(s: string) -> int
    let mask = 4294967295
    let h = 2166136261
    for i in 0..len(s)
        h = h ^ ord(char_at(s, i))
        h = (h * 16777619) & mask
    h

// The 32-bit SimHash fingerprint of a token list.

fn simhash(tokens: list) -> int
    let bits = 32
    let v = [0 for a in 0..bits]
    for t in 0..len(tokens)
        let h = _sh_hash(str(tokens[t]))
        for b in 0..bits
            if (h & _sh_bit(b)) != 0
                v[b] += 1
            else
                v[b] -= 1
    let fp = 0
    for c in 0..bits
        if v[c] > 0
            fp += _sh_bit(c)
    fp

// Hamming distance between two fingerprints: the number of differing bits (0 = identical, up to 32).

fn simhash_distance(a: int, b: int) -> int
    let x = a ^ b
    let count = 0
    for i in 0..32
        if (x & _sh_bit(i)) != 0
            count += 1
    count

// True if two fingerprints differ by at most `max_dist` bits (a near-duplicate test; ~3 is a common threshold).

fn simhash_similar(a: int, b: int, max_dist: int) -> bool
    return sh_similar(a, b, max_dist)

fn simhash_token_distance(tokens_a: list, tokens_b: list) -> int
    simhash_distance(simhash(tokens_a), simhash(tokens_b))

