// forge_simhash -- SimHash: reduce a document to a single 32-bit FINGERPRINT such that similar documents get
// similar fingerprints (small Hamming distance = few differing bits). This is Charikar's locality-sensitive hash,
// the technique Google used to de-duplicate the web: instead of comparing every pair of documents in full, you
// compare compact fingerprints bit-for-bit. Where forge_minhash estimates Jaccard set overlap, SimHash captures
// weighted/cosine-style similarity and packs it into ONE integer you can index, store cheaply, and compare in a
// few CPU ops. Use it for near-duplicate detection, clustering by content, plagiarism/spam fingerprinting, and
// change detection. Each token votes on every bit position (set -> +1, clear -> -1); the sign of each column's
// vote becomes that bit of the fingerprint. Tokenize (words, shingles) however you like first. LEAF.

// PRIVATE: 2^b for b in 0..31 (all fit in a positive i64).
fn _sh_bit(b: int) -> int
    1 << b

// PRIVATE: FNV-1a 32-bit hash of a token string.
fn _sh_hash(s: string) -> int
    let mask = 4294967295
    let h = 2166136261
    let i = 0
    while i < len(s)
        h = h ^ ord(char_at(s, i))
        h = (h * 16777619) & mask
        i = i + 1
    h

// The 32-bit SimHash fingerprint of a token list.
fn simhash(tokens: list) -> int
    let bits = 32
    let v = []
    let a = 0
    while a < bits
        push(v, 0)
        a = a + 1
    let t = 0
    while t < len(tokens)
        let h = _sh_hash(str(tokens[t]))
        let b = 0
        while b < bits
            if (h & _sh_bit(b)) != 0
                v[b] = v[b] + 1
            else
                v[b] = v[b] - 1
            b = b + 1
        t = t + 1
    let fp = 0
    let c = 0
    while c < bits
        if v[c] > 0
            fp = fp + _sh_bit(c)
        c = c + 1
    fp

// Hamming distance between two fingerprints: the number of differing bits (0 = identical, up to 32).
fn simhash_distance(a: int, b: int) -> int
    let x = a ^ b
    let count = 0
    let i = 0
    while i < 32
        if (x & _sh_bit(i)) != 0
            count = count + 1
        i = i + 1
    count

// True if two fingerprints differ by at most `max_dist` bits (a near-duplicate test; ~3 is a common threshold).
fn simhash_similar(a: int, b: int, max_dist: int) -> bool
    simhash_distance(a, b) <= max_dist

// Convenience: the Hamming distance between the SimHash fingerprints of two token lists.
fn simhash_token_distance(tokens_a: list, tokens_b: list) -> int
    simhash_distance(simhash(tokens_a), simhash(tokens_b))
