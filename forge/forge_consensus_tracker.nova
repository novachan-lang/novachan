// forge_consensus_tracker — Track consensus votes (Raft-like).

fn ct_new(quorum_size: int) -> dict
    let c = {}
    c["quorum"] = quorum_size
    c["proposals"] = {}
    c["votes_for"] = {}
    c["votes_against"] = {}
    c["proposal_count"] = 0
    c["decided_count"] = 0
    c

fn ct_propose(c: dict, proposal_id: string, value: string) -> dict
    c["proposals"][proposal_id] = value
    c["votes_for"][proposal_id] = 0
    c["votes_against"][proposal_id] = 0
    c["proposal_count"] = c["proposal_count"] + 1
    c

fn ct_vote_for(c: dict, proposal_id: string) -> dict
    c["votes_for"][proposal_id] = c["votes_for"][proposal_id] + 1
    c

fn ct_vote_against(c: dict, proposal_id: string) -> dict
    c["votes_against"][proposal_id] = c["votes_against"][proposal_id] + 1
    c

fn ct_is_decided(c: dict, proposal_id: string) -> int
    let f = c["votes_for"][proposal_id]
    let a = c["votes_against"][proposal_id]
    if f >= c["quorum"]
        return 1
    if a >= c["quorum"]
        return 1
    0

fn ct_is_accepted(c: dict, proposal_id: string) -> int
    if c["votes_for"][proposal_id] >= c["quorum"]
        return 1
    0

fn ct_value(c: dict, proposal_id: string) -> string
    c["proposals"][proposal_id]

fn ct_votes_for(c: dict, proposal_id: string) -> int
    c["votes_for"][proposal_id]

fn ct_votes_against(c: dict, proposal_id: string) -> int
    c["votes_against"][proposal_id]

fn ct_proposal_count(c: dict) -> int
    c["proposal_count"]
