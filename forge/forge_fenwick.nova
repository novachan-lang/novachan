// forge_fenwick -- a Fenwick tree (Binary Indexed Tree): maintain a running array under point UPDATES while
// answering prefix-sum / range-sum queries, both in O(log n). The right structure when a plain array makes
// queries O(n) and a prefix-sum array makes updates O(n): live leaderboards (rank/score sums), frequency
// tables, cumulative statistics, and "sum of the last k events" dashboards. 1-based indices. LEAF.
//
// The classic low-bit trick i & (-i) isolates the lowest set bit to walk the implicit tree.

// A new tree over indices 1..n (internally n+1 slots, all zero).
fn fenwick_new(n: int) -> list
    let t = []
    let i = 0
    while i <= n
        push(t, 0)
        i = i + 1
    t

// Add `delta` at 1-based index `i` (updates all affected tree nodes).
fn fenwick_add(tree: list, i: int, delta: int) -> list
    let idx = i
    while idx < len(tree)
        tree[idx] = tree[idx] + delta
        idx = idx + (idx & (0 - idx))
    tree

// Prefix sum of indices 1..i.
fn fenwick_prefix_sum(tree: list, i: int) -> int
    let s = 0
    let idx = i
    while idx > 0
        s = s + tree[idx]
        idx = idx - (idx & (0 - idx))
    s

// Inclusive range sum of indices l..r.
fn fenwick_range_sum(tree: list, l: int, r: int) -> int
    fenwick_prefix_sum(tree, r) - fenwick_prefix_sum(tree, l - 1)
