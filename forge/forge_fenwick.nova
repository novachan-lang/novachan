// forge_fenwick -- thin wrapper over std/collections/fenwick (canonical implementation).
import std/collections/fenwick

fn fenwick_new(n: int) -> list
    return fw_new(n)

fn fenwick_add(tree: list, i: int, delta: int) -> list
    let idx = i
    while idx < len(tree)
        tree[idx] += delta
        idx += (idx & (-idx))
    tree

// Prefix sum of indices 1..i.

fn fenwick_prefix_sum(tree: list, i: int) -> int
    let s = 0
    let idx = i
    while idx > 0
        s += tree[idx]
        idx -= (idx & (-idx))
    s

// Inclusive range sum of indices l..r.

fn fenwick_range_sum(tree: list, l: int, r: int) -> int
    fenwick_prefix_sum(tree, r) - fenwick_prefix_sum(tree, l - 1)

