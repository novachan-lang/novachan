// forge_trie -- a prefix tree (trie) for AUTOCOMPLETE and prefix search: type-ahead suggestions, command
// completion, dictionary/word lookup. Each node is a dict whose keys are single characters mapping to child
// nodes; a completed word is marked by the reserved key "$end" (set to 1) on its final node. "$end" is 4
// chars so it never collides with a single-char child key -- iteration skips it via `k != "$end"`. Because
// NOVA dicts are reference values, descending by reassigning a cursor and mutating the child writes through
// into the shared root -- so trie_insert needs no explicit re-stitching. LEAF -- imports NOTHING.
// "Verified by reasoning": insert(w) then contains(w) = true; contains of a proper-prefix-only string = false
// (no "$end"); has_prefix is true for any path present; complete(p) = every word under the p-node.

// The reserved end-of-word marker key. A completed word's final node carries d["$end"] = 1. It is a 4-char
// string so it is never mistaken for a single-character child edge when iterating a node's keys.
fn _trie_end() -> string
    "$end"

// A new, empty trie root (an empty node dict). Insert words into it, then query with contains/has_prefix/
// complete. The root is itself a plain node -- an empty root means "no words inserted".
fn trie_new() -> dict
    {}

// Insert `word` as a complete word. Walks the characters from the root, creating an empty child node dict for
// any character edge that does not yet exist, then marks the final node with the "$end" key. Mutates `root` in
// place (dicts are reference values, so writing through the descending cursor updates the shared root) and
// also returns it for fluent chaining.
fn trie_insert(root: dict, word: string) -> dict
    let cur = root
    for i in 0..len(word)
        let c = char_at(word, i)
        if c not in cur
            let child = {}
            cur[c] = child
        cur = cur[c]
    cur[_trie_end()] = 1
    root

// True if `word` was inserted as a COMPLETE word. Walks each character; if any edge is missing the word was
// never a path at all -> false. Reaching the end is not enough -- the final node must carry the "$end" marker
// (otherwise `word` is only a proper prefix of some inserted word, not a word itself).
fn trie_contains(root: dict, word: string) -> bool
    let cur = root
    for i in 0..len(word)
        let c = char_at(word, i)
        if c not in cur
            return false
        cur = cur[c]
    _trie_end() in cur

// True if ANY inserted word starts with `prefix`. Walks each character; every edge must be present as a path,
// but the "$end" marker is irrelevant here -- a prefix need not itself be a completed word. An empty prefix is
// always true (every word starts with "").
fn trie_has_prefix(root: dict, prefix: string) -> bool
    let cur = root
    for i in 0..len(prefix)
        let c = char_at(prefix, i)
        if c not in cur
            return false
        cur = cur[c]
    true

// Depth-first collector: if `node` ends a word, emit the accumulated `prefix`; then recurse into every child
// edge (skipping the "$end" marker key), extending the prefix by that edge's character. Appends whole words to
// `out` (a list, a reference value, so recursion accumulates into the caller's list).
fn _trie_collect(node: dict, prefix: string, out: list) -> list
    if _trie_end() in node
        push(out, prefix)
    for k in keys(node)
        if k != _trie_end()
            _trie_collect(node[k], prefix + k, out)
    out

// ALL inserted words that start with `prefix`, as a list of strings (autocomplete / type-ahead). Walks to the
// prefix node first; if that path does not exist, returns [] (no completions). Otherwise depth-first collects
// every completed word beneath it, each rebuilt as `prefix` + the trailing characters down to its "$end".
fn trie_complete(root: dict, prefix: string) -> list
    let cur = root
    for i in 0..len(prefix)
        let c = char_at(prefix, i)
        if c not in cur
            return []
        cur = cur[c]
    let out = []
    _trie_collect(cur, prefix, out)
    out
