// forge_capacity_planner — Capacity planning with demand forecasting.

fn cp_new(total_capacity: int) -> dict
    let c = {}
    c["total"] = total_capacity
    c["allocated"] = 0
    c["reservations"] = {}
    c["res_count"] = 0
    c["peak"] = 0
    c

fn cp_reserve(c: dict, name: string, amount: int) -> dict
    let result = {}
    if c["allocated"] + amount > c["total"]
        result["ok"] = 0
        result["c"] = c
        return result
    c["reservations"][name] = amount
    c["allocated"] = c["allocated"] + amount
    c["res_count"] = c["res_count"] + 1
    if c["allocated"] > c["peak"]
        c["peak"] = c["allocated"]
    result["ok"] = 1
    result["c"] = c
    result

fn cp_release(c: dict, name: string) -> dict
    let has = contains(c["reservations"], name)
    if has == true
        c["allocated"] = c["allocated"] - c["reservations"][name]
        let new_res = {}
        let ks = keys(c["reservations"])
        let i = 0
        while i < len(ks)
            if ks[i] != name
                new_res[ks[i]] = c["reservations"][ks[i]]
            i = i + 1
        c["reservations"] = new_res
    c

fn cp_available(c: dict) -> int
    c["total"] - c["allocated"]

fn cp_utilization(c: dict) -> int
    if c["total"] == 0
        return 0
    c["allocated"] * 100 / c["total"]

fn cp_peak_utilization(c: dict) -> int
    if c["total"] == 0
        return 0
    c["peak"] * 100 / c["total"]

fn cp_reservation_count(c: dict) -> int
    len(keys(c["reservations"]))

fn cp_total_capacity(c: dict) -> int
    c["total"]
