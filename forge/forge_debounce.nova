// forge_debounce — Debounce + throttle controller for event streams.

fn deb_new(cooldown: int) -> dict
    {"cooldown": cooldown, "last_fired": 0, "total_events": 0, "total_fired": 0, "total_suppressed": 0}

fn deb_event(d: dict, timestamp: int) -> dict
    d["total_events"] += 1
    let elapsed = timestamp - d["last_fired"]
    if elapsed >= d["cooldown"]
        d["last_fired"] = timestamp
        d["total_fired"] += 1
        return {"fire": 1, "d": d}
    d["total_suppressed"] += 1
    {"fire": 0, "d": d}

fn deb_total_events(d: dict) -> int
    d["total_events"]

fn deb_total_fired(d: dict) -> int
    d["total_fired"]

fn deb_total_suppressed(d: dict) -> int
    d["total_suppressed"]

fn deb_suppression_rate(d: dict) -> int
    if d["total_events"] == 0
        return 0
    d["total_suppressed"] * 100 / d["total_events"]

fn deb_last_fired(d: dict) -> int
    d["last_fired"]
