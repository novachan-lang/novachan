// forge_ssl_pinning — certificate pin management with validation and Result API.

fn sp_new() -> dict
    let s = {}
    s["pin_count"] = 0
    s["validations"] = 0
    s["rejections"] = 0
    s

fn sp_add_pin(s: dict, host: string, pin_hash: string) -> dict
    s["pin_" + host] = pin_hash
    s["pin_count"] = s["pin_count"] + 1
    s

fn sp_validate(s: dict, host: string, cert_hash: string) -> Result
    s["validations"] = s["validations"] + 1
    let pk = "pin_" + host
    if pk not in s
        return ok("no pin configured")
    if s[pk] == cert_hash
        return ok("pin valid")
    s["rejections"] = s["rejections"] + 1
    err("pin mismatch for: " + host)

fn sp_has_pin(s: dict, host: string) -> int
    let pk = "pin_" + host
    if pk in s
        return 1
    0

fn sp_get_pin(s: dict, host: string) -> Result
    let pk = "pin_" + host
    if pk not in s
        return err("no pin for: " + host)
    ok(s[pk])

fn sp_pin_count(s: dict) -> int
    s["pin_count"]

fn sp_validation_count(s: dict) -> int
    s["validations"]

fn sp_rejection_count(s: dict) -> int
    s["rejections"]
