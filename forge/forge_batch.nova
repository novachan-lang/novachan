// forge_batch -- S19: chunk/batch processing (Spring Batch reader->processor->writer, chunked). Process a
// large list in fixed-size CHUNKS so memory stays bounded and each chunk commits independently (the ETL
// pattern Spring Batch/Sidekiq-batch give). process_fn(chunk) runs per chunk; batch_process returns the
// total processed. batch_map transforms each item; batch_chunks splits a list for manual iteration.
//
// LEAF MODULE -- imports NOTHING. Built-ins: len, push.
//
// RAISED 2026-08-05. Two problems:
//
//   1. batch_process used for-index with `chunks[i]`. for-in.
//   2. batch_map had a dead binding `let out = [...]; out`. Inlined.

fn batch_chunks(items: list, chunk_size: int) -> list
    let out = []
    let i = 0
    let n = len(items)
    // STAYS a while: steps by chunk_size with a variable-length final chunk.
    while i < n
        let chunk = [items[i + j] for j in 0..min(chunk_size, n - i)]
        push(out, chunk)
        i += chunk_size
    out

fn batch_process(items: list, chunk_size: int, process_fn) -> int
    let chunks = batch_chunks(items, chunk_size)
    let processed = 0
    for c in chunks
        process_fn(c)
        processed += len(c)
    processed

fn batch_map(items: list, map_fn) -> list
    [map_fn(items[i]) for i in 0..len(items)]
