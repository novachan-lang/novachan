// forge_raster -- draw lines and circles as lists of integer PIXELS. Where forge_svg emits vector shapes for a
// browser to render, this rasterizes: given endpoints, it returns the exact grid cells a line or circle passes
// through, using Bresenham's line and the midpoint-circle algorithm -- integer-only, no floating point, the same
// methods GPUs and old-school graphics libraries use. It's what you want for drawing on a pixel/LED matrix or
// tile grid, plotting on a character canvas, computing a line-of-sight or laser path across a game map, or
// generating shapes for image buffers. Each result is a list of [x, y] cells. LEAF -- imports NOTHING.

// PRIVATE.
fn _r_abs(x: int) -> int
    let v = x
    if x < 0
        v = 0 - x
    v

// The integer pixels along the line from (x0,y0) to (x1,y1), inclusive (Bresenham). Works in all directions.
fn line(x0: int, y0: int, x1: int, y1: int) -> list
    let pts = []
    let dx = _r_abs(x1 - x0)
    let dy = _r_abs(y1 - y0)
    let sx = 1
    if x0 > x1
        sx = 0 - 1
    let sy = 1
    if y0 > y1
        sy = 0 - 1
    let err = dx - dy
    let x = x0
    let y = y0
    let going = true
    while going
        push(pts, [x, y])
        if x == x1 and y == y1
            going = false
        else
            let e2 = 2 * err
            if e2 > (0 - dy)
                err -= dy
                x += sx
            if e2 < dx
                err += dx
                y += sy
    pts

// The integer pixels on the circle of radius r centered at (cx,cy) (midpoint / Jesko circle algorithm). Uses
// 8-way symmetry; boundary pixels may repeat.
fn circle(cx: int, cy: int, r: int) -> list
    let pts = []
    if r >= 0
        let x = r
        let y = 0
        let dx = 1
        let dy = 1
        let err = dx - 2 * r
        let going = true
        while going
            if x < y
                going = false
            else
                push(pts, [cx + x, cy + y])
                push(pts, [cx + y, cy + x])
                push(pts, [cx - y, cy + x])
                push(pts, [cx - x, cy + y])
                push(pts, [cx - x, cy - y])
                push(pts, [cx - y, cy - x])
                push(pts, [cx + y, cy - x])
                push(pts, [cx + x, cy - y])
                y += 1
                if err <= 0
                    err += dy
                    dy += 2
                if err > 0
                    x -= 1
                    dx += 2
                    err += dx - 2 * r
    pts

// The integer pixels of an axis-aligned rectangle OUTLINE from (x0,y0) to (x1,y1).
fn rect(x0: int, y0: int, x1: int, y1: int) -> list
    let pts = []
    let lox = x0
    let hix = x1
    if x1 < x0
        lox = x1
        hix = x0
    let loy = y0
    let hiy = y1
    if y1 < y0
        loy = y1
        hiy = y0
    let x = lox
    while x <= hix
        push(pts, [x, loy])
        push(pts, [x, hiy])
        x += 1
    let y = loy + 1
    while y < hiy
        push(pts, [lox, y])
        push(pts, [hix, y])
        y += 1
    pts
