// forge_slug_generator — URL slug generation.

fn slug_generate(text: string) -> string
    let result = ""
    let last_dash = 0
    for i in 0..len(text)
        let ch = text[i]
        if ch >= "a" and ch <= "z"
            result += ch
            last_dash = 0
        else if ch >= "A" and ch <= "Z"
            result += chr(ord(ch) + 32)
            last_dash = 0
        else if ch >= "0" and ch <= "9"
            result += ch
            last_dash = 0
        else if (ch == " " or ch == "_" or ch == "-") and last_dash == 0 and len(result) > 0
            result += "-"
            last_dash = 1
    if len(result) > 0 and result[len(result) - 1] == "-"
        result = slice(result, 0, len(result) - 1)
    result

fn slug_is_valid(slug: string) -> int
    if len(slug) == 0
        return 0
    for i in 0..len(slug)
        let ch = slug[i]
        let valid = (ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9") or ch == "-"
        if not valid
            return 0
    1

fn slug_truncate(slug: string, max_len: int) -> string
    if len(slug) <= max_len
        return slug
    let truncated = slice(slug, 0, max_len)
    if truncated[len(truncated) - 1] == "-"
        truncated = slice(truncated, 0, len(truncated) - 1)
    truncated
