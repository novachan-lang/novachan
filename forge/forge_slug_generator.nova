// forge_slug_generator — URL slug generation.

fn slug_generate(text: string) -> string
    let result = ""
    let last_dash = 0
    let i = 0
    while i < len(text)
        let ch = text[i]
        if ch >= "a"
            if ch <= "z"
                result = result + ch
                last_dash = 0
        if ch >= "A"
            if ch <= "Z"
                let lower = chr(ord(ch) + 32)
                result = result + lower
                last_dash = 0
        if ch >= "0"
            if ch <= "9"
                result = result + ch
                last_dash = 0
        if ch == " " or ch == "_" or ch == "-"
            if last_dash == 0
                if len(result) > 0
                    result = result + "-"
                    last_dash = 1
        i = i + 1
    if len(result) > 0
        if result[len(result) - 1] == "-"
            result = slice(result, 0, len(result) - 1)
    result

fn slug_is_valid(slug: string) -> int
    if len(slug) == 0
        return 0
    let i = 0
    while i < len(slug)
        let ch = slug[i]
        let valid = 0
        if ch >= "a"
            if ch <= "z"
                valid = 1
        if ch >= "0"
            if ch <= "9"
                valid = 1
        if ch == "-"
            valid = 1
        if valid == 0
            return 0
        i = i + 1
    1

fn slug_truncate(slug: string, max_len: int) -> string
    if len(slug) <= max_len
        return slug
    let truncated = slice(slug, 0, max_len)
    if truncated[len(truncated) - 1] == "-"
        truncated = slice(truncated, 0, len(truncated) - 1)
    truncated
