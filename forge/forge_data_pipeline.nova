// forge_data_pipeline — ETL data pipeline builder.
// Define stages, execute transforms, track status.

fn dp_new(name: string) -> dict
    {"name": name, "stages": [], "data": [], "errors": [], "status": "idle"}

fn dp_add_stage(pipe: dict, name: string, stage_type: string) -> dict
    let s = {"name": name, "type": stage_type, "status": "pending", "output_count": 0}
    push(pipe["stages"], s)
    pipe

fn dp_set_data(pipe: dict, data: list) -> dict
    pipe["data"] = data
    pipe

fn dp_filter(pipe: dict, field: string, value: any) -> dict
    pipe["data"] = [row for row in pipe["data"] if field in row and row[field] == value]
    pipe

fn dp_transform_field(pipe: dict, field: string, prefix: string) -> dict
    for i in 0..len(pipe["data"])
        let row = pipe["data"][i]
        if field in row
            pipe["data"][i][field] = prefix + str(row[field])
    pipe

fn dp_add_field(pipe: dict, field: string, value: any) -> dict
    for i in 0..len(pipe["data"])
        pipe["data"][i][field] = value
    pipe

fn dp_count(pipe: dict) -> int
    len(pipe["data"])

fn dp_mark_stage(pipe: dict, idx: int, status: string) -> dict
    if idx < len(pipe["stages"])
        pipe["stages"][idx]["status"] = status
        pipe["stages"][idx]["output_count"] = len(pipe["data"])
    pipe

fn dp_run_status(pipe: dict) -> string
    pipe["status"]

fn dp_set_status(pipe: dict, status: string) -> dict
    pipe["status"] = status
    pipe

fn dp_add_error(pipe: dict, msg: string) -> dict
    push(pipe["errors"], msg)
    pipe

fn dp_error_count(pipe: dict) -> int
    len(pipe["errors"])

fn dp_stage_count(pipe: dict) -> int
    len(pipe["stages"])

fn dp_get_data(pipe: dict) -> list
    pipe["data"]
