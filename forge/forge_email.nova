// forge_email — Email message builder (RFC 5322 + MIME multipart).
// Builds email messages as data structures, renders to RFC 5322 wire format.
// Integrates with forge_smtp for sending.

fn email_new(from: string, to: string, subject: string) -> dict
    {"from": from, "to": [to], "cc": [], "bcc": [], "subject": subject, "headers": {}, "text_body": "", "html_body": "", "attachments": [], "reply_to": ""}

fn email_to(e: dict, addr: string) -> dict
    push(e["to"], addr)
    e

fn email_cc(e: dict, addr: string) -> dict
    push(e["cc"], addr)
    e

fn email_bcc(e: dict, addr: string) -> dict
    push(e["bcc"], addr)
    e

fn email_reply_to(e: dict, addr: string) -> dict
    e["reply_to"] = addr
    e

fn email_header(e: dict, name: string, value: string) -> dict
    e["headers"][name] = value
    e

fn email_text(e: dict, body: string) -> dict
    e["text_body"] = body
    e

fn email_html(e: dict, body: string) -> dict
    e["html_body"] = body
    e

fn email_attach(e: dict, filename: string, content_type: string, data: string) -> dict
    push(e["attachments"], {"filename": filename, "content_type": content_type, "data": data})
    e

fn email_render(e: dict) -> string
    let boundary = "----=_Part_Nova_" + str(len(e["text_body"]) + len(e["html_body"]))
    let msg = "From: {e["from"]}\r\n"
    msg = msg + "To: {join(e["to"], ", ")}\r\n"
    if len(e["cc"]) > 0
        msg = msg + "Cc: {join(e["cc"], ", ")}\r\n"
    msg = msg + "Subject: {e["subject"]}\r\n"
    if len(e["reply_to"]) > 0
        msg = msg + "Reply-To: {e["reply_to"]}\r\n"
    let hk = keys(e["headers"])
    let i = 0
    while i < len(hk)
        msg = msg + "{hk[i]}: {e["headers"][hk[i]]}\r\n"
        i = i + 1
    msg = msg + "MIME-Version: 1.0\r\n"
    let has_text = len(e["text_body"]) > 0
    let has_html = len(e["html_body"]) > 0
    let has_attach = len(e["attachments"]) > 0
    if has_text and not has_html and not has_attach
        msg = msg + "Content-Type: text/plain; charset=utf-8\r\n\r\n"
        msg = msg + e["text_body"]
        return msg
    if has_html and not has_text and not has_attach
        msg = msg + "Content-Type: text/html; charset=utf-8\r\n\r\n"
        msg = msg + e["html_body"]
        return msg
    if has_attach
        msg = msg + "Content-Type: multipart/mixed; boundary=\"{boundary}\"\r\n\r\n"
    else
        msg = msg + "Content-Type: multipart/alternative; boundary=\"{boundary}\"\r\n\r\n"
    if has_text
        msg = msg + "--{boundary}\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n{e["text_body"]}\r\n"
    if has_html
        msg = msg + "--{boundary}\r\nContent-Type: text/html; charset=utf-8\r\n\r\n{e["html_body"]}\r\n"
    i = 0
    while i < len(e["attachments"])
        let att = e["attachments"][i]
        msg = msg + "--{boundary}\r\nContent-Type: {att["content_type"]}\r\nContent-Disposition: attachment; filename=\"{att["filename"]}\"\r\n\r\n{att["data"]}\r\n"
        i = i + 1
    msg = msg + "--{boundary}--\r\n"
    msg

fn email_validate(e: dict) -> list
    let errors = []
    if len(e["from"]) == 0
        push(errors, "from is required")
    if len(e["to"]) == 0
        push(errors, "at least one recipient required")
    if len(e["subject"]) == 0
        push(errors, "subject is required")
    if len(e["text_body"]) == 0 and len(e["html_body"]) == 0
        push(errors, "body (text or html) is required")
    let i = 0
    while i < len(e["to"])
        if not contains(e["to"][i], "@")
            push(errors, "invalid to address: {e["to"][i]}")
        i = i + 1
    errors
