// forge_opengraph -- Open Graph + Twitter Card meta tags (the <meta> tags that make a link unfurl into a rich
// preview card on Facebook, Twitter/X, LinkedIn, Slack, iMessage, Discord). Given title/description/image/url,
// emit the head tags every social platform reads. Attribute values are HTML-escaped (no tag injection). LEAF.

fn _og_esc(s: string) -> string
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == chr(34)
            out += "&quot;"
        else
            if c == "<"
                out += "&lt;"
            else
                if c == ">"
                    out += "&gt;"
                else
                    if c == "&"
                        out += "&amp;"
                    else
                        out += c
    out

// PRIVATE: one <meta property="p" content="v"> line (OG uses property=).
fn _og_prop(p: string, v: string) -> string
    chr(60) + "meta property=" + chr(34) + p + chr(34) + " content=" + chr(34) + _og_esc(v) + chr(34) + ">" + chr(10)

// PRIVATE: one <meta name="n" content="v"> line (Twitter uses name=).
fn _og_name(n: string, v: string) -> string
    chr(60) + "meta name=" + chr(34) + n + chr(34) + " content=" + chr(34) + _og_esc(v) + chr(34) + ">" + chr(10)

// The full Open Graph + Twitter Card <head> block for a page. `type_str` = "website"/"article"; image/url are
// absolute URLs. Emits og:* (Facebook/LinkedIn/Slack) AND twitter:* (summary_large_image) tags together.
fn opengraph(title: string, description: string, image: string, url: string, type_str: string) -> string
    let out = ""
    out += _og_prop("og:title", title)
    out += _og_prop("og:description", description)
    out += _og_prop("og:image", image)
    out += _og_prop("og:url", url)
    out += _og_prop("og:type", type_str)
    out += _og_name("twitter:card", "summary_large_image")
    out += _og_name("twitter:title", title)
    out += _og_name("twitter:description", description)
    out += _og_name("twitter:image", image)
    out
