// forge_telemetry_store — IoT telemetry data storage: record metric readings
// per device and query the latest value/timestamp/count and metric list.
//
// STATE SHAPE (flat dict, no nesting):
//   state["device_count"]                 — int, distinct devices with telemetry
//   state["total_records"]                — int, total ts_record calls
//   state["val_"+device_id+"::"+metric]   — any, latest recorded value
//   state["time_"+device_id+"::"+metric]  — int, timestamp of latest value
//   state["cnt_"+device_id+"::"+metric]   — int, number of records for this pair
//   state["devseen_"+device_id]           — 1, presence = device has ANY telemetry
//   state["metrics_"+device_id]           — string, comma-separated metric names
//                                            recorded for this device (dedup'd)
//
// "::" separates device_id from metric_name in the composite key — chosen
// because device ids / metric names are expected to use "_" internally, so a
// two-char separator avoids accidental collisions between e.g. device "a_b"
// metric "c" and device "a" metric "b_c".
//
// LEAF MODULE — imports NOTHING; only NOVA builtins: contains/split/ok/err.

// _ts_key(device_id, metric_name) -> string  — PRIVATE composite-key builder.
fn _ts_key(device_id: string, metric_name: string) -> string
    "{device_id}::{metric_name}"

// ts_new() -> dict
// Create an empty telemetry store.
fn ts_new() -> dict
    {"device_count": 0, "total_records": 0}

// ts_record(state, device_id, metric_name, value, timestamp) -> dict
// Record a telemetry reading. Updates the latest value/timestamp, bumps the
// per-pair count, the store-wide total, and (on a device's first-ever
// telemetry) the device count and its metric list.
fn ts_record(state: dict, device_id: string, metric_name: string, value: any, timestamp: int) -> dict
    let ck = _ts_key(device_id, metric_name)
    let valk = "val_{ck}"
    let cntk = "cnt_{ck}"
    if valk not in state
        state[cntk] = 0
    state[valk] = value
    state["time_{ck}"] = timestamp
    state[cntk] += 1
    state["total_records"] += 1

    let seenk = "devseen_{device_id}"
    let mk = "metrics_{device_id}"
    if seenk not in state
        state[seenk] = 1
        state["device_count"] += 1
        state[mk] = metric_name
    else
        let cur = state[mk]
        let toks = split(cur, ",")
        let found = 0
        for t in toks
            if t == metric_name
                found = 1
        if found == 0
            state[mk] = "{cur},{metric_name}"
    state

// ts_latest(state, device_id, metric_name) -> Result
// Return ok(latest_value) or err("no data") if the pair was never recorded.
fn ts_latest(state: dict, device_id: string, metric_name: string) -> Result
    let ck = _ts_key(device_id, metric_name)
    let valk = "val_{ck}"
    if valk not in state
        return err("no data")
    ok(state[valk])

// ts_latest_time(state, device_id, metric_name) -> Result
// Return ok(latest_timestamp) or err("no data").
fn ts_latest_time(state: dict, device_id: string, metric_name: string) -> Result
    let ck = _ts_key(device_id, metric_name)
    let timek = "time_{ck}"
    if timek not in state
        return err("no data")
    ok(state[timek])

// ts_count(state, device_id, metric_name) -> Result
// Return ok(record_count) or err("no data").
fn ts_count(state: dict, device_id: string, metric_name: string) -> Result
    let ck = _ts_key(device_id, metric_name)
    let cntk = "cnt_{ck}"
    if cntk not in state
        return err("no data")
    ok(state[cntk])

// ts_device_count(state) -> int
// Number of distinct devices that have recorded at least one telemetry value.
fn ts_device_count(state: dict) -> int
    state["device_count"]

// ts_total_records(state) -> int
// Total number of ts_record calls ever made against this store.
fn ts_total_records(state: dict) -> int
    state["total_records"]

// ts_metric_list(state, device_id) -> Result
// Return ok(comma_separated_metric_names) or err("no telemetry for device").
fn ts_metric_list(state: dict, device_id: string) -> Result
    let mk = "metrics_{device_id}"
    if mk not in state
        return err("no telemetry for device")
    ok(state[mk])
