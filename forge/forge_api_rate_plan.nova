// forge_api_rate_plan — tiered API rate plans with Result API.

fn rp_new() -> dict
    let r = {}
    r["plans"] = {}
    r["user_plans"] = {}
    r["plan_count"] = 0
    r["total_checks"] = 0
    r

fn rp_add_plan(r: dict, name: string, limit: int, window: int) -> dict
    let lk = "l_" + name
    r["plans"][lk] = limit
    let wk = "w_" + name
    r["plans"][wk] = window
    r["plan_count"] = r["plan_count"] + 1
    r

fn rp_assign(r: dict, user: string, plan: string) -> Result
    let lk = "l_" + plan
    if contains(r["plans"], lk) != true
        return err("plan not found: " + plan)
    let uk = "u_" + user
    r["user_plans"][uk] = plan
    ok(r)

fn rp_check(r: dict, user: string, current_usage: int) -> Result
    r["total_checks"] = r["total_checks"] + 1
    let uk = "u_" + user
    if contains(r["user_plans"], uk) != true
        return err("no plan assigned")
    let plan = r["user_plans"][uk]
    let lk = "l_" + plan
    let limit = r["plans"][lk]
    if current_usage >= limit
        return err("rate limit exceeded")
    ok(limit - current_usage)

fn rp_user_plan(r: dict, user: string) -> Result
    let uk = "u_" + user
    if contains(r["user_plans"], uk) != true
        return err("no plan assigned")
    ok(r["user_plans"][uk])

fn rp_plan_limit(r: dict, plan: string) -> Result
    let lk = "l_" + plan
    if contains(r["plans"], lk) != true
        return err("plan not found")
    ok(r["plans"][lk])

fn rp_plan_count(r: dict) -> int
    r["plan_count"]

fn rp_total_checks(r: dict) -> int
    r["total_checks"]
