// forge_api_rate_plan -- tiered API rate plans: define plans with per-window limits, assign users,
// and check whether a user's current usage exceeds their plan. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. rp_new built the state dict as four individual assignments. Dict literal.
//   2. `contains(...) != true` at FOUR sites -- `not in`.
//   3. Error messages used `"plan not found: " + plan` -- interpolation. And `r["plan_count"] =
//      r["plan_count"] + 1` -- compound assignment.

fn rp_new() -> dict
    {"plans": {}, "user_plans": {}, "plan_count": 0, "total_checks": 0}

fn rp_add_plan(r: dict, name: string, limit: int, window: int) -> dict
    r["plans"]["l_{name}"] = limit
    r["plans"]["w_{name}"] = window
    r["plan_count"] += 1
    r

fn rp_assign(r: dict, user: string, plan: string) -> Result
    if "l_{plan}" not in r["plans"]
        return err("plan not found: {plan}")
    r["user_plans"]["u_{user}"] = plan
    ok(r)

fn rp_check(r: dict, user: string, current_usage: int) -> Result
    r["total_checks"] += 1
    let uk = "u_{user}"
    if uk not in r["user_plans"]
        return err("no plan assigned")
    let plan = r["user_plans"][uk]
    let limit = r["plans"]["l_{plan}"]
    if current_usage >= limit
        return err("rate limit exceeded")
    ok(limit - current_usage)

fn rp_user_plan(r: dict, user: string) -> Result
    let uk = "u_{user}"
    if uk not in r["user_plans"]
        return err("no plan assigned")
    ok(r["user_plans"][uk])

fn rp_plan_limit(r: dict, plan: string) -> Result
    let lk = "l_{plan}"
    if lk not in r["plans"]
        return err("plan not found")
    ok(r["plans"][lk])

fn rp_plan_count(r: dict) -> int
    r["plan_count"]

fn rp_total_checks(r: dict) -> int
    r["total_checks"]
