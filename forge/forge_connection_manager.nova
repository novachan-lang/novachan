// forge_connection_manager — Manage a pool of named connections.

fn cm_new(max_conns: int) -> dict
    {"max": max_conns, "conns": {}, "status": {}, "count": 0, "total_created": 0, "total_closed": 0}

fn cm_open(c: dict, name: string, addr: string) -> dict
    if c["count"] >= c["max"]
        return {"ok": 0, "reason": "pool_full", "c": c}
    c["conns"][name] = addr
    c["status"][name] = "open"
    c["count"] += 1
    c["total_created"] += 1
    {"ok": 1, "reason": "", "c": c}

fn cm_close(c: dict, name: string) -> dict
    if name not in c["status"]
        return c
    if c["status"][name] == "closed"
        return c
    c["status"][name] = "closed"
    c["count"] -= 1
    c["total_closed"] += 1
    c

fn cm_get(c: dict, name: string) -> dict
    if name not in c["status"]
        return {"found": 0, "addr": "", "status": ""}
    {"found": 1, "addr": c["conns"][name], "status": c["status"][name]}

fn cm_is_open(c: dict, name: string) -> int
    if name not in c["status"]
        return 0
    if c["status"][name] == "open"
        return 1
    0

fn cm_active_count(c: dict) -> int
    c["count"]

fn cm_available(c: dict) -> int
    c["max"] - c["count"]

fn cm_utilization(c: dict) -> int
    if c["max"] == 0
        return 0
    c["count"] * 100 / c["max"]
