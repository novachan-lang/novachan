// forge_connection_manager — Manage a pool of named connections.

fn cm_new(max_conns: int) -> dict
    let c = {}
    c["max"] = max_conns
    c["conns"] = {}
    c["status"] = {}
    c["count"] = 0
    c["total_created"] = 0
    c["total_closed"] = 0
    c

fn cm_open(c: dict, name: string, addr: string) -> dict
    let result = {}
    if c["count"] >= c["max"]
        result["ok"] = 0
        result["reason"] = "pool_full"
        result["c"] = c
        return result
    c["conns"][name] = addr
    c["status"][name] = "open"
    c["count"] = c["count"] + 1
    c["total_created"] = c["total_created"] + 1
    result["ok"] = 1
    result["reason"] = ""
    result["c"] = c
    result

fn cm_close(c: dict, name: string) -> dict
    let has = contains(c["status"], name)
    if has != true
        return c
    if c["status"][name] == "closed"
        return c
    c["status"][name] = "closed"
    c["count"] = c["count"] - 1
    c["total_closed"] = c["total_closed"] + 1
    c

fn cm_get(c: dict, name: string) -> dict
    let result = {}
    let has = contains(c["status"], name)
    if has != true
        result["found"] = 0
        result["addr"] = ""
        result["status"] = ""
        return result
    result["found"] = 1
    result["addr"] = c["conns"][name]
    result["status"] = c["status"][name]
    result

fn cm_is_open(c: dict, name: string) -> int
    let has = contains(c["status"], name)
    if has != true
        return 0
    if c["status"][name] == "open"
        return 1
    0

fn cm_active_count(c: dict) -> int
    c["count"]

fn cm_available(c: dict) -> int
    c["max"] - c["count"]

fn cm_utilization(c: dict) -> int
    if c["max"] == 0
        return 0
    c["count"] * 100 / c["max"]
