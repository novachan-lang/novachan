// forge_resource_pool — Generic resource pool with borrowing.
// Fixed-capacity pool, borrow/return, idle tracking, stats.

fn rp_new(capacity: int) -> dict
    let rp = {}
    rp["capacity"] = capacity
    rp["resources"] = []
    rp["borrowed"] = []
    rp["returned"] = 0
    rp["total_borrows"] = 0
    rp

fn rp_add(rp: dict, name: string) -> dict
    if len(rp["resources"]) + len(rp["borrowed"]) >= rp["capacity"]
        return rp
    push(rp["resources"], name)
    rp

fn rp_borrow(rp: dict) -> dict
    if len(rp["resources"]) == 0
        let r = {}
        r["pool"] = rp
        r["resource"] = ""
        r["ok"] = 0
        return r
    let name = rp["resources"][0]
    let new_res = []
    let i = 1
    while i < len(rp["resources"])
        push(new_res, rp["resources"][i])
        i += 1
    rp["resources"] = new_res
    push(rp["borrowed"], name)
    rp["total_borrows"] = rp["total_borrows"] + 1
    let r = {}
    r["pool"] = rp
    r["resource"] = name
    r["ok"] = 1
    r

fn rp_return(rp: dict, name: string) -> dict
    let new_borrowed = []
    let found = 0
    let i = 0
    while i < len(rp["borrowed"])
        let item = rp["borrowed"][i]
        if item == name
            if found != 1
                found = 1
                i += 1
            else
                push(new_borrowed, item)
                i += 1
        else
            push(new_borrowed, item)
            i += 1
    if found == 1
        rp["borrowed"] = new_borrowed
        push(rp["resources"], name)
        rp["returned"] = rp["returned"] + 1
    rp

fn rp_available(rp: dict) -> int
    len(rp["resources"])

fn rp_in_use(rp: dict) -> int
    len(rp["borrowed"])

fn rp_total(rp: dict) -> int
    len(rp["resources"]) + len(rp["borrowed"])

fn rp_stats(rp: dict) -> dict
    let s = {}
    s["capacity"] = rp["capacity"]
    s["available"] = len(rp["resources"])
    s["in_use"] = len(rp["borrowed"])
    s["total_borrows"] = rp["total_borrows"]
    s["total_returns"] = rp["returned"]
    s
