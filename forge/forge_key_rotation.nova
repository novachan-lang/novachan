// forge_key_rotation — Cryptographic key rotation manager.
// Track key versions, rotate, expire old keys, active key lookup.

fn kr_new() -> dict
    let kr = {}
    kr["keys"] = []
    kr["active_idx"] = -1
    kr["rotations"] = 0
    kr

fn kr_add_key(kr: dict, key_id: string, created_at: int) -> dict
    let k = {}
    k["id"] = key_id
    k["created_at"] = created_at
    k["status"] = "active"
    push(kr["keys"], k)
    kr["active_idx"] = len(kr["keys"]) - 1
    kr

fn kr_rotate(kr: dict, new_key_id: string, created_at: int) -> dict
    if kr["active_idx"] >= 0
        kr["keys"][kr["active_idx"]]["status"] = "rotated"
    kr = kr_add_key(kr, new_key_id, created_at)
    kr["rotations"] = kr["rotations"] + 1
    kr

fn kr_expire(kr: dict, key_id: string) -> dict
    let i = 0
    while i < len(kr["keys"])
        if kr["keys"][i]["id"] == key_id
            kr["keys"][i]["status"] = "expired"
            return kr
        i = i + 1
    kr

fn kr_active_key(kr: dict) -> string
    if kr["active_idx"] < 0
        return ""
    kr["keys"][kr["active_idx"]]["id"]

fn kr_key_status(kr: dict, key_id: string) -> string
    let i = 0
    while i < len(kr["keys"])
        if kr["keys"][i]["id"] == key_id
            return kr["keys"][i]["status"]
        i = i + 1
    ""

fn kr_key_count(kr: dict) -> int
    len(kr["keys"])

fn kr_active_count(kr: dict) -> int
    let count = 0
    let i = 0
    while i < len(kr["keys"])
        if kr["keys"][i]["status"] == "active"
            count = count + 1
        i = i + 1
    count

fn kr_rotation_count(kr: dict) -> int
    kr["rotations"]
