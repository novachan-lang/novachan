// forge_vcard -- vCard 4.0 contact card generation (RFC 6350): the .vcf format phones, CRMs, and
// "Add to Contacts" links consume. vcard_build(fields) assembles a complete VCARD from a dict of
// name/org/phone/email/etc.; every TEXT value is escaped per RFC 6350 §3.4 and lines use CRLF.
// vcard_simple(name, email, phone) is a minimal convenience card. LEAF -- imports nothing.

// Escape a vCard TEXT value per RFC 6350 §3.4. Backslash MUST be escaped first (otherwise the
// backslashes we add for , ; and newline would themselves be doubled). Order: \ then , then ; then LF.
fn vcard_escape(s: string) -> string
    let bs = chr(92)
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == bs
            out += bs + bs
        else
            if c == ","
                out += bs + ","
            else
                if c == ";"
                    out += bs + ";"
                else
                    if c == chr(10)
                        out += bs + "n"
                    else
                        out += c
    out

// Build a complete VCARD 4.0 from a dict of optional fields. Recognized keys: full_name (FN),
// family_name+given_name (structured N), org (ORG), title (TITLE), email (EMAIL), phone (TEL),
// url (URL), note (NOTE), address (ADR street field). Only present keys emit a line; every text
// value is escaped, while structured separators (;) are literal. CRLF line endings throughout.
fn vcard_build(fields: dict) -> string
    let crlf = chr(13) + chr(10)
    let out = "BEGIN:VCARD" + crlf + "VERSION:4.0" + crlf
    if "full_name" in fields
        out += "FN:" + vcard_escape(fields["full_name"]) + crlf
    if "family_name" in fields
        if "given_name" in fields
            out += "N:" + vcard_escape(fields["family_name"]) + ";" + vcard_escape(fields["given_name"]) + ";;;" + crlf
    if "org" in fields
        out += "ORG:" + vcard_escape(fields["org"]) + crlf
    if "title" in fields
        out += "TITLE:" + vcard_escape(fields["title"]) + crlf
    if "email" in fields
        out += "EMAIL:" + vcard_escape(fields["email"]) + crlf
    if "phone" in fields
        out += "TEL:" + vcard_escape(fields["phone"]) + crlf
    if "url" in fields
        out += "URL:" + vcard_escape(fields["url"]) + crlf
    if "note" in fields
        out += "NOTE:" + vcard_escape(fields["note"]) + crlf
    if "address" in fields
        out += "ADR:;;" + vcard_escape(fields["address"]) + ";;;;" + crlf
    out += "END:VCARD" + crlf
    out

// Convenience: a minimal card from just name/email/phone. Pass "" to omit email or phone.
fn vcard_simple(full_name: string, email: string, phone: string) -> string
    let d = {}
    d["full_name"] = full_name
    if email != ""
        d["email"] = email
    if phone != ""
        d["phone"] = phone
    vcard_build(d)
