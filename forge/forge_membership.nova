// forge_membership — Cluster membership management.
// Join/leave/suspect/confirm, member listing, health tracking.

fn mem_new() -> dict
    let m = {}
    m["members"] = {}
    m["generation"] = 0
    m

fn mem_join(m: dict, node: string, address: string) -> dict
    let member = {}
    member["address"] = address
    member["status"] = "alive"
    member["joined_at"] = m["generation"]
    m["members"][node] = member
    m["generation"] = m["generation"] + 1
    m

fn mem_leave(m: dict, node: string) -> dict
    let has = contains(m["members"], node)
    if has != true
        return m
    m["members"][node]["status"] = "left"
    m["generation"] = m["generation"] + 1
    m

fn mem_suspect(m: dict, node: string) -> dict
    let has = contains(m["members"], node)
    if has != true
        return m
    m["members"][node]["status"] = "suspect"
    m

fn mem_confirm_alive(m: dict, node: string) -> dict
    let has = contains(m["members"], node)
    if has != true
        return m
    m["members"][node]["status"] = "alive"
    m

fn mem_status(m: dict, node: string) -> string
    let has = contains(m["members"], node)
    if has != true
        return ""
    m["members"][node]["status"]

fn mem_alive_members(m: dict) -> list
    let nodes = keys(m["members"])
    let result = [nodes[i] for i in 0..len(nodes) if m["members"][nodes[i]]["status"] == "alive"]
    result

fn mem_member_count(m: dict) -> int
    len(keys(m["members"]))

fn mem_alive_count(m: dict) -> int
    len(mem_alive_members(m))

fn mem_address(m: dict, node: string) -> string
    let has = contains(m["members"], node)
    if has != true
        return ""
    m["members"][node]["address"]
