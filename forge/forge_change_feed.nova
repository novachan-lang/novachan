// forge_change_feed — Change data capture feed with Result.

fn cf_new() -> dict
    let c = {}
    c["changes"] = {}
    c["count"] = 0
    c["consumers"] = {}
    c["consumer_count"] = 0
    c

fn cf_append(c: dict, table: string, op: string, key: string, value: string) -> dict
    let k = str(c["count"])
    c["changes"][k + "_table"] = table
    c["changes"][k + "_op"] = op
    c["changes"][k + "_key"] = key
    c["changes"][k + "_value"] = value
    c["count"] = c["count"] + 1
    c

fn cf_subscribe(c: dict, consumer: string) -> Result
    let has = contains(c["consumers"], consumer)
    if has == true
        return err("consumer already subscribed: " + consumer)
    c["consumers"][consumer] = 0
    c["consumer_count"] = c["consumer_count"] + 1
    ok(c)

fn cf_poll(c: dict, consumer: string) -> Result
    let has = contains(c["consumers"], consumer)
    if has != true
        return err("unknown consumer: " + consumer)
    let offset = c["consumers"][consumer]
    if offset >= c["count"]
        return err("no new changes")
    let k = str(offset)
    c["consumers"][consumer] = offset + 1
    ok(c["changes"][k + "_table"] + ":" + c["changes"][k + "_op"] + ":" + c["changes"][k + "_key"])

fn cf_lag(c: dict, consumer: string) -> Result
    let has = contains(c["consumers"], consumer)
    if has != true
        return err("unknown consumer")
    ok(c["count"] - c["consumers"][consumer])

fn cf_total_changes(c: dict) -> int
    c["count"]

fn cf_consumer_count(c: dict) -> int
    c["consumer_count"]
