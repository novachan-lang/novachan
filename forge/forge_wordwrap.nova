// forge_wordwrap -- wrap text to a maximum line WIDTH on word boundaries (terminal output, plain-text email,
// code comments, chat formatting). Long lines break at spaces; existing newlines are preserved. LEAF.

fn word_wrap(text: string, width: int) -> string
    let nl = chr(10)
    let out = ""
    let line_len = 0
    let word = ""
    let i = 0
    let n = len(text)
    while i <= n
        let atend = i == n
        let c = " "
        if atend == false
            c = char_at(text, i)
        if atend or c == " " or c == nl
            if len(word) > 0
                if line_len > 0 and line_len + 1 + len(word) > width
                    out = out + nl
                    line_len = 0
                if line_len > 0
                    out = out + " "
                    line_len = line_len + 1
                out = out + word
                line_len = line_len + len(word)
                word = ""
            if atend == false and c == nl
                out = out + nl
                line_len = 0
        else
            word = word + c
        i = i + 1
    out
