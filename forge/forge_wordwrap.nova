// forge_wordwrap -- wrap text to a maximum line WIDTH on word boundaries (terminal output, plain-text email,
// code comments, chat formatting). Long lines break at spaces; existing newlines are preserved. LEAF.

fn word_wrap(text: string, width: int) -> string
    let nl = chr(10)
    let out_parts = []
    let line_len = 0
    let word = ""
    let n = len(text)
    for i in 0..(n + 1)
        let atend = i == n
        let c = " "
        if not atend
            c = char_at(text, i)
        if atend or c == " " or c == nl
            if len(word) > 0
                if line_len > 0 and line_len + 1 + len(word) > width
                    push(out_parts, nl)
                    line_len = 0
                if line_len > 0
                    push(out_parts, " ")
                    line_len += 1
                push(out_parts, word)
                line_len += len(word)
                word = ""
            if not atend and c == nl
                push(out_parts, nl)
                line_len = 0
        else
            word += c
    let out = join(out_parts, "")
    out
