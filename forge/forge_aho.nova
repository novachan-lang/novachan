// forge_aho -- Aho-Corasick multi-pattern string matching: find EVERY occurrence of ANY of a set of keywords
// in a single O(text + matches) pass, instead of scanning the text once per keyword. This is the engine behind
// profanity/PII filters, keyword highlighting, malware/IDS signature matching, and dictionary tagging -- cases
// where the single-pattern `find` builtin would mean re-scanning for every term. Build once, search many texts.
//
// The automaton is a dict of parallel structures: "goto" (list of {char -> child-node} dicts), "fail" (list of
// failure-link node ids), "out" (list of pattern lists ending at each node). Node 0 is the root. LEAF.

// A new empty automaton (root only).
fn ac_new() -> dict
    let ac = {}
    ac["goto"] = [{}]
    ac["fail"] = [0]
    ac["out"] = [[]]
    ac

// Add a keyword to the trie (call before ac_build).
fn ac_add(ac: dict, pattern: string) -> dict
    let g = ac["goto"]
    let node = 0
    let i = 0
    while i < len(pattern)
        let c = char_at(pattern, i)
        let children = g[node]
        if contains(children, c) == false
            let newid = len(g)
            push(g, {})
            push(ac["fail"], 0)
            push(ac["out"], [])
            children[c] = newid
        node = g[node][c]
        i = i + 1
    push(ac["out"][node], pattern)
    ac

// Build the failure links + merged outputs by BFS (call once, after all ac_add).
fn ac_build(ac: dict) -> dict
    let g = ac["goto"]
    let fail = ac["fail"]
    let out = ac["out"]
    let queue = []
    let rk = keys(g[0])
    let i = 0
    while i < len(rk)
        let child = g[0][rk[i]]
        fail[child] = 0
        push(queue, child)
        i = i + 1
    let qi = 0
    while qi < len(queue)
        let node = queue[qi]
        qi = qi + 1
        let cks = keys(g[node])
        let j = 0
        while j < len(cks)
            let c = cks[j]
            let child = g[node][c]
            push(queue, child)
            let f = fail[node]
            let done = false
            while done == false
                if contains(g[f], c) and g[f][c] != child
                    done = true
                else
                    if f == 0
                        done = true
                    else
                        f = fail[f]
            if contains(g[f], c) and g[f][c] != child
                fail[child] = g[f][c]
            else
                fail[child] = 0
            let fo = out[fail[child]]
            let k = 0
            while k < len(fo)
                push(out[child], fo[k])
                k = k + 1
            j = j + 1
    ac

// Search `text`; returns a list of [pattern, end_index] matches (end_index is the 0-based position of the last
// matched character).
fn ac_search(ac: dict, text: string) -> list
    let g = ac["goto"]
    let fail = ac["fail"]
    let out = ac["out"]
    let results = []
    let node = 0
    let i = 0
    while i < len(text)
        let c = char_at(text, i)
        let done = false
        while done == false
            if contains(g[node], c)
                node = g[node][c]
                done = true
            else
                if node == 0
                    done = true
                else
                    node = fail[node]
        let o = out[node]
        let j = 0
        while j < len(o)
            push(results, [o[j], i])
            j = j + 1
        i = i + 1
    results
