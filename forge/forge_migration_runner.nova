// forge_migration_runner — database migration tracker with Result API.

fn mr_new() -> dict
    let m = {}
    m["migrations"] = {}
    m["applied"] = {}
    m["count"] = 0
    m["applied_count"] = 0
    m["rolled_back"] = 0
    m

fn mr_register(m: dict, version: int, name: string) -> dict
    let key = "m_" + str(version)
    m["migrations"][key] = name
    m["count"] = m["count"] + 1
    m

fn mr_apply(m: dict, version: int) -> Result
    let key = "m_" + str(version)
    if contains(m["migrations"], key) != true
        return err("migration not found: " + str(version))
    let ak = "a_" + str(version)
    if contains(m["applied"], ak) == true
        return err("already applied: " + str(version))
    m["applied"][ak] = "applied"
    m["applied_count"] = m["applied_count"] + 1
    ok(m)

fn mr_rollback(m: dict, version: int) -> Result
    let ak = "a_" + str(version)
    if contains(m["applied"], ak) != true
        return err("not applied: " + str(version))
    m["applied"][ak] = "rolled_back"
    m["applied_count"] = m["applied_count"] - 1
    m["rolled_back"] = m["rolled_back"] + 1
    ok(m)

fn mr_is_applied(m: dict, version: int) -> int
    let ak = "a_" + str(version)
    if contains(m["applied"], ak) == true
        if m["applied"][ak] == "applied"
            return 1
    0

fn mr_pending_count(m: dict) -> int
    m["count"] - m["applied_count"]

fn mr_applied_count(m: dict) -> int
    m["applied_count"]

fn mr_migration_name(m: dict, version: int) -> Result
    let key = "m_" + str(version)
    if contains(m["migrations"], key) != true
        return err("not found")
    ok(m["migrations"][key])
