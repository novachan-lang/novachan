// forge_data_masker — Mask sensitive data (PII, secrets).

fn dm_new() -> dict
    {"rules": {}, "rule_count": 0, "total_masked": 0}

fn dm_add_rule(d: dict, field: string, strategy: string) -> dict
    d["rules"][field] = strategy
    d["rule_count"] += 1
    d

fn dm_mask_value(strategy: string, value: string) -> string
    if strategy == "redact"
        return "***REDACTED***"
    if strategy == "hash"
        let h = 0
        for i in 0..len(value)
            h = h * 31 + ord(value[i])
        if h < 0
            h = -h
        return "hash:" + str(h)
    if strategy == "partial"
        if len(value) <= 4
            return "****"
        return slice(value, 0, 2) + "****" + slice(value, len(value) - 2, len(value))
    value

fn dm_mask(d: dict, data: dict) -> dict
    let result = {}
    let ks = keys(data)
    for i in 0..len(ks)
        let field = ks[i]
        if field in d["rules"]
            let strategy = d["rules"][field]
            result[field] = dm_mask_value(strategy, data[field])
            d["total_masked"] += 1
        else
            result[field] = data[field]
    result["_d"] = d
    result

fn dm_total_masked(d: dict) -> int
    d["total_masked"]

fn dm_rule_count(d: dict) -> int
    d["rule_count"]
