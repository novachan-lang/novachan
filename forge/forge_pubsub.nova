// forge_pubsub — publish/subscribe with Result API.

fn ps_new() -> dict
    {"topics": {}, "topic_count": 0, "total_published": 0, "total_delivered": 0}

fn ps_create_topic(p: dict, name: string) -> Result
    let tk = "tp_{name}"
    if tk in p["topics"]
        return err("topic exists: {name}")
    p["topics"][tk] = 1
    p["topics"]["{tk}_subs"] = 0
    p["topics"]["{tk}_msgs"] = 0
    p["topic_count"] += 1
    ok(p)

fn ps_subscribe(p: dict, topic: string, subscriber: string) -> Result
    let tk = "tp_{topic}"
    if tk not in p["topics"]
        return err("unknown topic: {topic}")
    let sk = "{tk}_sub_{subscriber}"
    p["topics"][sk] = 1
    let subs_key = "{tk}_subs"
    p["topics"][subs_key] += 1
    ok(p)

fn ps_publish(p: dict, topic: string, message: string) -> Result
    let tk = "tp_{topic}"
    if tk not in p["topics"]
        return err("unknown topic: {topic}")
    let msgs_key = "{tk}_msgs"
    p["topics"][msgs_key] += 1
    let subs = p["topics"]["{tk}_subs"]
    p["total_published"] += 1
    p["total_delivered"] += subs
    ok(p)

fn ps_topic_count(p: dict) -> int
    p["topic_count"]

fn ps_subscriber_count(p: dict, topic: string) -> int
    let tk = "tp_{topic}"
    if tk not in p["topics"]
        return 0
    p["topics"]["{tk}_subs"]

fn ps_total_published(p: dict) -> int
    p["total_published"]

fn ps_total_delivered(p: dict) -> int
    p["total_delivered"]
