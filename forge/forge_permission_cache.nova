// forge_permission_cache — Cache permission lookups with TTL and Result.

fn pc_new(ttl: int) -> dict
    {"cache": {}, "timestamps": {}, "ttl": ttl, "hits": 0, "misses": 0}

fn pc_set(p: dict, user: string, permission: string, allowed: int, now: int) -> dict
    let key = user + ":" + permission
    p["cache"][key] = allowed
    p["timestamps"][key] = now
    p

fn pc_check(p: dict, user: string, permission: string, now: int) -> Result
    let key = user + ":" + permission
    if key not in p["cache"]
        p["misses"] += 1
        return err("cache miss")
    let ts = p["timestamps"][key]
    if now - ts > p["ttl"]
        p["misses"] += 1
        return err("cache expired")
    p["hits"] += 1
    ok(p["cache"][key])

fn pc_invalidate(p: dict, user: string, permission: string) -> dict
    let key = user + ":" + permission
    p["timestamps"][key] = 0
    p

fn pc_hit_rate(p: dict) -> int
    let total = p["hits"] + p["misses"]
    if total == 0
        return 0
    p["hits"] * 100 / total

fn pc_total_lookups(p: dict) -> int
    p["hits"] + p["misses"]
