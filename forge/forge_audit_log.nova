// forge_audit_log -- immutable audit trail for compliance / security: append-only log with actor, action,
// resource, and metadata. Query by actor/action/resource, get recent entries, summarize by action count.
// LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. audit_log_new / audit_append built dicts as individual assignments. Dict literals.
//   2. THREE query functions (actor/action/resource) were identical push-filter while loops differing
//      only in the field name. Comprehensions.
//   3. audit_last_n used a while-index loop to collect a tail slice. Comprehension over a range.
//   4. audit_summary used a while-index loop. for-in + compound assignment.
//   5. `log["next_id"] = log["next_id"] + 1` -- compound assignment.

fn audit_log_new() -> dict
    {"entries": [], "next_id": 1}

fn audit_append(log: dict, actor: string, action: string, resource: string, metadata: dict) -> dict
    let id = log["next_id"]
    push(log["entries"], {"id": id, "actor": actor, "action": action, "resource": resource, "metadata": metadata, "timestamp": id})
    log["next_id"] += 1
    log

fn audit_query_actor(log: dict, actor: string) -> list
    [e for e in log["entries"] if str(e["actor"]) == actor]

fn audit_query_action(log: dict, action: string) -> list
    [e for e in log["entries"] if str(e["action"]) == action]

fn audit_query_resource(log: dict, resource: string) -> list
    [e for e in log["entries"] if str(e["resource"]) == resource]

fn audit_count(log: dict) -> int
    len(log["entries"])

fn audit_last_n(log: dict, n: int) -> list
    let total = len(log["entries"])
    let start = max(0, total - n)
    [log["entries"][i] for i in start..total]

fn audit_summary(log: dict) -> dict
    let actions = {}
    for e in log["entries"]
        let action = str(e["action"])
        if action in actions
            actions[action] += 1
        else
            actions[action] = 1
    actions
