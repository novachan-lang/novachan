// forge_audit_log — Immutable audit trail for compliance / security.
// Append-only log with actor, action, resource, timestamp, metadata.

fn audit_log_new() -> dict
    let log = {}
    log["entries"] = []
    log["next_id"] = 1
    log

fn audit_append(log: dict, actor: string, action: string, resource: string, metadata: dict) -> dict
    let entry = {}
    entry["id"] = log["next_id"]
    entry["actor"] = actor
    entry["action"] = action
    entry["resource"] = resource
    entry["metadata"] = metadata
    entry["timestamp"] = log["next_id"]
    log["next_id"] = log["next_id"] + 1
    push(log["entries"], entry)
    log

fn audit_query_actor(log: dict, actor: string) -> list
    let result = []
    let i = 0
    while i < len(log["entries"])
        let e = log["entries"][i]
        if e["actor"] == actor
            push(result, e)
        i = i + 1
    result

fn audit_query_action(log: dict, action: string) -> list
    let result = []
    let i = 0
    while i < len(log["entries"])
        let e = log["entries"][i]
        if e["action"] == action
            push(result, e)
        i = i + 1
    result

fn audit_query_resource(log: dict, resource: string) -> list
    let result = []
    let i = 0
    while i < len(log["entries"])
        let e = log["entries"][i]
        if e["resource"] == resource
            push(result, e)
        i = i + 1
    result

fn audit_count(log: dict) -> int
    len(log["entries"])

fn audit_last_n(log: dict, n: int) -> list
    let entries = log["entries"]
    let total = len(entries)
    let start = total - n
    if start < 0
        start = 0
    let result = []
    let i = start
    while i < total
        push(result, entries[i])
        i = i + 1
    result

fn audit_summary(log: dict) -> dict
    let actions = {}
    let i = 0
    while i < len(log["entries"])
        let action = log["entries"][i]["action"]
        if contains(actions, action)
            actions[action] = actions[action] + 1
        else
            actions[action] = 1
        i = i + 1
    actions
