// forge_tls_client — a live TLS 1.3 client over real TCP sockets (binary tcp_connect / tcp_send_bytes /
// tcp_recv_bytes). Drives the handshake state machine and reuses forge_tls for all the crypto. Tested
// against openssl s_server. L1 = connect -> ClientHello -> ServerHello -> ECDHE -> derive handshake keys
// -> decrypt the server's encrypted flight (EncryptedExtensions/Certificate/CertificateVerify/Finished).
import forge_tls
import forge_crypto
import forge_x509
import forge_chain
import std/time/strftime

// CSPRNG: real OS entropy for the ephemeral X25519 key + client random. NOVA's random_int is C rand()
// (non-crypto); nova_rt_os_random uses the OS CSPRNG (CryptGenRandom / urandom). Reached via the @link
// extern FFI so no compiler change is needed (nova_runtime.o is always linked).
extern fn nova_rt_os_random(n: int) -> bytes

fn _tlsc_b2l(b) -> list
    let out = []
    let n = bytes_len(b)
    let i = 0
    while i < n
        push(out, bytes_get(b, i))
        i = i + 1
    out

fn _tlsc_l2b(lst)
    let b = bytes(0)
    let i = 0
    while i < len(lst)
        b = bytes_append(b, lst[i])
        i = i + 1
    b

fn _tlsc_cat(a, b) -> list
    let o = []
    let i = 0
    while i < len(a)
        push(o, a[i])
        i = i + 1
    let j = 0
    while j < len(b)
        push(o, b[j])
        j = j + 1
    o

// 32-byte little-endian u-coordinate of the X25519 base point (9).
fn _tlsc_base9() -> list
    let u = []
    push(u, 9)
    let i = 0
    while i < 31
        push(u, 0)
        i = i + 1
    u

// ensure `buf` holds >= need bytes, reading more from the socket as required.
fn _tlsc_fill(sock, buf, need: int) -> list
    while len(buf) < need
        let chunk = _tlsc_b2l(tcp_recv_bytes(sock))
        if len(chunk) == 0
            return buf
        let j = 0
        while j < len(chunk)
            push(buf, chunk[j])
            j = j + 1
    buf

// read one TLS record from the socket -> [content_type, body_list, leftover_buf]. ct = -1 if the
// connection closed before a full record arrived.
fn _tlsc_read_record(sock, buf) -> list
    let b2 = _tlsc_fill(sock, buf, 5)
    if len(b2) < 5
        let c = []
        push(c, 0 - 1)
        push(c, [])
        push(c, b2)
        return c
    let ct = b2[0]
    let reclen = (b2[3] << 8) | b2[4]
    b2 = _tlsc_fill(sock, b2, 5 + reclen)
    if len(b2) < 5 + reclen
        let c2 = []
        push(c2, 0 - 1)
        push(c2, [])
        push(c2, b2)
        return c2
    let body = []
    let i = 5
    while i < 5 + reclen
        push(body, b2[i])
        i = i + 1
    let rest = []
    let k = 5 + reclen
    while k < len(b2)
        push(rest, b2[k])
        k = k + 1
    let r = []
    push(r, ct)
    push(r, body)
    push(r, rest)
    r

fn _tlsc_take(lst, n: int) -> list
    let o = []
    let i = 0
    while i < n
        push(o, lst[i])
        i = i + 1
    o

fn _tlsc_slice(lst, a: int, b: int) -> list
    let o = []
    let i = a
    while i < b
        push(o, lst[i])
        i = i + 1
    o

// build a [content_type || 0x0303 || uint16 len || body] wire record for tls13_record_open.
fn _tlsc_wire(ct: int, body) -> list
    let w = []
    push(w, ct)
    push(w, 3)
    push(w, 3)
    push(w, (len(body) >> 8) & 255)
    push(w, len(body) & 255)
    let i = 0
    while i < len(body)
        push(w, body[i])
        i = i + 1
    w

// send one TLS record: content_type || 0x03 ver_lo || uint16 len || body.
fn _tlsc_send_record(sock, ct: int, ver_lo: int, body) -> int
    let rec = []
    push(rec, ct)
    push(rec, 3)
    push(rec, ver_lo)
    push(rec, (len(body) >> 8) & 255)
    push(rec, len(body) & 255)
    let i = 0
    while i < len(body)
        push(rec, body[i])
        i = i + 1
    tcp_send_bytes(sock, _tlsc_l2b(rec))

// FIX 3 (MITM defense): current time as UTCTime VALUE bytes ("YYMMDDHHMMSSZ") for chain_verify's `now` --
// the real wall clock, so the certificate validity window is enforced on every call, not skippable by a
// caller who doesn't supply one. dt_strftime has no %y (2-digit year) directive, so build the 4-digit year
// form first ("20260803143022", 14 chars) and drop the century (UTCTime is YY not YYYY).
fn _tlsc_now_utctime() -> list
    let full = dt_strftime(datetime_timestamp(), "%Y%m%d%H%M%S")
    str_to_blist(full[2:14] + "Z")

// FIX 3 (MITM defense): extract EVERY certificate DER from a Certificate message body, leaf first then any
// intermediates/root the server actually sent -- forge_tls's tls13_cert_leaf_der only returns the FIRST
// entry, but chain_verify (forge_chain) needs the FULL chain [leaf, intermediate.., root] to walk issuer ->
// issuer up to the trust anchor. Per RFC 8446 4.4.2 each CertificateEntry is
// [cert_data uint24-len][cert_data][extensions uint16-len][extensions]; walked with explicit bounds (every
// length field clamped to the declared list end) so a truncated/malformed Certificate message yields
// whatever complete entries were read, never an OOB read.
fn _tlsc_cert_chain(cert_body) -> list
    let n = len(cert_body)
    let ctxlen = cert_body[0]
    let p = 1 + ctxlen
    if p + 3 > n
        return []
    let listlen = (cert_body[p] << 16) | (cert_body[p + 1] << 8) | cert_body[p + 2]
    p = p + 3
    let listend = p + listlen
    if listend > n
        listend = n
    let out = []
    while p + 3 <= listend
        let clen = (cert_body[p] << 16) | (cert_body[p + 1] << 8) | cert_body[p + 2]
        p = p + 3
        let cend = p + clen
        if cend > listend
            cend = listend
        push(out, _tlsc_slice(cert_body, p, cend))
        p = cend
        if p + 2 > listend
            p = listend
        else
            let extlen = (cert_body[p] << 8) | cert_body[p + 1]
            p = p + 2 + extlen
            if p > listend
                p = listend
    out

// Does `flight` (concatenated handshake messages) end exactly with a complete Finished (type 20)?
fn _tlsc_flight_done(flight) -> int
    let p = 0
    let last = 0
    while p + 4 <= len(flight)
        let hlen = (flight[p + 1] << 16) | (flight[p + 2] << 8) | flight[p + 3]
        let nxt = p + 4 + hlen
        if nxt > len(flight)
            return 0
        last = flight[p]
        p = nxt
    if p == len(flight) and last == 20
        return 1
    0

// L1 handshake: connect, exchange hellos, derive handshake keys, decrypt the server flight.
// Returns [ok, flight_msgs, s_hs_secret, c_hs_secret, handshake_secret, transcript_ch_sh, sock, leftover].
fn tls13_client_l1(host, port: int) -> list
    let priv = _tlsc_b2l(unsafe nova_rt_os_random(32))
    let rando = _tlsc_b2l(unsafe nova_rt_os_random(32))
    let pub = x25519(priv, _tlsc_base9())

    let sock = tcp_connect(host, port)
    if sock < 0
        return [0]

    let ch = tls13_make_client_hello(rando, pub)
    _tlsc_send_record(sock, 22, 1, ch)
    let transcript = _tlsc_cat([], ch)

    // ServerHello (plaintext handshake record)
    let rr = _tlsc_read_record(sock, [])
    let buf = rr[2]
    let sh = rr[1]
    if rr[0] != 22
        return [0]
    transcript = _tlsc_cat(transcript, sh)
    let shp = tls13_parse_server_hello(sh)
    let server_pub = shp[2]

    let shared = x25519(priv, server_pub)
    let hs = tls13_handshake_secret(shared)
    let th_ch_sh = sha256_bytes(transcript)
    let s_hs = tls13_derive_secret(hs, "s hs traffic", th_ch_sh)
    let c_hs = tls13_derive_secret(hs, "c hs traffic", th_ch_sh)
    let s_hs_key = tls13_traffic_key(s_hs)
    let s_hs_iv = tls13_traffic_iv(s_hs)

    // read encrypted flight records (skip ChangeCipherSpec ct=20); decrypt with s_hs, seq from 0
    let flight = []
    let seq = 0
    let guard = 0
    while _tlsc_flight_done(flight) == 0 and guard < 64
        let rec = _tlsc_read_record(sock, buf)
        buf = rec[2]
        guard = guard + 1
        if rec[0] == 23
            let wire = []
            push(wire, 23)
            push(wire, 3)
            push(wire, 3)
            push(wire, (len(rec[1]) >> 8) & 255)
            push(wire, len(rec[1]) & 255)
            let w = 0
            while w < len(rec[1])
                push(wire, rec[1][w])
                w = w + 1
            let opened = tls13_record_open(s_hs_key, s_hs_iv, seq, wire)
            seq = seq + 1
            if opened[0] != true
                return [0]
            flight = _tlsc_cat(flight, opened[1])
    let r = []
    push(r, _tlsc_flight_done(flight))
    push(r, flight)
    push(r, s_hs)
    push(r, c_hs)
    push(r, hs)
    push(r, th_ch_sh)
    push(r, sock)
    push(r, buf)
    push(r, transcript)
    r

// Full TLS 1.3 client: complete the handshake (verify CertificateVerify + server Finished, send client
// Finished), derive application keys, send `request` and return the decrypted server response.
// Returns [ok, response_bytes_list]. Verifies the server's handshake signature + Finished (per-handshake
// authentication) AND (FIX 3) WHO the peer actually is: the certificate chain to `trust_anchor` (forge_chain)
// and the leaf's hostname against `expected_host` (forge_x509, RFC 6125 SAN matching). Without those two,
// the signature+Finished checks alone are satisfiable by ANY active MITM holding a fresh, self-signed
// keypair -- they also derive a valid ECDHE secret and can sign their own handshake with their own key.
// SECURITY: `trust_anchor` and `expected_host` are REQUIRED params (NOT defaulted) -- this widens the
// signature, a legitimate breaking change; the only in-tree caller (forge_tls_client_l2_test.nova) is
// updated alongside this. (Default parameter values were tried first but VERIFIED not to work across a
// module import boundary in the current toolchain -- a probe with an imported fn's trailing args defaulted
// compiled fine called from its OWN file, but failed arity checking called from a DIFFERENT file that
// imports it; required params are the correct, toolchain-compatible choice here, and they are also the
// more honest one: the caller cannot forget to think about verification.) An empty trust_anchor FAILS
// CLOSED (mirrors chain_verify's own `now` convention: a caller that can't supply what verification needs
// gets a clean refusal, never a silent bypass) -- pass a real pinned root/leaf DER to actually verify. Pass
// "" for expected_host to verify against `host` itself (the address actually connected to); hostname
// binding can never be silently skipped. On any failure (including a failed chain/host check) this returns
// [0, []] -- the SAME failure value every earlier check in this function already used, never a silent
// success.
fn tls13_client_request(host, port: int, request, trust_anchor, expected_host: string) -> list
    let st = tls13_client_l1(host, port)
    if st[0] != 1
        return [0, []]
    let flight = st[1]
    let s_hs = st[2]
    let c_hs = st[3]
    let hs = st[4]
    let sock = st[6]
    let buf = st[7]
    let transcript = st[8]

    let m1 = tls13_hs_header(flight, 0)
    let m2 = tls13_hs_header(flight, m1[3])
    let m3 = tls13_hs_header(flight, m2[3])
    let m4 = tls13_hs_header(flight, m3[3])
    if m4[0] != 20
        return [0, []]

    let th_cert = sha256_bytes(_tlsc_cat(transcript, _tlsc_take(flight, m2[3])))
    let th_cv = sha256_bytes(_tlsc_cat(transcript, _tlsc_take(flight, m3[3])))
    let th_sf = sha256_bytes(_tlsc_cat(transcript, flight))

    // verify the server's CertificateVerify against the leaf cert
    let cert_body = _tlsc_slice(flight, m2[2], m2[3])
    let leaf = tls13_cert_leaf_der(cert_body)
    let spki = x509_parse_cert(leaf)[2]
    let cvp = tls13_certverify_parse(_tlsc_slice(flight, m3[2], m3[3]))
    let cvcontent = tls13_certverify_content("TLS 1.3, server CertificateVerify", th_cert)
    if tls13_verify_cert_signature(cvp[0], spki, cvcontent, cvp[1]) != 1
        return [0, []]

    // verify the server Finished
    if tls13_verify_server_finished(s_hs, th_cv, _tlsc_slice(flight, m4[2], m4[3])) != 1
        return [0, []]

    // FIX 3 (MITM defense): authenticate WHO the peer is, not just that they hold A keypair. An empty
    // trust_anchor fails CLOSED -- there is nothing to pin to, so this refuses rather than silently trusting
    // an unverified leaf.
    if len(trust_anchor) == 0
        return [0, []]
    let certs = _tlsc_cert_chain(cert_body)
    if len(certs) == 0
        return [0, []]
    if chain_verify(certs, trust_anchor, _tlsc_now_utctime()) != 1
        return [0, []]
    let want_host = expected_host
    if want_host == ""
        want_host = host
    if x509_matches_host(leaf, str_to_blist(want_host)) != 1
        return [0, []]

    // send ChangeCipherSpec (legacy) + the encrypted client Finished (c_hs, seq 0)
    _tlsc_send_record(sock, 20, 3, [1])
    let cf = []
    push(cf, 20)
    push(cf, 0)
    push(cf, 0)
    push(cf, 32)
    cf = _tlsc_cat(cf, tls13_client_finished(c_hs, th_sf))
    tcp_send_bytes(sock, _tlsc_l2b(tls13_record_seal(tls13_traffic_key(c_hs), tls13_traffic_iv(c_hs), 0, cf, 22, 0)))

    // application traffic keys
    let ms = tls13_master_secret(hs)
    let c_ap = tls13_derive_secret(ms, "c ap traffic", th_sf)
    let s_ap = tls13_derive_secret(ms, "s ap traffic", th_sf)
    let c_ap_key = tls13_traffic_key(c_ap)
    let c_ap_iv = tls13_traffic_iv(c_ap)
    let s_ap_key = tls13_traffic_key(s_ap)
    let s_ap_iv = tls13_traffic_iv(s_ap)

    // send the request encrypted with the client application key
    tcp_send_bytes(sock, _tlsc_l2b(tls13_record_seal(c_ap_key, c_ap_iv, 0, request, 23, 0)))

    // read records: decrypt with s_ap, skip NewSessionTicket (inner type 22), collect application_data
    let response = []
    let sseq = 0
    let guard = 0
    while guard < 64
        guard = guard + 1
        let rec = _tlsc_read_record(sock, buf)
        buf = rec[2]
        if rec[0] == 0 - 1
            return [1, response]
        if rec[0] == 23
            let opened = tls13_record_open(s_ap_key, s_ap_iv, sseq, _tlsc_wire(23, rec[1]))
            sseq = sseq + 1
            if opened[0] != true
                return [0, response]
            if opened[2] == 23
                response = _tlsc_cat(response, opened[1])
            if opened[2] == 21
                return [1, response]
    return [1, response]
