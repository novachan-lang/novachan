// forge_mysql -- pure-NOVA MySQL driver over raw TCP (no libmysqlclient), mirroring forge_pg. Speaks the
// classic MySQL protocol: LE packet framing (3-byte length + 1-byte seq), HandshakeV10, the
// mysql_native_password auth (SHA-1), COM_QUERY, and length-encoded result-set parsing. Rows come back as
// name-keyed string dicts -- so forge_orm's typed mapping (orm_all<T>/orm_one<T>) works unchanged.
// Auth token = SHA1(pw) XOR SHA1(scramble ++ SHA1(SHA1(pw))); values are always parameterized upstream.
import forge_crypto

// ---- little-endian helpers --------------------------------------------------------------------------
fn _my_u(b, off: int, n: int) -> int
    let v = 0
    let i = 0
    let mul = 1
    while i < n
        v = v + bytes_get(b, off + i) * mul
        mul = mul * 256
        i = i + 1
    v

fn _my_p3(n: int) -> any
    let b = bytes(0)
    b = bytes_append(b, n & 255)
    b = bytes_append(b, (n >> 8) & 255)
    b = bytes_append(b, (n >> 16) & 255)
    b

fn _my_p4(n: int) -> any
    let b = bytes(0)
    b = bytes_append(b, n & 255)
    b = bytes_append(b, (n >> 8) & 255)
    b = bytes_append(b, (n >> 16) & 255)
    b = bytes_append(b, (n >> 24) & 255)
    b

fn _my_cstr(b, off: int) -> any
    let endp = off
    while endp < bytes_len(b) and bytes_get(b, endp) != 0
        endp = endp + 1
    [bytes_to_str(bytes_slice(b, off, endp)), endp + 1]

// length-encoded integer -> [value, next_off].
fn _my_lenenc_int(b, off: int) -> any
    let f = bytes_get(b, off)
    if f < 251
        return [f, off + 1]
    if f == 252
        return [_my_u(b, off + 1, 2), off + 3]
    if f == 253
        return [_my_u(b, off + 1, 3), off + 4]
    if f == 254
        return [_my_u(b, off + 1, 8), off + 9]
    [0, off + 1]

// length-encoded string -> [string, next_off]. 0xfb (251) = SQL NULL -> "".
fn _my_lenenc_str(b, off: int) -> any
    if bytes_get(b, off) == 251
        return ["", off + 1]
    let li = _my_lenenc_int(b, off)
    let n = li[0]
    let start = li[1]
    [bytes_to_str(bytes_slice(b, start, start + n)), start + n]

// length-encoded INTEGER writer (for COM_STMT_EXECUTE param values/lengths).
fn _my_wr_lenenc(n: int) -> any
    let b = bytes(0)
    if n < 251
        return bytes_append(b, n)
    if n < 65536
        b = bytes_append(b, 252)
        b = bytes_append(b, n & 255)
        b = bytes_append(b, (n >> 8) & 255)
        return b
    b = bytes_append(b, 253)
    b = bytes_append(b, n & 255)
    b = bytes_append(b, (n >> 8) & 255)
    b = bytes_append(b, (n >> 16) & 255)
    b

// length-encoded STRING writer (lenenc length + raw bytes).
fn _my_wr_lenstr(sb) -> any
    bytes_concat(_my_wr_lenenc(bytes_len(sb)), sb)

// ---- packet IO --------------------------------------------------------------------------------------
fn _my_recv_at_least(sock: int, buf, need: int) -> any
    while bytes_len(buf) < need
        let chunk = tcp_recv_bytes(sock)
        if bytes_len(chunk) == 0
            return buf
        buf = bytes_concat(buf, chunk)
    buf

// Read one whole packet -> [seq, payload, leftover]. seq -1 = EOF/short read.
fn _my_read_packet(sock: int, buf) -> any
    buf = _my_recv_at_least(sock, buf, 4)
    if bytes_len(buf) < 4
        return [0 - 1, bytes(0), buf]
    let plen = _my_u(buf, 0, 3)
    let seq = bytes_get(buf, 3)
    let total = 4 + plen
    buf = _my_recv_at_least(sock, buf, total)
    if bytes_len(buf) < total
        return [0 - 1, bytes(0), buf]
    [seq, bytes_slice(buf, 4, total), bytes_slice(buf, total, bytes_len(buf))]

fn _my_write_packet(sock: int, seq: int, payload)
    let hdr = _my_p3(bytes_len(payload))
    hdr = bytes_append(hdr, seq & 255)
    tcp_send_bytes(sock, bytes_concat(hdr, payload))

// ---- auth (mysql_native_password) -------------------------------------------------------------------
// token = SHA1(pw) XOR SHA1( scramble(20) ++ SHA1(SHA1(pw)) ). Empty password -> empty token.
fn _my_native_pw(password: string, scramble) -> any
    if len(password) == 0
        return bytes(0)
    let pw = str_to_blist(password)
    let h1 = sha1_bytes(pw)
    let h2 = sha1_bytes(h1)
    let cat = []
    let i = 0
    while i < len(scramble)
        push(cat, scramble[i])
        i = i + 1
    i = 0
    while i < len(h2)
        push(cat, h2[i])
        i = i + 1
    let h3 = sha1_bytes(cat)
    let out = bytes(0)
    i = 0
    while i < 20
        out = bytes_append(out, (h1[i] ^ h3[i]) & 255)
        i = i + 1
    out

// caching_sha2_password fast-path token = SHA256(pw) XOR SHA256( SHA256(SHA256(pw)) ++ scramble(20) ), 32 bytes.
fn _my_caching_sha2_pw(password: string, scramble) -> any
    if len(password) == 0
        return bytes(0)
    let pw = str_to_blist(password)
    let h1 = sha256_bytes(pw)
    let h2 = sha256_bytes(h1)
    let cat = []
    let i = 0
    while i < len(h2)
        push(cat, h2[i])
        i = i + 1
    i = 0
    while i < len(scramble)
        push(cat, scramble[i])
        i = i + 1
    let h3 = sha256_bytes(cat)
    let out = bytes(0)
    i = 0
    while i < 32
        out = bytes_append(out, (h1[i] ^ h3[i]) & 255)
        i = i + 1
    out

// ---- connect ----------------------------------------------------------------------------------------
// mysql_connect -> ok(["my", sock]) authenticated + ready for queries, or err. Supports
// mysql_native_password (MySQL 5.7 default; 8.0 accounts created WITH mysql_native_password).
fn mysql_connect(host: string, port: int, user: string, db: string, password: string) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("mysql: cannot connect to " + host + ":" + str(port))
    let pkt = _my_read_packet(sock, bytes(0))
    if pkt[0] == 0 - 1
        tcp_close(sock)
        return err("mysql: no handshake packet")
    let payload = pkt[1]
    if bytes_get(payload, 0) != 10
        tcp_close(sock)
        return err("mysql: unsupported protocol version")
    let svr = _my_cstr(payload, 1)
    let off = svr[1]
    off = off + 4
    let scr1off = off
    off = off + 8 + 1
    off = off + 2 + 1 + 2 + 2
    let adl = bytes_get(payload, off)
    off = off + 1 + 10
    let part2 = adl - 8
    if part2 < 13
        part2 = 13
    let scr2off = off
    let scramble = []
    let si = 0
    while si < 8
        push(scramble, bytes_get(payload, scr1off + si))
        si = si + 1
    si = 0
    while si < 12
        push(scramble, bytes_get(payload, scr2off + si))
        si = si + 1
    let plugin_res = _my_cstr(payload, scr2off + part2)
    let srv_plugin = plugin_res[0]
    let token = bytes(0)
    let resp_plugin = "mysql_native_password"
    if srv_plugin == "caching_sha2_password"
        token = _my_caching_sha2_pw(password, scramble)
        resp_plugin = "caching_sha2_password"
    else
        token = _my_native_pw(password, scramble)
    // HandshakeResponse41
    let flags = 512 | 32768 | 524288 | 1
    if len(db) > 0
        flags = flags | 8
    let resp = _my_p4(flags)
    resp = bytes_concat(resp, _my_p4(16777215))
    resp = bytes_append(resp, 33)
    let z = 0
    while z < 23
        resp = bytes_append(resp, 0)
        z = z + 1
    resp = bytes_concat(resp, str_to_bytes(user))
    resp = bytes_append(resp, 0)
    resp = bytes_append(resp, bytes_len(token))
    resp = bytes_concat(resp, token)
    if len(db) > 0
        resp = bytes_concat(resp, str_to_bytes(db))
        resp = bytes_append(resp, 0)
    resp = bytes_concat(resp, str_to_bytes(resp_plugin))
    resp = bytes_append(resp, 0)
    _my_write_packet(sock, 1, resp)
    let r2 = _my_read_packet(sock, pkt[2])
    if r2[0] == 0 - 1
        tcp_close(sock)
        return err("mysql: connection closed during auth")
    let rp = r2[1]
    let first = bytes_get(rp, 0)
    if first == 255
        let errcode = _my_u(rp, 1, 2)
        let msg = bytes_to_str(bytes_slice(rp, 9, bytes_len(rp)))
        tcp_close(sock)
        return err("mysql: " + str(errcode) + " " + msg)
    if first == 1
        let status = bytes_get(rp, 1)
        if status == 3
            let r3 = _my_read_packet(sock, r2[2])
            if r3[0] == 0 - 1
                tcp_close(sock)
                return err("mysql: connection closed after caching_sha2 fast-auth")
            if bytes_get(r3[1], 0) == 255
                let ec = _my_u(r3[1], 1, 2)
                tcp_close(sock)
                return err("mysql: " + str(ec) + " " + bytes_to_str(bytes_slice(r3[1], 9, bytes_len(r3[1]))))
            return ok(["my", sock])
        tcp_close(sock)
        return err("mysql: caching_sha2 full authentication required (cold cache) -- needs TLS or RSA, not yet supported; prime the cache or use mysql_native_password")
    if first == 254
        tcp_close(sock)
        return err("mysql: server requested an auth-switch (unsupported plugin)")
    ok(["my", sock])

fn mysql_close(conn)
    tcp_close(conn[1])

// ---- query ------------------------------------------------------------------------------------------
// Run SQL (COM_QUERY). Returns ok(list of name-keyed string row dicts) for a SELECT, ok([]) for a
// statement with no result set (INSERT/UPDATE/DDL), or err(message).
// affected_rows from an OK packet. Layout: byte0 = 0x00 (OK marker), then affected_rows as a
// length-encoded int, then last_insert_id (lenenc), status_flags (2), warnings (2). Caller must have
// verified byte0 == 0x00 (an OK packet, not a result set or ERR).
fn mysql_ok_affected(pkt) -> int
    (_my_lenenc_int(pkt, 1))[0]

fn mysql_query(conn, sql: string) -> any
    let sock = conn[1]
    let q = bytes(0)
    q = bytes_append(q, 3)
    q = bytes_concat(q, str_to_bytes(sql))
    _my_write_packet(sock, 0, q)
    let buf = bytes(0)
    let p1 = _my_read_packet(sock, buf)
    if p1[0] == 0 - 1
        return err("mysql: connection closed during query")
    buf = p1[2]
    let head = p1[1]
    let fb = bytes_get(head, 0)
    if fb == 255
        let errcode = _my_u(head, 1, 2)
        return err("mysql: " + str(errcode) + " " + bytes_to_str(bytes_slice(head, 9, bytes_len(head))))
    if fb == 0
        // OK packet (INSERT/UPDATE/DELETE/DDL): byte0=0x00, then affected_rows as a lenenc-int.
        // SELECT returns a result set (fb = column count) and takes the row-reading path below, so
        // orm_all is unaffected; only exec-style statements reach here.
        return ok(mysql_ok_affected(head))
    let ccr = _my_lenenc_int(head, 0)
    let ncols = ccr[0]
    let colnames = []
    let ci = 0
    while ci < ncols
        let cp = _my_read_packet(sock, buf)
        buf = cp[2]
        let cdef = cp[1]
        let o = 0
        let s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        push(colnames, s[0])
        ci = ci + 1
    let ep = _my_read_packet(sock, buf)
    buf = ep[2]
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(sock, buf)
        if rp[0] == 0 - 1
            done = 1
        else
            buf = rp[2]
            let row = rp[1]
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let d = {}
                let o = 0
                let k = 0
                while k < ncols
                    if bytes_get(row, o) == 251
                        d[colnames[k]] = ""
                        o = o + 1
                    else
                        let sv = _my_lenenc_str(row, o)
                        d[colnames[k]] = sv[0]
                        o = sv[1]
                    k = k + 1
                push(rows, d)
    ok(rows)

// ---- prepared statements (binary protocol) ----------------------------------------------------------
// PRIVATE: left-pad an int to at least 2 / exactly 6 digits (temporal formatting).
fn _my_z2(n: int) -> string
    let s = str(n)
    if len(s) < 2
        return "0" + s
    s

fn _my_z6(n: int) -> string
    let s = str(n)
    while len(s) < 6
        s = "0" + s
    s

// Decode ONE binary-protocol value at `off` for column type `t` -> [string, next_off]. Integers ->
// decimal string; string/decimal/blob/json -> lenenc string; DATE/DATETIME/TIMESTAMP/TIME decode to
// ISO strings; FLOAT/DOUBLE decode via the float_from_bits/f32_from_bits reinterpret builtins.
// _my_u is unsigned (fine for ids/counts).
fn _my_bin_val(b, off: int, t: int) -> any
    if t == 1
        return [str(_my_u(b, off, 1)), off + 1]
    if t == 2 or t == 13
        return [str(_my_u(b, off, 2)), off + 2]
    if t == 3 or t == 9
        return [str(_my_u(b, off, 4)), off + 4]
    if t == 8
        return [str(_my_u(b, off, 8)), off + 8]
    if t == 4
        // FLOAT: 4-byte little-endian IEEE-754 single -> widen to double via f32_from_bits.
        return [str(f32_from_bits(_my_u(b, off, 4))), off + 4]
    if t == 5
        // DOUBLE: 8-byte little-endian IEEE-754 double. _my_u wraps to the exact 64-bit pattern;
        // float_from_bits reinterprets those bits as a NOVA float.
        return [str(float_from_bits(_my_u(b, off, 8))), off + 8]
    // binary DATE(10)/DATETIME(12)/TIMESTAMP(7): a length byte then that many payload bytes (0/4/7/11).
    // 4 = date only; 7 = + time; 11 = + microseconds. year is 2-byte LE, the rest single bytes.
    if t == 10 or t == 12 or t == 7
        let dlen = _my_u(b, off, 1)
        let dp = off + 1
        if dlen == 0
            return ["0000-00-00", dp]
        let yr = _my_u(b, dp, 2)
        let mo = _my_u(b, dp + 2, 1)
        let dy = _my_u(b, dp + 3, 1)
        let dstr = str(yr) + "-" + _my_z2(mo) + "-" + _my_z2(dy)
        if dlen == 4
            return [dstr, dp + 4]
        let hh = _my_u(b, dp + 4, 1)
        let mi = _my_u(b, dp + 5, 1)
        let se = _my_u(b, dp + 6, 1)
        let tstr = dstr + " " + _my_z2(hh) + ":" + _my_z2(mi) + ":" + _my_z2(se)
        if dlen == 7
            return [tstr, dp + 7]
        let dus = _my_u(b, dp + 7, 4)
        return [tstr + "." + _my_z6(dus), dp + 11]
    // binary TIME(11): length byte then sign(1) days(4 LE) hour(1) min(1) sec(1) [micros(4 LE)] (0/8/12).
    // MySQL TIME can exceed 24h (up to 838:59:59), so total hours = days*24 + hour (may be >2 digits).
    if t == 11
        let tlen = _my_u(b, off, 1)
        let tp = off + 1
        if tlen == 0
            return ["00:00:00", tp]
        let neg = _my_u(b, tp, 1)
        let days = _my_u(b, tp + 1, 4)
        let th = _my_u(b, tp + 5, 1)
        let tmi = _my_u(b, tp + 6, 1)
        let tse = _my_u(b, tp + 7, 1)
        let sign = ""
        if neg == 1
            sign = "-"
        let base = sign + _my_z2(days * 24 + th) + ":" + _my_z2(tmi) + ":" + _my_z2(tse)
        if tlen == 8
            return [base, tp + 8]
        let tus = _my_u(b, tp + 8, 4)
        return [base + "." + _my_z6(tus), tp + 12]
    let sres = _my_lenenc_str(b, off)
    [sres[0], sres[1]]

// Public seam over _my_bin_val for offline testing: decode one binary-protocol value -> [str, next_off].
fn mysql_bin_val(b, off: int, t: int) -> any
    _my_bin_val(b, off, t)

// Read num_def column-definition packets -> [names, types, leftover_buf], then consume the trailing EOF.
fn _my_read_coldefs(sock: int, buf, n: int) -> any
    let names = []
    let types = []
    let ci = 0
    while ci < n
        let cp = _my_read_packet(sock, buf)
        buf = cp[2]
        let cdef = cp[1]
        let o = 0
        let st = _my_lenenc_str(cdef, o)
        o = st[1]
        st = _my_lenenc_str(cdef, o)
        o = st[1]
        st = _my_lenenc_str(cdef, o)
        o = st[1]
        st = _my_lenenc_str(cdef, o)
        o = st[1]
        st = _my_lenenc_str(cdef, o)
        let cname = st[0]
        o = st[1]
        st = _my_lenenc_str(cdef, o)
        o = st[1]
        push(names, cname)
        push(types, bytes_get(cdef, o + 1 + 2 + 4))
        ci = ci + 1
    if n > 0
        let e = _my_read_packet(sock, buf)
        buf = e[2]
    [names, types, buf]

// Parameterized query via a PREPARED STATEMENT (COM_STMT_PREPARE + COM_STMT_EXECUTE, binary protocol).
// Every param is bound as MYSQL_TYPE_VAR_STRING and the server coerces it to the column type -> NO string
// inlining/escaping, injection-safe, and numeric-correct. Returns ok(name-keyed string row dicts) /
// ok([]) for a no-result-set statement / err.
fn mysql_query_params(conn, sql: string, params) -> any
    let sock = conn[1]
    let pq = bytes(0)
    pq = bytes_append(pq, 22)
    pq = bytes_concat(pq, str_to_bytes(sql))
    _my_write_packet(sock, 0, pq)
    let buf = bytes(0)
    let pr = _my_read_packet(sock, buf)
    if pr[0] == 0 - 1
        return err("mysql: connection closed during prepare")
    buf = pr[2]
    let pp = pr[1]
    if bytes_get(pp, 0) == 255
        return err("mysql: " + str(_my_u(pp, 1, 2)) + " " + bytes_to_str(bytes_slice(pp, 9, bytes_len(pp))))
    let stmt_id = _my_u(pp, 1, 4)
    let num_cols = _my_u(pp, 5, 2)
    let num_params = _my_u(pp, 7, 2)
    let pd = _my_read_coldefs(sock, buf, num_params)
    buf = pd[2]
    let cd = _my_read_coldefs(sock, buf, num_cols)
    buf = cd[2]
    let ex = bytes(0)
    ex = bytes_append(ex, 23)
    ex = bytes_concat(ex, _my_p4(stmt_id))
    ex = bytes_append(ex, 0)
    ex = bytes_concat(ex, _my_p4(1))
    let np = len(params)
    if np > 0
        let nbm = (np + 7) / 8
        let bi = 0
        while bi < nbm
            ex = bytes_append(ex, 0)
            bi = bi + 1
        ex = bytes_append(ex, 1)
        let ti = 0
        while ti < np
            ex = bytes_append(ex, 253)
            ex = bytes_append(ex, 0)
            ti = ti + 1
        let vi = 0
        while vi < np
            ex = bytes_concat(ex, _my_wr_lenstr(str_to_bytes(str(params[vi]))))
            vi = vi + 1
    _my_write_packet(sock, 0, ex)
    let xr = _my_read_packet(sock, buf)
    if xr[0] == 0 - 1
        return err("mysql: connection closed during execute")
    buf = xr[2]
    let xp = xr[1]
    let xf = bytes_get(xp, 0)
    if xf == 255
        return err("mysql: " + str(_my_u(xp, 1, 2)) + " " + bytes_to_str(bytes_slice(xp, 9, bytes_len(xp))))
    if xf == 0
        // OK packet: affected_rows is a lenenc-int right after the 0x00 marker (same as text protocol).
        return ok(mysql_ok_affected(xp))
    let rcc = _my_lenenc_int(xp, 0)
    let rncols = rcc[0]
    let rc = _my_read_coldefs(sock, buf, rncols)
    let rnames = rc[0]
    let rtypes = rc[1]
    buf = rc[2]
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(sock, buf)
        if rp[0] == 0 - 1
            done = 1
        else
            buf = rp[2]
            let row = rp[1]
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let nbmlen = (rncols + 7 + 2) / 8
                let o = 1 + nbmlen
                let d = {}
                let k = 0
                while k < rncols
                    let bytei = 1 + ((k + 2) / 8)
                    let biti = (k + 2) % 8
                    if ((bytes_get(row, bytei) >> biti) & 1) == 1
                        d[rnames[k]] = ""
                    else
                        let dec = _my_bin_val(row, o, rtypes[k])
                        d[rnames[k]] = dec[0]
                        o = dec[1]
                    k = k + 1
                push(rows, d)
    ok(rows)
