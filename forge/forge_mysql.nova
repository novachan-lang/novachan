// forge_mysql -- pure-NOVA MySQL wire-protocol driver. Speaks HandshakeV10, mysql_native_password /
// caching_sha2_password auth, COM_QUERY (text) and COM_STMT_PREPARE/EXECUTE (binary), connection
// pooling, and transactions. Rows come back as name-keyed string/null dicts for forge_orm compatibility.
import forge_crypto
import forge_pg

// ── data types ──────────────────────────────────────────────────────────────────────────────────
type MysqlConn
    is_tls: int
    handle: int

type MysqlPacket
    seq: int
    payload: bytes
    leftover: bytes

type ColDefs
    names: list
    types: list
    flags: list
    leftover: bytes

// ── little-endian helpers ───────────────────────────────────────────────────────────────────────
fn _my_le_list(v: int, w: int) -> list
    [(v >> (i * 8)) & 255 for i in 0..w]

fn _my_u(b, off: int, n: int) -> int
    reduce([bytes_get(b, off + n - 1 - i) for i in 0..n], (acc, v) => (acc << 8) | v, 0)

fn _my_i(b, off: int, n: int) -> int
    let u = _my_u(b, off, n)
    let sign_bit = 1 << (n * 8 - 1)
    u - (sign_bit << 1) if u >= sign_bit else u

fn _my_p3(n: int) -> any
    bytes_from_list(_my_le_list(n, 3))

fn _my_p4(n: int) -> any
    bytes_from_list(_my_le_list(n, 4))

fn _my_cstr(b, off: int) -> any
    let endp = off
    while endp < bytes_len(b) and bytes_get(b, endp) != 0
        endp += 1
    [bytes_to_str(bytes_slice(b, off, endp)), endp + 1]

fn _my_lenenc_int(b, off: int) -> any
    let f = bytes_get(b, off)
    if f < 251
        return [f, off + 1]
    if f == 252
        return [_my_u(b, off + 1, 2), off + 3]
    if f == 253
        return [_my_u(b, off + 1, 3), off + 4]
    if f == 254
        return [_my_u(b, off + 1, 8), off + 9]
    [0, off + 1]

// 0xfb (251) = SQL NULL -> NOVA null (not "")
fn _my_lenenc_str(b, off: int) -> any
    if bytes_get(b, off) == 251
        return [null, off + 1]
    let li = _my_lenenc_int(b, off)
    let n = li[0]
    let start = li[1]
    [bytes_to_str(bytes_slice(b, start, start + n)), start + n]

fn _my_wr_lenenc(n: int) -> any
    if n < 251
        return bytes_from_list([n])
    if n < 65536
        return bytes_from_list([252, ..._my_le_list(n, 2)])
    bytes_from_list([253, ..._my_le_list(n, 3)])

fn _my_wr_lenstr(sb) -> any
    bytes_concat(_my_wr_lenenc(bytes_len(sb)), sb)

fn _my_lenenc_str_n(b, off: int, n: int) -> any
    let o = off
    let s = ["", off]
    for i in 0..n
        s = _my_lenenc_str(b, o)
        o = s[1]
    s

// ── transport (dispatch on conn.is_tls) ─────────────────────────────────────────────────────────
fn _my_send(conn: MysqlConn, data)
    if conn.is_tls == 1
        tls_send_bytes(conn.handle, data)
    else
        tcp_send_bytes(conn.handle, data)

fn _my_recv_chunk(conn: MysqlConn) -> any
    if conn.is_tls == 1
        return tls_recv_bytes(conn.handle)
    tcp_recv_bytes(conn.handle)

fn _my_close_transport(conn: MysqlConn)
    if conn.is_tls == 1
        tls_close(conn.handle)
    else
        tcp_close(conn.handle)

fn _my_recv_at_least(conn: MysqlConn, buf, need: int) -> any
    while bytes_len(buf) < need
        let chunk = _my_recv_chunk(conn)
        if bytes_len(chunk) == 0
            return buf
        buf = bytes_concat(buf, chunk)
    buf

// ── packet I/O ──────────────────────────────────────────────────────────────────────────────────
// Read one whole packet -> MysqlPacket. seq == -1 means EOF/short read. Reassembles >16MB payloads.
fn _my_read_packet(conn: MysqlConn, buf) -> MysqlPacket
    buf = _my_recv_at_least(conn, buf, 4)
    if bytes_len(buf) < 4
        return MysqlPacket(-1, bytes(0), buf)
    let plen = _my_u(buf, 0, 3)
    let seq = bytes_get(buf, 3)
    let total = 4 + plen
    buf = _my_recv_at_least(conn, buf, total)
    if bytes_len(buf) < total
        return MysqlPacket(-1, bytes(0), buf)
    let payload = bytes_slice(buf, 4, total)
    buf = bytes_slice(buf, total, bytes_len(buf))
    while plen == 16777215
        buf = _my_recv_at_least(conn, buf, 4)
        if bytes_len(buf) < 4
            return MysqlPacket(-1, bytes(0), buf)
        plen = _my_u(buf, 0, 3)
        seq = bytes_get(buf, 3)
        total = 4 + plen
        buf = _my_recv_at_least(conn, buf, total)
        if bytes_len(buf) < total
            return MysqlPacket(-1, bytes(0), buf)
        payload = bytes_concat(payload, bytes_slice(buf, 4, total))
        buf = bytes_slice(buf, total, bytes_len(buf))
    MysqlPacket(seq, payload, buf)

fn _my_write_packet(conn: MysqlConn, seq: int, payload)
    let hdr = bytes_from_list([..._my_le_list(bytes_len(payload), 3), seq & 255])
    _my_send(conn, bytes_concat(hdr, payload))

// ── auth (mysql_native_password / caching_sha2_password) ────────────────────────────────────────
// Both plugins: h1 = H(pw); h3 = H(salted H(h1)); token = h1 XOR h3. Hash + concat order differ.
fn _my_xor_auth_token(password: string, scramble, hashfn, h2_first: int) -> any
    if len(password) == 0
        return bytes(0)
    let h1 = hashfn(str_to_blist(password))
    let h2 = hashfn(h1)
    let cat = [...h2, ...scramble] if h2_first == 1 else [...scramble, ...h2]
    let h3 = hashfn(cat)
    bytes_from_list([(h1[i] ^ h3[i]) & 255 for i in 0..len(h1)])

fn _my_native_pw(password: string, scramble) -> any
    _my_xor_auth_token(password, scramble, (m) => sha1_bytes(m), 0)

fn _my_caching_sha2_pw(password: string, scramble) -> any
    _my_xor_auth_token(password, scramble, (m) => sha256_bytes(m), 1)

fn _my_err_msg(p) -> string
    let code = _my_u(p, 1, 2)
    let sqlstate = bytes_to_str(bytes_slice(p, 4, 9))
    let msg = bytes_to_str(bytes_slice(p, 9, bytes_len(p)))
    "mysql: [{sqlstate}] {code} {msg}"

// ── connect ─────────────────────────────────────────────────────────────────────────────────────
fn _my_handshake_header(flags: int) -> any
    bytes_from_list([..._my_le_list(flags, 4), ..._my_le_list(16777215, 4), 45, ...[0 for zi in 0..23]])

// Handle AuthMoreData (byte0 == 1) for caching_sha2_password fast/full paths.
fn _my_handle_auth_more(conn: MysqlConn, rp, r2: MysqlPacket, password: string, use_tls: int) -> any
    let status = bytes_get(rp, 1)
    if status == 3
        let r3 = _my_read_packet(conn, r2.leftover)
        if r3.seq == -1
            _my_close_transport(conn)
            return err("mysql: connection closed after caching_sha2 fast-auth")
        if bytes_get(r3.payload, 0) == 255
            _my_close_transport(conn)
            return err(_my_err_msg(r3.payload))
        return ok(conn)
    if use_tls == 1
        let pw_bytes = bytes_append(str_to_bytes(password), 0)
        _my_write_packet(conn, r2.seq + 1, pw_bytes)
        let r4 = _my_read_packet(conn, r2.leftover)
        if r4.seq == -1
            _my_close_transport(conn)
            return err("mysql: connection closed during caching_sha2 full auth")
        if bytes_get(r4.payload, 0) == 255
            _my_close_transport(conn)
            return err(_my_err_msg(r4.payload))
        return ok(conn)
    _my_close_transport(conn)
    err("mysql: caching_sha2 full auth requires TLS (use mysql_connect_tls) or prime the server cache")

fn _my_connect_impl(host: string, port: int, user: string, db: string, password: string, use_tls: int) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("mysql: cannot connect to {host}:{port}")
    let conn = MysqlConn(0, sock)
    let pkt = _my_read_packet(conn, bytes(0))
    if pkt.seq == -1
        _my_close_transport(conn)
        return err("mysql: no handshake packet")
    let payload = pkt.payload
    if bytes_get(payload, 0) != 10
        _my_close_transport(conn)
        return err("mysql: unsupported protocol version")
    let svr = _my_cstr(payload, 1)
    let off = svr[1] + 4
    let scr1off = off
    off += 8 + 1 + 2 + 1 + 2 + 2
    let adl = bytes_get(payload, off)
    off += 1 + 10
    let part2 = max([adl - 8, 13])
    let scr2off = off
    let scramble = [...[bytes_get(payload, scr1off + si) for si in 0..8], ...[bytes_get(payload, scr2off + si) for si in 0..12]]
    let plugin_res = _my_cstr(payload, scr2off + part2)
    let srv_plugin = plugin_res[0]
    let is_sha2 = srv_plugin == "caching_sha2_password"
    let token = _my_caching_sha2_pw(password, scramble) if is_sha2 else _my_native_pw(password, scramble)
    let resp_plugin = "caching_sha2_password" if is_sha2 else "mysql_native_password"
    let flags = 512 | 32768 | 524288 | 1
    if len(db) > 0
        flags = flags | 8
    let resp_seq = 1
    if use_tls == 1
        flags = flags | 2048
        _my_write_packet(conn, 1, _my_handshake_header(flags))
        let tls = tls_upgrade(sock, host, 1)
        if tls == 0
            tcp_close(sock)
            return err("mysql: TLS handshake/verification failed")
        conn = MysqlConn(1, tls)
        resp_seq = 2
    let resp = _my_handshake_header(flags)
    resp = bytes_concat(resp, str_to_bytes(user))
    resp = bytes_append(resp, 0)
    resp = bytes_append(resp, bytes_len(token))
    resp = bytes_concat(resp, token)
    if len(db) > 0
        resp = bytes_concat(resp, str_to_bytes(db))
        resp = bytes_append(resp, 0)
    resp = bytes_concat(resp, str_to_bytes(resp_plugin))
    resp = bytes_append(resp, 0)
    _my_write_packet(conn, resp_seq, resp)
    let r2 = _my_read_packet(conn, pkt.leftover)
    if r2.seq == -1
        _my_close_transport(conn)
        return err("mysql: connection closed during auth")
    let rp = r2.payload
    let first = bytes_get(rp, 0)
    if first == 255
        _my_close_transport(conn)
        return err(_my_err_msg(rp))
    if first == 1
        return _my_handle_auth_more(conn, rp, r2, password, use_tls)
    if first == 254
        _my_close_transport(conn)
        return err("mysql: server requested an auth-switch (unsupported plugin)")
    ok(conn)

fn mysql_connect(host: string, port: int, user: string, db: string, password: string) -> any
    _my_connect_impl(host, port, user, db, password, 0)

fn mysql_connect_tls(host: string, port: int, user: string, db: string, password: string) -> any
    _my_connect_impl(host, port, user, db, password, 1)

// COM_QUIT (opcode 1) + close transport.
fn mysql_close(conn: MysqlConn)
    _my_write_packet(conn, 0, bytes_from_list([1]))
    _my_close_transport(conn)

// COM_PING (opcode 14): round-trip liveness check. true = alive, false = dead.
fn mysql_ping(conn: MysqlConn) -> bool
    _my_write_packet(conn, 0, bytes_from_list([14]))
    let pkt = _my_read_packet(conn, bytes(0))
    pkt.seq != -1 and bytes_get(pkt.payload, 0) == 0

// ── query (text protocol) ───────────────────────────────────────────────────────────────────────
fn mysql_ok_affected(pkt) -> int
    (_my_lenenc_int(pkt, 1))[0]

// COM_QUERY -> ok(list of row dicts) for SELECT, ok(affected_rows: int) for DML, or err.
fn mysql_query(conn: MysqlConn, sql: string) -> any
    _my_write_packet(conn, 0, bytes_concat(bytes_from_list([3]), str_to_bytes(sql)))
    let buf = bytes(0)
    let p1 = _my_read_packet(conn, buf)
    if p1.seq == -1
        return err("mysql: connection closed during query")
    buf = p1.leftover
    let head = p1.payload
    let fb = bytes_get(head, 0)
    if fb == 255
        return err(_my_err_msg(head))
    if fb == 0
        return ok(mysql_ok_affected(head))
    let ncols = (_my_lenenc_int(head, 0))[0]
    let colnames = []
    for ci in 0..ncols
        let cp = _my_read_packet(conn, buf)
        buf = cp.leftover
        push(colnames, (_my_lenenc_str_n(cp.payload, 0, 5))[0])
    let ep = _my_read_packet(conn, buf)
    buf = ep.leftover
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(conn, buf)
        if rp.seq == -1
            done = 1
        else
            buf = rp.leftover
            let row = rp.payload
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let d = {}
                let o = 0
                for k in 0..ncols
                    if bytes_get(row, o) == 251
                        d[colnames[k]] = null
                        o += 1
                    else
                        let sv = _my_lenenc_str(row, o)
                        d[colnames[k]] = sv[0]
                        o = sv[1]
                push(rows, d)
    ok(rows)

// ── binary protocol (prepared statements) ───────────────────────────────────────────────────────
fn _my_z2(n: int) -> string
    str_pad_left(str(n), 2, "0")

fn _my_z6(n: int) -> string
    str_pad_left(str(n), 6, "0")

// Decode a signed or unsigned integer of width n at offset -> [str, next_off].
fn _my_decode_int(b, off: int, n: int, unsigned: int) -> any
    let v = _my_u(b, off, n) if unsigned == 1 else _my_i(b, off, n)
    [str(v), off + n]

// Decode DATE/DATETIME/TIMESTAMP at offset -> [iso_string, next_off].
fn _my_decode_date(b, off: int, has_time: int) -> any
    let dlen = _my_u(b, off, 1)
    let dp = off + 1
    if dlen == 0
        return ["0000-00-00 00:00:00" if has_time == 1 else "0000-00-00", dp]
    let yr = _my_u(b, dp, 2)
    let mo = _my_u(b, dp + 2, 1)
    let dy = _my_u(b, dp + 3, 1)
    let dstr = "{yr}-{_my_z2(mo)}-{_my_z2(dy)}"
    if dlen == 4
        return ["{dstr} 00:00:00" if has_time == 1 else dstr, dp + 4]
    let hh = _my_u(b, dp + 4, 1)
    let mi = _my_u(b, dp + 5, 1)
    let se = _my_u(b, dp + 6, 1)
    let tstr = "{dstr} {_my_z2(hh)}:{_my_z2(mi)}:{_my_z2(se)}"
    if dlen == 7
        return [tstr, dp + 7]
    let dus = _my_u(b, dp + 7, 4)
    ["{tstr}.{_my_z6(dus)}", dp + 11]

// Decode TIME at offset -> [hh:mm:ss string, next_off]. MySQL TIME can exceed 24h.
fn _my_decode_time(b, off: int) -> any
    let tlen = _my_u(b, off, 1)
    let tp = off + 1
    if tlen == 0
        return ["00:00:00", tp]
    let neg = _my_u(b, tp, 1)
    let days = _my_u(b, tp + 1, 4)
    let th = _my_u(b, tp + 5, 1)
    let tmi = _my_u(b, tp + 6, 1)
    let tse = _my_u(b, tp + 7, 1)
    let sign = "-" if neg == 1 else ""
    let base = "{sign}{_my_z2(days * 24 + th)}:{_my_z2(tmi)}:{_my_z2(tse)}"
    if tlen == 8
        return [base, tp + 8]
    let tus = _my_u(b, tp + 8, 4)
    ["{base}.{_my_z6(tus)}", tp + 12]

// Decode one binary-protocol value by MySQL column type -> [string, next_off].
fn _my_bin_val(b, off: int, t: int, unsigned: int) -> any
    match t
        1 => _my_decode_int(b, off, 1, unsigned)
        2 => _my_decode_int(b, off, 2, unsigned)
        13 => _my_decode_int(b, off, 2, unsigned)
        3 => _my_decode_int(b, off, 4, unsigned)
        9 => _my_decode_int(b, off, 4, unsigned)
        8 => _my_decode_int(b, off, 8, unsigned)
        4 => [str(f32_from_bits(_my_u(b, off, 4))), off + 4]
        5 => [str(float_from_bits(_my_u(b, off, 8))), off + 8]
        10 => _my_decode_date(b, off, 0)
        12 => _my_decode_date(b, off, 1)
        7 => _my_decode_date(b, off, 1)
        11 => _my_decode_time(b, off)
        _ => _my_lenenc_str(b, off)

fn mysql_bin_val(b, off: int, t: int) -> any
    _my_bin_val(b, off, t, 0)

// Read n column-definition packets -> ColDefs struct, then consume trailing EOF.
fn _my_read_coldefs(conn: MysqlConn, buf, n: int) -> ColDefs
    let names = []
    let types = []
    let flags = []
    for ci in 0..n
        let cp = _my_read_packet(conn, buf)
        buf = cp.leftover
        let cdef = cp.payload
        let st = _my_lenenc_str_n(cdef, 0, 5)
        push(names, st[0])
        let o = (_my_lenenc_str(cdef, st[1]))[1]
        push(types, bytes_get(cdef, o + 1 + 2 + 4))
        push(flags, _my_u(cdef, o + 1 + 2 + 4 + 1, 2))
    if n > 0
        let e = _my_read_packet(conn, buf)
        buf = e.leftover
    ColDefs(names, types, flags, buf)

fn _my_stmt_close(conn: MysqlConn, stmt_id: int)
    _my_write_packet(conn, 0, bytes_from_list([25, ..._my_le_list(stmt_id, 4)]))

// Bound parameters go out in TEXT form. A NOVA bool must become "1"/"0", not str()'s
// "true"/"false": MySQL accepts 1/0 for TINYINT(1), BOOLEAN and INT alike, whereas 'true' into an
// INT column is coerced to 0 in a permissive sqlmode and REJECTED under STRICT_TRANS_TABLES --
// either way the value is wrong. This mirrors the identical fix in forge_orm for PostgreSQL, where
// 'true' into an int column is a hard 22P02 error.
// Detecting the bool has to accept BOTH of its representations: read inline a NOVA bool is
// str()="1"/type_name()="int", but passed across a function-call boundary (exactly what happens
// here) it is str()="true"/type_name()="bool". Excluding strings is what keeps a genuine TEXT value
// of "true" from being rewritten to "1".
fn _my_param_str(p) -> string
    let s = str(p)
    if type_name(p) != "string" and (s == "true" or s == "false")
        return "1" if s == "true" else "0"
    s

// COM_STMT_PREPARE + COM_STMT_EXECUTE -> ok(row dicts) / ok(affected: int) / err.
// All params bound as MYSQL_TYPE_VAR_STRING; null params use the null-bitmap.
fn mysql_query_params(conn: MysqlConn, sql: string, params) -> any
    _my_write_packet(conn, 0, bytes_concat(bytes_from_list([22]), str_to_bytes(sql)))
    let buf = bytes(0)
    let pr = _my_read_packet(conn, buf)
    if pr.seq == -1
        return err("mysql: connection closed during prepare")
    buf = pr.leftover
    let pp = pr.payload
    if bytes_get(pp, 0) == 255
        return err(_my_err_msg(pp))
    let stmt_id = _my_u(pp, 1, 4)
    defer _my_stmt_close(conn, stmt_id)
    let num_cols = _my_u(pp, 5, 2)
    let num_params = _my_u(pp, 7, 2)
    let pd = _my_read_coldefs(conn, buf, num_params)
    buf = pd.leftover
    let cd = _my_read_coldefs(conn, buf, num_cols)
    buf = cd.leftover
    let ex = bytes_from_list([23, ..._my_le_list(stmt_id, 4), 0, ..._my_le_list(1, 4)])
    let np = len(params)
    if np > 0
        let nbm = (np + 7) / 8
        // THE NULL BITMAP IS LEFT ALL-ZERO DELIBERATELY -- do not "restore" the check below.
        //
        // This used to set a bit whenever `params[pi] == null`. But NOVA HAS NO DISTINGUISHABLE NULL
        // VALUE: null is represented as 0, and the runtime's own predicate is literally
        // `nova_rt_is_null(p) { return p == 0; }`. So `0 == null` is TRUE, and EVERY BOUND INTEGER
        // ZERO was flagged NULL and had its value omitted -- MySQL stored NULL for it.
        // Verified against a live server: binding 0 stored NULL, while 1, -5, the string "0", and a
        // literal 0 written into the SQL all stored correctly. Silent data corruption on the single
        // most ordinary value in a database: every zeroed count, flag, quantity, balance or
        // bool-as-int became NULL. It also made rows VANISH from typed reads, because a null cannot
        // be mapped onto an `int` struct field and <T>__from_dict_list drops rows it cannot map.
        //
        // A real SQL NULL is expressed the way forge_orm already does it uniformly for every driver:
        // orm_null() -> _orm_apply_nulls rewrites that placeholder into the literal NULL keyword
        // BEFORE the driver is reached. So inferring NULL from a bound value here is both impossible
        // (no distinguishable null) and redundant (the ORM has already handled it).
        let null_bm = [0 for bi in 0..nbm]
        ex = bytes_concat(ex, bytes_from_list([...null_bm, 1, ...[253 if ti % 2 == 0 else 0 for ti in 0..(np * 2)]]))
        for pv in params
            ex = bytes_concat(ex, _my_wr_lenstr(str_to_bytes(_my_param_str(pv))))
    _my_write_packet(conn, 0, ex)
    let xr = _my_read_packet(conn, buf)
    if xr.seq == -1
        return err("mysql: connection closed during execute")
    buf = xr.leftover
    let xp = xr.payload
    let xf = bytes_get(xp, 0)
    if xf == 255
        return err(_my_err_msg(xp))
    if xf == 0
        return ok(mysql_ok_affected(xp))
    let rncols = (_my_lenenc_int(xp, 0))[0]
    let rc = _my_read_coldefs(conn, buf, rncols)
    let rnames = rc.names
    let rtypes = rc.types
    let rflags = rc.flags
    buf = rc.leftover
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(conn, buf)
        if rp.seq == -1
            done = 1
        else
            buf = rp.leftover
            let row = rp.payload
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let nbmlen = (rncols + 7 + 2) / 8
                let o = 1 + nbmlen
                let d = {}
                for k in 0..rncols
                    let bytei = 1 + ((k + 2) / 8)
                    let biti = (k + 2) % 8
                    if ((bytes_get(row, bytei) >> biti) & 1) == 1
                        d[rnames[k]] = null
                    else
                        let is_unsigned = 1 if (rflags[k] & 32) == 32 else 0
                        let dec = _my_bin_val(row, o, rtypes[k], is_unsigned)
                        d[rnames[k]] = dec[0]
                        o = dec[1]
                push(rows, d)
    ok(rows)

// ── connection pool + transactions ──────────────────────────────────────────────────────────────
fn mysql_pool_open(host: string, port: int, user: string, db: string, password: string, n: int) -> any
    let ch = channel()
    let opened = 0
    for i in 0..n
        let r = mysql_connect(host, port, user, db, password)
        if is_ok(r)
            send(ch, unwrap(r))
            opened += 1
        else
            for j in 0..opened
                mysql_close(recv(ch))
            return r
    ok(ch)

// Default bounded-acquire budget (module-level INT is safe; a module-level dict reads back EMPTY).
let _MY_ACQUIRE_TIMEOUT_MS = 5000

// ── crash-safe, bounded pool acquire/release ────────────────────────────────────────────────────
// Same defect class that was fixed in forge_pg: `defer send(pool, conn)` is NOT crash-safe, because
// `defer` is a COMPILE-TIME construct inlined at a function's exit points and a panic longjmps past
// all of them -- so a handler that crashed holding a pooled connection leaked it permanently, and
// after N crashes (N = pool size) every later unbounded recv(pool) parked FOREVER. on_exit_send
// registers a release the fiber trampoline drains on BOTH the normal and crashed exit path, and
// cancel_on_exit_val cancels it on the normal path, so release happens exactly once either way.
// NEVER pair on_exit_send with a bare `send` -- that returns the connection TWICE and puts duplicate
// handles in the pool, which is precisely the bug that was live in forge_orm's sqlite path.
fn _my_acq(pool, ms: int) -> any
    let r = select_timeout(pool, ms)
    if r[0] == 0
        on_exit_send(pool, r[1])
        return ok(r[1])
    err("mysql: pool acquire timeout after {ms}ms (all connections busy)")

fn _my_rel(pool, conn)
    send(pool, conn)
    cancel_on_exit_val(pool, conn)

// A connection-level failure means THIS connection is unusable. Returning it to the pool re-poisons
// it for the next caller -- MySQL is especially unforgiving here because a desynced packet sequence
// makes the NEXT query on that socket read the PREVIOUS query's response.
fn _my_discard(pool, conn)
    cancel_on_exit_val(pool, conn)
    mysql_close(conn)

fn mysql_pool_acquire(pool)
    let a = _my_acq(pool, _MY_ACQUIRE_TIMEOUT_MS)
    if is_err(a)
        return null
    unwrap(a)

fn mysql_pool_release(pool, conn: MysqlConn)
    _my_rel(pool, conn)

// Health-checked acquire: COM_PING the connection, replace if dead.
fn mysql_pool_acquire_healthy(pool, host: string, port: int, user: string, db: string, password: string) -> any
    let conn = recv(pool)
    if mysql_ping(conn)
        return ok(conn)
    _my_close_transport(conn)
    mysql_connect(host, port, user, db, password)

fn mysql_pool_query(pool, sql: string) -> any
    let a = _my_acq(pool, _MY_ACQUIRE_TIMEOUT_MS)
    if is_err(a)
        return a
    let conn: MysqlConn = unwrap(a)
    let r = mysql_query(conn, sql)
    _my_rel(pool, conn)
    r

fn mysql_pool_query_params(pool, sql: string, params) -> any
    let a = _my_acq(pool, _MY_ACQUIRE_TIMEOUT_MS)
    if is_err(a)
        return a
    let conn: MysqlConn = unwrap(a)
    let r = mysql_query_params(conn, sql, params)
    _my_rel(pool, conn)
    r

// START TRANSACTION -> body_fn(conn) -> COMMIT on ok / ROLLBACK on err, EVERY step checked.
//
// This previously DISCARDED the results of START TRANSACTION, COMMIT and ROLLBACK and returned the
// BODY's Result -- the same silent data-integrity failure that was fixed in forge_pg.pg_with_tx:
//   1. START TRANSACTION failed -> the body then ran with autocommit still on, so each statement
//      committed individually. A "transaction" with zero atomicity, reported as a transaction.
//   2. COMMIT failed -> returned the body's ok(...). On MySQL/InnoDB a COMMIT can fail on lock-wait
//      timeout, deadlock rollback (1213), or a dropped connection; the caller was told data had
//      persisted that the server had just discarded.
fn mysql_with_tx(pool, body_fn) -> any
    let a = _my_acq(pool, _MY_ACQUIRE_TIMEOUT_MS)
    if is_err(a)
        return a
    let conn: MysqlConn = unwrap(a)
    let b = mysql_query(conn, "START TRANSACTION")
    if is_err(b)
        // No transaction was opened -- running the body would silently autocommit each statement.
        _my_rel(pool, conn)
        return err("mysql tx: START TRANSACTION failed: {str(unwrap_err(b))}")
    let r = body_fn(conn)
    if is_err(r)
        let rb = mysql_query(conn, "ROLLBACK")
        if is_err(rb)
            _my_discard(pool, conn)
        else
            _my_rel(pool, conn)
        return r
    let c = mysql_query(conn, "COMMIT")
    if is_err(c)
        _my_discard(pool, conn)
        return err("mysql tx: COMMIT failed, transaction did NOT persist: {str(unwrap_err(c))}")
    _my_rel(pool, conn)
    r

// Drain and close up to n pooled connections, BOUNDED so shutdown cannot hang. The old unbounded
// recv(pool) parked forever on the first missing connection -- and one is missing whenever a
// connection was discarded as dead or is still checked out by an in-flight request.
fn mysql_pool_close(pool, n: int)
    let closed = 0
    for i in 0..n
        let r = select_timeout(pool, 2000)
        if r[0] == 0
            let c: MysqlConn = r[1]
            mysql_close(c)
            closed += 1
    closed
