// forge_mysql -- pure-NOVA MySQL driver over raw TCP (no libmysqlclient), mirroring forge_pg. Speaks the
// classic MySQL protocol: LE packet framing (3-byte length + 1-byte seq), HandshakeV10, the
// mysql_native_password auth (SHA-1), COM_QUERY, and length-encoded result-set parsing. Rows come back as
// name-keyed string dicts -- so forge_orm's typed mapping (orm_all<T>/orm_one<T>) works unchanged.
// Auth token = SHA1(pw) XOR SHA1(scramble ++ SHA1(SHA1(pw))); values are always parameterized upstream.
import forge_crypto

// ---- little-endian helpers --------------------------------------------------------------------------
fn _my_u(b, off: int, n: int) -> int
    let v = 0
    let i = 0
    let mul = 1
    while i < n
        v = v + bytes_get(b, off + i) * mul
        mul = mul * 256
        i = i + 1
    v

fn _my_p3(n: int) -> any
    let b = bytes(0)
    b = bytes_append(b, n & 255)
    b = bytes_append(b, (n >> 8) & 255)
    b = bytes_append(b, (n >> 16) & 255)
    b

fn _my_p4(n: int) -> any
    let b = bytes(0)
    b = bytes_append(b, n & 255)
    b = bytes_append(b, (n >> 8) & 255)
    b = bytes_append(b, (n >> 16) & 255)
    b = bytes_append(b, (n >> 24) & 255)
    b

fn _my_cstr(b, off: int) -> any
    let endp = off
    while endp < bytes_len(b) and bytes_get(b, endp) != 0
        endp = endp + 1
    [bytes_to_str(bytes_slice(b, off, endp)), endp + 1]

// length-encoded integer -> [value, next_off].
fn _my_lenenc_int(b, off: int) -> any
    let f = bytes_get(b, off)
    if f < 251
        return [f, off + 1]
    if f == 252
        return [_my_u(b, off + 1, 2), off + 3]
    if f == 253
        return [_my_u(b, off + 1, 3), off + 4]
    if f == 254
        return [_my_u(b, off + 1, 8), off + 9]
    [0, off + 1]

// length-encoded string -> [string, next_off]. 0xfb (251) = SQL NULL -> "".
fn _my_lenenc_str(b, off: int) -> any
    if bytes_get(b, off) == 251
        return ["", off + 1]
    let li = _my_lenenc_int(b, off)
    let n = li[0]
    let start = li[1]
    [bytes_to_str(bytes_slice(b, start, start + n)), start + n]

// ---- packet IO --------------------------------------------------------------------------------------
fn _my_recv_at_least(sock: int, buf, need: int) -> any
    while bytes_len(buf) < need
        let chunk = tcp_recv_bytes(sock)
        if bytes_len(chunk) == 0
            return buf
        buf = bytes_concat(buf, chunk)
    buf

// Read one whole packet -> [seq, payload, leftover]. seq -1 = EOF/short read.
fn _my_read_packet(sock: int, buf) -> any
    buf = _my_recv_at_least(sock, buf, 4)
    if bytes_len(buf) < 4
        return [0 - 1, bytes(0), buf]
    let plen = _my_u(buf, 0, 3)
    let seq = bytes_get(buf, 3)
    let total = 4 + plen
    buf = _my_recv_at_least(sock, buf, total)
    if bytes_len(buf) < total
        return [0 - 1, bytes(0), buf]
    [seq, bytes_slice(buf, 4, total), bytes_slice(buf, total, bytes_len(buf))]

fn _my_write_packet(sock: int, seq: int, payload)
    let hdr = _my_p3(bytes_len(payload))
    hdr = bytes_append(hdr, seq & 255)
    tcp_send_bytes(sock, bytes_concat(hdr, payload))

// ---- auth (mysql_native_password) -------------------------------------------------------------------
// token = SHA1(pw) XOR SHA1( scramble(20) ++ SHA1(SHA1(pw)) ). Empty password -> empty token.
fn _my_native_pw(password: string, scramble) -> any
    if len(password) == 0
        return bytes(0)
    let pw = str_to_blist(password)
    let h1 = sha1_bytes(pw)
    let h2 = sha1_bytes(h1)
    let cat = []
    let i = 0
    while i < len(scramble)
        push(cat, scramble[i])
        i = i + 1
    i = 0
    while i < len(h2)
        push(cat, h2[i])
        i = i + 1
    let h3 = sha1_bytes(cat)
    let out = bytes(0)
    i = 0
    while i < 20
        out = bytes_append(out, (h1[i] ^ h3[i]) & 255)
        i = i + 1
    out

// ---- connect ----------------------------------------------------------------------------------------
// mysql_connect -> ok(["my", sock]) authenticated + ready for queries, or err. Supports
// mysql_native_password (MySQL 5.7 default; 8.0 accounts created WITH mysql_native_password).
fn mysql_connect(host: string, port: int, user: string, db: string, password: string) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("mysql: cannot connect to " + host + ":" + str(port))
    let pkt = _my_read_packet(sock, bytes(0))
    if pkt[0] == 0 - 1
        tcp_close(sock)
        return err("mysql: no handshake packet")
    let payload = pkt[1]
    if bytes_get(payload, 0) != 10
        tcp_close(sock)
        return err("mysql: unsupported protocol version")
    let svr = _my_cstr(payload, 1)
    let off = svr[1]
    off = off + 4
    let scr1off = off
    off = off + 8 + 1
    off = off + 2 + 1 + 2 + 2
    let adl = bytes_get(payload, off)
    off = off + 1 + 10
    let part2 = adl - 8
    if part2 < 13
        part2 = 13
    let scr2off = off
    let scramble = []
    let si = 0
    while si < 8
        push(scramble, bytes_get(payload, scr1off + si))
        si = si + 1
    si = 0
    while si < 12
        push(scramble, bytes_get(payload, scr2off + si))
        si = si + 1
    let token = _my_native_pw(password, scramble)
    // HandshakeResponse41
    let flags = 512 | 32768 | 524288 | 1
    if len(db) > 0
        flags = flags | 8
    let resp = _my_p4(flags)
    resp = bytes_concat(resp, _my_p4(16777215))
    resp = bytes_append(resp, 33)
    let z = 0
    while z < 23
        resp = bytes_append(resp, 0)
        z = z + 1
    resp = bytes_concat(resp, str_to_bytes(user))
    resp = bytes_append(resp, 0)
    resp = bytes_append(resp, bytes_len(token))
    resp = bytes_concat(resp, token)
    if len(db) > 0
        resp = bytes_concat(resp, str_to_bytes(db))
        resp = bytes_append(resp, 0)
    resp = bytes_concat(resp, str_to_bytes("mysql_native_password"))
    resp = bytes_append(resp, 0)
    _my_write_packet(sock, 1, resp)
    let r2 = _my_read_packet(sock, pkt[2])
    if r2[0] == 0 - 1
        tcp_close(sock)
        return err("mysql: connection closed during auth")
    let rp = r2[1]
    let first = bytes_get(rp, 0)
    if first == 255
        let errcode = _my_u(rp, 1, 2)
        let msg = bytes_to_str(bytes_slice(rp, 9, bytes_len(rp)))
        tcp_close(sock)
        return err("mysql: " + str(errcode) + " " + msg)
    if first == 254
        tcp_close(sock)
        return err("mysql: server requested auth-switch (account is not mysql_native_password)")
    ok(["my", sock])

fn mysql_close(conn)
    tcp_close(conn[1])

// ---- query ------------------------------------------------------------------------------------------
// Run SQL (COM_QUERY). Returns ok(list of name-keyed string row dicts) for a SELECT, ok([]) for a
// statement with no result set (INSERT/UPDATE/DDL), or err(message).
fn mysql_query(conn, sql: string) -> any
    let sock = conn[1]
    let q = bytes(0)
    q = bytes_append(q, 3)
    q = bytes_concat(q, str_to_bytes(sql))
    _my_write_packet(sock, 0, q)
    let buf = bytes(0)
    let p1 = _my_read_packet(sock, buf)
    if p1[0] == 0 - 1
        return err("mysql: connection closed during query")
    buf = p1[2]
    let head = p1[1]
    let fb = bytes_get(head, 0)
    if fb == 255
        let errcode = _my_u(head, 1, 2)
        return err("mysql: " + str(errcode) + " " + bytes_to_str(bytes_slice(head, 9, bytes_len(head))))
    if fb == 0
        return ok([])
    let ccr = _my_lenenc_int(head, 0)
    let ncols = ccr[0]
    let colnames = []
    let ci = 0
    while ci < ncols
        let cp = _my_read_packet(sock, buf)
        buf = cp[2]
        let cdef = cp[1]
        let o = 0
        let s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        o = s[1]
        s = _my_lenenc_str(cdef, o)
        push(colnames, s[0])
        ci = ci + 1
    let ep = _my_read_packet(sock, buf)
    buf = ep[2]
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(sock, buf)
        if rp[0] == 0 - 1
            done = 1
        else
            buf = rp[2]
            let row = rp[1]
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let d = {}
                let o = 0
                let k = 0
                while k < ncols
                    if bytes_get(row, o) == 251
                        d[colnames[k]] = ""
                        o = o + 1
                    else
                        let sv = _my_lenenc_str(row, o)
                        d[colnames[k]] = sv[0]
                        o = sv[1]
                    k = k + 1
                push(rows, d)
    ok(rows)
