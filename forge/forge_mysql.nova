// forge_mysql -- pure-NOVA MySQL driver over raw TCP (no libmysqlclient), mirroring forge_pg. Speaks the
// classic MySQL protocol: LE packet framing (3-byte length + 1-byte seq), HandshakeV10, the
// mysql_native_password auth (SHA-1), COM_QUERY, and length-encoded result-set parsing. Rows come back as
// name-keyed string dicts -- so forge_orm's typed mapping (orm_all<T>/orm_one<T>) works unchanged.
// Auth token = SHA1(pw) XOR SHA1(scramble ++ SHA1(SHA1(pw))); values are always parameterized upstream.
// Also provides: a channel-based connection POOL + transactions (mysql_pool_open/mysql_with_tx, parallel
// to forge_db's pool_*/with_tx and forge_pg's pg_pool_open/pg_with_tx), and optional TLS (mysql_connect_tls,
// parallel to forge_pg's pg_connect/pg_connect_tls split, via MySQL's mid-handshake SSLRequest switch).
import forge_crypto
// forge_pg (not just for its own sake -- see the extern-dedup note by the TLS externs below).
import forge_pg
// str_pad_left(s, width, "0") -- read before delegating: it no-ops when len(s) >= width, exactly like the
// hand-rolled zero-padders it replaces below.
import std/core/str

// ---- little-endian helpers --------------------------------------------------------------------------
// n little-endian bytes of `v` as a plain int list -- the ONE place the LE byte order is written.
// _my_p3/_my_p4 were the same three/four lines at two widths; they are now this at w=3 / w=4.
fn _my_le_list(v: int, w: int) -> list
    [(v >> (i * 8)) & 255 for i in 0..w]

// Read an n-byte little-endian unsigned integer. Folded most-significant byte first so the fold is the
// same wrapping i64 arithmetic the byte*256^i sum was (verified bit-exact incl. the 8-byte/float cases).
fn _my_u(b, off: int, n: int) -> int
    reduce([bytes_get(b, off + n - 1 - i) for i in 0..n], (acc, v) => (acc << 8) | v, 0)

fn _my_p3(n: int) -> any
    bytes_from_list(_my_le_list(n, 3))

fn _my_p4(n: int) -> any
    bytes_from_list(_my_le_list(n, 4))

fn _my_cstr(b, off: int) -> any
    let endp = off
    while endp < bytes_len(b) and bytes_get(b, endp) != 0
        endp += 1
    [bytes_to_str(bytes_slice(b, off, endp)), endp + 1]

// length-encoded integer -> [value, next_off].
fn _my_lenenc_int(b, off: int) -> any
    let f = bytes_get(b, off)
    if f < 251
        return [f, off + 1]
    if f == 252
        return [_my_u(b, off + 1, 2), off + 3]
    if f == 253
        return [_my_u(b, off + 1, 3), off + 4]
    if f == 254
        return [_my_u(b, off + 1, 8), off + 9]
    [0, off + 1]

// length-encoded string -> [string, next_off]. 0xfb (251) = SQL NULL -> "".
fn _my_lenenc_str(b, off: int) -> any
    if bytes_get(b, off) == 251
        return ["", off + 1]
    let li = _my_lenenc_int(b, off)
    let n = li[0]
    let start = li[1]
    [bytes_to_str(bytes_slice(b, start, start + n)), start + n]

// length-encoded INTEGER writer (for COM_STMT_EXECUTE param values/lengths).
fn _my_wr_lenenc(n: int) -> any
    if n < 251
        return bytes_from_list([n])
    if n < 65536
        return bytes_from_list([252, ..._my_le_list(n, 2)])
    bytes_from_list([253, ..._my_le_list(n, 3)])

// length-encoded STRING writer (lenenc length + raw bytes).
fn _my_wr_lenstr(sb) -> any
    bytes_concat(_my_wr_lenenc(bytes_len(sb)), sb)

// ---- packet IO --------------------------------------------------------------------------------------
// Transport-agnostic send/recv/close. `conn` = [is_tls (0/1), handle]: handle is a raw tcp_connect() fd
// when is_tls==0, or the opaque handle nova_rt_tls_upgrade() returned when is_tls==1. Every packet read
// and write in this file flows through _my_read_packet/_my_write_packet -> these three helpers, so
// mysql_connect_tls can switch a connection from plaintext to TLS mid-handshake (see _my_connect_impl's
// use_tls block) and every later query on that same conn stays transparently encrypted. Mirrors forge_pg's
// _pg_send/_pg_recv_chunk/_pg_close_transport (conn = [kind, handle]) exactly.
// NOT re-declared as `extern fn` here (unlike forge_pg.nova, which does declare them): the compiler
// emits a `define @nova_ffi_<name>` FFI wrapper for every FILE containing its own `extern fn` of a
// given name, with no cross-file dedup -- so two files each independently declaring the identical
// extern (forge_pg.nova already does) collide at link time the moment a program imports both (as
// forge_orm.nova, which imports forge_pg + forge_mysql, does). `import forge_pg` above makes its
// already-declared nova_rt_tls_upgrade/nova_rt_tls_send_bytes/nova_rt_tls_recv_bytes symbols
// directly callable here (NOVA function symbols are global across imports) with no redeclaration.
// (tls_close is already a compiler builtin -- used directly below, NOT re-declared as extern.)

fn _my_send(conn, data)
    if conn[0] == 1
        unsafe nova_rt_tls_send_bytes(conn[1], data)
    else
        tcp_send_bytes(conn[1], data)

fn _my_recv_chunk(conn) -> any
    if conn[0] == 1
        return unsafe nova_rt_tls_recv_bytes(conn[1])
    tcp_recv_bytes(conn[1])

fn _my_close_transport(conn)
    if conn[0] == 1
        tls_close(conn[1])
    else
        tcp_close(conn[1])

fn _my_recv_at_least(conn, buf, need: int) -> any
    while bytes_len(buf) < need
        let chunk = _my_recv_chunk(conn)
        if bytes_len(chunk) == 0
            return buf
        buf = bytes_concat(buf, chunk)
    buf

// Read one whole packet -> [seq, payload, leftover]. seq -1 = EOF/short read.
fn _my_read_packet(conn, buf) -> any
    buf = _my_recv_at_least(conn, buf, 4)
    if bytes_len(buf) < 4
        return [-1, bytes(0), buf]
    let plen = _my_u(buf, 0, 3)
    let seq = bytes_get(buf, 3)
    let total = 4 + plen
    buf = _my_recv_at_least(conn, buf, total)
    if bytes_len(buf) < total
        return [-1, bytes(0), buf]
    [seq, bytes_slice(buf, 4, total), bytes_slice(buf, total, bytes_len(buf))]

fn _my_write_packet(conn, seq: int, payload)
    let hdr = bytes_from_list([..._my_le_list(bytes_len(payload), 3), seq & 255])
    _my_send(conn, bytes_concat(hdr, payload))

// ---- auth (mysql_native_password / caching_sha2_password) -------------------------------------------
// Both MySQL challenge-response plugins are the SAME shape -- h1 = H(pw); h3 = H(salted H(h1)); token =
// h1 XOR h3, len(h1) bytes -- differing only in the hash and in which side of the concat the scramble
// sits on. One helper, the hash passed as a closure, `h2_first` picking the concat order. The XOR width
// is len(h1), which is exactly the 20 (SHA-1) / 32 (SHA-256) the two open-coded versions used.
fn _my_xor_auth_token(password: string, scramble, hashfn, h2_first: int) -> any
    if len(password) == 0
        return bytes(0)
    let h1 = hashfn(str_to_blist(password))
    let h2 = hashfn(h1)
    let cat = [...h2, ...scramble] if h2_first == 1 else [...scramble, ...h2]
    let h3 = hashfn(cat)
    bytes_from_list([(h1[i] ^ h3[i]) & 255 for i in 0..len(h1)])

// token = SHA1(pw) XOR SHA1( scramble(20) ++ SHA1(SHA1(pw)) ). Empty password -> empty token.
fn _my_native_pw(password: string, scramble) -> any
    _my_xor_auth_token(password, scramble, (m) => sha1_bytes(m), 0)

// caching_sha2_password fast-path token = SHA256(pw) XOR SHA256( SHA256(SHA256(pw)) ++ scramble(20) ), 32 bytes.
fn _my_caching_sha2_pw(password: string, scramble) -> any
    _my_xor_auth_token(password, scramble, (m) => sha256_bytes(m), 1)

// PRIVATE: format a MySQL ERR packet (byte0 = 0xff) -> "mysql: <code> <message>". Layout: 0xff,
// error_code(2 LE), then a 6-byte SQL-state marker+state, then the human-readable message. This exact
// three-line shape appeared at five call sites (connect, fast-auth, query, prepare, execute).
fn _my_err_msg(p) -> string
    let code = _my_u(p, 1, 2)
    let msg = bytes_to_str(bytes_slice(p, 9, bytes_len(p)))
    "mysql: {code} {msg}"

// PRIVATE: skip n consecutive length-encoded strings starting at `off` -> [nth string, next off].
// A column-definition packet is a run of these, and both readers below walk it the same way.
fn _my_lenenc_str_n(b, off: int, n: int) -> any
    let o = off
    let s = ["", off]
    for i in 0..n
        s = _my_lenenc_str(b, o)
        o = s[1]
    s

// ---- connect ----------------------------------------------------------------------------------------
// PRIVATE: the HandshakeResponse41 header shared by both the abbreviated SSLRequest and the full
// response: capability flags(4) + max-packet-size(4) + charset(1) + 23 reserved zero bytes.
fn _my_handshake_header(flags: int) -> any
    bytes_from_list([..._my_le_list(flags, 4), ..._my_le_list(16777215, 4), 33, ...[0 for zi in 0..23]])

// PRIVATE: shared by mysql_connect (use_tls=0) and mysql_connect_tls (use_tls=1) -- ok(conn) authenticated
// + ready for queries, or err. conn = [is_tls, handle] (is_tls 0 = plaintext, handle = tcp fd; is_tls 1 =
// TLS, handle = the nova_rt_tls_upgrade() handle) -- opaque to every other function here, which only ever
// forwards it into _my_read_packet/_my_write_packet/_my_close_transport. Supports mysql_native_password
// (MySQL 5.7 default; 8.0 accounts created WITH mysql_native_password) and caching_sha2_password's fast
// path. use_tls=1 encrypts the connection (verify=1: cert chain + hostname checked, matching the other
// secure-by-default callers of nova_rt_tls_upgrade) via MySQL's mid-handshake SSLRequest switch below.
// (A default param on ONE public mysql_connect would be simpler, but a default parameter is not filled in
// at a cross-module call site -- verified by compiling forge_orm_test.nova, which calls
// forge_mysql.mysql_connect with 5 args and failed arity-checking against a 6-param signature. Two
// distinctly-named public entry points below sidestep that gap entirely and mirror forge_pg's actual
// pg_connect/pg_connect_tls split.)
fn _my_connect_impl(host: string, port: int, user: string, db: string, password: string, use_tls: int) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("mysql: cannot connect to {host}:{port}")
    let conn = [0, sock]
    let pkt = _my_read_packet(conn, bytes(0))
    if pkt[0] == -1
        _my_close_transport(conn)
        return err("mysql: no handshake packet")
    let payload = pkt[1]
    if bytes_get(payload, 0) != 10
        _my_close_transport(conn)
        return err("mysql: unsupported protocol version")
    let svr = _my_cstr(payload, 1)
    let off = svr[1]
    off += 4
    let scr1off = off
    off += 8 + 1
    off += 2 + 1 + 2 + 2
    let adl = bytes_get(payload, off)
    off += 1 + 10
    let part2 = adl - 8
    if part2 < 13
        part2 = 13
    let scr2off = off
    let scramble = [...[bytes_get(payload, scr1off + si) for si in 0..8], ...[bytes_get(payload, scr2off + si) for si in 0..12]]
    let plugin_res = _my_cstr(payload, scr2off + part2)
    let srv_plugin = plugin_res[0]
    let token = bytes(0)
    let resp_plugin = "mysql_native_password"
    if srv_plugin == "caching_sha2_password"
        token = _my_caching_sha2_pw(password, scramble)
        resp_plugin = "caching_sha2_password"
    else
        token = _my_native_pw(password, scramble)
    // HandshakeResponse41
    let flags = 512 | 32768 | 524288 | 1
    if len(db) > 0
        flags = flags | 8
    let resp_seq = 1
    if use_tls == 1
        // MySQL's SSL switch happens MID-handshake (unlike Postgres's pre-startup SSLRequest): send the
        // abbreviated SSLRequest -- capability flags with CLIENT_SSL set, no username/password -- at
        // sequence 1, upgrade the raw socket to TLS, then send the FULL HandshakeResponse41 (built below,
        // with the credentials) at sequence 2 over the now-encrypted transport. Every read/write on
        // `conn` from here on is transparently encrypted (_my_read_packet/_my_write_packet dispatch on
        // conn[0]).
        flags = flags | 2048
        _my_write_packet(conn, 1, _my_handshake_header(flags))
        let tls = unsafe nova_rt_tls_upgrade(sock, host, 1)
        if tls == 0
            tcp_close(sock)
            return err("mysql: TLS handshake/verification failed")
        conn = [1, tls]
        resp_seq = 2
    let resp = _my_handshake_header(flags)
    resp = bytes_concat(resp, str_to_bytes(user))
    resp = bytes_append(resp, 0)
    resp = bytes_append(resp, bytes_len(token))
    resp = bytes_concat(resp, token)
    if len(db) > 0
        resp = bytes_concat(resp, str_to_bytes(db))
        resp = bytes_append(resp, 0)
    resp = bytes_concat(resp, str_to_bytes(resp_plugin))
    resp = bytes_append(resp, 0)
    _my_write_packet(conn, resp_seq, resp)
    let r2 = _my_read_packet(conn, pkt[2])
    if r2[0] == -1
        _my_close_transport(conn)
        return err("mysql: connection closed during auth")
    let rp = r2[1]
    let first = bytes_get(rp, 0)
    if first == 255
        let emsg = _my_err_msg(rp)
        _my_close_transport(conn)
        return err(emsg)
    if first == 1
        let status = bytes_get(rp, 1)
        if status == 3
            let r3 = _my_read_packet(conn, r2[2])
            if r3[0] == -1
                _my_close_transport(conn)
                return err("mysql: connection closed after caching_sha2 fast-auth")
            if bytes_get(r3[1], 0) == 255
                let e3 = _my_err_msg(r3[1])
                _my_close_transport(conn)
                return err(e3)
            return ok(conn)
        _my_close_transport(conn)
        return err("mysql: caching_sha2 full authentication required (cold cache) -- needs TLS or RSA, not yet supported; prime the cache or use mysql_native_password")
    if first == 254
        _my_close_transport(conn)
        return err("mysql: server requested an auth-switch (unsupported plugin)")
    ok(conn)

// Plaintext connect (the common case) -> ok(conn) or err.
fn mysql_connect(host: string, port: int, user: string, db: string, password: string) -> any
    _my_connect_impl(host, port, user, db, password, 0)

// TLS connect: encrypts the connection via MySQL's mid-handshake SSLRequest switch (see
// _my_connect_impl's use_tls block above for the wire-level detail); verify is always on, matching the
// other secure-by-default nova_rt_tls_upgrade callers (forge_pg's pg_connect_tls, forge_http_client) ->
// ok(conn) or err.
fn mysql_connect_tls(host: string, port: int, user: string, db: string, password: string) -> any
    _my_connect_impl(host, port, user, db, password, 1)

fn mysql_close(conn)
    _my_close_transport(conn)

// ---- query ------------------------------------------------------------------------------------------
// Run SQL (COM_QUERY). Returns ok(list of name-keyed string row dicts) for a SELECT, ok([]) for a
// statement with no result set (INSERT/UPDATE/DDL), or err(message).
// affected_rows from an OK packet. Layout: byte0 = 0x00 (OK marker), then affected_rows as a
// length-encoded int, then last_insert_id (lenenc), status_flags (2), warnings (2). Caller must have
// verified byte0 == 0x00 (an OK packet, not a result set or ERR).
fn mysql_ok_affected(pkt) -> int
    (_my_lenenc_int(pkt, 1))[0]

fn mysql_query(conn, sql: string) -> any
    let q = bytes_concat(bytes_from_list([3]), str_to_bytes(sql))
    _my_write_packet(conn, 0, q)
    let buf = bytes(0)
    let p1 = _my_read_packet(conn, buf)
    if p1[0] == -1
        return err("mysql: connection closed during query")
    buf = p1[2]
    let head = p1[1]
    let fb = bytes_get(head, 0)
    if fb == 255
        return err(_my_err_msg(head))
    if fb == 0
        // OK packet (INSERT/UPDATE/DELETE/DDL): byte0=0x00, then affected_rows as a lenenc-int.
        // SELECT returns a result set (fb = column count) and takes the row-reading path below, so
        // orm_all is unaffected; only exec-style statements reach here.
        return ok(mysql_ok_affected(head))
    let ccr = _my_lenenc_int(head, 0)
    let ncols = ccr[0]
    // one column-definition packet per column; the 5th length-encoded string is the column NAME
    let colnames = []
    for ci in 0..ncols
        let cp = _my_read_packet(conn, buf)
        buf = cp[2]
        push(colnames, (_my_lenenc_str_n(cp[1], 0, 5))[0])
    let ep = _my_read_packet(conn, buf)
    buf = ep[2]
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(conn, buf)
        if rp[0] == -1
            done = 1
        else
            buf = rp[2]
            let row = rp[1]
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let d = {}
                let o = 0
                for k in 0..ncols
                    if bytes_get(row, o) == 251
                        d[colnames[k]] = ""
                        o += 1
                    else
                        let sv = _my_lenenc_str(row, o)
                        d[colnames[k]] = sv[0]
                        o = sv[1]
                push(rows, d)
    ok(rows)

// ---- prepared statements (binary protocol) ----------------------------------------------------------
// PRIVATE: left-pad an int to at least 2 / exactly 6 digits (temporal formatting).
fn _my_z2(n: int) -> string
    str_pad_left(str(n), 2, "0")

fn _my_z6(n: int) -> string
    str_pad_left(str(n), 6, "0")

// Decode ONE binary-protocol value at `off` for column type `t` -> [string, next_off]. Integers ->
// decimal string; string/decimal/blob/json -> lenenc string; DATE/DATETIME/TIMESTAMP/TIME decode to
// ISO strings; FLOAT/DOUBLE decode via the float_from_bits/f32_from_bits reinterpret builtins.
// _my_u is unsigned (fine for ids/counts).
fn _my_bin_val(b, off: int, t: int) -> any
    if t == 1
        return [str(_my_u(b, off, 1)), off + 1]
    if t == 2 or t == 13
        return [str(_my_u(b, off, 2)), off + 2]
    if t == 3 or t == 9
        return [str(_my_u(b, off, 4)), off + 4]
    if t == 8
        return [str(_my_u(b, off, 8)), off + 8]
    if t == 4
        // FLOAT: 4-byte little-endian IEEE-754 single -> widen to double via f32_from_bits.
        return [str(f32_from_bits(_my_u(b, off, 4))), off + 4]
    if t == 5
        // DOUBLE: 8-byte little-endian IEEE-754 double. _my_u wraps to the exact 64-bit pattern;
        // float_from_bits reinterprets those bits as a NOVA float.
        return [str(float_from_bits(_my_u(b, off, 8))), off + 8]
    // binary DATE(10)/DATETIME(12)/TIMESTAMP(7): a length byte then that many payload bytes (0/4/7/11).
    // 4 = date only; 7 = + time; 11 = + microseconds. year is 2-byte LE, the rest single bytes.
    if t == 10 or t == 12 or t == 7
        let dlen = _my_u(b, off, 1)
        let dp = off + 1
        // DATETIME(12)/TIMESTAMP(7) carry a time component even at midnight: MySQL omits an all-zero time
        // (sends dlen 4 or 0), but the canonical value is still "... 00:00:00". DATE(10) is date-only.
        let has_time = t == 12 or t == 7
        if dlen == 0
            if has_time
                return ["0000-00-00 00:00:00", dp]
            return ["0000-00-00", dp]
        let yr = _my_u(b, dp, 2)
        let mo = _my_u(b, dp + 2, 1)
        let dy = _my_u(b, dp + 3, 1)
        let dstr = "{yr}-{_my_z2(mo)}-{_my_z2(dy)}"
        if dlen == 4
            if has_time
                return ["{dstr} 00:00:00", dp + 4]
            return [dstr, dp + 4]
        let hh = _my_u(b, dp + 4, 1)
        let mi = _my_u(b, dp + 5, 1)
        let se = _my_u(b, dp + 6, 1)
        let tstr = "{dstr} {_my_z2(hh)}:{_my_z2(mi)}:{_my_z2(se)}"
        if dlen == 7
            return [tstr, dp + 7]
        let dus = _my_u(b, dp + 7, 4)
        return ["{tstr}.{_my_z6(dus)}", dp + 11]
    // binary TIME(11): length byte then sign(1) days(4 LE) hour(1) min(1) sec(1) [micros(4 LE)] (0/8/12).
    // MySQL TIME can exceed 24h (up to 838:59:59), so total hours = days*24 + hour (may be >2 digits).
    if t == 11
        let tlen = _my_u(b, off, 1)
        let tp = off + 1
        if tlen == 0
            return ["00:00:00", tp]
        let neg = _my_u(b, tp, 1)
        let days = _my_u(b, tp + 1, 4)
        let th = _my_u(b, tp + 5, 1)
        let tmi = _my_u(b, tp + 6, 1)
        let tse = _my_u(b, tp + 7, 1)
        let sign = "-" if neg == 1 else ""
        let base = "{sign}{_my_z2(days * 24 + th)}:{_my_z2(tmi)}:{_my_z2(tse)}"
        if tlen == 8
            return [base, tp + 8]
        let tus = _my_u(b, tp + 8, 4)
        return ["{base}.{_my_z6(tus)}", tp + 12]
    let sres = _my_lenenc_str(b, off)
    [sres[0], sres[1]]

// Public seam over _my_bin_val for offline testing: decode one binary-protocol value -> [str, next_off].
fn mysql_bin_val(b, off: int, t: int) -> any
    _my_bin_val(b, off, t)

// Read num_def column-definition packets -> [names, types, leftover_buf], then consume the trailing EOF.
fn _my_read_coldefs(conn, buf, n: int) -> any
    let names = []
    let types = []
    for ci in 0..n
        let cp = _my_read_packet(conn, buf)
        buf = cp[2]
        let cdef = cp[1]
        // catalog, schema, table, org_table, NAME -- the 5th length-encoded string is the column name
        let st = _my_lenenc_str_n(cdef, 0, 5)
        push(names, st[0])
        // then org_name; the column TYPE byte sits past charset(2) + column_length(4) after it
        let o = (_my_lenenc_str(cdef, st[1]))[1]
        push(types, bytes_get(cdef, o + 1 + 2 + 4))
    if n > 0
        let e = _my_read_packet(conn, buf)
        buf = e[2]
    [names, types, buf]

// PRIVATE: COM_STMT_CLOSE (opcode 25) -- opcode byte + the 4-byte statement id, same packet-framing
// style as COM_STMT_PREPARE/EXECUTE above. The server sends NO response to this command (see
// https://dev.mysql.com/doc/dev/mysql-server/latest/page_protocol_com_stmt_close.html), so callers must
// only SEND it, never follow with a _my_read_packet -- doing so would block waiting for a reply that
// never comes and desync every read after it.
fn _my_stmt_close(conn, stmt_id: int)
    _my_write_packet(conn, 0, bytes_from_list([25, ..._my_le_list(stmt_id, 4)]))

// Parameterized query via a PREPARED STATEMENT (COM_STMT_PREPARE + COM_STMT_EXECUTE, binary protocol).
// Every param is bound as MYSQL_TYPE_VAR_STRING and the server coerces it to the column type -> NO string
// inlining/escaping, injection-safe, and numeric-correct. Returns ok(name-keyed string row dicts) /
// ok([]) for a no-result-set statement / err.
fn mysql_query_params(conn, sql: string, params) -> any
    let pq = bytes_concat(bytes_from_list([22]), str_to_bytes(sql))
    _my_write_packet(conn, 0, pq)
    let buf = bytes(0)
    let pr = _my_read_packet(conn, buf)
    if pr[0] == -1
        return err("mysql: connection closed during prepare")
    buf = pr[2]
    let pp = pr[1]
    if bytes_get(pp, 0) == 255
        return err(_my_err_msg(pp))
    let stmt_id = _my_u(pp, 1, 4)
    // The statement is now live server-side -- close it on EVERY path below (row-set, OK-packet, or an
    // execute error) via defer, so a parameterized query never leaks a server-side prepared-statement
    // handle for the life of the connection.
    defer _my_stmt_close(conn, stmt_id)
    let num_cols = _my_u(pp, 5, 2)
    let num_params = _my_u(pp, 7, 2)
    let pd = _my_read_coldefs(conn, buf, num_params)
    buf = pd[2]
    let cd = _my_read_coldefs(conn, buf, num_cols)
    buf = cd[2]
    // COM_STMT_EXECUTE(23) || stmt_id(4 LE) || flags(0) || iteration_count(1)
    let ex = bytes_from_list([23, ..._my_le_list(stmt_id, 4), 0, ..._my_le_list(1, 4)])
    let np = len(params)
    if np > 0
        // null bitmap (all-zero: no NULLs) || new_params_bound=1 || (type, unsigned-flag) per param,
        // every param bound as MYSQL_TYPE_VAR_STRING (253) with the unsigned flag clear.
        let nbm = (np + 7) / 8
        ex = bytes_concat(ex, bytes_from_list([...[0 for bi in 0..nbm], 1, ...[253 if ti % 2 == 0 else 0 for ti in 0..(np * 2)]]))
        for pv in params
            ex = bytes_concat(ex, _my_wr_lenstr(str_to_bytes(str(pv))))
    _my_write_packet(conn, 0, ex)
    let xr = _my_read_packet(conn, buf)
    if xr[0] == -1
        return err("mysql: connection closed during execute")
    buf = xr[2]
    let xp = xr[1]
    let xf = bytes_get(xp, 0)
    if xf == 255
        return err(_my_err_msg(xp))
    if xf == 0
        // OK packet: affected_rows is a lenenc-int right after the 0x00 marker (same as text protocol).
        return ok(mysql_ok_affected(xp))
    let rcc = _my_lenenc_int(xp, 0)
    let rncols = rcc[0]
    let rc = _my_read_coldefs(conn, buf, rncols)
    let rnames = rc[0]
    let rtypes = rc[1]
    buf = rc[2]
    let rows = []
    let done = 0
    while done == 0
        let rp = _my_read_packet(conn, buf)
        if rp[0] == -1
            done = 1
        else
            buf = rp[2]
            let row = rp[1]
            let rfb = bytes_get(row, 0)
            if rfb == 254 and bytes_len(row) < 9
                done = 1
            else if rfb == 255
                done = 1
            else
                let nbmlen = (rncols + 7 + 2) / 8
                let o = 1 + nbmlen
                let d = {}
                for k in 0..rncols
                    let bytei = 1 + ((k + 2) / 8)
                    let biti = (k + 2) % 8
                    if ((bytes_get(row, bytei) >> biti) & 1) == 1
                        d[rnames[k]] = ""
                    else
                        let dec = _my_bin_val(row, o, rtypes[k])
                        d[rnames[k]] = dec[0]
                        o = dec[1]
                push(rows, d)
    ok(rows)

// ── connection POOL + transactions (parallel to forge_db's pool_*/with_tx and forge_pg's pg_pool_open/
// pg_with_tx) ──────────────────────────────────────────────────────────────────────────────────────────
// A pool is a channel of authenticated connections; acquire = recv (parks until one frees), release =
// send. Opens n plaintext connections and puts them on the channel; on ANY failure it cleanly closes
// those already opened and returns the err, so a bad host/credential never leaves live sockets behind.
// (Plaintext only, mirroring pg_pool_open exactly -- forge_pg has no TLS pool constructor either. A
// pooled-TLS variant would call mysql_connect_tls per-connection; deferred as a tracked follow-up rather
// than invented here without an established convention to mirror.)
fn mysql_pool_open(host: string, port: int, user: string, db: string, password: string, n: int) -> any
    let ch = channel()
    let opened = 0
    for i in 0..n
        let r = mysql_connect(host, port, user, db, password)
        // is_ok/unwrap (runtime Result-tag checks) -- matches pg_pool_open's convention (a `match`
        // Ok/Err on an any-typed connect result mis-resolves the constructor in a couple of these
        // driver modules; the runtime tag ops are unaffected).
        if is_ok(r)
            send(ch, unwrap(r))
            opened += 1
        else
            for j in 0..opened
                mysql_close(recv(ch))
            return r
    ok(ch)

fn mysql_pool_acquire(pool)
    recv(pool)

fn mysql_pool_release(pool, conn)
    send(pool, conn)

// Acquire -> query -> release. `defer` releases the connection on EVERY path, including an error return.
// mysql_query already returns ok(rows) for a SELECT or ok(affected_int) for an exec-style statement (OK
// packet), so this single pooled entry point covers both -- no separate pool_exec is needed.
fn mysql_pool_query(pool, sql: string) -> any
    let conn = recv(pool)
    defer send(pool, conn)
    mysql_query(conn, sql)

// Parameterized (injection-safe) pooled query: acquire -> mysql_query_params -> release (defer).
fn mysql_pool_query_params(pool, sql: string, params) -> any
    let conn = recv(pool)
    defer send(pool, conn)
    mysql_query_params(conn, sql, params)

// Run body_fn(conn) in a transaction on ONE pooled connection: START TRANSACTION (MySQL's spelling of
// BEGIN), then COMMIT if body returns ok(..) or ROLLBACK if it returns err(..). The connection is
// released back to the pool either way (defer, so an early error return still releases it). Returns the
// body's Result. NOTE: as with forge_db's with_tx, this rolls back on a returned ERROR; rolling back on a
// PANIC would need runtime panic-recovery, which NOVA doesn't have -- a transaction signals failure via
// err(), never a panic.
fn mysql_with_tx(pool, body_fn) -> any
    let conn = recv(pool)
    defer send(pool, conn)
    mysql_query(conn, "START TRANSACTION")
    let r = body_fn(conn)
    if is_ok(r)
        mysql_query(conn, "COMMIT")
    else
        mysql_query(conn, "ROLLBACK")
    r

// Close all n pooled connections (drain + close each).
fn mysql_pool_close(pool, n: int)
    for i in 0..n
        mysql_close(recv(pool))
