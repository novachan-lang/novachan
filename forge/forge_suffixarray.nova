// forge_suffixarray -- self-contained suffix array (see NOTE below).
//
// NOTE: std/collections/suffixarray is NOT imported here. sa_build(s) matches std's
// signature and algorithm, but sa_contains does NOT: this module's public API is
// sa_contains(sa, s, pattern) (index first) while std's is sa_contains(s, sa, pat)
// (string first) -- callers of this module (and the test suite) depend on the
// index-first order, so the two are API-incompatible despite sharing a name. Since
// NOVA does not mangle symbols per module, importing std would still collide at link
// time on the identically-named sa_build even where the signature does match. Keeping
// both functions self-contained avoids the collision without changing this module's
// public contract.

// _sab_cmp: compare suffix of s starting at i against suffix starting at j.
// Returns negative if suffix[i] < suffix[j], 0 if equal, positive if suffix[i] > suffix[j].
fn _sab_cmp(s: string, i: int, j: int) -> int
    let n = len(s)
    let li = n - i
    let lj = n - j
    let min_len = li
    if lj < min_len
        min_len = lj
    let k = 0
    while k < min_len
        let ci = ord(char_at(s, i + k))
        let cj = ord(char_at(s, j + k))
        if ci < cj
            return -1
        if ci > cj
            return 1
        k += 1
    if li < lj
        return -1
    if li > lj
        return 1
    0

// sa_build: construct the suffix array of s via insertion sort (O(n^2 log n) worst
// case -- correct and simple for the moderate strings this module targets).
fn sa_build(s: string) -> list
    let n = len(s)
    let sa = [i for i in 0..n]
    for j in 1..n
        let key = sa[j]
        let pos = j - 1
        let ins = j
        while pos >= 0 and _sab_cmp(s, sa[pos], key) > 0
            sa[pos + 1] = sa[pos]
            ins = pos
            pos -= 1
        sa[ins] = key
    sa

// _sac_cmp_prefix: compare suffix of s starting at idx against pattern pat.
// Returns -1 if suffix < pat prefix-wise, 0 if suffix starts with pat, 1 if suffix > pat.
fn _sac_cmp_prefix(s: string, idx: int, pat: string) -> int
    let sn = len(s)
    let pn = len(pat)
    let avail = sn - idx
    let min_len = pn
    if avail < min_len
        min_len = avail
    let k = 0
    while k < min_len
        let cs = ord(char_at(s, idx + k))
        let cp = ord(char_at(pat, k))
        if cs < cp
            return -1
        if cs > cp
            return 1
        k += 1
    if avail < pn
        return -1
    0

// sa_contains: true if pattern occurs anywhere in s, via binary search over sa.
fn sa_contains(sa: list, s: string, pattern: string) -> bool
    if len(pattern) == 0
        return true
    let lo = 0
    let hi = len(sa)
    while lo < hi
        let mid = (lo + hi) / 2
        if _sac_cmp_prefix(s, sa[mid], pattern) < 0
            lo = mid + 1
        else
            hi = mid
    if lo >= len(sa)
        return false
    _sac_cmp_prefix(s, sa[lo], pattern) == 0

fn sa_lcp(sa: list, s: string) -> list
    let n = len(s)
    let lcp = [0]
    for i in 1..len(sa)
        let a = sa[i - 1]
        let b = sa[i]
        let l = 0
        while a + l < n and b + l < n and char_at(s, a + l) == char_at(s, b + l)
            l += 1
        push(lcp, l)
    lcp

// The longest substring that appears at least twice in s (the max LCP value's substring); "" if none repeats.

fn sa_longest_repeated(s: string) -> string
    let sa = sa_build(s)
    let lcp = sa_lcp(sa, s)
    let best = 0
    let pos = 0
    for i in 0..len(lcp)
        if lcp[i] > best
            best = lcp[i]
            pos = sa[i]
    slice(s, pos, pos + best)

// The number of DISTINCT non-empty substrings of s (total substrings minus repeated prefixes via LCP).

fn sa_count_distinct(s: string) -> int
    let n = len(s)
    let sa = sa_build(s)
    let lcp = sa_lcp(sa, s)
    let total = n * (n + 1) / 2
    let sum = 0
    for i in 0..len(lcp)
        sum += lcp[i]
    total - sum

