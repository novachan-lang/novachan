// forge_suffixarray -- a suffix array: the sorted list of ALL suffixes of a string, which turns the string into a
// reusable full-text INDEX. Where KMP/Boyer-Moore (forge_kmp/forge_boyermoore) scan the text afresh for each
// single pattern, a suffix array is built ONCE and then answers "does pattern P occur?" for any P in O(|P| log n)
// by binary-searching the sorted suffixes -- the right tool when you query the same text many times (search
// engines, autocomplete, bioinformatics read mapping). Paired with the LCP array (longest common prefix of
// adjacent sorted suffixes) it also yields, in linear extra time, the LONGEST REPEATED substring and the exact
// COUNT of distinct substrings -- classic answers that are awkward any other way. Build here is the simple
// comparison sort (fine for moderate texts); the queries and LCP tricks are the real payoff. LEAF -- imports NOTHING.

// PRIVATE: is the suffix starting at i lexicographically less than the one at j?
fn _sa_less(s: string, i: int, j: int) -> bool
    let n = len(s)
    let a = i
    let b = j
    let out = false
    let decided = false
    while a < n and b < n and not decided
        let ca = ord(char_at(s, a))
        let cb = ord(char_at(s, b))
        if ca < cb
            out = true
            decided = true
        else if ca > cb
            decided = true
        a += 1
        b += 1
    if not decided
        // one suffix is a prefix of the other -> the shorter (ran out first) is smaller
        if a >= n and b < n
            out = true
    out

// The suffix array of s: starting indices of all suffixes, sorted lexicographically.
fn sa_build(s: string) -> list
    let n = len(s)
    let sa = [i for i in 0..n]
    // insertion sort the indices by suffix order (scalar int moves)
    for a in 1..n
        let key = sa[a]
        let b = a - 1
        while b >= 0 and _sa_less(s, key, sa[b])
            sa[b + 1] = sa[b]
            b -= 1
        sa[b + 1] = key
    sa

// PRIVATE: compare pattern against the suffix at `start`, only over the pattern's length. -1 pattern<suffix,
// 0 pattern is a prefix of the suffix, 1 pattern>suffix.
fn _sa_cmp(s: string, start: int, pattern: string) -> int
    let m = len(pattern)
    let n = len(s)
    for k in 0..m
        if start + k >= n
            return 1
        let cp = ord(char_at(pattern, k))
        let cs = ord(char_at(s, start + k))
        if cp < cs
            return -1
        if cp > cs
            return 1
    0

// True if pattern occurs anywhere in s, via binary search on the suffix array. Empty pattern -> true.
fn sa_contains(sa: list, s: string, pattern: string) -> bool
    let found = false
    if len(pattern) == 0
        found = true
    else
        let lo = 0
        let hi = len(sa) - 1
        while lo <= hi and not found
            let mid = (lo + hi) / 2
            let c = _sa_cmp(s, sa[mid], pattern)
            if c == 0
                found = true
            else if c < 0
                hi = mid - 1
            else
                lo = mid + 1
    found

// The LCP array: lcp[i] = length of the longest common prefix of the suffixes at sa[i-1] and sa[i] (lcp[0]=0).
fn sa_lcp(sa: list, s: string) -> list
    let n = len(s)
    let lcp = [0]
    for i in 1..len(sa)
        let a = sa[i - 1]
        let b = sa[i]
        let l = 0
        while a + l < n and b + l < n and char_at(s, a + l) == char_at(s, b + l)
            l += 1
        push(lcp, l)
    lcp

// The longest substring that appears at least twice in s (the max LCP value's substring); "" if none repeats.
fn sa_longest_repeated(s: string) -> string
    let sa = sa_build(s)
    let lcp = sa_lcp(sa, s)
    let best = 0
    let pos = 0
    for i in 0..len(lcp)
        if lcp[i] > best
            best = lcp[i]
            pos = sa[i]
    slice(s, pos, pos + best)

// The number of DISTINCT non-empty substrings of s (total substrings minus repeated prefixes via LCP).
fn sa_count_distinct(s: string) -> int
    let n = len(s)
    let sa = sa_build(s)
    let lcp = sa_lcp(sa, s)
    let total = n * (n + 1) / 2
    let sum = 0
    for i in 0..len(lcp)
        sum += lcp[i]
    total - sum
