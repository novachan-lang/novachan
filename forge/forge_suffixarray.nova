// forge_suffixarray -- thin wrapper over std/collections/suffixarray (canonical implementation).
import std/collections/suffixarray

fn sa_build(s: string) -> list
    return sa_build(s)

fn sa_contains(sa: list, s: string, pattern: string) -> bool
    return sa_contains(sa, s, pattern)

fn sa_lcp(sa: list, s: string) -> list
    let n = len(s)
    let lcp = [0]
    for i in 1..len(sa)
        let a = sa[i - 1]
        let b = sa[i]
        let l = 0
        while a + l < n and b + l < n and char_at(s, a + l) == char_at(s, b + l)
            l += 1
        push(lcp, l)
    lcp

// The longest substring that appears at least twice in s (the max LCP value's substring); "" if none repeats.

fn sa_longest_repeated(s: string) -> string
    let sa = sa_build(s)
    let lcp = sa_lcp(sa, s)
    let best = 0
    let pos = 0
    for i in 0..len(lcp)
        if lcp[i] > best
            best = lcp[i]
            pos = sa[i]
    slice(s, pos, pos + best)

// The number of DISTINCT non-empty substrings of s (total substrings minus repeated prefixes via LCP).

fn sa_count_distinct(s: string) -> int
    let n = len(s)
    let sa = sa_build(s)
    let lcp = sa_lcp(sa, s)
    let total = n * (n + 1) / 2
    let sum = 0
    for i in 0..len(lcp)
        sum += lcp[i]
    total - sum

