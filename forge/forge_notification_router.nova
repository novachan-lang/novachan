// forge_notification_router — multi-channel notification routing by severity.
//
// Channels are registered with a type (email/slack/webhook/sms — the type is stored
// as metadata only, this module does not perform delivery). Rules bind a severity
// level to a channel; routing a notification picks the FIRST rule (in the order it
// was added) whose severity matches and delivers to that rule's channel. This
// first-match-wins order lets callers register a specific override before a
// catch-all rule for the same severity.

fn nr_new() -> dict
    let s = {}
    s["channels"] = {}
    s["channel_count"] = 0
    s["rules"] = {}
    s["rule_count"] = 0
    s["sent"] = {}
    s["sent_count"] = 0
    s["last_message"] = ""
    s

fn nr_add_channel(state: dict, channel_name: string, channel_type: string) -> dict
    let has = contains(state["channels"], channel_name + "_type")
    if has != true
        state["channel_count"] = state["channel_count"] + 1
        state["channels"][channel_name + "_sent"] = 0
    state["channels"][channel_name + "_type"] = channel_type
    state

fn nr_add_rule(state: dict, rule_name: string, severity: string, channel_name: string) -> Result
    let has_chan = contains(state["channels"], channel_name + "_type")
    if has_chan != true
        return err("unknown channel: " + channel_name)
    let idx = state["rule_count"]
    let k = "rule_" + str(idx)
    state["rules"][k + "_name"] = rule_name
    state["rules"][k + "_severity"] = severity
    state["rules"][k + "_channel"] = channel_name
    state["rule_count"] = idx + 1
    ok(state)

fn nr_route(state: dict, severity: string, message: string) -> Result
    let n = state["rule_count"]
    let i = 0
    let target = ""
    while i < n
        let k = "rule_" + str(i)
        if state["rules"][k + "_severity"] == severity
            target = state["rules"][k + "_channel"]
            break
        i += 1
    if target == ""
        return err("no route for severity: " + severity)
    let sk = str(state["sent_count"])
    state["sent"][sk + "_channel"] = target
    state["sent"][sk + "_severity"] = severity
    state["sent"][sk + "_message"] = message
    state["sent_count"] = state["sent_count"] + 1
    state["channels"][target + "_sent"] = state["channels"][target + "_sent"] + 1
    state["last_message"] = message
    ok(target)

fn nr_sent_count(state: dict) -> int
    state["sent_count"]

fn nr_channel_count(state: dict) -> int
    state["channel_count"]

fn nr_rule_count(state: dict) -> int
    state["rule_count"]

fn nr_channel_sent(state: dict, channel_name: string) -> Result
    let has = contains(state["channels"], channel_name + "_type")
    if has != true
        return err("unknown channel: " + channel_name)
    ok(state["channels"][channel_name + "_sent"])

fn nr_has_channel(state: dict, channel_name: string) -> int
    let has = contains(state["channels"], channel_name + "_type")
    if has == true
        return 1
    0

fn nr_last_message(state: dict) -> Result
    if state["sent_count"] == 0
        return err("no messages routed yet")
    ok(state["last_message"])
