// forge_crdt_counter — Mesh CRDT G-Counter (grow-only counter).
// Each node increments its own slot; merge takes the max per node (idempotent, commutative, associative).

fn gc_new() -> dict
    let gc = {}
    gc["counts"] = {}
    gc

fn gc_increment(gc: dict, node_id: string, amount: int) -> dict
    let has = contains(gc["counts"], node_id)
    if has != true
        gc["counts"][node_id] = 0
    gc["counts"][node_id] = gc["counts"][node_id] + amount
    gc

fn gc_value(gc: dict) -> int
    let total = 0
    let nodes = keys(gc["counts"])
    for i in 0..len(nodes)
        total += gc["counts"][nodes[i]]
    total

fn gc_node_value(gc: dict, node_id: string) -> Result
    if contains(gc["counts"], node_id) != true
        return err("unknown node: " + node_id)
    ok(gc["counts"][node_id])

fn gc_merge(a: dict, b: dict) -> dict
    let result = {}
    result["counts"] = {}
    let a_nodes = keys(a["counts"])
    for i in 0..len(a_nodes)
        result["counts"][a_nodes[i]] = a["counts"][a_nodes[i]]
    let b_nodes = keys(b["counts"])
    for j in 0..len(b_nodes)
        let has = contains(result["counts"], b_nodes[j])
        if has != true
            result["counts"][b_nodes[j]] = b["counts"][b_nodes[j]]
        else
            if b["counts"][b_nodes[j]] > result["counts"][b_nodes[j]]
                result["counts"][b_nodes[j]] = b["counts"][b_nodes[j]]
    result

fn gc_node_count(gc: dict) -> int
    len(keys(gc["counts"]))

fn gc_node_list(gc: dict) -> string
    let nodes = keys(gc["counts"])
    let i = 0
    let result = ""
    while i < len(nodes)
        if result == ""
            result = nodes[i]
        else
            result += "," + nodes[i]
        i += 1
    result

fn gc_has_node(gc: dict, node_id: string) -> int
    if contains(gc["counts"], node_id) == true
        return 1
    0
