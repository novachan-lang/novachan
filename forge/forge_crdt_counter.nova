// forge_crdt_counter — CRDT G-Counter (grow-only counter).
// Each node increments its own counter, merge takes max per node.

fn gc_new() -> dict
    let gc = {}
    gc["counts"] = {}
    gc

fn gc_increment(gc: dict, node: string, amount: int) -> dict
    let has = contains(gc["counts"], node)
    if has != true
        gc["counts"][node] = 0
    gc["counts"][node] = gc["counts"][node] + amount
    gc

fn gc_value(gc: dict) -> int
    let total = 0
    let nodes = keys(gc["counts"])
    let i = 0
    while i < len(nodes)
        total = total + gc["counts"][nodes[i]]
        i = i + 1
    total

fn gc_node_value(gc: dict, node: string) -> int
    let has = contains(gc["counts"], node)
    if has != true
        return 0
    gc["counts"][node]

fn gc_merge(a: dict, b: dict) -> dict
    let result = {}
    result["counts"] = {}
    let a_nodes = keys(a["counts"])
    let i = 0
    while i < len(a_nodes)
        result["counts"][a_nodes[i]] = a["counts"][a_nodes[i]]
        i = i + 1
    let b_nodes = keys(b["counts"])
    let j = 0
    while j < len(b_nodes)
        let has = contains(result["counts"], b_nodes[j])
        if has != true
            result["counts"][b_nodes[j]] = b["counts"][b_nodes[j]]
        else
            if b["counts"][b_nodes[j]] > result["counts"][b_nodes[j]]
                result["counts"][b_nodes[j]] = b["counts"][b_nodes[j]]
        j = j + 1
    result

fn gc_node_count(gc: dict) -> int
    len(keys(gc["counts"]))
