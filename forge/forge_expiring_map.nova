// forge_expiring_map — key-value map with TTL expiry and Result API.

fn em_new() -> dict
    let m = {}
    m["data"] = {}
    m["expiry"] = {}
    m["count"] = 0
    m["expired"] = 0
    m

fn em_put(m: dict, key: string, value: string, ttl: int, now: int) -> dict
    let dk = "d_" + key
    let ek = "e_" + key
    let is_new = 0
    if contains(m["data"], dk) != true
        is_new = 1
    m["data"][dk] = value
    m["expiry"][ek] = now + ttl
    if is_new == 1
        m["count"] = m["count"] + 1
    m

fn em_get(m: dict, key: string, now: int) -> Result
    let dk = "d_" + key
    if contains(m["data"], dk) != true
        return err("key not found")
    let ek = "e_" + key
    if now > m["expiry"][ek]
        m["expired"] = m["expired"] + 1
        return err("expired")
    ok(m["data"][dk])

fn em_delete(m: dict, key: string) -> Result
    let dk = "d_" + key
    if contains(m["data"], dk) != true
        return err("key not found")
    m["data"][dk] = ""
    m["count"] = m["count"] - 1
    ok(m)

fn em_has(m: dict, key: string, now: int) -> int
    let dk = "d_" + key
    if contains(m["data"], dk) != true
        return 0
    let ek = "e_" + key
    if now > m["expiry"][ek]
        return 0
    1

fn em_count(m: dict) -> int
    m["count"]

fn em_expired_count(m: dict) -> int
    m["expired"]
