// forge_json_pretty -- pretty-print JSON with 2-space indentation (json_stringify emits compact single-line;
// this gives human-readable output for config files, API debugging, and log inspection). Parses with
// json_decode then re-emits. NOTE: NOVA booleans are ints (type_of(true)=="int"), so a decoded true/false
// renders as 1/0. LEAF -- imports NOTHING (json_decode is a builtin).

fn _jp_indent(n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + "  "
        i = i + 1
    out

fn _jp_esc(s: string) -> string
    let bs = chr(92)
    let q = chr(34)
    let out = ""
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        if c == bs
            out = out + bs + bs
        else
            if c == q
                out = out + bs + q
            else
                if c == chr(10)
                    out = out + bs + "n"
                else
                    out = out + c
        i = i + 1
    out

fn _jp_emit(v: any, depth: int) -> string
    let t = type_of(v)
    let ob = chr(123)
    let cb = chr(125)
    let q = chr(34)
    let nl = chr(10)
    if t == "dict"
        let ks = keys(v)
        if len(ks) == 0
            return ob + cb
        let out = ob + nl
        let i = 0
        while i < len(ks)
            out = out + _jp_indent(depth + 1) + q + _jp_esc(ks[i]) + q + ": " + _jp_emit(v[ks[i]], depth + 1)
            if i < len(ks) - 1
                out = out + ","
            out = out + nl
            i = i + 1
        return out + _jp_indent(depth) + cb
    if t == "list"
        if len(v) == 0
            return "[]"
        let out = "[" + nl
        let j = 0
        while j < len(v)
            out = out + _jp_indent(depth + 1) + _jp_emit(v[j], depth + 1)
            if j < len(v) - 1
                out = out + ","
            out = out + nl
            j = j + 1
        return out + _jp_indent(depth) + "]"
    if t == "string"
        return q + _jp_esc(v) + q
    str(v)

// Pretty-print a JSON string with 2-space indentation.
fn json_pretty(json_str: string) -> string
    _jp_emit(json_decode(json_str), 0)

// Pretty-print an already-decoded value (dict/list/scalar).
fn json_pretty_value(value: any) -> string
    _jp_emit(value, 0)
