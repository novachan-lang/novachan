// forge_dsuontree -- DSU on tree (a.k.a. "small-to-large merging" / Sack's technique): answer SUBTREE
// aggregate queries over a rooted tree in O(n log n) total, without the heavy machinery of HLD or a
// persistent structure. The classic problems it solves: for EVERY node, "how many DISTINCT colors are in
// its subtree?", "what is the most frequent color (mode) in its subtree?", "sum of the k most common", or
// any aggregate over the multiset of values in each subtree. The naive approach recomputes each subtree
// from scratch in O(n^2); DSU-on-tree gets O(n log n) by a beautiful trick: process children, KEEP the
// data structure of the "big" child (the one with the largest subtree) and only re-add the "small"
// children's contributions. Because every node is re-added only O(log n) times (each time it's in a small
// child, the containing subtree at least doubles), the total work is O(n log n).
//
// This module computes, for every node, the NUMBER OF DISTINCT VALUES (colors) in its subtree, and the
// count of the MOST FREQUENT value in its subtree -- the two canonical DSU-on-tree outputs. The core
// add/remove-over-Euler-order machinery is structured so other aggregates can reuse the same pattern.
//
// Tree: n nodes 0..n-1, parent array (parent[root] = -1), a per-node integer value ("color"), and a root.
//
// API:
//   dot_distinct_per_subtree(n, parent, root, color) -> list   answer[v] = #distinct colors in subtree(v)
//   dot_mode_count_per_subtree(n, parent, root, color) -> list answer[v] = count of the most frequent color
// LEAF (imports nothing).

fn _dot_children(n: int, parent: list) -> list
    let children = []
    let i = 0
    while i < n
        push(children, [])
        i = i + 1
    let v = 0
    while v < n
        if parent[v] >= 0
            push(children[parent[v]], v)
        v = v + 1
    return children

// Iterative subtree sizes + heavy child, and an Euler order (tin) so a subtree is a contiguous range.
// Returns [size, heavy, tin, euler] where euler[tin[v] .. tin[v]+size[v]-1] are the nodes of subtree(v).
fn _dot_prep(n: int, root: int, children: list) -> list
    let size = []
    let heavy = []
    let tin = []
    let i = 0
    while i < n
        push(size, 1)
        push(heavy, 0 - 1)
        push(tin, 0)
        i = i + 1
    // post-order for sizes/heavy
    let post = []
    let stack = [root]
    while len(stack) > 0
        let node = stack[len(stack) - 1]
        let ns = []
        let si = 0
        while si < len(stack) - 1
            push(ns, stack[si])
            si = si + 1
        stack = ns
        push(post, node)
        let ch = children[node]
        let ci = 0
        while ci < len(ch)
            push(stack, ch[ci])
            ci = ci + 1
    let idx = len(post) - 1
    while idx >= 0
        let node = post[idx]
        let ch = children[node]
        let maxsz = 0
        let hc = 0 - 1
        let ci = 0
        while ci < len(ch)
            let c = ch[ci]
            size[node] = size[node] + size[c]
            if size[c] > maxsz
                maxsz = size[c]
                hc = c
            ci = ci + 1
        heavy[node] = hc
        idx = idx - 1
    // Euler order (pre-order DFS) so subtree(v) = euler[tin[v] .. tin[v]+size[v]-1]
    let euler = []
    let timer_box = [0]
    let stack2 = [root]
    while len(stack2) > 0
        let node = stack2[len(stack2) - 1]
        let ns = []
        let si = 0
        while si < len(stack2) - 1
            push(ns, stack2[si])
            si = si + 1
        stack2 = ns
        tin[node] = timer_box[0]
        push(euler, node)
        timer_box[0] = timer_box[0] + 1
        // push children in reverse so pre-order is left-to-right
        let ch = children[node]
        let ci = len(ch) - 1
        while ci >= 0
            push(stack2, ch[ci])
            ci = ci - 1
    return [size, heavy, tin, euler]

// DSU-on-tree computing #distinct colors per subtree. Iterative (explicit work stack), small-to-large.
fn dot_distinct_per_subtree(n: int, parent: list, root: int, color: list) -> list
    let children = _dot_children(n, parent)
    let prep = _dot_prep(n, root, children)
    let size = prep[0]
    let heavy = prep[1]
    let tin = prep[2]
    let euler = prep[3]
    let answer = []
    let i = 0
    while i < n
        push(answer, 0)
        i = i + 1
    // Global frequency table (by color) shared across the recursion, with a running distinct count.
    let freq = {}
    let distinct_box = [0]
    // We simulate the recursion with an explicit stack of frames.
    // Each frame: [node, phase] phase 0 = enter, 1 = after processing children (compute answer).
    // We process light children first (adding then REMOVING their contribution), keep the heavy child.
    let stack = [[root, 0]]
    while len(stack) > 0
        let top = stack[len(stack) - 1]
        let ns = []
        let si = 0
        while si < len(stack) - 1
            push(ns, stack[si])
            si = si + 1
        stack = ns
        let node = top[0]
        let phase = top[1]
        if phase == 0
            // Enter: first recurse into LIGHT children (each fully computed then erased),
            // then recurse into the HEAVY child (kept), then finalize this node in phase 1.
            // We push in reverse order of desired execution.
            // desired: light children (compute+erase) ... then heavy (keep) ... then finalize(node)
            // Because stack is LIFO, push finalize last-executed items first.
            push(stack, [node, 1])
            let hc = heavy[node]
            // heavy child: recurse but KEEP its data (no erase)
            if hc != 0 - 1
                push(stack, [hc, 0])
            // light children: each is a "compute then erase" episode. We encode erase as phase 2.
            let ch = children[node]
            let ci = len(ch) - 1
            while ci >= 0
                let c = ch[ci]
                if c != hc
                    // erase marker first (executes AFTER the child subtree is computed), then enter child
                    push(stack, [c, 2])
                    push(stack, [c, 0])
                ci = ci - 1
        else
            if phase == 2
                // Erase: remove the whole subtree(node) contribution from freq/distinct.
                let start = tin[node]
                let end = tin[node] + size[node] - 1
                let p = start
                while p <= end
                    let col = color[euler[p]]
                    let key = str(col)
                    let f = get(freq, key, 0)
                    freq[key] = f - 1
                    if f - 1 == 0
                        distinct_box[0] = distinct_box[0] - 1
                    p = p + 1
            else
                // phase 1 finalize: at this point, the heavy child's data is already present,
                // and all light children were computed+erased. Now ADD this node's own light-subtree
                // contributions: the node itself plus all LIGHT children's subtrees (heavy already in).
                // Add node itself:
                _dot_add_one(freq, distinct_box, color[node])
                // Add each light child's ENTIRE subtree:
                let hc = heavy[node]
                let ch = children[node]
                let ci = 0
                while ci < len(ch)
                    let c = ch[ci]
                    if c != hc
                        let start = tin[c]
                        let end = tin[c] + size[c] - 1
                        let p = start
                        while p <= end
                            _dot_add_one(freq, distinct_box, color[euler[p]])
                            p = p + 1
                    ci = ci + 1
                // Now freq/distinct reflect the FULL subtree(node); record the answer.
                answer[node] = distinct_box[0]
    return answer

fn _dot_add_one(freq: dict, distinct_box: list, col: int)
    let key = str(col)
    let f = get(freq, key, 0)
    if f == 0
        distinct_box[0] = distinct_box[0] + 1
    freq[key] = f + 1

// DSU-on-tree computing the MODE count (frequency of the most common color) per subtree.
// Same small-to-large skeleton but tracks a running max-frequency alongside freq.
fn dot_mode_count_per_subtree(n: int, parent: list, root: int, color: list) -> list
    let children = _dot_children(n, parent)
    let prep = _dot_prep(n, root, children)
    let size = prep[0]
    let heavy = prep[1]
    let tin = prep[2]
    let euler = prep[3]
    let answer = []
    let i = 0
    while i < n
        push(answer, 0)
        i = i + 1
    let freq = {}
    // max_box[0] = current max frequency in the active window
    let max_box = [0]
    let stack = [[root, 0]]
    while len(stack) > 0
        let top = stack[len(stack) - 1]
        let ns = []
        let si = 0
        while si < len(stack) - 1
            push(ns, stack[si])
            si = si + 1
        stack = ns
        let node = top[0]
        let phase = top[1]
        if phase == 0
            push(stack, [node, 1])
            let hc = heavy[node]
            if hc != 0 - 1
                push(stack, [hc, 0])
            let ch = children[node]
            let ci = len(ch) - 1
            while ci >= 0
                let c = ch[ci]
                if c != hc
                    push(stack, [c, 2])
                    push(stack, [c, 0])
                ci = ci - 1
        else
            if phase == 2
                // erase subtree(node) AND recompute max from scratch over remaining freq
                let start = tin[node]
                let end = tin[node] + size[node] - 1
                let p = start
                while p <= end
                    let key = str(color[euler[p]])
                    freq[key] = get(freq, key, 0) - 1
                    p = p + 1
                // recompute max (simple: scan the values that remain non-zero)
                max_box[0] = _dot_recompute_max(freq)
            else
                // finalize: add node + light children subtrees, tracking max
                _dot_add_mode(freq, max_box, color[node])
                let hc = heavy[node]
                let ch = children[node]
                let ci = 0
                while ci < len(ch)
                    let c = ch[ci]
                    if c != hc
                        let start = tin[c]
                        let end = tin[c] + size[c] - 1
                        let p = start
                        while p <= end
                            _dot_add_mode(freq, max_box, color[euler[p]])
                            p = p + 1
                    ci = ci + 1
                answer[node] = max_box[0]
    return answer

fn _dot_add_mode(freq: dict, max_box: list, col: int)
    let key = str(col)
    let f = get(freq, key, 0) + 1
    freq[key] = f
    if f > max_box[0]
        max_box[0] = f

fn _dot_recompute_max(freq: dict) -> int
    let ks = keys(freq)
    let mx = 0
    let i = 0
    while i < len(ks)
        let v = get(freq, ks[i], 0)
        if v > mx
            mx = v
        i = i + 1
    return mx
