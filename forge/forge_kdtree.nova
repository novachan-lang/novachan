// forge_kdtree -- a 2-D k-d tree for fast NEAREST-NEIGHBOR search: preprocess a set of points once, then answer
// "which stored point is closest to this query?" in roughly O(log n) instead of scanning them all. A k-d tree
// recursively splits the plane, alternating between the x and y axis at each level, so a query can PRUNE whole
// subtrees whose region is already farther than the best point found. It's the classic structure behind nearest-
// facility lookups (closest store/charger/cell tower), accelerating k-nearest-neighbor classifiers, collision and
// proximity culling in games, and snapping to the nearest feature on a map. Unlike a uniform grid (forge
// spatialhash) it adapts to clustered data, and unlike forge_closestpair (one global answer) it serves many
// queries against a fixed set. Points are [x, y] integer pairs; distances are exact SQUARED integers (no floats).
// LEAF -- imports NOTHING.

// PRIVATE: squared distance between (ax,ay) and point p=[x,y].
fn _kd_d2(ax: int, ay: int, p: list) -> int
    let dx = ax - p[0]
    let dy = ay - p[1]
    dx * dx + dy * dy

// PRIVATE: recursively build a balanced subtree from index list `idx`, splitting on axis depth%2. Node fields are
// appended to the parallel pools; returns the node id (or -1 for empty).
fn _kd_build(points: list, idx: list, depth: int, pt: list, lft: list, rgt: list, ax: list) -> int
    if len(idx) == 0
        return -1
    let axis = depth % 2
    // insertion-sort idx by coordinate on this axis (int index array -> safe scalar moves)
    for a in 1..len(idx)
        let key = idx[a]
        let b = a - 1
        while b >= 0 and points[idx[b]][axis] > points[key][axis]
            idx[b + 1] = idx[b]
            b -= 1
        idx[b + 1] = key
    let mid = len(idx) / 2
    let node = len(pt)
    push(pt, idx[mid])
    push(lft, -1)
    push(rgt, -1)
    push(ax, axis)
    // left/right index sublists
    let li = [idx[i] for i in 0..mid]
    let ri = [idx[i] for i in (mid + 1)..len(idx)]
    let l = _kd_build(points, li, depth + 1, pt, lft, rgt, ax)
    let r = _kd_build(points, ri, depth + 1, pt, lft, rgt, ax)
    lft[node] = l
    rgt[node] = r
    node

// Build a k-d tree over `points` (list of [x,y]). Returns an opaque pack for kd_nearest.
fn kd_build(points: list) -> list
    let pt = []
    let lft = []
    let rgt = []
    let ax = []
    let idx = [i for i in 0..len(points)]
    let root = _kd_build(points, idx, 0, pt, lft, rgt, ax)
    [root, pt, lft, rgt, ax, points]

// PRIVATE: recursive nearest-neighbor search; best = [best_dist2, best_point_index] mutated in place.
fn _kd_nn(node: int, qx: int, qy: int, pt: list, lft: list, rgt: list, ax: list, points: list, best: list)
    if node == -1
        return
    let pidx = pt[node]
    let d = _kd_d2(qx, qy, points[pidx])
    if d < best[0]
        best[0] = d
        best[1] = pidx
    let axis = ax[node]
    let qv = qx
    let pv = points[pidx][0]
    if axis == 1
        qv = qy
        pv = points[pidx][1]
    let diff = qv - pv
    let near = rgt[node] if diff > 0 else lft[node]
    let far = lft[node] if diff > 0 else rgt[node]
    _kd_nn(near, qx, qy, pt, lft, rgt, ax, points, best)
    // only descend the far side if the splitting plane is closer than the current best
    if diff * diff < best[0]
        _kd_nn(far, qx, qy, pt, lft, rgt, ax, points, best)

// The index (into the original points list) of the point nearest to (qx, qy). -1 if the tree is empty.
fn kd_nearest(tree: list, qx: int, qy: int) -> int
    let best = [4611686018427387904, -1]
    _kd_nn(tree[0], qx, qy, tree[1], tree[2], tree[3], tree[4], tree[5], best)
    best[1]

// The squared distance from (qx, qy) to its nearest stored point (-1 if empty).
fn kd_nearest_dist2(tree: list, qx: int, qy: int) -> int
    let best = [4611686018427387904, -1]
    _kd_nn(tree[0], qx, qy, tree[1], tree[2], tree[3], tree[4], tree[5], best)
    let out = -1
    if best[1] != -1
        out = best[0]
    out
