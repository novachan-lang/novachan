// forge_kdtree -- thin wrapper over std/collections/kdtree (canonical implementation).
import std/collections/kdtree

fn _kd_nn(node: int, qx: int, qy: int, pt: list, lft: list, rgt: list, ax: list, points: list, best: list)
    if node == -1
        return
    let pidx = pt[node]
    let d = _kd_d2(qx, qy, points[pidx])
    if d < best[0]
        best[0] = d
        best[1] = pidx
    let axis = ax[node]
    let qv = qx
    let pv = points[pidx][0]
    if axis == 1
        qv = qy
        pv = points[pidx][1]
    let diff = qv - pv
    let near = rgt[node] if diff > 0 else lft[node]
    let far = lft[node] if diff > 0 else rgt[node]
    _kd_nn(near, qx, qy, pt, lft, rgt, ax, points, best)
    // only descend the far side if the splitting plane is closer than the current best
    if diff * diff < best[0]
        _kd_nn(far, qx, qy, pt, lft, rgt, ax, points, best)

// The index (into the original points list) of the point nearest to (qx, qy). -1 if the tree is empty.

fn kd_build(points: list) -> list
    return kd_build(points)

fn kd_nearest(tree: list, qx: int, qy: int) -> int
    return kd_nearest(tree, qx, qy)

fn kd_nearest_dist2(tree: list, qx: int, qy: int) -> int
    let best = [4611686018427387904, -1]
    _kd_nn(tree[0], qx, qy, tree[1], tree[2], tree[3], tree[4], tree[5], best)
    let out = -1
    if best[1] != -1
        out = best[0]
    out

