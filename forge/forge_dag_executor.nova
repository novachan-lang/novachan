// forge_dag_executor — simple DAG task ordering with dependency tracking and Result API.

fn dag_new() -> dict
    {"tasks": {}, "deps": {}, "done": {}, "task_count": 0, "executed": 0}

fn dag_add_task(d: dict, name: string) -> dict
    d["tasks"]["t_{name}"] = 1
    d["task_count"] += 1
    d

fn dag_add_dep(d: dict, task: string, depends_on: string) -> Result
    if "t_{task}" not in d["tasks"]
        return err("task not found: {task}")
    if "t_{depends_on}" not in d["tasks"]
        return err("dependency not found: {depends_on}")
    d["deps"]["d_{task}_{depends_on}"] = 1
    ok(d)

fn dag_is_ready(d: dict, task: string) -> int
    if "t_{task}" not in d["tasks"]
        return 0
    if "t_{task}" in d["done"]
        return 0
    let all_tasks = keys(d["deps"])
    for i in 0..len(all_tasks)
        let dk = all_tasks[i]
        let prefix = "d_{task}_"
        if len(dk) > len(prefix)
            if slice(dk, 0, len(prefix)) == prefix
                let dep = slice(dk, len(prefix), len(dk))
                if "t_{dep}" not in d["done"]
                    return 0
    1

fn dag_execute(d: dict, task: string) -> Result
    if dag_is_ready(d, task) == 0
        return err("task not ready or not found: {task}")
    d["done"]["t_{task}"] = 1
    d["executed"] += 1
    ok(d)

fn dag_is_done(d: dict, task: string) -> int
    1 if "t_{task}" in d["done"] else 0

fn dag_task_count(d: dict) -> int
    d["task_count"]

fn dag_executed_count(d: dict) -> int
    d["executed"]

fn dag_is_complete(d: dict) -> int
    1 if d["executed"] == d["task_count"] else 0
