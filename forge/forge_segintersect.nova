// forge_segintersect -- do two line SEGMENTS cross, and if so, where? Two segments (each given by its endpoints)
// either miss, touch, or cross; this decides which and computes the crossing point. It's a bedrock 2D-geometry
// operation: detecting when a moving object's path hits a wall, self-intersections in a polygon or route,
// map/CAD overlap, laser/ray hits, wire-crossing checks, and clipping. The test uses only cross-product
// orientation (which side of a line a point is on) plus on-segment checks -- integer-exact, no square roots. The
// intersection point (for a proper crossing of non-parallel segments) is found by the determinant formula, which
// needs one division but still no sqrt. Points are [x, y]. LEAF -- imports NOTHING.

// PRIVATE: orientation of the ordered triple (p, q, r): 0 collinear, 1 clockwise, 2 counter-clockwise.
fn _si_orient(p: list, q: list, r: list) -> int
    let val = (q[1] * 1.0 - p[1] * 1.0) * (r[0] * 1.0 - q[0] * 1.0) - (q[0] * 1.0 - p[0] * 1.0) * (r[1] * 1.0 - q[1] * 1.0)
    let o = 0
    if val > 0.0
        o = 1
    else if val < 0.0
        o = 2
    o

// PRIVATE: is point q on segment pr, given p,q,r are collinear?
fn _si_on(p: list, q: list, r: list) -> bool
    let qx = q[0] * 1.0
    let qy = q[1] * 1.0
    let minx = p[0] * 1.0
    let maxx = r[0] * 1.0
    if maxx < minx
        minx = r[0] * 1.0
        maxx = p[0] * 1.0
    let miny = p[1] * 1.0
    let maxy = r[1] * 1.0
    if maxy < miny
        miny = r[1] * 1.0
        maxy = p[1] * 1.0
    qx >= minx and qx <= maxx and qy >= miny and qy <= maxy

// True if segment a-b intersects segment c-d (including touching at an endpoint or collinear overlap).
fn segments_intersect(a: list, b: list, c: list, d: list) -> bool
    let o1 = _si_orient(a, b, c)
    let o2 = _si_orient(a, b, d)
    let o3 = _si_orient(c, d, a)
    let o4 = _si_orient(c, d, b)
    // general case: c,d on opposite sides of ab AND a,b on opposite sides of cd; else the collinear
    // special cases (an orientation of 0 with the third point lying on the segment).
    (o1 != o2 and o3 != o4) or (o1 == 0 and _si_on(a, c, b)) or (o2 == 0 and _si_on(a, d, b)) or (o3 == 0 and _si_on(c, a, d)) or (o4 == 0 and _si_on(c, b, d))

// The intersection point [x, y] of the two segments if they cross at a single point, or null (miss, parallel,
// or collinear-overlap). Uses the determinant formula.
fn intersection_point(a: list, b: list, c: list, d: list)
    if not segments_intersect(a, b, c, d)
        return null
    let x1 = a[0] * 1.0
    let y1 = a[1] * 1.0
    let x2 = b[0] * 1.0
    let y2 = b[1] * 1.0
    let x3 = c[0] * 1.0
    let y3 = c[1] * 1.0
    let x4 = d[0] * 1.0
    let y4 = d[1] * 1.0
    let denom = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
    if denom == 0.0
        return null
    let t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / denom
    [x1 + t * (x2 - x1), y1 + t * (y2 - y1)]
