// forge_fence_token — Fencing tokens for distributed lock safety.
// Monotonic tokens ensure stale lock holders can't write.

fn ft_new() -> dict
    let ft = {}
    ft["counter"] = 0
    ft["holders"] = {}
    ft["revoked"] = {}
    ft

fn ft_acquire(ft: dict, owner: string) -> dict
    ft["counter"] = ft["counter"] + 1
    let token = ft["counter"]
    ft["holders"][owner] = token
    let result = {}
    result["token"] = token
    result["owner"] = owner
    result["ft"] = ft
    result

fn ft_validate(ft: dict, owner: string, token: int) -> int
    let has_owner = contains(ft["holders"], owner)
    if has_owner != true
        return 0
    let current = ft["holders"][owner]
    if current != token
        return 0
    let revoked = contains(ft["revoked"], str(token))
    if revoked == true
        return 0
    1

fn ft_revoke(ft: dict, owner: string) -> dict
    let has_owner = contains(ft["holders"], owner)
    if has_owner == true
        let token = ft["holders"][owner]
        ft["revoked"][str(token)] = 1
    ft

fn ft_current_token(ft: dict) -> int
    ft["counter"]

fn ft_owner_token(ft: dict, owner: string) -> int
    let has_owner = contains(ft["holders"], owner)
    if has_owner != true
        return 0
    ft["holders"][owner]

fn ft_is_latest(ft: dict, token: int) -> int
    if token == ft["counter"]
        return 1
    0
