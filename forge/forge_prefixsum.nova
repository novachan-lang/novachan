// forge_prefixsum -- prefix sums (a.k.a. summed-area tables) and their dual, the difference array. A prefix sum
// precomputes running totals ONCE so that afterwards the sum of ANY range answers in O(1) by a single subtraction
// -- turning "sum of elements l..r", asked a million times, from O(n) each into O(1) each. The 2-D version (the
// summed-area / integral image) does the same for any rectangular sub-block, which is the trick behind fast image
// filters (box blur), Haar-feature face detection, and heatmap/analytics queries. The difference array is the
// mirror image: it makes RANGE UPDATES O(1) (add a value to every element in [l,r] by touching just two
// endpoints), then one final pass materializes the array -- ideal when you apply many overlapping increments
// (booking seats, interval coverage, scheduling) and only read at the end. Integer elements. LEAF -- imports NOTHING.

// The 1-D prefix-sum array of xs: P has length n+1, P[0]=0, P[i]=xs[0]+...+xs[i-1]. Pass P to range_sum_1d.
fn prefix_1d(xs: list) -> list
    let p = [0]
    let running = 0
    for i in 0..len(xs)
        running += xs[i]
        push(p, running)
    p

// The sum of xs[l..r] inclusive, in O(1), from a prefix array built by prefix_1d.
fn range_sum_1d(prefix: list, l: int, r: int) -> int
    prefix[r + 1] - prefix[l]

// A 2-D prefix sum (summed-area table) for matrix `mat` (rows of equal length). Returns a packed
// [flat_prefix, rows, cols] to pass to range_sum_2d. The flat prefix is (rows+1)*(cols+1) with a zero border.
fn prefix_2d(mat: list) -> list
    let r = len(mat)
    let c = 0
    if r > 0
        c = len(mat[0])
    let w = c + 1
    let p = [0 for z in 0..((r + 1) * w)]
    for i in 1..(r + 1)
        for j in 1..(c + 1)
            p[i * w + j] = mat[i - 1][j - 1] + p[(i - 1) * w + j] + p[i * w + (j - 1)] - p[(i - 1) * w + (j - 1)]
    [p, r, c]

// The sum of the sub-rectangle rows r1..r2, cols c1..c2 (all inclusive), in O(1), from a pack built by prefix_2d.
fn range_sum_2d(pack: list, r1: int, c1: int, r2: int, c2: int) -> int
    let p = pack[0]
    let c = pack[2]
    let w = c + 1
    p[(r2 + 1) * w + (c2 + 1)] - p[r1 * w + (c2 + 1)] - p[(r2 + 1) * w + c1] + p[r1 * w + c1]

// A fresh difference array for n elements (length n+1, all zero). Apply range adds with diff_add, then diff_apply.
fn diff_build(n: int) -> list
    [0 for i in 0..(n + 1)]

// Add `val` to every element in [l, r] inclusive, in O(1), by touching only the two endpoints of the difference
// array (mutates d in place).
fn diff_add(d: list, l: int, r: int, val: int)
    d[l] = d[l] + val
    d[r + 1] = d[r + 1] - val

// Materialize the final array of length n from a difference array (one prefix-sum pass).
fn diff_apply(d: list, n: int) -> list
    let out = []
    let running = 0
    for i in 0..n
        running += d[i]
        push(out, running)
    out
