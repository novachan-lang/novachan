// forge_doc_gen — NOVA source documentation generator.
// Parses .nova source files, extracts function signatures, params, and doc
// comments (lines starting with "#" or "//" directly above a "fn " line),
// and renders human-readable documentation.
//
// State is a flat dict (no nested dicts/lists-in-dicts — those crash):
//   state["file_count"]                 -- string int, files parsed
//   state["fn_count"]                   -- string int, total documented fns
//   state["fn_names"]                   -- comma-separated fn name list
//   state["fn_" + name + "_params"]     -- comma-separated param names
//   state["fn_" + name + "_file"]       -- source filename
//   state["fn_" + name + "_line"]       -- 1-based line number (string)
//   state["fn_" + name + "_doc"]        -- doc comment text (may be "")
//   state["fn_" + name + "_sig"]        -- full "fn name(...)" signature text

fn dg_new() -> dict
    let st = {}
    st["file_count"] = "0"
    st["fn_count"] = "0"
    st["fn_names"] = ""
    st

// Extract the comma-separated parameter NAMES (not types) from a signature
// line such as "fn add(a: int, b: int) -> int".
fn dg_extract_params(sig_line: string) -> string
    let open_i = find(sig_line, "(")
    let close_i = find(sig_line, ")")
    if open_i < 0
        return ""
    if close_i < 0
        return ""
    if close_i <= open_i
        return ""
    let inner = slice(sig_line, open_i + 1, close_i)
    let inner_t = trim(inner)
    if len(inner_t) == 0
        return ""
    let parts = split(inner_t, ",")
    let out = ""
    for i in 0..len(parts)
        let p = trim(parts[i])
        let colon_i = find(p, ":")
        let pname = p
        if colon_i >= 0
            pname = trim(slice(p, 0, colon_i))
        if len(pname) > 0
            if len(out) > 0
                out += ", "
            out += pname
    out

// Extract the function name from a line starting with "fn ".
fn dg_extract_name(sig_line: string) -> string
    let after = trim(slice(sig_line, 3, len(sig_line)))
    let open_i = find(after, "(")
    if open_i < 0
        return ""
    trim(slice(after, 0, open_i))

// 1 if the trimmed line looks like a doc-comment line ("#..." or "//...").
fn dg_is_comment_line(trimmed: string) -> int
    if len(trimmed) == 0
        return 0
    if starts_with(trimmed, "#")
        return 1
    if starts_with(trimmed, "//")
        return 1
    0

// Strip a leading "#" or "//" (and one following space) from a comment line.
fn dg_strip_comment_marker(trimmed: string) -> string
    let body = trimmed
    if starts_with(body, "//")
        body = slice(body, 2, len(body))
    else if starts_with(body, "#")
        body = slice(body, 1, len(body))
    trim(body)

// Parse one NOVA source file's content and register every top-level
// function it declares into `state`. Returns the updated state.
fn dg_parse_file(state: dict, filename: string, content: string) -> dict
    let lines = split(content, "\n")
    let pending_doc = ""
    let line_no = 0
    for i in 0..len(lines)
        line_no += 1
        let raw = lines[i]
        let trimmed = trim(raw)
        if dg_is_comment_line(trimmed) == 1
            let piece = dg_strip_comment_marker(trimmed)
            if len(pending_doc) == 0
                pending_doc = piece
            else
                pending_doc += " " + piece
        else if starts_with(trimmed, "fn ")
            let name = dg_extract_name(trimmed)
            if len(name) > 0
                let params = dg_extract_params(trimmed)
                let already = dg_has_fn(state, name)
                if already == 0
                    if len(state["fn_names"]) > 0
                        state["fn_names"] = state["fn_names"] + "," + name
                    else
                        state["fn_names"] = name
                    state["fn_count"] = str(int(state["fn_count"]) + 1)
                state["fn_" + name + "_params"] = params
                state["fn_" + name + "_file"] = filename
                state["fn_" + name + "_line"] = str(line_no)
                state["fn_" + name + "_doc"] = pending_doc
                state["fn_" + name + "_sig"] = trimmed
            pending_doc = ""
        else if len(trimmed) == 0
            pending_doc = pending_doc
        else
            pending_doc = ""
    state["file_count"] = str(int(state["file_count"]) + 1)
    state

// 1 if `fn_name` has been documented, else 0.
fn dg_has_fn(state: dict, fn_name: string) -> int
    let has = contains(state, "fn_" + fn_name + "_sig")
    if has == true
        return 1
    0

// Number of documented functions.
fn dg_fn_count(state: dict) -> int
    int(state["fn_count"])

// Comma-separated list of all documented function names.
fn dg_fn_list(state: dict) -> string
    state["fn_names"]

// Nth documented function name (0-based index) as a Result.
fn dg_fn_at(state: dict, index: int) -> Result
    if index < 0
        return err("dg_fn_at: negative index")
    let names = split(state["fn_names"], ",")
    if index >= len(names)
        return err("dg_fn_at: index out of range")
    ok(names[index])

// Comma-separated parameter list for a function, as a Result.
fn dg_param_list(state: dict, fn_name: string) -> Result
    if dg_has_fn(state, fn_name) == 0
        return err("dg_param_list: unknown function '" + fn_name + "'")
    ok(state["fn_" + fn_name + "_params"])

// Get the full doc record for a function, rendered as a Result<string>.
// Format: "name(params) -- doc [file:line]"
fn dg_get_fn(state: dict, name: string) -> Result
    if dg_has_fn(state, name) == 0
        return err("dg_get_fn: unknown function '" + name + "'")
    let sig = state["fn_" + name + "_sig"]
    let doc = state["fn_" + name + "_doc"]
    let file = state["fn_" + name + "_file"]
    let line = state["fn_" + name + "_line"]
    let out = sig
    if len(doc) > 0
        out += " -- " + doc
    out += " [" + file + ":" + line + "]"
    ok(out)

// Render full documentation text for one function, as a Result<string>.
fn dg_render_fn(state: dict, fn_name: string) -> Result
    if dg_has_fn(state, fn_name) == 0
        return err("dg_render_fn: unknown function '" + fn_name + "'")
    let sig = state["fn_" + fn_name + "_sig"]
    let doc = state["fn_" + fn_name + "_doc"]
    let params = state["fn_" + fn_name + "_params"]
    let file = state["fn_" + fn_name + "_file"]
    let line = state["fn_" + fn_name + "_line"]
    let out = "## " + fn_name + "\n\n"
    out += "```\n" + sig + "\n```\n\n"
    if len(doc) > 0
        out += doc + "\n\n"
    if len(params) > 0
        out += "Parameters: " + params + "\n"
    else
        out += "Parameters: (none)\n"
    out += "Defined in " + file + " at line " + line + "\n"
    ok(out)

// Render documentation for every function, in registration order.
fn dg_render_all(state: dict) -> string
    let names = split(state["fn_names"], ",")
    let out = "# Documentation\n\n"
    for i in 0..len(names)
        let n = names[i]
        if len(n) > 0
            let r = dg_render_fn(state, n)
            if is_ok(r)
                out += unwrap(r) + "\n"
    out
