// forge_envelope -- a standard API response envelope so every endpoint returns a CONSISTENT shape:
// {"data": ...} on success (+ optional "meta"), {"error": {code, message}} on failure. The JSON:API-lite
// convention teams standardize on (vs each route inventing its own shape). json_stringify -> the response
// body. LEAF -- imports NOTHING.

fn envelope_ok(data) -> dict
    let e = {}
    e["data"] = data
    e

fn envelope_ok_meta(data, meta) -> dict
    let e = {}
    e["data"] = data
    e["meta"] = meta
    e

fn envelope_error(code: string, message: string) -> dict
    let err = {}
    err["code"] = code
    err["message"] = message
    let e = {}
    e["error"] = err
    e

// A paginated success envelope: data + meta{page, per_page, total}.
fn envelope_page(items, page: int, per_page: int, total: int) -> dict
    let meta = {}
    meta["page"] = page
    meta["per_page"] = per_page
    meta["total"] = total
    envelope_ok_meta(items, meta)
