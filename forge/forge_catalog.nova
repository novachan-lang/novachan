// forge_catalog — Data catalog (tables/columns/lineage) with Result.

fn cat_new() -> dict
    {"tables": {}, "columns": {}, "lineage": {}, "table_count": 0}

fn cat_add_table(c: dict, name: string, description: string) -> dict
    c["tables"][name] = description
    c["columns"]["{name}_count"] = 0
    c["table_count"] += 1
    c

fn cat_add_column(c: dict, table: string, col_name: string, col_type: string) -> Result
    if table not in c["tables"]
        return err("unknown table: {table}")
    let idx = c["columns"]["{table}_count"]
    c["columns"]["{table}_{idx}"] = col_name
    c["columns"]["{table}_{idx}_type"] = col_type
    c["columns"]["{table}_count"] = idx + 1
    ok(c)

fn cat_add_lineage(c: dict, source: string, target: string) -> Result
    if source not in c["tables"]
        return err("unknown source: {source}")
    if target not in c["tables"]
        return err("unknown target: {target}")
    c["lineage"]["{source}->{target}"] = 1
    ok(c)

fn cat_table_description(c: dict, name: string) -> Result
    if name not in c["tables"]
        return err("unknown table: {name}")
    ok(c["tables"][name])

fn cat_column_count(c: dict, table: string) -> int
    c["columns"]["{table}_count"]

fn cat_has_lineage(c: dict, source: string, target: string) -> int
    let key = "{source}->{target}"
    1 if key in c["lineage"] else 0

fn cat_table_count(c: dict) -> int
    c["table_count"]
