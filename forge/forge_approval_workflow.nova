// forge_approval_workflow -- multi-step approval: submit requests, accumulate approvals (self-approval
// blocked), auto-approve when the threshold is met, reject with reason. Flat-dict state with indexed
// request keys. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. aw_new built the state dict as three individual assignments. Dict literal.
//   2. THE REQUEST KEY `request_id + "_status"` (and _submitter/_approvals/_rejections) was built by
//      concatenation at TWELVE sites. _aw_key owns the scheme.
//   3. `contains(...) != true` at THREE sites -- `not in`.
//   4. Error messages used `"unknown request: " + request_id` -- interpolation. And compound assignment.

// PRIVATE: the per-request key scheme.
fn _aw_key(request_id: string, field: string) -> string
    "{request_id}_{field}"

fn aw_new(required_approvals: int) -> dict
    {"required": required_approvals, "requests": {}, "req_count": 0}

fn aw_submit(a: dict, request_id: string, submitter: string) -> dict
    a["requests"][_aw_key(request_id, "submitter")] = submitter
    a["requests"][_aw_key(request_id, "status")] = "pending"
    a["requests"][_aw_key(request_id, "approvals")] = 0
    a["requests"][_aw_key(request_id, "rejections")] = 0
    a["req_count"] += 1
    a

fn aw_approve(a: dict, request_id: string, approver: string) -> Result
    let sk = _aw_key(request_id, "status")
    if sk not in a["requests"]
        return err("unknown request: {request_id}")
    let status = str(a["requests"][sk])
    if status != "pending"
        return err("request not pending: {status}")
    if approver == str(a["requests"][_aw_key(request_id, "submitter")])
        return err("self-approval not allowed")
    let ak = _aw_key(request_id, "approvals")
    a["requests"][ak] += 1
    if a["requests"][ak] >= a["required"]
        a["requests"][sk] = "approved"
    ok(a)

fn aw_reject(a: dict, request_id: string, reason: string) -> Result
    let sk = _aw_key(request_id, "status")
    if sk not in a["requests"]
        return err("unknown request: {request_id}")
    a["requests"][sk] = "rejected"
    a["requests"][_aw_key(request_id, "rejections")] += 1
    ok(a)

fn aw_status(a: dict, request_id: string) -> Result
    let sk = _aw_key(request_id, "status")
    if sk not in a["requests"]
        return err("unknown request")
    ok(a["requests"][sk])

fn aw_approvals(a: dict, request_id: string) -> int
    a["requests"][_aw_key(request_id, "approvals")]

fn aw_request_count(a: dict) -> int
    a["req_count"]
