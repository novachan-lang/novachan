// forge_approval_workflow — Multi-step approval with Result.

fn aw_new(required_approvals: int) -> dict
    let a = {}
    a["required"] = required_approvals
    a["requests"] = {}
    a["req_count"] = 0
    a

fn aw_submit(a: dict, request_id: string, submitter: string) -> dict
    a["requests"][request_id + "_submitter"] = submitter
    a["requests"][request_id + "_status"] = "pending"
    a["requests"][request_id + "_approvals"] = 0
    a["requests"][request_id + "_rejections"] = 0
    a["req_count"] = a["req_count"] + 1
    a

fn aw_approve(a: dict, request_id: string, approver: string) -> Result
    let has = contains(a["requests"], request_id + "_status")
    if has != true
        return err("unknown request: " + request_id)
    let status = a["requests"][request_id + "_status"]
    if status != "pending"
        return err("request not pending: " + status)
    if approver == a["requests"][request_id + "_submitter"]
        return err("self-approval not allowed")
    a["requests"][request_id + "_approvals"] = a["requests"][request_id + "_approvals"] + 1
    if a["requests"][request_id + "_approvals"] >= a["required"]
        a["requests"][request_id + "_status"] = "approved"
    ok(a)

fn aw_reject(a: dict, request_id: string, reason: string) -> Result
    let has = contains(a["requests"], request_id + "_status")
    if has != true
        return err("unknown request: " + request_id)
    a["requests"][request_id + "_status"] = "rejected"
    a["requests"][request_id + "_rejections"] = a["requests"][request_id + "_rejections"] + 1
    ok(a)

fn aw_status(a: dict, request_id: string) -> Result
    let has = contains(a["requests"], request_id + "_status")
    if has != true
        return err("unknown request")
    ok(a["requests"][request_id + "_status"])

fn aw_approvals(a: dict, request_id: string) -> int
    a["requests"][request_id + "_approvals"]

fn aw_request_count(a: dict) -> int
    a["req_count"]
