// forge_consent -- GDPR/CCPA consent management: track a user's opt-in per category (necessary / analytics /
// marketing / preferences) and GATE cookie-setting + tracking on it (never fire analytics/marketing without
// consent). "necessary" is always granted; the rest require explicit opt-in. Encodes to a compact cookie
// string and back. LEAF -- imports NOTHING.

fn consent_new() -> dict
    {"necessary": true, "analytics": false, "marketing": false, "preferences": false}

// Grant a category (opt-in). Fluent.
fn consent_grant(c: dict, category: string) -> dict
    c[category] = true
    c

// Revoke a category (necessary cannot be revoked). Fluent.
fn consent_revoke(c: dict, category: string) -> dict
    if category != "necessary"
        c[category] = false
    c

// Is this category allowed? necessary is always true; unknown categories default to false (deny by default).
fn consent_allowed(c: dict, category: string) -> bool
    if category == "necessary"
        return true
    if category not in c
        return false
    c[category]

fn _consent_bit(c: dict, cat: string) -> string
    if consent_allowed(c, cat)
        return "1"
    "0"

// Encode to a compact cookie value "n1a?m?p?" (category initial + 0/1) for storage.
fn consent_encode(c: dict) -> string
    let a = _consent_bit(c, "analytics")
    let m = _consent_bit(c, "marketing")
    let p = _consent_bit(c, "preferences")
    "n1a{a}m{m}p{p}"

// Decode a consent cookie value back to a consent dict.
fn consent_decode(s: string) -> dict
    let c = consent_new()
    if find(s, "a1") >= 0
        c["analytics"] = true
    if find(s, "m1") >= 0
        c["marketing"] = true
    if find(s, "p1") >= 0
        c["preferences"] = true
    c
