// forge_bitio -- read and write data at the BIT level, packing values of ANY bit width tightly into bytes.
// Writer and reader state are plain dicts. Values are non-negative integers. LEAF -- imports NOTHING.

fn bw_new() -> dict
    {"bytes": [], "cur": 0, "nbits": 0}

fn bw_write_bits(w: dict, value: int, n: int)
    let i = n - 1
    while i >= 0
        let bit = (value >> i) & 1
        w["cur"] = (w["cur"] << 1) | bit
        w["nbits"] += 1
        if w["nbits"] == 8
            push(w["bytes"], w["cur"])
            w["cur"] = 0
            w["nbits"] = 0
        i -= 1

fn bw_finish(w: dict) -> list
    if w["nbits"] > 0
        w["cur"] = w["cur"] << (8 - w["nbits"])
        push(w["bytes"], w["cur"])
        w["cur"] = 0
        w["nbits"] = 0
    w["bytes"]

fn bw_bitcount(w: dict) -> int
    len(w["bytes"]) * 8 + w["nbits"]

fn br_new(bytes: list) -> dict
    {"bytes": bytes, "pos": 0}

fn br_read_bits(r: dict, n: int) -> int
    let value = 0
    let bytes = r["bytes"]
    for i in 0..n
        let pos = r["pos"]
        let bytepos = pos / 8
        let bitpos = 7 - (pos % 8)
        let bit = 0
        if bytepos < len(bytes)
            bit = (bytes[bytepos] >> bitpos) & 1
        value = (value << 1) | bit
        r["pos"] += 1
    value

fn br_remaining(r: dict) -> int
    len(r["bytes"]) * 8 - r["pos"]
