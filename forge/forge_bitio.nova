// forge_bitio -- read and write data at the BIT level, packing values of ANY bit width tightly into bytes instead
// of wasting a whole byte (or more) per field. This is what binary formats need but a byte-oriented API can't do:
// emit a 3-bit flag, a 5-bit count, and a 12-bit offset back-to-back; write the variable-length codes a Huffman
// compressor (forge_huffman) produces; or pack a protocol/bitmap/pixel format where fields don't fall on byte
// boundaries. A writer accumulates bits MSB-first and flushes complete bytes, padding the last one; a reader walks
// the same stream back, pulling n bits at a time. Together they let you define a compact binary layout and
// round-trip it exactly. Writer and reader state are plain dicts you pass along. Values are non-negative integers.
// LEAF -- imports NOTHING.

// A new bit writer.
fn bw_new() -> dict
    let w = {}
    w["bytes"] = []
    w["cur"] = 0
    w["nbits"] = 0
    w

// Write the low `n` bits of `value` to the writer, most-significant bit first.
fn bw_write_bits(w: dict, value: int, n: int)
    let i = n - 1
    while i >= 0
        let bit = (value >> i) & 1
        w["cur"] = (w["cur"] << 1) | bit
        w["nbits"] = w["nbits"] + 1
        if w["nbits"] == 8
            push(w["bytes"], w["cur"])
            w["cur"] = 0
            w["nbits"] = 0
        i -= 1

// Finish writing: flush any partial final byte (zero-padded on the right) and return the completed byte list.
fn bw_finish(w: dict) -> list
    if w["nbits"] > 0
        w["cur"] = w["cur"] << (8 - w["nbits"])
        push(w["bytes"], w["cur"])
        w["cur"] = 0
        w["nbits"] = 0
    w["bytes"]

// The total number of bits written so far (across completed bytes plus the partial one).
fn bw_bitcount(w: dict) -> int
    len(w["bytes"]) * 8 + w["nbits"]

// A new bit reader over a list of bytes (integers 0..255).
fn br_new(bytes: list) -> dict
    let r = {}
    r["bytes"] = bytes
    r["pos"] = 0
    r

// Read the next `n` bits (most-significant first) and return them as an integer. Reads past the end yield 0 bits.
fn br_read_bits(r: dict, n: int) -> int
    let value = 0
    let bytes = r["bytes"]
    for i in 0..n
        let pos = r["pos"]
        let bytepos = pos / 8
        let bitpos = 7 - (pos % 8)
        let bit = 0
        if bytepos < len(bytes)
            bit = (bytes[bytepos] >> bitpos) & 1
        value = (value << 1) | bit
        r["pos"] = pos + 1
    value

// How many bits remain unread in the stream.
fn br_remaining(r: dict) -> int
    len(r["bytes"]) * 8 - r["pos"]
