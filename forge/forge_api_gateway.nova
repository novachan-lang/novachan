// forge_api_gateway — API gateway / reverse proxy configuration.
// Route matching, load balancing, rate limiting config, circuit breaker.
// Pure data — composes with forge HTTP server.

fn gw_new(name: string) -> dict
    let gw = {}
    gw["name"] = name
    gw["routes"] = []
    gw["upstreams"] = {}
    gw["middleware"] = []
    gw

fn gw_add_upstream(gw: dict, name: string, targets: list) -> dict
    let upstream = {}
    upstream["targets"] = targets
    upstream["strategy"] = "round_robin"
    upstream["health_check"] = "/health"
    upstream["index"] = 0
    gw["upstreams"][name] = upstream
    gw

fn gw_add_route(gw: dict, path: string, upstream_name: string) -> dict
    let route = {}
    route["path"] = path
    route["upstream"] = upstream_name
    route["methods"] = ["GET", "POST", "PUT", "DELETE"]
    route["strip_prefix"] = false
    route["timeout_ms"] = 30000
    push(gw["routes"], route)
    gw

fn gw_add_route_methods(gw: dict, path: string, upstream_name: string, methods: list) -> dict
    let route = {}
    route["path"] = path
    route["upstream"] = upstream_name
    route["methods"] = methods
    route["strip_prefix"] = false
    route["timeout_ms"] = 30000
    push(gw["routes"], route)
    gw

fn gw_set_strip_prefix(gw: dict, path: string, strip: bool) -> dict
    let i = 0
    while i < len(gw["routes"])
        if gw["routes"][i]["path"] == path
            gw["routes"][i]["strip_prefix"] = strip
        i += 1
    gw

fn gw_set_timeout(gw: dict, path: string, timeout_ms: int) -> dict
    let i = 0
    while i < len(gw["routes"])
        if gw["routes"][i]["path"] == path
            gw["routes"][i]["timeout_ms"] = timeout_ms
        i += 1
    gw

fn gw_match_route(gw: dict, path: string, method: string) -> dict
    let i = 0
    while i < len(gw["routes"])
        let r = gw["routes"][i]
        if starts_with(path, r["path"])
            let j = 0
            while j < len(r["methods"])
                if r["methods"][j] == method
                    return r
                j += 1
        i += 1
    let none = {}
    none["path"] = ""
    none["upstream"] = ""
    none

fn gw_next_target(gw: dict, upstream_name: string) -> string
    if not contains(gw["upstreams"], upstream_name)
        return ""
    let up = gw["upstreams"][upstream_name]
    let targets = up["targets"]
    if len(targets) == 0
        return ""
    let idx = up["index"] % len(targets)
    up["index"] = up["index"] + 1
    gw["upstreams"][upstream_name] = up
    targets[idx]

fn gw_add_middleware(gw: dict, name: string) -> dict
    push(gw["middleware"], name)
    gw

fn gw_describe(gw: dict) -> string
    let s = "Gateway: " + gw["name"] + "\n"
    s += "Routes: " + str(len(gw["routes"])) + "\n"
    s += "Upstreams: " + str(len(keys(gw["upstreams"]))) + "\n"
    let i = 0
    while i < len(gw["routes"])
        let r = gw["routes"][i]
        s += "  " + r["path"] + " -> " + r["upstream"] + "\n"
        i += 1
    s
