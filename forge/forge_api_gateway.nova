// forge_api_gateway -- API gateway / reverse proxy configuration: route matching, load balancing,
// middleware. Pure data -- composes with forge HTTP server. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. gw_new / gw_add_upstream / gw_add_route / gw_add_route_methods each built a dict as 4-6
//      individual assignments. Dict literals.
//   2. gw_match_route had a NESTED while loop to check method membership (`while j < len(methods);
//      if methods[j] == method`). That is `method in r["methods"]`.
//   3. gw_set_strip_prefix / gw_set_timeout used `while i < len(...); i += 1` to iterate routes.
//      for-in over a range.
//   4. gw_next_target used `not contains(...)`. `not in`.
//   5. gw_describe built the output by five concat operations per line. Interpolation + for-in.

fn gw_new(name: string) -> dict
    {"name": name, "routes": [], "upstreams": {}, "middleware": []}

fn gw_add_upstream(gw: dict, name: string, targets: list) -> dict
    gw["upstreams"][name] = {"targets": targets, "strategy": "round_robin", "health_check": "/health", "index": 0}
    gw

fn gw_add_route(gw: dict, path: string, upstream_name: string) -> dict
    push(gw["routes"], {"path": path, "upstream": upstream_name, "methods": ["GET", "POST", "PUT", "DELETE"], "strip_prefix": false, "timeout_ms": 30000})
    gw

fn gw_add_route_methods(gw: dict, path: string, upstream_name: string, methods: list) -> dict
    push(gw["routes"], {"path": path, "upstream": upstream_name, "methods": methods, "strip_prefix": false, "timeout_ms": 30000})
    gw

fn gw_set_strip_prefix(gw: dict, path: string, strip: bool) -> dict
    for i in 0..len(gw["routes"])
        if gw["routes"][i]["path"] == path
            gw["routes"][i]["strip_prefix"] = strip
    gw

fn gw_set_timeout(gw: dict, path: string, timeout_ms: int) -> dict
    for i in 0..len(gw["routes"])
        if gw["routes"][i]["path"] == path
            gw["routes"][i]["timeout_ms"] = timeout_ms
    gw

fn gw_match_route(gw: dict, path: string, method: string) -> dict
    for r in gw["routes"]
        if starts_with(path, str(r["path"])) and method in r["methods"]
            return r
    {"path": "", "upstream": ""}

fn gw_next_target(gw: dict, upstream_name: string) -> string
    if upstream_name not in gw["upstreams"]
        return ""
    let up = gw["upstreams"][upstream_name]
    let targets = up["targets"]
    if len(targets) == 0
        return ""
    let idx = up["index"] % len(targets)
    up["index"] += 1
    gw["upstreams"][upstream_name] = up
    targets[idx]

fn gw_add_middleware(gw: dict, name: string) -> dict
    push(gw["middleware"], name)
    gw

fn gw_describe(gw: dict) -> string
    let name = str(gw["name"])
    let nr = len(gw["routes"])
    let nu = len(keys(gw["upstreams"]))
    let s = "Gateway: {name}\nRoutes: {nr}\nUpstreams: {nu}\n"
    for r in gw["routes"]
        let rp = str(r["path"])
        let ru = str(r["upstream"])
        s += "  {rp} -> {ru}\n"
    s
