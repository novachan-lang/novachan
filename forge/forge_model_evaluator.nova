// forge_model_evaluator — ML model evaluation metrics (accuracy, per-class, confusion).
//
// NOTE: forge_metric_exporter.nova already ships a `me_*` API for a different purpose
// (counters/gauges for observability). To avoid a function-name collision in the flat
// module namespace (me_new/me_counter_count would otherwise clash with different
// signatures), this module uses the `mev_*` prefix (Model EValuator).
//
// Per-class stats (mev_class_count/mev_class_correct/mev_class_accuracy) are recall-
// style: keyed on the ACTUAL (ground-truth) label, i.e. "of the times this class truly
// occurred, how many were predicted correctly" — the standard per-class accuracy
// definition. mev_class_list reports every label seen on EITHER side (predicted or
// actual), so a class the model hallucinates but that never occurs in ground truth
// still shows up (with class_count 0).

fn mev_new() -> dict
    let s = {}
    s["total"] = 0
    s["correct"] = 0
    s["classes"] = {}
    s["class_count"] = 0
    s["class_names"] = ""
    s["confusion"] = {}
    s

fn _mev_touch_class(state: dict, class_name: string) -> dict
    let has = contains(state["classes"], class_name + "_seen")
    if has != true
        state["classes"][class_name + "_seen"] = 1
        state["classes"][class_name + "_count"] = 0
        state["classes"][class_name + "_correct"] = 0
        state["class_count"] = state["class_count"] + 1
        if state["class_names"] == ""
            state["class_names"] = class_name
        else
            state["class_names"] = state["class_names"] + "," + class_name
    state

fn mev_record(state: dict, predicted: string, actual: string) -> dict
    state["total"] = state["total"] + 1
    state = _mev_touch_class(state, predicted)
    state = _mev_touch_class(state, actual)
    state["classes"][actual + "_count"] = state["classes"][actual + "_count"] + 1
    if predicted == actual
        state["correct"] = state["correct"] + 1
        state["classes"][actual + "_correct"] = state["classes"][actual + "_correct"] + 1
    let ck = predicted + "|" + actual
    let has_c = contains(state["confusion"], ck)
    if has_c != true
        state["confusion"][ck] = 0
    state["confusion"][ck] = state["confusion"][ck] + 1
    state

fn mev_total(state: dict) -> int
    state["total"]

fn mev_correct(state: dict) -> int
    state["correct"]

fn mev_accuracy(state: dict) -> Result
    if state["total"] == 0
        return err("no predictions recorded yet")
    ok(state["correct"] * 100 / state["total"])

fn mev_class_count(state: dict, class_name: string) -> int
    let has = contains(state["classes"], class_name + "_seen")
    if has != true
        return 0
    state["classes"][class_name + "_count"]

fn mev_class_correct(state: dict, class_name: string) -> int
    let has = contains(state["classes"], class_name + "_seen")
    if has != true
        return 0
    state["classes"][class_name + "_correct"]

fn mev_class_accuracy(state: dict, class_name: string) -> Result
    let has = contains(state["classes"], class_name + "_seen")
    if has != true
        return err("unknown class: " + class_name)
    let total = state["classes"][class_name + "_count"]
    if total == 0
        return err("no ground-truth instances for class: " + class_name)
    ok(state["classes"][class_name + "_correct"] * 100 / total)

fn mev_confusion(state: dict, predicted: string, actual: string) -> Result
    let ck = predicted + "|" + actual
    let has = contains(state["confusion"], ck)
    if has != true
        return ok(0)
    ok(state["confusion"][ck])

fn mev_class_list(state: dict) -> string
    state["class_names"]
