// forge_oauth_pkce -- OAuth 2.0 PKCE (RFC 7636), the "Proof Key for Code Exchange" that secures the
// authorization-code flow for PUBLIC clients (SPAs, mobile, CLI) which can't safely hold a client secret. The
// client mints a random code_verifier, sends only its SHA-256 hash (code_challenge, method S256) with the auth
// request, then proves possession by presenting the verifier at token exchange -- so a stolen authorization
// code is useless to an attacker. Composes forge_crypto (sha256_bytes + base64) + forge_qs (param encoding).
import forge_crypto
import forge_qs

// PRIVATE: standard base64 -> base64url (RFC 4648 §5): + -> - , / -> _ , drop '=' padding.
fn _b64url(s: string) -> string
    let out_parts = []
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == "+"
            push(out_parts, "-")
        else
            if c == "/"
                push(out_parts, "_")
            else
                if c != "="
                    push(out_parts, c)
    let out = join(out_parts, "")
    out

// A high-entropy code_verifier (RFC 7636 §4.1): base64url over `nbytes` CSPRNG bytes -> URL-safe, unbiased.
// nbytes=32 yields 256 bits (>= the 43-char minimum). Keep it secret until token exchange.
fn pkce_verifier(nbytes: int) -> string
    let b = secure_bytes(nbytes)
    let bl = [bytes_get(b, i) for i in 0..nbytes]
    _b64url(b64_encode_blist(bl))

// The S256 code_challenge for a verifier = base64url(SHA-256(ASCII(verifier))). Send with the auth request.
fn pkce_challenge(verifier: string) -> string
    let bytes = [ord(char_at(verifier, i)) for i in 0..len(verifier)]
    _b64url(b64_encode_blist(sha256_bytes(bytes)))

// Build the authorization-endpoint URL for the code+PKCE flow. `state` is the CSRF guard; scope is
// space-delimited; challenge comes from pkce_challenge. All user-supplied params are percent-encoded.
fn pkce_auth_url(authorize_endpoint: string, client_id: string, redirect_uri: string, scope: string, state: string, challenge: string) -> string
    let sep = "?"
    if find(authorize_endpoint, "?") >= 0
        sep = "&"
    authorize_endpoint + sep + "response_type=code&client_id=" + qs_encode(client_id) + "&redirect_uri=" + qs_encode(redirect_uri) + "&scope=" + qs_encode(scope) + "&state=" + qs_encode(state) + "&code_challenge=" + challenge + "&code_challenge_method=S256"

// Verify a returned `state` matches the one we sent (CSRF check at the redirect callback). Constant-length-ish.
fn pkce_state_ok(sent: string, got: string) -> bool
    sent == got and len(sent) > 0
