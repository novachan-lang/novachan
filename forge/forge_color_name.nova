// forge_color_name -- CSS named colors <-> hex. Turn a human color name ("crimson") into its hex ("#dc143c")
// and back, for theme config, CSS/SVG generation, and admin UIs where a designer types a name. Covers the 16
// original HTML colors plus the most-used extended CSS names. Names are lowercase. Companion to forge_color
// (which does hex<->rgb, HSL/HSV, WCAG contrast). LEAF -- imports NOTHING.

// PRIVATE: (name, hex) table as a list of [name, hex] pairs.
fn _cn_table() -> list
    [["black", "#000000"], ["white", "#ffffff"], ["red", "#ff0000"], ["lime", "#00ff00"], ["blue", "#0000ff"], ["yellow", "#ffff00"], ["cyan", "#00ffff"], ["aqua", "#00ffff"], ["magenta", "#ff00ff"], ["fuchsia", "#ff00ff"], ["silver", "#c0c0c0"], ["gray", "#808080"], ["grey", "#808080"], ["maroon", "#800000"], ["olive", "#808000"], ["green", "#008000"], ["purple", "#800080"], ["teal", "#008080"], ["navy", "#000080"], ["orange", "#ffa500"], ["pink", "#ffc0cb"], ["brown", "#a52a2a"], ["gold", "#ffd700"], ["indigo", "#4b0082"], ["violet", "#ee82ee"], ["coral", "#ff7f50"], ["salmon", "#fa8072"], ["khaki", "#f0e68c"], ["crimson", "#dc143c"], ["turquoise", "#40e0d0"], ["tomato", "#ff6347"], ["orchid", "#da70d6"], ["skyblue", "#87ceeb"], ["chocolate", "#d2691e"], ["tan", "#d2b48c"], ["beige", "#f5f5dc"], ["ivory", "#fffff0"], ["lavender", "#e6e6fa"]]

// The hex for a CSS color name (lowercased), or "" if unknown.
fn color_name_to_hex(name: string) -> string
    let want = lower(name)
    let t = _cn_table()
    for i in 0..len(t)
        if t[i][0] == want
            return t[i][1]
    ""

// The FIRST CSS name for a hex value (case-insensitive, accepts with/without leading '#'), or "" if none.
fn color_hex_to_name(hex: string) -> string
    let h = lower(hex)
    if not starts_with(h, "#")
        h = "#" + h
    let t = _cn_table()
    for i in 0..len(t)
        if t[i][1] == h
            return t[i][0]
    ""
