// forge_pipeline_executor — Multi-stage pipeline execution.

fn pe_new() -> dict
    {"stages": {}, "stage_count": 0, "current": 0, "status": "idle", "results": {}}

fn pe_add_stage(p: dict, name: string) -> dict
    let k = str(p["stage_count"])
    p["stages"]["{k}_name"] = name
    p["stages"]["{k}_status"] = "pending"
    p["stage_count"] += 1
    p

fn pe_start(p: dict) -> dict
    if p["stage_count"] == 0
        return p
    p["status"] = "running"
    p["current"] = 0
    p["stages"]["0_status"] = "running"
    p

fn pe_complete_stage(p: dict, result: string) -> dict
    let k = str(p["current"])
    p["stages"]["{k}_status"] = "done"
    p["results"][k] = result
    let next = p["current"] + 1
    if next >= p["stage_count"]
        p["status"] = "done"
        p["current"] = next
        return p
    p["current"] = next
    let nk = str(next)
    p["stages"]["{nk}_status"] = "running"
    p

fn pe_fail_stage(p: dict, reason: string) -> dict
    let k = str(p["current"])
    p["stages"]["{k}_status"] = "failed"
    p["results"][k] = reason
    p["status"] = "failed"
    p

fn pe_stage_name(p: dict, idx: int) -> string
    let k = str(idx)
    p["stages"]["{k}_name"]

fn pe_stage_status(p: dict, idx: int) -> string
    let k = str(idx)
    p["stages"]["{k}_status"]

fn pe_current_stage(p: dict) -> int
    p["current"]

fn pe_status(p: dict) -> string
    p["status"]

fn pe_stage_count(p: dict) -> int
    p["stage_count"]

fn pe_progress(p: dict) -> int
    if p["stage_count"] == 0
        return 100
    let done = 0
    for i in 0..p["stage_count"]
        let k = str(i)
        if p["stages"]["{k}_status"] == "done"
            done += 1
    done * 100 / p["stage_count"]
