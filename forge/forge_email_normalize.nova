// forge_email_normalize -- canonicalize an email for DEDUP + account matching, so alice@gmail.com,
// Alice@Gmail.com, a.l.i.c.e@gmail.com, and alice+promo@gmail.com all collapse to ONE account (prevents
// duplicate signups + abuse of plus-addressing). Always lowercases + strips a +tag; for Gmail/Googlemail also
// removes dots from the local part and unifies the domain to gmail.com. LEAF -- imports NOTHING.

fn _email_strip_dots(s: string) -> string
    join([char_at(s, i) for i in 0..len(s) if char_at(s, i) != "."], "")

// The canonical form of `email` for storage/lookup.
fn email_normalize(email: string) -> string
    let e = lower(trim(email))
    let at = find(e, "@")
    if at <= 0
        return e
    let local = slice(e, 0, at)
    let domain = slice(e, at + 1, len(e))
    let plus = find(local, "+")
    if plus >= 0
        local = slice(local, 0, plus)
    if domain == "gmail.com" or domain == "googlemail.com"
        local = _email_strip_dots(local)
        domain = "gmail.com"
    local + "@" + domain

// Do two emails resolve to the SAME account after normalization?
fn email_same(a: string, b: string) -> bool
    email_normalize(a) == email_normalize(b)
