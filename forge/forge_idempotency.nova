// forge_idempotency -- idempotency keys (Stripe "Idempotency-Key", PayPal, every serious payment API). A
// client that retries a POST after a network blip must NOT double-charge: the FIRST request under a key
// executes and its response is stored; a REPLAY of the same key returns the stored response instead of
// re-executing. The pending state also guards the in-flight window so two concurrent retries don't both run.
// State is a dict (in production: back it with Redis/DB via the same begin/complete calls). LEAF.

fn idem_new() -> dict
    {"entries": {}}

// Claim a key. Returns true if THIS caller owns it and should execute; false if the key was already seen
// (a completed response exists, or another attempt is in flight -> the caller should replay/return 409).
fn idem_begin(store: dict, key: string) -> bool
    let e = store["entries"]
    if key in e
        return false
    e[key] = ["pending", ""]
    true

// Record the finished response for a key (call once execution succeeds). Fluent.
fn idem_complete(store: dict, key: string, response: string) -> dict
    let e = store["entries"]
    e[key] = ["done", response]
    store

// Has a key completed (a stored response is available to replay)?
fn idem_done(store: dict, key: string) -> bool
    let e = store["entries"]
    if key not in e
        return false
    let rec = e[key]
    rec[0] == "done"

// The stored response for a completed key ("" if unknown or still pending).
fn idem_response(store: dict, key: string) -> string
    let e = store["entries"]
    if key not in e
        return ""
    let rec = e[key]
    if rec[0] == "done"
        return rec[1]
    ""

// Abandon a key that failed to complete (frees it so a genuine retry can execute). Fluent.
fn idem_release(store: dict, key: string) -> dict
    let e = store["entries"]
    if key in e
        let rec = e[key]
        if rec[0] == "pending"
            e[key] = ["gone", ""]
    store
