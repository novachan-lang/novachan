// forge_xml -- a small XML serializer (dict->child elements, list-><item>s, scalars esc'd)
// for SOAP/RSS/sitemap/legacy content negotiation; XML declaration in xml_document;
// attributes via xml_attr_element. Text + attribute values are esc()'d (injection-safe).
// "Verified by reasoning":
//   xml_element("user", {name:"ada", age:30}) -> "<user><name>ada</name><age>30</age></user>"
import forge_html

// PRIVATE: serialize the CONTENT of a value (not wrapped in a tag).
//   dict  -> each key k becomes <k>content</k>; keys iterated in insertion order.
//   list  -> each item wrapped in <item>content</item>.
//   scalar -> esc(str(v)) so & < > are injection-safe.
fn _xml_value(v) -> string
    if type_of(v) == "dict"
        let out = ""
        for k in keys(v)
            out += "<" + k + ">" + _xml_value(v[k]) + "</" + k + ">"
        return out
    if type_of(v) == "list"
        let out = ""
        for i in 0..len(v)
            out += "<item>" + _xml_value(v[i]) + "</item>"
        return out
    esc(str(v))

// Wrap a value in a named element: <tag>content</tag>.
// The content is produced by _xml_value, so nested dicts/lists recurse naturally.
fn xml_element(tag: string, v) -> string
    "<" + tag + ">" + _xml_value(v) + "</" + tag + ">"

// Return a full XML document: the XML 1.0/UTF-8 declaration followed by a root element.
// The declaration uses chr(34) for the required double-quotes around attribute values.
fn xml_document(root: string, v) -> string
    let q = chr(34)
    let decl = "<?xml version=" + q + "1.0" + q + " encoding=" + q + "UTF-8" + q + "?>"
    decl + xml_element(root, v)

// PRIVATE: build an attribute string from a dict of name->value pairs.
// Attribute values are single-quoted (XML allows this) and esc()'d against injection.
fn _xml_attrs(attrs: dict) -> string
    let out_parts = []
    for k in keys(attrs)
        let v = str(attrs[k])
        push(out_parts, " " + k + "=" + chr(39) + esc(v) + chr(39))
    let out = join(out_parts, "")
    out

// Like xml_element but with attributes on the opening tag.
// attrs is a {name:value} dict; values are esc()'d and single-quoted.
// Example: xml_attr_element("item", {id:"5"}, "hello") -> "<item id='5'>hello</item>"
fn xml_attr_element(tag: string, attrs: dict, v) -> string
    "<" + tag + _xml_attrs(attrs) + ">" + _xml_value(v) + "</" + tag + ">"
