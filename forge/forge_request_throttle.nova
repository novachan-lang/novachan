// forge_request_throttle — Per-client request throttling.

fn rt_new(max_per_window: int, window_ms: int) -> dict
    {"max": max_per_window, "window": window_ms, "clients": {}, "client_ts": {}, "total_allowed": 0, "total_denied": 0}

fn rt_request(t: dict, client: string, timestamp: int) -> dict
    let result = {}
    if client not in t["clients"]
        t["clients"][client] = 1
        t["client_ts"][client] = timestamp
        t["total_allowed"] += 1
        result["allowed"] = 1
        result["t"] = t
        return result
    let last_ts = t["client_ts"][client]
    let elapsed = timestamp - last_ts
    if elapsed >= t["window"]
        t["clients"][client] = 1
        t["client_ts"][client] = timestamp
        t["total_allowed"] += 1
        result["allowed"] = 1
        result["t"] = t
        return result
    let count = t["clients"][client]
    if count >= t["max"]
        t["total_denied"] += 1
        result["allowed"] = 0
        result["t"] = t
        return result
    t["clients"][client] = count + 1
    t["total_allowed"] += 1
    result["allowed"] = 1
    result["t"] = t
    result

fn rt_reset_client(t: dict, client: string) -> dict
    t["clients"][client] = 0
    t

fn rt_deny_rate(t: dict) -> int
    let total = t["total_allowed"] + t["total_denied"]
    if total == 0
        return 0
    t["total_denied"] * 100 / total

fn rt_client_usage(t: dict, client: string) -> int
    if client not in t["clients"]
        return 0
    t["clients"][client]
