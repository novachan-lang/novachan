// forge_state_machine -- thin wrapper over std/automata/state_machine (canonical implementation).
import std/automata/state_machine

fn fsm_new(initial: string) -> dict
    return fsm_new(initial)

fn fsm_add_transition(m: dict, from: string, event: string, to: string) -> dict
    return fsm_add_transition(m, from, event, to)

fn fsm_send(m: dict, event: string) -> Result
    return fsm_send(m, event)

fn fsm_current(m: dict) -> string
    m["current"]

fn fsm_can_send(m: dict, event: string) -> int
    return fsm_can_send(m, event)

fn fsm_total_transitions(m: dict) -> int
    m["total_transitions"]

fn fsm_transition_count(m: dict) -> int
    m["transition_count"]

