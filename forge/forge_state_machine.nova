// forge_state_machine — finite state machine with Result API.

fn fsm_new(initial: string) -> dict
    let m = {}
    m["current"] = initial
    m["transitions"] = {}
    m["transition_count"] = 0
    m["history_count"] = 0
    m["total_transitions"] = 0
    m

fn fsm_add_transition(m: dict, from: string, event: string, to: string) -> dict
    let key = "tr_" + from + "_" + event
    m["transitions"][key] = to
    m["transition_count"] = m["transition_count"] + 1
    m

fn fsm_send(m: dict, event: string) -> Result
    let key = "tr_" + m["current"] + "_" + event
    let has = contains(m["transitions"], key)
    if has != true
        return err("no transition from " + m["current"] + " on " + event)
    let prev = m["current"]
    m["current"] = m["transitions"][key]
    let hk = "hist_" + str(m["history_count"])
    m["transitions"][hk] = prev + "->" + m["current"]
    m["history_count"] = m["history_count"] + 1
    m["total_transitions"] = m["total_transitions"] + 1
    ok(m)

fn fsm_current(m: dict) -> string
    m["current"]

fn fsm_can_send(m: dict, event: string) -> int
    let key = "tr_" + m["current"] + "_" + event
    let has = contains(m["transitions"], key)
    if has == true
        return 1
    0

fn fsm_total_transitions(m: dict) -> int
    m["total_transitions"]

fn fsm_transition_count(m: dict) -> int
    m["transition_count"]
