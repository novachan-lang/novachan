// forge_state_machine — finite state machine with Result API.

fn fsm_new(initial: string) -> dict
    {"current": initial, "transitions": {}, "transition_count": 0, "history_count": 0, "total_transitions": 0}

fn fsm_add_transition(m: dict, from: string, event: string, to: string) -> dict
    let key = "tr_{from}_{event}"
    m["transitions"][key] = to
    m["transition_count"] += 1
    m

fn fsm_send(m: dict, event: string) -> Result
    let cur = m["current"]
    let key = "tr_{cur}_{event}"
    if key not in m["transitions"]
        return err("no transition from {cur} on {event}")
    let prev = cur
    m["current"] = m["transitions"][key]
    let hc = m["history_count"]
    let hk = "hist_{hc}"
    let newcur = m["current"]
    m["transitions"][hk] = "{prev}->{newcur}"
    m["history_count"] += 1
    m["total_transitions"] += 1
    ok(m)

fn fsm_current(m: dict) -> string
    m["current"]

fn fsm_can_send(m: dict, event: string) -> int
    let cur = m["current"]
    let key = "tr_{cur}_{event}"
    if key in m["transitions"]
        return 1
    0

fn fsm_total_transitions(m: dict) -> int
    m["total_transitions"]

fn fsm_transition_count(m: dict) -> int
    m["transition_count"]
