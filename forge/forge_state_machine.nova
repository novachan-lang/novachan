// forge_state_machine — Finite state machine.
// Define states, transitions, guards. Advance through transitions.

fn fsm_new(initial: string) -> dict
    let sm = {}
    sm["current"] = initial
    sm["transitions"] = []
    sm["history"] = []
    push(sm["history"], initial)
    sm

fn fsm_add_transition(sm: dict, from_state: string, event: string, to_state: string) -> dict
    let t = {}
    t["from"] = from_state
    t["event"] = event
    t["to"] = to_state
    push(sm["transitions"], t)
    sm

fn fsm_send(sm: dict, event: string) -> dict
    let i = 0
    while i < len(sm["transitions"])
        let t = sm["transitions"][i]
        if t["from"] == sm["current"]
            if t["event"] == event
                sm["current"] = t["to"]
                push(sm["history"], t["to"])
                return sm
        i = i + 1
    sm

fn fsm_current(sm: dict) -> string
    sm["current"]

fn fsm_can_send(sm: dict, event: string) -> int
    let i = 0
    while i < len(sm["transitions"])
        let t = sm["transitions"][i]
        if t["from"] == sm["current"]
            if t["event"] == event
                return 1
        i = i + 1
    0

fn fsm_history(sm: dict) -> list
    sm["history"]

fn fsm_history_count(sm: dict) -> int
    len(sm["history"])

fn fsm_available_events(sm: dict) -> list
    let events = []
    let i = 0
    while i < len(sm["transitions"])
        let t = sm["transitions"][i]
        if t["from"] == sm["current"]
            push(events, t["event"])
        i = i + 1
    events

fn fsm_reset(sm: dict) -> dict
    let first = sm["history"][0]
    sm["current"] = first
    sm["history"] = []
    push(sm["history"], first)
    sm

fn fsm_transition_count(sm: dict) -> int
    len(sm["transitions"])
