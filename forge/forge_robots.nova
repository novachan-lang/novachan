// forge_robots -- robots.txt generation: control which paths search engines + bots may crawl (User-agent
// groups with Allow/Disallow, Crawl-delay, and a Sitemap pointer). Serve the rendered body at /robots.txt.
// Pairs with forge_sitemap. LEAF -- imports NOTHING.

fn robots_new() -> dict
    let r = {}
    r["lines"] = []
    r

// Start a User-agent group ("*" = all bots). Fluent -- follow with allow/disallow.
fn robots_agent(r: dict, agent: string) -> dict
    push(r["lines"], "User-agent: " + agent)
    r

fn robots_allow(r: dict, path: string) -> dict
    push(r["lines"], "Allow: " + path)
    r

fn robots_disallow(r: dict, path: string) -> dict
    push(r["lines"], "Disallow: " + path)
    r

fn robots_crawl_delay(r: dict, seconds: int) -> dict
    push(r["lines"], "Crawl-delay: " + str(seconds))
    r

fn robots_sitemap(r: dict, url: string) -> dict
    push(r["lines"], "Sitemap: " + url)
    r

// Render the robots.txt body.
fn robots_render(r: dict) -> string
    let nl = chr(10)
    let out = ""
    let lines = r["lines"]
    let i = 0
    while i < len(lines)
        out = out + lines[i] + nl
        i = i + 1
    out
