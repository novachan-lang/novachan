// forge_karatsuba -- Karatsuba fast big-integer multiplication (O(n^1.585) vs schoolbook O(n^2)).
// forge_bignum.big_mul multiplies two arbitrary-length decimal-string integers with the grade-school
// O(n^2) algorithm. Karatsuba (1960, the first sub-quadratic multiplication algorithm ever discovered,
// and the one that disproved Kolmogorov's conjecture that O(n^2) was optimal) cuts the work using an
// algebraic trick: to multiply two 2m-digit numbers x = a*B + b and y = c*B + d (splitting each in half
// at base B = 10^m), instead of the FOUR products ac, ad, bc, bd it computes only THREE:
//     z2 = a*c
//     z0 = b*d
//     z1 = (a+b)*(c+d) - z2 - z0     (this equals ad + bc, recovered from one multiply)
//   result = z2*B^2 + z1*B + z0
// Recursing, the recurrence T(n) = 3*T(n/2) + O(n) solves to O(n^log2(3)) = O(n^1.585). For thousands of
// digits (RSA keys, pi computation, factorials, cryptographic moduli) this is dramatically faster than
// schoolbook. Below a small cutoff we fall back to grade-school (recursion overhead dominates for tiny n).
//
// Operates on the SAME non-negative decimal-string representation as forge_bignum, so it is a drop-in
// faster multiply. Returns the product as a normalized decimal string.
//
// API:
//   kmul(a, b) -> str          product of two non-negative decimal-string integers via Karatsuba
// LEAF (imports nothing).

// Strip leading zeros; empty/"" -> "0".
fn _kt_norm(s: str) -> str
    let n = len(s)
    let i = 0
    while i < n - 1 and char_at(s, i) == "0"
        i += 1
    if i == 0
        if n == 0
            return "0"
        return s
    return slice(s, i, n)

// Grade-school multiply (used below the Karatsuba cutoff). Non-negative decimal strings.
fn _kt_schoolbook(a0: str, b0: str) -> str
    let a = _kt_norm(a0)
    let b = _kt_norm(b0)
    if a == "0" or b == "0"
        return "0"
    let na = len(a)
    let nb = len(b)
    let res = [0 for z in 0..(na + nb)]
    let i = na - 1
    while i >= 0
        let da = ord(char_at(a, i)) - 48
        let carry = 0
        let j = nb - 1
        while j >= 0
            let db = ord(char_at(b, j)) - 48
            let pos = (na - 1 - i) + (nb - 1 - j)
            let cur = res[pos] + da * db + carry
            res[pos] = cur % 10
            carry = cur / 10
            j -= 1
        let pos2 = (na - 1 - i) + nb
        while carry > 0
            let cur2 = res[pos2] + carry
            res[pos2] = cur2 % 10
            carry = cur2 / 10
            pos2 += 1
        i -= 1
    let s_parts = []
    let k = len(res) - 1
    while k >= 0
        push(s_parts, chr(48 + res[k]))
        k -= 1
    let s = join(s_parts, "")
    return _kt_norm(s)

// Add two non-negative decimal strings.
fn _kt_add(a0: str, b0: str) -> str
    let a = _kt_norm(a0)
    let b = _kt_norm(b0)
    let i = len(a) - 1
    let j = len(b) - 1
    let carry = 0
    let out = ""
    while i >= 0 or j >= 0 or carry > 0
        let da = 0
        if i >= 0
            da = ord(char_at(a, i)) - 48
        let db = 0
        if j >= 0
            db = ord(char_at(b, j)) - 48
        let sum = da + db + carry
        out = chr(48 + sum % 10) + out
        carry = sum / 10
        i -= 1
        j -= 1
    return _kt_norm(out)

// Subtract b from a (a >= b >= 0). Non-negative decimal strings.
fn _kt_sub(a0: str, b0: str) -> str
    let a = _kt_norm(a0)
    let b = _kt_norm(b0)
    let i = len(a) - 1
    let j = len(b) - 1
    let borrow = 0
    let out = ""
    while i >= 0
        let da = ord(char_at(a, i)) - 48
        let db = 0
        if j >= 0
            db = ord(char_at(b, j)) - 48
        let diff = da - db - borrow
        if diff < 0
            diff += 10
            borrow = 1
        else
            borrow = 0
        out = chr(48 + diff) + out
        i -= 1
        j -= 1
    return _kt_norm(out)

// Multiply by 10^k (append k zeros). If the value is "0", stays "0".
fn _kt_shift(s0: str, k: int) -> str
    let s = _kt_norm(s0)
    if s == "0"
        return "0"
    let out = s
    for i in 0..k
        out += "0"
    return out

// Karatsuba multiply of two non-negative decimal strings.
fn kmul(a0: str, b0: str) -> str
    let a = _kt_norm(a0)
    let b = _kt_norm(b0)
    if a == "0" or b == "0"
        return "0"
    let na = len(a)
    let nb = len(b)
    // cutoff: use schoolbook for small operands
    if na <= 8 or nb <= 8
        return _kt_schoolbook(a, b)
    // split point m = half of the larger length
    let n = na
    if nb > n
        n = nb
    let m = n / 2
    // left-pad the shorter number conceptually by slicing from the right.
    // high = number without the last m digits; low = last m digits.
    let a_high = "0"
    let a_low = a
    if na > m
        a_high = slice(a, 0, na - m)
        a_low = slice(a, na - m, na)
    let b_high = "0"
    let b_low = b
    if nb > m
        b_high = slice(b, 0, nb - m)
        b_low = slice(b, nb - m, nb)
    let z2 = kmul(a_high, b_high)
    let z0 = kmul(a_low, b_low)
    let a_sum = _kt_add(a_high, a_low)
    let b_sum = _kt_add(b_high, b_low)
    let z1_full = kmul(a_sum, b_sum)
    let z1 = _kt_sub(_kt_sub(z1_full, z2), z0)
    // result = z2 * 10^(2m) + z1 * 10^m + z0
    let part1 = _kt_shift(z2, 2 * m)
    let part2 = _kt_shift(z1, m)
    let res = _kt_add(_kt_add(part1, part2), z0)
    return _kt_norm(res)
