// forge_vec2 -- 2D vector math: the everyday algebra of points, directions, velocities, and forces on a plane.
// forge_vec3 covers 3D; this is the 2D case that dominates UI layout, sprites and physics in a game, plotting,
// mouse/touch input, and any screen or map work. A vector is [x, y]. Add/subtract to move points and combine
// velocities, scale to speed up or shrink, dot for "how aligned / project onto", cross (a scalar in 2D) for
// turn direction and signed area, length/distance for magnitude and spacing, normalize for a pure direction,
// lerp to interpolate/animate between points, and perp for a right-angle turn. Magnitude functions use sqrt
// INLINE in the returning expression (dodges the float-return codegen edge). LEAF -- imports NOTHING.

// Sum of two vectors.
fn vec2_add(a: list, b: list) -> list
    [a[0] * 1.0 + b[0] * 1.0, a[1] * 1.0 + b[1] * 1.0]

// Difference a - b.
fn vec2_sub(a: list, b: list) -> list
    [a[0] * 1.0 - b[0] * 1.0, a[1] * 1.0 - b[1] * 1.0]

// Scale a vector by a scalar.
fn vec2_scale(a: list, s) -> list
    [a[0] * 1.0 * (s * 1.0), a[1] * 1.0 * (s * 1.0)]

// Negate a vector.
fn vec2_negate(a: list) -> list
    [-a[0] * 1.0, -a[1] * 1.0]

// Dot product a . b (0 = perpendicular, positive = same-ish direction).
fn vec2_dot(a: list, b: list) -> float
    let d = a[0] * 1.0 * (b[0] * 1.0) + a[1] * 1.0 * (b[1] * 1.0)
    d

// 2D cross product (a scalar): a.x*b.y - a.y*b.x. Sign gives turn direction; magnitude = parallelogram area.
fn vec2_cross(a: list, b: list) -> float
    let c = a[0] * 1.0 * (b[1] * 1.0) - a[1] * 1.0 * (b[0] * 1.0)
    c

// Squared length x^2 + y^2 (no sqrt -- cheaper, exact; use it when you only need to compare magnitudes).
fn vec2_length_sq(a: list) -> float
    let l = a[0] * 1.0 * (a[0] * 1.0) + a[1] * 1.0 * (a[1] * 1.0)
    l

// Euclidean length (magnitude) of a vector.
fn vec2_length(a: list) -> float
    sqrt(a[0] * 1.0 * (a[0] * 1.0) + a[1] * 1.0 * (a[1] * 1.0))

// Distance between two points.
fn vec2_distance(a: list, b: list) -> float
    let dx = a[0] * 1.0 - b[0] * 1.0
    let dy = a[1] * 1.0 - b[1] * 1.0
    sqrt(dx * dx + dy * dy)

// Unit vector in the direction of a (a zero vector stays zero).
fn vec2_normalize(a: list) -> list
    let lsq = a[0] * 1.0 * (a[0] * 1.0) + a[1] * 1.0 * (a[1] * 1.0)
    let out = [0.0, 0.0]
    if lsq > 0.0
        out = [a[0] * 1.0 / sqrt(lsq), a[1] * 1.0 / sqrt(lsq)]
    out

// Linear interpolation from a to b by t in [0,1] (t=0 -> a, t=1 -> b).
fn vec2_lerp(a: list, b: list, t) -> list
    let tf = t * 1.0
    [a[0] * 1.0 + (b[0] * 1.0 - a[0] * 1.0) * tf, a[1] * 1.0 + (b[1] * 1.0 - a[1] * 1.0) * tf]

// A vector rotated 90 degrees counter-clockwise: [-y, x].
fn vec2_perp(a: list) -> list
    [-a[1] * 1.0, a[0] * 1.0]
