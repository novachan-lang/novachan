// forge_ratelimit_headers -- standard rate-limit response headers (draft-ietf-httpapi-ratelimit-headers + the
// de-facto X-RateLimit-*). Turn a limiter's remaining/reset into the headers a well-behaved client uses to back
// off. Pairs with forge_ratewin / forge_sliding (or any limiter yielding remaining + reset). LEAF.

// Header dict for a decision: `limit` = the quota, `remaining` = calls left, `reset_epoch` = unix-seconds when
// the window resets, `now_epoch` = current unix-seconds (for the Retry-After delta). Retry-After is added only
// when `blocked` (the request was rejected).
fn ratelimit_headers(limit: int, remaining: int, reset_epoch: int, now_epoch: int, blocked: bool) -> dict
    let h = {}
    h["X-RateLimit-Limit"] = str(limit)
    let rem = remaining
    if rem < 0
        rem = 0
    h["X-RateLimit-Remaining"] = str(rem)
    h["X-RateLimit-Reset"] = str(reset_epoch)
    if blocked
        let after = reset_epoch - now_epoch
        if after < 0
            after = 0
        h["Retry-After"] = str(after)
    h
