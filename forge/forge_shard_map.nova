// forge_shard_map — key-to-shard assignment with Result API.

fn sm_new(shard_count: int) -> dict
    let s = {}
    s["shard_count"] = shard_count
    s["assignments"] = {}
    s["key_count"] = 0
    s["lookups"] = 0
    s

fn sm_assign(s: dict, key: string) -> dict
    let hv = hash(key)
    if hv < 0
        hv = 0 - hv
    let shard = hv - (hv / s["shard_count"]) * s["shard_count"]
    s["assignments"]["k_" + key] = shard
    s["key_count"] = s["key_count"] + 1
    s

fn sm_get_shard(s: dict, key: string) -> Result
    s["lookups"] = s["lookups"] + 1
    let ak = "k_" + key
    if contains(s["assignments"], ak) != true
        return err("key not assigned: " + key)
    ok(s["assignments"][ak])

fn sm_shard_for(s: dict, key: string) -> int
    let hv = hash(key)
    if hv < 0
        hv = 0 - hv
    hv - (hv / s["shard_count"]) * s["shard_count"]

fn sm_key_count(s: dict) -> int
    s["key_count"]

fn sm_shard_count(s: dict) -> int
    s["shard_count"]

fn sm_total_lookups(s: dict) -> int
    s["lookups"]
