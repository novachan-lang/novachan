// forge_text -- content-rendering helpers: word-boundary truncate/excerpt with an ellipsis, word count,
// estimated reading time, and search-term highlighting. The bits every blog/CMS/search-results view re-writes.
// LEAF -- imports NOTHING.

fn _last_space(s: string) -> int
    let idx = -1
    for i in 0..len(s)
        if char_at(s, i) == " "
            idx = i
    idx

// Truncate to at most `max` chars, backing up to the last word boundary and appending "..." (unchanged if it
// already fits).
fn truncate_words(text: string, max: int) -> string
    if len(text) <= max
        return text
    let cut = slice(text, 0, max)
    let sp = _last_space(cut)
    if sp > 0
        cut = slice(cut, 0, sp)
    cut + "..."

// Whitespace-separated word count.
fn word_count(text: string) -> int
    let n = 0
    let in_word = false
    for i in 0..len(text)
        let c = char_at(text, i)
        if c == " " or c == chr(10) or c == chr(9) or c == chr(13)
            in_word = false
        else
            if in_word == false
                n += 1
                in_word = true
    n

// Estimated reading time in whole MINUTES (rounded up) at `wpm` words/minute (200 typical).
fn reading_time(text: string, wpm: int) -> int
    if wpm <= 0
        return 0
    (word_count(text) + wpm - 1) / wpm

// Plain-prose excerpt (word-boundary truncation).
fn excerpt(text: string, max: int) -> string
    truncate_words(text, max)

// Wrap every case-insensitive occurrence of `term` with <mark>...</mark>, preserving each match's original
// casing (search-result highlighting). Empty term -> unchanged.
fn highlight(text: string, term: string) -> string
    if len(term) == 0
        return text
    let lt = lower(text)
    let lterm = lower(term)
    let tl = len(term)
    let out = ""
    let i = 0
    let n = len(text)
    while i < n
        if i + tl <= n and slice(lt, i, i + tl) == lterm
            out += "<mark>" + slice(text, i, i + tl) + "</mark>"
            i += tl
        else
            out += char_at(text, i)
            i += 1
    out

// The number of sentences, counting runs of ending punctuation (. ! ?) as one boundary each. Trailing text without
// terminal punctuation still counts as a sentence.
fn sentence_count(text: string) -> int
    let count = 0
    let in_sentence = false
    for i in 0..len(text)
        let c = char_at(text, i)
        if c == "." or c == "!" or c == "?"
            if in_sentence
                count += 1
                in_sentence = false
        else
            if c != " "
                in_sentence = true
    if in_sentence
        count += 1
    count

// The number of characters, optionally excluding spaces. char_count("a b", false) = 3, char_count("a b", true) = 2.
fn char_count(text: string, exclude_spaces: bool) -> int
    let out = len(text)
    if exclude_spaces
        out = 0
        for i in 0..len(text)
            if char_at(text, i) != " "
                out += 1
    out

// The longest whitespace-separated word (the first one, on ties), or "" for empty/space-only text.
fn longest_word(text: string) -> string
    let best = ""
    let cur = ""
    let i = 0
    while i <= len(text)
        let is_end = false
        if i == len(text)
            is_end = true
        else
            if char_at(text, i) == " "
                is_end = true
        if is_end
            if len(cur) > len(best)
                best = cur
            cur = ""
        else
            cur += char_at(text, i)
        i += 1
    best
