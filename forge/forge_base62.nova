// forge_base62 -- base62 encode/decode of non-negative integers (URL shorteners + short opaque ids: YouTube
// video ids, bit.ly codes, compact public ids that hide a sequential PK). 0-9 a-z A-Z = 62 symbols: far more
// compact than decimal/hex for the same value and fully URL-safe (no +, /, or = to escape).
//
// The radix conversion itself now lives ONCE in forge_radix, shared with base36 and base58. This module is
// its alphabet plus three thin entry points.
import forge_radix

fn _b62_alpha() -> string
    "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

// Encode a non-negative int to base62 (0 -> "0").
fn base62_encode(n: int) -> string
    radix_encode(n, _b62_alpha(), "0")

// Decode a base62 string back to an int (0 if any char is outside the alphabet).
// Contract UNCHANGED, including the ambiguity that 0 means both "decodes to zero" and "invalid input" --
// reach for base62_decode_checked when that distinction matters.
fn base62_decode(s: string) -> int
    unwrap_or(radix_decode_exact(s, _b62_alpha()), 0)

// Decode KEEPING the reason: ok(n), or err naming the offending character and its index.
fn base62_decode_checked(s: string) -> Result
    radix_decode_exact(s, _b62_alpha())
