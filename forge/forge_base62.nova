// forge_base62 -- base62 encode/decode of non-negative integers (URL shorteners + short opaque ids: YouTube
// video ids, bit.ly codes, compact public ids that hide a sequential PK). 0-9 a-z A-Z = 62 symbols: far more
// compact than decimal/hex for the same value and fully URL-safe (no +, /, or = to escape). LEAF.

fn _b62_alpha() -> string
    "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

// Encode a non-negative int to base62 (0 -> "0").
fn base62_encode(n: int) -> string
    if n <= 0
        return "0"
    let alpha = _b62_alpha()
    let v = n
    let out = ""
    while v > 0
        out = char_at(alpha, v % 62) + out
        v = v / 62
    out

// Decode a base62 string back to an int (0 if any char is outside the alphabet).
fn base62_decode(s: string) -> int
    let alpha = _b62_alpha()
    let v = 0
    for i in 0..len(s)
        let d = find(alpha, char_at(s, i))
        if d < 0
            return 0
        v = v * 62 + d
    v
