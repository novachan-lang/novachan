// forge_lfsr -- Galois linear-feedback shift registers, the tiny hardware-friendly engines that generate
// pseudo-random bit streams from a handful of XOR gates. An LFSR holds a register of bits and, each tick, shifts it
// and XORs a fixed set of "tap" positions back in; with the right taps an n-bit register cycles through EVERY one
// of its 2^n - 1 nonzero states before repeating (a "maximal-length" or m-sequence). That single property makes
// LFSRs the workhorse behind CRC checksums, data scramblers on Ethernet/SATA/PCIe/DVB, spread-spectrum and GPS
// gold codes, the whitening in flash/RF, cheap on-chip test-pattern generation (BIST), and the keystream cores of
// classic stream ciphers. This is the Galois form -- shift right, and when the bit shifted out is 1, XOR the whole
// register by the tap mask -- which is the fast, one-branch variant. lfsr_next advances one step, lfsr_bits pulls a
// stream, lfsr_period measures the cycle length, and lfsr_is_maximal certifies a tap mask gives the full 2^n - 1
// period. Taps are given as an integer bit mask; the seed must be nonzero (the all-zero state is a dead fixed
// point). Integers only. LEAF -- imports NOTHING.

// Advance a Galois LFSR one step: shift the register right by one, and if the bit that fell off was 1, XOR the
// register with the tap mask. Returns the new register state.
fn lfsr_next(state: int, taps: int) -> int
    let lsb = state & 1
    let s = state >> 1
    if lsb == 1
        s = s ^ taps
    s

// Pull `count` output bits from the LFSR seeded at `seed`: the bit shifted out (the current least-significant bit)
// on each of `count` successive steps, returned as a list of 0/1.
fn lfsr_bits(seed: int, taps: int, count: int) -> list
    let out = []
    let s = seed
    let i = 0
    while i < count
        push(out, s & 1)
        s = lfsr_next(s, taps)
        i = i + 1
    out

// The period of the LFSR from `seed`: the number of steps until the register first returns to `seed`, or -1 if it
// has not cycled back within `maxsteps` steps. For a maximal tap mask on an n-bit register this equals 2^n - 1.
fn lfsr_period(seed: int, taps: int, maxsteps: int) -> int
    let out = 0 - 1
    let s = lfsr_next(seed, taps)
    let count = 1
    while s != seed and count < maxsteps
        s = lfsr_next(s, taps)
        count = count + 1
    if s == seed
        out = count
    out

// True if `taps` is a maximal-length tap mask for an n = width bit register: starting from state 1 the register
// visits all 2^width - 1 nonzero states before repeating.
fn lfsr_is_maximal(taps: int, width: int) -> bool
    let full = (1 << width) - 1
    let p = lfsr_period(1, taps, full + 2)
    p == full
