// forge_convexhull -- the convex hull of a set of 2D points: the smallest convex polygon that encloses them all
// (imagine stretching a rubber band around a scatter of pins and letting it snap tight). It's a foundational
// computational-geometry primitive: the outline/footprint of a shape or GPS track, a coarse collision boundary
// for physics broad-phase, the extent of a cluster of points, "which points are on the outer edge", and the
// basis for shape metrics like diameter and area. Uses Andrew's monotone-chain algorithm: sort the points, then
// sweep a lower and an upper chain, dropping any point that would make a non-left turn. The only geometric test
// is the cross-product sign -- no square roots, so it's exact on integer coordinates and reliable on floats.
// Points are [x, y]. LEAF -- imports NOTHING.

// PRIVATE: 2D cross product (b-o) x (a... ) orientation of turn o->a->b. >0 left/CCW, <0 right/CW, 0 collinear.
fn _ch_cross(o: list, a: list, b: list) -> float
    let ox = o[0] * 1.0
    let oy = o[1] * 1.0
    let r = (a[0] * 1.0 - ox) * (b[1] * 1.0 - oy) - (a[1] * 1.0 - oy) * (b[0] * 1.0 - ox)
    r

// PRIVATE: does point pa sort AFTER pb by (x then y)?
fn _ch_gt(pa: list, pb: list) -> bool
    let ax = pa[0] * 1.0
    let bx = pb[0] * 1.0
    ax > bx or (ax == bx and (pa[1] * 1.0) > (pb[1] * 1.0))

// PRIVATE: build one monotone chain (lower or upper) by scanning `order` (a list of point indices) and popping
// any stacked point that would make a non-left turn against the incoming point.
fn _ch_chain(points: list, order: list) -> list
    let stack = []
    for oi in 0..len(order)
        let p = order[oi]
        while len(stack) >= 2 and _ch_cross(points[stack[len(stack) - 2]], points[stack[len(stack) - 1]], points[p]) <= 0.0
            pop(stack)
        push(stack, p)
    stack

// The convex hull of `points` as a list of [x, y] vertices in counter-clockwise order (collinear edge points
// are dropped). For < 3 points, returns the points themselves.
fn convex_hull(points: list) -> list
    let n = len(points)
    if n < 3
        return [[points[c][0], points[c][1]] for c in 0..n]
    // sort indices by (x, y)
    let idx = [z for z in 0..n]
    for a in 1..n
        let cur = idx[a]
        let b = a - 1
        while b >= 0 and _ch_gt(points[idx[b]], points[cur])
            idx[b + 1] = idx[b]
            b -= 1
        idx[b + 1] = cur
    // lower hull (index stack), then upper hull over the same indices in reverse order
    let lower = _ch_chain(points, idx)
    let rev_idx = [idx[n - 1 - k] for k in 0..n]
    let upper = _ch_chain(points, rev_idx)
    // concatenate, dropping the last point of each chain (shared endpoints)
    let hull = []
    for x in 0..(len(lower) - 1)
        push(hull, [points[lower[x]][0], points[lower[x]][1]])
    for y in 0..(len(upper) - 1)
        push(hull, [points[upper[y]][0], points[upper[y]][1]])
    hull

// The area enclosed by the convex hull (shoelace formula; no square roots).
fn hull_area(points: list) -> float
    let h = convex_hull(points)
    let n = len(h)
    let area2 = 0.0
    if n >= 3
        for i in 0..n
            let j = 0 if i + 1 == n else i + 1
            area2 += (h[i][0] * 1.0) * (h[j][1] * 1.0) - (h[j][0] * 1.0) * (h[i][1] * 1.0)
    abs(area2 / 2.0)

// The number of vertices on the hull.
fn hull_size(points: list) -> int
    len(convex_hull(points))
