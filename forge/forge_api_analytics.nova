// forge_api_analytics -- API usage analytics: track requests per endpoint, response times, error rates.
// Pure state, no I/O -- composes with any HTTP server. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. aa_new built the state dict as four individual assignments. Dict literal.
//   2. THE ENDPOINT KEY "GET /users" was constructed as `method + " " + path` at THREE sites -- one
//      typo ("+path" without the space) silently splits a single endpoint into two. _aa_key owns the
//      scheme.
//   3. `contains(analytics["endpoints"], key); if has_ep != true` -- `not in`.
//   4. Min/max latency were updated by hand-written if-compare-assign pairs. `min`/`max` builtins.
//   5. aa_top_endpoints used a HAND-ROLLED SELECTION SORT (O(n^2) with a swap loop). `sort_by` is
//      O(n log n) and states the intent ("sort these entries by count, descending").

fn aa_new() -> dict
    {"endpoints": {}, "total_requests": 0, "total_errors": 0}

// PRIVATE: the endpoint key, stated once. Three sites previously concatenated it.
fn _aa_key(method: string, path: string) -> string
    "{method} {path}"

fn aa_record(analytics: dict, method: string, path: string, status: int, latency_ms: int) -> dict
    let key = _aa_key(method, path)
    if key not in analytics["endpoints"]
        analytics["endpoints"][key] = {"count": 0, "errors": 0, "total_latency": 0, "min_latency": latency_ms, "max_latency": latency_ms}
    let ep = analytics["endpoints"][key]
    ep["count"] += 1
    ep["total_latency"] += latency_ms
    ep["min_latency"] = min(ep["min_latency"], latency_ms)
    ep["max_latency"] = max(ep["max_latency"], latency_ms)
    if status >= 400
        ep["errors"] += 1
        analytics["total_errors"] += 1
    analytics["total_requests"] += 1
    analytics["endpoints"][key] = ep
    analytics

fn aa_avg_latency(analytics: dict, method: string, path: string) -> int
    let key = _aa_key(method, path)
    if key not in analytics["endpoints"]
        return 0
    let ep = analytics["endpoints"][key]
    0 if ep["count"] == 0 else ep["total_latency"] / ep["count"]

fn aa_error_rate(analytics: dict, method: string, path: string) -> int
    let key = _aa_key(method, path)
    if key not in analytics["endpoints"]
        return 0
    let ep = analytics["endpoints"][key]
    0 if ep["count"] == 0 else (ep["errors"] * 100) / ep["count"]

fn aa_total_requests(analytics: dict) -> int
    analytics["total_requests"]

fn aa_total_errors(analytics: dict) -> int
    analytics["total_errors"]

fn aa_top_endpoints(analytics: dict) -> list
    let entries = [{"endpoint": k, "count": analytics["endpoints"][k]["count"]} for k in keys(analytics["endpoints"])]
    reverse(sort_by(entries, (e) => e["count"]))

fn aa_endpoint_count(analytics: dict) -> int
    len(keys(analytics["endpoints"]))
