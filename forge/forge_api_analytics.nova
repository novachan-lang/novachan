// forge_api_analytics — API usage analytics.
// Track requests per endpoint, response times, error rates.

fn aa_new() -> dict
    let a = {}
    a["endpoints"] = {}
    a["total_requests"] = 0
    a["total_errors"] = 0
    a

fn aa_record(analytics: dict, method: string, path: string, status: int, latency_ms: int) -> dict
    let key = method + " " + path
    let has_ep = contains(analytics["endpoints"], key)
    if has_ep != true
        let ep = {}
        ep["count"] = 0
        ep["errors"] = 0
        ep["total_latency"] = 0
        ep["min_latency"] = latency_ms
        ep["max_latency"] = latency_ms
        analytics["endpoints"][key] = ep
    let ep = analytics["endpoints"][key]
    ep["count"] = ep["count"] + 1
    ep["total_latency"] = ep["total_latency"] + latency_ms
    if latency_ms < ep["min_latency"]
        ep["min_latency"] = latency_ms
    if latency_ms > ep["max_latency"]
        ep["max_latency"] = latency_ms
    if status >= 400
        ep["errors"] = ep["errors"] + 1
        analytics["total_errors"] = analytics["total_errors"] + 1
    analytics["total_requests"] = analytics["total_requests"] + 1
    analytics["endpoints"][key] = ep
    analytics

fn aa_avg_latency(analytics: dict, method: string, path: string) -> int
    let key = method + " " + path
    let has_ep = contains(analytics["endpoints"], key)
    if has_ep != true
        return 0
    let ep = analytics["endpoints"][key]
    if ep["count"] == 0
        return 0
    ep["total_latency"] / ep["count"]

fn aa_error_rate(analytics: dict, method: string, path: string) -> int
    let key = method + " " + path
    let has_ep = contains(analytics["endpoints"], key)
    if has_ep != true
        return 0
    let ep = analytics["endpoints"][key]
    if ep["count"] == 0
        return 0
    (ep["errors"] * 100) / ep["count"]

fn aa_total_requests(analytics: dict) -> int
    analytics["total_requests"]

fn aa_total_errors(analytics: dict) -> int
    analytics["total_errors"]

fn aa_top_endpoints(analytics: dict) -> list
    let result = []
    let ks = keys(analytics["endpoints"])
    let i = 0
    while i < len(ks)
        let entry = {}
        entry["endpoint"] = ks[i]
        entry["count"] = analytics["endpoints"][ks[i]]["count"]
        push(result, entry)
        i = i + 1
    let s = 0
    while s < len(result)
        let j = s + 1
        while j < len(result)
            if result[j]["count"] > result[s]["count"]
                let tmp = result[s]
                result[s] = result[j]
                result[j] = tmp
            j = j + 1
        s = s + 1
    result

fn aa_endpoint_count(analytics: dict) -> int
    len(keys(analytics["endpoints"]))
