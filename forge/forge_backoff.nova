// forge_backoff -- retry backoff delay calculators (AWS "Exponential Backoff And Jitter"). Pure functions:
// given the attempt number, return the delay in ms. Exponential growth prevents hammering a recovering
// service; decorrelated jitter spreads a herd of retriers so they don't resynchronize. Pair with
// forge_aspects retried(). Deterministic (no hidden RNG) so tests are reproducible. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. backoff_exp used an early return + comparison for capping. `min` builtin.
//   2. backoff_linear used an if/return for capping. `min` builtin (one expression).
//   3. backoff_decorrelated used an if-swap for flooring + if/return for capping. `max` + `min` builtins.

fn backoff_exp(attempt: int, base_ms: int, cap_ms: int) -> int
    let d = base_ms
    for i in 0..attempt
        d = min(d * 2, cap_ms)
    d

fn backoff_linear(attempt: int, base_ms: int, cap_ms: int) -> int
    min(base_ms * (attempt + 1), cap_ms)

fn backoff_decorrelated(prev_ms: int, base_ms: int, cap_ms: int, rnd_0_99: int) -> int
    let hi = max(prev_ms * 3, base_ms)
    let span = hi - base_ms
    min(base_ms + (span * rnd_0_99) / 100, cap_ms)
