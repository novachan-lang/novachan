// forge_backoff -- retry backoff delay calculators (AWS "Exponential Backoff And Jitter"). Pure functions:
// given the attempt number, return the delay in ms. Exponential growth prevents hammering a recovering
// service; decorrelated jitter spreads a herd of retriers so they don't resynchronize. Pair with
// forge_aspects retried(). Deterministic (no hidden RNG) so tests are reproducible. LEAF -- imports NOTHING.

// Exponential: base_ms * 2^attempt, capped at cap_ms. attempt 0 -> base_ms.
fn backoff_exp(attempt: int, base_ms: int, cap_ms: int) -> int
    let d = base_ms
    for i in 0..attempt
        d = d * 2
        if d >= cap_ms
            return cap_ms
    d

// Linear: base_ms * (attempt + 1), capped.
fn backoff_linear(attempt: int, base_ms: int, cap_ms: int) -> int
    let d = base_ms * (attempt + 1)
    if d > cap_ms
        return cap_ms
    d

// Decorrelated jitter (AWS): the next delay is placed in [base_ms, prev_ms*3], capped. The caller supplies
// rnd_0_99 (0..99) to position it -- feed a counter or a CSPRNG byte for real jitter, or a fixed value for a
// deterministic test. Reduces thundering-herd resynchronization better than pure exponential.
fn backoff_decorrelated(prev_ms: int, base_ms: int, cap_ms: int, rnd_0_99: int) -> int
    let hi = prev_ms * 3
    if hi < base_ms
        hi = base_ms
    let span = hi - base_ms
    let d = base_ms + (span * rnd_0_99) / 100
    if d > cap_ms
        return cap_ms
    d
