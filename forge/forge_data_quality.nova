// forge_data_quality — Data quality checks with Result.

fn dq_new() -> dict
    {"checks": {}, "check_count": 0, "runs": 0, "passes": 0, "failures": 0}

fn dq_add_check(d: dict, name: string, check_type: string, field: string) -> dict
    let k = str(d["check_count"])
    d["checks"][k + "_name"] = name
    d["checks"][k + "_type"] = check_type
    d["checks"][k + "_field"] = field
    d["check_count"] += 1
    d

fn dq_run_check(d: dict, idx: int, data: dict) -> Result
    if idx >= d["check_count"]
        return err("check index out of range")
    let k = str(idx)
    let ctype = d["checks"][k + "_type"]
    let field = d["checks"][k + "_field"]
    d["runs"] += 1
    if ctype == "not_null"
        if field not in data
            d["failures"] += 1
            return err("field missing: " + field)
        d["passes"] += 1
        return ok(d)
    if ctype == "not_empty"
        if field not in data
            d["failures"] += 1
            return err("field missing: " + field)
        if data[field] == ""
            d["failures"] += 1
            return err("field empty: " + field)
        d["passes"] += 1
        return ok(d)
    err("unknown check type: " + ctype)

fn dq_check_count(d: dict) -> int
    d["check_count"]

fn dq_pass_rate(d: dict) -> int
    if d["runs"] == 0
        return 100
    d["passes"] * 100 / d["runs"]

fn dq_total_failures(d: dict) -> int
    d["failures"]
