// forge_runlength -- run-length encoding (RLE): the simplest lossless compression. It replaces a "run" of the same
// repeated character with a single (count, character) pair, so "aaaaabbbc" becomes "5a3b1c". It shines on data
// with long runs -- fax/bitmap images, simple sprite/tilemap graphics, sparse sensor logs, DNA with repeats -- and
// is the first stage inside bigger schemes (BWT+RLE in bzip2, RLE inside PackBits/TIFF/PCX). Two APIs: a compact
// TEXT form ("count then char", best when the alphabet has no digits) and a fully general PAIRS form (list of
// [char, count]) that round-trips ANY string, digits included. run_count reports how many runs a string has (its
// "compressibility"). LEAF -- imports NOTHING.

// Encode s in the compact "<count><char>" text form, e.g. "aaabbc" -> "3a2b1c", "wwwwwwwwwwww" -> "12w". Best for
// alphabets WITHOUT digit characters (decoding reads a leading integer count before each character).
fn rle_encode(s: string) -> string
    let out = ""
    let n = len(s)
    let i = 0
    while i < n
        let ch = char_at(s, i)
        let count = 1
        let j = i + 1
        while j < n and char_at(s, j) == ch
            count += 1
            j += 1
        out += str(count) + ch
        i = j
    out

// Decode the compact "<count><char>" text form back to the original string. Counts may be multiple digits.
fn rle_decode(s: string) -> string
    let out = ""
    let n = len(s)
    let i = 0
    while i < n
        // read the (possibly multi-digit) count
        let num = 0
        while i < n and char_at(s, i) >= "0" and char_at(s, i) <= "9"
            num = num * 10 + (ord(char_at(s, i)) - 48)
            i += 1
        if i < n
            let ch = char_at(s, i)
            for k in 0..num
                out += ch
            i += 1
    out

// Encode s as a list of [char, count] runs. Fully general -- round-trips ANY string including digits.
fn rle_pairs(s: string) -> list
    let out = []
    let n = len(s)
    let i = 0
    while i < n
        let ch = char_at(s, i)
        let count = 1
        let j = i + 1
        while j < n and char_at(s, j) == ch
            count += 1
            j += 1
        push(out, [ch, count])
        i = j
    out

// Rebuild the original string from a [char, count] run list.
fn rle_from_pairs(pairs: list) -> string
    let out_parts = []
    for i in 0..len(pairs)
        let run = pairs[i]
        let ch = run[0]
        let count = run[1]
        let k = 0
        while k < count
            push(out_parts, ch)
            k += 1
    let out = join(out_parts, "")
    out

// How many runs s has (the number of maximal same-character blocks). Fewer runs = more compressible.
fn run_count(s: string) -> int
    let n = len(s)
    let runs = 0
    let i = 0
    while i < n
        let ch = char_at(s, i)
        let j = i + 1
        while j < n and char_at(s, j) == ch
            j += 1
        runs += 1
        i = j
    runs
