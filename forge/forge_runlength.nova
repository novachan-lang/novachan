// forge_runlength -- thin wrapper over std/encoding/runlength (canonical implementation).
import std/encoding/runlength

fn rle_encode(s: string) -> string
    return rl_encode(s)

fn rle_decode(s: string) -> string
    return rl_decode(s)

fn rle_pairs(s: string) -> list
    return rl_encode_pairs(s)

fn rle_from_pairs(pairs: list) -> string
    return rl_decode_pairs(pairs)

fn run_count(s: string) -> int
    let n = len(s)
    let runs = 0
    let i = 0
    while i < n
        let ch = char_at(s, i)
        let j = i + 1
        while j < n and char_at(s, j) == ch
            j += 1
        runs += 1
        i = j
    runs

