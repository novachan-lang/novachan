// forge_maxflow -- the maximum flow through a capacitated network from a source to a sink: how much water/data/
// traffic/goods can you push through a pipe/link/road network given each connection's capacity? This one
// algorithm answers a surprising range of problems: peak throughput of a network, the MAXIMUM BIPARTITE MATCHING
// (jobs to workers, students to projects), the MINIMUM CUT (the cheapest set of links to sever to disconnect
// source from sink = the bottleneck, by the max-flow-min-cut theorem), project scheduling, and transportation/
// assignment planning. It uses Edmonds-Karp: repeatedly find a shortest augmenting path (BFS) in the residual
// network and push flow along it until none remains. Edges are [from, to, capacity] with string node ids and
// non-negative integer capacities. LEAF -- imports NOTHING.

// PRIVATE: reconstruct nodes + residual capacity dict + adjacency from the edge list.
fn _mf_build(edges: list) -> list
    let cap = {}
    let adj = {}
    for e in 0..len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        let c = edges[e][2]
        let key = u + "|" + v
        cap[key] = get(cap, key, 0) + c
        let rkey = v + "|" + u
        if rkey not in cap
            cap[rkey] = 0
        if u not in adj
            adj[u] = []
        if v not in adj
            adj[v] = []
        push(adj[u], v)
        push(adj[v], u)
    [cap, adj]

// The maximum flow from `source` to `sink`. Also equals the minimum cut capacity.
fn max_flow(edges: list, source, sink) -> int
    let built = _mf_build(edges)
    let cap = built[0]
    let adj = built[1]
    let total = 0
    if source in adj and sink in adj
        let running = true
        while running
            // BFS for a shortest augmenting path in the residual graph
            let parent = {}
            let visited = {}
            visited[source] = 1
            let queue = []
            push(queue, source)
            let qi = 0
            let found = false
            while qi < len(queue) and not found
                let v = queue[qi]
                qi += 1
                let nb = adj[v]
                for j in 0..len(nb)
                    let w = nb[j]
                    let residual = get(cap, v + "|" + w, 0)
                    if w not in visited and residual > 0
                        visited[w] = 1
                        parent[w] = v
                        if w == sink
                            found = true
                        push(queue, w)
            if not found
                running = false
            else
                // bottleneck along sink -> source
                let bottleneck = -1
                let node = sink
                while node != source
                    let p = parent[node]
                    let c = get(cap, p + "|" + node, 0)
                    if bottleneck < 0 or c < bottleneck
                        bottleneck = c
                    node = p
                // augment
                let node2 = sink
                while node2 != source
                    let p = parent[node2]
                    cap[p + "|" + node2] = get(cap, p + "|" + node2, 0) - bottleneck
                    cap[node2 + "|" + p] = get(cap, node2 + "|" + p, 0) + bottleneck
                    node2 = p
                total += bottleneck
    total
