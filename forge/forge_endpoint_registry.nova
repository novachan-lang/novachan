// forge_endpoint_registry — service endpoint discovery and health with Result API.

fn er_new() -> dict
    let e = {}
    e["endpoint_count"] = 0
    e["lookups"] = 0
    e

fn er_register(e: dict, service: string, endpoint: string) -> dict
    e["ep_" + service + "_url"] = endpoint
    e["ep_" + service + "_healthy"] = 1
    e["endpoint_count"] = e["endpoint_count"] + 1
    e

fn er_lookup(e: dict, service: string) -> Result
    e["lookups"] = e["lookups"] + 1
    let uk = "ep_" + service + "_url"
    if uk not in e
        return err("service not found: " + service)
    if e["ep_" + service + "_healthy"] != 1
        return err("service unhealthy: " + service)
    ok(e[uk])

fn er_mark_unhealthy(e: dict, service: string) -> Result
    let hk = "ep_" + service + "_healthy"
    if hk not in e
        return err("service not found: " + service)
    e[hk] = 0
    ok(e)

fn er_mark_healthy(e: dict, service: string) -> Result
    let hk = "ep_" + service + "_healthy"
    if hk not in e
        return err("service not found: " + service)
    e[hk] = 1
    ok(e)

fn er_is_healthy(e: dict, service: string) -> int
    let hk = "ep_" + service + "_healthy"
    if hk in e
        return e[hk]
    0

fn er_endpoint_count(e: dict) -> int
    e["endpoint_count"]

fn er_total_lookups(e: dict) -> int
    e["lookups"]
