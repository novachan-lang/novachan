// forge_health -- composite health checks (Spring Actuator HealthIndicator + /health aggregation). Register
// named indicators (a check is fn() -> bool, true=up: a DB ping, a cache reachable, a downstream up); the
// aggregate is UP iff ALL are up, with per-component detail. Deepens forge_obs's /healthz from a static 200
// into a real dependency health report. LEAF -- imports NOTHING.

fn health_new() -> dict
    {"indicators": {}}

// Register a named health indicator (check = fn() -> bool). Fluent.
fn health_indicator(reg: dict, name: string, check) -> dict
    let inds = reg["indicators"]
    inds[name] = check
    reg

// Run all indicators -> {"status": "UP"|"DOWN", "components": {name: {"status": ...}}}. DOWN if ANY is down.
fn health_check(reg: dict) -> dict
    let inds = reg["indicators"]
    let components = {}
    let all_up = 1
    for name in keys(inds)
        let check = inds[name]
        let up = check()
        if not up
            all_up = 0
        components[name] = {"status": "UP" if up else "DOWN"}
    {"status": "UP" if all_up == 1 else "DOWN", "components": components}
