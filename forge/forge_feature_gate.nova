// forge_feature_gate — Feature gating with environment/user targeting.
// Define gates with conditions, evaluate for context.

fn fg_new() -> dict
    {"gates": {}}

fn fg_add_gate(fg: dict, name: string, gate_type: string) -> dict
    fg["gates"][name] = {"type": gate_type, "enabled": 1, "users": [], "environments": [], "evaluations": 0, "passes": 0}
    fg

fn fg_add_user(fg: dict, gate_name: string, user_id: string) -> dict
    if gate_name not in fg["gates"]
        return fg
    push(fg["gates"][gate_name]["users"], user_id)
    fg

fn fg_add_env(fg: dict, gate_name: string, env: string) -> dict
    if gate_name not in fg["gates"]
        return fg
    push(fg["gates"][gate_name]["environments"], env)
    fg

fn fg_evaluate(fg: dict, gate_name: string, user_id: string, env: string) -> int
    if gate_name not in fg["gates"]
        return 0
    let g = fg["gates"][gate_name]
    fg["gates"][gate_name]["evaluations"] += 1
    if g["enabled"] != 1
        return 0
    if g["type"] == "boolean"
        fg["gates"][gate_name]["passes"] += 1
        return 1
    if g["type"] == "user"
        for i in 0..len(g["users"])
            if g["users"][i] == user_id
                fg["gates"][gate_name]["passes"] += 1
                return 1
        return 0
    if g["type"] == "environment"
        for i in 0..len(g["environments"])
            if g["environments"][i] == env
                fg["gates"][gate_name]["passes"] += 1
                return 1
        return 0
    0

fn fg_disable(fg: dict, gate_name: string) -> dict
    if gate_name not in fg["gates"]
        return fg
    fg["gates"][gate_name]["enabled"] = 0
    fg

fn fg_gate_count(fg: dict) -> int
    len(keys(fg["gates"]))

fn fg_evaluations(fg: dict, gate_name: string) -> int
    if gate_name not in fg["gates"]
        return 0
    fg["gates"][gate_name]["evaluations"]

fn fg_pass_rate(fg: dict, gate_name: string) -> int
    if gate_name not in fg["gates"]
        return 0
    let evals = fg["gates"][gate_name]["evaluations"]
    if evals == 0
        return 0
    (fg["gates"][gate_name]["passes"] * 100) / evals
