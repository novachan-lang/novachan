// forge_fan_out_fan_in — Fan-out to workers, fan-in results.

fn fi_new(worker_count: int) -> dict
    {"worker_count": worker_count, "items": {}, "item_count": 0, "results": {}, "result_count": 0}

fn fi_submit(f: dict, item: string) -> dict
    let assigned = f["item_count"] - (f["item_count"] / f["worker_count"]) * f["worker_count"]
    let k = str(f["item_count"])
    f["items"][k + "_item"] = item
    f["items"][k + "_worker"] = assigned
    f["items"][k + "_done"] = 0
    f["item_count"] += 1
    f

fn fi_complete(f: dict, idx: int, result: string) -> dict
    if idx >= f["item_count"]
        return f
    f["items"][str(idx) + "_done"] = 1
    f["results"][str(f["result_count"])] = result
    f["result_count"] += 1
    f

fn fi_worker_load(f: dict, worker_id: int) -> int
    let count = 0
    for i in 0..f["item_count"]
        if f["items"][str(i) + "_worker"] == worker_id
            count += 1
    count

fn fi_all_done(f: dict) -> int
    1 if f["result_count"] == f["item_count"] else 0

fn fi_result(f: dict, idx: int) -> string
    f["results"][str(idx)]

fn fi_progress(f: dict) -> int
    if f["item_count"] == 0
        return 100
    f["result_count"] * 100 / f["item_count"]
