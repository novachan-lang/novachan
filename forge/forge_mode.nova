// forge_mode -- the MODE and frequency analysis: which value appears most often, how often each value occurs,
// and the full multi-modal picture. The mode is the third "average" alongside mean (forge_stats) and median
// (forge_select), and it's the ONLY one that works on categorical data -- the most common category, the top
// answer in a survey, the busiest hour, the most-visited page, the winning vote, the peak of a distribution.
// frequency gives the whole tally (value -> count) for histograms and analytics; modes returns every value tied
// for most frequent (a distribution can be bi- or multi-modal). Elements may be integers or strings. LEAF.

// The value counts as a dict of str(value) -> count.
fn frequency(arr: list) -> dict
    let freq = {}
    for i in 0..len(arr)
        let key = str(arr[i])
        freq[key] = get(freq, key, 0) + 1
    freq

// How many times `x` appears in the list.
fn count_of(arr: list, x) -> int
    let target = str(x)
    let c = 0
    for i in 0..len(arr)
        if str(arr[i]) == target
            c += 1
    c

// The most frequently occurring value (the first to reach the top count on ties), or null for an empty list.
fn mode(arr: list)
    let freq = {}
    let best = null
    let best_count = 0
    for i in 0..len(arr)
        let key = str(arr[i])
        let c = get(freq, key, 0) + 1
        freq[key] = c
        if c > best_count
            best_count = c
            best = arr[i]
    best

// Every value tied for the highest frequency (in first-seen order) -- handles multi-modal data.
fn modes(arr: list) -> list
    let freq = frequency(arr)
    // maximum count
    let maxc = 0
    let ks = keys(freq)
    for k in 0..len(ks)
        if freq[ks[k]] > maxc
            maxc = freq[ks[k]]
    // collect distinct values (original form) whose count equals maxc, first-seen order
    let seen = {}
    let out = []
    for i in 0..len(arr)
        let key = str(arr[i])
        if freq[key] == maxc and contains(seen, key) == false
            seen[key] = 1
            push(out, arr[i])
    out
