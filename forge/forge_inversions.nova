// forge_inversions -- count INVERSIONS (pairs that are out of order) and merge-sort, in O(n log n). An inversion is
// a pair i<j with xs[i] > xs[j]; the inversion count is exactly how many adjacent swaps a bubble sort would need,
// i.e. a precise measure of "how unsorted" a list is. It's the engine behind Kendall's tau rank correlation
// (agreement between two rankings -> recommender systems, A/B ranking, search-quality metrics), measuring how far
// a permutation is from sorted, and detecting near-sorted data. The naive count is O(n^2); doing it during a merge
// sort makes it O(n log n) -- when the right half contributes an element before some of the left half remains,
// every remaining left element forms an inversion with it, counted in one shot. merge_sort itself is a stable
// comparison sort that (unlike forge_intsort's counting/radix) handles NEGATIVE numbers and any comparable ints.
// LEAF -- imports NOTHING.

// PRIVATE: xs[lo..hi) as a new list.
fn _inv_sub(xs: list, lo: int, hi: int) -> list
    let out = []
    let i = lo
    while i < hi
        push(out, xs[i])
        i = i + 1
    out

// PRIVATE: merge two sorted lists, returning [merged_list, cross_inversions].
fn _inv_merge(a: list, b: list) -> list
    let out = []
    let inv = 0
    let i = 0
    let j = 0
    let na = len(a)
    let nb = len(b)
    while i < na and j < nb
        if a[i] <= b[j]
            push(out, a[i])
            i = i + 1
        else
            // b[j] jumps ahead of every remaining element of a -> that many inversions
            push(out, b[j])
            inv = inv + (na - i)
            j = j + 1
    while i < na
        push(out, a[i])
        i = i + 1
    while j < nb
        push(out, b[j])
        j = j + 1
    [out, inv]

// PRIVATE: recursive sort returning [sorted_list, inversion_count].
fn _inv_sort(xs: list) -> list
    let n = len(xs)
    let out = [xs, 0]
    if n > 1
        let mid = n / 2
        let lr = _inv_sort(_inv_sub(xs, 0, mid))
        let rr = _inv_sort(_inv_sub(xs, mid, n))
        let merged = _inv_merge(lr[0], rr[0])
        out = [merged[0], lr[1] + rr[1] + merged[1]]
    out

// The number of inversions (out-of-order pairs i<j with xs[i] > xs[j]) in O(n log n).
fn count_inversions(xs: list) -> int
    let r = _inv_sort(xs)
    r[1]

// A stable ascending sort via merge sort. Handles negatives and duplicates. O(n log n).
fn merge_sort(xs: list) -> list
    let r = _inv_sort(xs)
    r[0]

// Kendall tau DISTANCE between two rankings of the same items: the number of pairs ordered differently in the two
// sequences. `b` is the target order; this counts inversions of b's positions as they appear in `a`. Both lists
// must be permutations of the same elements.
fn kendall_tau_distance(a: list, b: list) -> int
    // map each value to its rank in b
    let rank = {}
    let i = 0
    while i < len(b)
        rank[str(b[i])] = i
        i = i + 1
    // translate a into b-ranks, then count inversions
    let seq = []
    let k = 0
    while k < len(a)
        push(seq, get(rank, str(a[k]), 0))
        k = k + 1
    count_inversions(seq)
