// forge_secret_rotation — Rotate secrets with versioning.

fn sr_new() -> dict
    {"secrets": {}, "versions": {}, "rotations": 0, "secret_count": 0}

fn sr_set(s: dict, name: string, value: string, version: int) -> dict
    if name not in s["secrets"]
        s["secret_count"] += 1
    s["secrets"][name] = value
    s["versions"][name] = version
    s

fn sr_rotate(s: dict, name: string, new_value: string) -> dict
    if name not in s["versions"]
        s = sr_set(s, name, new_value, 1)
        s["rotations"] += 1
        return s
    let v = s["versions"][name] + 1
    s["secrets"][name + "_prev"] = s["secrets"][name]
    s["secrets"][name] = new_value
    s["versions"][name] = v
    s["rotations"] += 1
    s

fn sr_get(s: dict, name: string) -> dict
    if name not in s["secrets"]
        return {"found": 0, "value": "", "version": 0}
    {"found": 1, "value": s["secrets"][name], "version": s["versions"][name]}

fn sr_previous(s: dict, name: string) -> string
    let k = name + "_prev"
    if k not in s["secrets"]
        return ""
    s["secrets"][k]

fn sr_total_rotations(s: dict) -> int
    s["rotations"]

fn sr_secret_count(s: dict) -> int
    s["secret_count"]
