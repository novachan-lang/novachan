// forge_request_pipeline — Middleware pipeline for request processing.

fn rp_new() -> dict
    let p = {}
    p["middleware"] = {}
    p["count"] = 0
    p["processed"] = 0
    p["aborted"] = 0
    p

fn rp_use(p: dict, name: string, action: string) -> dict
    let k = str(p["count"])
    p["middleware"][k + "_name"] = name
    p["middleware"][k + "_action"] = action
    p["middleware"][k + "_enabled"] = 1
    p["count"] = p["count"] + 1
    p

fn rp_disable(p: dict, index: int) -> dict
    if index < 0
        return p
    if index >= p["count"]
        return p
    p["middleware"][str(index) + "_enabled"] = 0
    p

fn rp_enable(p: dict, index: int) -> dict
    if index < 0
        return p
    if index >= p["count"]
        return p
    p["middleware"][str(index) + "_enabled"] = 1
    p

fn rp_process(p: dict, request_path: string) -> dict
    let result = {}
    result["path"] = request_path
    result["steps_run"] = 0
    result["aborted"] = 0
    let last_action = ""
    let i = 0
    while i < p["count"]
        let k = str(i)
        if p["middleware"][k + "_enabled"] == 1
            last_action = p["middleware"][k + "_action"]
            result["steps_run"] = result["steps_run"] + 1
            if last_action == "reject"
                result["aborted"] = 1
                p["aborted"] = p["aborted"] + 1
                result["p"] = p
                return result
        i = i + 1
    p["processed"] = p["processed"] + 1
    result["p"] = p
    result

fn rp_middleware_count(p: dict) -> int
    p["count"]

fn rp_total_processed(p: dict) -> int
    p["processed"]

fn rp_total_aborted(p: dict) -> int
    p["aborted"]
