// forge_readability -- Flesch Reading Ease + Flesch-Kincaid grade level (content readability scoring for SEO,
// education, and UX writing). Syllables are estimated by counting vowel groups (min 1/word). Higher ease =
// easier to read; grade = approximate US school grade. Integer math (milli-scaled). LEAF -- imports NOTHING.

fn _rd_is_vowel(c: string) -> bool
    find("aeiouyAEIOUY", c) >= 0

fn _rd_syllables(word: string) -> int
    let count = 0
    let prev_vowel = false
    for i in 0..len(word)
        let v = _rd_is_vowel(char_at(word, i))
        if v and prev_vowel == false
            count += 1
        prev_vowel = v
    if count == 0
        return 1
    count

// [words, sentences, syllables] for a text.
fn _rd_stats(text: string) -> list
    let words = 0
    let sentences = 0
    let syllables = 0
    let word = ""
    let i = 0
    let n = len(text)
    while i <= n
        let atend = i == n
        let c = " "
        if atend == false
            c = char_at(text, i)
        if c == "." or c == "!" or c == "?"
            sentences += 1
        if atend or c == " " or c == chr(10) or c == "." or c == "!" or c == "?" or c == "," or c == ";"
            if len(word) > 0
                words += 1
                syllables += _rd_syllables(word)
                word = ""
        else
            word += c
        i += 1
    if sentences == 0
        sentences = 1
    [words, sentences, syllables]

// Flesch Reading Ease: 206.835 - 1.015*(words/sentence) - 84.6*(syllables/word). Higher = easier.
fn flesch_reading_ease(text: string) -> int
    let s = _rd_stats(text)
    let words = s[0]
    if words == 0
        return 0
    let asl = words * 1000 / s[1]
    let asw = s[2] * 1000 / words
    (206835 - (1015 * asl) / 1000 - (84600 * asw) / 1000) / 1000

// Flesch-Kincaid grade level: 0.39*ASL + 11.8*ASW - 15.59 (clamped at 0).
fn flesch_kincaid_grade(text: string) -> int
    let s = _rd_stats(text)
    let words = s[0]
    if words == 0
        return 0
    let asl = words * 1000 / s[1]
    let asw = s[2] * 1000 / words
    let g = (390 * asl / 1000 + 11800 * asw / 1000 - 15590) / 1000
    if g < 0
        return 0
    g
