// forge_sliding -- SLIDING-WINDOW-LOG rate limiting: precise per-key limiting with NO boundary burst. The
// fixed-window counter (forge_ratewin) lets a client fire up to 2x the limit straddling a window edge;
// sliding-window keeps a timestamp log per key and counts only hits within the trailing `window_ms`, so the
// limit holds at every instant. Old entries are evicted lazily on each check. Cost = O(hits-in-window) memory
// per key -- exact where fixed-window is cheap-but-bursty. State = dict of key -> list of hit timestamps. LEAF.

fn sliding_new(limit: int, window_ms: int) -> dict
    let sw = {}
    sw["limit"] = limit
    sw["window_ms"] = window_ms
    sw["log"] = {}
    sw

// PRIVATE: the still-in-window timestamps for a key at now_ms. Rebuilds the list dropping anything at/older
// than now_ms - window_ms, stores it back, and returns it (the SAME list object stored under the key).
fn _sliding_prune(sw: dict, key: string, now_ms: int) -> list
    let cutoff = now_ms - sw["window_ms"]
    let log = sw["log"]
    let kept = []
    if key in log
        let arr = log[key]
        for i in 0..len(arr)
            if arr[i] > cutoff
                push(kept, arr[i])
    log[key] = kept
    kept

// Try to consume one unit. true (and records the hit) if fewer than `limit` hits are in the trailing window,
// else false. The recorded timestamp persists in the key's log for subsequent checks.
fn sliding_allow(sw: dict, key: string, now_ms: int) -> bool
    let kept = _sliding_prune(sw, key, now_ms)
    if len(kept) >= sw["limit"]
        return false
    push(kept, now_ms)
    true

// Hits remaining in the current sliding window for a key (never negative).
fn sliding_remaining(sw: dict, key: string, now_ms: int) -> int
    let kept = _sliding_prune(sw, key, now_ms)
    let rem = sw["limit"] - len(kept)
    if rem < 0
        return 0
    rem
