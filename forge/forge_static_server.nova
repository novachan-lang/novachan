// forge_static_server -- static-file-serving CONFIGURATION: MIME table, index-file name, cache TTL,
// and URL-path -> filesystem-path resolution with directory-traversal protection. Does not touch the
// filesystem itself (no open/read here) -- it is the policy layer a request handler consults before
// reading a file, matching the split between nginx's `location`/`mime.types` config and the actual
// sendfile() call. LEAF -- imports NOTHING.

// sf_new: a fresh static-server config rooted at root_dir. Default index file is "index.html",
// default cache_ttl is 0 (no caching), no MIME mappings registered yet.
fn sf_new(root_dir: string) -> dict
    let s = {}
    s["root"] = root_dir
    s["index"] = "index.html"
    s["cache_ttl"] = 0
    s["mime_count"] = 0
    s

// sf_add_mime: register (or overwrite) an extension -> MIME-type mapping. extension is compared
// as-given by sf_get_mime/sf_has_mime (callers should pass a consistent case, e.g. always lowercase).
fn sf_add_mime(state: dict, extension: string, mime_type: string) -> dict
    let nk = "m_" + extension
    if contains(state, nk) != true
        state["mime_count"] = state["mime_count"] + 1
    state[nk] = mime_type
    state

// sf_get_mime: the MIME type registered for extension, or Err if none was registered.
fn sf_get_mime(state: dict, extension: string) -> Result
    let nk = "m_" + extension
    if contains(state, nk) != true
        return err("mime type not found for extension: " + extension)
    ok(state[nk])

// _sf_has_traversal: 1 if p contains a ".." segment anywhere (covers "../", "..\\", a bare trailing
// "..", and "..%2f"-style encoded forms are rejected upstream by NOT percent-decoding before this
// check -- an encoded ".." never reaches here as literal ".." so it fails safe as an opaque path
// instead of resolving outside root).
fn _sf_has_traversal(p: string) -> int
    if find(p, "..") >= 0
        return 1
    0

// sf_resolve: resolve a request URL path to a filesystem path under state's root. Rejects any path
// containing ".." (directory-traversal protection) with Err. An empty path or "/" resolves to
// root + "/" + the configured index file. A relative path (no leading "/") gets one added. Does not
// check the file actually exists -- that is the caller's job after resolving.
fn sf_resolve(state: dict, url_path: string) -> Result
    if _sf_has_traversal(url_path) == 1
        return err("path traversal rejected: " + url_path)
    let root = state["root"]
    let p = url_path
    if len(p) == 0
        p = "/"
    if char_at(p, 0) != "/"
        p = "/" + p
    if p == "/"
        p = "/" + state["index"]
    ok(root + p)

// sf_set_index: change the index filename served for a directory-root request (default "index.html").
fn sf_set_index(state: dict, filename: string) -> dict
    state["index"] = filename
    state

// sf_get_index: the configured index filename.
fn sf_get_index(state: dict) -> string
    state["index"]

// sf_set_cache_ttl: set the cache TTL (seconds) advertised for served files (e.g. via Cache-Control).
fn sf_set_cache_ttl(state: dict, seconds: int) -> dict
    state["cache_ttl"] = seconds
    state

// sf_get_cache_ttl: the configured cache TTL in seconds.
fn sf_get_cache_ttl(state: dict) -> int
    state["cache_ttl"]

// sf_mime_count: the number of distinct extension -> MIME-type mappings registered.
fn sf_mime_count(state: dict) -> int
    state["mime_count"]

// sf_has_mime: 1 if extension has a registered MIME mapping, else 0.
fn sf_has_mime(state: dict, extension: string) -> int
    let nk = "m_" + extension
    if contains(state, nk) == true
        return 1
    0
