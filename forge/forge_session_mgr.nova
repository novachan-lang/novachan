// ══════════════════════════════════════════════════════════════════════════════
// ⚠ NOT THE LIVE FORGE SESSION MECHANISM -- DO NOT IMPORT FOR REAL HTTP SESSIONS ⚠
// This module (the sm_* functions below) is a STANDALONE, in-memory session
// scaffold with its own session-id/TTL bookkeeping. It is NOT wired into
// forge.nova's request/response pipeline, is NOT used by mw_require_auth or
// the CSRF machinery, and has NO relationship to the REAL, actually-used
// session mechanism, which lives in forge.nova:
//     session_set(resp: Response, secret: string, value: string) -> Response   // signs + sets cookie
//     session_get(req: Request, secret: string) -> string                     // verifies + reads cookie
// forge.nova's session_get/session_set are signed (HMAC), cookie-backed, and
// are what mw_require_auth / CSRF depend on. This module's sm_create/sm_get_session/
// sm_set/sm_get_val take a caller-managed `store: dict` + bare `session_id: string`
// and never touch a cookie or an HMAC at all -- SILENTLY DIFFERENT semantics on a
// security-relevant code path. If a future developer imports forge_session_mgr
// expecting cookie session handling, they will get the wrong thing with no
// compile error. For real HTTP session handling, use forge.nova's session_get /
// session_set directly (see forge.nova, not this file).
// ══════════════════════════════════════════════════════════════════════════════
// forge_session_mgr — HTTP session management.
// Create/get/expire sessions with typed data, TTL tracking.

fn sm_new_store() -> dict
    {"sessions": {}, "next_id": 1}

fn sm_create(store: dict, ttl: int, now: int) -> dict
    let nid = store["next_id"]
    let id = "sess_{nid}"
    store["next_id"] += 1
    let sess = {"id": id, "data": {}, "created_at": now, "last_access": now, "ttl": ttl, "active": 1}
    store["sessions"][id] = sess
    {"store": store, "session_id": id}

fn sm_get_session(store: dict, id: string, now: int) -> dict
    if id not in store["sessions"]
        return {"valid": 0}
    let sess = store["sessions"][id]
    if sess["active"] != 1
        return {"valid": 0}
    let age = now - sess["last_access"]
    if age > sess["ttl"]
        sess["active"] = 0
        return {"valid": 0}
    sess["last_access"] = now
    {"valid": 1, "data": sess["data"], "session_id": id}

fn sm_set(store: dict, id: string, key: string, value: any) -> dict
    if id not in store["sessions"]
        return store
    store["sessions"][id]["data"][key] = value
    store

fn sm_get_val(store: dict, id: string, key: string) -> any
    if id not in store["sessions"]
        return ""
    let data = store["sessions"][id]["data"]
    if key not in data
        return ""
    data[key]

fn sm_destroy(store: dict, id: string) -> dict
    if id not in store["sessions"]
        return store
    store["sessions"][id]["active"] = 0
    store

fn sm_active_count(store: dict) -> int
    let count = 0
    let all = keys(store["sessions"])
    for i in 0..len(all)
        let k = all[i]
        if store["sessions"][k]["active"] == 1
            count += 1
    count

fn sm_session_count(store: dict) -> int
    len(keys(store["sessions"]))
