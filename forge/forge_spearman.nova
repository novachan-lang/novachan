// forge_spearman -- Spearman's rank correlation: does one variable rise (or fall) as another does, even if the
// relationship isn't a straight line? Pearson correlation (forge_stats) measures LINEAR association and is
// thrown off by curves and outliers; Spearman measures MONOTONIC association by comparing RANKS instead of raw
// values, so it's robust to outliers and catches "as X goes up, Y goes up" for any consistently-increasing
// relationship. The result rho is in [-1, 1]: +1 = perfectly rank-aligned, -1 = perfectly reversed, 0 = no
// monotonic trend. Use it for feature relevance on skewed/ordinal data, A/B or survey analysis, and detecting
// non-linear dependence. Computed from the rank-difference formula (no square roots -- fully reliable); ties get
// averaged ranks. Two equal-length numeric lists in, one correlation out. LEAF -- imports NOTHING.

// PRIVATE: the ranks of `values` (1-based, average rank for ties), in the original order.
fn _sp_rank(values: list) -> list
    let n = len(values)
    // parallel sort of (value, original index) by value ascending
    let vals = []
    let idx = []
    for i in 0..n
        push(vals, values[i] * 1.0)
        push(idx, i)
    for a in 1..n
        let cv = vals[a] * 1.0
        let ci = idx[a]
        let b = a - 1
        while b >= 0 and (vals[b] * 1.0) > cv
            vals[b + 1] = vals[b]
            idx[b + 1] = idx[b]
            b -= 1
        vals[b + 1] = cv
        idx[b + 1] = ci
    // assign ranks, averaging over runs of equal values
    let ranks = [0.0 for z in 0..n]
    let p = 0
    while p < n
        let q = p + 1
        while q < n and (vals[q] * 1.0) == (vals[p] * 1.0)
            q += 1
        // 0-based positions p..q-1 -> 1-based ranks p+1..q ; average = (p+1 + q)/2
        let avg_rank = ((p + 1) + q) / 2.0
        let r = p
        while r < q
            ranks[idx[r]] = avg_rank
            r += 1
        p = q
    ranks

// Spearman's rho between two equal-length lists. +1/-1 = perfect monotonic up/down, 0 = none. 0.0 if n < 2 or
// lengths differ. Exact for distinct values; averaged ranks approximate the tied case.
fn spearman(x: list, y: list) -> float
    let n = len(x)
    let out = 0.0
    if n > 1 and len(y) == n
        let rx = _sp_rank(x)
        let ry = _sp_rank(y)
        let sumd2 = 0.0
        for i in 0..n
            let d = rx[i] * 1.0 - ry[i] * 1.0
            sumd2 += d * d
        let nf = n * 1.0
        out = 1.0 - 6.0 * sumd2 / (nf * (nf * nf - 1.0))
    out
