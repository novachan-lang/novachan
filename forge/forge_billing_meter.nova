// forge_billing_meter — Metered billing with usage tiers.

fn bm_new() -> dict
    let b = {}
    b["meters"] = {}
    b["tiers"] = {}
    b["tier_counts"] = {}
    b

fn bm_add_meter(b: dict, name: string, unit_price: int) -> dict
    b["meters"][name] = unit_price
    b["tiers"][name] = 0
    b

fn bm_record(b: dict, meter: string, quantity: int) -> dict
    let has = contains(b["tiers"], meter)
    if has == true
        b["tiers"][meter] = b["tiers"][meter] + quantity
    let hc = contains(b["tier_counts"], meter)
    if hc == true
        b["tier_counts"][meter] = b["tier_counts"][meter] + 1
    else
        b["tier_counts"][meter] = 1
    b

fn bm_usage(b: dict, meter: string) -> int
    let has = contains(b["tiers"], meter)
    if has != true
        return 0
    b["tiers"][meter]

fn bm_cost(b: dict, meter: string) -> int
    let has = contains(b["meters"], meter)
    if has != true
        return 0
    let usage = bm_usage(b, meter)
    usage * b["meters"][meter]

fn bm_total_cost(b: dict) -> int
    let ks = keys(b["meters"])
    let total = 0
    let i = 0
    while i < len(ks)
        total = total + bm_cost(b, ks[i])
        i = i + 1
    total

fn bm_record_count(b: dict, meter: string) -> int
    let has = contains(b["tier_counts"], meter)
    if has != true
        return 0
    b["tier_counts"][meter]

fn bm_reset(b: dict, meter: string) -> dict
    let has = contains(b["tiers"], meter)
    if has == true
        b["tiers"][meter] = 0
        b["tier_counts"][meter] = 0
    b
