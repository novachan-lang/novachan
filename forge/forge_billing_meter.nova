// forge_billing_meter — Metered billing with usage tiers.

fn bm_new() -> dict
    {"meters": {}, "tiers": {}, "tier_counts": {}}

fn bm_add_meter(b: dict, name: string, unit_price: int) -> dict
    b["meters"][name] = unit_price
    b["tiers"][name] = 0
    b

fn bm_record(b: dict, meter: string, quantity: int) -> dict
    if meter in b["tiers"]
        b["tiers"][meter] += quantity
    if meter in b["tier_counts"]
        b["tier_counts"][meter] += 1
    else
        b["tier_counts"][meter] = 1
    b

fn bm_usage(b: dict, meter: string) -> int
    if meter not in b["tiers"]
        return 0
    b["tiers"][meter]

fn bm_cost(b: dict, meter: string) -> int
    if meter not in b["meters"]
        return 0
    bm_usage(b, meter) * b["meters"][meter]

fn bm_total_cost(b: dict) -> int
    let total = 0
    for k in keys(b["meters"])
        total += bm_cost(b, k)
    total

fn bm_record_count(b: dict, meter: string) -> int
    if meter not in b["tier_counts"]
        return 0
    b["tier_counts"][meter]

fn bm_reset(b: dict, meter: string) -> dict
    if meter in b["tiers"]
        b["tiers"][meter] = 0
        b["tier_counts"][meter] = 0
    b
