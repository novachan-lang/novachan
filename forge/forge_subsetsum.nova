// forge_subsetsum -- the SUBSET SUM problem and its cousins: can you pick SOME subset of a set of numbers that adds
// up to a target? Unlike a contiguous run (forge_subarraysum), the chosen items need not be adjacent -- any
// combination counts -- which makes this NP-complete in general, but a dynamic program solves it in O(n * target)
// by tracking exactly which totals are reachable. Sweep the numbers, and for each one mark every previously
// reachable total plus that number as now reachable too; whether the target ends up marked answers the question.
// This underpins the partition problem (can a set be split into two halves of equal sum -- balancing teams, loads,
// or a bill), making exact change or hitting a budget from a fixed set, and feasibility checks in scheduling and
// resource allocation. Provides existence, a count of DISTINCT subsets that hit the target, and the equal-partition
// test. Non-negative integers. LEAF -- imports NOTHING.

// True if some subset of `nums` sums to exactly `target`. O(n * target) dynamic program.
fn subset_sum_exists(nums: list, target: int) -> bool
    let out = false
    if target == 0
        out = true
    else
        if target > 0
            let dp = []
            for z in 0..(target + 1)
                push(dp, 0)
            dp[0] = 1
            for i in 0..len(nums)
                let x = nums[i]
                let s = target
                while s >= x
                    if dp[s - x] == 1
                        dp[s] = 1
                    s -= 1
            if dp[target] == 1
                out = true
    out

// The number of DISTINCT subsets of `nums` that sum to exactly `target` (the empty subset counts for target 0).
fn count_subsets_sum(nums: list, target: int) -> int
    let out = 0
    if target >= 0
        let dp = []
        for z in 0..(target + 1)
            push(dp, 0)
        dp[0] = 1
        for i in 0..len(nums)
            let x = nums[i]
            let s = target
            while s >= x
                dp[s] = dp[s] + dp[s - x]
                s -= 1
        out = dp[target]
    out

// True if `nums` can be split into two subsets with equal sums (the partition problem).
fn can_partition(nums: list) -> bool
    let total = 0
    for i in 0..len(nums)
        total += nums[i]
    let out = false
    if total % 2 == 0
        out = subset_sum_exists(nums, total / 2)
    out
