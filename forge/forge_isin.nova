// forge_isin -- ISIN (International Securities Identification Number, ISO 6166) validation & check-digit
// computation. An ISIN is the global 12-character id for a security: a 2-letter ISO country code, a 9-character
// national security number (NSIN, alphanumeric), and 1 check digit. It joins forge's fintech validators
// (IBAN/BIC/card/Luhn) but for tradeable instruments (equities, bonds). The check digit uses the "Luhn mod 10"
// scheme AFTER expanding every letter to two digits (A=10 .. Z=35), doubling every second digit from the right.
// LEAF -- imports NOTHING.

// PRIVATE: a single ISIN char's numeric value -- '0'..'9' -> 0..9, 'A'..'Z' -> 10..35, else -1 (invalid).
fn _isin_val(c: string) -> int
    if c >= "0" and c <= "9"
        return ord(c) - 48
    if c >= "A" and c <= "Z"
        return ord(c) - 55
    0 - 1

// PRIVATE: expand a string to its digit string -- each char -> its value, a value >= 10 contributing two
// digits (tens then units). Returns "" if any char is invalid.
fn _isin_expand(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let v = _isin_val(char_at(s, i))
        if v < 0
            return ""
        if v >= 10
            out = out + str(v / 10) + str(v % 10)
        else
            out = out + str(v)
        i = i + 1
    out

// PRIVATE: Luhn sum over a digit string, doubling every second digit FROM THE RIGHT starting with the rightmost.
fn _isin_luhn_sum(digits: string) -> int
    let sum = 0
    let dbl = true
    let i = len(digits) - 1
    while i >= 0
        let d = ord(char_at(digits, i)) - 48
        if dbl
            let v = d * 2
            if v > 9
                v = v - 9
            sum = sum + v
        else
            sum = sum + d
        if dbl
            dbl = false
        else
            dbl = true
        i = i - 1
    sum

// The check digit (0..9) for an 11-character ISIN body (country code + 9-char NSIN, no check digit). The body
// is expanded, then the rightmost expanded digit is treated as position-2 (doubled), so the check digit makes
// the full Luhn total a multiple of 10. Returns -1 if the body has an invalid character.
fn isin_check_digit(body11: string) -> int
    let expanded = _isin_expand(body11)
    if len(expanded) == 0
        return 0 - 1
    let sum = _isin_luhn_sum(expanded)
    (10 - (sum % 10)) % 10

// True iff `isin` is a well-formed, checksum-valid 12-character ISIN.
fn isin_valid(isin: string) -> bool
    if len(isin) != 12
        return false
    // first two chars must be letters (country code)
    let c0 = char_at(isin, 0)
    let c1 = char_at(isin, 1)
    if not (c0 >= "A" and c0 <= "Z")
        return false
    if not (c1 >= "A" and c1 <= "Z")
        return false
    let last = char_at(isin, 11)
    if not (last >= "0" and last <= "9")
        return false
    let cd = isin_check_digit(slice(isin, 0, 11))
    if cd < 0
        return false
    cd == ord(last) - 48
