// forge_base32 -- thin wrapper over std/encoding/base32 (canonical implementation).
import std/encoding/base32

fn _p2(k: int) -> int
    let v = 1
    for i in 0..k
        v = v * 2
    v

// Encode: 5 input bytes -> 8 base32 symbols, '=' padded to a multiple of 8.
// Each char is taken as a byte via ord(char_at(...)) over the BYTE length of `s` -- byte-for-byte the
// same reads the inline loop did (NOVA's char_at is codepoint-indexed while len() is byte-counted, so a
// non-ASCII input has always encoded its first bytes plus zero padding; that behaviour is preserved
// exactly, not "fixed" -- callers with binary/non-ASCII data must use base32_encode_bytes).

fn base32_encode(s: string) -> string
    return base32_encode(s)

fn base32_encode_bytes(data: list) -> string
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    // Symbols are PUSHED to a list and joined ONCE at the end. `out = out + symbol` inside the loop is
    // QUADRATIC in NOVA: every concatenation allocates a fresh buffer and recopies everything emitted so
    // far, so encoding n bytes copied ~n^2/2 characters.
    let parts = []
    let bits = 0
    let nbits = 0
    for i in 0..len(data)
        bits = bits * 256 + (data[i] % 256)
        nbits += 8
        // Data-dependent drain of the bit accumulator (0, 1 or 2 symbols per input byte) -- stays a while.
        while nbits >= 5
            nbits -= 5
            push(parts, char_at(alpha, (bits / _p2(nbits)) % 32))
        bits = bits % _p2(nbits)
    if nbits > 0
        push(parts, char_at(alpha, (bits * _p2(5 - nbits)) % 32))
    // '=' pad to a multiple of 8 symbols: index a constant table by the deficit instead of appending one
    // character at a time (every alphabet symbol is exactly 1 char, so the symbol count IS the length).
    let pads = ["", "=", "==", "===", "====", "=====", "======", "======="]
    join(parts, "") + pads[(8 - len(parts) % 8) % 8]

// Decode: case-insensitive base32 -> the original bytes as a string. Stops at the first '='. Non-alphabet
// chars are skipped (lenient). Trailing partial bits are discarded (RFC canonical).
// NOTE (unchanged behaviour, verified against the pre-refactor version): a decoded 0x00 byte does not
// survive the string form -- chr(0) contributes nothing -- so the NUL is silently dropped and the
// octet stream no longer matches what was encoded. That is exactly why base32_decode_bytes exists.

fn base32_decode(s: string) -> string
    return base32_decode(s)

fn base32_decode_bytes(s: string) -> list
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    let lalpha = "abcdefghijklmnopqrstuvwxyz234567"
    let out = []
    let bits = 0
    let nbits = 0
    // Short-circuits at the first '=' (padding ends the data) -- a counted range with an explicit break,
    // not a hand-rolled index with a sentinel assignment.
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == "="
            break
        let upper = find(alpha, c)
        let v = find(lalpha, c) if upper < 0 else upper
        if v >= 0
            bits = bits * 32 + v
            nbits += 5
            if nbits >= 8
                nbits -= 8
                push(out, (bits / _p2(nbits)) % 256)
                bits = bits % _p2(nbits)
    out

