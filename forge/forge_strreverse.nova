// forge_strreverse -- reverse text at the character, word, and word-order level. reverse_string flips a string end
// to end (the building block of palindrome checks, reversing a buffer, and many string tricks). reverse_words
// reverses the ORDER of the words while keeping each word intact and collapsing extra spaces ("the quick brown fox"
// -> "fox brown quick the"), which is exactly what you need to render right-to-left word streams, flip
// "Last, First" name orders, or re-order path/URL segments. reverse_each_word keeps the words in place but reverses
// the letters inside each ("abc def" -> "cba fed"), handy for simple obfuscation and certain text puzzles. These
// are small but constant text-processing needs; done right they normalize whitespace and never leave stray
// separators. Character-level (byte) reversal. LEAF -- imports NOTHING.

// A string reversed end to end. reverse_string("hello") = "olleh".
fn reverse_string(s: string) -> string
    join([char_at(s, len(s) - 1 - j) for j in 0..len(s)], "")

// PRIVATE: split on runs of spaces into non-empty word tokens.
fn _rw_words(s: string) -> list
    let words = []
    let cur = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == " " and len(cur) > 0
            push(words, cur)
            cur = ""
        else if c != " "
            cur += c
    if len(cur) > 0
        push(words, cur)
    words

// The words in reverse order, single-spaced, with leading/trailing/duplicate spaces collapsed.
// reverse_words("the quick brown fox") = "fox brown quick the".
fn reverse_words(s: string) -> string
    join(reverse(_rw_words(s)), " ")

// Each word with its own letters reversed, words kept in original order and single-spaced.
// reverse_each_word("abc def") = "cba fed".
fn reverse_each_word(s: string) -> string
    join([reverse_string(w) for w in _rw_words(s)], " ")
