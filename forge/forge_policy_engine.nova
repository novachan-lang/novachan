// forge_policy_engine — Rule-based policy engine.
// Define rules, evaluate against facts, trace decisions.

fn pe_new() -> dict
    {"rules": [], "decisions": []}

fn pe_add_rule(engine: dict, name: string, field: string, operator: string, value: any, action: string) -> dict
    let rule = {"name": name, "field": field, "operator": operator, "value": value, "action": action, "enabled": true}
    push(engine["rules"], rule)
    engine

fn pe_disable_rule(engine: dict, name: string) -> dict
    for i in 0..len(engine["rules"])
        if engine["rules"][i]["name"] == name
            engine["rules"][i]["enabled"] = false
    engine

fn pe_evaluate(engine: dict, facts: dict) -> string
    for i in 0..len(engine["rules"])
        let rule = engine["rules"][i]
        if not rule["enabled"]
            continue
        let field = rule["field"]
        if field not in facts
            continue
        let fact_val = facts[field]
        let matched = false
        if rule["operator"] == "eq"
            if fact_val == rule["value"]
                matched = true
        if rule["operator"] == "gt"
            if fact_val > rule["value"]
                matched = true
        if rule["operator"] == "lt"
            if fact_val < rule["value"]
                matched = true
        if rule["operator"] == "neq"
            if fact_val != rule["value"]
                matched = true
        if matched
            push(engine["decisions"], {"rule": rule["name"], "action": rule["action"]})
            return rule["action"]
    "default"

fn pe_decision_log(engine: dict) -> list
    engine["decisions"]

fn pe_rule_count(engine: dict) -> int
    len(engine["rules"])

fn pe_last_decision(engine: dict) -> string
    let n = len(engine["decisions"])
    if n == 0
        return ""
    engine["decisions"][n - 1]["action"]
