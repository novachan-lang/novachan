// forge_tenant_billing — Tenant billing and usage tracking.
// Metered usage, invoices, plans, overages.

fn bill_new() -> dict
    {"tenants": {}, "invoices": []}

fn bill_create_tenant(bill: dict, tenant_id: string, plan: string, limit: int) -> dict
    bill["tenants"][tenant_id] = {"plan": plan, "limit": limit, "usage": 0, "balance": 0}
    bill

fn bill_record_usage(bill: dict, tenant_id: string, amount: int) -> dict
    if tenant_id in bill["tenants"]
        bill["tenants"][tenant_id]["usage"] += amount
    bill

fn bill_get_usage(bill: dict, tenant_id: string) -> int
    if tenant_id not in bill["tenants"]
        return 0
    bill["tenants"][tenant_id]["usage"]

fn bill_is_over_limit(bill: dict, tenant_id: string) -> bool
    if tenant_id not in bill["tenants"]
        return false
    let t = bill["tenants"][tenant_id]
    if t["usage"] > t["limit"]
        return true
    false

fn bill_overage(bill: dict, tenant_id: string) -> int
    if tenant_id not in bill["tenants"]
        return 0
    let t = bill["tenants"][tenant_id]
    let over = t["usage"] - t["limit"]
    if over > 0
        return over
    0

fn bill_generate_invoice(bill: dict, tenant_id: string, period: string, base_cost: int) -> dict
    if tenant_id not in bill["tenants"]
        return bill
    let usage = bill["tenants"][tenant_id]["usage"]
    let overage = bill_overage(bill, tenant_id)
    push(bill["invoices"], {"tenant_id": tenant_id, "period": period, "base_cost": base_cost, "usage": usage, "overage_cost": overage, "total": base_cost + overage})
    bill

fn bill_reset_usage(bill: dict, tenant_id: string) -> dict
    if tenant_id in bill["tenants"]
        bill["tenants"][tenant_id]["usage"] = 0
    bill

fn bill_invoice_count(bill: dict) -> int
    len(bill["invoices"])

fn bill_last_invoice(bill: dict) -> dict
    let n = len(bill["invoices"])
    if n == 0
        return {}
    bill["invoices"][n - 1]
