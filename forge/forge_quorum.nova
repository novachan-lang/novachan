// forge_quorum — Quorum-based decision making.
// Collect votes from nodes, check if quorum reached.

fn q_new(total_nodes: int) -> dict
    let q = {}
    q["total"] = total_nodes
    q["proposals"] = {}
    q

fn q_propose(q: dict, proposal_id: string) -> dict
    let p = {}
    p["votes_for"] = []
    p["votes_against"] = []
    p["status"] = "pending"
    q["proposals"][proposal_id] = p
    q

fn q_vote(q: dict, proposal_id: string, node: string, approve: int) -> dict
    let has = contains(q["proposals"], proposal_id)
    if has != true
        return q
    if approve == 1
        push(q["proposals"][proposal_id]["votes_for"], node)
    else
        push(q["proposals"][proposal_id]["votes_against"], node)
    let majority = (q["total"] / 2) + 1
    let for_count = len(q["proposals"][proposal_id]["votes_for"])
    let against_count = len(q["proposals"][proposal_id]["votes_against"])
    if for_count >= majority
        q["proposals"][proposal_id]["status"] = "accepted"
    if against_count >= majority
        q["proposals"][proposal_id]["status"] = "rejected"
    q

fn q_status(q: dict, proposal_id: string) -> string
    let has = contains(q["proposals"], proposal_id)
    if has != true
        return ""
    q["proposals"][proposal_id]["status"]

fn q_votes_for(q: dict, proposal_id: string) -> int
    let has = contains(q["proposals"], proposal_id)
    if has != true
        return 0
    len(q["proposals"][proposal_id]["votes_for"])

fn q_votes_against(q: dict, proposal_id: string) -> int
    let has = contains(q["proposals"], proposal_id)
    if has != true
        return 0
    len(q["proposals"][proposal_id]["votes_against"])

fn q_has_quorum(q: dict, proposal_id: string) -> int
    let status = q_status(q, proposal_id)
    if status == "accepted"
        return 1
    if status == "rejected"
        return 1
    0

fn q_proposal_count(q: dict) -> int
    len(keys(q["proposals"]))
