// forge_targeting -- feature-flag TARGETING + percentage rollout (LaunchDarkly / Unleash / Flipper). Decide
// whether a feature is ON for a given user: a stable percentage rollout (the SAME user always gets the same
// answer, so a 10% rollout consistently includes the same 10% -- via a hash bucket, not random) + attribute
// rules (on for users whose attribute is in an allowed set). Beyond forge_flags' simple on/off. LEAF.

fn _target_hash(s: string) -> int
    let h = 2166136261
    for i in 0..len(s)
        h = (h * 16777619 + ord(char_at(s, i))) % 2147483647
    h

// Is `feature` ON for `user_id` at a `percent` rollout (0-100)? STABLE per (feature,user): the same user
// always gets the same bucket, so increasing the percent only ADDS users (never flips existing ones).
fn rollout_on(feature: string, user_id: string, percent: int) -> bool
    if percent >= 100
        return true
    if percent <= 0
        return false
    let bucket = _target_hash(feature + ":" + user_id) % 100
    bucket < percent

// Attribute targeting: ON iff the user's `attr` value is in `allowed` (e.g. plan in [pro, enterprise];
// country in [US, CA]; beta_opt_in == "1").
fn target_attr(user_attrs: dict, attr: string, allowed: list) -> bool
    if attr not in user_attrs
        return false
    user_attrs[attr] in allowed

// Combined decision: ON if an attribute rule matches OR the user falls in the percentage rollout.
fn feature_on(feature: string, user_id: string, user_attrs: dict, attr: string, allowed: list, percent: int) -> bool
    if target_attr(user_attrs, attr, allowed)
        return true
    rollout_on(feature, user_id, percent)

// Stable A/B(/n) variant assignment: deterministically map (feature, user_id) to one of `variants`. The same
// user always lands on the SAME variant for a given feature + variant list, so an experiment's arms are sticky
// with no server-side assignment store and every node agrees. Distinct from rollout_on (a boolean %): this
// splits the whole population across N arms. "" when `variants` is empty.
fn ab_variant(feature: string, user_id: string, variants: list) -> string
    if len(variants) == 0
        return ""
    let idx = _target_hash(feature + ":" + user_id) % len(variants)
    variants[idx]
