// forge_health_endpoint — Health check endpoint with component checks.

fn he_new(service_name: string) -> dict
    {"service": service_name, "comp_status": {}, "comp_detail": {}, "comp_names": {}, "comp_count": 0, "checks": 0}

fn he_add_component(h: dict, name: string) -> dict
    let idx = h["comp_count"]
    h["comp_names"][str(idx)] = name
    h["comp_status"][name] = "up"
    h["comp_detail"][name] = ""
    h["comp_count"] += 1
    h

fn he_set_status(h: dict, component: string, status: string, detail: string) -> dict
    if component in h["comp_status"]
        h["comp_status"][component] = status
        h["comp_detail"][component] = detail
    h

fn he_check(h: dict) -> dict
    h["checks"] += 1
    let result = {"service": h["service"], "status": "up"}
    for i in 0..h["comp_count"]
        let name = h["comp_names"][str(i)]
        let st = h["comp_status"][name]
        if st != "up"
            result["status"] = "degraded"
    result["h"] = h
    result

fn he_component_status(h: dict, component: string) -> string
    if component not in h["comp_status"]
        return "unknown"
    h["comp_status"][component]

fn he_total_checks(h: dict) -> int
    h["checks"]

fn he_service_name(h: dict) -> string
    h["service"]
