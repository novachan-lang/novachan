// forge_mac -- MAC address (EUI-48) validation + normalization. Accepts colon, hyphen, or Cisco dot forms
// ("aa:bb:cc:dd:ee:ff", "AA-BB-CC-DD-EE-FF", "aabb.ccdd.eeff") and normalizes to lowercase colon form. For
// network device tracking, DHCP leases, and ARP tables. LEAF -- imports NOTHING.

fn _mac_hexonly(s: string) -> string
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if c != ":" and c != "-" and c != "."
            out += c
    lower(out)

// Valid MAC? Exactly 12 hex digits after stripping separators.
fn mac_valid(mac: string) -> bool
    let h = _mac_hexonly(mac)
    if len(h) != 12
        return false
    for i in 0..12
        if find("0123456789abcdef", char_at(h, i)) < 0
            return false
    true

// Normalize to lowercase colon form ("aa:bb:cc:dd:ee:ff"); "" if invalid.
fn mac_normalize(mac: string) -> string
    if not mac_valid(mac)
        return ""
    let h = _mac_hexonly(mac)
    let out_parts = []
    for i in 0..12
        if i > 0 and i % 2 == 0
            push(out_parts, ":")
        push(out_parts, char_at(h, i))
    let out = join(out_parts, "")
    out

// The OUI (first 3 bytes, vendor prefix) as "aa:bb:cc"; "" if invalid.
fn mac_oui(mac: string) -> string
    let n = mac_normalize(mac)
    if len(n) < 8
        return ""
    slice(n, 0, 8)
