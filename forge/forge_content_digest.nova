// forge_content_digest -- the RFC 9530 Content-Digest HTTP header: a cryptographic digest of the message body
// so a receiver can verify the payload was not truncated or tampered with in transit (integrity, independent of
// TLS -- useful for signed webhooks, proxied uploads, and content-addressed caches). The header uses HTTP
// structured fields: a dictionary member whose value is a byte-sequence (`:<base64>:`), e.g.
//   Content-Digest: sha-256=:uU0nuZNNPgilLlLX2n2r+sSE7+N6U4DukIj3rOLvzek=:
// This module builds and verifies the SHA-256 variant. Composes forge_crypto (sha256_bytes + base64). LEAF-ish:
// imports only forge_crypto.

import forge_crypto

// The `sha-256=:<base64-of-raw-digest>:` structured-field value for a body. This is the whole header VALUE
// (the caller sets it as `Content-Digest: <value>`).
fn content_digest_sha256(body: string) -> string
    let digest = sha256_bytes(str_to_blist(body))
    let b64 = b64_encode_blist(digest)
    "sha-256=:{b64}:"

// Verify an inbound Content-Digest value against the actual body: recompute and compare. Constant-work compare
// is not needed here (the digest is not a secret) -- this guards integrity, not authentication.
fn content_digest_verify(body: string, header_value: string) -> bool
    content_digest_sha256(body) == header_value
