// forge_batch_processor — Batch processing framework.
// Accumulate items, process in batches, track progress/errors.
//
// RAISED 2026-08-05. Five problems:
//
//   1. bp_new built the state dict as six individual assignments. Dict literal.
//   2. bp_flush split the buffer with a while-index loop + if/else. Comprehension slices.
//   3. bp_flush / bp_record_error used `bp["x"] = bp["x"] + n`. Compound `+=`.
//   4. bp_flush built the result dict as two assignments. Dict literal.
//   5. bp_should_flush / bp_error_rate had multi-line if/return. Ternary.

fn bp_new(batch_size: int) -> dict
    {"batch_size": batch_size, "buffer": [], "batches_processed": 0, "items_processed": 0, "errors": 0, "results": []}

fn bp_add(bp: dict, item: string) -> dict
    push(bp["buffer"], item)
    bp

fn bp_buffer_size(bp: dict) -> int
    len(bp["buffer"])

fn bp_should_flush(bp: dict) -> int
    1 if len(bp["buffer"]) >= bp["batch_size"] else 0

fn bp_flush(bp: dict) -> dict
    let buf = bp["buffer"]
    let bs = bp["batch_size"]
    let n = len(buf)
    if n == 0
        return bp
    let batch = [buf[i] for i in 0..min(bs, n)]
    bp["buffer"] = [buf[i] for i in bs..n]
    bp["batches_processed"] += 1
    bp["items_processed"] += len(batch)
    push(bp["results"], {"batch_num": bp["batches_processed"], "count": len(batch)})
    bp

fn bp_flush_all(bp: dict) -> dict
    while len(bp["buffer"]) > 0
        bp = bp_flush(bp)
    bp

fn bp_record_error(bp: dict) -> dict
    bp["errors"] += 1
    bp

fn bp_batches_processed(bp: dict) -> int
    bp["batches_processed"]

fn bp_items_processed(bp: dict) -> int
    bp["items_processed"]

fn bp_error_count(bp: dict) -> int
    bp["errors"]

fn bp_error_rate(bp: dict) -> int
    0 if bp["items_processed"] == 0 else (bp["errors"] * 100) / bp["items_processed"]
