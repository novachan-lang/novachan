// forge_batch_processor — Batch processing framework.
// Accumulate items, process in batches, track progress/errors.

fn bp_new(batch_size: int) -> dict
    let bp = {}
    bp["batch_size"] = batch_size
    bp["buffer"] = []
    bp["batches_processed"] = 0
    bp["items_processed"] = 0
    bp["errors"] = 0
    bp["results"] = []
    bp

fn bp_add(bp: dict, item: string) -> dict
    push(bp["buffer"], item)
    bp

fn bp_buffer_size(bp: dict) -> int
    len(bp["buffer"])

fn bp_should_flush(bp: dict) -> int
    if len(bp["buffer"]) >= bp["batch_size"]
        return 1
    0

fn bp_flush(bp: dict) -> dict
    let batch = []
    let remaining = []
    let i = 0
    while i < len(bp["buffer"])
        if i < bp["batch_size"]
            push(batch, bp["buffer"][i])
        else
            push(remaining, bp["buffer"][i])
        i += 1
    if len(batch) == 0
        return bp
    bp["buffer"] = remaining
    bp["batches_processed"] = bp["batches_processed"] + 1
    bp["items_processed"] = bp["items_processed"] + len(batch)
    let result = {}
    result["batch_num"] = bp["batches_processed"]
    result["count"] = len(batch)
    push(bp["results"], result)
    bp

fn bp_flush_all(bp: dict) -> dict
    while len(bp["buffer"]) > 0
        bp = bp_flush(bp)
    bp

fn bp_record_error(bp: dict) -> dict
    bp["errors"] = bp["errors"] + 1
    bp

fn bp_batches_processed(bp: dict) -> int
    bp["batches_processed"]

fn bp_items_processed(bp: dict) -> int
    bp["items_processed"]

fn bp_error_count(bp: dict) -> int
    bp["errors"]

fn bp_error_rate(bp: dict) -> int
    if bp["items_processed"] == 0
        return 0
    (bp["errors"] * 100) / bp["items_processed"]
