// forge_method_security — method-level security (@PreAuthorize/@Secured) — guard a service action with
// the caller's principal + required role(s) BEFORE it runs, returning {allowed,value} so the caller
// sends 403 on deny. The principal is a dict with a "roles" list (from the session/JWT). No filter
// chain, explicit + testable.
//
// Verified by reasoning: has_role({"roles":["admin"]},"admin")=true; pre_authorize with a matching
// role runs the action; a non-matching role returns {allowed:false}.
//
// LEAF MODULE — imports NOTHING. Only NOVA builtins: contains/len.

// has_role(principal, role) -> bool
// True iff the principal dict has a "roles" list that contains `role`. Fail-closed: if the principal
// has no "roles" key the result is false (not a crash), matching Spring @PreAuthorize behavior where
// an unauthenticated or role-less principal is always denied.
fn has_role(principal: dict, role: string) -> bool
    if "roles" not in principal
        return false
    let roles = principal["roles"]
    role in roles

// has_any_role(principal, roles) -> bool
// True iff the principal has AT LEAST ONE role from the `roles` list. Equivalent to
// @PreAuthorize("hasAnyRole('A','B')"). Returns false immediately when the principal lacks a "roles"
// key, so unauthenticated callers are always denied.
fn has_any_role(principal: dict, roles: list) -> bool
    for i in 0..len(roles)
        if has_role(principal, roles[i])
            return true
    false

// has_all_roles(principal, roles) -> bool
// True iff the principal has EVERY role in `roles`. Equivalent to multiple @PreAuthorize checks
// ANDed together. An empty `roles` list returns true (vacuously satisfied), consistent with set
// semantics and matching how Spring evaluates an empty authority list.
fn has_all_roles(principal: dict, roles: list) -> bool
    for i in 0..len(roles)
        if not has_role(principal, roles[i])
            return false
    true

// pre_authorize(principal, role, action) -> dict
// The @PreAuthorize guard: requires the caller to hold a single `role` before running `action`.
// `action` is a 0-arg closure — the service method body. If the role check passes, action() is
// called and its return value is placed in {allowed:true, value:<result>}. On deny, returns
// {allowed:false, value:0} — the caller maps that to HTTP 403 Forbidden. Structurally mirrors
// Spring @PreAuthorize("hasRole('X')") but is an explicit first-class function, not an annotation
// processed via AOP proxy: it is trivially testable without container setup.
fn pre_authorize(principal: dict, role: string, action) -> dict
    if has_role(principal, role)
        return {"allowed": true, "value": action()}
    {"allowed": false, "value": 0}

// secured(principal, roles, action) -> dict
// Like pre_authorize but requires ANY role from `roles` — equivalent to @Secured({"ROLE_A","ROLE_B"}).
// Spring @Secured is historically the simpler of the two annotations (no SpEL), requiring the caller
// to hold at least one named role. Returns the same {allowed,value} contract as pre_authorize so
// callers handle both identically: check allowed, send 403 on false, unwrap value on true.
fn secured(principal: dict, roles: list, action) -> dict
    if has_any_role(principal, roles)
        return {"allowed": true, "value": action()}
    {"allowed": false, "value": 0}
