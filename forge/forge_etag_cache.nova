// forge_etag_cache — HTTP ETag-based caching with conditional request support.

fn ec_new() -> dict
    {"entries": {}, "hits": 0, "misses": 0, "version": 0}

fn ec_set(e: dict, path: string, body: string) -> dict
    e["version"] += 1
    let etag = str(e["version"])
    e["entries"][path + "_body"] = body
    e["entries"][path + "_etag"] = etag
    e

fn ec_get(e: dict, path: string) -> dict
    let bkey = path + "_body"
    if bkey in e["entries"]
        e["hits"] += 1
        return {"found": 1, "body": e["entries"][bkey], "etag": e["entries"][path + "_etag"], "e": e}
    e["misses"] += 1
    {"found": 0, "body": "", "etag": "", "e": e}

fn ec_check_etag(e: dict, path: string, if_none_match: string) -> dict
    let ekey = path + "_etag"
    if ekey not in e["entries"]
        return {"status": 404, "body": "", "etag": ""}
    let etag = e["entries"][ekey]
    if etag == if_none_match
        return {"status": 304, "body": "", "etag": etag}
    {"status": 200, "body": e["entries"][path + "_body"], "etag": etag}

fn ec_invalidate(e: dict, path: string) -> dict
    let new_entries = {}
    let ks = keys(e["entries"])
    let prefix1 = path + "_body"
    let prefix2 = path + "_etag"
    for i in 0..len(ks)
        if ks[i] != prefix1
            if ks[i] != prefix2
                new_entries[ks[i]] = e["entries"][ks[i]]
    e["entries"] = new_entries
    e

fn ec_hit_rate(e: dict) -> int
    let total = e["hits"] + e["misses"]
    if total == 0
        return 0
    e["hits"] * 100 / total
