// forge_etag_cache — HTTP ETag-based caching with conditional request support.

fn ec_new() -> dict
    let e = {}
    e["entries"] = {}
    e["hits"] = 0
    e["misses"] = 0
    e["version"] = 0
    e

fn ec_set(e: dict, path: string, body: string) -> dict
    e["version"] = e["version"] + 1
    let etag = str(e["version"])
    e["entries"][path + "_body"] = body
    e["entries"][path + "_etag"] = etag
    e

fn ec_get(e: dict, path: string) -> dict
    let result = {}
    let has = contains(e["entries"], path + "_body")
    if has == true
        e["hits"] = e["hits"] + 1
        result["found"] = 1
        result["body"] = e["entries"][path + "_body"]
        result["etag"] = e["entries"][path + "_etag"]
    else
        e["misses"] = e["misses"] + 1
        result["found"] = 0
        result["body"] = ""
        result["etag"] = ""
    result["e"] = e
    result

fn ec_check_etag(e: dict, path: string, if_none_match: string) -> dict
    let result = {}
    let has = contains(e["entries"], path + "_etag")
    if has == true
        if e["entries"][path + "_etag"] == if_none_match
            result["status"] = 304
            result["body"] = ""
        else
            result["status"] = 200
            result["body"] = e["entries"][path + "_body"]
        result["etag"] = e["entries"][path + "_etag"]
    else
        result["status"] = 404
        result["body"] = ""
        result["etag"] = ""
    result

fn ec_invalidate(e: dict, path: string) -> dict
    let new_entries = {}
    let ks = keys(e["entries"])
    let prefix1 = path + "_body"
    let prefix2 = path + "_etag"
    let i = 0
    while i < len(ks)
        if ks[i] != prefix1
            if ks[i] != prefix2
                new_entries[ks[i]] = e["entries"][ks[i]]
        i = i + 1
    e["entries"] = new_entries
    e

fn ec_hit_rate(e: dict) -> int
    let total = e["hits"] + e["misses"]
    if total == 0
        return 0
    e["hits"] * 100 / total
