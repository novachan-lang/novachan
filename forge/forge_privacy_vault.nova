// forge_privacy_vault — Store PII with access controls and retention.

fn pv_new() -> dict
    {"records": {}, "access_log": {}, "record_count": 0, "access_count": 0, "retention_days": 90}

fn pv_set_retention(p: dict, days: int) -> dict
    p["retention_days"] = days
    p

fn pv_store(p: dict, subject_id: string, field: string, value: string) -> dict
    p["records"]["{subject_id}:{field}"] = value
    p["record_count"] += 1
    p

fn pv_retrieve(p: dict, subject_id: string, field: string, accessor: string) -> dict
    let key = "{subject_id}:{field}"
    if key not in p["records"]
        return {"found": 0, "value": "", "p": p}
    let ak = str(p["access_count"])
    p["access_log"]["{ak}_subject"] = subject_id
    p["access_log"]["{ak}_field"] = field
    p["access_log"]["{ak}_accessor"] = accessor
    p["access_count"] += 1
    {"found": 1, "value": p["records"][key], "p": p}

fn pv_delete_subject(p: dict, subject_id: string) -> dict
    let ks = keys(p["records"])
    let prefix = subject_id + ":"
    let plen = len(prefix)
    for i in 0..len(ks)
        let k = ks[i]
        if len(k) >= plen
            if slice(k, 0, plen) == prefix
                p["records"][k] = ""
    p

fn pv_access_count(p: dict) -> int
    p["access_count"]

fn pv_record_count(p: dict) -> int
    p["record_count"]

fn pv_last_accessor(p: dict) -> string
    if p["access_count"] == 0
        return ""
    let ak = str(p["access_count"] - 1)
    p["access_log"]["{ak}_accessor"]
