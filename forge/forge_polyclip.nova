// forge_polyclip -- clip a polygon against a rectangle or any convex region (Sutherland-Hodgman algorithm).
// Clipping keeps only the part of a shape that lies inside a boundary: cropping map features to a viewport or
// tile, restricting a drawing to a window, computing the overlap of a region with a bounding box, and culling
// geometry that falls outside the visible area before rendering. It works edge by edge: for each side of the
// clip region it walks the subject polygon, keeping vertices that are inside and inserting new vertices exactly
// where edges cross the boundary. Polygons are lists of [x, y] vertices; the clip region must be CONVEX (a
// rectangle always is). Uses cross-product side tests and line intersection -- no square roots. LEAF.

// PRIVATE: is point (px,py) on the inside (left) of the directed clip edge a->b?
fn _pc_inside(ax: float, ay: float, bx: float, by: float, px: float, py: float) -> bool
    let cross = (bx - ax) * (py - ay) - (by - ay) * (px - ax)
    cross >= 0.0

// PRIVATE: intersection of segment p->q with the infinite line through a->b, as [x, y].
fn _pc_intersect(p: list, q: list, ax: float, ay: float, bx: float, by: float) -> list
    let x1 = p[0] * 1.0
    let y1 = p[1] * 1.0
    let x2 = q[0] * 1.0
    let y2 = q[1] * 1.0
    let denom = (x1 - x2) * (ay - by) - (y1 - y2) * (ax - bx)
    let out = [x1, y1]
    if denom != 0.0
        let t = ((x1 - ax) * (ay - by) - (y1 - ay) * (ax - bx)) / denom
        out = [x1 + t * (x2 - x1), y1 + t * (y2 - y1)]
    out

// PRIVATE: clip `subject` polygon against a single directed edge a->b, keeping the inside.
fn _pc_clip_edge(subject: list, ax: float, ay: float, bx: float, by: float) -> list
    let out = []
    let n = len(subject)
    if n > 0
        for i in 0..n
            let p = subject[i]
            let qi = i + 1
            if qi == n
                qi = 0
            let q = subject[qi]
            let p_in = _pc_inside(ax, ay, bx, by, p[0] * 1.0, p[1] * 1.0)
            let q_in = _pc_inside(ax, ay, bx, by, q[0] * 1.0, q[1] * 1.0)
            if q_in
                if p_in == false
                    push(out, _pc_intersect(p, q, ax, ay, bx, by))
                push(out, [q[0] * 1.0, q[1] * 1.0])
            else
                if p_in
                    push(out, _pc_intersect(p, q, ax, ay, bx, by))
    out

// Clip `subject` against a CONVEX `clip` polygon (both lists of [x,y]; clip given counter-clockwise). Returns
// the clipped polygon's vertices (empty if nothing is inside).
fn clip_polygon(subject: list, clip: list) -> list
    let result = subject
    let cn = len(clip)
    for e in 0..cn
        let a = clip[e]
        let bi = e + 1
        if bi == cn
            bi = 0
        let b = clip[bi]
        result = _pc_clip_edge(result, a[0] * 1.0, a[1] * 1.0, b[0] * 1.0, b[1] * 1.0)
    result

// Clip `subject` against the axis-aligned rectangle [minx,miny]..[maxx,maxy].
fn clip_rect(subject: list, minx, miny, maxx, maxy) -> list
    let rect = [[minx * 1.0, miny * 1.0], [maxx * 1.0, miny * 1.0], [maxx * 1.0, maxy * 1.0], [minx * 1.0, maxy * 1.0]]
    clip_polygon(subject, rect)
