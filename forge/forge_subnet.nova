// forge_subnet -- IPv4 subnet math from a CIDR: network (base) address, broadcast (last) address, host count,
// and netmask. For network planning, IP allocation, and "how many hosts fit in a /24". Complements
// forge_ipcidr (membership tests). Masking via boundary-floor (no bitwise-AND). LEAF -- imports NOTHING.

fn _sn_pow2(n: int) -> int
    let v = 1
    for i in 0..n
        v = v * 2
    v

fn _sn_ip_to_int(ip: string) -> int
    let parts = split(ip, ".")
    if len(parts) != 4
        return -1
    let v = 0
    for i in 0..4
        v = v * 256 + parse_int(parts[i])
    v

fn _sn_int_to_ip(v: int) -> string
    let a = (v / 16777216) % 256
    let b = (v / 65536) % 256
    let c = (v / 256) % 256
    let d = v % 256
    "{a}.{b}.{c}.{d}"

// Total addresses in a /prefix (2^(32-prefix)). subnet_size(24) -> 256.
fn subnet_size(prefix: int) -> int
    _sn_pow2(32 - prefix)

// The network (base) address of "a.b.c.d/prefix".
fn subnet_network(cidr: string) -> string
    let slash = find(cidr, "/")
    if slash < 0
        return ""
    let ip = _sn_ip_to_int(slice(cidr, 0, slash))
    let block = _sn_pow2(32 - parse_int(slice(cidr, slash + 1, len(cidr))))
    _sn_int_to_ip((ip / block) * block)

// The broadcast (last) address of the subnet.
fn subnet_broadcast(cidr: string) -> string
    let slash = find(cidr, "/")
    if slash < 0
        return ""
    let ip = _sn_ip_to_int(slice(cidr, 0, slash))
    let block = _sn_pow2(32 - parse_int(slice(cidr, slash + 1, len(cidr))))
    _sn_int_to_ip((ip / block) * block + block - 1)

// The netmask string for a prefix ("255.255.255.0" for /24).
fn subnet_netmask(prefix: int) -> string
    _sn_int_to_ip(4294967296 - _sn_pow2(32 - prefix))
