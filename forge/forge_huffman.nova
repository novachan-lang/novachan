// forge_huffman -- Huffman coding, the optimal PREFIX-FREE entropy coder and the final stage of gzip, bzip2, JPEG
// and MP3. Fixed-width encoding spends 8 bits on every character no matter how common it is; Huffman instead gives
// FREQUENT symbols SHORT bit-codes and rare ones longer codes, provably minimizing the total bits for a given set
// of symbol frequencies. It builds a binary tree by repeatedly merging the two least-frequent nodes, so a symbol's
// depth (code length) is inversely related to its frequency, and because every symbol is a LEAF no code is a
// prefix of another -- the bitstream decodes unambiguously with no separators. This is what compresses the
// zero-heavy stream that BWT+MTF (forge_bwt/forge_mtf) produce, and it's the textbook building block for any
// custom compressor. The codebook is derived from the input's own frequencies. Bits are represented as a string of
// '0'/'1'. LEAF -- imports NOTHING.

// PRIVATE: recursion-free depth-first walk that fills `codes` (char -> bit-string) from the tree in the parallel
// arrays nleft/nright/nsym, rooted at `root`.
fn _huff_codes_from_tree(nleft: list, nright: list, nsym: list, root: int, codes: dict)
    let stack_node = [root]
    let stack_pref = [""]
    while len(stack_node) > 0
        let node = pop(stack_node)
        let prefix = pop(stack_pref)
        if nleft[node] == 0 - 1
            codes[nsym[node]] = prefix
        else
            push(stack_node, nleft[node])
            push(stack_pref, prefix + "0")
            push(stack_node, nright[node])
            push(stack_pref, prefix + "1")

// Build the Huffman codebook for s: a dict mapping each character to its '0'/'1' bit-code, derived from s's
// character frequencies. A string of one distinct character maps it to "0".
fn huffman_build(s: string) -> dict
    let codes = {}
    let n = len(s)
    if n > 0
        // frequencies
        let freq = {}
        for i in 0..n
            let ch = char_at(s, i)
            freq[ch] = get(freq, ch, 0) + 1
        let distinct = keys(freq)
        // leaf nodes in parallel arrays
        let nleft = []
        let nright = []
        let nsym = []
        let nfreq = []
        let active = []
        for d in 0..len(distinct)
            push(nsym, distinct[d])
            push(nfreq, freq[distinct[d]])
            push(nleft, 0 - 1)
            push(nright, 0 - 1)
            push(active, len(nsym) - 1)
        if len(active) == 1
            codes[distinct[0]] = "0"
        else
            while len(active) > 1
                // two active positions with the smallest frequency
                let i1 = 0
                for k in 1..len(active)
                    if nfreq[active[k]] < nfreq[active[i1]]
                        i1 = k
                let i2 = 0 - 1
                for k2 in 0..len(active)
                    if k2 != i1
                        if i2 < 0 or nfreq[active[k2]] < nfreq[active[i2]]
                            i2 = k2
                let a = active[i1]
                let b = active[i2]
                // new internal node
                push(nsym, "")
                push(nfreq, nfreq[a] + nfreq[b])
                push(nleft, a)
                push(nright, b)
                let newidx = len(nsym) - 1
                // active without i1,i2, plus the new node
                let newactive = []
                for z in 0..len(active)
                    if z != i1 and z != i2
                        push(newactive, active[z])
                push(newactive, newidx)
                active = newactive
            _huff_codes_from_tree(nleft, nright, nsym, active[0], codes)
    codes

// Encode s to a '0'/'1' bit-string using a codebook from huffman_build.
fn huffman_encode(s: string, codes: dict) -> string
    let out = ""
    for i in 0..len(s)
        out += get(codes, char_at(s, i), "")
    out

// Decode a '0'/'1' bit-string back to text using the same codebook (prefix-free, so greedy matching is
// unambiguous).
fn huffman_decode(bits: string, codes: dict) -> string
    // reverse map: code -> character
    let rev = {}
    let ks = keys(codes)
    for i in 0..len(ks)
        rev[codes[ks[i]]] = ks[i]
    let out_parts = []
    let cur = ""
    for p in 0..len(bits)
        cur += char_at(bits, p)
        if cur in rev
            push(out_parts, rev[cur])
            cur = ""
    let out = join(out_parts, "")
    out

// The number of bits Huffman needs for s (vs 8*len(s) for fixed-width) -- a direct measure of the savings.
fn huffman_encoded_bits(s: string) -> int
    let codes = huffman_build(s)
    len(huffman_encode(s, codes))
