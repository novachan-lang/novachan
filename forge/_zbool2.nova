import sqlitex
fn main()
    print("type_name(true) = {type_name(true)}")
    print("str(true) = {str(true)}")
    let db = db_open(":memory:")
    db_exec(db, "CREATE TABLE t (flag INTEGER, f REAL)")
    print("bind literal true:")
    let r = db_write(db, "INSERT INTO t (flag, f) VALUES (?, ?)", [true, 3.5])
    print(is_ok(r))
    if is_err(r)
        print(unwrap_err(r))
    print(db_query_named(db, "SELECT * FROM t", []))
    print("SURVIVED")
