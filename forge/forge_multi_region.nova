// forge_multi_region — Multi-region routing with failover.

fn mr_new() -> dict
    let m = {}
    m["regions"] = {}
    m["count"] = 0
    m["primary"] = ""
    m["failovers"] = 0
    m

fn mr_add_region(m: dict, name: string, priority: int) -> dict
    let k = str(m["count"])
    m["regions"][k + "_name"] = name
    m["regions"][k + "_priority"] = priority
    m["regions"][k + "_healthy"] = 1
    m["count"] = m["count"] + 1
    if len(m["primary"]) == 0
        m["primary"] = name
    m

fn mr_set_primary(m: dict, name: string) -> dict
    m["primary"] = name
    m

fn mr_mark_down(m: dict, name: string) -> dict
    let i = 0
    while i < m["count"]
        let k = str(i)
        if m["regions"][k + "_name"] == name
            m["regions"][k + "_healthy"] = 0
        i = i + 1
    m

fn mr_mark_up(m: dict, name: string) -> dict
    let i = 0
    while i < m["count"]
        let k = str(i)
        if m["regions"][k + "_name"] == name
            m["regions"][k + "_healthy"] = 1
        i = i + 1
    m

fn mr_route(m: dict) -> string
    let i = 0
    while i < m["count"]
        let k = str(i)
        if m["regions"][k + "_name"] == m["primary"]
            if m["regions"][k + "_healthy"] == 1
                return m["primary"]
        i = i + 1
    let best = ""
    let best_pri = -1
    let j = 0
    while j < m["count"]
        let k = str(j)
        if m["regions"][k + "_healthy"] == 1
            if m["regions"][k + "_priority"] > best_pri
                best_pri = m["regions"][k + "_priority"]
                best = m["regions"][k + "_name"]
        j = j + 1
    if len(best) > 0
        m["failovers"] = m["failovers"] + 1
    best

fn mr_region_count(m: dict) -> int
    m["count"]

fn mr_failover_count(m: dict) -> int
    m["failovers"]
