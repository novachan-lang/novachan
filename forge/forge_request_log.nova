// forge_request_log — HTTP request logging/middleware.
// Log requests with method/path/status/duration, query, filter.

fn rl_new() -> dict
    {"entries": [], "total": 0}

fn rl_log(rl: dict, method: string, path: string, status: int, duration_ms: int) -> dict
    push(rl["entries"], {"method": method, "path": path, "status": status, "duration_ms": duration_ms})
    rl["total"] += 1
    rl

fn rl_total(rl: dict) -> int
    rl["total"]

fn rl_by_status(rl: dict, status: int) -> list
    [e for e in rl["entries"] if e["status"] == status]

fn rl_by_method(rl: dict, method: string) -> list
    [e for e in rl["entries"] if e["method"] == method]

fn rl_errors(rl: dict) -> list
    [e for e in rl["entries"] if e["status"] >= 400]

fn rl_error_count(rl: dict) -> int
    len(rl_errors(rl))

fn rl_avg_duration(rl: dict) -> int
    if rl["total"] == 0
        return 0
    let sum = 0
    for e in rl["entries"]
        sum += e["duration_ms"]
    sum / rl["total"]

fn rl_slowest(rl: dict) -> dict
    if rl["total"] == 0
        return {"duration_ms": 0}
    let max_dur = 0
    let max_idx = 0
    for i in 0..len(rl["entries"])
        if rl["entries"][i]["duration_ms"] > max_dur
            max_dur = rl["entries"][i]["duration_ms"]
            max_idx = i
    rl["entries"][max_idx]

fn rl_last_n(rl: dict, n: int) -> list
    let start = max(len(rl["entries"]) - n, 0)
    [rl["entries"][i] for i in start..len(rl["entries"])]
