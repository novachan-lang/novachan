// forge_request_log — HTTP request logging/middleware.
// Log requests with method/path/status/duration, query, filter.

fn rl_new() -> dict
    let rl = {}
    rl["entries"] = []
    rl["total"] = 0
    rl

fn rl_log(rl: dict, method: string, path: string, status: int, duration_ms: int) -> dict
    let entry = {}
    entry["method"] = method
    entry["path"] = path
    entry["status"] = status
    entry["duration_ms"] = duration_ms
    push(rl["entries"], entry)
    rl["total"] = rl["total"] + 1
    rl

fn rl_total(rl: dict) -> int
    rl["total"]

fn rl_by_status(rl: dict, status: int) -> list
    let result = []
    let i = 0
    while i < len(rl["entries"])
        if rl["entries"][i]["status"] == status
            push(result, rl["entries"][i])
        i = i + 1
    result

fn rl_by_method(rl: dict, method: string) -> list
    let result = []
    let i = 0
    while i < len(rl["entries"])
        if rl["entries"][i]["method"] == method
            push(result, rl["entries"][i])
        i = i + 1
    result

fn rl_errors(rl: dict) -> list
    let result = []
    let i = 0
    while i < len(rl["entries"])
        if rl["entries"][i]["status"] >= 400
            push(result, rl["entries"][i])
        i = i + 1
    result

fn rl_error_count(rl: dict) -> int
    len(rl_errors(rl))

fn rl_avg_duration(rl: dict) -> int
    if rl["total"] == 0
        return 0
    let sum = 0
    let i = 0
    while i < len(rl["entries"])
        sum = sum + rl["entries"][i]["duration_ms"]
        i = i + 1
    sum / rl["total"]

fn rl_slowest(rl: dict) -> dict
    if rl["total"] == 0
        let empty = {}
        empty["duration_ms"] = 0
        return empty
    let max_dur = 0
    let max_idx = 0
    let i = 0
    while i < len(rl["entries"])
        if rl["entries"][i]["duration_ms"] > max_dur
            max_dur = rl["entries"][i]["duration_ms"]
            max_idx = i
        i = i + 1
    rl["entries"][max_idx]

fn rl_last_n(rl: dict, n: int) -> list
    let result = []
    let start = len(rl["entries"]) - n
    if start < 0
        start = 0
    let i = start
    while i < len(rl["entries"])
        push(result, rl["entries"][i])
        i = i + 1
    result
