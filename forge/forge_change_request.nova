fn cr_new()
    {"cr_count": 0, "cr_ids": "", "approved_count": 0, "rejected_count": 0}

fn cr_submit(s, cr_id, title, requester, impact)
    let idx = int(s["cr_count"])
    let k = str(idx)
    s["cr_{k}_id"] = cr_id
    s["cr_{k}_title"] = title
    s["cr_{k}_requester"] = requester
    s["cr_{k}_impact"] = impact
    s["cr_{k}_status"] = "pending"
    s["cr_{k}_approvals"] = 0
    s["cr_count"] = idx + 1
    let ids = str(s["cr_ids"])
    s["cr_ids"] = cr_id if ids == "" else "{ids},{cr_id}"
    return s

fn _cr_find(s, cr_id)
    let cnt = int(s["cr_count"])
    for i in 0..cnt
        let k = str(i)
        if str(s["cr_{k}_id"]) == cr_id
            return i
    return -1

fn cr_approve(s, cr_id, approver) -> Result
    let ci = _cr_find(s, cr_id)
    if ci < 0
        return err("CR not found: {cr_id}")
    let k = str(ci)
    let status = str(s["cr_{k}_status"])
    if status != "pending"
        return err("CR not pending: {status}")
    let req = str(s["cr_{k}_requester"])
    if req == approver
        return err("self-approval not allowed")
    s["cr_{k}_approvals"] = int(s["cr_{k}_approvals"]) + 1
    s["cr_{k}_status"] = "approved"
    s["approved_count"] = int(s["approved_count"]) + 1
    return ok(s)

fn cr_reject(s, cr_id, reason) -> Result
    let ci = _cr_find(s, cr_id)
    if ci < 0
        return err("CR not found: {cr_id}")
    let k = str(ci)
    let status = str(s["cr_{k}_status"])
    if status != "pending"
        return err("CR not pending: {status}")
    s["cr_{k}_status"] = "rejected"
    s["cr_{k}_reject_reason"] = reason
    s["rejected_count"] = int(s["rejected_count"]) + 1
    return ok(s)

fn cr_status(s, cr_id) -> Result
    let ci = _cr_find(s, cr_id)
    if ci < 0
        return err("CR not found: {cr_id}")
    let k = str(ci)
    return ok(str(s["cr_{k}_status"]))

fn cr_impact(s, cr_id) -> Result
    let ci = _cr_find(s, cr_id)
    if ci < 0
        return err("CR not found: {cr_id}")
    let k = str(ci)
    return ok(str(s["cr_{k}_impact"]))

fn cr_total(s)
    return int(s["cr_count"])

fn cr_approved_count(s)
    return int(s["approved_count"])

fn cr_rejected_count(s)
    return int(s["rejected_count"])

fn cr_pending_count(s)
    return int(s["cr_count"]) - int(s["approved_count"]) - int(s["rejected_count"])

fn cr_id_list(s)
    return str(s["cr_ids"])

fn cr_has(s, cr_id)
    let ci = _cr_find(s, cr_id)
    if ci >= 0
        return 1
    return 0
