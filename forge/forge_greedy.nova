// forge_greedy -- a handful of classic GREEDY / one-pass problems where making the locally-optimal choice at each
// step provably reaches the global optimum, so each is solved in a single O(n) sweep with no search or DP table.
// jump_game asks whether you can reach the end of an array where each cell says how far you may hop from it (track
// the farthest index still reachable); min_jumps counts the FEWEST hops to get there (a greedy BFS by "jump
// levels"). gas_station finds where to start a circular fuel route so you never run dry -- if the total fuel covers
// the total cost, the answer is just past the point where the tank last went negative. max_non_adjacent_sum is the
// "house robber" problem: the largest sum of elements with no two adjacent (rob houses without tripping two in a
// row). These patterns show up in reachability and hop-count routing, circular scheduling/logistics, and picking
// non-conflicting items for maximum value. Integer arrays (non-negative where noted). LEAF -- imports NOTHING.

// True if you can reach the last index, where nums[i] is the maximum jump length from position i.
fn jump_game(nums: list) -> bool
    let n = len(nums)
    let out = true
    if n > 0
        let farthest = 0
        let i = 0
        while i < n and out
            if i > farthest
                out = false
            else
                let reach = i + nums[i]
                if reach > farthest
                    farthest = reach
            i = i + 1
    out

// The minimum number of jumps to reach the last index (assumes it is reachable). 0 for a single element.
fn min_jumps(nums: list) -> int
    let n = len(nums)
    let jumps = 0
    let cur_end = 0
    let farthest = 0
    let i = 0
    while i < n - 1
        let reach = i + nums[i]
        if reach > farthest
            farthest = reach
        if i == cur_end
            jumps = jumps + 1
            cur_end = farthest
        i = i + 1
    jumps

// The index to START a circular route so you can complete the loop without the fuel tank going negative, or -1 if
// impossible. gas[i] is fuel gained at station i; cost[i] is fuel to reach station i+1.
fn gas_station(gas: list, cost: list) -> int
    let n = len(gas)
    let total = 0
    let tank = 0
    let start = 0
    let i = 0
    while i < n
        let diff = gas[i] - cost[i]
        total = total + diff
        tank = tank + diff
        if tank < 0
            start = i + 1
            tank = 0
        i = i + 1
    let out = 0 - 1
    if total >= 0
        out = start
    out

// The maximum sum of a subset of `nums` with no two chosen elements adjacent (the house-robber problem).
fn max_non_adjacent_sum(nums: list) -> int
    let incl = 0
    let excl = 0
    let i = 0
    while i < len(nums)
        let new_incl = excl + nums[i]
        if incl > excl
            excl = incl
        incl = new_incl
        i = i + 1
    let out = incl
    if excl > out
        out = excl
    out
