// forge_di — Dependency injection container.
// Register services by name + factory fn, resolve with auto-wiring.
// Singleton and transient lifetimes. Pure data structures.

fn di_container() -> dict
    {"services": {}, "singletons": {}, "instances": {}}

fn di_register(c: dict, name: string, factory_value: any, lifetime: string) -> dict
    c["services"][name] = {"value": factory_value, "lifetime": lifetime}
    c

fn di_singleton(c: dict, name: string, value: any) -> dict
    c["services"][name] = {"value": value, "lifetime": "singleton"}
    c["instances"][name] = value
    c

fn di_transient(c: dict, name: string, factory_value: any) -> dict
    c["services"][name] = {"value": factory_value, "lifetime": "transient"}
    c

fn di_resolve(c: dict, name: string) -> any
    if name not in c["services"]
        return null
    let svc = c["services"][name]
    if svc["lifetime"] == "singleton"
        if name in c["instances"]
            return c["instances"][name]
        let instance = svc["value"]
        c["instances"][name] = instance
        return instance
    svc["value"]

fn di_has(c: dict, name: string) -> bool
    name in c["services"]

fn di_remove(c: dict, name: string) -> dict
    if name in c["services"]
        delete(c["services"], name)
    if name in c["instances"]
        delete(c["instances"], name)
    c

fn di_list_services(c: dict) -> list
    keys(c["services"])

fn di_scope(parent: dict) -> dict
    let child = di_container()
    child["services"] = parent["services"]
    child["singletons"] = parent["singletons"]
    child

fn di_override(c: dict, name: string, value: any) -> dict
    c["services"][name] = {"value": value, "lifetime": "singleton"}
    c["instances"][name] = value
    c
