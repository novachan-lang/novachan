// forge_murmur -- MurmurHash3 (32-bit, x86 variant), the most widely deployed NON-cryptographic hash: fast, and
// with excellent avalanche and distribution, which is exactly what you want for hash tables, Bloom filters, sharding
// and consistent-hashing keys, feature flags, cache lookups, deduplication, and bucketing -- anywhere you need to
// scatter arbitrary bytes uniformly across buckets but do NOT need to resist an adversary (for that use a keyed
// cryptographic MAC, forge_crypto). MurmurHash3 mixes the input four bytes at a time with two magic multipliers and
// bit-rotations, then a final "fmix" avalanche step that spreads every input bit across the whole 32-bit output.
// It is deterministic, seedable (a different seed gives an independent hash family), and returns a value in
// [0, 2^32). Because MurmurHash needs true 32-bit wraparound multiplication, this masks to 32 bits after each
// multiply (NOVA's 64-bit multiply wraps mod 2^64, whose low 32 bits are exactly the 32-bit product). The core
// takes a list of byte values 0..255 so it handles embedded zero bytes correctly; murmur3_str is a convenience
// wrapper for text. Verified against the canonical SMHasher self-test value 0xB0F57EE3. LEAF -- imports NOTHING.

// PRIVATE: rotate a 32-bit value left by r bits.
fn _mm_rotl32(x: int, r: int) -> int
    let xm = x & 0xFFFFFFFF
    ((xm << r) | (xm >> (32 - r))) & 0xFFFFFFFF

// MurmurHash3 x86 32-bit over a list of byte values (each 0..255), with the given 32-bit seed. Returns the 32-bit
// hash as an integer in [0, 2^32).
fn murmur3_bytes(data: list, seed: int) -> int
    let c1 = 0xcc9e2d51
    let c2 = 0x1b873593
    let h = seed & 0xFFFFFFFF
    let length = len(data)
    let nblocks = length / 4
    // body: process 4-byte little-endian blocks
    let i = 0
    while i < nblocks
        let base = i * 4
        let k = (data[base] & 255) | ((data[base + 1] & 255) << 8) | ((data[base + 2] & 255) << 16) | ((data[base + 3] & 255) << 24)
        k = (k * c1) & 0xFFFFFFFF
        k = _mm_rotl32(k, 15)
        k = (k * c2) & 0xFFFFFFFF
        h = h ^ k
        h = _mm_rotl32(h, 13)
        h = (h * 5 + 0xe6546b64) & 0xFFFFFFFF
        i = i + 1
    // tail: the remaining 1..3 bytes
    let tail = nblocks * 4
    let rem = length - tail
    let k2 = 0
    if rem == 3
        k2 = k2 ^ ((data[tail + 2] & 255) << 16)
    if rem >= 2
        k2 = k2 ^ ((data[tail + 1] & 255) << 8)
    if rem >= 1
        k2 = k2 ^ (data[tail] & 255)
        k2 = (k2 * c1) & 0xFFFFFFFF
        k2 = _mm_rotl32(k2, 15)
        k2 = (k2 * c2) & 0xFFFFFFFF
        h = h ^ k2
    // finalization mix (fmix32): full avalanche
    h = h ^ length
    h = h ^ (h >> 16)
    h = (h * 0x85ebca6b) & 0xFFFFFFFF
    h = h ^ (h >> 13)
    h = (h * 0xc2b2ae35) & 0xFFFFFFFF
    h = h ^ (h >> 16)
    h

// MurmurHash3 x86 32-bit over the bytes of a string. NOTE: NOVA strings are NUL-terminated, so for data that may
// contain a zero byte, use murmur3_bytes with an explicit byte list instead.
fn murmur3_str(s: string, seed: int) -> int
    let data = []
    let i = 0
    while i < len(s)
        push(data, ord(char_at(s, i)))
        i = i + 1
    murmur3_bytes(data, seed)
