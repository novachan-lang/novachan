// forge_data_catalog — Data catalog / metadata registry.
// Register datasets with schema, tags, lineage, search.

fn dc_new() -> dict
    let dc = {}
    dc["datasets"] = {}
    dc

fn dc_register(dc: dict, name: string, owner: string, description: string) -> dict
    let ds = {}
    ds["owner"] = owner
    ds["description"] = description
    ds["tags"] = []
    ds["columns"] = []
    ds["lineage"] = []
    dc["datasets"][name] = ds
    dc

fn dc_add_tag(dc: dict, name: string, tag: string) -> dict
    let has = contains(dc["datasets"], name)
    if has != true
        return dc
    push(dc["datasets"][name]["tags"], tag)
    dc

fn dc_add_column(dc: dict, name: string, col_name: string, col_type: string) -> dict
    let has = contains(dc["datasets"], name)
    if has != true
        return dc
    let col = {}
    col["name"] = col_name
    col["type"] = col_type
    push(dc["datasets"][name]["columns"], col)
    dc

fn dc_add_lineage(dc: dict, name: string, source: string) -> dict
    let has = contains(dc["datasets"], name)
    if has != true
        return dc
    push(dc["datasets"][name]["lineage"], source)
    dc

fn dc_get(dc: dict, name: string) -> dict
    let has = contains(dc["datasets"], name)
    if has != true
        let empty = {}
        empty["owner"] = ""
        return empty
    dc["datasets"][name]

fn dc_search_tag(dc: dict, tag: string) -> list
    let result = []
    let names = keys(dc["datasets"])
    for i in 0..len(names)
        let ds = dc["datasets"][names[i]]
        let j = 0
        while j < len(ds["tags"])
            if ds["tags"][j] == tag
                push(result, names[i])
                j = len(ds["tags"])
            else
                j += 1
    result

fn dc_dataset_count(dc: dict) -> int
    len(keys(dc["datasets"]))

fn dc_column_count(dc: dict, name: string) -> int
    let has = contains(dc["datasets"], name)
    if has != true
        return 0
    len(dc["datasets"][name]["columns"])
