// forge_dns_round_robin — round-robin DNS load distribution with Result API.

fn rr_new() -> dict
    let r = {}
    r["record_count"] = 0
    r["queries"] = 0
    r

fn rr_add_record(r: dict, domain: string, ip: string) -> dict
    let dk = "d_" + domain + "_count"
    if contains(r, dk) == true
        let idx = r[dk]
        r["d_" + domain + "_ip_" + str(idx)] = ip
        r[dk] = idx + 1
    else
        r[dk] = 1
        r["d_" + domain + "_ip_0"] = ip
        r["d_" + domain + "_next"] = 0
    r["record_count"] = r["record_count"] + 1
    r

fn rr_resolve(r: dict, domain: string) -> Result
    r["queries"] = r["queries"] + 1
    let dk = "d_" + domain + "_count"
    if contains(r, dk) != true
        return err("domain not found: " + domain)
    let cnt = r[dk]
    let nk = "d_" + domain + "_next"
    let idx = r[nk]
    let ip = r["d_" + domain + "_ip_" + str(idx)]
    r[nk] = (idx + 1) - ((idx + 1) / cnt) * cnt
    ok(ip)

fn rr_record_count(r: dict) -> int
    r["record_count"]

fn rr_total_queries(r: dict) -> int
    r["queries"]
