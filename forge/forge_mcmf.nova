// forge_mcmf -- Minimum-Cost Maximum-Flow: push as much flow as possible from a source to a sink through a capacitated
// network AND do it as cheaply as possible, where every edge has both a capacity and a per-unit cost. This is the
// single most versatile "optimal allocation" primitive in combinatorial optimization: the transportation and
// assignment problems (match workers to jobs / warehouses to stores at least total cost), min-cost bipartite
// matching, optimal scheduling and load balancing, network routing with tariffs, image-segmentation and
// computer-vision energy minimization, and inventory/logistics planning all reduce to it. The method here is
// successive shortest paths: repeatedly find the CHEAPEST source-to-sink path that still has spare capacity (via a
// Bellman-Ford / SPFA relaxation, which tolerates the negative costs that appear on residual "undo" edges) and push
// as much flow along it as the tightest edge allows, until no augmenting path remains. Because each augmentation
// uses a shortest path, the running total is always the minimum cost for the flow achieved so far. Edges are given
// as [from, to, capacity, cost]; the result is [max_flow, min_cost]. Integer capacities and costs. LEAF.

// Compute the minimum-cost maximum flow from source to sink over n nodes. `edges` is a list of [from, to, cap, cost]
// (directed). Returns [max_flow, min_cost]: the largest total flow and its least possible total cost.
fn min_cost_max_flow(n: int, edges: list, source: int, sink: int) -> list
    // residual graph in parallel arrays; edge i and its reverse i^1 are stored adjacently
    let e_to = []
    let e_cap = []
    let e_cost = []
    let adj = [[] for i in 0..n]
    for ei in 0..len(edges)
        let ed = edges[ei]
        let u = ed[0]
        let v = ed[1]
        let cap = ed[2]
        let cost = ed[3]
        let fidx = len(e_to)
        push(e_to, v)
        push(e_cap, cap)
        push(e_cost, cost)
        let au = adj[u]
        push(au, fidx)
        push(e_to, u)
        push(e_cap, 0)
        push(e_cost, 0 - cost)
        let av = adj[v]
        push(av, fidx + 1)

    let INF = 1000000000
    let total_flow = 0
    let total_cost = 0
    let going = true
    while going
        // SPFA: cheapest cost from source along edges with residual capacity
        let dist = []
        let inq = []
        let prevedge = []
        for z in 0..n
            push(dist, INF)
            push(inq, false)
            push(prevedge, 0 - 1)
        dist[source] = 0
        let queue = [source]
        inq[source] = true
        let head = 0
        while head < len(queue)
            let u = queue[head]
            head += 1
            inq[u] = false
            let alist = adj[u]
            for ai in 0..len(alist)
                let eid = alist[ai]
                let to = e_to[eid]
                if e_cap[eid] > 0 and dist[u] + e_cost[eid] < dist[to]
                    dist[to] = dist[u] + e_cost[eid]
                    prevedge[to] = eid
                    if inq[to] == false
                        push(queue, to)
                        inq[to] = true
        if dist[sink] >= INF
            going = false
        else
            // bottleneck along the found path
            let bott = INF
            let v = sink
            while v != source
                let eid = prevedge[v]
                if e_cap[eid] < bott
                    bott = e_cap[eid]
                v = e_to[eid ^ 1]
            // augment
            v = sink
            while v != source
                let eid = prevedge[v]
                e_cap[eid] = e_cap[eid] - bott
                e_cap[eid ^ 1] = e_cap[eid ^ 1] + bott
                v = e_to[eid ^ 1]
            total_flow += bott
            total_cost += bott * dist[sink]
    [total_flow, total_cost]

// Convenience: solve the ASSIGNMENT problem (min-cost perfect matching) for an n x n cost matrix, returning the
// minimum total cost of assigning each of n workers to a distinct job. Builds the standard flow network internally.
fn assignment_min_cost(cost: list) -> int
    let n = len(cost)
    // nodes: 0 = source, 1..n = workers, n+1..2n = jobs, 2n+1 = sink
    let source = 0
    let sink = 2 * n + 1
    let edges = []
    for i in 0..n
        push(edges, [source, 1 + i, 1, 0])
        push(edges, [n + 1 + i, sink, 1, 0])
    for r in 0..n
        let row = cost[r]
        let c = 0
        while c < n
            push(edges, [1 + r, n + 1 + c, 1, row[c]])
            c += 1
    let res = min_cost_max_flow(2 * n + 2, edges, source, sink)
    res[1]
