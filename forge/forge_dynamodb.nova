// forge_dynamodb -- build SIGNED Amazon DynamoDB requests (PutItem/GetItem/Query/...) with no SDK. DynamoDB is
// a single POST endpoint: an X-Amz-Target header names the operation and a JSON body carries the args; the
// request is SigV4-signed (service "dynamodb"). Returns a request dict ready for the HTTP client. This is
// NOVA's serverless NoSQL backend, alongside forge_s3 for blobs. Imports forge_awssigv4 (KAT-verified signer).
import forge_awssigv4

fn dynamodb_host(region: string) -> string
    "dynamodb.{region}.amazonaws.com"

// Build a signed DynamoDB request. `target` = "DynamoDB_20120810.<Op>" (e.g. ".PutItem"). `body` = the JSON
// payload (build with json_stringify). amz_date="YYYYMMDDTHHMMSSZ", date_stamp="YYYYMMDD". Returns a dict:
// method/url/host/authorization/x-amz-date/x-amz-target/content-type/x-amz-content-sha256.
fn dynamodb_request(access_key: string, secret: string, region: string, target: string, body: string, amz_date: string, date_stamp: string) -> dict
    let host = dynamodb_host(region)
    let payload_hash = sigv4_payload_hash(body)
    let content_type = "application/x-amz-json-1.0"
    let nl = chr(10)
    let ch = "content-type:{content_type}{nl}host:{host}{nl}x-amz-content-sha256:{payload_hash}{nl}x-amz-date:{amz_date}{nl}x-amz-target:{target}{nl}"
    let signed = "content-type;host;x-amz-content-sha256;x-amz-date;x-amz-target"
    let creq = sigv4_canonical_request("POST", "/", "", ch, signed, payload_hash)
    let scope = sigv4_scope(date_stamp, region, "dynamodb")
    let sts = sigv4_string_to_sign(amz_date, scope, creq)
    let sig = sigv4_signature(secret, date_stamp, region, "dynamodb", sts)
    {"method": "POST", "url": "https://{host}/", "host": host, "authorization": sigv4_auth_header(access_key, scope, signed, sig), "x-amz-date": amz_date, "x-amz-target": target, "content-type": content_type, "x-amz-content-sha256": payload_hash}

fn dynamodb_put_item(access_key: string, secret: string, region: string, body: string, amz_date: string, date_stamp: string) -> dict
    dynamodb_request(access_key, secret, region, "DynamoDB_20120810.PutItem", body, amz_date, date_stamp)

fn dynamodb_get_item(access_key: string, secret: string, region: string, body: string, amz_date: string, date_stamp: string) -> dict
    dynamodb_request(access_key, secret, region, "DynamoDB_20120810.GetItem", body, amz_date, date_stamp)

fn dynamodb_query(access_key: string, secret: string, region: string, body: string, amz_date: string, date_stamp: string) -> dict
    dynamodb_request(access_key, secret, region, "DynamoDB_20120810.Query", body, amz_date, date_stamp)
