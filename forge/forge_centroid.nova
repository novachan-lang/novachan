// forge_centroid -- centroid decomposition of a tree: a recursive divide-and-conquer over tree structure.
// The CENTROID of a tree is a node whose removal leaves every remaining component with at most half the
// nodes. Centroid decomposition repeatedly finds the centroid, records it, removes it, and recurses on
// each resulting component -- producing the "centroid tree", a balanced O(log n)-height auxiliary tree
// over the SAME vertices. Because any two original vertices' path passes through their lowest common
// ancestor in the centroid tree, this decomposition answers a large class of TREE PATH-COUNTING problems
// efficiently: "how many pairs of nodes are at distance exactly K?", "closest marked node to each node",
// distance queries under updates, and many competitive-programming path problems -- each in O(n log n) or
// O(n log^2 n) instead of O(n^2). The centroid tree has height O(log n), which bounds all these.
//
// This module builds the centroid tree (returns each node's parent in the centroid tree, and the decomp
// order) and, as a decisive demonstrable use, counts the number of unordered vertex pairs whose path
// length (edge count) equals a given K -- via the classic centroid-decomposition + distance-multiset trick.
//
// Tree given as n and an undirected edge list [[a,b],...] (n-1 edges, connected). All 0-based node ids.
//
// API:
//   centroid_decompose(n, edges) -> list         [centroid_parent[], decomp_order[]]
//   centroid_tree_parent(n, edges) -> list       parent of each node in the centroid tree (-1 for the top)
//   count_pairs_at_distance(n, edges, k) -> int  # unordered pairs of nodes at path length exactly k
// LEAF (imports nothing).

fn _ce_build_adj(n: int, edges: list) -> list
    let adj = []
    let i = 0
    while i < n
        push(adj, [])
        i = i + 1
    let e = 0
    while e < len(edges)
        let a = edges[e][0]
        let b = edges[e][1]
        push(adj[a], b)
        push(adj[b], a)
        e = e + 1
    return adj

// Compute subtree sizes over the CURRENT (non-removed) component rooted at start, avoiding removed nodes.
// Returns the size array (only meaningful for nodes in this component) and the component's node count.
fn _ce_compute_sizes(start: int, adj: list, removed: list, size: list, parent_in_dfs: list) -> int
    // iterative DFS to fill sizes
    let stack = [start]
    let order = []
    parent_in_dfs[start] = 0 - 1
    let visited = {}
    visited[str(start)] = 1
    while len(stack) > 0
        let node = stack[len(stack) - 1]
        let new_stack = []
        let si = 0
        while si < len(stack) - 1
            push(new_stack, stack[si])
            si = si + 1
        stack = new_stack
        push(order, node)
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let w = nbrs[j]
            if removed[w] == 0 and get(visited, str(w), 0) == 0
                visited[str(w)] = 1
                parent_in_dfs[w] = node
                push(stack, w)
            j = j + 1
    // process order in reverse to accumulate sizes
    let idx = len(order) - 1
    while idx >= 0
        let node = order[idx]
        size[node] = 1
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let w = nbrs[j]
            if removed[w] == 0 and parent_in_dfs[w] == node
                size[node] = size[node] + size[w]
            j = j + 1
        idx = idx - 1
    return len(order)

// Find the centroid of the component containing start (with given total size).
fn _ce_find_centroid(start: int, adj: list, removed: list, size: list, total: int) -> int
    let cur = start
    let prev = 0 - 1
    let done = false
    while done == false
        let nbrs = adj[cur]
        let next = 0 - 1
        let j = 0
        while j < len(nbrs) and next == 0 - 1
            let w = nbrs[j]
            if removed[w] == 0 and w != prev
                // the size of the subtree toward w (from cur's perspective in this component)
                if size[w] > total / 2
                    next = w
            j = j + 1
        if next == 0 - 1
            done = true
        else
            // recompute: when moving to next, the size seen "back" toward cur is total - size[next]
            size[cur] = total - size[next]
            prev = cur
            cur = next
    return cur

// Build the centroid tree: returns [centroid_parent, decomp_order].
fn centroid_decompose(n: int, edges: list) -> list
    let adj = _ce_build_adj(n, edges)
    let removed = []
    let size = []
    let parent_in_dfs = []
    let centroid_parent = []
    let i = 0
    while i < n
        push(removed, 0)
        push(size, 0)
        push(parent_in_dfs, 0 - 1)
        push(centroid_parent, 0 - 1)
        i = i + 1
    let decomp_order = []
    // process components via an explicit work queue of [start_node, parent_centroid]
    let work = [[0, 0 - 1]]
    while len(work) > 0
        let item = work[len(work) - 1]
        let new_work = []
        let wi = 0
        while wi < len(work) - 1
            push(new_work, work[wi])
            wi = wi + 1
        work = new_work
        let start = item[0]
        let par_cen = item[1]
        // compute sizes of this component
        let total = _ce_compute_sizes(start, adj, removed, size, parent_in_dfs)
        let cen = _ce_find_centroid(start, adj, removed, size, total)
        centroid_parent[cen] = par_cen
        push(decomp_order, cen)
        removed[cen] = 1
        // enqueue each neighboring component
        let nbrs = adj[cen]
        let j = 0
        while j < len(nbrs)
            let w = nbrs[j]
            if removed[w] == 0
                push(work, [w, cen])
            j = j + 1
    return [centroid_parent, decomp_order]

fn centroid_tree_parent(n: int, edges: list) -> list
    let res = centroid_decompose(n, edges)
    return res[0]

// Count unordered pairs of nodes whose path length (edge count) is exactly k.
// Classic centroid-decomposition method: at each centroid, count pairs of nodes (in different subtrees
// of the centroid, or with the centroid itself) whose distance-through-the-centroid == k, using
// inclusion-exclusion (count all pairs through centroid, subtract pairs within the same child subtree).
fn count_pairs_at_distance(n: int, edges: list, k: int) -> int
    let adj = _ce_build_adj(n, edges)
    let removed = []
    let i = 0
    while i < n
        push(removed, 0)
        i = i + 1
    let total_pairs_box = [0]
    // work queue of component start nodes
    let work = [0]
    while len(work) > 0
        let start = work[len(work) - 1]
        let new_work = []
        let wi = 0
        while wi < len(work) - 1
            push(new_work, work[wi])
            wi = wi + 1
        work = new_work
        // sizes
        let size = []
        let parent_in_dfs = []
        let z = 0
        while z < n
            push(size, 0)
            push(parent_in_dfs, 0 - 1)
            z = z + 1
        let total = _ce_compute_sizes(start, adj, removed, size, parent_in_dfs)
        let cen = _ce_find_centroid(start, adj, removed, size, total)
        // count pairs through cen: gather all distances from cen (including cen=0) across ALL of the
        // component, then subtract per-child-subtree self-counts.
        // dist_count[d] over the whole component (from cen)
        let all_counts = _ce_dist_counts(cen, 0 - 1, adj, removed, k)
        // pairs where d1 + d2 == k over the whole set (naively counts same-subtree pairs too)
        total_pairs_box[0] = total_pairs_box[0] + _ce_count_k(all_counts, k)
        // subtract each child subtree's internal (d1+d2==k) contributions
        let nbrs = adj[cen]
        let j = 0
        while j < len(nbrs)
            let w = nbrs[j]
            if removed[w] == 0
                // distances measured from cen, but starting one edge in (root the subtree at w, dist from cen)
                let sub_counts = _ce_dist_counts(w, cen, adj, removed, k)
                // shift by +1 because these are distances from cen going through w's edge... actually
                // _ce_dist_counts(w, cen,...) already returns distances FROM w. We need distances FROM cen
                // for the subtree = (dist from w) + 1. We handle via _ce_dist_counts_from_cen below.
                let sub_from_cen = _ce_shift(sub_counts)
                total_pairs_box[0] = total_pairs_box[0] - _ce_count_k(sub_from_cen, k)
            j = j + 1
        removed[cen] = 1
        // enqueue neighbors
        let j2 = 0
        while j2 < len(nbrs)
            let w = nbrs[j2]
            if removed[w] == 0
                push(work, w)
            j2 = j2 + 1
    return total_pairs_box[0]

// distance histogram from `root` (avoiding parent-edge & removed nodes), capped at index k.
fn _ce_dist_counts(root: int, banned: int, adj: list, removed: list, k: int) -> list
    let counts = []
    let i = 0
    while i <= k
        push(counts, 0)
        i = i + 1
    // BFS
    let queue = [[root, 0]]
    let visited = {}
    visited[str(root)] = 1
    if banned >= 0
        visited[str(banned)] = 1
    let qi = 0
    while qi < len(queue)
        let node = queue[qi][0]
        let d = queue[qi][1]
        qi = qi + 1
        if d <= k
            counts[d] = counts[d] + 1
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let w = nbrs[j]
            if removed[w] == 0 and get(visited, str(w), 0) == 0
                visited[str(w)] = 1
                push(queue, [w, d + 1])
            j = j + 1
    return counts
// shift a distance histogram up by 1 (distances from cen = distances from child + 1).
fn _ce_shift(counts: list) -> list
    let out = [0]
    let i = 0
    while i < len(counts)
        push(out, counts[i])
        i = i + 1
    return out

// count unordered pairs (i<j) with d1+d2==k, plus (if the histogram includes distance 0 = the centroid)
// pairs formed with the centroid: counts[0]*counts[k]. General formula over the multiset of distances:
// number of pairs summing to k = sum over d1<d2 counts[d1]*counts[d2] + (if k even) C(counts[k/2],2).
fn _ce_count_k(counts: list, k: int) -> int
    let total = 0
    let d = 0
    while d <= k
        let e = k - d
        if e >= 0 and e < len(counts) and d < len(counts)
            if d < e
                total = total + counts[d] * counts[e]
            else
                if d == e
                    let c = counts[d]
                    total = total + c * (c - 1) / 2
        d = d + 1
    return total
