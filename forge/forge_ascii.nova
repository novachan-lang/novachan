// forge_ascii -- ASCII character helpers: test printable/control, strip non-printable, and check ascii-only.
// For input sanitization, protocol/header validation (reject control chars -> header-injection safety), and
// safe logging. LEAF -- imports NOTHING.

fn is_ascii(s: string) -> bool
    for i in 0..len(s)
        if ord(char_at(s, i)) > 127
            return false
    true

fn is_printable(s: string) -> bool
    for i in 0..len(s)
        let b = ord(char_at(s, i))
        if b < 32 or b > 126
            return false
    true

// Strip non-printable-ASCII chars (keep bytes 32..126). Header/log injection safety.
fn strip_control(s: string) -> string
    let out_parts = []
    for i in 0..len(s)
        let c = char_at(s, i)
        let b = ord(c)
        if b >= 32 and b <= 126
            push(out_parts, c)
    let out = join(out_parts, "")
    out

// Any control char present? (byte < 32 except tab/LF/CR, or 127). For rejecting header-injection payloads.
fn has_control(s: string) -> bool
    for i in 0..len(s)
        let b = ord(char_at(s, i))
        if (b < 32 and b != 9 and b != 10 and b != 13) or b == 127
            return true
    false
