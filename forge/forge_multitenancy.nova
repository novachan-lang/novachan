// forge_multitenancy — Multi-tenant isolation.
// Tenant registry, context propagation, resource scoping.

fn mt_registry() -> dict
    let r = {}
    r["tenants"] = {}
    r["current"] = ""
    r

fn mt_register(reg: dict, id: string, name: string) -> dict
    let t = {}
    t["name"] = name
    t["active"] = true
    t["config"] = {}
    t["quota_used"] = 0
    t["quota_max"] = 0
    reg["tenants"][id] = t
    reg

fn mt_set_current(reg: dict, id: string) -> dict
    reg["current"] = id
    reg

fn mt_current(reg: dict) -> string
    reg["current"]

fn mt_set_quota(reg: dict, id: string, max_val: int) -> dict
    if contains(reg["tenants"], id)
        reg["tenants"][id]["quota_max"] = max_val
    reg

fn mt_use_quota(reg: dict, id: string, amount: int) -> dict
    if contains(reg["tenants"], id)
        reg["tenants"][id]["quota_used"] = reg["tenants"][id]["quota_used"] + amount
    reg

fn mt_quota_remaining(reg: dict, id: string) -> int
    if contains(reg["tenants"], id)
        let t = reg["tenants"][id]
        return t["quota_max"] - t["quota_used"]
    0

fn mt_deactivate(reg: dict, id: string) -> dict
    if contains(reg["tenants"], id)
        reg["tenants"][id]["active"] = false
    reg

fn mt_activate(reg: dict, id: string) -> dict
    if contains(reg["tenants"], id)
        reg["tenants"][id]["active"] = true
    reg

fn mt_is_active(reg: dict, id: string) -> bool
    if contains(reg["tenants"], id)
        let val = reg["tenants"][id]["active"]
        if val == true
            return true
    false

fn mt_set_config(reg: dict, id: string, key: string, value: any) -> dict
    if contains(reg["tenants"], id)
        reg["tenants"][id]["config"][key] = value
    reg

fn mt_get_config(reg: dict, id: string, key: string) -> any
    if contains(reg["tenants"], id)
        if contains(reg["tenants"][id]["config"], key)
            return reg["tenants"][id]["config"][key]
    ""

fn mt_list_tenants(reg: dict) -> list
    keys(reg["tenants"])

fn mt_scoped_key(reg: dict, key: string) -> string
    let cur = reg["current"]
    cur + ":" + key
