// forge_linreg -- fit a straight line y = slope*x + intercept to your data by least squares, then PREDICT new
// values and judge how good the fit is with R^2. Where forge_stats gives just the raw slope/intercept, this is
// the complete toolkit: fit once into a model, predict for any x, and read R^2 -- the fraction of the variance
// the line explains (1.0 = the points lie exactly on the line, 0 = the line is no better than the mean, and it
// can go negative for a truly bad fit). Use it for trend lines and forecasting, calibration curves, "how much
// does X drive Y", and quick what-if predictions. Two equal-length numeric lists in; a [slope, intercept, r2]
// model out. All sums, no square roots -- fully reliable. LEAF -- imports NOTHING.

// Fit a least-squares line. Returns the model [slope, intercept, r2]. Needs >= 2 points.
fn linreg_fit(xs: list, ys: list) -> list
    let n = len(xs)
    let model = [0.0, 0.0, 0.0]
    if n > 1 and len(ys) == n
        let sx = 0.0
        let sy = 0.0
        for i in 0..n
            sx += xs[i] * 1.0
            sy += ys[i] * 1.0
        let mx = sx / (n * 1.0)
        let my = sy / (n * 1.0)
        let cov = 0.0
        let varx = 0.0
        for j in 0..n
            let dx = xs[j] * 1.0 - mx
            let dy = ys[j] * 1.0 - my
            cov += dx * dy
            varx += dx * dx
        let slope = (cov / varx) if varx != 0.0 else 0.0
        let intercept = my - slope * mx
        // R^2 = 1 - SS_res / SS_tot
        let ss_res = 0.0
        let ss_tot = 0.0
        for k in 0..n
            let yhat = slope * (xs[k] * 1.0) + intercept
            let e = ys[k] * 1.0 - yhat
            ss_res += e * e
            let dt = ys[k] * 1.0 - my
            ss_tot += dt * dt
        let r2 = (1.0 - ss_res / ss_tot) if ss_tot != 0.0 else 1.0
        model = [slope, intercept, r2]
    model

// Predict y for a given x from a fitted [slope, intercept, r2] model.
fn linreg_predict(model: list, x) -> float
    let y = (model[0] * 1.0) * (x * 1.0) + model[1] * 1.0
    y

// The slope of the fitted line.
fn linreg_slope(model: list) -> float
    let s = model[0] * 1.0
    s

// The y-intercept of the fitted line.
fn linreg_intercept(model: list) -> float
    let b = model[1] * 1.0
    b

// R^2, the coefficient of determination (fraction of variance explained; 1.0 = perfect fit).
fn linreg_r2(model: list) -> float
    let r = model[2] * 1.0
    r
