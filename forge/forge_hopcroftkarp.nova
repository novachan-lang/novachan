// forge_hopcroftkarp -- Hopcroft-Karp maximum bipartite matching in O(E * sqrt(V)).
// forge_bimatch already finds a maximum bipartite matching via Kuhn's algorithm, which augments ONE path
// at a time for O(V*E) worst case. Hopcroft-Karp is the asymptotically FASTER algorithm (O(E*sqrt(V))):
// each PHASE runs a single BFS to find the length of the shortest augmenting path and build a layered
// graph, then a batch of DFS runs augment along a MAXIMAL SET of vertex-disjoint shortest augmenting
// paths simultaneously. Because the shortest augmenting-path length strictly increases every phase and is
// bounded by O(sqrt(V)) phases (a classical argument), the total cost is O(E*sqrt(V)). This is the
// algorithm of record for large bipartite matching -- assignment at scale, scheduling, flow-based
// matching, stable-matching preprocessing, and the matching core inside other graph algorithms.
//
// Left vertices are 0..nl-1, right vertices 0..nr-1. Edges are [left, right] index pairs. Returns the
// matching as match_left[] where match_left[u] = the right vertex matched to left u, or -1 if unmatched.
//
// API:
//   hk_max_matching(nl, nr, edges) -> list   match_left array (length nl); -1 = unmatched
//   hk_matching_size(nl, nr, edges) -> int   size of the maximum matching
// LEAF (imports nothing).

fn _hk_nil() -> int
    return 0 - 1

// Build left-adjacency: adj[u] = list of right vertices reachable from left u.
fn _hk_build_adj(nl: int, edges: list) -> list
    let adj = []
    let i = 0
    while i < nl
        push(adj, [])
        i = i + 1
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        push(adj[u], v)
        e = e + 1
    return adj

// BFS: build dist[] for left vertices, layering free left vertices at 0. Returns true if an augmenting
// path exists (some free right vertex reachable). dist and pair arrays are mutated.
fn _hk_bfs(nl: int, adj: list, pair_left: list, pair_right: list, dist: list) -> bool
    let queue = []
    let u = 0
    while u < nl
        if pair_left[u] == 0 - 1
            dist[u] = 0
            push(queue, u)
        else
            dist[u] = 0 - 1
        u = u + 1
    let found = false
    let qi = 0
    while qi < len(queue)
        let uu = queue[qi]
        qi = qi + 1
        let nbrs = adj[uu]
        let j = 0
        while j < len(nbrs)
            let v = nbrs[j]
            let w = pair_right[v]
            if w == 0 - 1
                // reached a free right vertex -> augmenting path exists
                found = true
            else
                if dist[w] == 0 - 1
                    dist[w] = dist[uu] + 1
                    push(queue, w)
            j = j + 1
    return found

// DFS: try to find an augmenting path from left vertex u along layered edges. Mutates pairings.
fn _hk_dfs(u: int, adj: list, pair_left: list, pair_right: list, dist: list) -> bool
    let nbrs = adj[u]
    let j = 0
    while j < len(nbrs)
        let v = nbrs[j]
        let w = pair_right[v]
        let advance = false
        if w == 0 - 1
            advance = true
        else
            if dist[w] == dist[u] + 1
                if _hk_dfs(w, adj, pair_left, pair_right, dist)
                    advance = true
        if advance
            pair_left[u] = v
            pair_right[v] = u
            return true
        j = j + 1
    dist[u] = 0 - 1
    return false

// Maximum bipartite matching via Hopcroft-Karp. Returns pair_left (length nl); -1 = unmatched.
fn hk_max_matching(nl: int, nr: int, edges: list) -> list
    let adj = _hk_build_adj(nl, edges)
    let pair_left = []
    let i = 0
    while i < nl
        push(pair_left, 0 - 1)
        i = i + 1
    let pair_right = []
    let k = 0
    while k < nr
        push(pair_right, 0 - 1)
        k = k + 1
    let dist = []
    let d = 0
    while d < nl
        push(dist, 0 - 1)
        d = d + 1
    let running = true
    while running
        if _hk_bfs(nl, adj, pair_left, pair_right, dist) == false
            running = false
        else
            // Try to augment from every free left vertex
            let u = 0
            while u < nl
                if pair_left[u] == 0 - 1
                    let ignore = _hk_dfs(u, adj, pair_left, pair_right, dist)
                u = u + 1
    return pair_left

fn hk_matching_size(nl: int, nr: int, edges: list) -> int
    let pl = hk_max_matching(nl, nr, edges)
    let cnt = 0
    let i = 0
    while i < len(pl)
        if pl[i] != 0 - 1
            cnt = cnt + 1
        i = i + 1
    return cnt
