// forge_wavelettree -- Wavelet tree over an integer array: range frequency/quantile queries in O(log V).
// The wavelet tree is the most versatile range-query data structure: given a fixed array of values,
// answer ALL of these queries in O(log V) per query (V = value alphabet size):
//   - How many times does value v appear in array[l..r]? (range frequency)
//   - What is the k-th smallest value in array[l..r]? (range k-th order statistic / quantile)
//   - How many values in array[l..r] are < v? (rank / range less-than count)
// Applications: database column statistics, bioinformatics (read alignment, FM-index / BWT), competitive
// programming (multiple-dimension range queries), range median, range mode frequency, suffix arrays.
//
// IMPLEMENTATION (bit-level wavelet tree, standard textbook form):
// Values are in [0, max_val]. We process LOG = ceil(log2(max_val+1)) bit levels.
// At each level b (from MSB to LSB), the array is split: elements with bit b = 0 go to the left half,
// elements with bit b = 1 go to the right half (stable partition). For each level we store:
//   prefix_zeros[i] = number of 0-bit elements in positions [0..i-1] of the CURRENT level's array
// Queries navigate level-by-level: given [l, r] at level b, compute [l', r'] in the child.
// For LEFT (bit=0): l' = prefix_zeros[l], r' = prefix_zeros[r+1] - 1
// For RIGHT (bit=1): l' = total_zeros + (l - prefix_zeros[l]), r' = total_zeros + (r - prefix_zeros[r+1] + 1) - 1
// (total_zeros = prefix_zeros[n], the number of elements that went left in the full array at this level)
//
// API:
//   wt_build(arr, max_val) -> tree          build wavelet tree (list of levels)
//   wt_freq(tree, l, r, v) -> int           count occurrences of v in arr[l..r] (inclusive)
//   wt_rank_less(tree, l, r, v) -> int      count values < v in arr[l..r]
//   wt_kth(tree, l, r, k) -> int            k-th smallest (1-based) in arr[l..r]
// LEAF (imports nothing).

fn _wt_pow2(b: int) -> int
    let r = 1
    let i = 0
    while i < b
        r = r * 2
        i = i + 1
    return r

// Number of bits needed: smallest b such that 2^b > max_val.
fn _wt_bits(max_val: int) -> int
    if max_val <= 0
        return 1
    let b = 0
    let v = max_val
    while v > 0
        b = b + 1
        v = v / 2
    return b

// Build the wavelet tree.
// Returns a list of levels, one per bit (MSB first).
// Each level = [prefix_zeros_list, total_zeros_int]
// prefix_zeros_list has length n+1; prefix_zeros[i] = number of 0-bit elements in [0..i-1] of current seq.
fn wt_build(arr: list, max_val: int) -> list
    let n = len(arr)
    if n == 0
        return []
    let bits = _wt_bits(max_val)
    let levels = []
    let cur = arr
    let lev = 0
    while lev < bits
        let bit_pos = bits - 1 - lev
        let pw = _wt_pow2(bit_pos)
        // Build prefix_zeros for the CURRENT level sequence
        let pfx = []
        push(pfx, 0)
        let cnt_zero = 0
        let i = 0
        while i < n
            let v = cur[i]
            let bval = (v / pw) % 2
            if bval == 0
                cnt_zero = cnt_zero + 1
            push(pfx, cnt_zero)
            i = i + 1
        // Stable partition into left (bit=0) and right (bit=1)
        let left_part = []
        let right_part = []
        let j = 0
        while j < n
            let v = cur[j]
            let bval = (v / pw) % 2
            if bval == 0
                push(left_part, v)
            else
                push(right_part, v)
            j = j + 1
        // Build next-level sequence = left_part ++ right_part
        let next = []
        let p = 0
        while p < len(left_part)
            push(next, left_part[p])
            p = p + 1
        let q = 0
        while q < len(right_part)
            push(next, right_part[q])
            q = q + 1
        push(levels, [pfx, cnt_zero])
        cur = next
        lev = lev + 1
    return levels

// Count occurrences of value v in arr[l..r] (0-indexed, inclusive).
fn wt_freq(tree: list, l: int, r: int, v: int) -> int
    if len(tree) == 0
        return 0
    let n_levels = len(tree)
    let bits = n_levels
    let cur_l = l
    let cur_r = r
    let lev = 0
    while lev < n_levels
        if cur_l > cur_r
            return 0
        let level = tree[lev]
        let pfx = level[0]
        let total_zeros = level[1]
        let bit_pos = bits - 1 - lev
        let pw = _wt_pow2(bit_pos)
        let v_bit = (v / pw) % 2
        let z_l = pfx[cur_l]
        let z_r1 = pfx[cur_r + 1]
        if v_bit == 0
            // Go left: elements with bit=0 are at positions [0..total_zeros-1] in next level
            cur_l = z_l
            cur_r = z_r1 - 1
        else
            // Go right: elements with bit=1 are at positions [total_zeros..n-1] in next level
            // ones before l = cur_l - z_l; ones before r+1 = (cur_r+1) - z_r1
            cur_l = total_zeros + cur_l - z_l
            cur_r = total_zeros + cur_r - z_r1
        lev = lev + 1
    if cur_l > cur_r
        return 0
    return cur_r - cur_l + 1

// Count values < v in arr[l..r] (0-indexed, inclusive).
fn wt_rank_less(tree: list, l: int, r: int, v: int) -> int
    if len(tree) == 0 or v <= 0
        return 0
    let n_levels = len(tree)
    let bits = n_levels
    let cur_l = l
    let cur_r = r
    let result = 0
    let lev = 0
    while lev < n_levels
        if cur_l > cur_r
            return result
        let level = tree[lev]
        let pfx = level[0]
        let total_zeros = level[1]
        let bit_pos = bits - 1 - lev
        let pw = _wt_pow2(bit_pos)
        let v_bit = (v / pw) % 2
        let z_l = pfx[cur_l]
        let z_r1 = pfx[cur_r + 1]
        let zeros_in_range = z_r1 - z_l
        if v_bit == 0
            // Go left: all right-branch elements at this level are >= v (bit=1 >= bit=0)
            // So we only count in the left child; no addition to result here
            cur_l = z_l
            cur_r = z_r1 - 1
        else
            // All zeros_in_range elements went left -> they have bit=0 at this position
            // Their values are all < current right-side (bit=1 means >= 2^bit_pos)
            // Wait, not exactly: they are < v only in the specific bit pattern sense.
            // The correct rule: when v_bit=1, ALL elements that went LEFT at this level
            // have bit=0 here, so they are LESS than elements that went RIGHT at this level.
            // Any element that went LEFT has value with this bit = 0 < 1, so ALL of them
            // in [cur_l..cur_r] that went left ARE < v (at the bit-prefix level so far).
            result = result + zeros_in_range
            cur_l = total_zeros + cur_l - z_l
            cur_r = total_zeros + cur_r - z_r1
        lev = lev + 1
    return result

// k-th smallest value (1-based) in arr[l..r].
fn wt_kth(tree: list, l: int, r: int, k: int) -> int
    if len(tree) == 0
        return -1
    let n_levels = len(tree)
    let bits = n_levels
    let cur_l = l
    let cur_r = r
    let val = 0
    let lev = 0
    while lev < n_levels
        if cur_l > cur_r
            return -1
        let level = tree[lev]
        let pfx = level[0]
        let total_zeros = level[1]
        let bit_pos = bits - 1 - lev
        let z_l = pfx[cur_l]
        let z_r1 = pfx[cur_r + 1]
        let zeros_in_range = z_r1 - z_l
        if k <= zeros_in_range
            // k-th smallest is in left child (bit=0)
            cur_l = z_l
            cur_r = z_r1 - 1
            // current bit of result = 0 (val unchanged)
        else
            // k-th smallest is in right child (bit=1)
            k = k - zeros_in_range
            val = val + _wt_pow2(bit_pos)
            cur_l = total_zeros + cur_l - z_l
            cur_r = total_zeros + cur_r - z_r1
        lev = lev + 1
    return val
