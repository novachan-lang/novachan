// forge_aspects -- S15: declarative cross-cutting concerns as HIGHER-ORDER decorators (the AOP substitute).
// Spring applies @Cacheable/@Retryable/@Scheduled/@Timed via reflective PROXIES; NOVA wraps the service fn
// DIRECTLY -- one impl, every call site, no proxy, no reflection, no hidden cost. Each decorator takes a
// DEFERRED action (a 0-arg closure `fn() work()`), so the wrapper controls when / whether / how-many-times
// it runs. (Transactions already have with_tx(pool, fn); this module adds cache/retry/timing/scheduling.)
//
// LEAF MODULE -- imports NOTHING. Built-ins: contains, keys, is_err, sleep, clock_ns, spawn, len.

// @Cacheable -- return the cached value for `key`, else run `producer` once, cache it, and return it. `store`
// is a plain dict (a per-request or per-scope memo). For a shared/actor-backed cache, adapt forge_cache.
fn cached(store: dict, key: string, producer) -> any
    if key in store
        return store[key]
    let v = producer()
    store[key] = v
    v

// @CacheEvict -- return a NEW store without `key` (no dict-delete builtin, so rebuild; O(n) but simple+sound).
fn cache_forget(store: dict, key: string) -> dict
    let out = {}
    for k in keys(store)
        if k != key
            out[k] = store[k]
    out

// @Retryable -- run `action` (a 0-arg closure returning a Result); on err, retry up to `max_attempts` with
// exponential backoff (base_ms * 2^attempt), sleeping between tries. Returns the last Result (ok on any
// success, else the final err). The declarative retry Spring gives via @Retryable/@Recover.
fn retried(max_attempts: int, base_ms: int, action) -> any
    let attempt = 0
    let r = action()
    while is_err(r) and attempt + 1 < max_attempts
        let delay = base_ms
        for d in 0..attempt
            delay = delay * 2
        sleep(delay)
        attempt += 1
        r = action()
    r

// @Timed -- run `action`, return [result, elapsed_ms] (monotonic clock). Wrap a hot path for metrics.
fn timed(action) -> list
    let start = clock_ns() / 1000000
    let r = action()
    let elapsed = (clock_ns() / 1000000) - start
    [r, elapsed]

// @Scheduled(fixedRate) -- spawn a background loop that runs `action` every interval_ms, forever. Returns
// immediately (fire-and-forget). Declarative cron-string parsing is a follow-up; fixed-rate covers the
// common "every N ms / every N seconds" case (Spring @Scheduled(fixedRate=...)).
fn _every_loop(interval_ms: int, action)
    while true
        action()
        sleep(interval_ms)

fn every(interval_ms: int, action)
    spawn _every_loop(interval_ms, action)
    0
