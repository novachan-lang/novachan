// forge_secret_store — in-memory secret store with access logging and Result API.

fn ss_new() -> dict
    {"secrets": {}, "access_log": {}, "access_count": 0, "secret_count": 0}

fn ss_put(s: dict, key: string, value: string) -> dict
    let sk = "s_" + key
    let is_new = sk not in s["secrets"]
    s["secrets"][sk] = value
    if is_new
        s["secret_count"] += 1
    s

fn ss_get(s: dict, key: string) -> Result
    let sk = "s_" + key
    if sk not in s["secrets"]
        return err("secret not found: {key}")
    s["access_count"] += 1
    let ak = "a_" + key
    s["access_log"][ak] = get(s["access_log"], ak, 0) + 1
    ok(s["secrets"][sk])

fn ss_delete(s: dict, key: string) -> Result
    let sk = "s_" + key
    if sk not in s["secrets"]
        return err("secret not found: {key}")
    s["secrets"][sk] = ""
    s["secret_count"] -= 1
    ok(s)

fn ss_has(s: dict, key: string) -> int
    let sk = "s_" + key
    if sk in s["secrets"] and s["secrets"][sk] != ""
        return 1
    0

fn ss_access_count(s: dict, key: string) -> int
    get(s["access_log"], "a_" + key, 0)

fn ss_total_accesses(s: dict) -> int
    s["access_count"]

fn ss_count(s: dict) -> int
    s["secret_count"]
