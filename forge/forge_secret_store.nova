// forge_secret_store — in-memory secret store with access logging and Result API.

fn ss_new() -> dict
    let s = {}
    s["secrets"] = {}
    s["access_log"] = {}
    s["access_count"] = 0
    s["secret_count"] = 0
    s

fn ss_put(s: dict, key: string, value: string) -> dict
    let sk = "s_" + key
    let is_new = 0
    if contains(s["secrets"], sk) != true
        is_new = 1
    s["secrets"][sk] = value
    if is_new == 1
        s["secret_count"] = s["secret_count"] + 1
    s

fn ss_get(s: dict, key: string) -> Result
    let sk = "s_" + key
    if contains(s["secrets"], sk) != true
        return err("secret not found: " + key)
    s["access_count"] = s["access_count"] + 1
    let ak = "a_" + key
    if contains(s["access_log"], ak) == true
        s["access_log"][ak] = s["access_log"][ak] + 1
    else
        s["access_log"][ak] = 1
    ok(s["secrets"][sk])

fn ss_delete(s: dict, key: string) -> Result
    let sk = "s_" + key
    if contains(s["secrets"], sk) != true
        return err("secret not found: " + key)
    s["secrets"][sk] = ""
    s["secret_count"] = s["secret_count"] - 1
    ok(s)

fn ss_has(s: dict, key: string) -> int
    let sk = "s_" + key
    if contains(s["secrets"], sk) == true
        if s["secrets"][sk] != ""
            return 1
    0

fn ss_access_count(s: dict, key: string) -> int
    let ak = "a_" + key
    if contains(s["access_log"], ak) == true
        return s["access_log"][ak]
    0

fn ss_total_accesses(s: dict) -> int
    s["access_count"]

fn ss_count(s: dict) -> int
    s["secret_count"]
