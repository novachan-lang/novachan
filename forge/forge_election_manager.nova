// forge_election_manager — Leader election (Bully algorithm).

fn em_new() -> dict
    let e = {}
    e["nodes"] = {}
    e["node_count"] = 0
    e["leader"] = ""
    e["elections"] = 0
    e["alive"] = {}
    e

fn em_add_node(e: dict, name: string, priority: int) -> dict
    e["nodes"][name] = priority
    e["alive"][name] = 1
    e["node_count"] = e["node_count"] + 1
    e

fn em_set_down(e: dict, name: string) -> dict
    e["alive"][name] = 0
    e

fn em_set_up(e: dict, name: string) -> dict
    e["alive"][name] = 1
    e

fn em_elect(e: dict) -> dict
    let ks = keys(e["nodes"])
    let best = ""
    let best_pri = -1
    let i = 0
    while i < len(ks)
        let n = ks[i]
        if e["alive"][n] == 1
            let p = e["nodes"][n]
            if p > best_pri
                best_pri = p
                best = n
        i = i + 1
    e["leader"] = best
    e["elections"] = e["elections"] + 1
    e

fn em_leader(e: dict) -> string
    e["leader"]

fn em_is_leader(e: dict, name: string) -> int
    if e["leader"] == name
        return 1
    0

fn em_election_count(e: dict) -> int
    e["elections"]

fn em_alive_count(e: dict) -> int
    let ks = keys(e["alive"])
    let c = 0
    let i = 0
    while i < len(ks)
        if e["alive"][ks[i]] == 1
            c = c + 1
        i = i + 1
    c

fn em_node_count(e: dict) -> int
    e["node_count"]
