// forge_p256 — NIST P-256 (secp256r1) field arithmetic mod p = 2^256-2^224+2^192+2^96-1.
// Reuses the base-2^16 limb bigint (_p_* from forge_crypto). Field elements are 16-limb LE lists.
// Reduction uses 2^256 == 2^224 - 2^192 - 2^96 + 1 (mod p); 224/192/96 are multiples of 16 so the fold
// is limb-aligned (no Solinas word-shuffle).
import forge_crypto

fn _p256_p() -> list
    let p = []
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 1)
    push(p, 0)
    push(p, 65535)
    push(p, 65535)
    p

fn _p256_small(n: int) -> list
    let f = []
    push(f, n & 65535)
    push(f, (n >> 16) & 65535)
    let i = 0
    while i < 14
        push(f, 0)
        i = i + 1
    f

fn _p256_one() -> list
    _p256_small(1)

fn _shiftk(h, k: int) -> list
    let o = []
    let i = 0
    while i < k
        push(o, 0)
        i = i + 1
    let j = 0
    while j < len(h)
        push(o, h[j])
        j = j + 1
    o

fn _p256_has_high(v) -> int
    let i = 16
    while i < len(v)
        if v[i] != 0
            return 1
        i = i + 1
    0

// reduce any-length limb list mod p to a 16-limb (< 2^256) value (loosely reduced)
fn _p256_reduce(x) -> list
    let v = _p_norm(x)
    while _p256_has_high(v) == 1
        let lo = []
        let i = 0
        while i < 16
            if i < len(v)
                push(lo, v[i])
            else
                push(lo, 0)
            i = i + 1
        let hi = []
        let j = 16
        while j < len(v)
            push(hi, v[j])
            j = j + 1
        let p1 = _p_add(_p_add(lo, _shiftk(hi, 14)), hi)
        let n1 = _p_add(_shiftk(hi, 12), _shiftk(hi, 6))
        v = _p_norm(_p_sub(p1, n1))
    let r = []
    let q = 0
    while q < 16
        if q < len(v)
            push(r, v[q])
        else
            push(r, 0)
        q = q + 1
    r

fn _p256_freeze(a) -> list
    let v = _p256_reduce(a)
    let i = 0
    while i < 2
        if _p_cmp(v, _p256_p()) >= 0
            v = _p_sub(v, _p256_p())
        i = i + 1
    v

fn pf_add(a, b) -> list
    _p256_reduce(_p_add(a, b))

fn pf_sub(a, b) -> list
    let fourp = _p_mul_small(_p256_p(), 4)
    _p256_reduce(_p_add(a, _p_sub(fourp, b)))

fn pf_mul(a, b) -> list
    _p256_reduce(_p_mul(a, b))

fn pf_sqr(a) -> list
    _p256_reduce(_p_mul(a, a))

fn _pf_pow(a, e, nbits: int) -> list
    let result = _p256_one()
    let i = nbits - 1
    while i >= 0
        result = _p256_reduce(_p_mul(result, result))
        let bit = (e[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = _p256_reduce(_p_mul(result, a))
        i = i - 1
    result

fn pf_inv(a) -> list
    let pm2 = _p_sub(_p256_p(), _p256_small(2))
    _p256_freeze(_pf_pow(a, pm2, 256))

// 32 big-endian bytes -> field element (16 LE limbs)
fn p256_decode(b) -> list
    let f = []
    let i = 0
    while i < 16
        let lo = b[31 - 2 * i]
        let hi = b[30 - 2 * i]
        push(f, lo | (hi << 8))
        i = i + 1
    f

// field element -> 32 big-endian bytes (frozen)
fn p256_encode(a) -> list
    let v = _p256_freeze(a)
    let out = []
    let i = 15
    while i >= 0
        push(out, (v[i] >> 8) & 255)
        push(out, v[i] & 255)
        i = i - 1
    out

// serialize 16 LE limbs to 32 big-endian bytes WITHOUT mod-p freeze (for mod-n scalars r,s)
fn _limbs_encode32(v) -> list
    let out = []
    let i = 15
    while i >= 0
        push(out, (v[i] >> 8) & 255)
        push(out, v[i] & 255)
        i = i - 1
    out

// ── scalar field mod n (the group order) ─────────────────────────────────────────────────────────────
fn _n256() -> list
    p256_decode(hex_to_blist("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"))

fn n_reduce(x) -> list
    let nn = _n256()
    let xn = _p_norm(x)
    let nbits = len(xn) * 16
    let rem = []
    push(rem, 0)
    let i = nbits - 1
    while i >= 0
        rem = _shl1(rem)
        let bit = (xn[i / 16] >> (i & 15)) & 1
        if bit == 1
            rem[0] = rem[0] | 1
        if _p_cmp(rem, nn) >= 0
            rem = _p_sub(rem, nn)
        i = i - 1
    while len(rem) < 16
        push(rem, 0)
    rem

fn n_mul(a, b) -> list
    n_reduce(_p_mul(a, b))

fn n_add(a, b) -> list
    n_reduce(_p_add(a, b))

fn n_inv(a) -> list
    let nm2 = _p_sub(_n256(), _p256_small(2))
    let result = _p256_one()
    let i = 255
    while i >= 0
        result = n_reduce(_p_mul(result, result))
        let bit = (nm2[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = n_reduce(_p_mul(result, a))
        i = i - 1
    result

// ── short-Weierstrass curve ops (a = -3), Jacobian coords [X, Y, Z]; identity = Z==0 ─────────────────
fn _p256_iszero(a) -> int
    if _p_is_nonzero(_p256_freeze(a)) == 1
        return 0
    1

fn _f_eq256(a, b) -> int
    _p256_iszero(pf_sub(a, b))

fn _ec_inf() -> list
    let p = []
    push(p, _p256_one())
    push(p, _p256_one())
    push(p, _p256_small(0))
    p

fn _ec_is_inf(p) -> int
    _p256_iszero(p[2])

fn _ec_G() -> list
    let g = []
    push(g, p256_decode(hex_to_blist("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296")))
    push(g, p256_decode(hex_to_blist("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")))
    push(g, _p256_one())
    g

fn ec_double(p) -> list
    let x = p[0]
    let y = p[1]
    let z = p[2]
    let delta = pf_sqr(z)
    let gamma = pf_sqr(y)
    let beta = pf_mul(x, gamma)
    let alpha = pf_mul(_p256_small(3), pf_mul(pf_sub(x, delta), pf_add(x, delta)))
    let x3 = pf_sub(pf_sqr(alpha), pf_mul(_p256_small(8), beta))
    let yz = pf_add(y, z)
    let z3 = pf_sub(pf_sub(pf_sqr(yz), gamma), delta)
    let fourbeta = pf_mul(_p256_small(4), beta)
    let eightgamma2 = pf_mul(_p256_small(8), pf_sqr(gamma))
    let y3 = pf_sub(pf_mul(alpha, pf_sub(fourbeta, x3)), eightgamma2)
    let r = []
    push(r, x3)
    push(r, y3)
    push(r, z3)
    r

fn ec_add(p, q) -> list
    if _ec_is_inf(p) == 1
        return q
    if _ec_is_inf(q) == 1
        return p
    let x1 = p[0]
    let y1 = p[1]
    let z1 = p[2]
    let x2 = q[0]
    let y2 = q[1]
    let z2 = q[2]
    let z1z1 = pf_sqr(z1)
    let z2z2 = pf_sqr(z2)
    let u1 = pf_mul(x1, z2z2)
    let u2 = pf_mul(x2, z1z1)
    let s1 = pf_mul(pf_mul(y1, z2), z2z2)
    let s2 = pf_mul(pf_mul(y2, z1), z1z1)
    if _f_eq256(u1, u2) == 1
        if _f_eq256(s1, s2) == 1
            return ec_double(p)
        return _ec_inf()
    let h = pf_sub(u2, u1)
    let twoh = pf_add(h, h)
    let i = pf_sqr(twoh)
    let j = pf_mul(h, i)
    let t = pf_sub(s2, s1)
    let rr = pf_add(t, t)
    let v = pf_mul(u1, i)
    let x3 = pf_sub(pf_sub(pf_sqr(rr), j), pf_add(v, v))
    let y3 = pf_sub(pf_mul(rr, pf_sub(v, x3)), pf_mul(pf_add(s1, s1), j))
    let z1z2 = pf_add(z1, z2)
    let z3 = pf_mul(pf_sub(pf_sub(pf_sqr(z1z2), z1z1), z2z2), h)
    let r = []
    push(r, x3)
    push(r, y3)
    push(r, z3)
    r

fn ec_scalarmul(klimbs, point) -> list
    let q = _ec_inf()
    let i = 255
    while i >= 0
        q = ec_double(q)
        let bit = (klimbs[i / 16] >> (i & 15)) & 1
        if bit == 1
            q = ec_add(q, point)
        i = i - 1
    q

fn ec_to_affine(p) -> list
    let zinv = pf_inv(p[2])
    let zinv2 = pf_sqr(zinv)
    let x = pf_mul(p[0], zinv2)
    let y = pf_mul(p[1], pf_mul(zinv2, zinv))
    let r = []
    push(r, x)
    push(r, y)
    r

// ── ECDSA (inputs/outputs are 32-byte big-endian) ────────────────────────────────────────────────────
fn ecdsa_p256_pubkey(d_bytes) -> list
    let d = p256_decode(d_bytes)
    let qa = ec_to_affine(ec_scalarmul(d, _ec_G()))
    let r = []
    push(r, _limbs_encode32(_p256_freeze(qa[0])))
    push(r, _limbs_encode32(_p256_freeze(qa[1])))
    r

fn ecdsa_p256_sign(d_bytes, hash_bytes, k_bytes) -> list
    let d = p256_decode(d_bytes)
    let k = p256_decode(k_bytes)
    let e = n_reduce(p256_decode(hash_bytes))
    let ra = ec_to_affine(ec_scalarmul(k, _ec_G()))
    let r = n_reduce(_p256_freeze(ra[0]))
    let s = n_mul(n_inv(k), n_add(e, n_mul(r, d)))
    let out = []
    push(out, _limbs_encode32(r))
    push(out, _limbs_encode32(s))
    out

fn ecdsa_p256_verify(qx_bytes, qy_bytes, hash_bytes, r_bytes, s_bytes) -> int
    let r = p256_decode(r_bytes)
    let s = p256_decode(s_bytes)
    let e = n_reduce(p256_decode(hash_bytes))
    let w = n_inv(s)
    let u1 = n_mul(e, w)
    let u2 = n_mul(r, w)
    let q = []
    push(q, p256_decode(qx_bytes))
    push(q, p256_decode(qy_bytes))
    push(q, _p256_one())
    let rr = ec_add(ec_scalarmul(u1, _ec_G()), ec_scalarmul(u2, q))
    if _ec_is_inf(rr) == 1
        return 0
    let raff = ec_to_affine(rr)
    let v = n_reduce(_p256_freeze(raff[0]))
    if _p_cmp(v, r) == 0
        return 1
    0
