// forge_p256 — NIST P-256 (secp256r1) field arithmetic mod p = 2^256-2^224+2^192+2^96-1.
// Reuses the base-2^16 limb bigint (_p_* from forge_crypto). Field elements are 16-limb LE lists.
// Reduction uses 2^256 == 2^224 - 2^192 - 2^96 + 1 (mod p); 224/192/96 are multiples of 16 so the fold
// is limb-aligned (no Solinas word-shuffle).
import forge_crypto

fn _p256_p() -> list
    let p = []
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 65535)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 0)
    push(p, 1)
    push(p, 0)
    push(p, 65535)
    push(p, 65535)
    p

fn _p256_small(n: int) -> list
    let f = []
    push(f, n & 65535)
    push(f, (n >> 16) & 65535)
    let i = 0
    while i < 14
        push(f, 0)
        i = i + 1
    f

fn _p256_one() -> list
    _p256_small(1)

fn _shiftk(h, k: int) -> list
    let o = []
    let i = 0
    while i < k
        push(o, 0)
        i = i + 1
    let j = 0
    while j < len(h)
        push(o, h[j])
        j = j + 1
    o

fn _p256_has_high(v) -> int
    let i = 16
    while i < len(v)
        if v[i] != 0
            return 1
        i = i + 1
    0

// reduce any-length limb list mod p to a 16-limb (< 2^256) value (loosely reduced)
fn _p256_reduce(x) -> list
    let v = _p_norm(x)
    while _p256_has_high(v) == 1
        let lo = []
        let i = 0
        while i < 16
            if i < len(v)
                push(lo, v[i])
            else
                push(lo, 0)
            i = i + 1
        let hi = []
        let j = 16
        while j < len(v)
            push(hi, v[j])
            j = j + 1
        let p1 = _p_add(_p_add(lo, _shiftk(hi, 14)), hi)
        let n1 = _p_add(_shiftk(hi, 12), _shiftk(hi, 6))
        v = _p_norm(_p_sub(p1, n1))
    let r = []
    let q = 0
    while q < 16
        if q < len(v)
            push(r, v[q])
        else
            push(r, 0)
        q = q + 1
    r

fn _p256_freeze(a) -> list
    let v = _p256_reduce(a)
    let i = 0
    while i < 2
        if _p_cmp(v, _p256_p()) >= 0
            v = _p_sub(v, _p256_p())
        i = i + 1
    v

fn pf_add(a, b) -> list
    _p256_reduce(_p_add(a, b))

fn pf_sub(a, b) -> list
    let fourp = _p_mul_small(_p256_p(), 4)
    _p256_reduce(_p_add(a, _p_sub(fourp, b)))

fn pf_mul(a, b) -> list
    _p256_reduce(_p_mul(a, b))

fn pf_sqr(a) -> list
    _p256_reduce(_p_mul(a, a))

fn _pf_pow(a, e, nbits: int) -> list
    let result = _p256_one()
    let i = nbits - 1
    while i >= 0
        result = _p256_reduce(_p_mul(result, result))
        let bit = (e[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = _p256_reduce(_p_mul(result, a))
        i = i - 1
    result

fn pf_inv(a) -> list
    let pm2 = _p_sub(_p256_p(), _p256_small(2))
    _p256_freeze(_pf_pow(a, pm2, 256))

// 32 big-endian bytes -> field element (16 LE limbs)
fn p256_decode(b) -> list
    let f = []
    let i = 0
    while i < 16
        let lo = b[31 - 2 * i]
        let hi = b[30 - 2 * i]
        push(f, lo | (hi << 8))
        i = i + 1
    f

// field element -> 32 big-endian bytes (frozen)
fn p256_encode(a) -> list
    let v = _p256_freeze(a)
    let out = []
    let i = 15
    while i >= 0
        push(out, (v[i] >> 8) & 255)
        push(out, v[i] & 255)
        i = i - 1
    out
