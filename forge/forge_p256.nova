// forge_p256 — NIST P-256 (secp256r1) field arithmetic mod p = 2^256-2^224+2^192+2^96-1.
// Reuses the base-2^16 limb bigint (public bn_limb_* wrappers in forge_crypto, over its private _p_*
// primitives). Field elements are 16-limb LE lists.
// Reduction uses 2^256 == 2^224 - 2^192 - 2^96 + 1 (mod p); 224/192/96 are multiples of 16 so the fold
// is limb-aligned (no Solinas word-shuffle).
import forge_crypto

// p = 2^256-2^224+2^192+2^96-1 as 16 base-2^16 little-endian limbs.
fn _p256_p() -> list
    [65535, 65535, 65535, 65535, 65535, 65535, 0, 0, 0, 0, 0, 0, 1, 0, 65535, 65535]

fn _p256_small(n: int) -> list
    [n & 65535, (n >> 16) & 65535, ...[0 for i in 0..14]]

fn _p256_one() -> list
    _p256_small(1)

// h shifted up by k limbs (k zero limbs prepended).
fn _shiftk(h, k: int) -> list
    [...[0 for i in 0..k], ...h]

fn _p256_has_high(v) -> int
    // short-circuits on the first non-zero high limb, so it stays a loop -- but a for-range one
    for i in 16..len(v)
        if v[i] != 0
            return 1
    0

// The low 16 limbs of `v`, zero-padded when `v` is shorter. Both the fold input and the final result
// of _p256_reduce needed exactly this, open-coded twice.
fn _p256_lo16(v) -> list
    [v[i] if i < len(v) else 0 for i in 0..16]

// reduce any-length limb list mod p to a 16-limb (< 2^256) value (loosely reduced)
fn _p256_reduce(x) -> list
    let v = bn_limb_norm(x)
    // each fold shortens v by a data-dependent amount, so the reduction loop stays a while
    while _p256_has_high(v) == 1
        let lo = _p256_lo16(v)
        let hi = [v[j] for j in 16..len(v)]
        let p1 = bn_limb_add(bn_limb_add(lo, _shiftk(hi, 14)), hi)
        let n1 = bn_limb_add(_shiftk(hi, 12), _shiftk(hi, 6))
        v = bn_limb_norm(bn_limb_sub(p1, n1))
    _p256_lo16(v)

fn _p256_freeze(a) -> list
    let v = _p256_reduce(a)
    for i in 0..2
        if bn_limb_cmp(v, _p256_p()) >= 0
            v = bn_limb_sub(v, _p256_p())
    v

fn pf_add(a, b) -> list
    _p256_reduce(bn_limb_add(a, b))

fn pf_sub(a, b) -> list
    let fourp = bn_limb_mul_small(_p256_p(), 4)
    _p256_reduce(bn_limb_add(a, bn_limb_sub(fourp, b)))

fn pf_mul(a, b) -> list
    _p256_reduce(bn_limb_mul(a, b))

fn pf_sqr(a) -> list
    _p256_reduce(bn_limb_mul(a, a))

fn _pf_pow(a, e, nbits: int) -> list
    let result = _p256_one()
    let i = nbits - 1
    while i >= 0
        result = _p256_reduce(bn_limb_mul(result, result))
        let bit = (e[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = _p256_reduce(bn_limb_mul(result, a))
        i -= 1
    result

fn pf_inv(a) -> list
    let pm2 = bn_limb_sub(_p256_p(), _p256_small(2))
    _p256_freeze(_pf_pow(a, pm2, 256))

// 32 big-endian bytes -> field element (16 LE limbs)
fn p256_decode(b) -> list
    [b[31 - 2 * i] | (b[30 - 2 * i] << 8) for i in 0..16]

// serialize 16 LE limbs to 32 big-endian bytes WITHOUT mod-p freeze (for mod-n scalars r,s)
fn _limbs_encode32(v) -> list
    let out = []
    // limbs are little-endian, bytes are big-endian -> top limb first, high byte then low byte
    for i in 0..16
        let limb = v[15 - i]
        push(out, (limb >> 8) & 255)
        push(out, limb & 255)
    out

// field element -> 32 big-endian bytes (frozen). This WAS _limbs_encode32 open-coded a second time.
fn p256_encode(a) -> list
    _limbs_encode32(_p256_freeze(a))

// ── scalar field mod n (the group order) ─────────────────────────────────────────────────────────────
fn _n256() -> list
    p256_decode(hex_to_blist("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"))

fn n_reduce(x) -> list
    let nn = _n256()
    let xn = bn_limb_norm(x)
    let nbits = len(xn) * 16
    let rem = []
    push(rem, 0)
    let i = nbits - 1
    while i >= 0
        rem = bn_limb_shl1(rem)
        let bit = (xn[i / 16] >> (i & 15)) & 1
        if bit == 1
            rem[0] = rem[0] | 1
        if bn_limb_cmp(rem, nn) >= 0
            rem = bn_limb_sub(rem, nn)
        i -= 1
    // zero-pad the remainder back out to 16 limbs (the count is fixed once the division is done)
    [...rem, ...[0 for i in 0..(16 - len(rem))]]

fn n_mul(a, b) -> list
    n_reduce(bn_limb_mul(a, b))

fn n_add(a, b) -> list
    n_reduce(bn_limb_add(a, b))

fn n_inv(a) -> list
    let nm2 = bn_limb_sub(_n256(), _p256_small(2))
    let result = _p256_one()
    let i = 255
    while i >= 0
        result = n_reduce(bn_limb_mul(result, result))
        let bit = (nm2[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = n_reduce(bn_limb_mul(result, a))
        i -= 1
    result

// ── short-Weierstrass curve ops (a = -3), Jacobian coords [X, Y, Z]; identity = Z==0 ─────────────────
fn _p256_iszero(a) -> int
    if bn_limb_is_nonzero(_p256_freeze(a)) == 1
        return 0
    1

fn _f_eq256(a, b) -> int
    _p256_iszero(pf_sub(a, b))

fn _ec_inf() -> list
    [_p256_one(), _p256_one(), _p256_small(0)]

fn _ec_is_inf(p) -> int
    _p256_iszero(p[2])

fn _ec_G() -> list
    [
        p256_decode(hex_to_blist("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296")),
        p256_decode(hex_to_blist("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")),
        _p256_one()
    ]

fn ec_double(p) -> list
    let x = p[0]
    let y = p[1]
    let z = p[2]
    let delta = pf_sqr(z)
    let gamma = pf_sqr(y)
    let beta = pf_mul(x, gamma)
    let alpha = pf_mul(_p256_small(3), pf_mul(pf_sub(x, delta), pf_add(x, delta)))
    let x3 = pf_sub(pf_sqr(alpha), pf_mul(_p256_small(8), beta))
    let yz = pf_add(y, z)
    let z3 = pf_sub(pf_sub(pf_sqr(yz), gamma), delta)
    let fourbeta = pf_mul(_p256_small(4), beta)
    let eightgamma2 = pf_mul(_p256_small(8), pf_sqr(gamma))
    let y3 = pf_sub(pf_mul(alpha, pf_sub(fourbeta, x3)), eightgamma2)
    [x3, y3, z3]

fn ec_add(p, q) -> list
    if _ec_is_inf(p) == 1
        return q
    if _ec_is_inf(q) == 1
        return p
    let x1 = p[0]
    let y1 = p[1]
    let z1 = p[2]
    let x2 = q[0]
    let y2 = q[1]
    let z2 = q[2]
    let z1z1 = pf_sqr(z1)
    let z2z2 = pf_sqr(z2)
    let u1 = pf_mul(x1, z2z2)
    let u2 = pf_mul(x2, z1z1)
    let s1 = pf_mul(pf_mul(y1, z2), z2z2)
    let s2 = pf_mul(pf_mul(y2, z1), z1z1)
    if _f_eq256(u1, u2) == 1
        if _f_eq256(s1, s2) == 1
            return ec_double(p)
        return _ec_inf()
    let h = pf_sub(u2, u1)
    let twoh = pf_add(h, h)
    let i = pf_sqr(twoh)
    let j = pf_mul(h, i)
    let t = pf_sub(s2, s1)
    let rr = pf_add(t, t)
    let v = pf_mul(u1, i)
    let x3 = pf_sub(pf_sub(pf_sqr(rr), j), pf_add(v, v))
    let y3 = pf_sub(pf_mul(rr, pf_sub(v, x3)), pf_mul(pf_add(s1, s1), j))
    let z1z2 = pf_add(z1, z2)
    let z3 = pf_mul(pf_sub(pf_sub(pf_sqr(z1z2), z1z1), z2z2), h)
    [x3, y3, z3]

fn ec_scalarmul(klimbs, point) -> list
    let q = _ec_inf()
    let i = 255
    while i >= 0
        q = ec_double(q)
        let bit = (klimbs[i / 16] >> (i & 15)) & 1
        if bit == 1
            q = ec_add(q, point)
        i -= 1
    q

fn ec_to_affine(p) -> list
    let zinv = pf_inv(p[2])
    let zinv2 = pf_sqr(zinv)
    let x = pf_mul(p[0], zinv2)
    let y = pf_mul(p[1], pf_mul(zinv2, zinv))
    [x, y]

// ── ECDSA (inputs/outputs are 32-byte big-endian) ────────────────────────────────────────────────────
fn ecdsa_p256_pubkey(d_bytes) -> list
    let d = p256_decode(d_bytes)
    let qa = ec_to_affine(ec_scalarmul(d, _ec_G()))
    [_limbs_encode32(_p256_freeze(qa[0])), _limbs_encode32(_p256_freeze(qa[1]))]

fn ecdsa_p256_sign(d_bytes, hash_bytes, k_bytes) -> list
    let d = p256_decode(d_bytes)
    let k = p256_decode(k_bytes)
    let e = n_reduce(p256_decode(hash_bytes))
    let ra = ec_to_affine(ec_scalarmul(k, _ec_G()))
    let r = n_reduce(_p256_freeze(ra[0]))
    let s = n_mul(n_inv(k), n_add(e, n_mul(r, d)))
    [_limbs_encode32(r), _limbs_encode32(s)]

// The P-256 group order n (32 bytes, big-endian).
fn _p256_n_bytes() -> list
    hex_to_blist("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")

// Returns 1 iff the 32-byte big-endian scalar v is in [1, n-1] (a valid ECDSA r or s). Rejects 0 and any
// value >= n. Byte-level (representation-independent) so it does not depend on the field internals.
// 1 iff the 32-byte big-endian `v` is strictly less than the 32-byte big-endian `bound`. The
// scalar (< n) and coordinate (< p) range checks below were this same comparison written twice.
fn _p256_be32_lt(v, bound) -> int
    for j in 0..32
        if v[j] < bound[j]
            return 1
        if v[j] > bound[j]
            return 0
    0

fn _p256_scalar_in_range(v) -> int
    // OR-fold over every byte -- deliberately NOT short-circuiting, so "is v zero" costs the same
    // time for every input (the values here are secret-adjacent signature scalars).
    if reduce(v, (acc, x) => acc | x, 0) == 0
        return 0
    if len(v) != 32
        return 0
    _p256_be32_lt(v, _p256_n_bytes())

// Returns 1 iff the 32-byte big-endian coordinate v is a canonical field element (0 <= v < p).
fn _p256_coord_lt_p(v) -> int
    if len(v) != 32
        return 0
    _p256_be32_lt(v, hex_to_blist("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"))

// Returns 1 iff Q=(qx,qy) is a valid P-256 public point: both coordinates canonical (< p) AND on the curve
// y^2 == x^3 - 3x + b (mod p). Rejects off-curve, out-of-range, and the identity (0,0) -- which fails the
// curve equation since b != 0. This is the invalid-curve / small-subgroup defense for ECDSA verification.
fn _p256_point_on_curve(qx_bytes, qy_bytes) -> int
    if _p256_coord_lt_p(qx_bytes) != 1
        return 0
    if _p256_coord_lt_p(qy_bytes) != 1
        return 0
    let x = p256_decode(qx_bytes)
    let y = p256_decode(qy_bytes)
    let y2 = pf_sqr(y)
    let x3 = pf_mul(pf_sqr(x), x)
    let three_x = pf_mul(_p256_small(3), x)
    let bb = p256_decode(hex_to_blist("5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"))
    let rhs = pf_add(pf_sub(x3, three_x), bb)
    if _f_eq256(y2, rhs) != 1
        return 0
    1

fn ecdsa_p256_verify(qx_bytes, qy_bytes, hash_bytes, r_bytes, s_bytes) -> int
    // FIPS 186-4 step: reject signatures whose r or s is not in [1, n-1] (rejects r/s = 0 -- which would
    // otherwise hit n_inv(0) -- and out-of-range / non-canonical values, closing signature malleability).
    if _p256_scalar_in_range(r_bytes) != 1
        return 0
    if _p256_scalar_in_range(s_bytes) != 1
        return 0
    // reject a public key that is not a valid point on P-256 (invalid-curve attack defense)
    if _p256_point_on_curve(qx_bytes, qy_bytes) != 1
        return 0
    let r = p256_decode(r_bytes)
    let s = p256_decode(s_bytes)
    let e = n_reduce(p256_decode(hash_bytes))
    let w = n_inv(s)
    let u1 = n_mul(e, w)
    let u2 = n_mul(r, w)
    let q = [p256_decode(qx_bytes), p256_decode(qy_bytes), _p256_one()]
    let rr = ec_add(ec_scalarmul(u1, _ec_G()), ec_scalarmul(u2, q))
    if _ec_is_inf(rr) == 1
        return 0
    let raff = ec_to_affine(rr)
    let v = n_reduce(_p256_freeze(raff[0]))
    if bn_limb_cmp(v, r) == 0
        return 1
    0
