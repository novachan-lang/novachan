// forge_tsv -- TSV (tab-separated values) parse + build: the format clipboard/spreadsheet paste and simple data
// export use. Simpler than CSV (no quoting rules). tsv_parse -> rows of fields; tsv_build -> text;
// tsv_parse_dicts -> header-keyed dicts. Complements forge_csv_parse. LEAF -- imports NOTHING.

fn tsv_parse(text: string) -> list
    let tab = chr(9)
    let cr = chr(13)
    let out = []
    let lines = split(text, chr(10))
    let i = 0
    while i < len(lines)
        let line = lines[i]
        if len(line) > 0 and char_at(line, len(line) - 1) == cr
            line = slice(line, 0, len(line) - 1)
        if i == len(lines) - 1 and len(line) == 0
            i += 1
        else
            push(out, split(line, tab))
            i += 1
    out

fn tsv_build(rows: list) -> string
    let tab = chr(9)
    let nl = chr(10)
    let out_parts = []
    for i in 0..len(rows)
        if i > 0
            push(out_parts, nl)
        let row = rows[i]
        let j = 0
        while j < len(row)
            if j > 0
                push(out_parts, tab)
            push(out_parts, str(row[j]))
            j += 1
    let out = join(out_parts, "")
    out

// Parse with the first row as headers -> list of dicts.
fn tsv_parse_dicts(text: string) -> list
    let rows = tsv_parse(text)
    let out = []
    if len(rows) == 0
        return out
    let header = rows[0]
    for r in 1..len(rows)
        let cur = rows[r]
        let d = {}
        let j = 0
        while j < len(header)
            let v = ""
            if j < len(cur)
                v = cur[j]
            d[header[j]] = v
            j += 1
        push(out, d)
    out
