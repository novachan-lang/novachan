// forge_hamiltonian -- find a Hamiltonian PATH or CYCLE in a graph: an ordering that visits EVERY vertex exactly
// once (and, for a cycle, returns to the start). This is the "visit every city once" backbone of route and tour
// planning, DNA-fragment assembly (overlap-layout-consensus lays fragments in a Hamiltonian path), snake/board
// puzzles, PCB drill-order and CNC tool-path sequencing, and the yes/no core underneath the Travelling Salesman
// problem. It differs from forge_tsp / forge_heldkarp, which find the CHEAPEST tour on a weighted complete graph:
// here the graph is arbitrary (any set of allowed edges) and the question is pure existence -- can you thread all
// vertices on the edges you are given at all? That makes it NP-complete, so this uses backtracking search with
// early pruning (try to extend the current partial path along a real edge to an unvisited vertex, and undo when
// stuck), which is exact and fast on the small-to-medium graphs where you actually need an answer. The graph is an
// adjacency matrix (n rows of n 0/1 entries, adj[u][v] = 1 iff edge u-v exists); build_adj assembles one from an
// edge list. Results are vertex orderings; an empty list means none exists. LEAF -- imports NOTHING.

// Build an n-vertex undirected adjacency matrix from a flat edge list [u0,v0, u1,v1, ...].
fn build_adj(n: int, edges: list) -> list
    let adj = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            push(row, 0)
            j += 1
        push(adj, row)
    let e = 0
    while e + 1 < len(edges)
        let u = edges[e]
        let v = edges[e + 1]
        let ru = adj[u]
        ru[v] = 1
        let rv = adj[v]
        rv[u] = 1
        e += 2
    adj

// PRIVATE: recursively try to extend `path` to cover all n vertices, backtracking on dead ends. If want_cycle is
// true the completed path must also have an edge from the last vertex back to the first.
fn _ham_extend(adj: list, n: int, path: list, visited: list, want_cycle: bool) -> bool
    let out = false
    if len(path) == n
        if want_cycle
            let first = path[0]
            let last = path[n - 1]
            let lastrow = adj[last]
            out = lastrow[first] == 1
        else
            out = true
    else
        let last = path[len(path) - 1]
        let row = adj[last]
        let v = 0
        while v < n and out == false
            if row[v] == 1 and visited[v] == false
                visited[v] = true
                push(path, v)
                if _ham_extend(adj, n, path, visited, want_cycle)
                    out = true
                else
                    pop(path)
                    visited[v] = false
            v += 1
    out

// A Hamiltonian path (an ordering of all n vertices with an edge between each consecutive pair), or an empty list
// if none exists. Tries every possible starting vertex.
fn hamiltonian_path(adj: list, n: int) -> list
    let out = []
    let start = 0
    while start < n and len(out) == 0
        let path = [start]
        let visited = []
        for z in 0..n
            push(visited, false)
        visited[start] = true
        if _ham_extend(adj, n, path, visited, false)
            out = path
        start += 1
    out

// A Hamiltonian cycle (an ordering of all n vertices, each adjacent to the next AND the last adjacent back to the
// first), or an empty list if none exists. Fixes the start at vertex 0 (a cycle can begin anywhere).
fn hamiltonian_cycle(adj: list, n: int) -> list
    let out = []
    if n > 0
        let path = [0]
        let visited = [false for z in 0..n]
        visited[0] = true
        if _ham_extend(adj, n, path, visited, true)
            out = path
    out

// Verify that `path` really is a Hamiltonian path on adj: it lists all n vertices once and each consecutive pair is
// an edge. If want_cycle is true, also require an edge from the last vertex back to the first.
fn is_hamiltonian(adj: list, path: list, n: int, want_cycle: bool) -> bool
    let out = true
    if len(path) != n
        out = false
    else
        // all vertices present exactly once
        let seen = [0 for z in 0..n]
        for i in 0..n
            let p = path[i]
            if p < 0 or p >= n
                out = false
            else
                seen[p] = seen[p] + 1
        for k in 0..n
            if seen[k] != 1
                out = false
        // consecutive pairs are edges
        let j = 0
        while j + 1 < n
            let a = path[j]
            let b = path[j + 1]
            let ra = adj[a]
            if ra[b] != 1
                out = false
            j += 1
        if want_cycle and n > 1
            let f = path[0]
            let l = path[n - 1]
            let rl = adj[l]
            if rl[f] != 1
                out = false
    out
