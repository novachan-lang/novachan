// forge_hamiltonian -- thin wrapper over std/graph/hamiltonian (canonical implementation).
import std/graph/hamiltonian

fn build_adj(n: int, edges: list) -> list
    let adj = []
    for i in 0..n
        push(adj, [0 for j in 0..n])
    let e = 0
    while e + 1 < len(edges)
        let u = edges[e]
        let v = edges[e + 1]
        let ru = adj[u]
        ru[v] = 1
        let rv = adj[v]
        rv[u] = 1
        e += 2
    adj

// PRIVATE: recursively try to extend `path` to cover all n vertices, backtracking on dead ends. If want_cycle is
// true the completed path must also have an edge from the last vertex back to the first.

fn hamiltonian_path(adj: list, n: int) -> list
    return ham_has_path(adj, n)

fn hamiltonian_cycle(adj: list, n: int) -> list
    return ham_has_cycle(adj, n)

fn is_hamiltonian(adj: list, path: list, n: int, want_cycle: bool) -> bool
    let out = true
    if len(path) != n
        out = false
    else
        // all vertices present exactly once
        let seen = [0 for z in 0..n]
        for i in 0..n
            let p = path[i]
            if p < 0 or p >= n
                out = false
            else
                seen[p] += 1
        for k in 0..n
            if seen[k] != 1
                out = false
        // consecutive pairs are edges
        let j = 0
        while j + 1 < n
            let a = path[j]
            let b = path[j + 1]
            let ra = adj[a]
            if ra[b] != 1
                out = false
            j += 1
        if want_cycle and n > 1
            let f = path[0]
            let l = path[n - 1]
            let rl = adj[l]
            if rl[f] != 1
                out = false
    out

