// forge_evalmetrics -- measure how good a classifier actually is. Training a model (forge_bayes, forge_knn) is
// only half the job; you must EVALUATE it on held-out data, and raw accuracy lies when classes are imbalanced
// (99% accuracy is worthless if 99% of email is ham). This module computes the confusion matrix and the metrics
// that matter: precision (of the things I flagged, how many were right), recall (of the things I should have
// caught, how many did I), F1 (their harmonic balance), plus accuracy and macro-averages across all classes.
// Feed it two parallel lists -- the true labels and the predicted labels. LEAF -- imports NOTHING.

// PRIVATE: distinct labels appearing in either list, in first-seen order.
fn _em_labels(actual: list, predicted: list) -> list
    let seen = {}
    let out = []
    for i in 0..len(actual)
        let a = str(actual[i])
        if a in seen == false
            seen[a] = 1
            push(out, a)
    for j in 0..len(predicted)
        let p = str(predicted[j])
        if p in seen == false
            seen[p] = 1
            push(out, p)
    out

// Fraction of predictions that exactly match the true label. 0.0 for empty input.
fn eval_accuracy(actual: list, predicted: list) -> float
    let n = len(actual)
    let acc = 0.0
    if n > 0
        let correct = 0
        for i in 0..n
            if str(actual[i]) == str(predicted[i])
                correct += 1
        acc = (correct * 1.0) / (n * 1.0)
    acc

// Binary confusion counts for a chosen positive label: [TP, FP, FN, TN].
fn eval_confusion(actual: list, predicted: list, pos: string) -> list
    let tp = 0
    let fp = 0
    let fn_c = 0
    let tn = 0
    for i in 0..len(actual)
        let a = str(actual[i])
        let p = str(predicted[i])
        let a_pos = a == pos
        let p_pos = p == pos
        if a_pos and p_pos
            tp += 1
        else
            if p_pos
                fp += 1
            else
                if a_pos
                    fn_c += 1
                else
                    tn += 1
    [tp, fp, fn_c, tn]

// Precision for `pos`: TP / (TP + FP) -- of everything predicted positive, how much was right. 0.0 if none predicted positive.
fn eval_precision(actual: list, predicted: list, pos: string) -> float
    let cm = eval_confusion(actual, predicted, pos)
    let tp = cm[0]
    let fp = cm[1]
    let out = 0.0
    if tp + fp > 0
        out = (tp * 1.0) / ((tp + fp) * 1.0)
    out

// Recall for `pos`: TP / (TP + FN) -- of everything actually positive, how much was caught. 0.0 if none actually positive.
fn eval_recall(actual: list, predicted: list, pos: string) -> float
    let cm = eval_confusion(actual, predicted, pos)
    let tp = cm[0]
    let fn_c = cm[2]
    let out = 0.0
    if tp + fn_c > 0
        out = (tp * 1.0) / ((tp + fn_c) * 1.0)
    out

// F1 for `pos`: harmonic mean of precision and recall = 2PR/(P+R). 0.0 if both are 0.
fn eval_f1(actual: list, predicted: list, pos: string) -> float
    let p = eval_precision(actual, predicted, pos)
    let r = eval_recall(actual, predicted, pos)
    let out = 0.0
    let denom = p + r
    if denom > 0.0
        out = (2.0 * p * r) / denom
    out

// Macro-averaged F1: the unweighted mean of per-class F1 over every label. Good for imbalanced multiclass.
fn eval_macro_f1(actual: list, predicted: list) -> float
    let labels = _em_labels(actual, predicted)
    let out = 0.0
    if len(labels) > 0
        let sum = 0.0
        for i in 0..len(labels)
            sum += eval_f1(actual, predicted, labels[i])
        out = sum / (len(labels) * 1.0)
    out

// Macro-averaged precision (unweighted mean of per-class precision).
fn eval_macro_precision(actual: list, predicted: list) -> float
    let labels = _em_labels(actual, predicted)
    let out = 0.0
    if len(labels) > 0
        let sum = 0.0
        for i in 0..len(labels)
            sum += eval_precision(actual, predicted, labels[i])
        out = sum / (len(labels) * 1.0)
    out
