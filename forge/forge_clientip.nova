// forge_clientip -- find the REAL client IP when your app sits behind proxies/load balancers/CDNs, without
// getting spoofed. When a request passes through proxies, each appends the caller to X-Forwarded-For, so the
// header reads "client, proxy1, proxy2" -- but a malicious client can PREFILL fake entries on the left. The
// secure rule (what Rails, Express `trust proxy`, and nginx real_ip do): walk the chain from the RIGHT (the
// entry your own trusted proxy added, which a client cannot forge) leftward, skipping IPs in your trusted-proxy
// list; the first NON-trusted address is the true client. Using the leftmost XFF value blindly is a spoofable
// vulnerability (forged rate-limit/geo/audit identity) -- this module does it right, and also exposes the naive
// version clearly labelled. Trusted proxies are given as CIDR blocks. Imports forge_ipcidr.

import forge_ipcidr

// Parse an X-Forwarded-For header into a left-to-right list of trimmed IP strings (empty entries dropped).
fn parse_forwarded_for(header: string) -> list
    let out = []
    if len(header) > 0
        let parts = split(header, ",")
        let i = 0
        while i < len(parts)
            let ip = trim(parts[i])
            if len(ip) > 0
                push(out, ip)
            i = i + 1
    out

// SECURE client IP: given the X-Forwarded-For header, the direct peer address (remote_addr, the actual TCP
// connection -- unspoofable), and your trusted-proxy CIDRs, return the real client. Walks the chain
// [xff..., remote_addr] from the right, skipping trusted proxies; returns the first non-trusted address. If
// every hop is trusted, returns the leftmost (the original client claim).
fn client_ip(xff_header: string, remote_addr: string, trusted_cidrs: list) -> string
    let chain = parse_forwarded_for(xff_header)
    push(chain, remote_addr)
    let result = chain[0]
    let i = len(chain) - 1
    let found = false
    while i >= 0 and found == false
        let ip = chain[i]
        if ip_in_any(trusted_cidrs, ip)
            i = i - 1
        else
            result = ip
            found = true
    result

// NAIVE client IP (INSECURE unless you fully trust the network): the leftmost X-Forwarded-For entry, or
// remote_addr if the header is empty. A client can forge this -- prefer client_ip() with a trusted-proxy list.
fn client_ip_leftmost(xff_header: string, remote_addr: string) -> string
    let chain = parse_forwarded_for(xff_header)
    let result = remote_addr
    if len(chain) > 0
        result = chain[0]
    result

// True if `remote_addr` is one of your trusted proxies (in any trusted CIDR) -- i.e. whether X-Forwarded-For
// from this connection can be believed at all.
fn is_trusted_proxy(remote_addr: string, trusted_cidrs: list) -> bool
    ip_in_any(trusted_cidrs, remote_addr)

// The number of proxy hops the request traversed (X-Forwarded-For entry count).
fn proxy_hop_count(xff_header: string) -> int
    len(parse_forwarded_for(xff_header))
