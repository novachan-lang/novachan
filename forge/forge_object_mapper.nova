// forge_object_mapper — field mapping/transformation between dicts with Result API.

fn om_new() -> dict
    {"mappings": {}, "count": 0, "total_mapped": 0}

fn om_add_mapping(m: dict, from_field: string, to_field: string) -> dict
    let mk = "m_{from_field}"
    m["mappings"][mk] = to_field
    m["count"] += 1
    m

fn om_map(m: dict, source: dict) -> dict
    let result = {}
    let ks = keys(m["mappings"])
    for i in 0..len(ks)
        let k = ks[i]
        let from_field = slice(k, 2, len(k))
        let to_field = m["mappings"][k]
        if from_field in source
            result[to_field] = source[from_field]
    m["total_mapped"] += 1
    result

fn om_has_mapping(m: dict, from_field: string) -> int
    let mk = "m_{from_field}"
    let has = mk in m["mappings"]
    1 if has else 0

fn om_target_field(m: dict, from_field: string) -> Result
    let mk = "m_{from_field}"
    if mk not in m["mappings"]
        return err("no mapping for {from_field}")
    ok(m["mappings"][mk])

fn om_mapping_count(m: dict) -> int
    m["count"]

fn om_total_mapped(m: dict) -> int
    m["total_mapped"]
