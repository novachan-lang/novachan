// forge_boolean -- parse a string into a boolean, accepting many truthy/falsy spellings.
// Case-insensitive, whitespace-trimmed. LEAF -- imports NOTHING.

fn parse_bool(s: string) -> bool
    let v = lower(trim(s))
    v in ["true", "yes", "1", "on", "y", "t"]

fn parse_bool_default(s: string, default: bool) -> bool
    let v = lower(trim(s))
    if v in ["true", "yes", "1", "on", "y", "t"]
        return true
    if v in ["false", "no", "0", "off", "n", "f", ""]
        return false
    default

fn bool_str(b: bool) -> string
    "true" if b else "false"
