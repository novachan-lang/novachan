// forge_boolean -- parse a string into a boolean, accepting the many truthy/falsy spellings config files, form
// checkboxes, and env vars use ("yes"/"true"/"1"/"on"/"y"/"t" -> true; everything else / "" -> false).
// Case-insensitive, whitespace-trimmed. LEAF -- imports NOTHING.

fn parse_bool(s: string) -> bool
    let v = lower(trim(s))
    if v == "true" or v == "yes" or v == "1" or v == "on" or v == "y" or v == "t"
        return true
    false

// Parse with an explicit default for values that match NEITHER the truthy NOR the falsy set.
fn parse_bool_default(s: string, default: bool) -> bool
    let v = lower(trim(s))
    if v == "true" or v == "yes" or v == "1" or v == "on" or v == "y" or v == "t"
        return true
    if v == "false" or v == "no" or v == "0" or v == "off" or v == "n" or v == "f" or v == ""
        return false
    default

// Render a bool as "true"/"false".
fn bool_str(b: bool) -> string
    if b
        return "true"
    "false"
