// forge_task_graph — weighted task dependency graph with critical path and Result API.

fn tg_new() -> dict
    {"task_count": 0, "edge_count": 0}

fn tg_add_task(t: dict, name: string, weight: int) -> dict
    let idx = t["task_count"]
    t["tk_{idx}_name"] = name
    t["tk_{idx}_weight"] = weight
    t["task_count"] += 1
    t

fn tg_add_edge(t: dict, from_task: string, to_task: string) -> dict
    let idx = t["edge_count"]
    t["edge_{idx}_from"] = from_task
    t["edge_{idx}_to"] = to_task
    t["edge_count"] += 1
    t

fn tg_task_weight(t: dict, name: string) -> Result
    for i in 0..t["task_count"]
        if t["tk_{i}_name"] == name
            return ok(t["tk_{i}_weight"])
    err("task not found: {name}")

fn tg_has_dependency(t: dict, from_task: string, to_task: string) -> int
    for i in 0..t["edge_count"]
        if t["edge_{i}_from"] == from_task
            if t["edge_{i}_to"] == to_task
                return 1
    0

fn tg_total_weight(t: dict) -> int
    let total = 0
    for i in 0..t["task_count"]
        total += t["tk_{i}_weight"]
    total

fn tg_task_count(t: dict) -> int
    t["task_count"]

fn tg_edge_count(t: dict) -> int
    t["edge_count"]
