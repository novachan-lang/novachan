// forge_token_store — Token storage with expiry.

fn ts_new() -> dict
    let t = {}
    t["tokens"] = {}
    t["expiry"] = {}
    t["owners"] = {}
    t["total_created"] = 0
    t["total_expired"] = 0
    t

fn ts_store(t: dict, token: string, owner: string, expires_at: int) -> dict
    t["tokens"][token] = 1
    t["expiry"][token] = expires_at
    t["owners"][token] = owner
    t["total_created"] = t["total_created"] + 1
    t

fn ts_validate(t: dict, token: string, now: int) -> dict
    let result = {}
    let has = contains(t["tokens"], token)
    if has != true
        result["valid"] = 0
        result["reason"] = "not_found"
        result["t"] = t
        return result
    if t["tokens"][token] == 0
        result["valid"] = 0
        result["reason"] = "revoked"
        result["t"] = t
        return result
    if now > t["expiry"][token]
        t["tokens"][token] = 0
        t["total_expired"] = t["total_expired"] + 1
        result["valid"] = 0
        result["reason"] = "expired"
        result["t"] = t
        return result
    result["valid"] = 1
    result["owner"] = t["owners"][token]
    result["reason"] = ""
    result["t"] = t
    result

fn ts_revoke(t: dict, token: string) -> dict
    let has = contains(t["tokens"], token)
    if has == true
        t["tokens"][token] = 0
    t

fn ts_owner(t: dict, token: string) -> string
    let has = contains(t["owners"], token)
    if has != true
        return ""
    t["owners"][token]

fn ts_total_created(t: dict) -> int
    t["total_created"]

fn ts_total_expired(t: dict) -> int
    t["total_expired"]
