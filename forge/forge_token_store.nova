// forge_token_store -- secure token issuance/validation/revocation (Sentinel). Tracks per-token
// user/scope/revoked state and per-user issuance counts under a flat-key dict (no nested dicts/lists),
// matching forge_session_store's convention -- state is mutated in place; callers do not need to
// reassign after Result-returning calls (only the fluent ts_issue needs reassignment for chaining).

fn ts_new(default_ttl: int) -> dict
    let s = {}
    s["default_ttl"] = default_ttl
    s["issued_count"] = 0
    s["active_count"] = 0
    s

// Issue (or re-issue) a token bound to user_id/scope. Re-issuing a REVOKED token_id un-revokes it and
// counts as reactivation (active_count goes back up) without double-counting active_count if the token
// was already active. issued_count and the per-user count increment on every issuance event.
fn ts_issue(state: dict, token_id: string, user_id: string, scope: string) -> dict
    let k_exists = "tok_" + token_id + "_exists"
    let was_active = 0
    if contains(state, k_exists)
        if int(state[k_exists]) == 1
            if int(state["tok_" + token_id + "_revoked"]) != 1
                was_active = 1
    state[k_exists] = 1
    state["tok_" + token_id + "_user"] = user_id
    state["tok_" + token_id + "_scope"] = scope
    state["tok_" + token_id + "_revoked"] = 0
    state["issued_count"] = int(state["issued_count"]) + 1
    if was_active == 0
        state["active_count"] = int(state["active_count"]) + 1
    let uk = "tsu_" + user_id + "_count"
    if contains(state, uk)
        state[uk] = int(state[uk]) + 1
    else
        state[uk] = 1
    state

fn _ts_exists(state: dict, token_id: string) -> bool
    contains(state, "tok_" + token_id + "_exists")

// ts_validate(state, token_id) -> Result: ok("valid") if the token exists and is not revoked.
fn ts_validate(state: dict, token_id: string) -> Result
    if not _ts_exists(state, token_id)
        return err("token not found: " + token_id)
    if int(state["tok_" + token_id + "_revoked"]) == 1
        return err("token revoked: " + token_id)
    ok("valid")

// ts_revoke(state, token_id) -> Result: revokes an active token. Err if missing or already revoked.
fn ts_revoke(state: dict, token_id: string) -> Result
    if not _ts_exists(state, token_id)
        return err("token not found: " + token_id)
    if int(state["tok_" + token_id + "_revoked"]) == 1
        return err("token already revoked: " + token_id)
    state["tok_" + token_id + "_revoked"] = 1
    state["active_count"] = int(state["active_count"]) - 1
    ok(token_id)

fn ts_get_user(state: dict, token_id: string) -> Result
    if not _ts_exists(state, token_id)
        return err("token not found: " + token_id)
    ok(str(state["tok_" + token_id + "_user"]))

fn ts_get_scope(state: dict, token_id: string) -> Result
    if not _ts_exists(state, token_id)
        return err("token not found: " + token_id)
    ok(str(state["tok_" + token_id + "_scope"]))

fn ts_is_revoked(state: dict, token_id: string) -> Result
    if not _ts_exists(state, token_id)
        return err("token not found: " + token_id)
    ok(int(state["tok_" + token_id + "_revoked"]))

fn ts_active_count(state: dict) -> int
    int(state["active_count"])

fn ts_total_issued(state: dict) -> int
    int(state["issued_count"])

// Total issuance events recorded for user_id (0 if the user has never had a token issued).
fn ts_user_tokens(state: dict, user_id: string) -> int
    let uk = "tsu_" + user_id + "_count"
    if contains(state, uk)
        return int(state[uk])
    0
