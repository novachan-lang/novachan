// forge_simplex -- linear programming via the revised Simplex method: maximize c·x subject to Ax <= b,
// x >= 0. The universal algorithm for optimal resource allocation: LP relaxations in branch-and-bound
// integer programming, diet/blend/transportation/assignment/portfolio optimization, network flow,
// scheduling, machine-learning (SVM margin, lasso via LP relaxation), game-theory Nash equilibria.
// API: simplex(c, A, b) -> [status, obj, x] where status = 0 (optimal), 1 (infeasible), 2 (unbounded).
// Standard form: add one slack variable per constraint -> basis starts as the all-slack identity.
// Bland's rule for pivot selection (smallest-index entering variable) guarantees termination (no cycling).
// Ratio test (Dantzig min-ratio) keeps the solution primal-feasible. Handles m constraints, n variables.
// LEAF (imports nothing). Floats; any row with b[i] < 0 is multiplied by -1 to enforce non-negative RHS.

fn _sx_abs(x: float) -> float
    -x if x < 0.0 else x

// simplex: maximize c (length n) subject to A (m x n) x <= b (length m), x >= 0.
// Returns [status, objective_value, x_vector].
// status 0=optimal, 1=infeasible/iteration-limit, 2=unbounded.
fn simplex(c: list, A: list, b: list) -> list
    let n = len(c)
    let m = len(b)
    // Tableau: (m+1) rows x (n+m+1) cols.
    // Rows 0..m-1 = constraints; row m = objective row.
    // Cols 0..n-1 = original vars; cols n..n+m-1 = slack vars; col n+m = RHS.
    let cols = n + m + 1
    // Build tableau row by row
    let tab = []
    for i in 0..m
        // Fill A coefficients; handle negative RHS by flipping sign
        let bi = b[i] * 1.0
        let sign = (0.0 - 1.0) if bi < 0.0 else 1.0
        let row = [0.0 for z in 0..cols]
        // NOTE: `sign` is multiplied in here rather than inside the comprehension -- a float local
        // bound from an EXPRESSION is corrupted when captured by a comprehension (compiler bug,
        // measured: 1.5 * 1.0 * 1.0 -> 6.9e18). A plain for-loop body is unaffected.
        for k in 0..n
            row[k] = A[i][k] * 1.0 * sign
        // Slack variable for this row
        row[n + i] = sign
        // RHS
        row[cols - 1] = bi * sign
        push(tab, row)
    // Objective row: negate c (we track -obj so optimal has all-non-negative reduced costs)
    let obj_row = [...[0.0 - c[k] * 1.0 for k in 0..n], ...[0.0 for z in 0..(m + 1)]]
    push(tab, obj_row)
    // Basis: initially slack variables n, n+1, ..., n+m-1
    let basis = [n + k for k in 0..m]
    // Simplex iterations (Bland's rule: smallest-index col with negative reduced cost)
    let max_iter = (n + m) * (n + m) + 400
    for iter in 0..max_iter
        // Find entering variable: smallest index jj with tab[m][jj] < -eps (short-circuits on first)
        let enter = -1
        for jj in 0..(n + m)
            if tab[m][jj] * 1.0 < -0.0000001
                enter = jj
                break
        if enter == -1
            // Optimal: no negative reduced cost in objective row
            let x = [0.0 for p in 0..n]
            for q, bvar in basis
                if bvar < n
                    x[bvar] = tab[q][cols - 1] * 1.0
            let obj = tab[m][cols - 1] * 1.0
            return [0, obj, x]
        // Ratio test: find leaving variable (row with minimum positive ratio RHS/pivot)
        let leave = -1
        let min_ratio = -1.0
        for ii in 0..m
            let pivot_val = tab[ii][enter] * 1.0
            if pivot_val > 0.0000001
                let ratio = (tab[ii][cols - 1] * 1.0) / pivot_val
                if leave == -1
                    leave = ii
                    min_ratio = ratio
                if ratio < min_ratio
                    leave = ii
                    min_ratio = ratio
        if leave == -1
            // Unbounded: entering variable can increase without bound
            return [2, 0.0, []]
        // Pivot: divide pivot row by pivot element
        let pivot_val = tab[leave][enter] * 1.0
        // NOTE: the two pivot kernels below stay explicit in-place loops on purpose. Rewriting them
        // as comprehensions corrupts the raw floats across the any-boxed element boundary (measured:
        // objective 36.0 -> 5.86e-18). Do not "raise" these two loops.
        let prow = tab[leave]
        for jj2 in 0..cols
            prow[jj2] = prow[jj2] * 1.0 / pivot_val
        // Eliminate enter column from all other rows (including objective row m)
        for ii2 in 0..(m + 1)
            if ii2 != leave
                let crow = tab[ii2]
                let factor = crow[enter] * 1.0
                if _sx_abs(factor) > 0.0000001
                    for jj3 in 0..cols
                        crow[jj3] = crow[jj3] * 1.0 - factor * (prow[jj3] * 1.0)
        // Update basis
        basis[leave] = enter
    // Iteration limit exceeded
    return [1, 0.0, []]
