// forge_transreduce -- transitive reduction: strip a directed graph down to the FEWEST edges that keep exactly
// the same reachability. If A depends on B and C, and B already depends on C, then the direct A->C edge is
// redundant (you can still reach C from A through B) and can be dropped. Removing these shortcuts gives the
// minimal "skeleton" of a dependency graph -- which is what you want to DISPLAY a clean dependency diagram
// (only the essential/direct edges, no clutter), simplify a build/package graph, show a Hasse diagram of a
// partial order, or find the direct-prerequisite structure behind a tangle of transitive requirements. For an
// acyclic graph (a DAG) this minimal set is unique. An edge is kept only if its endpoint is NOT reachable from
// its start through some OTHER path. Directed edges [from, to] with string ids. LEAF -- imports NOTHING.

// PRIVATE: is `target` reachable from `source` using every edge EXCEPT the one at index `skip`?
fn _tr_reachable_without(edges: list, source, target, skip: int) -> bool
    let adj = {}
    let e = 0
    while e < len(edges)
        if e != skip
            let u = edges[e][0]
            let v = edges[e][1]
            if contains(adj, u) == false
                adj[u] = []
            push(adj[u], v)
        e = e + 1
    let visited = {}
    let queue = []
    push(queue, source)
    visited[source] = 1
    let qi = 0
    let found = false
    while qi < len(queue) and found == false
        let x = queue[qi]
        qi = qi + 1
        let nb = get(adj, x, [])
        let j = 0
        while j < len(nb)
            let w = nb[j]
            if w == target
                found = true
            if contains(visited, w) == false
                visited[w] = 1
                push(queue, w)
            j = j + 1
    found

// The transitive reduction: the minimal edge set with the same reachability. Returns a list of [from, to] edges.
fn transitive_reduction(edges: list) -> list
    let result = []
    let i = 0
    while i < len(edges)
        let u = edges[i][0]
        let v = edges[i][1]
        // keep this edge only if v is NOT reachable from u by another route
        if _tr_reachable_without(edges, u, v, i) == false
            push(result, [u, v])
        i = i + 1
    result

// The number of edges in the transitive reduction.
fn reduction_edge_count(edges: list) -> int
    len(transitive_reduction(edges))
