// forge_ascii85 -- Ascii85 (base-85) binary-to-text encoding: ~25% overhead vs base64's 33%, the encoding used
// inside PDF and PostScript streams, Adobe products, and git binary diffs. Four bytes become a 32-bit big-endian
// number written as five base-85 digits over the printable range '!'..'u' (33..117). A full all-zero group is
// abbreviated to the single letter 'z'. A trailing partial group of n bytes (1..3) is zero-padded to four,
// encoded, and only the first n+1 characters are emitted. Encodes a byte list to an Ascii85 string. LEAF.
//
// This is the btoa/Adobe core (no <~ ~> framing -- add that at the call site if a PDF stream needs it).
//
// RAISED 2026-08-05. Two problems:
//
//   1. The five-character string was built as five `chr()` concat operations. Interpolation.
//   2. `let out = join(...); out` -- the intermediate binding has no reader.

fn ascii85_encode(data: list) -> string
    let out_parts = []
    let n = len(data)
    let i = 0
    // STAYS a while: processes 4 bytes at a time with a trailing partial group.
    while i < n
        let cnt = min(4, n - i)
        let acc = 0
        for k in 0..4
            let byte = data[i + k] if k < cnt else 0
            acc = acc * 256 + byte
        if cnt == 4 and acc == 0
            push(out_parts, "z")
        else
            let d0 = (acc / 52200625) % 85
            let d1 = (acc / 614125) % 85
            let d2 = (acc / 7225) % 85
            let d3 = (acc / 85) % 85
            let d4 = acc % 85
            let five = "{chr(33 + d0)}{chr(33 + d1)}{chr(33 + d2)}{chr(33 + d3)}{chr(33 + d4)}"
            push(out_parts, slice(five, 0, cnt + 1))
        i += 4
    join(out_parts, "")
