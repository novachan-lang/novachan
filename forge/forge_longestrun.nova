// forge_longestrun -- find the longest run of CONSECUTIVE integers hiding in an UNSORTED array, in O(n) time.
// [100, 4, 200, 1, 3, 2] contains the consecutive stretch 1,2,3,4, so the answer is 4 -- and you get it WITHOUT
// sorting (which would be O(n log n)). The trick is a hash set: drop every value in, then only start counting a run
// from a value whose predecessor is ABSENT (a true run-start), walking forward while successors exist; because
// each element is visited at most twice overall, the whole thing is linear. This shows up in gap/coverage analysis
// ("what's the longest unbroken span of IDs/days/ports we have?"), streak detection, and de-fragmentation
// heuristics. Also included: the length of the longest run of 1s in a binary array (a common streak/uptime query).
// Duplicates are ignored (treated as a set). Integer arrays. LEAF -- imports NOTHING.

// The length of the longest run of consecutive integers present in `arr` (unsorted, duplicates ignored). O(n).
fn longest_consecutive(arr: list) -> int
    let set = {}
    for i in 0..len(arr)
        set[str(arr[i])] = 1
    let best = 0
    for j in 0..len(arr)
        let x = arr[j]
        // only extend from a true run start (x-1 not present)
        if str(x - 1) not in set
            let cur = x
            let length = 1
            while str(cur + 1) in set
                cur += 1
                length += 1
            if length > best
                best = length
    best

// The smallest starting value of a longest consecutive run (which integer it begins at), or 0 for an empty array.
fn longest_consecutive_start(arr: list) -> int
    let set = {}
    for i in 0..len(arr)
        set[str(arr[i])] = 1
    let best = 0
    let start = 0
    for j in 0..len(arr)
        let x = arr[j]
        if str(x - 1) not in set
            let cur = x
            let length = 1
            while str(cur + 1) in set
                cur += 1
                length += 1
            if length > best or (length == best and x < start)
                best = length
                start = x
    start

// The length of the longest run of consecutive 1s in a binary (0/1) array -- a streak/uptime query.
fn max_consecutive_ones(arr: list) -> int
    let best = 0
    let cur = 0
    for i in 0..len(arr)
        if arr[i] == 1
            cur += 1
            if cur > best
                best = cur
        else
            cur = 0
    best
