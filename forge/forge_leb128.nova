// forge_leb128 -- LEB128 variable-length integer encoding: store an integer in as few bytes as its magnitude
// needs (small numbers take one byte, large ones grow 7 bits at a time). This is the integer format of
// WebAssembly and DWARF debug info, and a building block for compact binary protocols and file formats. NOVA
// compiles to WASM, so this is the on-the-wire integer encoding for that target. Two flavors: UNSIGNED
// (uleb128) for non-negative values, and SIGNED (sleb128) which sign-extends so negatives round-trip exactly
// (this is DIFFERENT from protobuf's zig-zag signed varint in forge_protobuf -- LEB128 is the WASM/DWARF
// convention). Encoded output is a list of byte integers (0..255); decode reads from such a list at an offset.
// LEAF -- imports NOTHING.

// Encode a non-negative integer as unsigned LEB128; returns a list of bytes (0..255).
fn uleb128_encode(n: int) -> list
    let out = []
    let v = n
    let done = false
    while not done
        let byte = v & 127
        v = v / 128
        if v != 0
            push(out, byte + 128)
        else
            push(out, byte)
            done = true
    out

// Decode an unsigned LEB128 value from `bytes` starting at `offset`; returns [value, next_offset].
fn uleb128_decode(bytes: list, offset: int) -> list
    let result = 0
    let shift = 0
    let i = offset
    let done = false
    while not done
        let byte = bytes[i]
        i += 1
        result += ((byte & 127) << shift)
        shift += 7
        if (byte & 128) == 0
            done = true
    [result, i]

// Encode a signed integer as signed LEB128 (sign-extended); returns a list of bytes.
fn sleb128_encode(n: int) -> list
    let out = []
    let v = n
    let more = true
    while more
        let byte = v & 127
        v = v >> 7
        let sign_set = (byte & 64) != 0
        if (v == 0 and not sign_set) or (v == -1 and sign_set)
            more = false
        else
            byte += 128
        push(out, byte)
    out

// Decode a signed LEB128 value from `bytes` starting at `offset`; returns [value, next_offset].
fn sleb128_decode(bytes: list, offset: int) -> list
    let result = 0
    let shift = 0
    let i = offset
    let byte = 0
    let done = false
    while not done
        byte = bytes[i]
        i += 1
        result += ((byte & 127) << shift)
        shift += 7
        if (byte & 128) == 0
            done = true
    // sign-extend if the sign bit (bit 6) of the final byte is set
    if (byte & 64) != 0
        result -= (1 << shift)
    [result, i]
