// forge_permissions — Fine-grained permission system (ABAC-style).
// Policies, resource permissions, attribute-based access decisions.

fn perm_new() -> dict
    {"policies": [], "grants": {}}

fn perm_add_policy(pm: dict, subject: string, action: string, resource: string, effect: string) -> dict
    let pol = {"subject": subject, "action": action, "resource": resource, "effect": effect}
    push(pm["policies"], pol)
    pm

fn perm_grant(pm: dict, subject: string, resource: string, actions: list) -> dict
    let key = subject + ":" + resource
    pm["grants"][key] = actions
    pm

fn perm_check(pm: dict, subject: string, action: string, resource: string) -> bool
    let key = subject + ":" + resource
    let has_grant = key in pm["grants"]
    if has_grant
        let actions = pm["grants"][key]
        for i in 0..len(actions)
            if actions[i] == action or actions[i] == "*"
                return true
    for i in 0..len(pm["policies"])
        let pol = pm["policies"][i]
        let subj_match = pol["subject"] == subject or pol["subject"] == "*"
        let act_match = pol["action"] == action or pol["action"] == "*"
        let res_match = pol["resource"] == resource or pol["resource"] == "*"
        if subj_match and act_match and res_match and pol["effect"] == "allow"
            return true
    false

fn perm_revoke(pm: dict, subject: string, resource: string) -> dict
    let key = subject + ":" + resource
    let has_grant = key in pm["grants"]
    if has_grant
        pm["grants"][key] = []
    pm

fn perm_list_grants(pm: dict, subject: string) -> list
    let result = []
    let all_keys = keys(pm["grants"])
    let prefix = subject + ":"
    for i in 0..len(all_keys)
        let k = all_keys[i]
        if len(k) > len(prefix)
            let found = false
            for j in 0..len(prefix)
                if k[j] != prefix[j]
                    found = true
            if not found
                push(result, {"key": k, "actions": pm["grants"][k]})
    result

fn perm_policy_count(pm: dict) -> int
    len(pm["policies"])
