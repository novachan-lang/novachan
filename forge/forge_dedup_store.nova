// forge_dedup_store — deduplication store with Result API.

fn dd_new() -> dict
    let d = {}
    d["seen"] = {}
    d["count"] = 0
    d["dup_count"] = 0
    d

fn dd_check_and_add(d: dict, key: string) -> Result
    let sk = "s_" + key
    let has = contains(d["seen"], sk)
    if has == true
        d["dup_count"] = d["dup_count"] + 1
        return err("duplicate: " + key)
    d["seen"][sk] = 1
    d["count"] = d["count"] + 1
    ok(d)

fn dd_is_duplicate(d: dict, key: string) -> int
    let sk = "s_" + key
    let has = contains(d["seen"], sk)
    if has == true
        return 1
    0

fn dd_count(d: dict) -> int
    d["count"]

fn dd_dup_count(d: dict) -> int
    d["dup_count"]

fn dd_dup_rate(d: dict) -> int
    let total = d["count"] + d["dup_count"]
    if total == 0
        return 0
    d["dup_count"] * 100 / total
