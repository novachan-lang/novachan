// forge_request_validator — Request validation middleware.
// Validate request body fields, headers, query params.

fn rv_new() -> dict
    let rv = {}
    rv["rules"] = []
    rv

fn rv_require_field(rv: dict, field: string) -> dict
    let rule = {}
    rule["type"] = "required"
    rule["field"] = field
    push(rv["rules"], rule)
    rv

fn rv_require_type(rv: dict, field: string, expected_type: string) -> dict
    let rule = {}
    rule["type"] = "type_check"
    rule["field"] = field
    rule["expected"] = expected_type
    push(rv["rules"], rule)
    rv

fn rv_min_length(rv: dict, field: string, min_len: int) -> dict
    let rule = {}
    rule["type"] = "min_length"
    rule["field"] = field
    rule["min"] = min_len
    push(rv["rules"], rule)
    rv

fn rv_max_length(rv: dict, field: string, max_len: int) -> dict
    let rule = {}
    rule["type"] = "max_length"
    rule["field"] = field
    rule["max"] = max_len
    push(rv["rules"], rule)
    rv

fn rv_validate(rv: dict, body: dict) -> dict
    let result = {}
    result["valid"] = 1
    result["errors"] = []
    let i = 0
    while i < len(rv["rules"])
        let rule = rv["rules"][i]
        if rule["type"] == "required"
            let has = contains(body, rule["field"])
            if has != true
                result["valid"] = 0
                push(result["errors"], "missing: " + rule["field"])
        if rule["type"] == "type_check"
            let has = contains(body, rule["field"])
            if has == true
                let t = type_of(body[rule["field"]])
                if t != rule["expected"]
                    result["valid"] = 0
                    push(result["errors"], "wrong type: " + rule["field"])
        if rule["type"] == "min_length"
            let has = contains(body, rule["field"])
            if has == true
                let val = body[rule["field"]]
                if len(str(val)) < rule["min"]
                    result["valid"] = 0
                    push(result["errors"], "too short: " + rule["field"])
        if rule["type"] == "max_length"
            let has = contains(body, rule["field"])
            if has == true
                let val = body[rule["field"]]
                if len(str(val)) > rule["max"]
                    result["valid"] = 0
                    push(result["errors"], "too long: " + rule["field"])
        i = i + 1
    result

fn rv_rule_count(rv: dict) -> int
    len(rv["rules"])
