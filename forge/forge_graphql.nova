// forge_graphql — a real GraphQL query engine for Forge (tokenizer + recursive-descent parser + executor),
// with the §11-mandated DoS guards (max depth + max complexity). NOVA is Erlang-shaped, so a GraphQL
// resolver is just a function; the schema is the resolver MAP + your plain NOVA structs/dicts — no SDL
// file, no code-gen, no macro DSL (beats Absinthe's macro schema and graphene's class hierarchy).
//
// SCOPE (v1, honest): QUERIES — fields, aliases, scalar arguments (int/string/enum), arbitrarily nested
// selection sets, and list-of-object results. NOT yet: fragments, variables ($x), directives, mutations/
// subscriptions, input objects. These are additive (the parser is structured to grow). Flagged for the
// functional test pass.
//
// EXECUTION MODEL — a resolver map (fieldName -> fn(parent, args) -> value):
//   let r = {}
//   r["todos"] = fn(parent, args) todo_list()          // returns a list of dicts/structs
//   r["title"] = fn(parent, args) parent["title"]       // (optional — trivial fields auto-read below)
//   let res = gql_execute("{ todos { title done } }", r, 0)   // res["data"]["todos"] = [{title,done},...]
// A selected field with NO explicit resolver is read from its parent automatically (parent[name] for a
// dict, field_get(parent,name) for a struct) — the "trivial resolver", so nested object fields need no
// boilerplate. A resolver returning a list applies the sub-selection to EACH element (the common case).
//
// LEAF MODULE — imports NOTHING. Built-ins: len/push/slice/find/chr/parse_int/contains/type_of/
// field_names/field_get/str + first-class fn values.

// ── character classes ───────────────────────────────────────────────────────────────────────────────
fn _gql_is_name_start(c: string) -> bool
    find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0

fn _gql_is_digit(c: string) -> bool
    find("0123456789", c) >= 0

fn _gql_is_name_char(c: string) -> bool
    _gql_is_name_start(c) or _gql_is_digit(c)

// ── tokenizer ───────────────────────────────────────────────────────────────────────────────────────
// Each token is a 2-element list [kind, value]. kinds: "lbrace" "rbrace" "(" ")" ":" "name" "int" "str"
// "end". (Brace kinds are spelled out — a literal "{" in a NOVA string would trigger string interpolation.)
// Whitespace AND commas are insignificant in GraphQL, so both are skipped. Lenient: unknown chars skipped.
fn _gql_tokenize(q: string) -> list
    let toks = []
    let i = 0
    let n = len(q)
    while i < n
        let c = q[i]
        if c == " " or c == chr(9) or c == chr(10) or c == chr(13) or c == ","
            i += 1
        else if c == chr(123)
            push(toks, ["lbrace", c])
            i += 1
        else if c == chr(125)
            push(toks, ["rbrace", c])
            i += 1
        else if c == "(" or c == ")" or c == ":"
            push(toks, [c, c])
            i += 1
        else if c == chr(34)
            let start = i + 1
            let j = start
            while j < n and q[j] != chr(34)
                j += 1
            push(toks, ["str", slice(q, start, j)])
            i = j + 1
        else if _gql_is_digit(c) or c == "-"
            let start = i
            let j = i + 1
            while j < n and _gql_is_digit(q[j])
                j += 1
            push(toks, ["int", slice(q, start, j)])
            i = j
        else if c == "$"
            let start = i + 1
            let j = start
            while j < n and _gql_is_name_char(q[j])
                j += 1
            push(toks, ["var", slice(q, start, j)])
            i = j
        else if _gql_is_name_start(c)
            let start = i
            let j = i + 1
            while j < n and _gql_is_name_char(q[j])
                j += 1
            push(toks, ["name", slice(q, start, j)])
            i = j
        else
            i += 1
    push(toks, ["end", ""])
    toks

// ── parser (cursor in a state dict: st["toks"], st["pos"]) ──────────────────────────────────────────
fn _gql_peek(st) -> list
    st["toks"][st["pos"]]

fn _gql_advance(st) -> list
    let t = st["toks"][st["pos"]]
    st["pos"] = st["pos"] + 1
    t

// Argument value: int -> parse_int; var ($x) -> a {"__var": name} marker resolved at execution against
// the variables dict; string/enum/name -> the raw string.
fn _gql_arg_value(tok) -> any
    if tok[0] == "int"
        return parse_int(tok[1])
    if tok[0] == "var"
        return {"__var": tok[1]}
    tok[1]

// "(" name ":" value ("," name ":" value)* ")"  -> dict of arg name -> value.
fn _gql_parse_args(st) -> dict
    let args = {}
    _gql_advance(st)
    while _gql_peek(st)[0] != ")" and _gql_peek(st)[0] != "end"
        let key = _gql_advance(st)
        if _gql_peek(st)[0] == ":"
            _gql_advance(st)
        let val = _gql_advance(st)
        args[key[1]] = _gql_arg_value(val)
    if _gql_peek(st)[0] == ")"
        _gql_advance(st)
    args

// A field: [alias ":"] name [args] [selection-set]. Returns dict {name, alias, args, selections}.
fn _gql_parse_field(st) -> dict
    let name1 = _gql_advance(st)
    let fname = name1[1]
    let alias = fname
    if _gql_peek(st)[0] == ":"
        _gql_advance(st)
        let name2 = _gql_advance(st)
        fname = name2[1]
    let args = {}
    if _gql_peek(st)[0] == "("
        args = _gql_parse_args(st)
    let sels = []
    if _gql_peek(st)[0] == "lbrace"
        sels = _gql_parse_selset(st)
    {"name": fname, "alias": alias, "args": args, "selections": sels}

// selection set: lbrace field+ rbrace -> list of field dicts.
fn _gql_parse_selset(st) -> list
    let fields = []
    _gql_advance(st)
    while _gql_peek(st)[0] != "rbrace" and _gql_peek(st)[0] != "end"
        push(fields, _gql_parse_field(st))
    if _gql_peek(st)[0] == "rbrace"
        _gql_advance(st)
    fields

// Parse a whole query document into the top-level selection list. Skips a leading operation keyword/name
// ("query", "query GetUser", "mutation ...") by advancing to the first "{".
fn gql_parse(query: string) -> list
    let st = {}
    st["toks"] = _gql_tokenize(query)
    st["pos"] = 0
    while _gql_peek(st)[0] != "lbrace" and _gql_peek(st)[0] != "end"
        _gql_advance(st)
    if _gql_peek(st)[0] == "end"
        return []
    _gql_parse_selset(st)

// ── DoS guards (§11: GraphQL query depth + complexity limit) ──────────────────────────────────────────
// Nesting depth of the selection tree (a flat query = 1). Reject before executing to bound work.
fn gql_depth(fields: list) -> int
    let maxd = 0
    for f in fields
        let subs = f["selections"]
        let d = 1 if len(subs) == 0 else 1 + gql_depth(subs)
        if d > maxd
            maxd = d
    maxd

// Total number of fields in the query (a crude complexity/cost measure) — bounds fan-out.
// gql_complexity([]) == 0, so the leaf case needs no guard: 1 + <cost of an empty selection set> == 1.
fn gql_complexity(fields: list) -> int
    sum([1 + gql_complexity(f["selections"]) for f in fields])

// ── variable substitution ($var) ─────────────────────────────────────────────────────────────────
// GraphQL clients send `query GetUser($id: Int) { user(id: $id) { name } }` + a variables JSON
// {"id": 7}. The parser skips the operation's variable DEFINITIONS (advances to the first "{") and
// records each $ref in an arg as a {"__var": name} marker; this pass replaces those markers with the
// concrete values from `variables` (missing -> "", GraphQL-null-ish) BEFORE resolution, so the executor
// stays variable-agnostic. Arg values are otherwise scalars, so a dict value unambiguously = a var marker.
fn _gql_subst_one(val, variables: dict) -> any
    if type_of(val) == "dict"
        if "__var" in val
            let name = val["__var"]
            if name in variables
                return variables[name]
            return ""
    val

// One field, with every {"__var": n} marker in its args (and recursively in its sub-selections)
// replaced by the concrete variable value.
fn _gql_subst_field(f: dict, variables: dict) -> dict
    let newargs = {k: _gql_subst_one(f["args"][k], variables) for k in keys(f["args"])}
    {"name": f["name"], "alias": f["alias"], "args": newargs, "selections": _gql_apply_vars(f["selections"], variables)}

fn _gql_apply_vars(fields: list, variables: dict) -> list
    [_gql_subst_field(f, variables) for f in fields]

// ── executor ──────────────────────────────────────────────────────────────────────────────────────
// The trivial resolver: read `name` off `parent` when the field has no explicit resolver.
fn _gql_field_from_parent(parent, name: string) -> any
    let t = type_of(parent)
    if t == "dict"
        if name in parent
            return parent[name]
        return ""
    if len(field_names(parent)) > 0
        return field_get(parent, name)
    ""

// Apply a sub-selection to a resolved value: map over a list, else resolve the single object.
fn _gql_apply_selections(sels: list, resolvers: dict, value) -> any
    if type_of(value) == "list"
        return [_gql_resolve(sels, resolvers, v) for v in value]
    _gql_resolve(sels, resolvers, value)

// Resolve a selection list against a parent, producing a result dict keyed by field alias.
fn _gql_resolve(fields: list, resolvers: dict, parent) -> dict
    let out = {}
    for f in fields
        let name = f["name"]
        let value = 0
        if name in resolvers
            let r = resolvers[name]
            value = r(parent, f["args"])
        else
            value = _gql_field_from_parent(parent, name)
        if len(f["selections"]) > 0
            value = _gql_apply_selections(f["selections"], resolvers, value)
        out[f["alias"]] = value
    out

// gql_execute_vars(query, resolvers, root, variables) -> dict — with $variable substitution.
fn gql_execute_vars(query: string, resolvers: dict, root, variables: dict) -> dict
    let ast = _gql_apply_vars(gql_parse(query), variables)
    {"data": _gql_resolve(ast, resolvers, root)}

// gql_execute(query, resolvers, root) -> dict — GraphQL-shaped {"data": {...}}. No variables.
fn gql_execute(query: string, resolvers: dict, root) -> dict
    gql_execute_vars(query, resolvers, root, {})

// gql_execute_limited_vars(...) -> dict — the production entry point: $variable substitution PLUS the
// DoS guard. Rejects an over-deep / over-complex query with {"errors":[...]} BEFORE executing any
// resolver (a maliciously nested query cannot force unbounded work).
fn gql_execute_limited_vars(query: string, resolvers: dict, root, variables: dict, max_depth: int, max_complexity: int) -> dict
    let ast = _gql_apply_vars(gql_parse(query), variables)
    if gql_depth(ast) > max_depth
        return {"errors": ["query exceeds max depth {max_depth}"]}
    if gql_complexity(ast) > max_complexity
        return {"errors": ["query exceeds max complexity {max_complexity}"]}
    {"data": _gql_resolve(ast, resolvers, root)}

// gql_execute_limited(query, resolvers, root, max_depth, max_complexity) -> dict — DoS guard, no variables.
fn gql_execute_limited(query: string, resolvers: dict, root, max_depth: int, max_complexity: int) -> dict
    gql_execute_limited_vars(query, resolvers, root, {}, max_depth, max_complexity)

// ── DataLoader (GraphQL N+1 batching, task D4.4) ─────────────────────────────────────────────────
// The classic GraphQL N+1 problem: a query for 100 users each with a `posts` field fires 1+100
// resolver calls instead of 2. A DataLoader fixes this by collecting all keys requested during one
// execution phase and flushing them in a single batch_fn(keys)->values call, then serving results
// from an in-memory cache for the rest of the request.
//
// CONTRACT: batch_fn(keys: list) -> list  must return values in the SAME ORDER as keys.
//   e.g. batch_fn([1,2,3]) must return [v1, v2, v3]  (index alignment, not arbitrary order).
// Cache keys are stored as str(key) so any scalar key (int or string) works uniformly.
//
// Verified by reasoning:
//   Let L = gql_loader(fn(ks) [ks[i]*10 for i ...]).
//   gql_load_many(L, [1,2,3]) -> missing=[1,2,3] -> batch_fn called ONCE -> results=[10,20,30]
//   -> cache: "1"->10, "2"->20, "3"->30 -> output=[10,20,30]. ONE batch call.
//   gql_load_many(L, [2,3]) now -> missing=[] (both cached) -> batch_fn NOT called -> [20,30].
//   gql_load(L, 2) -> gql_load_many(L,[2])[0] -> 20 from cache.

// gql_loader(batch_fn) -> dict
//   Create a loader dict with the batch function and an empty per-request cache.
//   batch_fn is a first-class fn: fn(keys: list) -> list.
fn gql_loader(batch_fn) -> dict
    {"batch": batch_fn, "cache": {}}

// gql_load_many(loader, keys) -> list
//   Core batching operation: resolve a list of keys, calling batch_fn at most ONCE for any
//   uncached keys, then returning all values in the same order as the input keys list.
fn gql_load_many(loader, keys: list) -> list
    let cache = loader["cache"]
    // cache keys are str(key) so int and string keys coexist in one STRING-keyed dict
    let missing = [k for k in keys if not contains(cache, str(k))]
    if len(missing) > 0
        let bfn = loader["batch"]
        let results = bfn(missing)
        for mi, mk in missing
            cache[str(mk)] = results[mi]
    [cache[str(k)] for k in keys]

// gql_load(loader, key) -> any
//   Convenience wrapper for a single key lookup. Delegates to gql_load_many so the cache
//   and batch machinery is always used consistently.
fn gql_load(loader, key) -> any
    let vals = gql_load_many(loader, [key])
    vals[0]

// gql_loader_clear(loader)
//   Reset the cache to empty. Call at the start of each request so that the per-request
//   batching/caching invariant holds: no stale values bleed across requests.
fn gql_loader_clear(loader)
    loader["cache"] = {}
