// forge_change_data_capture — Track changes to records for CDC pipelines.

fn cdc_new() -> dict
    let c = {}
    c["changes"] = {}
    c["count"] = 0
    c["next_seq"] = 1
    c

fn cdc_insert(c: dict, table: string, key: string, value: string) -> dict
    let seq = c["next_seq"]
    let k = str(seq)
    c["changes"][k + "_op"] = "INSERT"
    c["changes"][k + "_table"] = table
    c["changes"][k + "_key"] = key
    c["changes"][k + "_value"] = value
    c["next_seq"] = seq + 1
    c["count"] = c["count"] + 1
    c

fn cdc_update(c: dict, table: string, key: string, old_val: string, new_val: string) -> dict
    let seq = c["next_seq"]
    let k = str(seq)
    c["changes"][k + "_op"] = "UPDATE"
    c["changes"][k + "_table"] = table
    c["changes"][k + "_key"] = key
    c["changes"][k + "_old"] = old_val
    c["changes"][k + "_new"] = new_val
    c["next_seq"] = seq + 1
    c["count"] = c["count"] + 1
    c

fn cdc_delete_record(c: dict, table: string, key: string) -> dict
    let seq = c["next_seq"]
    let k = str(seq)
    c["changes"][k + "_op"] = "DELETE"
    c["changes"][k + "_table"] = table
    c["changes"][k + "_key"] = key
    c["next_seq"] = seq + 1
    c["count"] = c["count"] + 1
    c

fn cdc_change_count(c: dict) -> int
    c["count"]

fn cdc_change_op(c: dict, seq: int) -> string
    let has = contains(c["changes"], str(seq) + "_op")
    if has != true
        return ""
    c["changes"][str(seq) + "_op"]

fn cdc_change_table(c: dict, seq: int) -> string
    let has = contains(c["changes"], str(seq) + "_table")
    if has != true
        return ""
    c["changes"][str(seq) + "_table"]

fn cdc_change_key(c: dict, seq: int) -> string
    let has = contains(c["changes"], str(seq) + "_key")
    if has != true
        return ""
    c["changes"][str(seq) + "_key"]

fn cdc_next_seq(c: dict) -> int
    c["next_seq"]
