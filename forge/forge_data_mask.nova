// forge_data_mask — PII/sensitive data masking.
// Mask emails, phone numbers, credit cards, and custom fields.

fn dm_mask_email(email: string) -> string
    let at_pos = -1
    let i = 0
    while i < len(email)
        if email[i] == "@"
            at_pos = i
        i = i + 1
    if at_pos < 1
        return "***"
    let first = email[0]
    let domain = ""
    let j = at_pos
    while j < len(email)
        domain = domain + email[j]
        j = j + 1
    first + "***" + domain

fn dm_mask_phone(phone: string) -> string
    if len(phone) < 4
        return "****"
    let last4 = ""
    let i = len(phone) - 4
    while i < len(phone)
        last4 = last4 + phone[i]
        i = i + 1
    "***-***-" + last4

fn dm_mask_card(card: string) -> string
    let digits = ""
    let i = 0
    while i < len(card)
        let c = card[i]
        if c >= "0"
            if c <= "9"
                digits = digits + c
        i = i + 1
    if len(digits) < 4
        return "****"
    let last4 = ""
    let j = len(digits) - 4
    while j < len(digits)
        last4 = last4 + digits[j]
        j = j + 1
    "****-****-****-" + last4

fn dm_mask_string(s: string, visible_start: int, visible_end: int) -> string
    let result = ""
    let i = 0
    while i < len(s)
        if i < visible_start
            result = result + s[i]
        else
            let tail_pos = len(s) - visible_end
            if i >= tail_pos
                result = result + s[i]
            else
                result = result + "*"
        i = i + 1
    result

fn dm_redact(s: string) -> string
    let result = ""
    let i = 0
    while i < len(s)
        result = result + "*"
        i = i + 1
    result

fn dm_mask_dict(d: dict, field_names: list) -> dict
    let result = {}
    let all_keys = keys(d)
    let i = 0
    while i < len(all_keys)
        let k = all_keys[i]
        let should_mask = 0
        let j = 0
        while j < len(field_names)
            if field_names[j] == k
                should_mask = 1
            j = j + 1
        if should_mask == 1
            result[k] = "***REDACTED***"
        else
            result[k] = d[k]
        i = i + 1
    result

fn dm_mask_ssn(ssn: string) -> string
    if len(ssn) < 4
        return "***"
    let last4 = ""
    let i = len(ssn) - 4
    while i < len(ssn)
        last4 = last4 + ssn[i]
        i = i + 1
    "***-**-" + last4
