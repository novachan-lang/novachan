// forge_data_mask — PII/sensitive data masking.
// Mask emails, phone numbers, credit cards, and custom fields.

fn dm_mask_email(email: string) -> string
    let at_pos = -1
    for i in 0..len(email)
        if email[i] == "@"
            at_pos = i
    if at_pos < 1
        return "***"
    let first = email[0]
    let domain_parts = []
    let j = at_pos
    while j < len(email)
        push(domain_parts, email[j])
        j += 1
    let domain = join(domain_parts, "")
    first + "***" + domain

fn dm_mask_phone(phone: string) -> string
    if len(phone) < 4
        return "****"
    let last4 = ""
    let i = len(phone) - 4
    while i < len(phone)
        last4 += phone[i]
        i += 1
    "***-***-" + last4

fn dm_mask_card(card: string) -> string
    let digits_parts = []
    for i in 0..len(card)
        let c = card[i]
        if c >= "0"
            if c <= "9"
                push(digits_parts, c)
    let digits = join(digits_parts, "")
    if len(digits) < 4
        return "****"
    let last4 = ""
    let j = len(digits) - 4
    while j < len(digits)
        last4 += digits[j]
        j += 1
    "****-****-****-" + last4

fn dm_mask_string(s: string, visible_start: int, visible_end: int) -> string
    let result = ""
    for i in 0..len(s)
        if i < visible_start
            result += s[i]
        else
            let tail_pos = len(s) - visible_end
            if i >= tail_pos
                result += s[i]
            else
                result += "*"
    result

fn dm_redact(s: string) -> string
    let result_parts = []
    for i in 0..len(s)
        push(result_parts, "*")
    let result = join(result_parts, "")
    result

fn dm_mask_dict(d: dict, field_names: list) -> dict
    let result = {}
    let all_keys = keys(d)
    for i in 0..len(all_keys)
        let k = all_keys[i]
        let should_mask = 0
        let j = 0
        while j < len(field_names)
            if field_names[j] == k
                should_mask = 1
            j += 1
        if should_mask == 1
            result[k] = "***REDACTED***"
        else
            result[k] = d[k]
    result

fn dm_mask_ssn(ssn: string) -> string
    if len(ssn) < 4
        return "***"
    let last4_parts = []
    let i = len(ssn) - 4
    while i < len(ssn)
        push(last4_parts, ssn[i])
        i += 1
    let last4 = join(last4_parts, "")
    "***-**-" + last4
