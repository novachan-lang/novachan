// forge_data_mask — PII/sensitive data masking.
// Mask emails, phone numbers, credit cards, and custom fields.

fn dm_mask_email(email: string) -> string
    let at_pos = -1
    for i in 0..len(email)
        if email[i] == "@"
            at_pos = i
    if at_pos < 1
        return "***"
    let first = email[0]
    let domain_parts = [email[j] for j in at_pos..len(email)]
    let domain = join(domain_parts, "")
    first + "***" + domain

fn dm_mask_phone(phone: string) -> string
    if len(phone) < 4
        return "****"
    let last4 = ""
    for i in (len(phone) - 4)..len(phone)
        last4 += phone[i]
    "***-***-" + last4

fn dm_mask_card(card: string) -> string
    let digits = join([card[i] for i in 0..len(card) if card[i] >= "0" and card[i] <= "9"], "")
    if len(digits) < 4
        return "****"
    let last4 = ""
    for j in (len(digits) - 4)..len(digits)
        last4 += digits[j]
    "****-****-****-" + last4

fn dm_mask_string(s: string, visible_start: int, visible_end: int) -> string
    let result = ""
    for i in 0..len(s)
        if i < visible_start
            result += s[i]
        else
            let tail_pos = len(s) - visible_end
            if i >= tail_pos
                result += s[i]
            else
                result += "*"
    result

fn dm_redact(s: string) -> string
    let result_parts = ["*" for i in 0..len(s)]
    join(result_parts, "")

fn dm_mask_dict(d: dict, field_names: list) -> dict
    let result = {}
    let all_keys = keys(d)
    for i in 0..len(all_keys)
        let k = all_keys[i]
        if k in field_names
            result[k] = "***REDACTED***"
        else
            result[k] = d[k]
    result

fn dm_mask_ssn(ssn: string) -> string
    if len(ssn) < 4
        return "***"
    let last4 = join([ssn[i] for i in (len(ssn) - 4)..len(ssn)], "")
    "***-**-" + last4
