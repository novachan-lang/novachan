// forge_error_tracker — error tracking and grouping with Result API.

fn et_new() -> dict
    let e = {}
    e["errors"] = {}
    e["counts"] = {}
    e["total"] = 0
    e["unique"] = 0
    e["last_error"] = ""
    e

fn et_record(e: dict, error_type: string, message: string) -> dict
    let ck = "c_" + error_type
    if contains(e["counts"], ck) == true
        e["counts"][ck] = e["counts"][ck] + 1
    else
        e["counts"][ck] = 1
        e["unique"] = e["unique"] + 1
    let mk = "m_" + error_type
    e["errors"][mk] = message
    e["total"] = e["total"] + 1
    e["last_error"] = error_type + ": " + message
    e

fn et_count_for(e: dict, error_type: string) -> Result
    let ck = "c_" + error_type
    if contains(e["counts"], ck) != true
        return err("error type not recorded")
    ok(e["counts"][ck])

fn et_message_for(e: dict, error_type: string) -> Result
    let mk = "m_" + error_type
    if contains(e["errors"], mk) != true
        return err("error type not recorded")
    ok(e["errors"][mk])

fn et_last_error(e: dict) -> Result
    if e["last_error"] == ""
        return err("no errors recorded")
    ok(e["last_error"])

fn et_total(e: dict) -> int
    e["total"]

fn et_unique_count(e: dict) -> int
    e["unique"]

fn et_error_rate(e: dict, error_type: string, total_requests: int) -> Result
    if total_requests == 0
        return err("zero requests")
    let ck = "c_" + error_type
    if contains(e["counts"], ck) != true
        return ok(0)
    ok(e["counts"][ck] * 100 / total_requests)
