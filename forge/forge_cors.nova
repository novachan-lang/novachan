// forge_cors -- CORS (Cross-Origin Resource Sharing) response-header generation for web servers. Decides
// whether an Origin is allowed (exact match or "*" wildcard) and builds the Access-Control-* response
// headers for both simple/actual responses and OPTIONS preflight responses. Pure header computation --
// no I/O; the caller is responsible for writing the returned dict onto the actual HTTP response.

// Default allowed methods when the caller passes an empty list.
fn _cors_default_methods() -> list<string>
    ["GET", "POST", "OPTIONS"]

// Default allowed headers when the caller passes an empty list.
fn _cors_default_headers() -> list<string>
    ["Content-Type", "Authorization"]

// The Vary header value CORS responses should carry whenever Access-Control-Allow-Origin
// echoes back a specific origin (rather than "*") -- tells caches the response varies by Origin.
fn cors_vary_header() -> string
    "Origin"

// 1 if `origin` is allowed to make cross-origin requests per `allowed_origins`: either
// allowed_origins contains the literal wildcard "*", or it contains `origin` exactly. 0 otherwise.
fn cors_is_allowed(origin: string, allowed_origins: list<string>) -> int
    if "*" in allowed_origins
        return 1
    if origin in allowed_origins
        return 1
    0

// Build the CORS response headers for an actual (non-preflight) request. Returns {} (no CORS
// headers) when `origin` is not allowed -- the browser will then reject the response client-side.
// When allowed: Access-Control-Allow-Origin (echoing "*" or the specific origin), a Vary: Origin
// header when the origin is echoed specifically (so shared caches don't leak cross-origin), and
// Access-Control-Allow-Methods. Empty allowed_methods falls back to GET/POST/OPTIONS.
fn cors_headers(origin: string, allowed_origins: list<string>, allowed_methods: list<string>, allowed_headers: list<string>, max_age: int) -> dict
    let h = {}
    if cors_is_allowed(origin, allowed_origins) == 0
        return h
    let methods = allowed_methods if len(allowed_methods) > 0 else _cors_default_methods()
    if "*" in allowed_origins
        h["Access-Control-Allow-Origin"] = "*"
    else
        h["Access-Control-Allow-Origin"] = origin
        h["Vary"] = cors_vary_header()
    h["Access-Control-Allow-Methods"] = join(methods, ", ")
    h

// Build the CORS response headers for an OPTIONS preflight request: everything cors_headers
// returns, plus Access-Control-Allow-Headers (falls back to Content-Type/Authorization when
// allowed_headers is empty) and Access-Control-Max-Age (preflight cache lifetime in seconds).
// Returns {} when `origin` is not allowed, same as cors_headers.
fn cors_preflight(origin: string, allowed_origins: list<string>, allowed_methods: list<string>, allowed_headers: list<string>, max_age: int) -> dict
    let h = cors_headers(origin, allowed_origins, allowed_methods, allowed_headers, max_age)
    if cors_is_allowed(origin, allowed_origins) == 0
        return h
    let headers = allowed_headers if len(allowed_headers) > 0 else _cors_default_headers()
    h["Access-Control-Allow-Headers"] = join(headers, ", ")
    h["Access-Control-Max-Age"] = str(max_age)
    h
