// forge_convexgeom -- EXACT integer computational geometry on convex polygons: the convex hull of a point set, a
// point-in-convex-polygon test, the polygon's diameter (farthest pair of vertices), and the Minkowski sum of two
// convex polygons. Doing this with integer coordinates and cross products -- instead of floating point -- means the
// answers are EXACT and robust: three collinear points are detected as exactly collinear, "is this point inside"
// never flickers on a boundary because of rounding, and a hull never gains a spurious vertex from a 1e-15 error.
// That matters for GIS and map overlays, collision detection and physics broad-phase (the Minkowski sum reduces
// "do two convex shapes overlap / how far can one move" to a point-in-polygon test), CAD/CNC, integer-lattice
// combinatorics, and robotics motion planning. The convex hull uses Andrew's monotone chain (sort, then one sweep
// up and one down); point_in_convex checks the query is on the inner side of every edge; polygon_diameter_sq uses
// rotating calipers to find the farthest pair in linear time; and minkowski_sum merges the two edge sequences by
// angle. Points are [x, y] integer pairs and polygons are vertex lists in counter-clockwise order; distances are
// returned SQUARED (exact integers, no square roots). LEAF -- imports NOTHING.

// PRIVATE: cross product of (a-o) and (b-o); >0 left turn (CCW), <0 right turn, 0 collinear.
fn _cg_cross(o: list, a: list, b: list) -> int
    (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

// The orientation of the ordered triple a,b,c: 1 if counter-clockwise (left turn), -1 if clockwise, 0 if collinear.
fn orientation(a: list, b: list, c: list) -> int
    let cr = _cg_cross(a, b, c)
    let out = 0
    if cr > 0
        out = 1
    else
        if cr < 0
            out = 0 - 1
    out

// Twice the signed area of a polygon (shoelace formula), exact integer. Positive if the vertices are CCW.
fn twice_signed_area(poly: list) -> int
    let n = len(poly)
    let s = 0
    let i = 0
    while i < n
        let a = poly[i]
        let b = poly[(i + 1) % n]
        s = s + (a[0] * b[1] - b[0] * a[1])
        i = i + 1
    s

// The convex hull of a set of [x,y] points, as a CCW vertex list with no collinear points, via Andrew's monotone
// chain. Returns the input (deduplicated ordering not guaranteed) if fewer than 3 points.
fn convex_hull(points: list) -> list
    let n = len(points)
    let out = []
    if n < 3
        let i = 0
        while i < n
            push(out, points[i])
            i = i + 1
    else
        // sort point INDICES by (x, then y) -- index array is integers, safe to sort
        let idx = []
        let z = 0
        while z < n
            push(idx, z)
            z = z + 1
        let a = 1
        while a < n
            let key = idx[a]
            let kp = points[key]
            let p = a - 1
            while p >= 0 and _cg_before(points[idx[p]], kp)
                idx[p + 1] = idx[p]
                p = p - 1
            idx[p + 1] = key
            a = a + 1
        // lower hull
        let lower = []
        let li = 0
        while li < n
            let pt = points[idx[li]]
            while len(lower) >= 2 and _cg_cross(lower[len(lower) - 2], lower[len(lower) - 1], pt) <= 0
                pop(lower)
            push(lower, pt)
            li = li + 1
        // upper hull
        let upper = []
        let ui = n - 1
        while ui >= 0
            let pt = points[idx[ui]]
            while len(upper) >= 2 and _cg_cross(upper[len(upper) - 2], upper[len(upper) - 1], pt) <= 0
                pop(upper)
            push(upper, pt)
            ui = ui - 1
        // concatenate, dropping the last point of each (it repeats the other's first)
        let k = 0
        while k < len(lower) - 1
            push(out, lower[k])
            k = k + 1
        let k2 = 0
        while k2 < len(upper) - 1
            push(out, upper[k2])
            k2 = k2 + 1
    out

// PRIVATE: is point q strictly before p in (x, then y) order? (used to insertion-sort indices, descending scan)
fn _cg_before(p: list, q: list) -> bool
    let out = false
    if p[0] > q[0]
        out = true
    else
        if p[0] == q[0] and p[1] > q[1]
            out = true
    out

// True if the point [px,py] is inside or on the boundary of a CONVEX polygon given in CCW order: it must lie on the
// inner (left) side of, or exactly on, every edge.
fn point_in_convex(poly: list, px: int, py: int) -> bool
    let n = len(poly)
    let out = true
    let q = [px, py]
    let i = 0
    while i < n
        let a = poly[i]
        let b = poly[(i + 1) % n]
        if _cg_cross(a, b, q) < 0
            out = false
        i = i + 1
    out

// PRIVATE: squared distance between two points.
fn _cg_distsq(a: list, b: list) -> int
    let dx = a[0] - b[0]
    let dy = a[1] - b[1]
    dx * dx + dy * dy

// The squared diameter of a convex polygon (CCW): the maximum squared distance between any two of its vertices,
// found in linear time by rotating calipers.
fn polygon_diameter_sq(poly: list) -> int
    let n = len(poly)
    let best = 0
    if n == 2
        best = _cg_distsq(poly[0], poly[1])
    else
        if n > 2
            let j = 1
            let i = 0
            while i < n
                let ni = (i + 1) % n
                while _cg_cross(poly[i], poly[ni], poly[(j + 1) % n]) > _cg_cross(poly[i], poly[ni], poly[j])
                    j = (j + 1) % n
                let d1 = _cg_distsq(poly[i], poly[j])
                let d2 = _cg_distsq(poly[ni], poly[j])
                if d1 > best
                    best = d1
                if d2 > best
                    best = d2
                i = i + 1
    best

// PRIVATE: rotate a CCW polygon so it starts at its lowest (min y, then min x) vertex.
fn _cg_start_lowest(poly: list) -> list
    let n = len(poly)
    let mi = 0
    let i = 1
    while i < n
        let p = poly[i]
        let m = poly[mi]
        if p[1] < m[1] or (p[1] == m[1] and p[0] < m[0])
            mi = i
        i = i + 1
    let out = []
    let k = 0
    while k < n
        push(out, poly[(mi + k) % n])
        k = k + 1
    out

// The Minkowski sum of two convex polygons A and B (each CCW): the convex polygon of all vector sums a+b. Merges
// the two edge sequences in angular order, O(nA + nB).
fn minkowski_sum(pa: list, pb: list) -> list
    let a = _cg_start_lowest(pa)
    let b = _cg_start_lowest(pb)
    let na = len(a)
    let nb = len(b)
    let out = []
    let i = 0
    let j = 0
    while i < na or j < nb
        let ai = a[i % na]
        let bj = b[j % nb]
        push(out, [ai[0] + bj[0], ai[1] + bj[1]])
        // compare the direction of edge A[i]->A[i+1] with edge B[j]->B[j+1]
        let a1 = a[(i + 1) % na]
        let a0 = a[i % na]
        let b1 = b[(j + 1) % nb]
        let b0 = b[j % nb]
        let ux = a1[0] - a0[0]
        let uy = a1[1] - a0[1]
        let vx = b1[0] - b0[0]
        let vy = b1[1] - b0[1]
        let cross = ux * vy - uy * vx
        if i >= na
            j = j + 1
        else
            if j >= nb
                i = i + 1
            else
                if cross > 0
                    i = i + 1
                else
                    if cross < 0
                        j = j + 1
                    else
                        i = i + 1
                        j = j + 1
    out
