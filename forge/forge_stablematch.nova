// forge_stablematch -- the Gale-Shapley stable matching algorithm (the "stable marriage problem"), the method that
// runs the US medical-residency Match, many public-school choice systems, and organ-exchange and job-market
// clearinghouses -- work that won Roth and Shapley the 2012 Nobel in economics. Given two equal-size groups (call
// them proposers and receivers) where everyone has ranked everyone on the other side, it produces a pairing with NO
// "blocking pair": there is no proposer and receiver who would BOTH rather be with each other than with their
// assigned partners. Such a matching always exists and Gale-Shapley always finds one: unmatched proposers propose
// down their list, each receiver tentatively holds her best proposer so far and trades up whenever a better one
// asks, and the process provably terminates with a stable, perfect matching -- and one that is optimal for the
// proposing side. Preferences are given as two lists of ranking lists (proposer_prefs[i] and receiver_prefs[j] each
// list the other side's indices best-first); the result maps each proposer to the receiver index they end up with.
// is_stable independently audits any matching for blocking pairs. Everything is integer/list. LEAF -- imports
// NOTHING.

// PRIVATE: build an n x n rank table where rank[a][b] = the position of b in a's preference list (0 = most
// preferred). Turns "who does a like" into "how much does a like b" for O(1) preference comparisons.
fn _sm_rank_table(prefs: list) -> list
    let n = len(prefs)
    let table = []
    let a = 0
    while a < n
        let row = [0 for z in 0..n]
        push(table, row)
        a += 1
    let i = 0
    while i < n
        let plist = prefs[i]
        let row = table[i]
        for r in 0..n
            row[plist[r]] = r
        i += 1
    table

// Compute a stable matching. proposer_prefs[i] and receiver_prefs[j] are ranking lists (best first) over the other
// side's indices; both groups have the same size n. Returns match_proposer where match_proposer[i] is the receiver
// index paired with proposer i. Returns an empty list if the two sides differ in size.
fn stable_matching(proposer_prefs: list, receiver_prefs: list) -> list
    let n = len(proposer_prefs)
    let out = []
    if len(receiver_prefs) == n
        let recv_rank = _sm_rank_table(receiver_prefs)
        let next_prop = []
        let match_recv = []
        let match_prop = []
        for z in 0..n
            push(next_prop, 0)
            push(match_recv, 0 - 1)
            push(match_prop, 0 - 1)
        // stack of currently-free proposers
        let free = []
        for m in 0..n
            push(free, m)
        while len(free) > 0
            let p = pop(free)
            if next_prop[p] < n
                let plist = proposer_prefs[p]
                let w = plist[next_prop[p]]
                next_prop[p] = next_prop[p] + 1
                let cur = match_recv[w]
                if cur == 0 - 1
                    match_recv[w] = p
                    match_prop[p] = w
                else
                    let rrow = recv_rank[w]
                    if rrow[p] < rrow[cur]
                        // receiver w trades up to p; cur becomes free again
                        match_recv[w] = p
                        match_prop[p] = w
                        match_prop[cur] = 0 - 1
                        push(free, cur)
                    else
                        // w keeps cur; p stays free and will try the next receiver
                        push(free, p)
        out = match_prop
    out

// Independently check a matching for stability: returns true if there is NO blocking pair -- no proposer i and
// receiver j who each prefer one another over their assigned partners. match_proposer[i] is proposer i's partner.
fn is_stable(proposer_prefs: list, receiver_prefs: list, match_proposer: list) -> bool
    let n = len(proposer_prefs)
    let out = true
    if len(receiver_prefs) == n and len(match_proposer) == n
        let prop_rank = _sm_rank_table(proposer_prefs)
        let recv_rank = _sm_rank_table(receiver_prefs)
        // invert to receiver's partner
        let match_recv = [0 - 1 for z in 0..n]
        for i in 0..n
            if match_proposer[i] >= 0
                match_recv[match_proposer[i]] = i
        for p in 0..n
            let prow = prop_rank[p]
            let partner_p = match_proposer[p]
            let w = 0
            while w < n
                // does p prefer w over p's partner, AND w prefer p over w's partner?
                let wpartner = match_recv[w]
                let wrow = recv_rank[w]
                if partner_p >= 0 and wpartner >= 0
                    if prow[w] < prow[partner_p] and wrow[p] < wrow[wpartner]
                        out = false
                w += 1
    out

// True if the matching is a perfect one-to-one pairing (every proposer matched, every receiver used exactly once).
fn is_perfect(match_proposer: list, n: int) -> bool
    let out = true
    if len(match_proposer) != n
        out = false
    else
        let seen = [0 for z in 0..n]
        for i in 0..n
            let w = match_proposer[i]
            if w < 0 or w >= n
                out = false
            else
                seen[w] = seen[w] + 1
        for k in 0..n
            if seen[k] != 1
                out = false
    out
