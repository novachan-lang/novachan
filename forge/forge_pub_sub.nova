// forge_pub_sub — in-process publish/subscribe with topic routing and Result API.

fn ps_new() -> dict
    {"sub_count": 0, "msg_count": 0, "delivered": 0}

fn ps_subscribe(p: dict, topic: string, subscriber: string) -> dict
    let sk = "s_{topic}_{subscriber}"
    p[sk] = 1
    let ck = "cnt_{topic}"
    p[ck] = (p[ck] + 1) if ck in p else 1
    p["sub_count"] += 1
    p

fn ps_unsubscribe(p: dict, topic: string, subscriber: string) -> Result
    let sk = "s_{topic}_{subscriber}"
    if sk not in p
        return err("not subscribed")
    p[sk] = 0
    let ck = "cnt_{topic}"
    p[ck] -= 1
    p["sub_count"] -= 1
    ok(p)

fn ps_publish(p: dict, topic: string, message: string) -> dict
    p["msg_count"] += 1
    let ck = "cnt_{topic}"
    if ck in p
        p["delivered"] += p[ck]
    p

fn ps_is_subscribed(p: dict, topic: string, subscriber: string) -> int
    let sk = "s_{topic}_{subscriber}"
    if sk in p and p[sk] == 1
        return 1
    0

fn ps_subscriber_count(p: dict, topic: string) -> int
    let ck = "cnt_{topic}"
    if ck in p
        return p[ck]
    0

fn ps_total_messages(p: dict) -> int
    p["msg_count"]

fn ps_total_delivered(p: dict) -> int
    p["delivered"]

fn ps_total_subscriptions(p: dict) -> int
    p["sub_count"]
