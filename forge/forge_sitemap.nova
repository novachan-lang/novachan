// forge_sitemap -- sitemap.xml generation (SEO page discovery + crawl priority for search engines). Add URLs
// with optional lastmod / changefreq / priority; render a valid <urlset>. URLs are XML-escaped. Serve at
// /sitemap.xml and reference it from robots.txt. LEAF -- imports NOTHING.

fn _sm_esc(s: string) -> string
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == "&"
            out += "&amp;"
        else if c == "<"
            out += "&lt;"
        else if c == ">"
            out += "&gt;"
        else
            out += c
    out

fn sitemap_new() -> dict
    {"urls": []}

// Add a URL entry. lastmod / changefreq / priority are optional -- pass "" to omit each.
fn sitemap_add(sm: dict, loc: string, lastmod: string, changefreq: string, priority: string) -> dict
    push(sm["urls"], [loc, lastmod, changefreq, priority])
    sm

// Render the sitemap.xml body.
fn sitemap_render(sm: dict) -> string
    let nl = chr(10)
    let q = chr(34)
    let out = "<?xml version={q}1.0{q} encoding={q}UTF-8{q}?>{nl}"
    out += "<urlset xmlns={q}http://www.sitemaps.org/schemas/sitemap/0.9{q}>{nl}"
    let urls = sm["urls"]
    for i in 0..len(urls)
        let u = urls[i]
        let loc = _sm_esc(u[0])
        out += "  <url><loc>{loc}</loc>"
        if len(u[1]) > 0
            let lastmod = u[1]
            out += "<lastmod>{lastmod}</lastmod>"
        if len(u[2]) > 0
            let changefreq = u[2]
            out += "<changefreq>{changefreq}</changefreq>"
        if len(u[3]) > 0
            let priority = u[3]
            out += "<priority>{priority}</priority>"
        out += "</url>{nl}"
    out + "</urlset>" + nl
