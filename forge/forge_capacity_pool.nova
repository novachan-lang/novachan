// forge_capacity_pool — fixed-capacity resource pool with Result API.

fn cap_new(capacity: int) -> dict
    let c = {}
    c["capacity"] = capacity
    c["available"] = capacity
    c["borrows"] = 0
    c["returns"] = 0
    c["waiters"] = 0
    c

fn cap_borrow(c: dict) -> Result
    if c["available"] <= 0
        c["waiters"] = c["waiters"] + 1
        return err("pool exhausted")
    c["available"] = c["available"] - 1
    c["borrows"] = c["borrows"] + 1
    ok(c)

fn cap_return(c: dict) -> Result
    if c["available"] >= c["capacity"]
        return err("pool already full")
    c["available"] = c["available"] + 1
    c["returns"] = c["returns"] + 1
    ok(c)

fn cap_available(c: dict) -> int
    c["available"]

fn cap_capacity(c: dict) -> int
    c["capacity"]

fn cap_utilization(c: dict) -> int
    let used = c["capacity"] - c["available"]
    (used * 100) / c["capacity"]

fn cap_total_borrows(c: dict) -> int
    c["borrows"]

fn cap_total_returns(c: dict) -> int
    c["returns"]

fn cap_waiter_count(c: dict) -> int
    c["waiters"]
