// forge_pagerank -- rank the nodes of a directed graph by IMPORTANCE, where a node is important if important
// nodes point to it. This is Google's original algorithm, and it works anywhere links imply endorsement: rank
// web pages, find influential users in a follow graph, surface key papers by citation, order products by
// "customers who bought X also bought Y", or score nodes in a dependency/trust network. It runs the power
// iteration: start every node equal, then repeatedly let each node pass its score along its outgoing links,
// with a damping factor d (usually 0.85) modelling a random surfer who occasionally jumps to a random node.
// Dangling nodes (no out-links) spread their score uniformly so no rank leaks away. Edges are [from, to] with
// string node ids; the result is a dict node -> rank, and the ranks sum to 1. LEAF -- imports NOTHING.

// PRIVATE: the distinct node ids appearing in the edge list, first-seen order.
fn _pr_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    for i in 0..len(edges)
        let f = edges[i][0]
        if f not in seen
            seen[f] = 1
            push(nodes, f)
        let t = edges[i][1]
        if t not in seen
            seen[t] = 1
            push(nodes, t)
    nodes

// Compute PageRank over a directed graph. `damping` is typically 0.85; `iterations` ~20-50 is plenty.
// Returns a dict node -> rank (ranks sum to 1).
fn pagerank(edges: list, damping: float, iterations: int) -> dict
    let nodes = _pr_nodes(edges)
    let n = len(nodes)
    let rank = {}
    if n > 0
        let d = damping * 1.0
        // out-degree of each node
        let outdeg = {}
        for a in 0..len(nodes)
            outdeg[nodes[a]] = 0
        for e in 0..len(edges)
            let f = edges[e][0]
            outdeg[f] = outdeg[f] + 1
        // init rank = 1/n
        let init = 1.0 / (n * 1.0)
        for b in 0..len(nodes)
            rank[nodes[b]] = init
        // power iteration
        for it in 0..iterations
            let newrank = {}
            let base = (1.0 - d) / (n * 1.0)
            for c in 0..len(nodes)
                newrank[nodes[c]] = base
            // dangling nodes distribute their rank uniformly
            let dangling = 0.0
            for g in 0..len(nodes)
                if outdeg[nodes[g]] == 0
                    dangling += rank[nodes[g]] * 1.0
            let dshare = d * dangling / (n * 1.0)
            for h in 0..len(nodes)
                newrank[nodes[h]] = newrank[nodes[h]] * 1.0 + dshare
            // each edge passes rank[from]/outdeg[from] to `to`
            for ei in 0..len(edges)
                let f2 = edges[ei][0]
                let t2 = edges[ei][1]
                let od = outdeg[f2]
                if od > 0
                    let contrib = d * (rank[f2] * 1.0) / (od * 1.0)
                    newrank[t2] = newrank[t2] * 1.0 + contrib
            rank = newrank
    rank

// The node with the highest PageRank (empty string if the graph is empty).
fn pagerank_top(edges: list, damping: float, iterations: int) -> string
    let rank = pagerank(edges, damping, iterations)
    let nodes = keys(rank)
    let best = ""
    let bestv = -1.0
    for i in 0..len(nodes)
        let v = rank[nodes[i]] * 1.0
        if v > bestv
            bestv = v
            best = nodes[i]
    best
