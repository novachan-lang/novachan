// forge_hot_key_detector — detect frequently accessed keys with Result API.

fn hk_new(threshold: int) -> dict
    {"counts": {}, "threshold": threshold, "total_accesses": 0, "hot_count": 0}

fn hk_access(h: dict, key: string) -> dict
    h["total_accesses"] += 1
    let ck = "c_" + key
    if ck in h["counts"]
        let old = h["counts"][ck]
        h["counts"][ck] = old + 1
        if old < h["threshold"] and old + 1 >= h["threshold"]
            h["hot_count"] += 1
    else
        h["counts"][ck] = 1
        if 1 >= h["threshold"]
            h["hot_count"] += 1
    h

fn hk_is_hot(h: dict, key: string) -> int
    let ck = "c_" + key
    if ck not in h["counts"]
        return 0
    1 if h["counts"][ck] >= h["threshold"] else 0

fn hk_access_count(h: dict, key: string) -> Result
    let ck = "c_" + key
    if ck not in h["counts"]
        return err("key not tracked")
    ok(h["counts"][ck])

fn hk_hot_key_count(h: dict) -> int
    h["hot_count"]

fn hk_total_accesses(h: dict) -> int
    h["total_accesses"]
