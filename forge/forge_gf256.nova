// forge_gf256 -- arithmetic in the finite field GF(2^8), the 256-element field of bytes that underlies AES, the
// Reed-Solomon codes in QR codes / CDs / DVDs / RAID-6, and BCH error correction. In this field a "number" is a
// single byte, ADDITION is XOR (so it is its own inverse and there are no carries), and MULTIPLICATION is
// carry-less binary polynomial multiplication reduced modulo the AES irreducible polynomial x^8 + x^4 + x^3 + x + 1
// (0x11B). What you get is a genuine field: every nonzero byte has a multiplicative inverse, so you can divide, and
// all the usual algebra (commutative, associative, distributive) holds -- which is exactly what error-correcting
// codes and the AES MixColumns/S-box need. Doing this with bytes instead of real numbers gives exact, overflow-free
// arithmetic where "1/x" always exists. gf_mul is the reference Russian-peasant multiply (no lookup tables needed),
// gf_pow/gf_inv/gf_div build on it, and gf_exp_table/gf_log_table expose the generator-3 log tables that make bulk
// Reed-Solomon math fast. All values are bytes 0..255. LEAF -- imports NOTHING.

// Field addition (and subtraction -- they are identical): bitwise XOR.
fn gf_add(a: int, b: int) -> int
    (a & 255) ^ (b & 255)

// Field multiplication in GF(2^8): carry-less multiply of the two bytes as polynomials, reduced mod 0x11B.
fn gf_mul(a: int, b: int) -> int
    let p = 0
    let x = a & 255
    let y = b & 255
    for i in 0..8
        if (y & 1) == 1
            p = p ^ x
        let hi = x & 128
        x = (x << 1) & 255
        if hi != 0
            x = x ^ 27
        y = y >> 1
    p & 255

// Raise a byte to a power in the field (exponentiation by squaring). gf_pow(a,0) == 1.
fn gf_pow(a: int, n: int) -> int
    let result = 1
    let base = a & 255
    let e = n
    while e > 0
        if (e & 1) == 1
            result = gf_mul(result, base)
        base = gf_mul(base, base)
        e = e >> 1
    result

// The multiplicative inverse of a nonzero byte: since a^255 == 1 for every nonzero a, a^-1 == a^254. Returns 0 for
// input 0 (which has no inverse).
fn gf_inv(a: int) -> int
    gf_pow(a, 254) if (a & 255) != 0 else 0

// Field division a / b == a * b^-1. Returns 0 if b is 0.
fn gf_div(a: int, b: int) -> int
    gf_mul(a, gf_inv(b)) if (b & 255) != 0 else 0

// The antilog (exponent) table: gf_exp_table()[i] = 3^i in the field, for i in 0..255 (generator 3 cycles through
// all 255 nonzero bytes). Handy for fast Reed-Solomon multiply via logs.
fn gf_exp_table() -> list
    let out = []
    let v = 1
    for i in 0..256
        push(out, v)
        v = gf_mul(v, 3)
    out

// The log table: gf_log_table()[b] = the exponent e with 3^e == b (for b in 1..255); index 0 is unused (-1).
fn gf_log_table() -> list
    let ex = gf_exp_table()
    let out = [0 - 1 for i in 0..256]
    for e in 0..255
        out[ex[e]] = e
    out
