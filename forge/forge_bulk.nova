// forge_bulk -- bulk DB operations: multi-row INSERT builder. Injection-safe (values bound). LEAF.

fn bulk_insert_sql(table: string, cols: list, rows: list) -> list
    let collist = join(cols, ", ")
    let value_groups = []
    let params = []
    for row in rows
        let phs = []
        for col in cols
            push(phs, "?")
            push(params, row[col] if col in row else "")
        push(value_groups, "({join(phs, ", ")})")
    let vals = join(value_groups, ", ")
    ["INSERT INTO {table} ({collist}) VALUES {vals}", params]
