// forge_bulk -- bulk DB operations: insert N rows in ONE statement (multi-row VALUES), far fewer round-trips
// than N single inserts (the batch-insert perf win Spring Data saveAll / Rails insert_all / Django
// bulk_create give). Pure [sql, params] builder; run via orm_exec/pool_query. Injection-safe (values bound).
// LEAF -- imports NOTHING.

// Multi-row INSERT: bulk_insert_sql("users", ["name","age"], [{name:"a",age:"1"},{name:"b",age:"2"}])
//   -> ["INSERT INTO users (name, age) VALUES (?, ?), (?, ?)", ["a","1","b","2"]]
fn bulk_insert_sql(table: string, cols: list, rows: list) -> list
    let collist = join(cols, ", ")
    let value_groups = []
    let params = []
    for r in 0..len(rows)
        let row = rows[r]
        let phs = []
        let c = 0
        while c < len(cols)
            push(phs, "?")
            let col = cols[c]
            if col in row
                push(params, row[col])
            else
                push(params, "")
            c += 1
        push(value_groups, "(" + join(phs, ", ") + ")")
    ["INSERT INTO " + table + " (" + collist + ") VALUES " + join(value_groups, ", "), params]
