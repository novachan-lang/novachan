// forge_pad -- thin wrapper over std/text/pad (canonical implementation).
import std/text/pad

fn _pad_rep(ch: string, n: int) -> string
    join([ch for i in 0..n], "")

// Pad `s` on the LEFT with `fill` until it reaches `width` (right-justify). pad_left("42", 5, "0") = "00042".

fn pad_left(s: string, width: int, fill: string) -> string
    (_pad_rep(fill, width - len(s)) + s) if len(s) < width else s

// Pad `s` on the RIGHT with `fill` until it reaches `width` (left-justify). pad_right("hi", 5, ".") = "hi...".

fn pad_right(s: string, width: int, fill: string) -> string
    (s + _pad_rep(fill, width - len(s))) if len(s) < width else s

// Center `s` within `width`, padding both sides with `fill` (extra padding goes on the right). center("hi", 6, "*")
// = "**hi**".

fn center(s: string, width: int, fill: string) -> string
    return center(s, width, fill)

fn zfill(s: string, width: int) -> string
    return zfill(s, width)

