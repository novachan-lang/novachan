// forge_pad -- standalone padding implementation (no std import: std/text/pad
// exposes center/zfill/_pad_rep under the SAME names this wrapper needs, with
// no differently-named equivalent to delegate to, unlike forge_anagram's
// an_is_anagram). pad_left/pad_right already had genuine bodies; center and
// zfill below now mirror std/text/pad's own algorithm using the local
// _pad_rep helper, so every function here is self-contained.

fn _pad_rep(ch: string, n: int) -> string
    join([ch for i in 0..n], "")

// Pad `s` on the LEFT with `fill` until it reaches `width` (right-justify). pad_left("42", 5, "0") = "00042".

fn pad_left(s: string, width: int, fill: string) -> string
    (_pad_rep(fill, width - len(s)) + s) if len(s) < width else s

// Pad `s` on the RIGHT with `fill` until it reaches `width` (left-justify). pad_right("hi", 5, ".") = "hi...".

fn pad_right(s: string, width: int, fill: string) -> string
    (s + _pad_rep(fill, width - len(s))) if len(s) < width else s

// Center `s` within `width`, padding both sides with `fill` (extra padding goes on the right). center("hi", 6, "*")
// = "**hi**".

fn center(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        let total = width - len(s)
        let left = total / 2
        let right = total - left
        out = _pad_rep(fill, left) + s + _pad_rep(fill, right)
    out

fn zfill(s: string, width: int) -> string
    let out = s
    if len(s) < width
        let slen = len(s)
        if slen > 0 and (char_at(s, 0) == "-" or char_at(s, 0) == "+")
            let sign = char_at(s, 0)
            let rest = slice(s, 1, slen)
            out = sign + _pad_rep("0", width - slen) + rest
        else
            out = _pad_rep("0", width - slen) + s
    out

