// forge_pad -- pad and align strings to a fixed WIDTH, the workhorse of tidy fixed-width output: columns that line
// up in a terminal or report, right-aligned numbers, zero-filled ids and timestamps, and centered headings.
// pad_left (a.k.a. right-justify) adds fill on the LEFT so text ends at the width -- the natural choice for numbers
// and currency so decimal points and digits align. pad_right (left-justify) pads on the RIGHT so text starts at a
// fixed column -- for labels and left-aligned table cells. center splits the padding to both sides. zfill is the
// number-friendly special case of pad_left with '0' (turning 42 into "0042" for sortable ids, dates, and version
// parts). A string already at or over the target width is returned unchanged (never truncated), so nothing is
// silently lost. The fill is a single character. LEAF -- imports NOTHING.

// PRIVATE: `ch` repeated `n` times ("" if n <= 0).
fn _pad_rep(ch: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// Pad `s` on the LEFT with `fill` until it reaches `width` (right-justify). pad_left("42", 5, "0") = "00042".
fn pad_left(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        out = _pad_rep(fill, width - len(s)) + s
    out

// Pad `s` on the RIGHT with `fill` until it reaches `width` (left-justify). pad_right("hi", 5, ".") = "hi...".
fn pad_right(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        out = s + _pad_rep(fill, width - len(s))
    out

// Center `s` within `width`, padding both sides with `fill` (extra padding goes on the right). center("hi", 6, "*")
// = "**hi**".
fn center(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        let total = width - len(s)
        let left = total / 2
        let right = total - left
        out = _pad_rep(fill, left) + s + _pad_rep(fill, right)
    out

// Left-pad a number-like string with zeros to `width` (pad_left with '0'). zfill("42", 4) = "0042". A leading '-'
// is kept in front of the zeros: zfill("-7", 4) = "-007".
fn zfill(s: string, width: int) -> string
    let out = s
    if len(s) < width
        if len(s) > 0 and char_at(s, 0) == "-"
            out = "-" + _pad_rep("0", width - len(s)) + slice(s, 1, len(s))
        else
            out = _pad_rep("0", width - len(s)) + s
    out
