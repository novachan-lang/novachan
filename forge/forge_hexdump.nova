// forge_hexdump -- a canonical `hexdump -C` style dump of a byte list: an 8-digit hex offset, up to 16 bytes
// as two-digit hex (split into two columns of 8 by a gap), then an ASCII gutter where printable bytes (0x20..
// 0x7e) show as-is and everything else as '.'. The standard way to eyeball a binary payload -- a wire frame,
// a file header, an encryption block -- in a log or a debug print. Operates on a byte list (0..255). LEAF.

// PRIVATE: two lowercase hex digits for a byte.
fn _hd_hex2(b: int) -> string
    let digs = "0123456789abcdef"
    char_at(digs, (b / 16) & 15) + char_at(digs, b & 15)

// PRIVATE: eight-digit hex offset.
fn _hd_off(n: int) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let shift = 28
    while shift >= 0
        out = out + char_at(digs, (n / _hd_pow16(shift / 4)) & 15)
        shift = shift - 4
    out

// PRIVATE: 16^e for e in 0..7 (offset digit place values; avoids a shift that could hit the 1<<64 edge).
fn _hd_pow16(e: int) -> int
    let p = 1
    let i = 0
    while i < e
        p = p * 16
        i = i + 1
    p

// The multi-line hexdump string (a trailing newline after each 16-byte row).
fn hexdump(data: list) -> string
    let n = len(data)
    let out = ""
    let base = 0
    while base < n
        // offset
        let line = _hd_off(base) + "  "
        // hex columns (16 slots; a space between columns 8 and 9; a missing byte -> "   ")
        let i = 0
        while i < 16
            if base + i < n
                line = line + _hd_hex2(data[base + i]) + " "
            else
                line = line + "   "
            if i == 7
                line = line + " "
            i = i + 1
        // ascii gutter
        line = line + " |"
        let j = 0
        while j < 16 and base + j < n
            let c = data[base + j]
            if c >= 32 and c <= 126
                line = line + chr(c)
            else
                line = line + "."
            j = j + 1
        line = line + "|"
        out = out + line + chr(10)
        base = base + 16
    out
