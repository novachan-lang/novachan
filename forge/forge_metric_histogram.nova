// forge_metric_histogram — histogram with configurable buckets and Result API.

fn hist_new(bucket_size: int, bucket_count: int) -> dict
    let h = {}
    h["bucket_size"] = bucket_size
    h["bucket_count"] = bucket_count
    h["total_samples"] = 0
    h["total_sum"] = 0
    let i = 0
    while i < bucket_count
        h["b_" + str(i)] = 0
        i = i + 1
    h["overflow"] = 0
    h

fn hist_record(h: dict, value: int) -> dict
    let idx = value / h["bucket_size"]
    if idx >= h["bucket_count"]
        h["overflow"] = h["overflow"] + 1
    else
        if idx < 0
            h["b_0"] = h["b_0"] + 1
        else
            h["b_" + str(idx)] = h["b_" + str(idx)] + 1
    h["total_samples"] = h["total_samples"] + 1
    h["total_sum"] = h["total_sum"] + value
    h

fn hist_bucket(h: dict, index: int) -> Result
    if index < 0 or index >= h["bucket_count"]
        return err("bucket index out of range")
    ok(h["b_" + str(index)])

fn hist_overflow(h: dict) -> int
    h["overflow"]

fn hist_mean(h: dict) -> Result
    if h["total_samples"] == 0
        return err("no samples")
    ok(h["total_sum"] / h["total_samples"])

fn hist_total_samples(h: dict) -> int
    h["total_samples"]

fn hist_total_sum(h: dict) -> int
    h["total_sum"]

fn hist_bucket_count(h: dict) -> int
    h["bucket_count"]
