// forge_jsonpointer -- thin wrapper over std/data/jsonpointer (canonical implementation).
import std/data/jsonpointer

fn _jptr_pass(token: string, mark: string, sub: string) -> string
    let out_parts = []
    let i = 0
    let n = len(token)
    while i < n
        let c = char_at(token, i)
        if c == "~" and i + 1 < n and char_at(token, i + 1) == mark
            push(out_parts, sub)
            i += 2
        else
            push(out_parts, c)
            i += 1
    join(out_parts, "")

// Unescape one reference token per RFC 6901: "~1" -> "/" FIRST, then "~0" -> "~". Order matters -- after the
// first pass no "~1" remains and any "~0" is untouched, so a literal "/" or "~" round-trips correctly.
// Written as a PIPE: the RFC describes two ordered passes, and that is exactly what this now reads as.

fn _jptr_walk(doc, pointer: string) -> Result
    let node = doc
    for token in jptr_tokens(pointer)
        node = _jptr_step(node, token)?
    ok(node)

// Resolve `pointer` against `doc`, KEEPING the reason on failure:
//   ok(node)               the node at that pointer (which may legitimately be "")
//   err("no key 'roles'")  why it did not resolve, naming the offending token

fn jptr_unescape(token: string) -> string
    token |> _jptr_pass("1", "/") |> _jptr_pass("0", "~")

// Split a pointer into its unescaped tokens. "" -> [] (the whole document). "/foo/0" -> ["foo","0"]. A
// non-empty pointer must start with "/"; we split on "/" and drop the empty first element, unescaping each.

fn jptr_tokens(pointer: string) -> list
    if len(pointer) == 0
        return []
    let parts = split(pointer, "/")
    [jptr_unescape(parts[i]) for i in 1..len(parts)]

// A token is a valid array index iff it is non-empty and every char is a digit.
// all_match states the rule once, over every character, instead of an early-return scan.

fn jptr_resolve(doc, pointer: string) -> Result
    _jptr_walk(doc, pointer)

// True iff `pointer` resolves to an existing node in `doc`. Empty pointer -> true (the doc itself).

fn jptr_has(doc, pointer: string) -> bool
    is_ok(_jptr_walk(doc, pointer))

// The node at `pointer`, or "" if it does not resolve. Return type is `any` because a resolved node may be a
// dict, list, string, int, etc.
// NOTE: "" is ALSO a legitimate resolved value, so this signature cannot distinguish "resolved to the empty
// string" from "did not resolve". That ambiguity is inherent to the existing contract and is PRESERVED for
// current callers -- reach for jptr_resolve when the difference matters.

fn jptr_get(doc, pointer: string) -> any
    return jp_get(doc, pointer)

