// forge_jsonpointer -- RFC 6901 JSON Pointer: navigate a nested structure of dicts and lists with a path
// string like "/user/roles/0/name". A pointer is "" (the whole document) or a sequence of "/"-prefixed
// reference tokens; each token is a dict key OR, when the current node is a list, a 0-based array index (all
// digits). Tokens are unescaped: "~1" -> "/" then "~0" -> "~" (in that order). Used for config lookups, JSON
// Patch targeting, and webhook payload extraction. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. The descend-one-token walk was written TWICE -- once in jptr_has returning bool, once in
// jptr_get returning "" -- and both threw away WHY a pointer failed to resolve. Two copies of the same rules
// is two places for them to drift.
//
// Now there is ONE walk, _jptr_walk, returning Result, and every entry point is a two-line adapter over it.
// A caller who wants the reason gets it from jptr_resolve, naming the offending token and the cause.

// Why a step failed. An ADT rather than a bare string so the CAUSE is a value a caller can match on: a
// missing key is a client error, a non-descendable node is a malformed-document error, and flattening both
// into "" (as before) makes them indistinguishable.
enum PtrFail
    NoKey(string)
    NotAnIndex(string)
    IndexOutOfRange(string)
    NotDescendable(string)

fn _fail_text(f: PtrFail) -> string
    match f
        NoKey(t) => "no key '{t}'"
        NotAnIndex(t) => "token '{t}' is not an array index"
        IndexOutOfRange(t) => "index {t} out of range"
        NotDescendable(t) => "cannot descend into a scalar at '{t}'"

// A single unescape pass: replace every "~" + `mark` with `sub`, copying all other chars verbatim. A trailing
// bare "~" (no following char) is copied as-is. Scanning by hand (rather than a blanket replace) keeps the two
// RFC passes independent so ordering is exact.
// The `while` STAYS: the index advances by 2 on an escape and by 1 otherwise, so the step is data-dependent
// and no for-range expresses it.
fn _jptr_pass(token: string, mark: string, sub: string) -> string
    let out_parts = []
    let i = 0
    let n = len(token)
    while i < n
        let c = char_at(token, i)
        if c == "~" and i + 1 < n and char_at(token, i + 1) == mark
            push(out_parts, sub)
            i += 2
        else
            push(out_parts, c)
            i += 1
    join(out_parts, "")

// Unescape one reference token per RFC 6901: "~1" -> "/" FIRST, then "~0" -> "~". Order matters -- after the
// first pass no "~1" remains and any "~0" is untouched, so a literal "/" or "~" round-trips correctly.
// Written as a PIPE: the RFC describes two ordered passes, and that is exactly what this now reads as.
fn jptr_unescape(token: string) -> string
    token |> _jptr_pass("1", "/") |> _jptr_pass("0", "~")

// Split a pointer into its unescaped tokens. "" -> [] (the whole document). "/foo/0" -> ["foo","0"]. A
// non-empty pointer must start with "/"; we split on "/" and drop the empty first element, unescaping each.
fn jptr_tokens(pointer: string) -> list
    if len(pointer) == 0
        return []
    let parts = split(pointer, "/")
    [jptr_unescape(parts[i]) for i in 1..len(parts)]

// A token is a valid array index iff it is non-empty and every char is a digit.
// all_match states the rule once, over every character, instead of an early-return scan.
fn _is_index(s: string) -> bool
    if len(s) == 0
        return false
    all_match([char_at(s, i) for i in 0..len(s)], (c) => find("0123456789", c) >= 0)

// Descend ONE token. The single place that knows how a step can fail.
fn _jptr_step(node, token: string) -> Result
    let kind = type_of(node)
    if kind == "dict"
        if token not in node
            return err(_fail_text(NoKey(token)))
        return ok(node[token])
    if kind == "list"
        if not _is_index(token)
            return err(_fail_text(NotAnIndex(token)))
        let idx = parse_int(token)
        if idx < 0 or idx >= len(node)
            return err(_fail_text(IndexOutOfRange(token)))
        return ok(node[idx])
    err(_fail_text(NotDescendable(token)))

// THE walk -- every entry point below is an adapter over this one function. `?` propagates the first failing
// step's message unchanged, so the loop body is a single line and there is no error plumbing to get wrong.
fn _jptr_walk(doc, pointer: string) -> Result
    let node = doc
    for token in jptr_tokens(pointer)
        node = _jptr_step(node, token)?
    ok(node)

// Resolve `pointer` against `doc`, KEEPING the reason on failure:
//   ok(node)               the node at that pointer (which may legitimately be "")
//   err("no key 'roles'")  why it did not resolve, naming the offending token
fn jptr_resolve(doc, pointer: string) -> Result
    _jptr_walk(doc, pointer)

// True iff `pointer` resolves to an existing node in `doc`. Empty pointer -> true (the doc itself).
fn jptr_has(doc, pointer: string) -> bool
    is_ok(_jptr_walk(doc, pointer))

// The node at `pointer`, or "" if it does not resolve. Return type is `any` because a resolved node may be a
// dict, list, string, int, etc.
// NOTE: "" is ALSO a legitimate resolved value, so this signature cannot distinguish "resolved to the empty
// string" from "did not resolve". That ambiguity is inherent to the existing contract and is PRESERVED for
// current callers -- reach for jptr_resolve when the difference matters.
fn jptr_get(doc, pointer: string) -> any
    unwrap_or(_jptr_walk(doc, pointer), "")
