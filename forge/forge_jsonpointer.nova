// forge_jsonpointer -- RFC 6901 JSON Pointer: navigate a nested structure of dicts and lists with a path
// string like "/user/roles/0/name". A pointer is "" (the whole document) or a sequence of "/"-prefixed
// reference tokens; each token is a dict key OR, when the current node is a list, a 0-based array index (all
// digits). Tokens are unescaped: "~1" -> "/" then "~0" -> "~" (in that order). Used for config lookups, JSON
// Patch targeting, and webhook payload extraction. LEAF -- imports NOTHING.

// A single unescape pass: replace every "~" + `mark` with `sub`, copying all other chars verbatim. A trailing
// bare "~" (no following char) is copied as-is. Scanning by hand (rather than a blanket replace) keeps the two
// RFC passes independent so ordering is exact.
fn _jptr_pass(token: string, mark: string, sub: string) -> string
    let out = ""
    let i = 0
    let n = len(token)
    while i < n
        let c = char_at(token, i)
        if c == "~" and i + 1 < n and char_at(token, i + 1) == mark
            out = out + sub
            i = i + 2
        else
            out = out + c
            i = i + 1
    out

// Unescape one reference token per RFC 6901: "~1" -> "/" FIRST, then "~0" -> "~". Order matters -- after the
// first pass no "~1" remains and any "~0" is untouched, so a literal "/" or "~" round-trips correctly.
fn jptr_unescape(token: string) -> string
    let step1 = _jptr_pass(token, "1", "/")
    _jptr_pass(step1, "0", "~")

// Split a pointer into its unescaped tokens. "" -> [] (the whole document). "/foo/0" -> ["foo","0"]. A
// non-empty pointer must start with "/"; we split on "/" and drop the empty first element, unescaping each.
fn jptr_tokens(pointer: string) -> list
    let out = []
    if len(pointer) == 0
        return out
    let parts = split(pointer, "/")
    let i = 1
    while i < len(parts)
        push(out, jptr_unescape(parts[i]))
        i = i + 1
    out

// A token is a valid array index iff it is non-empty and every char is a digit.
fn _is_index(s: string) -> bool
    if len(s) == 0
        return false
    let i = 0
    while i < len(s)
        if find("0123456789", char_at(s, i)) < 0
            return false
        i = i + 1
    true

// True iff `pointer` resolves to an existing node in `doc`. Empty pointer -> true (the doc itself). At each
// step: a dict descends by key (must contain it); a list descends by an all-digit token in range; anything
// else cannot be descended into -> false.
fn jptr_has(doc, pointer: string) -> bool
    let node = doc
    let toks = jptr_tokens(pointer)
    for token in toks
        let kind = type_of(node)
        if kind == "dict"
            if contains(node, token) == false
                return false
            node = node[token]
        else
            if kind == "list"
                if _is_index(token) == false
                    return false
                let idx = parse_int(token)
                if idx < 0 or idx >= len(node)
                    return false
                node = node[idx]
            else
                return false
    true

// The node at `pointer`, or "" if it does not resolve. Same walk as jptr_has. Return type is `any` because a
// resolved node may be a dict, list, string, int, etc.
fn jptr_get(doc, pointer: string) -> any
    let node = doc
    let toks = jptr_tokens(pointer)
    for token in toks
        let kind = type_of(node)
        if kind == "dict"
            if contains(node, token) == false
                return ""
            node = node[token]
        else
            if kind == "list"
                if _is_index(token) == false
                    return ""
                let idx = parse_int(token)
                if idx < 0 or idx >= len(node)
                    return ""
                node = node[idx]
            else
                return ""
    node
