// forge_lfu -- a bounded LFU (Least-Frequently-Used) cache: when it's full, evict the entry that has been accessed
// the FEWEST times, not the one accessed least recently. LRU (forge_lru) assumes recent = valuable and can throw
// away a popular item just because it wasn't touched in the last few requests; LFU keeps the items that are hit
// OFTEN, which fits caches where popularity is stable -- CDN edge caches, hot database rows/query results, frequent
// config or lookup values. Each entry tracks an access count that rises on every get/put; on eviction the smallest
// count loses, and ties are broken by least-recently-used so a brand-new cold entry doesn't instantly displace an
// established one. Keys are strings, values are anything, and the cache is a plain dict you thread through the
// calls. LEAF -- imports NOTHING. (Wrap in an actor for cross-task/N>1 sharing.)

// A new empty LFU cache holding up to `capacity` entries.
fn lfu_new(capacity: int) -> dict
    {"cap": capacity, "data": {}, "freq": {}, "tick": {}, "clock": 0}

// PRIVATE: a copy of dict d without `key`.
fn _lfu_without(d: dict, key: string) -> dict
    let nd = {}
    let ks = keys(d)
    for i in 0..len(ks)
        if ks[i] != key
            nd[ks[i]] = d[ks[i]]
    nd

// PRIVATE: the key to evict = smallest frequency, ties broken by smallest tick (least recently used).
fn _lfu_victim(c: dict) -> string
    let freq = c["freq"]
    let tick = c["tick"]
    let ks = keys(freq)
    let best = ks[0]
    for i in 1..len(ks)
        let k = ks[i]
        if freq[k] < freq[best] or (freq[k] == freq[best] and tick[k] < tick[best])
            best = k
    best

// Insert or update key -> value. Updating bumps its frequency; inserting into a full cache first evicts the
// least-frequently-used entry.
fn lfu_put(c: dict, key: string, value)
    let data = c["data"]
    let freq = c["freq"]
    let tick = c["tick"]
    c["clock"] += 1
    if key in data
        data[key] = value
        freq[key] += 1
        tick[key] = c["clock"]
    else
        if c["cap"] > 0
            if len(keys(data)) >= c["cap"]
                let evict = _lfu_victim(c)
                c["data"] = _lfu_without(data, evict)
                c["freq"] = _lfu_without(freq, evict)
                c["tick"] = _lfu_without(tick, evict)
            c["data"][key] = value
            c["freq"][key] = 1
            c["tick"][key] = c["clock"]

// Look up key. Returns [found, value] (found is 1/0); a hit bumps the key's frequency.
fn lfu_get(c: dict, key: string) -> list
    let data = c["data"]
    let out = [0, 0]
    if key in data
        c["clock"] += 1
        c["freq"][key] += 1
        c["tick"][key] = c["clock"]
        out = [1, data[key]]
    out

// True if key is currently cached (does NOT change its frequency).
fn lfu_contains(c: dict, key: string) -> bool
    key in c["data"]

// The number of cached entries.
fn lfu_size(c: dict) -> int
    len(keys(c["data"]))

// The current access frequency of key (0 if absent).
fn lfu_freq(c: dict, key: string) -> int
    get(c["freq"], key, 0)
