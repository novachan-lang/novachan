// forge_resource_limiter — per-resource usage limits with Result API.

fn rlim_new() -> dict
    let r = {}
    r["resource_count"] = 0
    r["violations"] = 0
    r

fn rlim_add(r: dict, name: string, limit: int) -> dict
    r["res_" + name + "_limit"] = limit
    r["res_" + name + "_used"] = 0
    r["resource_count"] = r["resource_count"] + 1
    r

fn rlim_acquire(r: dict, name: string, amount: int) -> Result
    let lk = "res_" + name + "_limit"
    if lk in r != true
        return err("resource not found: " + name)
    let used = r["res_" + name + "_used"]
    if used + amount > r[lk]
        r["violations"] = r["violations"] + 1
        return err("limit exceeded for: " + name)
    r["res_" + name + "_used"] = used + amount
    ok(r)

fn rlim_release(r: dict, name: string, amount: int) -> Result
    let uk = "res_" + name + "_used"
    if uk in r != true
        return err("resource not found: " + name)
    let used = r[uk]
    if amount > used
        r[uk] = 0
    else
        r[uk] = used - amount
    ok(r)

fn rlim_usage(r: dict, name: string) -> Result
    let uk = "res_" + name + "_used"
    if uk in r != true
        return err("resource not found: " + name)
    ok(r[uk])

fn rlim_remaining(r: dict, name: string) -> Result
    let lk = "res_" + name + "_limit"
    if lk in r != true
        return err("resource not found: " + name)
    ok(r[lk] - r["res_" + name + "_used"])

fn rlim_resource_count(r: dict) -> int
    r["resource_count"]

fn rlim_violation_count(r: dict) -> int
    r["violations"]
