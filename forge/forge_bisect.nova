// forge_bisect -- binary search over a SORTED integer list, and the two "boundary" searches that make it truly
// useful: lower_bound (the first position >= target) and upper_bound (the first position > target). Plain binary
// search only answers "is it there?"; the boundaries answer the questions real code actually asks -- WHERE would
// this value go to keep the list sorted (insertion point), how MANY copies of a value are there (upper - lower),
// what's the range of entries in [lo, hi), and which is the nearest entry. This is Python's `bisect` /  C++'s
// lower_bound/upper_bound. Every operation is O(log n). Keeping a list sorted and bisecting it is the simplest way
// to get fast ordered lookups, range counts, percentiles over a static dataset, and "closest match" queries
// without a tree. The list MUST already be sorted ascending. LEAF -- imports NOTHING.

// The first index i where xs[i] >= target (0..len). This is the insertion point that keeps xs sorted, placing an
// equal value BEFORE existing equals (a "left" insert). Python's bisect_left.
fn lower_bound(xs: list, target: int) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = (lo + hi) / 2
        if xs[mid] < target
            lo = mid + 1
        else
            hi = mid
    lo

// The first index i where xs[i] > target (0..len). Inserting here places an equal value AFTER existing equals
// (a "right" insert). Python's bisect_right.
fn upper_bound(xs: list, target: int) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = (lo + hi) / 2
        if xs[mid] <= target
            lo = mid + 1
        else
            hi = mid
    lo

// The index of target in the sorted list (its FIRST occurrence), or -1 if absent. O(log n).
fn binary_search(xs: list, target: int) -> int
    let i = lower_bound(xs, target)
    let out = 0 - 1
    if i < len(xs) and xs[i] == target
        out = i
    out

// True if target is present in the sorted list.
fn bisect_contains(xs: list, target: int) -> bool
    let ok = false
    if binary_search(xs, target) >= 0
        ok = true
    ok

// How many times target appears in the sorted list (upper_bound - lower_bound). O(log n).
fn count_sorted(xs: list, target: int) -> int
    upper_bound(xs, target) - lower_bound(xs, target)

// The number of entries in the half-open range [lo, hi) -- i.e. lo <= x < hi. O(log n).
fn count_range(xs: list, lo: int, hi: int) -> int
    lower_bound(xs, hi) - lower_bound(xs, lo)

// A NEW sorted list with `value` inserted at its lower-bound position (keeps ascending order).
fn insert_sorted(xs: list, value: int) -> list
    let pos = lower_bound(xs, value)
    let out = []
    let i = 0
    while i < len(xs)
        if i == pos
            push(out, value)
        push(out, xs[i])
        i = i + 1
    if pos == len(xs)
        push(out, value)
    out

// The value in the sorted list closest to target (ties -> the smaller value). The list must be non-empty.
fn closest(xs: list, target: int) -> int
    let n = len(xs)
    let i = lower_bound(xs, target)
    let out = 0
    if i == 0
        out = xs[0]
    else
        if i >= n
            out = xs[n - 1]
        else
            let below = xs[i - 1]
            let above = xs[i]
            if (target - below) <= (above - target)
                out = below
            else
                out = above
    out
