// forge_bisect -- binary search over a SORTED integer list: lower_bound, upper_bound, search, closest.
// Every operation is O(log n). LEAF -- imports NOTHING.

fn lower_bound(xs: list, target: int) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = (lo + hi) / 2
        if xs[mid] < target
            lo = mid + 1
        else
            hi = mid
    lo

fn upper_bound(xs: list, target: int) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = (lo + hi) / 2
        if xs[mid] <= target
            lo = mid + 1
        else
            hi = mid
    lo

fn binary_search(xs: list, target: int) -> int
    let i = lower_bound(xs, target)
    i if (i < len(xs) and xs[i] == target) else -1

fn bisect_contains(xs: list, target: int) -> bool
    binary_search(xs, target) >= 0

fn count_sorted(xs: list, target: int) -> int
    upper_bound(xs, target) - lower_bound(xs, target)

fn count_range(xs: list, lo: int, hi: int) -> int
    lower_bound(xs, hi) - lower_bound(xs, lo)

fn insert_sorted(xs: list, value: int) -> list
    let pos = lower_bound(xs, value)
    let out = []
    for i in 0..len(xs)
        if i == pos
            push(out, value)
        push(out, xs[i])
    if pos == len(xs)
        push(out, value)
    out

fn closest(xs: list, target: int) -> int
    let n = len(xs)
    let i = lower_bound(xs, target)
    if i == 0
        return xs[0]
    if i >= n
        return xs[n - 1]
    let below = xs[i - 1]
    let above = xs[i]
    below if (target - below) <= (above - target) else above
