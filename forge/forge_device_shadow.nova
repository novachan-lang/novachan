// forge_device_shadow — IoT device shadow / digital twin state (Edge).
// Each device has a "desired" state (what the cloud wants) and a
// "reported" state (what the device last confirmed). A key is "in
// delta" when desired and reported disagree — the classic AWS-IoT-style
// shadow model, reimplemented flat (no nested dicts: composite keys).

fn ds_new() -> dict
    {"devices": {}, "desired": {}, "reported": {}, "device_count": 0}

fn ds_create(s: dict, device_id: string) -> dict
    let key = "d_" + device_id
    if key not in s["devices"]
        s["devices"][key] = []
        s["device_count"] += 1
    s

fn ds_has_device(s: dict, device_id: string) -> int
    let key = "d_" + device_id
    if key in s["devices"]
        return 1
    0

fn _ds_track_key(s: dict, device_id: string, key_name: string)
    let dkey = "d_" + device_id
    let keylist = s["devices"][dkey]
    if key_name not in keylist
        push(s["devices"][dkey], key_name)

fn ds_set_desired(s: dict, device_id: string, key_name: string, value: string) -> Result
    let dkey = "d_" + device_id
    if dkey not in s["devices"]
        return err("device not found: " + device_id)
    let ck = device_id + "_" + key_name
    s["desired"][ck] = value
    _ds_track_key(s, device_id, key_name)
    ok(s)

fn ds_set_reported(s: dict, device_id: string, key_name: string, value: string) -> Result
    let dkey = "d_" + device_id
    if dkey not in s["devices"]
        return err("device not found: " + device_id)
    let ck = device_id + "_" + key_name
    s["reported"][ck] = value
    _ds_track_key(s, device_id, key_name)
    ok(s)

fn ds_get_desired(s: dict, device_id: string, key_name: string) -> Result
    let dkey = "d_" + device_id
    if dkey not in s["devices"]
        return err("device not found: " + device_id)
    let ck = device_id + "_" + key_name
    if ck not in s["desired"]
        return err("no desired value for key: " + key_name)
    ok(s["desired"][ck])

fn ds_get_reported(s: dict, device_id: string, key_name: string) -> Result
    let dkey = "d_" + device_id
    if dkey not in s["devices"]
        return err("device not found: " + device_id)
    let ck = device_id + "_" + key_name
    if ck not in s["reported"]
        return err("no reported value for key: " + key_name)
    ok(s["reported"][ck])

fn ds_is_synced(s: dict, device_id: string, key_name: string) -> Result
    let d = ds_get_desired(s, device_id, key_name)
    if is_err(d)
        return d
    let r = ds_get_reported(s, device_id, key_name)
    if is_err(r)
        return r
    if unwrap(d) == unwrap(r)
        return ok(1)
    ok(0)

fn ds_device_count(s: dict) -> int
    s["device_count"]

fn ds_delta_count(s: dict, device_id: string) -> Result
    let dkey = "d_" + device_id
    if dkey not in s["devices"]
        return err("device not found: " + device_id)
    let keylist = s["devices"][dkey]
    let deltas = 0
    for i in 0..len(keylist)
        let key_name = keylist[i]
        let ck = device_id + "_" + key_name
        let has_d = ck in s["desired"]
        let has_r = ck in s["reported"]
        if has_d
            if has_r
                if s["desired"][ck] != s["reported"][ck]
                    deltas += 1
            else
                deltas += 1
        else if has_r
            deltas += 1
    ok(deltas)
