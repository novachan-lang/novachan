// forge_sidecar — Sidecar proxy pattern.
// Route requests through sidecars for logging, auth, metrics injection.

fn sc_new() -> dict
    {"handlers": [], "requests": 0, "blocked": 0, "log": []}

fn sc_add_handler(sc: dict, name: string, kind: string, priority: int) -> dict
    push(sc["handlers"], {"name": name, "kind": kind, "priority": priority, "enabled": 1, "invocations": 0})
    sc

fn sc_process(sc: dict, path: string, method: string) -> dict
    sc["requests"] += 1
    let result = {"allowed": 1, "handlers_run": 0}
    for i in 0..len(sc["handlers"])
        let h = sc["handlers"][i]
        if h["enabled"] == 1
            sc["handlers"][i]["invocations"] += 1
            result["handlers_run"] += 1
            push(sc["log"], {"handler": h["name"], "path": path, "method": method})
    result

fn sc_block(sc: dict) -> dict
    sc["blocked"] += 1
    sc

fn sc_disable_handler(sc: dict, name: string) -> dict
    for i in 0..len(sc["handlers"])
        if sc["handlers"][i]["name"] == name
            sc["handlers"][i]["enabled"] = 0
            return sc
    sc

fn sc_enable_handler(sc: dict, name: string) -> dict
    for i in 0..len(sc["handlers"])
        if sc["handlers"][i]["name"] == name
            sc["handlers"][i]["enabled"] = 1
            return sc
    sc

fn sc_handler_count(sc: dict) -> int
    len(sc["handlers"])

fn sc_total_requests(sc: dict) -> int
    sc["requests"]

fn sc_total_blocked(sc: dict) -> int
    sc["blocked"]

fn sc_handler_invocations(sc: dict, name: string) -> int
    for i in 0..len(sc["handlers"])
        if sc["handlers"][i]["name"] == name
            return sc["handlers"][i]["invocations"]
    0

fn sc_log_count(sc: dict) -> int
    len(sc["log"])
