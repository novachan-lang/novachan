// forge_config_merger — Merge layered configs (defaults < env < overrides).

fn cm_new() -> dict
    {"defaults": {}, "env": {}, "overrides": {}}

fn cm_set_default(cm: dict, key: string, value: string) -> dict
    cm["defaults"][key] = value
    cm

fn cm_set_env(cm: dict, key: string, value: string) -> dict
    cm["env"][key] = value
    cm

fn cm_set_override(cm: dict, key: string, value: string) -> dict
    cm["overrides"][key] = value
    cm

fn cm_get(cm: dict, key: string) -> string
    if key in cm["overrides"]
        return cm["overrides"][key]
    if key in cm["env"]
        return cm["env"][key]
    if key in cm["defaults"]
        return cm["defaults"][key]
    ""

fn cm_has(cm: dict, key: string) -> int
    if key in cm["overrides"]
        return 1
    if key in cm["env"]
        return 1
    if key in cm["defaults"]
        return 1
    0

fn cm_source(cm: dict, key: string) -> string
    if key in cm["overrides"]
        return "override"
    if key in cm["env"]
        return "env"
    if key in cm["defaults"]
        return "default"
    "none"

// PRIVATE: mark every key of `source` as present in `all`.
fn _cm_mark_keys(all: dict, source: dict) -> dict
    for k in keys(source)
        all[k] = 1
    all

fn cm_all_keys(cm: dict) -> dict
    let all = {}
    all = _cm_mark_keys(all, cm["defaults"])
    all = _cm_mark_keys(all, cm["env"])
    all = _cm_mark_keys(all, cm["overrides"])
    all
