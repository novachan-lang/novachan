// forge_config_merger — Merge layered configs (defaults < env < overrides).

fn cm_new() -> dict
    let cm = {}
    cm["defaults"] = {}
    cm["env"] = {}
    cm["overrides"] = {}
    cm

fn cm_set_default(cm: dict, key: string, value: string) -> dict
    cm["defaults"][key] = value
    cm

fn cm_set_env(cm: dict, key: string, value: string) -> dict
    cm["env"][key] = value
    cm

fn cm_set_override(cm: dict, key: string, value: string) -> dict
    cm["overrides"][key] = value
    cm

fn cm_get(cm: dict, key: string) -> string
    let has_o = contains(cm["overrides"], key)
    if has_o == true
        return cm["overrides"][key]
    let has_e = contains(cm["env"], key)
    if has_e == true
        return cm["env"][key]
    let has_d = contains(cm["defaults"], key)
    if has_d == true
        return cm["defaults"][key]
    ""

fn cm_has(cm: dict, key: string) -> int
    let has_o = contains(cm["overrides"], key)
    if has_o == true
        return 1
    let has_e = contains(cm["env"], key)
    if has_e == true
        return 1
    let has_d = contains(cm["defaults"], key)
    if has_d == true
        return 1
    0

fn cm_source(cm: dict, key: string) -> string
    let has_o = contains(cm["overrides"], key)
    if has_o == true
        return "override"
    let has_e = contains(cm["env"], key)
    if has_e == true
        return "env"
    let has_d = contains(cm["defaults"], key)
    if has_d == true
        return "default"
    "none"

fn cm_all_keys(cm: dict) -> dict
    let all = {}
    let dk = keys(cm["defaults"])
    let i = 0
    while i < len(dk)
        all[dk[i]] = 1
        i = i + 1
    let ek = keys(cm["env"])
    let j = 0
    while j < len(ek)
        all[ek[j]] = 1
        j = j + 1
    let ok = keys(cm["overrides"])
    let k = 0
    while k < len(ok)
        all[ok[k]] = 1
        k = k + 1
    all
