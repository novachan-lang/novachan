// forge_health_check — Application health check system.
// Register checks, run all, aggregate status (UP/DOWN/DEGRADED).

fn hc_new() -> dict
    {"checks": {}, "results": {}}

fn hc_register(hc: dict, name: string, check_type: string) -> dict
    hc["checks"][name] = {"type": check_type, "status": "unknown", "message": "", "last_check": 0}
    hc

fn hc_report_up(hc: dict, name: string, ts: int) -> dict
    if name in hc["checks"]
        hc["checks"][name]["status"] = "up"
        hc["checks"][name]["message"] = ""
        hc["checks"][name]["last_check"] = ts
    hc

fn hc_report_down(hc: dict, name: string, reason: string, ts: int) -> dict
    if name in hc["checks"]
        hc["checks"][name]["status"] = "down"
        hc["checks"][name]["message"] = reason
        hc["checks"][name]["last_check"] = ts
    hc

fn hc_report_degraded(hc: dict, name: string, reason: string, ts: int) -> dict
    if name in hc["checks"]
        hc["checks"][name]["status"] = "degraded"
        hc["checks"][name]["message"] = reason
        hc["checks"][name]["last_check"] = ts
    hc

fn hc_status(hc: dict, name: string) -> string
    if name in hc["checks"]
        return hc["checks"][name]["status"]
    "unknown"

fn hc_overall(hc: dict) -> string
    let names = keys(hc["checks"])
    let has_down = false
    let has_degraded = false
    for i in 0..len(names)
        let st = hc["checks"][names[i]]["status"]
        if st == "down"
            has_down = true
        if st == "degraded"
            has_degraded = true
    if has_down
        return "down"
    if has_degraded
        return "degraded"
    "up"

fn hc_check_count(hc: dict) -> int
    len(keys(hc["checks"]))

fn hc_down_checks(hc: dict) -> list
    let names = keys(hc["checks"])
    [names[i] for i in 0..len(names) if hc["checks"][names[i]]["status"] == "down"]

fn hc_summary(hc: dict) -> dict
    {"overall": hc_overall(hc), "total": hc_check_count(hc), "down": len(hc_down_checks(hc))}
