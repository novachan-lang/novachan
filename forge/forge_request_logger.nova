// forge_request_logger — HTTP request logging with Result.

fn rl_new(max_entries: int) -> dict
    let r = {}
    r["entries"] = {}
    r["count"] = 0
    r["max"] = max_entries
    r["errors"] = 0
    r

fn rl_log(r: dict, method: string, path: string, status: int, duration_ms: int) -> dict
    let k = str(r["count"] % r["max"])
    r["entries"][k + "_method"] = method
    r["entries"][k + "_path"] = path
    r["entries"][k + "_status"] = status
    r["entries"][k + "_duration"] = duration_ms
    if status >= 400
        r["errors"] = r["errors"] + 1
    r["count"] = r["count"] + 1
    r

fn rl_get(r: dict, idx: int) -> Result
    if idx >= r["count"]
        return err("index out of range")
    if idx < 0
        return err("negative index")
    let k = str(idx % r["max"])
    ok(r["entries"][k + "_method"] + " " + r["entries"][k + "_path"] + " " + str(r["entries"][k + "_status"]))

fn rl_error_rate(r: dict) -> int
    if r["count"] == 0
        return 0
    r["errors"] * 100 / r["count"]

fn rl_total_count(r: dict) -> int
    r["count"]

fn rl_avg_duration(r: dict) -> int
    if r["count"] == 0
        return 0
    let total = 0
    let n = r["count"]
    if n > r["max"]
        n = r["max"]
    let i = 0
    while i < n
        total = total + r["entries"][str(i) + "_duration"]
        i = i + 1
    total / n
