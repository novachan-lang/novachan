// forge_hungarian -- the Hungarian algorithm (Kuhn-Munkres) for the ASSIGNMENT PROBLEM: given an n x n cost matrix
// of assigning each worker to each job (or any agents-to-tasks pairing), find the one-to-one assignment of minimum
// TOTAL cost. The brute-force search is n! (10 items = 3.6 million orderings); the Hungarian algorithm finds the
// provably optimal matching in O(n^3) by maintaining dual "potentials" on rows and columns and repeatedly finding
// shortest augmenting paths. It's the workhorse behind task/resource scheduling, matching drivers to riders or
// bidders to items, minimizing total wiring/transport cost, and multi-object tracking (assigning detections to
// tracks frame to frame). Returns the minimum total cost and, for each row, the column it is assigned to. Costs
// are non-negative integers; the matrix is square. LEAF -- imports NOTHING.

// PRIVATE: large sentinel.
fn _hg_inf() -> int
    1000000000

// Solve the assignment problem for a square cost matrix. Returns [total_cost, assignment] where assignment[i] is
// the column assigned to row i (a permutation of 0..n-1) minimizing the sum of chosen costs.
fn hungarian(cost: list) -> list
    let n = len(cost)
    let INF = _hg_inf()
    // 1-indexed potentials/matching, sized n+1
    let u = []
    let v = []
    let p = []
    let way = []
    for z in 0..(n + 1)
        push(u, 0)
        push(v, 0)
        push(p, 0)
        push(way, 0)
    for i in 1..(n + 1)
        p[0] = i
        let j0 = 0
        let minv = []
        let used = []
        for q in 0..(n + 1)
            push(minv, INF)
            push(used, 0)
        let cont = true
        while cont
            used[j0] = 1
            let i0 = p[j0]
            let delta = INF
            let j1 = 0 - 1
            for j in 1..(n + 1)
                if used[j] == 0
                    let cur = cost[i0 - 1][j - 1] - u[i0] - v[j]
                    if cur < minv[j]
                        minv[j] = cur
                        way[j] = j0
                    if minv[j] < delta
                        delta = minv[j]
                        j1 = j
            for jj in 0..(n + 1)
                if used[jj] == 1
                    u[p[jj]] += delta
                    v[jj] -= delta
                else
                    minv[jj] -= delta
            j0 = j1
            if p[j0] == 0
                cont = false
        // augment along the found path
        let aug = true
        while aug
            let j1b = way[j0]
            p[j0] = p[j1b]
            j0 = j1b
            if j0 == 0
                aug = false
    // assignment[row] = column
    let ans = [0 for a in 0..n]
    for jc in 1..(n + 1)
        if p[jc] != 0
            ans[p[jc] - 1] = jc - 1
    // total cost
    let total = 0
    for r in 0..n
        total += cost[r][ans[r]]
    [total, ans]

// Just the minimum total assignment cost.
fn assignment_cost(cost: list) -> int
    let r = hungarian(cost)
    r[0]
