// forge_port -- TCP/UDP port validation + well-known service-name lookup + URL-scheme default ports (http=80,
// https=443, ssh=22, postgres=5432). For URL parsing, firewall rules, and service configuration. LEAF.

fn port_valid(port: int) -> bool
    port >= 1 and port <= 65535

fn _port_names() -> dict
    {"20": "ftp-data", "21": "ftp", "22": "ssh", "23": "telnet", "25": "smtp", "53": "dns", "80": "http", "110": "pop3", "143": "imap", "443": "https", "587": "smtp-submission", "993": "imaps", "995": "pop3s", "3306": "mysql", "5432": "postgresql", "6379": "redis", "8080": "http-alt", "27017": "mongodb"}

// The well-known service name for a port ("" if none).
fn port_service(port: int) -> string
    let m = _port_names()
    let k = str(port)
    if k in m
        return m[k]
    ""

// The default port for a URL scheme (0 if unknown).
fn port_for_scheme(scheme: string) -> int
    let s = lower(trim(scheme))
    if s == "http" or s == "ws"
        return 80
    if s == "https" or s == "wss"
        return 443
    if s == "ftp"
        return 21
    if s == "ssh"
        return 22
    if s == "smtp"
        return 25
    if s == "redis"
        return 6379
    if s == "postgresql" or s == "postgres"
        return 5432
    if s == "mysql"
        return 3306
    0
