// forge_port -- TCP/UDP port validation + well-known service-name lookup + URL-scheme default ports (http=80,
// https=443, ssh=22, postgres=5432). For URL parsing, firewall rules, and service configuration. LEAF.

fn port_valid(port: int) -> bool
    port >= 1 and port <= 65535

fn _port_names() -> dict
    let m = {}
    m["20"] = "ftp-data"
    m["21"] = "ftp"
    m["22"] = "ssh"
    m["23"] = "telnet"
    m["25"] = "smtp"
    m["53"] = "dns"
    m["80"] = "http"
    m["110"] = "pop3"
    m["143"] = "imap"
    m["443"] = "https"
    m["587"] = "smtp-submission"
    m["993"] = "imaps"
    m["995"] = "pop3s"
    m["3306"] = "mysql"
    m["5432"] = "postgresql"
    m["6379"] = "redis"
    m["8080"] = "http-alt"
    m["27017"] = "mongodb"
    m

// The well-known service name for a port ("" if none).
fn port_service(port: int) -> string
    let m = _port_names()
    let k = str(port)
    if contains(m, k)
        return m[k]
    ""

// The default port for a URL scheme (0 if unknown).
fn port_for_scheme(scheme: string) -> int
    let s = lower(trim(scheme))
    if s == "http" or s == "ws"
        return 80
    if s == "https" or s == "wss"
        return 443
    if s == "ftp"
        return 21
    if s == "ssh"
        return 22
    if s == "smtp"
        return 25
    if s == "redis"
        return 6379
    if s == "postgresql" or s == "postgres"
        return 5432
    if s == "mysql"
        return 3306
    0
