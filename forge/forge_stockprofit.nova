// forge_stockprofit -- maximum profit from buying and selling a single asset given its price history, under
// different trading rules. forge_subarray's best_buy_sell handles ONE buy and ONE sell; this covers the richer
// cases you actually meet: as MANY transactions as you like (max_profit_unlimited), an unlimited number but with a
// fixed FEE per completed trade (max_profit_with_fee), and AT MOST k transactions (max_profit_k). Unlimited trading
// is a one-line greedy -- capture every upward step, since selling at each local peak and rebuying at each local
// dip equals holding across the whole rise. Adding a fee or a transaction cap turns it into a small state-machine
// dynamic program that tracks the best cash and best "currently holding" values as prices stream by. These are the
// core of algorithmic-trading backtests, but the same shape models any "enter/exit a position repeatedly to
// maximize gain, possibly with switching costs or a limited number of moves" problem. Integer prices. LEAF.

// Max profit with UNLIMITED transactions (buy and sell any number of times, one position at a time). Greedy: sum
// every upward price step. max_profit_unlimited([7,1,5,3,6,4]) = 7.
fn max_profit_unlimited(prices: list) -> int
    let profit = 0
    for i in 1..len(prices)
        if prices[i] > prices[i - 1]
            profit += (prices[i] - prices[i - 1])
    profit

// Max profit with unlimited transactions but a fixed `fee` charged per completed buy/sell. State-machine DP.
fn max_profit_with_fee(prices: list, fee: int) -> int
    let out = 0
    if len(prices) > 0
        let cash = 0
        let hold = -prices[0]
        for i in 1..len(prices)
            let sell_now = hold + prices[i] - fee
            if sell_now > cash
                cash = sell_now
            let buy_now = cash - prices[i]
            if buy_now > hold
                hold = buy_now
        out = cash
    out

// Max profit with AT MOST k completed transactions. DP over transaction count; falls back to unlimited when k is
// large enough not to constrain. max_profit_k([3,2,6,5,0,3], 2) = 7.
fn max_profit_k(prices: list, k: int) -> int
    let n = len(prices)
    let out = 0
    if n > 0 and k > 0
        if k >= n / 2
            out = max_profit_unlimited(prices)
        else
            // buy[t] = best balance after buying in transaction t; sell[t] = best after selling t-th
            let buy = []
            let sell = []
            for z in 0..(k + 1)
                push(buy, -1000000000)
                push(sell, 0)
            for i in 0..n
                let p = prices[i]
                for t in 1..(k + 1)
                    let cand_buy = sell[t - 1] - p
                    if cand_buy > buy[t]
                        buy[t] = cand_buy
                    let cand_sell = buy[t] + p
                    if cand_sell > sell[t]
                        sell[t] = cand_sell
            out = sell[k]
    out
