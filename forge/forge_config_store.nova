// forge_config_store — hierarchical config store with Result API.

fn cfg_new() -> dict
    let c = {}
    c["values"] = {}
    c["count"] = 0
    c["defaults"] = {}
    c

fn cfg_set(c: dict, key: string, value: string) -> dict
    c["values"]["v_" + key] = value
    c["count"] = c["count"] + 1
    c

fn cfg_set_default(c: dict, key: string, value: string) -> dict
    c["defaults"]["d_" + key] = value
    c

fn cfg_get(c: dict, key: string) -> Result
    let vk = "v_" + key
    let has = contains(c["values"], vk)
    if has == true
        return ok(c["values"][vk])
    let dk = "d_" + key
    let has_d = contains(c["defaults"], dk)
    if has_d == true
        return ok(c["defaults"][dk])
    err("key not found: " + key)

fn cfg_has(c: dict, key: string) -> int
    let vk = "v_" + key
    let has = contains(c["values"], vk)
    if has == true
        return 1
    let dk = "d_" + key
    let has_d = contains(c["defaults"], dk)
    if has_d == true
        return 1
    0

fn cfg_delete(c: dict, key: string) -> Result
    let vk = "v_" + key
    let has = contains(c["values"], vk)
    if has != true
        return err("key not found: " + key)
    c["values"][vk] = ""
    c["count"] = c["count"] - 1
    ok(c)

fn cfg_count(c: dict) -> int
    c["count"]
