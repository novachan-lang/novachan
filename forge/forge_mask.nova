// forge_mask -- PII masking for logs, audit trails, and API responses (GDPR/CCPA data minimization; the
// Logback masking converter, Rails config.filter_parameters). Redact sensitive values so secrets and personal
// data never reach a log sink or an error report. Non-destructive: mask_fields returns a masked COPY so the
// caller's real object is untouched. LEAF -- imports NOTHING.

// "alice@example.com" -> "a***@example.com" (keep the first char of the local-part + the whole domain).
fn mask_email(email: string) -> string
    let at = find(email, "@")
    if at <= 0
        return "***"
    slice(email, 0, 1) + "***" + slice(email, at, len(email))

// Keep the last `keep` chars, star the rest: mask_tail("4111111111111111", 4) -> "************1111".
fn mask_tail(value: string, keep: int) -> string
    let n = len(value)
    if n <= keep
        return value
    let stars_parts = []
    for i in 0..(n - keep)
        push(stars_parts, "*")
    let stars = join(stars_parts, "")
    stars + slice(value, n - keep, n)

// Full redaction for passwords/tokens/secrets: any non-empty value -> "***" (empty stays empty).
fn mask_secret(value: string) -> string
    if len(value) == 0
        return ""
    "***"

// Return a COPY of `d` with every value whose key is in `sensitive` redacted to "***". Build a log-safe view
// of a request/DTO before logging it, leaving the original data intact.
fn mask_fields(d: dict, sensitive: list) -> dict
    let out = {}
    let ks = keys(d)
    for i in 0..len(ks)
        let k = ks[i]
        if k in sensitive
            out[k] = "***"
        else
            out[k] = d[k]
    out
