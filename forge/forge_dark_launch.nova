// forge_dark_launch — Dark launch / shadow traffic.
// Route a percentage of traffic to shadow handlers, compare results.

fn dl_new() -> dict
    let dl = {}
    dl["features"] = {}
    dl["results"] = []
    dl

fn dl_add_feature(dl: dict, name: string, shadow_pct: int) -> dict
    let f = {}
    f["shadow_pct"] = shadow_pct
    f["enabled"] = 1
    f["calls"] = 0
    f["shadow_calls"] = 0
    f["mismatches"] = 0
    dl["features"][name] = f
    dl

fn dl_should_shadow(dl: dict, name: string, request_id: int) -> int
    let has = contains(dl["features"], name)
    if has != true
        return 0
    if dl["features"][name]["enabled"] != 1
        return 0
    let pct = dl["features"][name]["shadow_pct"]
    let hash = request_id % 100
    if hash < pct
        return 1
    0

fn dl_record_call(dl: dict, name: string, shadowed: int, matched: int) -> dict
    let has = contains(dl["features"], name)
    if has != true
        return dl
    dl["features"][name]["calls"] = dl["features"][name]["calls"] + 1
    if shadowed == 1
        dl["features"][name]["shadow_calls"] = dl["features"][name]["shadow_calls"] + 1
        if matched != 1
            dl["features"][name]["mismatches"] = dl["features"][name]["mismatches"] + 1
    let r = {}
    r["feature"] = name
    r["shadowed"] = shadowed
    r["matched"] = matched
    push(dl["results"], r)
    dl

fn dl_mismatch_rate(dl: dict, name: string) -> int
    let has = contains(dl["features"], name)
    if has != true
        return 0
    let sc = dl["features"][name]["shadow_calls"]
    if sc == 0
        return 0
    let mm = dl["features"][name]["mismatches"]
    (mm * 100) / sc

fn dl_disable(dl: dict, name: string) -> dict
    let has = contains(dl["features"], name)
    if has != true
        return dl
    dl["features"][name]["enabled"] = 0
    dl

fn dl_feature_count(dl: dict) -> int
    len(keys(dl["features"]))

fn dl_total_calls(dl: dict, name: string) -> int
    let has = contains(dl["features"], name)
    if has != true
        return 0
    dl["features"][name]["calls"]

fn dl_shadow_calls(dl: dict, name: string) -> int
    let has = contains(dl["features"], name)
    if has != true
        return 0
    dl["features"][name]["shadow_calls"]
