// forge_components -- the connected components ("islands") of an UNDIRECTED graph: groups of nodes that are all
// reachable from each other, with no connection between groups. This is the everyday "how many separate clusters
// are there, and who's in each" question: friend/social circles, network segments that can't reach each other,
// clusters of related records in entity resolution / deduplication, disjoint regions in a map or mesh, and
// checking whether an infrastructure graph is fully connected or fragmented. Unlike forge_scc (which handles
// DIRECTED cycles), this treats every edge as two-way. It BFS-floods from each unvisited node to gather its
// component. Edges are [u, v] undirected, string ids; only nodes that appear in an edge are considered. LEAF.

// PRIVATE.
fn _cc_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    for i in 0..len(edges)
        let u = edges[i][0]
        if u not in seen
            seen[u] = 1
            push(nodes, u)
        let v = edges[i][1]
        if v not in seen
            seen[v] = 1
            push(nodes, v)
    nodes

// PRIVATE: undirected adjacency.
fn _cc_adj(edges: list, nodes: list) -> dict
    let adj = {}
    for i in 0..len(nodes)
        adj[nodes[i]] = []
    for e in 0..len(edges)
        push(adj[edges[e][0]], edges[e][1])
        push(adj[edges[e][1]], edges[e][0])
    adj

// All connected components as a list of node-id lists.
fn connected_components(edges: list) -> list
    let nodes = _cc_nodes(edges)
    let adj = _cc_adj(edges, nodes)
    let visited = {}
    let comps = []
    for ni in 0..len(nodes)
        let start = nodes[ni]
        if start not in visited
            let comp = []
            let queue = []
            push(queue, start)
            visited[start] = 1
            let qi = 0
            while qi < len(queue)
                let v = queue[qi]
                qi += 1
                push(comp, v)
                let nb = adj[v]
                for j in 0..len(nb)
                    if nb[j] not in visited
                        visited[nb[j]] = 1
                        push(queue, nb[j])
            push(comps, comp)
    comps

// The number of connected components.
fn component_count(edges: list) -> int
    len(connected_components(edges))

// The size (node count) of the largest connected component.
fn largest_component_size(edges: list) -> int
    let comps = connected_components(edges)
    let best = 0
    for i in 0..len(comps)
        if len(comps[i]) > best
            best = len(comps[i])
    best

// True if u and v are in the same connected component (reachable through undirected edges).
fn same_component(edges: list, u, v) -> bool
    let comps = connected_components(edges)
    for i in 0..len(comps)
        let hu = false
        let hv = false
        for j in 0..len(comps[i])
            if comps[i][j] == u
                hu = true
            if comps[i][j] == v
                hv = true
        if hu and hv
            return true
    false

// True if the whole graph is one connected component.
fn is_connected(edges: list) -> bool
    component_count(edges) <= 1
