// forge_cursor -- CURSOR (keyset) pagination (GraphQL Relay connections, Stripe starting_after, Twitter
// max_id). Offset pagination is O(n) to skip rows and DRIFTS when rows are inserted mid-scroll; cursor
// pagination is an O(log n) index seek on (sort_key, id) and is STABLE under concurrent inserts. A cursor is
// an opaque token encoding the last row's [sort_value, id]; the next page is "WHERE (sort,id) > cursor".
// Length-prefixed encoding so a sort value containing the delimiter can't corrupt decoding. LEAF.

// Opaque cursor for the last row on a page. Length-prefix the sort value so ':' inside it is unambiguous.
fn cursor_encode(sort_value: string, id: string) -> string
    "{len(sort_value)}:{sort_value}:{id}"

// Decode a cursor back to [sort_value, id]. [] if malformed (treat as first page).
fn cursor_decode(cursor: string) -> list
    let colon = find(cursor, ":")
    if colon < 0
        return []
    let n = parse_int(slice(cursor, 0, colon))
    let rest = slice(cursor, colon + 1, len(cursor))
    if len(rest) < n + 1
        return []
    let sort_value = slice(rest, 0, n)
    let id = slice(rest, n + 1, len(rest))
    [sort_value, id]

// Build the keyset predicate + params for "rows strictly after this cursor" ordered by (sort_col, id_col)
// ascending. Returns [sql_fragment, params]. First page (empty/malformed cursor) -> ["", []]. Parameterized
// (the values are bound, never interpolated -> injection-safe).
fn cursor_where(cursor: string, sort_col: string, id_col: string) -> list
    if len(cursor) == 0
        return ["", []]
    let dec = cursor_decode(cursor)
    if len(dec) == 0
        return ["", []]
    let sql = "({sort_col}, {id_col}) > (?, ?)"
    [sql, [dec[0], dec[1]]]
