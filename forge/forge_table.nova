// forge_table -- render a data table as aligned monospace text (terminal output, logs, CLI reports, plain-text
// email). Given headers + rows (lists of string cells), computes column widths and pads cells, with a header
// separator line. LEAF -- imports NOTHING.

fn _tbl_max(a: int, b: int) -> int
    if a > b
        return a
    b

fn _tbl_pad(s: string, width: int) -> string
    let out = s
    while len(out) < width
        out = out + " "
    out

fn _tbl_dashes(n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + "-"
        i = i + 1
    out

fn _tbl_row(cells: list, widths: list, cols: int) -> string
    let out = ""
    let c = 0
    while c < cols
        if c > 0
            out = out + " | "
        let cell = ""
        if c < len(cells)
            cell = cells[c]
        out = out + _tbl_pad(cell, widths[c])
        c = c + 1
    out

// Render `headers` + `rows` (each a list of string cells) as an aligned table.
fn table_render(headers: list, rows: list) -> string
    let cols = len(headers)
    let widths = []
    let c = 0
    while c < cols
        push(widths, len(headers[c]))
        c = c + 1
    let r = 0
    while r < len(rows)
        let row = rows[r]
        let c2 = 0
        while c2 < cols and c2 < len(row)
            widths[c2] = _tbl_max(widths[c2], len(row[c2]))
            c2 = c2 + 1
        r = r + 1
    let nl = chr(10)
    let out = _tbl_row(headers, widths, cols)
    let sep = []
    let sc = 0
    while sc < cols
        push(sep, _tbl_dashes(widths[sc]))
        sc = sc + 1
    out = out + nl + _tbl_row(sep, widths, cols)
    let rr = 0
    while rr < len(rows)
        out = out + nl + _tbl_row(rows[rr], widths, cols)
        rr = rr + 1
    out
