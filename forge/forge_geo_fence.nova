// forge_geo_fence — Geo-fencing.
// Define rectangular zones, check point containment, nearest zone.

fn gf_new() -> dict
    {"zones": []}

fn gf_add_zone(gf: dict, name: string, min_lat: int, min_lon: int, max_lat: int, max_lon: int) -> dict
    push(gf["zones"], {"name": name, "min_lat": min_lat, "min_lon": min_lon, "max_lat": max_lat, "max_lon": max_lon})
    gf

fn gf_contains(gf: dict, zone_name: string, lat: int, lon: int) -> int
    for i in 0..len(gf["zones"])
        let z = gf["zones"][i]
        if z["name"] == zone_name
            if lat >= z["min_lat"]
                if lat <= z["max_lat"]
                    if lon >= z["min_lon"]
                        if lon <= z["max_lon"]
                            return 1
            return 0
    0

fn gf_zones_at(gf: dict, lat: int, lon: int) -> list
    let result = []
    for i in 0..len(gf["zones"])
        let z = gf["zones"][i]
        if lat >= z["min_lat"]
            if lat <= z["max_lat"]
                if lon >= z["min_lon"]
                    if lon <= z["max_lon"]
                        push(result, z["name"])
    result

fn gf_zone_count(gf: dict) -> int
    len(gf["zones"])

fn gf_get_zone(gf: dict, name: string) -> dict
    for i in 0..len(gf["zones"])
        if gf["zones"][i]["name"] == name
            return gf["zones"][i]
    {"name": ""}
