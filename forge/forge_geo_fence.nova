// forge_geo_fence — Geo-fencing.
// Define rectangular zones, check point containment, nearest zone.

fn gf_new() -> dict
    let gf = {}
    gf["zones"] = []
    gf

fn gf_add_zone(gf: dict, name: string, min_lat: int, min_lon: int, max_lat: int, max_lon: int) -> dict
    let z = {}
    z["name"] = name
    z["min_lat"] = min_lat
    z["min_lon"] = min_lon
    z["max_lat"] = max_lat
    z["max_lon"] = max_lon
    push(gf["zones"], z)
    gf

fn gf_contains(gf: dict, zone_name: string, lat: int, lon: int) -> int
    let i = 0
    while i < len(gf["zones"])
        let z = gf["zones"][i]
        if z["name"] == zone_name
            if lat >= z["min_lat"]
                if lat <= z["max_lat"]
                    if lon >= z["min_lon"]
                        if lon <= z["max_lon"]
                            return 1
            return 0
        i += 1
    0

fn gf_zones_at(gf: dict, lat: int, lon: int) -> list
    let result = []
    let i = 0
    while i < len(gf["zones"])
        let z = gf["zones"][i]
        if lat >= z["min_lat"]
            if lat <= z["max_lat"]
                if lon >= z["min_lon"]
                    if lon <= z["max_lon"]
                        push(result, z["name"])
        i += 1
    result

fn gf_zone_count(gf: dict) -> int
    len(gf["zones"])

fn gf_get_zone(gf: dict, name: string) -> dict
    let i = 0
    while i < len(gf["zones"])
        if gf["zones"][i]["name"] == name
            return gf["zones"][i]
        i += 1
    let empty = {}
    empty["name"] = ""
    empty
