// forge_duration_parse -- parse a human duration string ("2h30m", "1d12h", "500ms", "90s") into milliseconds:
// the inverse of forge_duration's humanize (ms -> text). For config timeouts, retry intervals, and cache TTLs
// written the way humans write them. Units: ms, s, m, h, d, w (accumulated). LEAF -- imports NOTHING.

// Parse a duration string to MILLISECONDS. Unknown units contribute 0; "ms" is matched before "m".
fn parse_duration_ms(s: string) -> int
    let total = 0
    let num = 0
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        if c >= "0" and c <= "9"
            num = num * 10 + (ord(c) - 48)
            i = i + 1
        else
            if c == "m" and i + 1 < n and char_at(s, i + 1) == "s"
                total = total + num
                num = 0
                i = i + 2
            else
                let mult = 0
                if c == "s"
                    mult = 1000
                if c == "m"
                    mult = 60000
                if c == "h"
                    mult = 3600000
                if c == "d"
                    mult = 86400000
                if c == "w"
                    mult = 604800000
                total = total + num * mult
                num = 0
                i = i + 1
    total

// Parse a duration string to whole SECONDS.
fn parse_duration_seconds(s: string) -> int
    parse_duration_ms(s) / 1000
