// forge_versioned_store — Key-value with version history and Result.

fn vs_new() -> dict
    let v = {}
    v["data"] = {}
    v["versions"] = {}
    v["history"] = {}
    v["count"] = 0
    v

fn vs_put(v: dict, key: string, value: string) -> dict
    let has = contains(v["versions"], key)
    let ver = 1
    if has == true
        ver = v["versions"][key] + 1
        v["history"][key + "_v" + str(ver - 1)] = v["data"][key]
    v["data"][key] = value
    v["versions"][key] = ver
    if ver == 1
        v["count"] = v["count"] + 1
    v

fn vs_get(v: dict, key: string) -> Result
    let has = contains(v["data"], key)
    if has != true
        return err("key not found: " + key)
    ok(v["data"][key])

fn vs_get_version(v: dict, key: string, ver: int) -> Result
    let current = v["versions"][key]
    if ver == current
        return ok(v["data"][key])
    let hkey = key + "_v" + str(ver)
    let has = contains(v["history"], hkey)
    if has != true
        return err("version not found: " + str(ver))
    ok(v["history"][hkey])

fn vs_version(v: dict, key: string) -> Result
    let has = contains(v["versions"], key)
    if has != true
        return err("key not found")
    ok(v["versions"][key])

fn vs_count(v: dict) -> int
    v["count"]
