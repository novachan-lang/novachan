// forge_chain_of_resp — Chain of responsibility pattern.

fn cor_new() -> dict
    let c = {}
    c["handlers"] = {}
    c["handler_count"] = 0
    c["handled"] = 0
    c["unhandled"] = 0
    c

fn cor_add_handler(c: dict, name: string, handles_type: string) -> dict
    let k = str(c["handler_count"])
    c["handlers"][k + "_name"] = name
    c["handlers"][k + "_type"] = handles_type
    c["handlers"][k + "_enabled"] = 1
    c["handler_count"] = c["handler_count"] + 1
    c

fn cor_disable(c: dict, name: string) -> dict
    let i = 0
    while i < c["handler_count"]
        if c["handlers"][str(i) + "_name"] == name
            c["handlers"][str(i) + "_enabled"] = 0
        i += 1
    c

fn cor_handle(c: dict, request_type: string) -> dict
    let result = {}
    let i = 0
    while i < c["handler_count"]
        let k = str(i)
        if c["handlers"][k + "_enabled"] == 1
            if c["handlers"][k + "_type"] == request_type
                c["handled"] = c["handled"] + 1
                result["handled"] = 1
                result["handler"] = c["handlers"][k + "_name"]
                result["c"] = c
                return result
        i += 1
    c["unhandled"] = c["unhandled"] + 1
    result["handled"] = 0
    result["handler"] = ""
    result["c"] = c
    result

fn cor_handler_count(c: dict) -> int
    c["handler_count"]

fn cor_total_handled(c: dict) -> int
    c["handled"]

fn cor_total_unhandled(c: dict) -> int
    c["unhandled"]

fn cor_handle_rate(c: dict) -> int
    let total = c["handled"] + c["unhandled"]
    if total == 0
        return 100
    c["handled"] * 100 / total
