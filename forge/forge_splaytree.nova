// forge_splaytree -- splay tree: a self-adjusting binary search tree with amortized O(log n) operations.
// A splay tree is a BST that, after every access, ROTATES the touched node to the root ("splaying").
// This simple move gives it three remarkable properties no balanced tree has for free:
//   1. Amortized O(log n) per operation WITHOUT storing any balance/height/color metadata.
//   2. The WORKING-SET property: recently/frequently accessed keys stay near the root, so real workloads
//      with locality run FASTER than a perfectly balanced tree (self-optimizing to the access pattern).
//   3. It is the node structure underneath LINK-CUT TREES (the next module), the standard way to represent
//      dynamic forests -- so a correct splay tree is a prerequisite for dynamic-tree connectivity.
// Uses: caches / LRU-ish structures, rope/text editors, network routing tables, any BST workload with
// temporal locality, and as the balancing engine of link-cut trees.
//
// This is a KEY-ORDERED splay tree over integer keys (a set/map). Nodes are stored in flat parallel
// arrays (a node pool) so there is no pointer aliasing hazard: left[i], right[i], parent[i], key[i].
// The root is tracked in a 1-element list so it can be mutated by reference across calls.
// Standard bottom-up splay via zig / zig-zig / zig-zag rotations.
//
// API:
//   sp_new() -> tree                     empty splay tree
//   sp_insert(tree, k)                   insert key k (no-op if present); splays k to root
//   sp_contains(tree, k) -> bool         membership test; splays the last accessed node to root
//   sp_delete(tree, k)                   remove key k if present
//   sp_size(tree) -> int                 number of keys
//   sp_min(tree) -> int                  smallest key (or a sentinel if empty); splays it to root
//   sp_max(tree) -> int                  largest key (sentinel if empty)
//   sp_inorder(tree) -> list             sorted list of all keys (validates BST order)
// LEAF (imports nothing).

fn _sp_nil() -> int
    return -1

// tree = [key_arr, left_arr, right_arr, parent_arr, root_box, size_box]
// root_box and size_box are 1-element lists so they mutate by reference.
fn sp_new() -> list
    let key_arr = []
    let left_arr = []
    let right_arr = []
    let parent_arr = []
    let root_box = [-1]
    let size_box = [0]
    return [key_arr, left_arr, right_arr, parent_arr, root_box, size_box]

fn _sp_alloc(tree: list, k: int) -> int
    let key_arr = tree[0]
    let left_arr = tree[1]
    let right_arr = tree[2]
    let parent_arr = tree[3]
    push(key_arr, k)
    push(left_arr, -1)
    push(right_arr, -1)
    push(parent_arr, -1)
    return len(key_arr) - 1

// Right rotation around x (x becomes right child of its left child).
fn _sp_rotate_right(tree: list, x: int)
    let left_arr = tree[1]
    let right_arr = tree[2]
    let parent_arr = tree[3]
    let root_box = tree[4]
    let y = left_arr[x]
    left_arr[x] = right_arr[y]
    if right_arr[y] != -1
        parent_arr[right_arr[y]] = x
    parent_arr[y] = parent_arr[x]
    if parent_arr[x] == -1
        root_box[0] = y
    else
        if x == left_arr[parent_arr[x]]
            left_arr[parent_arr[x]] = y
        else
            right_arr[parent_arr[x]] = y
    right_arr[y] = x
    parent_arr[x] = y

// Left rotation around x (x becomes left child of its right child).
fn _sp_rotate_left(tree: list, x: int)
    let left_arr = tree[1]
    let right_arr = tree[2]
    let parent_arr = tree[3]
    let root_box = tree[4]
    let y = right_arr[x]
    right_arr[x] = left_arr[y]
    if left_arr[y] != -1
        parent_arr[left_arr[y]] = x
    parent_arr[y] = parent_arr[x]
    if parent_arr[x] == -1
        root_box[0] = y
    else
        if x == left_arr[parent_arr[x]]
            left_arr[parent_arr[x]] = y
        else
            right_arr[parent_arr[x]] = y
    left_arr[y] = x
    parent_arr[x] = y

// Splay node x to the root.
fn _sp_splay(tree: list, x: int)
    let left_arr = tree[1]
    let right_arr = tree[2]
    let parent_arr = tree[3]
    while parent_arr[x] != -1
        let p = parent_arr[x]
        let g = parent_arr[p]
        if g == -1
            // zig
            if x == left_arr[p]
                _sp_rotate_right(tree, p)
            else
                _sp_rotate_left(tree, p)
        else
            if x == left_arr[p] and p == left_arr[g]
                // zig-zig
                _sp_rotate_right(tree, g)
                _sp_rotate_right(tree, p)
            else
                if x == right_arr[p] and p == right_arr[g]
                    _sp_rotate_left(tree, g)
                    _sp_rotate_left(tree, p)
                else
                    if x == right_arr[p] and p == left_arr[g]
                        // zig-zag
                        _sp_rotate_left(tree, p)
                        _sp_rotate_right(tree, g)
                    else
                        _sp_rotate_right(tree, p)
                        _sp_rotate_left(tree, g)

// Insert key k. Splays k to root. No-op if already present (still splays).
fn sp_insert(tree: list, k: int)
    let key_arr = tree[0]
    let left_arr = tree[1]
    let right_arr = tree[2]
    let parent_arr = tree[3]
    let root_box = tree[4]
    let size_box = tree[5]
    if root_box[0] == -1
        let node = _sp_alloc(tree, k)
        root_box[0] = node
        size_box[0] = size_box[0] + 1
        return
    let cur = root_box[0]
    let done = false
    while not done
        if k == key_arr[cur]
            _sp_splay(tree, cur)
            return
        if k < key_arr[cur]
            if left_arr[cur] == -1
                let node = _sp_alloc(tree, k)
                left_arr[cur] = node
                parent_arr[node] = cur
                size_box[0] = size_box[0] + 1
                _sp_splay(tree, node)
                done = true
            else
                cur = left_arr[cur]
        else
            if right_arr[cur] == -1
                let node = _sp_alloc(tree, k)
                right_arr[cur] = node
                parent_arr[node] = cur
                size_box[0] = size_box[0] + 1
                _sp_splay(tree, node)
                done = true
            else
                cur = right_arr[cur]

// Find the node with key k, or -1. Splays the last node on the search path to root.
fn _sp_find(tree: list, k: int) -> int
    let key_arr = tree[0]
    let left_arr = tree[1]
    let right_arr = tree[2]
    let root_box = tree[4]
    let cur = root_box[0]
    let last = -1
    let found = -1
    while cur != -1 and found == -1
        last = cur
        if k == key_arr[cur]
            found = cur
        else
            if k < key_arr[cur]
                cur = left_arr[cur]
            else
                cur = right_arr[cur]
    if last != -1
        _sp_splay(tree, last)
    return found

fn sp_contains(tree: list, k: int) -> bool
    return _sp_find(tree, k) != -1

// Delete key k if present.
fn sp_delete(tree: list, k: int)
    let key_arr = tree[0]
    let left_arr = tree[1]
    let right_arr = tree[2]
    let parent_arr = tree[3]
    let root_box = tree[4]
    let size_box = tree[5]
    let node = _sp_find(tree, k)
    if node == -1
        return
    // node is now the root (splayed). Detach and join subtrees.
    let l = left_arr[node]
    let r = right_arr[node]
    if l != -1
        parent_arr[l] = -1
    if r != -1
        parent_arr[r] = -1
    if l == -1
        root_box[0] = r
    else
        // find max of left subtree, splay it, attach r as its right child
        let m = l
        while right_arr[m] != -1
            m = right_arr[m]
        root_box[0] = l
        _sp_splay(tree, m)
        right_arr[m] = r
        if r != -1
            parent_arr[r] = m
    size_box[0] = size_box[0] - 1

fn sp_size(tree: list) -> int
    let size_box = tree[5]
    return size_box[0]

fn sp_min(tree: list) -> int
    let key_arr = tree[0]
    let left_arr = tree[1]
    let root_box = tree[4]
    if root_box[0] == -1
        return 0 - 2147483648
    let cur = root_box[0]
    while left_arr[cur] != -1
        cur = left_arr[cur]
    _sp_splay(tree, cur)
    return key_arr[cur]

fn sp_max(tree: list) -> int
    let key_arr = tree[0]
    let right_arr = tree[2]
    let root_box = tree[4]
    if root_box[0] == -1
        return 0 - 2147483648
    let cur = root_box[0]
    while right_arr[cur] != -1
        cur = right_arr[cur]
    _sp_splay(tree, cur)
    return key_arr[cur]

// In-order traversal producing the sorted key list (iterative, explicit stack).
fn sp_inorder(tree: list) -> list
    let key_arr = tree[0]
    let left_arr = tree[1]
    let right_arr = tree[2]
    let root_box = tree[4]
    let out = []
    let stack = []
    let cur = root_box[0]
    while cur != -1 or len(stack) > 0
        while cur != -1
            push(stack, cur)
            cur = left_arr[cur]
        let top = stack[len(stack) - 1]
        let new_stack = [stack[si] for si in 0..(len(stack) - 1)]
        stack = new_stack
        push(out, key_arr[top])
        cur = right_arr[top]
    return out
