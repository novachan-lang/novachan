// forge_splaytree -- thin wrapper over std/collections/splaytree (canonical implementation).
import std/collections/splaytree

fn sp_new() -> list
    return spl_new()

fn sp_insert(tree: list, k: int)
    return spl_insert(tree, k)

fn sp_contains(tree: list, k: int) -> bool
    return spl_contains(tree, k)

fn sp_delete(tree: list, k: int)
    return spl_delete(tree, k)

fn sp_size(tree: list) -> int
    return spl_size(tree)

fn sp_min(tree: list) -> int
    return spl_min(tree)

fn sp_max(tree: list) -> int
    return spl_max(tree)

fn sp_inorder(tree: list) -> list
    return spl_inorder(tree)

