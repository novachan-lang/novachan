// forge_kv_ttl -- an in-memory key-value store with PER-KEY TTL expiry (lazy eviction on read). For
// request-scoped caches, short-lived tokens, OTP/nonce storage, and rate-limit state. An entry expires when
// now > its expiry; reads past expiry behave as absent. State = dict of key -> [value, expiry_epoch]. LEAF.

fn kv_new() -> dict
    let k = {}
    k

// Set `key`=`value` with a TTL of `ttl_seconds` from `now` (ttl<=0 = never expires). Fluent.
fn kv_set(store: dict, key: string, value: string, ttl_seconds: int, now: int) -> dict
    let exp = 0
    if ttl_seconds > 0
        exp = now + ttl_seconds
    store[key] = [value, exp]
    store

// Is `key` present and unexpired at `now`?
fn kv_has(store: dict, key: string, now: int) -> bool
    if key not in store
        return false
    let entry = store[key]
    let exp = entry[1]
    if exp != 0 and now > exp
        return false
    true

// Value for `key` at `now` -> "" if absent or expired.
fn kv_get(store: dict, key: string, now: int) -> string
    if kv_has(store, key, now) == false
        return ""
    let entry = store[key]
    entry[0]

// Seconds until `key` expires (0 = no TTL; -1 = absent/expired).
fn kv_ttl_remaining(store: dict, key: string, now: int) -> int
    if kv_has(store, key, now) == false
        return 0 - 1
    let entry = store[key]
    let exp = entry[1]
    if exp == 0
        return 0
    exp - now

// Return a NEW store without `key` (no in-place dict delete).
fn kv_delete(store: dict, key: string) -> dict
    let out = kv_new()
    let ks = keys(store)
    for i in 0..len(ks)
        if ks[i] != key
            out[ks[i]] = store[ks[i]]
    out
