// forge_task_pool — Pool of callable tasks with status tracking.

fn tp_new() -> dict
    let t = {}
    t["tasks"] = {}
    t["task_count"] = 0
    t["running"] = 0
    t["completed"] = 0
    t["failed"] = 0
    t

fn tp_submit(t: dict, name: string, payload: string) -> dict
    let k = str(t["task_count"])
    t["tasks"][k + "_name"] = name
    t["tasks"][k + "_payload"] = payload
    t["tasks"][k + "_status"] = "pending"
    t["task_count"] = t["task_count"] + 1
    t

fn tp_start(t: dict, idx: int) -> dict
    if idx >= t["task_count"]
        return t
    t["tasks"][str(idx) + "_status"] = "running"
    t["running"] = t["running"] + 1
    t

fn tp_complete(t: dict, idx: int) -> dict
    if idx >= t["task_count"]
        return t
    t["tasks"][str(idx) + "_status"] = "completed"
    t["running"] = t["running"] - 1
    t["completed"] = t["completed"] + 1
    t

fn tp_fail(t: dict, idx: int) -> dict
    if idx >= t["task_count"]
        return t
    t["tasks"][str(idx) + "_status"] = "failed"
    t["running"] = t["running"] - 1
    t["failed"] = t["failed"] + 1
    t

fn tp_status(t: dict, idx: int) -> string
    t["tasks"][str(idx) + "_status"]

fn tp_pending_count(t: dict) -> int
    t["task_count"] - t["completed"] - t["failed"] - t["running"]

fn tp_completion_rate(t: dict) -> int
    if t["task_count"] == 0
        return 0
    t["completed"] * 100 / t["task_count"]

fn tp_failure_rate(t: dict) -> int
    let done = t["completed"] + t["failed"]
    if done == 0
        return 0
    t["failed"] * 100 / done
