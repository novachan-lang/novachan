enum OrmDriver
    Sqlite(pool: chan, size: int)
    Postgres(pool: chan, size: int)
    Mysql(conn: int)

type OrmDb
    drv: OrmDriver

fn zopen_sqlite(n: int) -> OrmDb
    let ch = channel()
    for i in 0..n
        send(ch, 100 + i)
    OrmDb { drv: Sqlite(ch, n) }

fn OrmDb.qident(name: string) -> string
    match self.drv
        Mysql(c) => "`" + name.replace("`", "``") + "`"
        _ => "\"" + name.replace("\"", "\"\"") + "\""

fn OrmDb.size() -> int
    match self.drv
        Sqlite(p, s) => s
        Postgres(p, s) => s
        Mysql(c) => 1
