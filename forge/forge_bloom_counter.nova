// forge_bloom_counter — Counting Bloom filter (approximate membership + count).

fn bc_new(size: int) -> dict
    let b = {"size": size, "buckets": {}, "added": 0}
    for i in 0..size
        b["buckets"][str(i)] = 0
    b

fn bc_hash1(b: dict, key: string) -> int
    let h = 0
    for i in 0..len(key)
        h = h * 31 + ord(key[i])
    if h < 0
        h = -h
    h - (h / b["size"]) * b["size"]

fn bc_hash2(b: dict, key: string) -> int
    let h = 17
    for i in 0..len(key)
        h = h * 37 + ord(key[i]) + 7
    if h < 0
        h = -h
    h - (h / b["size"]) * b["size"]

fn bc_add(b: dict, key: string) -> dict
    let h1 = bc_hash1(b, key)
    let h2 = bc_hash2(b, key)
    b["buckets"][str(h1)] += 1
    b["buckets"][str(h2)] += 1
    b["added"] += 1
    b

fn bc_might_contain(b: dict, key: string) -> int
    let h1 = bc_hash1(b, key)
    let h2 = bc_hash2(b, key)
    if b["buckets"][str(h1)] > 0 and b["buckets"][str(h2)] > 0
        return 1
    0

fn bc_min_count(b: dict, key: string) -> int
    let h1 = bc_hash1(b, key)
    let h2 = bc_hash2(b, key)
    let c1 = b["buckets"][str(h1)]
    let c2 = b["buckets"][str(h2)]
    c1 if c1 < c2 else c2

fn bc_total_added(b: dict) -> int
    b["added"]
