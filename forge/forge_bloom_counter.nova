// forge_bloom_counter — Counting Bloom filter (approximate membership + count).

fn bc_new(size: int) -> dict
    let b = {}
    b["size"] = size
    b["buckets"] = {}
    b["added"] = 0
    let i = 0
    while i < size
        b["buckets"][str(i)] = 0
        i = i + 1
    b

fn bc_hash1(b: dict, key: string) -> int
    let h = 0
    let i = 0
    while i < len(key)
        h = h * 31 + ord(key[i])
        i = i + 1
    let r = h
    if r < 0
        r = 0 - r
    r - (r / b["size"]) * b["size"]

fn bc_hash2(b: dict, key: string) -> int
    let h = 17
    let i = 0
    while i < len(key)
        h = h * 37 + ord(key[i]) + 7
        i = i + 1
    let r = h
    if r < 0
        r = 0 - r
    r - (r / b["size"]) * b["size"]

fn bc_add(b: dict, key: string) -> dict
    let h1 = bc_hash1(b, key)
    let h2 = bc_hash2(b, key)
    b["buckets"][str(h1)] = b["buckets"][str(h1)] + 1
    b["buckets"][str(h2)] = b["buckets"][str(h2)] + 1
    b["added"] = b["added"] + 1
    b

fn bc_might_contain(b: dict, key: string) -> int
    let h1 = bc_hash1(b, key)
    let h2 = bc_hash2(b, key)
    if b["buckets"][str(h1)] > 0
        if b["buckets"][str(h2)] > 0
            return 1
    0

fn bc_min_count(b: dict, key: string) -> int
    let h1 = bc_hash1(b, key)
    let h2 = bc_hash2(b, key)
    let c1 = b["buckets"][str(h1)]
    let c2 = b["buckets"][str(h2)]
    if c1 < c2
        return c1
    c2

fn bc_total_added(b: dict) -> int
    b["added"]
