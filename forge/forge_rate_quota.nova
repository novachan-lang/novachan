// forge_rate_quota — Rate limiting + quota management per tenant/key.

fn rq_new() -> dict
    {"quotas": {}, "usage": {}, "violations": []}

fn rq_set_quota(rq: dict, key: string, limit: int, window_sec: int) -> dict
    let q = {"limit": limit, "window": window_sec}
    rq["quotas"][key] = q
    if key not in rq["usage"]
        rq["usage"][key] = {"count": 0, "window_start": 0}
    rq

fn rq_record(rq: dict, key: string, timestamp: int) -> dict
    if key not in rq["quotas"]
        return rq
    let quota = rq["quotas"][key]
    let usage = rq["usage"][key]
    let window_end = usage["window_start"] + quota["window"]
    if timestamp >= window_end
        usage["count"] = 0
        usage["window_start"] = timestamp
    usage["count"] += 1
    if usage["count"] > quota["limit"]
        let v = {"key": key, "timestamp": timestamp, "count": usage["count"], "limit": quota["limit"]}
        push(rq["violations"], v)
    rq

fn rq_is_allowed(rq: dict, key: string) -> int
    if key not in rq["quotas"]
        return 1
    let quota = rq["quotas"][key]
    let usage = rq["usage"][key]
    if usage["count"] >= quota["limit"]
        return 0
    1

fn rq_remaining(rq: dict, key: string) -> int
    if key not in rq["quotas"]
        return 0
    let quota = rq["quotas"][key]
    let usage = rq["usage"][key]
    let rem = quota["limit"] - usage["count"]
    if rem < 0
        return 0
    rem

fn rq_usage(rq: dict, key: string) -> int
    if key not in rq["usage"]
        return 0
    rq["usage"][key]["count"]

fn rq_violations(rq: dict) -> list
    rq["violations"]

fn rq_violation_count(rq: dict) -> int
    len(rq["violations"])

fn rq_reset(rq: dict, key: string) -> dict
    if key not in rq["usage"]
        return rq
    rq["usage"][key]["count"] = 0
    rq
