// forge_retry_after -- parse a Retry-After response header (RFC 7231): either delay-seconds ("120") or an
// HTTP-date ("Sun, 06 Nov 1994 08:49:37 GMT"). Returns the wait in SECONDS from `now`, so a client can back off
// correctly on a 429/503 regardless of which form the server used. Composes forge_httpdate. Imports forge_httpdate.
import forge_httpdate

fn _ra_is_int(s: string) -> bool
    if len(s) == 0
        return false
    for i in 0..len(s)
        if find("0123456789", char_at(s, i)) < 0
            return false
    true

// Parse a Retry-After value -> wait seconds from `now_epoch`. Digits = seconds directly; HTTP-date = (date -
// now) floored at 0; -1 if unparseable.
fn retry_after_seconds(header: string, now_epoch: int) -> int
    let h = trim(header)
    if len(h) == 0
        return -1
    if _ra_is_int(h)
        return parse_int(h)
    let target = httpdate_parse(h)
    if target < 0
        return -1
    let delay = target - now_epoch
    if delay < 0
        return 0
    delay
