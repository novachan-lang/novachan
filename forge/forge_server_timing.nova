// forge_server_timing -- the W3C Server-Timing response header: surface backend timing metrics (DB, cache,
// render, upstream) to the browser so they appear in Chrome/Firefox DevTools' Network → Timing pane, right
// next to the network waterfall. This is the standard, zero-instrumentation way to hand server-side perf data
// to a front-end developer or an RUM tool. Header value grammar: comma-separated metrics, each `name` with an
// optional `;dur=<ms>` and `;desc="<text>"`, e.g. `db;dur=53, cache;dur=1;desc="Cache Read"`.
//
// Durations are integer milliseconds (Server-Timing permits fractional ms, but integer ms keeps this sound and
// is what almost every server emits). LEAF -- imports NOTHING.

// A bare metric name (a marker with no duration): "missed-cache".
fn st_name(name: string) -> string
    name

// A metric with a duration in ms: "db;dur=53".
fn st_metric(name: string, dur_ms: int) -> string
    name + ";dur=" + str(dur_ms)

// A metric with a duration AND a human description (the desc is a quoted-string): `cache;dur=1;desc="Cache Read"`.
fn st_metric_desc(name: string, dur_ms: int, desc: string) -> string
    name + ";dur=" + str(dur_ms) + ";desc=" + chr(34) + desc + chr(34)

// Join a list of metric strings into the full Server-Timing header value (comma+space separated).
fn st_header(parts: list) -> string
    let out = ""
    let i = 0
    while i < len(parts)
        if i > 0
            out = out + ", "
        out = out + parts[i]
        i = i + 1
    out
