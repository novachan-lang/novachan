// forge_dinic -- Dinic's algorithm for maximum flow: level graphs + blocking flow.
// forge_maxflow already computes max flow via Edmonds-Karp (BFS shortest augmenting path, O(V*E^2)).
// Dinic's is a genuinely DIFFERENT and asymptotically FASTER algorithm (O(V^2 * E) general, O(E*sqrt(V))
// on unit-capacity / bipartite-matching graphs -- the standard choice in competitive programming and
// production flow solvers). Two nested ideas:
//   1. BFS from the source assigns each node a LEVEL (its BFS distance in the residual graph). This
//      partitions the graph into layers; we only ever push flow along edges going strictly one level
//      deeper (u->v with level[v] == level[u]+1). This "level graph" is a DAG.
//   2. On the level graph we find a BLOCKING FLOW via DFS: saturate augmenting paths until no more
//      source->sink path exists in the level graph. An "iterator" pointer per node skips already-dead
//      edges so each DFS is efficient (each edge is advanced past at most once per phase).
// Repeat (rebuild levels, find blocking flow) in PHASES. The number of phases is O(V), and each phase's
// blocking flow is O(V*E), giving the O(V^2*E) bound. On bipartite matching it's O(E*sqrt(V)) -- much
// faster than Edmonds-Karp -- which is why Dinic's is the algorithm of record for matching/flow.
//
// Node ids are 0..num_nodes-1 (integers). Edges are [from, to, capacity] with integer capacity >= 0.
// Internally we build an adjacency list of directed edges plus their paired reverse (residual) edges.
//
// API:
//   dinic_max_flow(num_nodes, edges, source, sink) -> int   maximum flow value
//   dinic_min_cut(num_nodes, edges, source, sink) -> list   [flow, source_side_nodes] (min-cut partition)
// LEAF (imports nothing).

// Build the internal graph: returns [head_list, edge_to, edge_cap, edge_next]
// We store edges in parallel arrays (forward-star). head[u] = index of first edge from u, or -1.
// Each edge i: to[i], cap[i], next[i]. Reverse edge of i is i^1 (i and i+1 are a pair).
fn _dn_build(num_nodes: int, edges: list) -> list
    let head = [-1 for i in 0..num_nodes]
    let e_to = []
    let e_cap = []
    let e_next = []
    for ei in 0..len(edges)
        let edge = edges[ei]
        let u = edge[0]
        let v = edge[1]
        let c = edge[2]
        // forward edge
        push(e_to, v)
        push(e_cap, c)
        push(e_next, head[u])
        head[u] = len(e_to) - 1
        // reverse (residual) edge, capacity 0
        push(e_to, u)
        push(e_cap, 0)
        push(e_next, head[v])
        head[v] = len(e_to) - 1
    return [head, e_to, e_cap, e_next]

// BFS to assign levels. Returns the level list (level[sink] < 0 means sink unreachable).
fn _dn_bfs(num_nodes: int, head: list, e_to: list, e_cap: list, e_next: list, source: int, sink: int) -> list
    let level = [-1 for i in 0..num_nodes]
    level[source] = 0
    let queue = []
    push(queue, source)
    let qi = 0
    while qi < len(queue)
        let u = queue[qi]
        qi += 1
        let eid = head[u]
        while eid != -1
            let v = e_to[eid]
            let c = e_cap[eid]
            if c > 0 and level[v] < 0
                level[v] = level[u] + 1
                push(queue, v)
            eid = e_next[eid]
    return level

// DFS to push blocking flow. Uses iter[] as per-node edge pointer (mutated in place).
// Returns the flow pushed from u to sink, up to `pushed` (the min residual so far).
fn _dn_dfs(u: int, sink: int, pushed: int, head: list, e_to: list, e_cap: list, e_next: list, level: list, iter: list) -> int
    if u == sink
        return pushed
    // Continue from where we left off for node u
    let eid = iter[u]
    while eid != -1
        iter[u] = eid
        let v = e_to[eid]
        let c = e_cap[eid]
        if c > 0 and level[v] == level[u] + 1
            let avail = c if c < pushed else pushed
            let d = _dn_dfs(v, sink, avail, head, e_to, e_cap, e_next, level, iter)
            if d > 0
                // augment: reduce forward cap, increase reverse cap (reverse edge = eid^1)
                e_cap[eid] -= d
                let rev = _dn_xor1(eid)
                e_cap[rev] += d
                return d
        eid = e_next[eid]
        iter[u] = eid
    return 0

// eid ^ 1 (toggle the low bit to get the paired reverse edge).
fn _dn_xor1(x: int) -> int
    return x ^ 1

// Maximum flow from source to sink using Dinic's algorithm.
fn dinic_max_flow(num_nodes: int, edges: list, source: int, sink: int) -> int
    if source == sink
        return 0
    let g = _dn_build(num_nodes, edges)
    let head = g[0]
    let e_to = g[1]
    let e_cap = g[2]
    let e_next = g[3]
    let total = 0
    let running = true
    while running
        let level = _dn_bfs(num_nodes, head, e_to, e_cap, e_next, source, sink)
        if level[sink] < 0
            running = false
        else
            // reset iterators to head for each node
            let iter = [head[i] for i in 0..num_nodes]
            let phase_flow = true
            while phase_flow
                let f = _dn_dfs(source, sink, 1000000000000, head, e_to, e_cap, e_next, level, iter)
                if f <= 0
                    phase_flow = false
                else
                    total += f
    return total

// Min-cut: run max flow, then BFS in the final residual graph from source.
// Returns [flow, list_of_source_side_nodes]. Edges from source-side to non-source-side (in the original
// graph) form the minimum cut, whose total capacity equals the max flow.
fn dinic_min_cut(num_nodes: int, edges: list, source: int, sink: int) -> list
    if source == sink
        return [0, [source]]
    let g = _dn_build(num_nodes, edges)
    let head = g[0]
    let e_to = g[1]
    let e_cap = g[2]
    let e_next = g[3]
    let total = 0
    let running = true
    while running
        let level = _dn_bfs(num_nodes, head, e_to, e_cap, e_next, source, sink)
        if level[sink] < 0
            running = false
        else
            let iter = [head[i] for i in 0..num_nodes]
            let phase_flow = true
            while phase_flow
                let f = _dn_dfs(source, sink, 1000000000000, head, e_to, e_cap, e_next, level, iter)
                if f <= 0
                    phase_flow = false
                else
                    total += f
    // BFS in residual from source to find source-side set
    let visited = [0 for j in 0..num_nodes]
    visited[source] = 1
    let queue = []
    push(queue, source)
    let qi = 0
    while qi < len(queue)
        let u = queue[qi]
        qi += 1
        let eid = head[u]
        while eid != -1
            let v = e_to[eid]
            let c = e_cap[eid]
            if c > 0 and visited[v] == 0
                visited[v] = 1
                push(queue, v)
            eid = e_next[eid]
    let source_side = [k for k in 0..num_nodes if visited[k] == 1]
    return [total, source_side]
