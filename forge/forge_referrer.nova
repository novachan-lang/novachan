// forge_referrer -- classify an HTTP Referer into a traffic-source CHANNEL (search / social / direct /
// referral), the attribution every analytics tool computes. Matches known search + social domains; an empty
// referer is direct; anything else is a referral. LEAF -- imports NOTHING.

fn _ref_any(s: string, needles: list) -> bool
    for i in 0..len(needles)
        if find(s, needles[i]) >= 0
            return true
    false

fn referrer_channel(referer: string) -> string
    if len(referer) == 0
        return "direct"
    let r = lower(referer)
    if _ref_any(r, ["google.", "bing.", "yahoo.", "duckduckgo.", "baidu.", "yandex.", "ecosia."])
        return "search"
    if _ref_any(r, ["facebook.", "twitter.", "t.co/", "linkedin.", "instagram.", "reddit.", "youtube.", "pinterest.", "tiktok."])
        return "social"
    "referral"

// The host (scheme + path stripped): "https://www.google.com/search?q=x" -> "www.google.com".
fn referrer_domain(referer: string) -> string
    let r = referer
    let scheme = find(r, "://")
    if scheme >= 0
        r = slice(r, scheme + 3, len(r))
    let slash = find(r, "/")
    if slash >= 0
        r = slice(r, 0, slash)
    r
