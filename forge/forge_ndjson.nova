// forge_ndjson -- Newline-Delimited JSON (NDJSON / JSON Lines), the streaming format behind Elasticsearch
// _bulk, log shipping (Filebeat/Fluentd/Vector), and chunked JSON API responses. One JSON value per line: a
// producer streams records without buffering the whole array in memory, and a consumer processes line-by-line
// as bytes arrive. Built on the json_stringify / json_decode builtins. LEAF -- imports NOTHING.

// Encode a list of values as an NDJSON document: each element json_stringify'd on its own line (trailing LF).
fn ndjson_encode(rows: list) -> string
    let nl = chr(10)
    let out_parts = []
    for i in 0..len(rows)
        push(out_parts, json_stringify(rows[i]) + nl)
    let out = join(out_parts, "")
    out

// Encode ONE row as a single NDJSON line (with trailing LF) -- for streaming a record the instant it's ready.
fn ndjson_line(row) -> string
    json_stringify(row) + chr(10)

// Decode an NDJSON document into a list of parsed values. Blank lines are skipped (lenient framing).
fn ndjson_decode(doc: string) -> list
    let out = []
    let lines = split(doc, chr(10))
    for i in 0..len(lines)
        let line = trim(lines[i])
        if len(line) > 0
            push(out, json_decode(line))
    out
