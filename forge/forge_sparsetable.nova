// forge_sparsetable -- thin wrapper over std/collections/sparsetable (canonical implementation).
import std/collections/sparsetable

// REPRESENTATION: a sparse table is a DICT -- _spt_build in std/collections/sparsetable.nova
// builds `let t = {}` with n/k/log/levels keys. These wrappers annotated it `list`, and a
// list-typed parameter makes the compiler lower the table's dict reads as LIST indexes, so
// sparse_query_min returned 0 instead of the range minimum. Same class as forge_deque: a
// wrapper left behind when the underlying std module changed representation.
fn sparse_build_min(arr: list) -> dict
    return sp_build_min(arr)

fn sparse_build_max(arr: list) -> dict
    return sp_build_max(arr)

fn sparse_query_min(table: dict, l: int, r: int) -> int
    return sp_query_min(table, l, r)

fn sparse_query_max(table: dict, l: int, r: int) -> int
    return sp_query_max(table, l, r)

