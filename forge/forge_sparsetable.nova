// forge_sparsetable -- thin wrapper over std/collections/sparsetable (canonical implementation).
import std/collections/sparsetable

fn sparse_build_min(arr: list) -> list
    return sp_build_min(arr)

fn sparse_build_max(arr: list) -> list
    return sp_build_max(arr)

fn sparse_query_min(table: list, l: int, r: int) -> int
    return sp_query_min(table, l, r)

fn sparse_query_max(table: list, l: int, r: int) -> int
    return sp_query_max(table, l, r)

