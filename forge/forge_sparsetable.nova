// forge_sparsetable -- the Sparse Table: answer range-minimum / range-maximum queries over a STATIC array in
// O(1) each, after an O(n log n) build. The trick exploits that min and max are IDEMPOTENT (overlapping ranges
// don't distort the answer: min(a,a)=a), so any range [l,r] can be covered by just TWO precomputed power-of-two
// blocks that overlap -- the largest block of length 2^k that fits, anchored at both ends. Precompute the min/max
// of every 2^k-length block starting at every position, then each query is a single comparison of two lookups.
// Use it when the data doesn't change and you need many fast range queries: static RMQ, sliding analytics over a
// fixed log, lowest-common-ancestor via Euler tour, offline range stats. (For a MUTABLE array use a segment tree,
// forge_segtree; for prefix SUMS use forge_fenwick -- sums aren't idempotent so this structure doesn't apply.)
// The build returns an opaque table you pass back to the query functions. LEAF -- imports NOTHING.

// PRIVATE: floor(log2(x)) for x >= 1.
fn _st_log2(x: int) -> int
    let k = 0
    while (1 << (k + 1)) <= x
        k += 1
    k

// PRIVATE: shared builder. mode 0 = min, 1 = max.
fn _st_build(arr: list, mode: int) -> list
    let n = len(arr)
    let table = []
    // level 0 = the array itself (blocks of length 1)
    let level0 = [arr[z] for z in 0..n]
    push(table, level0)
    let k = 1
    while (1 << k) <= n
        let prev = table[k - 1]
        let span = 1 << (k - 1)
        let cur = []
        let i = 0
        while i + (1 << k) <= n
            let a = prev[i]
            let b = prev[i + span]
            let pick = a
            if mode == 0
                if b < a
                    pick = b
            else
                if b > a
                    pick = b
            push(cur, pick)
            i += 1
        push(table, cur)
        k += 1
    table

// Build a min sparse table over arr. Pass the result to sparse_query_min.
fn sparse_build_min(arr: list) -> list
    _st_build(arr, 0)

// Build a max sparse table over arr. Pass the result to sparse_query_max.
fn sparse_build_max(arr: list) -> list
    _st_build(arr, 1)

// The minimum of arr[l..r] inclusive, in O(1), using a min table from sparse_build_min.
fn sparse_query_min(table: list, l: int, r: int) -> int
    let length = r - l + 1
    let k = _st_log2(length)
    let row = table[k]
    let left = row[l]
    let right = row[r - (1 << k) + 1]
    let out = left
    if right < left
        out = right
    out

// The maximum of arr[l..r] inclusive, in O(1), using a max table from sparse_build_max.
fn sparse_query_max(table: list, l: int, r: int) -> int
    let length = r - l + 1
    let k = _st_log2(length)
    let row = table[k]
    let left = row[l]
    let right = row[r - (1 << k) + 1]
    let out = left
    if right > left
        out = right
    out
