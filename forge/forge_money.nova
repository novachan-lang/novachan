// forge_money -- money handling: store amounts as INTEGER minor units (cents) to avoid float rounding bugs,
// format for display. money_format(1234, "$") -> "$12.34"; money_parse("$12.34") -> 1234. LEAF.

fn money_format(cents: int, symbol: string) -> string
    let neg = 0
    let c = cents
    if c < 0
        neg = 1
        c = 0 - c
    let dollars = c / 100
    let rem = c % 100
    let cs = str(rem)
    if rem < 10
        cs = "0" + cs
    let out = symbol + str(dollars) + "." + cs
    if neg == 1
        return "-" + out
    out

// Add two cent amounts (exact integer arithmetic, no float error).
fn money_add(a: int, b: int) -> int
    a + b

// A percentage of an amount, rounded to the nearest cent (e.g. tax). money_percent(1000, 825) = 8.25% of
// 1000 = 82 (825 basis points). Uses basis points (1/100 of a percent) for precision.
fn money_percent(cents: int, basis_points: int) -> int
    (cents * basis_points) / 10000
