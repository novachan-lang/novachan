// forge_response_transformer — Transform HTTP responses through a chain.

fn rt_new() -> dict
    {"transforms": {}, "count": 0, "applied": 0}

fn rt_add_header(r: dict, header_name: string, header_value: string) -> dict
    let k = str(r["count"])
    r["transforms"][k + "_type"] = "header"
    r["transforms"][k + "_name"] = header_name
    r["transforms"][k + "_value"] = header_value
    r["count"] += 1
    r

fn rt_add_replace(r: dict, find_str: string, replace_str: string) -> dict
    let k = str(r["count"])
    r["transforms"][k + "_type"] = "replace"
    r["transforms"][k + "_find"] = find_str
    r["transforms"][k + "_replace"] = replace_str
    r["count"] += 1
    r

fn rt_apply(r: dict, body: string) -> dict
    let result = {"body": body, "headers": {}}
    let header_count = 0
    for i in 0..r["count"]
        let k = str(i)
        let t = r["transforms"][k + "_type"]
        if t == "header"
            result["headers"][r["transforms"][k + "_name"]] = r["transforms"][k + "_value"]
            header_count += 1
        r["applied"] += 1
    result["header_count"] = header_count
    result["r"] = r
    result

fn rt_transform_count(r: dict) -> int
    r["count"]

fn rt_total_applied(r: dict) -> int
    r["applied"]
