// forge_stream_processor — Process streams of events with windowing.

fn sp_new(window_size: int) -> dict
    {"window_size": window_size, "values": {}, "value_count": 0, "processed": 0, "dropped": 0, "sum": 0}

fn sp_push(s: dict, value: int) -> dict
    let ws = s["window_size"]
    if s["value_count"] >= ws
        let oldest_k = str(s["value_count"] - ws)
        let oldest_v = s["values"][oldest_k]
        s["sum"] -= oldest_v
    s["values"][str(s["value_count"])] = value
    s["value_count"] += 1
    s["sum"] += value
    s["processed"] += 1
    s

fn sp_window_count(s: dict) -> int
    let ws = s["window_size"]
    let vc = s["value_count"]
    if vc < ws
        return vc
    ws

fn sp_window_sum(s: dict) -> int
    s["sum"]

fn sp_window_avg(s: dict) -> int
    let cnt = sp_window_count(s)
    if cnt == 0
        return 0
    s["sum"] / cnt

fn sp_total_processed(s: dict) -> int
    s["processed"]

fn sp_latest(s: dict) -> int
    if s["value_count"] == 0
        return 0
    s["values"][str(s["value_count"] - 1)]

fn sp_filter_push(s: dict, value: int, min_val: int) -> dict
    if value < min_val
        s["dropped"] += 1
        return s
    sp_push(s, value)

fn sp_drop_rate(s: dict) -> int
    let total = s["processed"] + s["dropped"]
    if total == 0
        return 0
    s["dropped"] * 100 / total
