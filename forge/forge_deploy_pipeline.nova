fn dpipe_new()
    let s = {}
    s["stage_count"] = 0
    s["stage_names"] = ""
    s["current_stage"] = -1
    s["status"] = "idle"
    s["deploy_count"] = 0
    s["fail_count"] = 0
    return s

fn dpipe_add_stage(s, stage_name)
    let idx = int(s["stage_count"])
    s["st_" + str(idx) + "_name"] = stage_name
    s["st_" + str(idx) + "_status"] = "pending"
    s["stage_count"] = idx + 1
    if s["stage_names"] == ""
        s["stage_names"] = stage_name
    else
        s["stage_names"] = str(s["stage_names"]) + "," + stage_name
    return s

fn dpipe_start(s) -> Result
    if str(s["status"]) == "running"
        return err("pipeline already running")
    if int(s["stage_count"]) == 0
        return err("no stages defined")
    s["current_stage"] = 0
    s["status"] = "running"
    let cnt = int(s["stage_count"])
    let i = 0
    while i < cnt
        s["st_" + str(i) + "_status"] = "pending"
        i = i + 1
    s["st_0_status"] = "running"
    return ok(s)

fn dpipe_complete_stage(s) -> Result
    if str(s["status"]) != "running"
        return err("pipeline not running")
    let cur = int(s["current_stage"])
    s["st_" + str(cur) + "_status"] = "passed"
    let next = cur + 1
    if next >= int(s["stage_count"])
        s["status"] = "success"
        s["current_stage"] = -1
        s["deploy_count"] = int(s["deploy_count"]) + 1
        return ok(s)
    s["current_stage"] = next
    s["st_" + str(next) + "_status"] = "running"
    return ok(s)

fn dpipe_fail_stage(s, reason) -> Result
    if str(s["status"]) != "running"
        return err("pipeline not running")
    let cur = int(s["current_stage"])
    s["st_" + str(cur) + "_status"] = "failed"
    s["status"] = "failed"
    s["last_fail_reason"] = reason
    s["fail_count"] = int(s["fail_count"]) + 1
    return ok(s)

fn dpipe_status(s)
    return str(s["status"])

fn dpipe_current_stage(s) -> Result
    let cur = int(s["current_stage"])
    if cur < 0
        return err("no active stage")
    return ok(str(s["st_" + str(cur) + "_name"]))

fn dpipe_stage_status(s, stage_name) -> Result
    let cnt = int(s["stage_count"])
    let i = 0
    while i < cnt
        if str(s["st_" + str(i) + "_name"]) == stage_name
            return ok(str(s["st_" + str(i) + "_status"]))
        i = i + 1
    return err("stage not found: " + stage_name)

fn dpipe_stage_count(s)
    return int(s["stage_count"])

fn dpipe_deploy_count(s)
    return int(s["deploy_count"])

fn dpipe_fail_count(s)
    return int(s["fail_count"])

fn dpipe_stage_names(s)
    return str(s["stage_names"])
