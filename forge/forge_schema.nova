// forge_schema -- declarative validation SCHEMA (JSON Schema / Pydantic / Zod / Bean Validation @Valid).
// Validate a data dict against {field: [[validator_fn, message], ...]}, collecting the FIRST error per
// field. A validator is fn(value: string) -> bool (compose forge_validators). Returns {valid, errors}.
// LEAF -- imports NOTHING (validators are passed in as fn values).

// schema[field] = list of [validator_fn, message] pairs. Missing field -> value "" (so v_required catches it).
fn schema_validate(schema: dict, data: dict) -> dict
    let errors = {}
    for field in keys(schema)
        let rules = schema[field]
        let value = ""
        if contains(data, field)
            value = data[field]
        let i = 0
        let failed = 0
        while i < len(rules) and failed == 0
            let rule = rules[i]
            let v = rule[0]
            if v(value) == false
                errors[field] = rule[1]
                failed = 1
            i = i + 1
    let out = {}
    out["valid"] = len(keys(errors)) == 0
    out["errors"] = errors
    out
