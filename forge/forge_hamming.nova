// forge_hamming -- Hamming distance: how many positions differ between two EQUAL-LENGTH strings (or the bits of
// two integers). It's the natural "how many single changes apart" measure, and the foundation of error-detecting
// and error-correcting codes: a code whose codewords are all at least distance d apart can DETECT up to d-1 bit
// errors and CORRECT up to (d-1)/2. Beyond coding theory it's used for DNA/protein sequence difference (mutation
// count between equal-length reads), comparing hashes/fingerprints (forge_simhash near-duplicates rank by
// Hamming distance), and spotting how many fields changed between two fixed-format records. min_distance over a
// set of codewords tells you a code's error-handling power. Unlike edit distance (forge_editops), positions are
// compared directly -- no insertions or deletions. LEAF -- imports NOTHING.

// The Hamming distance between two equal-length strings (number of differing character positions), or -1 if the
// lengths differ.
fn hamming_distance(a: string, b: string) -> int
    let out = 0 - 1
    if len(a) == len(b)
        let d = 0
        let i = 0
        while i < len(a)
            if char_at(a, i) != char_at(b, i)
                d = d + 1
            i = i + 1
        out = d
    out

// The Hamming distance between two integers = the number of differing bits (popcount of a XOR b).
fn hamming_int(a: int, b: int) -> int
    let x = a ^ b
    let count = 0
    let v = x
    while v > 0
        count = count + (v & 1)
        v = v / 2
    count

// The MINIMUM pairwise Hamming distance over a list of equal-length codewords (strings). This is the code's
// minimum distance: it can detect (min-1) and correct (min-1)/2 symbol errors. Returns -1 for fewer than 2
// codewords or mismatched lengths.
fn min_distance(codewords: list) -> int
    let n = len(codewords)
    let out = 0 - 1
    if n >= 2
        let best = 0 - 1
        let i = 0
        while i < n
            let j = i + 1
            while j < n
                let d = hamming_distance(codewords[i], codewords[j])
                if d >= 0
                    if best < 0 or d < best
                        best = d
                j = j + 1
            i = i + 1
        out = best
    out
