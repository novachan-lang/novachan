// forge_lease_renewal — time-based lease management with renewal tracking and Result API.

fn lr_new() -> dict
    let l = {}
    l["lease_count"] = 0
    l["renewals"] = 0
    l["expirations"] = 0
    l

fn lr_acquire(l: dict, resource: string, ttl: int) -> dict
    l["l_" + resource + "_ttl"] = ttl
    l["l_" + resource + "_remaining"] = ttl
    l["l_" + resource + "_active"] = 1
    l["lease_count"] = l["lease_count"] + 1
    l

fn lr_renew(l: dict, resource: string) -> Result
    let ak = "l_" + resource + "_active"
    if contains(l, ak) != true
        return err("lease not found: " + resource)
    if l[ak] != 1
        return err("lease expired: " + resource)
    l["l_" + resource + "_remaining"] = l["l_" + resource + "_ttl"]
    l["renewals"] = l["renewals"] + 1
    ok(l)

fn lr_tick(l: dict, resource: string, elapsed: int) -> Result
    let ak = "l_" + resource + "_active"
    if contains(l, ak) != true
        return err("lease not found: " + resource)
    if l[ak] != 1
        return err("lease already expired")
    let remaining = l["l_" + resource + "_remaining"] - elapsed
    if remaining <= 0
        l["l_" + resource + "_remaining"] = 0
        l[ak] = 0
        l["expirations"] = l["expirations"] + 1
    else
        l["l_" + resource + "_remaining"] = remaining
    ok(l)

fn lr_remaining(l: dict, resource: string) -> Result
    let rk = "l_" + resource + "_remaining"
    if contains(l, rk) != true
        return err("lease not found: " + resource)
    ok(l[rk])

fn lr_is_active(l: dict, resource: string) -> int
    let ak = "l_" + resource + "_active"
    if contains(l, ak) == true
        return l[ak]
    0

fn lr_lease_count(l: dict) -> int
    l["lease_count"]

fn lr_renewal_count(l: dict) -> int
    l["renewals"]

fn lr_expiration_count(l: dict) -> int
    l["expirations"]
