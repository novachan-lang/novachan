// forge_ssn -- US Social Security Number validation + PII masking. Validates the structural rules (area not
// 000/666/900-999, group not 00, serial not 0000) and masks for display ("***-**-1234"). NEVER log or return a
// full SSN -- store it hashed, show it masked. LEAF -- imports NOTHING.

fn _ssn_digits(s: string) -> string
    let out_parts = []
    for i in 0..len(s)
        let c = char_at(s, i)
        if find("0123456789", c) >= 0
            push(out_parts, c)
    let out = join(out_parts, "")
    out

// Valid US SSN? 9 digits meeting the SSA structural exclusions.
fn ssn_valid(ssn: string) -> bool
    let d = _ssn_digits(ssn)
    if len(d) != 9
        return false
    let area = parse_int(slice(d, 0, 3))
    let group = parse_int(slice(d, 3, 5))
    let serial = parse_int(slice(d, 5, 9))
    if area == 0 or area == 666 or area >= 900
        return false
    if group == 0
        return false
    if serial == 0
        return false
    true

// Mask for display: "***-**-1234" (only the last 4 shown). Malformed -> "***-**-****".
fn ssn_mask(ssn: string) -> string
    let d = _ssn_digits(ssn)
    if len(d) != 9
        return "***-**-****"
    "***-**-" + slice(d, 5, 9)

// Format bare digits as "123-45-6789".
fn ssn_format(ssn: string) -> string
    let d = _ssn_digits(ssn)
    if len(d) != 9
        return d
    slice(d, 0, 3) + "-" + slice(d, 3, 5) + "-" + slice(d, 5, 9)
