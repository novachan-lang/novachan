// forge_base36 -- base36 encode/decode of non-negative integers (0-9 a-z = 36 symbols): compact AND
// case-insensitive ids (Reddit post/comment ids, short codes, human-transcribable references). More compact
// than decimal; case-insensitive unlike base62. Completes the radix family (base32/36/58/62/64). LEAF.

fn _b36_alpha() -> string
    "0123456789abcdefghijklmnopqrstuvwxyz"

fn base36_encode(n: int) -> string
    if n <= 0
        return "0"
    let alpha = _b36_alpha()
    let v = n
    let out = ""
    while v > 0
        out = char_at(alpha, v % 36) + out
        v = v / 36
    out

// Decode (case-insensitive); 0 if any char is outside the alphabet.
fn base36_decode(s: string) -> int
    let alpha = _b36_alpha()
    let v = 0
    let i = 0
    while i < len(s)
        let d = find(alpha, lower(char_at(s, i)))
        if d < 0
            return 0
        v = v * 36 + d
        i = i + 1
    v
