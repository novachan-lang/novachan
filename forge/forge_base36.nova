// forge_base36 -- base36 encode/decode of non-negative integers (0-9 a-z = 36 symbols): compact AND
// case-insensitive ids (Reddit post/comment ids, short codes, human-transcribable references). More compact
// than decimal; case-insensitive unlike base62.
//
// The radix conversion itself now lives ONCE in forge_radix, shared with base58 and base62. This module is
// its alphabet, its case folding, and three thin entry points.
import forge_radix

fn _b36_alpha() -> string
    "0123456789abcdefghijklmnopqrstuvwxyz"

fn base36_encode(n: int) -> string
    radix_encode(n, _b36_alpha(), "0")

// Decode (case-insensitive); 0 if any char is outside the alphabet.
// The case-insensitivity is the `lower` FOLD passed to radix_decode -- the one thing that genuinely
// differs from base58/base62, expressed as a closure rather than as a forked copy of the loop.
fn base36_decode(s: string) -> int
    unwrap_or(radix_decode(s, _b36_alpha(), (c) => lower(c)), 0)

// Decode KEEPING the reason: ok(n), or err naming the offending character and its index.
fn base36_decode_checked(s: string) -> Result
    radix_decode(s, _b36_alpha(), (c) => lower(c))
