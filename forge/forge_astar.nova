// forge_astar -- A* pathfinding on a grid: find the shortest walkable route from a start cell to a goal cell
// around obstacles. This is the algorithm game engines, robots, and map/navigation systems use to move a unit
// through a level, route around walls, or plan a path on a tile map. Where forge_dijkstra explores in every
// direction equally, A* is guided by a heuristic (here Manhattan distance) toward the goal, so it reaches it
// much faster on point-to-point queries while still returning an optimal path. The grid is a list of rows of
// cells: 0 = open, non-zero = blocked. Movement is 4-directional (up/down/left/right), each step costs 1.
// Returns the path as a list of [row, col] cells (start..goal inclusive), or an empty list if unreachable.
// LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Six problems:
//
//   1. _as_abs was a 4-line hand-rolled absolute value. `abs` is that.
//   2. _as_key used `str(r) + "," + str(c)` -- interpolation.
//   3. _as_parse manually parsed digits char by char (12 lines). `int(parts[0])` is that.
//   4. `0 - 1` was used for -1 at SEVEN sites -- unary negation is fixed.
//   5. `found == false` -- `not found`.
//   6. The traceback used a `walking` boolean flag to control the loop -- `loop` + `break`.

// PRIVATE: "r,c" cell key.
fn _as_key(r: int, c: int) -> string
    "{r},{c}"

// PRIVATE: parse a "r,c" key back into [r, c].
fn _as_parse(k: string) -> list
    let parts = split(k, ",")
    [int(parts[0]), int(parts[1])]

fn astar_grid(grid: list, start: list, goal: list) -> list
    let rows = len(grid)
    let cols = len(grid[0])
    let gr = goal[0]
    let gc = goal[1]
    let sk = _as_key(start[0], start[1])
    let gk = _as_key(gr, gc)
    let gscore = {}
    gscore[sk] = 0
    let came = {}
    let open_r = [start[0]]
    let open_c = [start[1]]
    let found = false
    // STAYS a while: each iteration picks the best open cell by f-score, data-dependent.
    while len(open_r) > 0 and not found
        let best = 0
        let bestf = gscore[_as_key(open_r[0], open_c[0])] + abs(open_r[0] - gr) + abs(open_c[0] - gc)
        for i in 1..len(open_r)
            let k = _as_key(open_r[i], open_c[i])
            let f = gscore[k] + abs(open_r[i] - gr) + abs(open_c[i] - gc)
            if f < bestf
                bestf = f
                best = i
        let cr = open_r[best]
        let cc = open_c[best]
        let ck = _as_key(cr, cc)
        let last = len(open_r) - 1
        open_r[best] = open_r[last]
        open_c[best] = open_c[last]
        pop(open_r)
        pop(open_c)
        if ck == gk
            found = true
        else
            let cg = gscore[ck]
            let dr = [-1, 1, 0, 0]
            let dc = [0, 0, -1, 1]
            for d in 0..4
                let nr = cr + dr[d]
                let nc = cc + dc[d]
                if nr >= 0 and nr < rows and nc >= 0 and nc < cols
                    if grid[nr][nc] == 0
                        let nk = _as_key(nr, nc)
                        let tentative = cg + 1
                        let known = get(gscore, nk, -1)
                        if known < 0 or tentative < known
                            gscore[nk] = tentative
                            came[nk] = ck
                            push(open_r, nr)
                            push(open_c, nc)
    if not found
        return []
    let rev = []
    let ck = gk
    loop
        push(rev, _as_parse(ck))
        if ck == sk
            break
        ck = str(get(came, ck, ""))
        if ck == ""
            break
    reverse(rev)

fn astar_distance(grid: list, start: list, goal: list) -> int
    let p = astar_grid(grid, start, goal)
    len(p) - 1 if len(p) > 0 else -1
