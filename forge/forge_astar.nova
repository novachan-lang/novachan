// forge_astar -- A* pathfinding on a grid: find the shortest walkable route from a start cell to a goal cell
// around obstacles. This is the algorithm game engines, robots, and map/navigation systems use to move a unit
// through a level, route around walls, or plan a path on a tile map. Where forge_dijkstra explores in every
// direction equally, A* is guided by a heuristic (here Manhattan distance) toward the goal, so it reaches it
// much faster on point-to-point queries while still returning an optimal path. The grid is a list of rows of
// cells: 0 = open, non-zero = blocked. Movement is 4-directional (up/down/left/right), each step costs 1.
// Returns the path as a list of [row, col] cells (start..goal inclusive), or an empty list if unreachable.
// LEAF -- imports NOTHING.

// PRIVATE.
fn _as_abs(x: int) -> int
    let v = x
    if x < 0
        v = 0 - x
    v

// PRIVATE: "r,c" cell key.
fn _as_key(r: int, c: int) -> string
    str(r) + "," + str(c)

// PRIVATE: parse a "r,c" key back into [r, c].
fn _as_parse(k: string) -> list
    let parts = split(k, ",")
    let r = 0
    let ri = 0
    let s0 = parts[0]
    while ri < len(s0)
        r = r * 10 + (ord(char_at(s0, ri)) - 48)
        ri += 1
    let c = 0
    let ci = 0
    let s1 = parts[1]
    while ci < len(s1)
        c = c * 10 + (ord(char_at(s1, ci)) - 48)
        ci += 1
    [r, c]

// Find the shortest 4-directional path from start [r,c] to goal [r,c] on `grid` (0=open, else blocked).
// Returns [[r,c], ...] start..goal, or [] if there is no path.
fn astar_grid(grid: list, start: list, goal: list) -> list
    let rows = len(grid)
    let cols = len(grid[0])
    let gr = goal[0]
    let gc = goal[1]
    let sk = _as_key(start[0], start[1])
    let gk = _as_key(gr, gc)
    let gscore = {}
    gscore[sk] = 0
    let came = {}
    // open set as PARALLEL scalar arrays (no list-of-lists to corrupt on removal)
    let open_r = []
    let open_c = []
    push(open_r, start[0])
    push(open_c, start[1])
    let found = false
    while len(open_r) > 0 and found == false
        // pick the open cell with the lowest f = g + heuristic
        let best = 0
        let bestf = gscore[_as_key(open_r[0], open_c[0])] + _as_abs(open_r[0] - gr) + _as_abs(open_c[0] - gc)
        for i in 1..len(open_r)
            let k = _as_key(open_r[i], open_c[i])
            let f = gscore[k] + _as_abs(open_r[i] - gr) + _as_abs(open_c[i] - gc)
            if f < bestf
                bestf = f
                best = i
        let cr = open_r[best]
        let cc = open_c[best]
        let ck = _as_key(cr, cc)
        // remove `best` from the open set (swap with last + pop -- scalar, safe)
        let last = len(open_r) - 1
        open_r[best] = open_r[last]
        open_c[best] = open_c[last]
        pop(open_r)
        pop(open_c)
        if ck == gk
            found = true
        else
            let cg = gscore[ck]
            // 4 neighbors
            let dr = [0 - 1, 1, 0, 0]
            let dc = [0, 0, 0 - 1, 1]
            for d in 0..4
                let nr = cr + dr[d]
                let nc = cc + dc[d]
                if nr >= 0 and nr < rows and nc >= 0 and nc < cols
                    if grid[nr][nc] == 0
                        let nk = _as_key(nr, nc)
                        let tentative = cg + 1
                        let known = get(gscore, nk, 0 - 1)
                        if known < 0 or tentative < known
                            gscore[nk] = tentative
                            came[nk] = ck
                            push(open_r, nr)
                            push(open_c, nc)
    // reconstruct
    let path = []
    if found
        let rev = []
        let ck = gk
        let walking = true
        while walking
            push(rev, ck)
            if ck == sk
                walking = false
            else
                ck = get(came, ck, "")
                if ck == ""
                    walking = false
        // rev is goal..start; reverse into [r,c] pairs start..goal
        let j = len(rev) - 1
        while j >= 0
            push(path, _as_parse(rev[j]))
            j -= 1
    path

// The length (number of steps) of the shortest path, or -1 if unreachable. A convenience over astar_grid.
fn astar_distance(grid: list, start: list, goal: list) -> int
    let p = astar_grid(grid, start, goal)
    let out = 0 - 1
    if len(p) > 0
        out = len(p) - 1
    out
