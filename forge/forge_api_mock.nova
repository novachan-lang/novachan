// forge_api_mock -- API mock server for testing: define mock endpoints with fixed responses, record
// every call, verify expectations. Pure state -- composes with any HTTP handler. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. mock_new / mock_add built dicts as individual assignments. Dict literals.
//   2. mock_handle had TWO NESTED `if`s for method+path match -- one compound `and`. And the call
//      record was built identically on both paths -- hoisted.
//   3. mock_call_count used a while-index loop for a linear search -- for-in.
//   4. mock_verify_called used `if count > 0: return 1; 0` -- ternary.
//   5. mock_reset_counts used a while-index loop to zero counters -- for-in range.

fn mock_new() -> dict
    {"endpoints": [], "calls": []}

fn mock_add(m: dict, method: string, path: string, status: int, body: string) -> dict
    push(m["endpoints"], {"method": method, "path": path, "status": status, "body": body, "call_count": 0})
    m

fn mock_handle(m: dict, method: string, path: string) -> dict
    let call = {"method": method, "path": path}
    for i in 0..len(m["endpoints"])
        let ep = m["endpoints"][i]
        if str(ep["method"]) == method and str(ep["path"]) == path
            m["endpoints"][i]["call_count"] += 1
            push(m["calls"], call)
            return {"status": ep["status"], "body": ep["body"], "matched": 1}
    push(m["calls"], call)
    {"status": 404, "body": "not found", "matched": 0}

fn mock_call_count(m: dict, method: string, path: string) -> int
    for ep in m["endpoints"]
        if str(ep["method"]) == method and str(ep["path"]) == path
            return ep["call_count"]
    0

fn mock_total_calls(m: dict) -> int
    len(m["calls"])

fn mock_verify_called(m: dict, method: string, path: string) -> int
    1 if mock_call_count(m, method, path) > 0 else 0

fn mock_endpoint_count(m: dict) -> int
    len(m["endpoints"])

fn mock_reset_counts(m: dict) -> dict
    for i in 0..len(m["endpoints"])
        m["endpoints"][i]["call_count"] = 0
    m["calls"] = []
    m
