// forge_api_mock — API mock server for testing.
// Define mock endpoints, record calls, verify expectations.

fn mock_new() -> dict
    let m = {}
    m["endpoints"] = []
    m["calls"] = []
    m

fn mock_add(m: dict, method: string, path: string, status: int, body: string) -> dict
    let ep = {}
    ep["method"] = method
    ep["path"] = path
    ep["status"] = status
    ep["body"] = body
    ep["call_count"] = 0
    push(m["endpoints"], ep)
    m

fn mock_handle(m: dict, method: string, path: string) -> dict
    let result = {}
    let i = 0
    while i < len(m["endpoints"])
        let ep = m["endpoints"][i]
        if ep["method"] == method
            if ep["path"] == path
                result["status"] = ep["status"]
                result["body"] = ep["body"]
                result["matched"] = 1
                m["endpoints"][i]["call_count"] = m["endpoints"][i]["call_count"] + 1
                let call = {}
                call["method"] = method
                call["path"] = path
                push(m["calls"], call)
                return result
        i += 1
    result["status"] = 404
    result["body"] = "not found"
    result["matched"] = 0
    let call = {}
    call["method"] = method
    call["path"] = path
    push(m["calls"], call)
    result

fn mock_call_count(m: dict, method: string, path: string) -> int
    let i = 0
    while i < len(m["endpoints"])
        let ep = m["endpoints"][i]
        if ep["method"] == method
            if ep["path"] == path
                return ep["call_count"]
        i += 1
    0

fn mock_total_calls(m: dict) -> int
    len(m["calls"])

fn mock_verify_called(m: dict, method: string, path: string) -> int
    let count = mock_call_count(m, method, path)
    if count > 0
        return 1
    0

fn mock_endpoint_count(m: dict) -> int
    len(m["endpoints"])

fn mock_reset_counts(m: dict) -> dict
    let i = 0
    while i < len(m["endpoints"])
        m["endpoints"][i]["call_count"] = 0
        i += 1
    m["calls"] = []
    m
