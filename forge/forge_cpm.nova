// forge_cpm -- the Critical Path Method for project scheduling. Given tasks, each with a DURATION, and
// dependencies (task X must finish before task Y starts), it computes the earliest each task can finish and the
// shortest possible time to complete the whole project -- the length of the CRITICAL PATH (the chain of
// dependent tasks with no slack; delaying any of them delays the whole project). This is core project management
// (PERT/CPM, Gantt charts), and the same math answers build/pipeline duration ("how long is the longest
// dependency chain of compile steps?"), assembly-line and workflow planning, and any "when can this finish given
// what it waits on". Tasks and durations are given as a dict task -> duration; dependencies as [before, after]
// edges with string task ids and non-negative integer durations. LEAF -- imports NOTHING.

// PRIVATE: all task ids (from durations and edges).
fn _cpm_tasks(edges: list, durations: dict) -> list
    let seen = {}
    let tasks = []
    let dk = keys(durations)
    let i = 0
    while i < len(dk)
        seen[dk[i]] = 1
        push(tasks, dk[i])
        i = i + 1
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        if contains(seen, u) == false
            seen[u] = 1
            push(tasks, u)
        let v = edges[e][1]
        if contains(seen, v) == false
            seen[v] = 1
            push(tasks, v)
        e = e + 1
    tasks

// The earliest finish time of every task as a dict task -> time (respecting dependencies). Returns an empty dict
// if the dependency graph has a cycle (no valid schedule).
fn earliest_finish(edges: list, durations: dict) -> dict
    let tasks = _cpm_tasks(edges, durations)
    let adj = {}
    let indeg = {}
    let es = {}
    let i = 0
    while i < len(tasks)
        adj[tasks[i]] = []
        indeg[tasks[i]] = 0
        es[tasks[i]] = 0
        i = i + 1
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        push(adj[u], v)
        indeg[v] = indeg[v] + 1
        e = e + 1
    // Kahn's topological order, propagating earliest-start forward
    let ef = {}
    let queue = []
    let t = 0
    while t < len(tasks)
        if indeg[tasks[t]] == 0
            push(queue, tasks[t])
        t = t + 1
    let qi = 0
    let processed = 0
    while qi < len(queue)
        let task = queue[qi]
        qi = qi + 1
        processed = processed + 1
        let finish = es[task] + get(durations, task, 0)
        ef[task] = finish
        let succ = adj[task]
        let j = 0
        while j < len(succ)
            let s = succ[j]
            if finish > es[s]
                es[s] = finish
            indeg[s] = indeg[s] - 1
            if indeg[s] == 0
                push(queue, s)
            j = j + 1
    // if not all tasks were processed, there was a cycle
    let out = ef
    if processed < len(tasks)
        out = {}
    out

// The critical-path length = the minimum time to finish the whole project = the largest earliest-finish time.
// Returns -1 if the dependencies contain a cycle.
fn critical_path_length(edges: list, durations: dict) -> int
    let ef = earliest_finish(edges, durations)
    let ks = keys(ef)
    let out = 0 - 1
    if len(ks) > 0
        let maxf = 0
        let i = 0
        while i < len(ks)
            if ef[ks[i]] > maxf
                maxf = ef[ks[i]]
            i = i + 1
        out = maxf
    else
        // empty ef means either no tasks or a cycle
        if len(_cpm_tasks(edges, durations)) == 0
            out = 0
    out
