// forge_intervaltree -- an AUGMENTED interval tree for answering "which stored intervals overlap this query?" and
// "which contain this point?" quickly. Given a fixed set of ranges [start, end], it builds a balanced binary tree
// keyed on start where every node also records the MAXIMUM end anywhere in its subtree; that one extra number lets
// a query PRUNE whole branches that can't possibly reach the query, so a stabbing/overlap search runs in
// O(log n + k) for k hits instead of scanning every interval. This is the structure behind calendar/meeting
// conflict detection ("what's booked during this slot?"), IP or port range lookups in firewalls/routers, genomic
// feature queries ("which genes cover this position?"), and rule engines that match a value against many ranges.
// It complements forge_interval (which merges/intersects a couple of intervals) by indexing a whole COLLECTION for
// repeated queries. Intervals are inclusive [start, end] integer pairs. LEAF -- imports NOTHING.

// PRIVATE: build a balanced subtree from sorted[lo..hi] (sorted by start); appends to the node pools, returns id.
fn _it_build(sorted: list, lo: int, hi: int, st: list, en: list, lc: list, rc: list, mx: list) -> int
    let out = 0 - 1
    if lo <= hi
        let mid = (lo + hi) / 2
        let node = len(st)
        push(st, sorted[mid][0])
        push(en, sorted[mid][1])
        push(lc, 0 - 1)
        push(rc, 0 - 1)
        push(mx, sorted[mid][1])
        let l = _it_build(sorted, lo, mid - 1, st, en, lc, rc, mx)
        let r = _it_build(sorted, mid + 1, hi, st, en, lc, rc, mx)
        lc[node] = l
        rc[node] = r
        let m = en[node]
        if l != 0 - 1 and mx[l] > m
            m = mx[l]
        if r != 0 - 1 and mx[r] > m
            m = mx[r]
        mx[node] = m
        out = node
    out

// Build an interval tree over `intervals` (list of [start, end]). Returns an opaque pack.
fn itree_build(intervals: list) -> list
    let n = len(intervals)
    // sort indices by start (int index array -> safe), then a start-ordered copy
    let idx = []
    let i = 0
    while i < n
        push(idx, i)
        i += 1
    let a = 1
    while a < n
        let key = idx[a]
        let b = a - 1
        while b >= 0 and intervals[idx[b]][0] > intervals[key][0]
            idx[b + 1] = idx[b]
            b -= 1
        idx[b + 1] = key
        a += 1
    let sorted = [intervals[idx[k]] for k in 0..n]
    let st = []
    let en = []
    let lc = []
    let rc = []
    let mx = []
    let root = _it_build(sorted, 0, n - 1, st, en, lc, rc, mx)
    [root, st, en, lc, rc, mx]

// PRIVATE: collect intervals overlapping [qs, qe] into `result`.
fn _it_query(node: int, qs: int, qe: int, st: list, en: list, lc: list, rc: list, mx: list, result: list)
    if node != 0 - 1
        if mx[node] >= qs
            _it_query(lc[node], qs, qe, st, en, lc, rc, mx, result)
            if st[node] <= qe and en[node] >= qs
                push(result, [st[node], en[node]])
            if st[node] <= qe
                _it_query(rc[node], qs, qe, st, en, lc, rc, mx, result)

// All stored intervals that overlap the inclusive query range [qs, qe], as a list of [start, end] pairs.
fn itree_overlap(pack: list, qs: int, qe: int) -> list
    let result = []
    _it_query(pack[0], qs, qe, pack[1], pack[2], pack[3], pack[4], pack[5], result)
    result

// All stored intervals that contain the point p (i.e. start <= p <= end).
fn itree_stab(pack: list, p: int) -> list
    itree_overlap(pack, p, p)
