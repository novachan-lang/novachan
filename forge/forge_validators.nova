// forge_validators -- composable field validators (JSR-380 / Django validators), each PURE returning
// true=valid; compose them in a route/form and map false -> an error message.
//
// "Verified by reasoning": v_email("a@b.com") true, v_email("ab.com") false;
// v_int_range("30","18","65") true; v_one_of("red",["red","blue"]) true.
//
// LEAF module -- imports NOTHING. Built-ins: len, find, slice, char_at, parse_int, lower.

// ── private helpers ──────────────────────────────────────────────────────────────────────────────

// _v_is_digits_only: true iff s is non-empty and every char is 0-9 (no sign).
// Used internally by v_digits and the int validators (sign stripped first).
fn _v_is_digits_only(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let i = 0
    while i < n
        let c = s[i]
        if find("0123456789", c) < 0
            return false
        i = i + 1
    true

// _v_count_char: count occurrences of single-char needle `c` in `s`.
// Used by v_email to verify exactly one '@'.
fn _v_count_char(s: string, c: string) -> int
    let n = len(s)
    let count = 0
    let i = 0
    while i < n
        if s[i] == c
            count = count + 1
        i = i + 1
    count

// ── length validators ─────────────────────────────────────────────────────────────────────────────

// v_required: true iff s is non-empty.  @NotBlank/@NotEmpty equivalent.
fn v_required(s: string) -> bool
    len(s) > 0

// v_min_len: true iff len(s) >= n.  @Size(min=n) equivalent.
fn v_min_len(s: string, n: int) -> bool
    len(s) >= n

// v_max_len: true iff len(s) <= n.  @Size(max=n) equivalent.
fn v_max_len(s: string, n: int) -> bool
    len(s) <= n

// v_length_between: true iff lo <= len(s) <= hi.  @Size(min=lo, max=hi) equivalent.
fn v_length_between(s: string, lo: int, hi: int) -> bool
    let n = len(s)
    n >= lo and n <= hi

// ── integer string validators ─────────────────────────────────────────────────────────────────────

// v_is_int: true iff s is a valid integer string: optional leading '-' then one or more digits.
// Non-empty required. Leading zeros permitted (matches Bean Validation / Django IntegerField).
fn v_is_int(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let digits = s
    if s[0] == "-"
        if n == 1
            return false
        digits = slice(s, 1, n)
    _v_is_digits_only(digits)

// v_int_min: true iff s is a valid int string AND parse_int(s) >= n.  @Min(n) equivalent.
fn v_int_min(s: string, n: int) -> bool
    if not v_is_int(s)
        return false
    parse_int(s) >= n

// v_int_max: true iff s is a valid int string AND parse_int(s) <= n.  @Max(n) equivalent.
fn v_int_max(s: string, n: int) -> bool
    if not v_is_int(s)
        return false
    parse_int(s) <= n

// v_int_range: true iff s is a valid int string AND lo <= parse_int(s) <= hi.
// @Range(min=lo, max=hi) equivalent.  v_int_range("30", 18, 65) -> true.
fn v_int_range(s: string, lo: int, hi: int) -> bool
    if not v_is_int(s)
        return false
    let v = parse_int(s)
    v >= lo and v <= hi

// ── character class validators ────────────────────────────────────────────────────────────────────

// v_digits: non-empty, all 0-9, no sign.  Suitable for zip codes, phone digit strings.
// @Digits / Django's validate_integer without sign equivalent.
fn v_digits(s: string) -> bool
    _v_is_digits_only(s)

// v_alnum: non-empty, every char is a-z A-Z 0-9.
// @Pattern(regexp="[a-zA-Z0-9]+") equivalent.
fn v_alnum(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    let i = 0
    while i < n
        if find(alpha, s[i]) < 0
            return false
        i = i + 1
    true

// v_matches_charset: every char of s is in `allowed`; s must be non-empty.
// Generic charset validator — compose to build slug, hex, base64-URL, etc. validators.
fn v_matches_charset(s: string, allowed: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let i = 0
    while i < n
        if find(allowed, s[i]) < 0
            return false
        i = i + 1
    true

// ── email / URL validators ────────────────────────────────────────────────────────────────────────

// v_email: pragmatic email shape check (not full RFC 5321 — full RFC needs a recursive parser).
// Rules: exactly one '@'; at least one char before '@' (non-empty local part);
// a '.' after the '@' position; at least one char between '@' and '.'; at least one char after '.'.
// v_email("a@b.com") -> true, v_email("ab.com") -> false, v_email("a@b") -> false.
fn v_email(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    if _v_count_char(s, "@") != 1
        return false
    let at = find(s, "@")
    if at <= 0
        return false
    let domain = slice(s, at + 1, n)
    let dot = find(domain, ".")
    if dot < 1
        return false
    if dot >= len(domain) - 1
        return false
    true

// v_url: starts with "http://" or "https://" and has a non-empty host after the scheme.
// @URL equivalent.  v_url("https://x.com") -> true, v_url("ftp://x.com") -> false.
fn v_url(s: string) -> bool
    let n = len(s)
    let http = "http://"
    let https = "https://"
    let lh = len(http)
    let lhs = len(https)
    if n > lhs
        if slice(s, 0, lhs) == https
            return true
    if n > lh
        if slice(s, 0, lh) == http
            return true
    false

// ── enum / choice validator ───────────────────────────────────────────────────────────────────────

// v_one_of: true iff s equals one of the strings in `options`.
// @Pattern / Django's validate_in_list / ChoiceField equivalent.
// v_one_of("red", ["red", "blue"]) -> true.
fn v_one_of(s: string, options: list) -> bool
    let n = len(options)
    let i = 0
    while i < n
        if options[i] == s
            return true
        i = i + 1
    false
