// forge_fenwick2d -- thin wrapper over std/collections/fenwick2d (canonical implementation).
import std/collections/fenwick2d

// NOTE: f2_new returns a dict (keys "a"/"rows"/"cols"/"c1"), not a list — the
// old `-> list` / `bit: list` annotations here were wrong and caused the
// runtime to mishandle the dict as a list, silently discarding every update.
fn fw2_new(rows: int, cols: int) -> dict
    return f2_new(rows, cols)

// NOTE: std/collections/fenwick2d is 1-indexed (cells 1..rows, 1..cols); this
// wrapper exposes a 0-indexed API (cells 0..rows-1, 0..cols-1), matching the
// convention every other forge collection wrapper uses. Translate at the
// boundary by shifting into the std module's 1-indexed space.
fn fw2_update(bit: dict, r: int, c: int, delta: int)
    return f2_update(bit, r + 1, c + 1, delta)

fn fw2_query(bit: dict, r: int, c: int) -> int
    return f2_query(bit, r + 1, c + 1)

fn fw2_rect_sum(bit: dict, r1: int, c1: int, r2: int, c2: int) -> int
    fw2_query(bit, r2, c2) - fw2_query(bit, r1 - 1, c2) - fw2_query(bit, r2, c1 - 1) + fw2_query(bit, r1 - 1, c1 - 1)

