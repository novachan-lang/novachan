// forge_fenwick2d -- a 2-D Fenwick tree (Binary Indexed Tree) for a grid you both UPDATE and QUERY: add to any
// single cell and ask for the sum of any rectangular sub-block, each in O(log rows * log cols). A plain 2-D prefix
// sum (forge_prefixsum) gives O(1) rectangle sums but has to be rebuilt from scratch whenever a cell changes; the
// Fenwick tree keeps both operations fast as the grid mutates. That's exactly what you need for a LIVE 2-D grid:
// heatmaps and analytics that update continuously, counting points in a moving rectangle, image integral images
// under edits, game-of-life-style boards, and "how many events in this region so far" over a stream. The magic is
// that each tree cell covers a range whose length is the lowest set bit of its index, so updates and prefix sums
// touch only O(log n) cells by repeatedly adding/removing that lowest bit. Rectangle sums come from inclusion-
// exclusion of four prefix sums. Integer values. LEAF -- imports NOTHING.

// PRIVATE: the lowest set bit of i (i - (i & (i-1)), avoiding negative arithmetic).
fn _fw2_low(i: int) -> int
    i - (i & (i - 1))

// A new rows x cols 2-D Fenwick tree, all zeros. Returns an opaque pack for the other functions.
fn fw2_new(rows: int, cols: int) -> list
    let w = cols + 1
    let tree = [0 for z in 0..((rows + 1) * w)]
    [tree, rows, cols]

// Add `delta` to cell (r, c) (0-based). O(log rows * log cols).
fn fw2_update(bit: list, r: int, c: int, delta: int)
    let tree = bit[0]
    let rows = bit[1]
    let cols = bit[2]
    let w = cols + 1
    let i = r + 1
    while i <= rows
        let j = c + 1
        while j <= cols
            tree[i * w + j] = tree[i * w + j] + delta
            j += _fw2_low(j)
        i += _fw2_low(i)

// PRIVATE: the prefix sum of the rectangle [0..r][0..c] (0 if r<0 or c<0).
fn fw2_query(bit: list, r: int, c: int) -> int
    let tree = bit[0]
    let cols = bit[2]
    let w = cols + 1
    let s = 0
    let i = r + 1
    while i > 0
        let j = c + 1
        while j > 0
            s += tree[i * w + j]
            j -= _fw2_low(j)
        i -= _fw2_low(i)
    s

// The sum of the sub-rectangle rows r1..r2, cols c1..c2 (all inclusive), via inclusion-exclusion of four prefixes.
fn fw2_rect_sum(bit: list, r1: int, c1: int, r2: int, c2: int) -> int
    fw2_query(bit, r2, c2) - fw2_query(bit, r1 - 1, c2) - fw2_query(bit, r2, c1 - 1) + fw2_query(bit, r1 - 1, c1 - 1)
