// forge_bloom_filter — probabilistic set membership with Result API.

fn bf_new(size: int, hash_count: int) -> dict
    let b = {}
    b["size"] = size
    b["hash_count"] = hash_count
    b["bits"] = {}
    b["count"] = 0
    b

fn bf_hash(key: string, seed: int, size: int) -> int
    let h = hash(key) + seed * 7919
    let result = h % size
    if result < 0
        result = 0 - result
    result

fn bf_add(b: dict, key: string) -> dict
    let i = 0
    while i < b["hash_count"]
        let h = bf_hash(key, i * 7 + 1, b["size"])
        let bk = "b_" + str(h)
        b["bits"][bk] = 1
        i += 1
    b["count"] = b["count"] + 1
    b

fn bf_might_contain(b: dict, key: string) -> int
    let i = 0
    while i < b["hash_count"]
        let h = bf_hash(key, i * 7 + 1, b["size"])
        let bk = "b_" + str(h)
        let has = contains(b["bits"], bk)
        if has != true
            return 0
        i += 1
    1

fn bf_count(b: dict) -> int
    b["count"]

fn bf_size(b: dict) -> int
    b["size"]
