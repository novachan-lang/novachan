fn ec_new()
    return {"device_count": 0, "config_count": 0, "pending_count": 0, "applied_count": 0}

fn ec_add_device(state, device_id)
    state["d_" + device_id + "_exists"] = 1
    state["d_" + device_id + "_configs"] = 0
    state["device_count"] += 1
    return state

fn ec_set_config(state, device_id, key, value)
    let ekey = "d_" + device_id + "_exists"
    if ekey not in state
        return err("unknown device: " + device_id)
    state["d_" + device_id + "_cfg_" + key] = value
    state["d_" + device_id + "_cfg_" + key + "_status"] = "pending"
    state["config_count"] += 1
    state["pending_count"] += 1
    return ok(state)

fn ec_get_config(state, device_id, key)
    let ckey = "d_" + device_id + "_cfg_" + key
    if ckey not in state
        return err("config not found")
    return ok(state[ckey])

fn ec_apply(state, device_id, key)
    let skey = "d_" + device_id + "_cfg_" + key + "_status"
    if skey not in state
        return err("config not found")
    if state[skey] == "applied"
        return err("already applied")
    state[skey] = "applied"
    state["pending_count"] -= 1
    state["applied_count"] += 1
    return ok(state)

fn ec_config_status(state, device_id, key)
    let skey = "d_" + device_id + "_cfg_" + key + "_status"
    if skey not in state
        return err("config not found")
    return ok(state[skey])

fn ec_device_count(state)
    return state["device_count"]

fn ec_config_count(state)
    return state["config_count"]

fn ec_pending_count(state)
    return state["pending_count"]

fn ec_applied_count(state)
    return state["applied_count"]

fn ec_has_device(state, device_id)
    let ekey = "d_" + device_id + "_exists"
    if ekey in state
        return 1
    return 0
