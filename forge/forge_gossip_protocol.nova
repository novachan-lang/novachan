// forge_gossip_protocol — Gossip protocol for state dissemination.
// Nodes exchange state, track generations, detect convergence.

fn gp_new() -> dict
    {"nodes": {}, "rounds": 0}

fn gp_add_node(gp: dict, node: string) -> dict
    gp["nodes"][node] = {"state": {}, "generation": 0, "alive": 1}
    gp

fn gp_set_state(gp: dict, node: string, key: string, value: string) -> dict
    if node not in gp["nodes"]
        return gp
    gp["nodes"][node]["state"][key] = value
    gp["nodes"][node]["generation"] += 1
    gp

fn gp_get_state(gp: dict, node: string, key: string) -> string
    if node not in gp["nodes"]
        return ""
    if key not in gp["nodes"][node]["state"]
        return ""
    gp["nodes"][node]["state"][key]

fn gp_gossip(gp: dict, from_node: string, to_node: string) -> dict
    if from_node not in gp["nodes"]
        return gp
    if to_node not in gp["nodes"]
        return gp
    let from_keys = keys(gp["nodes"][from_node]["state"])
    for i in 0..len(from_keys)
        let k = from_keys[i]
        gp["nodes"][to_node]["state"][k] = gp["nodes"][from_node]["state"][k]
    gp["rounds"] += 1
    gp

fn gp_mark_dead(gp: dict, node: string) -> dict
    if node not in gp["nodes"]
        return gp
    gp["nodes"][node]["alive"] = 0
    gp

fn gp_alive_count(gp: dict) -> int
    let count = 0
    let nodes = keys(gp["nodes"])
    for i in 0..len(nodes)
        if gp["nodes"][nodes[i]]["alive"] == 1
            count += 1
    count

fn gp_node_count(gp: dict) -> int
    len(keys(gp["nodes"]))

fn gp_generation(gp: dict, node: string) -> int
    if node not in gp["nodes"]
        return 0
    gp["nodes"][node]["generation"]

fn gp_gossip_rounds(gp: dict) -> int
    gp["rounds"]
