// forge_floydwarshall -- the Floyd-Warshall all-pairs shortest-path algorithm: in one O(V^3) pass it finds the
// shortest distance between EVERY pair of nodes, and unlike Dijkstra (forge_dijkstra) it handles NEGATIVE edge
// weights and can detect negative cycles. The idea is a three-line dynamic program: allow paths to route through
// node 0, then also through node 1, ... , then through node n-1; after considering every intermediate node, each
// dist[i][j] is optimal. It's the right tool for small/dense graphs where you need the whole distance matrix at
// once -- routing tables, transitive closure/reachability, "6 degrees" style all-pairs queries, and finding a
// graph's diameter. The graph is an adjacency matrix (list of rows) with 0 on the diagonal and fw_inf() for
// missing edges. Returns a new distance matrix; the input is not mutated. LEAF -- imports NOTHING.

// The sentinel for "no edge / unreachable". Build adjacency matrices with this for absent edges.
fn fw_inf() -> int
    1000000000

// All-pairs shortest distances for the adjacency matrix `graph` (n x n, 0 on diagonal, fw_inf() for no edge).
// Returns a fresh n x n matrix of shortest distances. Handles negative edges (but not negative cycles -- use
// fw_has_negative_cycle to check).
fn floyd_warshall(graph: list) -> list
    let n = len(graph)
    let INF = fw_inf()
    // flatten to a 1-D array (avoids 2-D element writes)
    let d = []
    let i = 0
    while i < n
        let j = 0
        while j < n
            push(d, graph[i][j])
            j = j + 1
        i = i + 1
    // relax through each intermediate node k
    let k = 0
    while k < n
        let ii = 0
        while ii < n
            let dik = d[ii * n + k]
            if dik < INF
                let jj = 0
                while jj < n
                    let dkj = d[k * n + jj]
                    if dkj < INF
                        let nd = dik + dkj
                        if nd < d[ii * n + jj]
                            d[ii * n + jj] = nd
                    jj = jj + 1
            ii = ii + 1
        k = k + 1
    // rebuild the matrix
    let out = []
    let a = 0
    while a < n
        let row = []
        let b = 0
        while b < n
            push(row, d[a * n + b])
            b = b + 1
        push(out, row)
        a = a + 1
    out

// True if `graph` contains a negative-weight cycle (some node ends up with a negative distance to itself).
fn fw_has_negative_cycle(graph: list) -> bool
    let dist = floyd_warshall(graph)
    let n = len(dist)
    let out = false
    let i = 0
    while i < n
        if dist[i][i] < 0
            out = true
        i = i + 1
    out

// True if j is reachable from i in a computed distance matrix (distance below fw_inf()).
fn fw_reachable(dist: list, i: int, j: int) -> bool
    let out = false
    if dist[i][j] < fw_inf()
        out = true
    out
