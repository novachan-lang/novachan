// forge_floydwarshall -- thin wrapper over std/graph/floydwarshall (canonical implementation).
import std/graph/floydwarshall

fn fw_inf() -> int
    1000000000

// All-pairs shortest distances for the adjacency matrix `graph` (n x n, 0 on diagonal, fw_inf() for no edge).
// Returns a fresh n x n matrix of shortest distances. Handles negative edges (but not negative cycles -- use
// fw_has_negative_cycle to check).

fn floyd_warshall(graph: list) -> list
    let n = len(graph)
    let INF = fw_inf()
    // flatten to a 1-D array (avoids 2-D element writes)
    let d = []
    for i in 0..n
        for j in 0..n
            push(d, graph[i][j])
    // relax through each intermediate node k
    for k in 0..n
        for ii in 0..n
            let dik = d[ii * n + k]
            if dik < INF
                for jj in 0..n
                    let dkj = d[k * n + jj]
                    if dkj < INF
                        let nd = dik + dkj
                        if nd < d[ii * n + jj]
                            d[ii * n + jj] = nd
    // rebuild the matrix
    [[d[a * n + b] for b in 0..n] for a in 0..n]

// True if `graph` contains a negative-weight cycle (some node ends up with a negative distance to itself).

fn fw_has_negative_cycle(graph: list) -> bool
    return fw_has_negative_cycle(graph)

fn fw_reachable(dist: list, i: int, j: int) -> bool
    dist[i][j] < fw_inf()

