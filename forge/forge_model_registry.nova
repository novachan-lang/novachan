// forge_model_registry — ML model versioning and registry.
// Register model versions with metrics, promote to production, query via Result.

fn mr_new() -> dict
    let r = {}
    r["models"] = {}
    r["metrics"] = {}
    r["production"] = {}
    r["model_count"] = 0
    r

fn mr_register(state: dict, name: string, version: int, metrics_csv: string) -> dict
    let has = contains(state["models"], name)
    if has != true
        state["models"][name] = str(version)
        state["model_count"] = state["model_count"] + 1
    else
        state["models"][name] = state["models"][name] + "," + str(version)
    let mkey = name + "@" + str(version)
    state["metrics"][mkey] = metrics_csv
    state

fn mr_latest(state: dict, name: string) -> Result
    if contains(state["models"], name) != true
        return err("model not found: " + name)
    let versions = split(state["models"][name], ",")
    ok(int(versions[len(versions) - 1]))

fn mr_metrics(state: dict, name: string, version: int) -> Result
    let mkey = name + "@" + str(version)
    if contains(state["metrics"], mkey) != true
        return err("no metrics for " + mkey)
    ok(state["metrics"][mkey])

fn mr_promote(state: dict, name: string, version: int) -> Result
    if contains(state["models"], name) != true
        return err("model not found: " + name)
    let versions = split(state["models"][name], ",")
    let found = false
    for i in 0..len(versions)
        if int(versions[i]) == version
            found = true
    if found != true
        return err("version not found: " + str(version))
    state["production"][name] = str(version)
    ok(version)

fn mr_production(state: dict, name: string) -> Result
    if contains(state["production"], name) != true
        return err("no production version for " + name)
    ok(int(state["production"][name]))

fn mr_model_count(state: dict) -> int
    state["model_count"]

fn mr_version_count(state: dict, name: string) -> Result
    if contains(state["models"], name) != true
        return err("model not found: " + name)
    let versions = split(state["models"][name], ",")
    ok(len(versions))

fn mr_has_model(state: dict, name: string) -> int
    let has = contains(state["models"], name)
    if has == true
        return 1
    0
