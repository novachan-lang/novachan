// forge_jwt_decode -- decode a JWT's header + payload WITHOUT verifying the signature: inspect claims
// (exp/iss/aud/sub), debug tokens, or read claims when verification happens at a gateway. forge.nova's
// jwt_verify does the SIGNED verification; this is the read-only inspector (do NOT trust these claims for
// authz without verifying). Composes forge_base64url + json_decode. Imports forge_base64url.
import forge_base64url

// The payload (claims) dict, signature UNVERIFIED. {} if malformed (not 3 dot-separated parts).
fn jwt_decode_payload(token: string) -> dict
    let parts = split(token, ".")
    if len(parts) != 3
        return {}
    json_decode(base64url_decode(parts[1]))

// The header dict (alg/typ), UNVERIFIED. {} if malformed.
fn jwt_decode_header(token: string) -> dict
    let parts = split(token, ".")
    if len(parts) != 3
        return {}
    json_decode(base64url_decode(parts[0]))

// Is the JWT expired at `now_epoch` (reads the unverified "exp" claim)? false if no exp.
fn jwt_is_expired(token: string, now_epoch: int) -> bool
    let payload = jwt_decode_payload(token)
    if "exp" not in payload
        return false
    now_epoch > payload["exp"]
