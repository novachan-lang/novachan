// forge_request_id — sequential request ID generation with metadata and Result API.

fn rid_new(prefix: string) -> dict
    let r = {}
    r["prefix"] = prefix
    r["next_seq"] = 1
    r["total_issued"] = 0
    r

fn rid_generate(r: dict) -> string
    let seq = r["next_seq"]
    r["next_seq"] = seq + 1
    r["total_issued"] = r["total_issued"] + 1
    r["prefix"] + "-" + str(seq)

fn rid_generate_with_context(r: dict, context: string) -> string
    let seq = r["next_seq"]
    r["next_seq"] = seq + 1
    r["total_issued"] = r["total_issued"] + 1
    let rid = r["prefix"] + "-" + str(seq)
    r["ctx_" + rid] = context
    rid

fn rid_context(r: dict, request_id: string) -> Result
    let ck = "ctx_" + request_id
    if ck in r != true
        return err("no context for: " + request_id)
    ok(r[ck])

fn rid_total_issued(r: dict) -> int
    r["total_issued"]

fn rid_next_sequence(r: dict) -> int
    r["next_seq"]
