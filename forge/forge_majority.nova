// forge_majority -- find the "frequent" elements of a list in ONE pass and O(1) extra space, using the Boyer-Moore
// voting algorithm. The trick: candidates and opposing votes CANCEL, so a value that truly dominates survives the
// cancellation. majority_element finds the value appearing MORE than half the time (if any) -- the classic use is
// fault-tolerant consensus (the value a majority of replicas agree on), stream/log "what's the dominant value",
// and election-style tallying. frequent_over_third generalizes it to every value appearing more than a THIRD of
// the time (there can be at most two) with two counters. Because voting alone can produce a false candidate when
// no true majority exists, both functions do a verification pass and only report values that genuinely clear the
// threshold. Elements are integers. LEAF -- imports NOTHING.

// PRIVATE: how many times v occurs in xs.
fn _maj_count(xs: list, v: int) -> int
    let c = 0
    for i in 0..len(xs)
        if xs[i] == v
            c += 1
    c

// The majority element (appears strictly more than n/2 times) as [found, value]: found is 1 with the value if a
// majority exists, else 0 (and value 0). One pass to get a candidate, one to verify.
fn majority_element(xs: list) -> list
    if len(xs) == 0
        return [0, 0]
    // Boyer-Moore vote
    let cand = xs[0]
    let count = 0
    for i in 0..len(xs)
        if count == 0
            cand = xs[i]
            count = 1
        else if xs[i] == cand
            count += 1
        else
            count -= 1
    // verify: strictly more than half
    if _maj_count(xs, cand) * 2 > len(xs)
        return [1, cand]
    [0, 0]

// True if the list has a majority element (some value in more than half the slots).
fn has_majority(xs: list) -> bool
    let m = majority_element(xs)
    m[0] == 1

// Every value that appears strictly more than n/3 times, ascending (there can be 0, 1, or 2 of them). Two-counter
// Boyer-Moore generalization, verified.
fn frequent_over_third(xs: list) -> list
    let out = []
    let n = len(xs)
    if n > 0
        let cand1 = 0
        let cand2 = 0
        let count1 = 0
        let count2 = 0
        for i in 0..n
            let x = xs[i]
            if count1 > 0 and x == cand1
                count1 += 1
            else if count2 > 0 and x == cand2
                count2 += 1
            else if count1 == 0
                cand1 = x
                count1 = 1
            else if count2 == 0
                cand2 = x
                count2 = 1
            else
                count1 -= 1
                count2 -= 1
        // verify each surviving candidate
        let ok1 = count1 > 0 and _maj_count(xs, cand1) * 3 > n
        let ok2 = count2 > 0 and cand2 != cand1 and _maj_count(xs, cand2) * 3 > n
        // emit ascending
        if ok1 and ok2
            if cand1 < cand2
                push(out, cand1)
                push(out, cand2)
            else
                push(out, cand2)
                push(out, cand1)
        else
            if ok1
                push(out, cand1)
            if ok2
                push(out, cand2)
    out
