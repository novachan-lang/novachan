// forge_cbor -- CBOR (Concise Binary Object Representation, RFC 8949) ENCODER. CBOR is the IETF's binary JSON:
// self-describing, compact, no schema -- and unlike MessagePack (forge_msgpack) it is the encoding under COSE,
// CWT, WebAuthn/FIDO2 attestation, and many IoT/constrained-device protocols. This module encodes NOVA values
// (unsigned & negative integers, text strings, arrays, and explicit bool/null) to a CBOR byte list, which the
// caller serializes via the bytes type or hex. Output is validated against the RFC 8949 Appendix A vectors.
//
// TYPE NOTE: NOVA's type_of(true) == "int" (an unboxed bool is indistinguishable from an int here), so
// cbor_encode treats bools as integers; encode a genuine CBOR boolean/null with the explicit cbor_bool /
// cbor_null helpers. Text is assumed ASCII (one byte per char) for the length/byte extraction. LEAF.

// PRIVATE: the CBOR "head" -- major type (0..7) in the top 3 bits + the argument `n` (a uint value or a
// length) encoded in the minimal width: inline (<24), 1, 2, 4, or 8 following big-endian bytes.
fn _cbor_head(major: int, n: int) -> list
    let mt = major * 32
    let out = []
    if n < 24
        push(out, mt + n)
        return out
    if n < 256
        push(out, mt + 24)
        push(out, n & 255)
        return out
    if n < 65536
        push(out, mt + 25)
        push(out, (n >> 8) & 255)
        push(out, n & 255)
        return out
    if n < 4294967296
        push(out, mt + 26)
        push(out, (n >> 24) & 255)
        push(out, (n >> 16) & 255)
        push(out, (n >> 8) & 255)
        push(out, n & 255)
        return out
    push(out, mt + 27)
    push(out, (n >> 56) & 255)
    push(out, (n >> 48) & 255)
    push(out, (n >> 40) & 255)
    push(out, (n >> 32) & 255)
    push(out, (n >> 24) & 255)
    push(out, (n >> 16) & 255)
    push(out, (n >> 8) & 255)
    push(out, n & 255)
    out

// Unsigned integer (major type 0).
fn cbor_uint(v: int) -> list
    _cbor_head(0, v)

// Any integer: non-negative -> major 0; negative -> major 1 with argument (-1 - v), so -1 -> 0x20, -100 -> 0x3863.
fn cbor_int(v: int) -> list
    if v >= 0
        return _cbor_head(0, v)
    _cbor_head(1, 0 - 1 - v)

// Text string (major type 3): head(len) + the ASCII bytes.
fn cbor_text(s: string) -> list
    let out = _cbor_head(3, len(s))
    for i in 0..len(s)
        push(out, ord(char_at(s, i)))
    out

// Explicit CBOR boolean (major 7): true = 0xf5, false = 0xf4.
fn cbor_bool(b: bool) -> list
    let out = []
    if b
        push(out, 245)
    else
        push(out, 244)
    out

// Explicit CBOR null (major 7): 0xf6.
fn cbor_null() -> list
    let out = []
    push(out, 246)
    out

// Generic encode: dispatches on NOVA type. int -> cbor_int, string -> cbor_text, list -> a CBOR array
// (major 4) whose elements are each cbor_encode'd recursively. (bool arrives as int -- use cbor_bool.)
fn cbor_encode(x) -> list
    let t = type_of(x)
    if t == "string"
        return cbor_text(x)
    if t == "list"
        let out = _cbor_head(4, len(x))
        for i in 0..len(x)
            let enc = cbor_encode(x[i])
            let j = 0
            while j < len(enc)
                push(out, enc[j])
                j += 1
        return out
    cbor_int(x)
