// forge_cbor -- thin wrapper over std/data/cbor (canonical implementation).
import std/data/cbor

fn _cbor_head(major: int, n: int) -> list
    let mt = major * 32
    let out = []
    if n < 24
        push(out, mt + n)
        return out
    if n < 256
        push(out, mt + 24)
        push(out, n & 255)
        return out
    if n < 65536
        push(out, mt + 25)
        push(out, (n >> 8) & 255)
        push(out, n & 255)
        return out
    if n < 4294967296
        push(out, mt + 26)
        push(out, (n >> 24) & 255)
        push(out, (n >> 16) & 255)
        push(out, (n >> 8) & 255)
        push(out, n & 255)
        return out
    push(out, mt + 27)
    push(out, (n >> 56) & 255)
    push(out, (n >> 48) & 255)
    push(out, (n >> 40) & 255)
    push(out, (n >> 32) & 255)
    push(out, (n >> 24) & 255)
    push(out, (n >> 16) & 255)
    push(out, (n >> 8) & 255)
    push(out, n & 255)
    out

// Unsigned integer (major type 0).

fn cbor_uint(v: int) -> list
    _cbor_head(0, v)

// Any integer: non-negative -> major 0; negative -> major 1 with argument (-1 - v), so -1 -> 0x20, -100 -> 0x3863.

fn cbor_int(v: int) -> list
    if v >= 0
        return _cbor_head(0, v)
    _cbor_head(1, -1 - v)

// Text string (major type 3): head(len) + the ASCII bytes.

fn cbor_text(s: string) -> list
    let out = _cbor_head(3, len(s))
    for i in 0..len(s)
        push(out, ord(char_at(s, i)))
    out

// Explicit CBOR boolean (major 7): true = 0xf5, false = 0xf4.

fn cbor_bool(b: bool) -> list
    return cb_encode_bool(b)

fn cbor_null() -> list
    return cb_encode_null()

fn cbor_encode(x) -> list
    return cb_encode(x)

