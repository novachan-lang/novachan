// forge_outbox_relay — Reliable outbox pattern: store then relay events.

fn or_new() -> dict
    {"outbox": {}, "count": 0, "relayed": 0, "failed": 0, "next_id": 1}

fn or_add(o: dict, topic: string, payload: string) -> dict
    let id = o["next_id"]
    let k = str(id)
    o["outbox"]["{k}_topic"] = topic
    o["outbox"]["{k}_payload"] = payload
    o["outbox"]["{k}_status"] = "pending"
    o["outbox"]["{k}_retries"] = 0
    o["next_id"] += 1
    o["count"] += 1
    o

fn or_relay_next(o: dict) -> dict
    let result = {"found": 0, "id": 0}
    for i in 1..o["next_id"]
        let k = str(i)
        let skey = "{k}_status"
        if skey in o["outbox"]
            if o["outbox"][skey] == "pending"
                result["found"] = 1
                result["id"] = i
                result["topic"] = o["outbox"]["{k}_topic"]
                result["payload"] = o["outbox"]["{k}_payload"]
                o["outbox"][skey] = "relayed"
                o["relayed"] += 1
                result["o"] = o
                return result
    result["o"] = o
    result

fn or_fail(o: dict, msg_id: int) -> dict
    let k = str(msg_id)
    let skey = "{k}_status"
    if skey in o["outbox"]
        o["outbox"][skey] = "failed"
        o["outbox"]["{k}_retries"] += 1
        o["failed"] += 1
    o

fn or_retry_failed(o: dict) -> int
    let retried = 0
    for i in 1..o["next_id"]
        let k = str(i)
        let skey = "{k}_status"
        if skey in o["outbox"]
            if o["outbox"][skey] == "failed"
                o["outbox"][skey] = "pending"
                retried += 1
    retried

fn or_pending_count(o: dict) -> int
    let count = 0
    for i in 1..o["next_id"]
        let k = str(i)
        let skey = "{k}_status"
        if skey in o["outbox"]
            if o["outbox"][skey] == "pending"
                count += 1
    count

fn or_relayed_count(o: dict) -> int
    o["relayed"]

fn or_total_count(o: dict) -> int
    o["count"]
