// forge_outbox_relay — Reliable outbox pattern: store then relay events.

fn or_new() -> dict
    let o = {}
    o["outbox"] = {}
    o["count"] = 0
    o["relayed"] = 0
    o["failed"] = 0
    o["next_id"] = 1
    o

fn or_add(o: dict, topic: string, payload: string) -> dict
    let id = o["next_id"]
    let k = str(id)
    o["outbox"][k + "_topic"] = topic
    o["outbox"][k + "_payload"] = payload
    o["outbox"][k + "_status"] = "pending"
    o["outbox"][k + "_retries"] = 0
    o["next_id"] = id + 1
    o["count"] = o["count"] + 1
    o

fn or_relay_next(o: dict) -> dict
    let result = {}
    result["found"] = 0
    result["id"] = 0
    let i = 1
    while i < o["next_id"]
        let k = str(i)
        let has = contains(o["outbox"], k + "_status")
        if has == true
            if o["outbox"][k + "_status"] == "pending"
                result["found"] = 1
                result["id"] = i
                result["topic"] = o["outbox"][k + "_topic"]
                result["payload"] = o["outbox"][k + "_payload"]
                o["outbox"][k + "_status"] = "relayed"
                o["relayed"] = o["relayed"] + 1
                result["o"] = o
                return result
        i += 1
    result["o"] = o
    result

fn or_fail(o: dict, msg_id: int) -> dict
    let k = str(msg_id)
    let has = contains(o["outbox"], k + "_status")
    if has == true
        o["outbox"][k + "_status"] = "failed"
        o["outbox"][k + "_retries"] = o["outbox"][k + "_retries"] + 1
        o["failed"] = o["failed"] + 1
    o

fn or_retry_failed(o: dict) -> int
    let retried = 0
    let i = 1
    while i < o["next_id"]
        let k = str(i)
        let has = contains(o["outbox"], k + "_status")
        if has == true
            if o["outbox"][k + "_status"] == "failed"
                o["outbox"][k + "_status"] = "pending"
                retried += 1
        i += 1
    retried

fn or_pending_count(o: dict) -> int
    let count = 0
    let i = 1
    while i < o["next_id"]
        let k = str(i)
        let has = contains(o["outbox"], k + "_status")
        if has == true
            if o["outbox"][k + "_status"] == "pending"
                count += 1
        i += 1
    count

fn or_relayed_count(o: dict) -> int
    o["relayed"]

fn or_total_count(o: dict) -> int
    o["count"]
