// forge_bittransform -- the fast transforms over BITMASK / subset space: compute, in O(n log n) instead of the
// naive O(n^2), the XOR-, OR-, and AND-convolutions of two arrays indexed by bitmasks, plus the zeta ("sum over all
// subsets") and Moebius (its inverse) transforms. A convolution here answers "for every result mask k, sum a[i]*b[j]
// over all pairs whose bitwise combination is k" -- the engine behind subset-sum and inclusion-exclusion dynamic
// programming, counting problems over sets, Walsh-Hadamard / Boolean-function analysis and spectral tests of
// S-boxes, probabilistic aggregation over feature sets, and a swath of competitive-programming DP. The XOR
// convolution runs through the Fast Walsh-Hadamard Transform (the same butterfly as an FFT but with +/- only, no
// roots of unity), while the OR and AND convolutions run through the subset (zeta) and superset transforms
// respectively -- transform both inputs, multiply pointwise, transform back. zeta_transform turns an array into its
// running sum over subsets (SOS DP) and mobius_transform undoes it exactly. Array length MUST be a power of two
// (each index is a bitmask); integer values, kept modest so pointwise products stay in signed 64-bit. LEAF.

// PRIVATE: an independent copy of a list.
fn _bt_copy(a: list) -> list
    let out = [a[i] for i in 0..len(a)]
    out

// The Fast Walsh-Hadamard Transform of a (length must be a power of two), in place, returning a. If invert is true
// it applies the inverse (the same butterfly followed by dividing every entry by n).
fn fwht(a: list, invert: bool) -> list
    let n = len(a)
    let step = 1
    while step < n
        let i = 0
        while i < n
            let j = i
            while j < i + step
                let x = a[j]
                let y = a[j + step]
                a[j] = x + y
                a[j + step] = x - y
                j += 1
            i += step * 2
        step = step * 2
    if invert
        for d in 0..n
            a[d] = a[d] / n
    a

// XOR convolution: result[k] = sum over all i,j with (i XOR j) == k of a[i]*b[j]. a and b must have equal
// power-of-two length. Computed via the Walsh-Hadamard transform.
fn xor_convolution(a: list, b: list) -> list
    let fa = _bt_copy(a)
    let fb = _bt_copy(b)
    fwht(fa, false)
    fwht(fb, false)
    let c = []
    let i = 0
    while i < len(fa)
        push(c, fa[i] * fb[i])
        i += 1
    fwht(c, true)
    c

// The zeta transform (sum over subsets / SOS DP): result[mask] = sum of a[sub] over every sub that is a subset of
// mask. In place, returns a. Length must be a power of two.
fn zeta_transform(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 1
                a[mask] = a[mask] + a[mask ^ bit]
        bit = bit * 2
    a

// The Moebius transform: the exact inverse of zeta_transform (recovers a from its subset-sums). In place, returns a.
fn mobius_transform(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        let mask = 0
        while mask < n
            if ((mask >> _bt_log2(bit)) & 1) == 1
                a[mask] = a[mask] - a[mask ^ bit]
            mask += 1
        bit = bit * 2
    a

// PRIVATE: index of the single set bit of a power of two.
fn _bt_log2(bit: int) -> int
    let b = bit
    let e = 0
    while b > 1
        b = b >> 1
        e += 1
    e

// OR convolution: result[k] = sum over all i,j with (i OR j) == k of a[i]*b[j]. Via subset (zeta) transforms.
fn or_convolution(a: list, b: list) -> list
    let za = _bt_copy(a)
    let zb = _bt_copy(b)
    zeta_transform(za)
    zeta_transform(zb)
    let c = []
    let i = 0
    while i < len(za)
        push(c, za[i] * zb[i])
        i += 1
    mobius_transform(c)
    c

// PRIVATE: superset zeta -- result[mask] = sum of a[sup] over every sup that CONTAINS mask.
fn _bt_superzeta(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 0
                a[mask] = a[mask] + a[mask ^ bit]
        bit = bit * 2
    a

// PRIVATE: superset moebius -- inverse of _bt_superzeta.
fn _bt_supermobius(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 0
                a[mask] = a[mask] - a[mask ^ bit]
        bit = bit * 2
    a

// AND convolution: result[k] = sum over all i,j with (i AND j) == k of a[i]*b[j]. Via superset transforms.
fn and_convolution(a: list, b: list) -> list
    let za = _bt_copy(a)
    let zb = _bt_copy(b)
    _bt_superzeta(za)
    _bt_superzeta(zb)
    let c = [za[i] * zb[i] for i in 0..len(za)]
    _bt_supermobius(c)
    c
