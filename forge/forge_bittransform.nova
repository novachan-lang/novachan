// forge_bittransform -- fast transforms over bitmask/subset space: XOR/OR/AND convolutions via
// Walsh-Hadamard, zeta (SOS DP), and Moebius transforms. Array length MUST be a power of two. LEAF.

fn _bt_copy(a: list) -> list
    [a[i] for i in 0..len(a)]

fn fwht(a: list, invert: bool) -> list
    let n = len(a)
    let step = 1
    while step < n
        let i = 0
        while i < n
            let j = i
            while j < i + step
                let x = a[j]
                let y = a[j + step]
                a[j] = x + y
                a[j + step] = x - y
                j += 1
            i += step * 2
        step = step * 2
    if invert
        for d in 0..n
            a[d] = a[d] / n
    a

fn xor_convolution(a: list, b: list) -> list
    let fa = _bt_copy(a)
    let fb = _bt_copy(b)
    fwht(fa, false)
    fwht(fb, false)
    let c = [fa[i] * fb[i] for i in 0..len(fa)]
    fwht(c, true)
    c

fn zeta_transform(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 1
                a[mask] += a[mask ^ bit]
        bit = bit * 2
    a

fn mobius_transform(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 1
                a[mask] -= a[mask ^ bit]
        bit = bit * 2
    a

fn _bt_log2(bit: int) -> int
    let b = bit
    let e = 0
    while b > 1
        b = b >> 1
        e += 1
    e

fn or_convolution(a: list, b: list) -> list
    let za = _bt_copy(a)
    let zb = _bt_copy(b)
    zeta_transform(za)
    zeta_transform(zb)
    let c = [za[i] * zb[i] for i in 0..len(za)]
    mobius_transform(c)
    c

fn _bt_superzeta(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 0
                a[mask] += a[mask ^ bit]
        bit = bit * 2
    a

fn _bt_supermobius(a: list) -> list
    let n = len(a)
    let bit = 1
    while bit < n
        for mask in 0..n
            if ((mask >> _bt_log2(bit)) & 1) == 0
                a[mask] -= a[mask ^ bit]
        bit = bit * 2
    a

fn and_convolution(a: list, b: list) -> list
    let za = _bt_copy(a)
    let zb = _bt_copy(b)
    _bt_superzeta(za)
    _bt_superzeta(zb)
    let c = [za[i] * zb[i] for i in 0..len(za)]
    _bt_supermobius(c)
    c
