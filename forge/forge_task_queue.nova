// forge_task_queue — Background job queue (Sidekiq/Celery pattern).
// Pure data structures for job definition, queue management, scheduling.
// Integrates with any backend (Redis, in-memory, DB) via adapter pattern.

fn tq_new(name: string) -> dict
    {"name": name, "jobs": [], "completed": [], "failed": [], "scheduled": [], "workers": 1, "max_retries": 3}

fn tq_enqueue(q: dict, job_type: string, payload: dict) -> dict
    let job = {"id": _tq_next_id(q), "type": job_type, "payload": payload, "status": "pending", "retries": 0, "created_at": 0, "priority": 0}
    push(q["jobs"], job)
    q

fn tq_enqueue_priority(q: dict, job_type: string, payload: dict, priority: int) -> dict
    let job = {"id": _tq_next_id(q), "type": job_type, "payload": payload, "status": "pending", "retries": 0, "created_at": 0, "priority": priority}
    push(q["jobs"], job)
    q

fn tq_schedule(q: dict, job_type: string, payload: dict, run_at: int) -> dict
    let job = {"id": _tq_next_id(q), "type": job_type, "payload": payload, "status": "scheduled", "retries": 0, "created_at": 0, "run_at": run_at, "priority": 0}
    push(q["scheduled"], job)
    q

fn tq_dequeue(q: dict) -> dict
    if len(q["jobs"]) == 0
        return {"job": null, "queue": q}
    let best_idx = 0
    let best_pri = q["jobs"][0]["priority"]
    let i = 1
    while i < len(q["jobs"])
        if q["jobs"][i]["priority"] > best_pri
            best_pri = q["jobs"][i]["priority"]
            best_idx = i
        i += 1
    let job = q["jobs"][best_idx]
    let new_jobs = []
    i = 0
    while i < len(q["jobs"])
        if i != best_idx
            push(new_jobs, q["jobs"][i])
        i += 1
    q["jobs"] = new_jobs
    job["status"] = "processing"
    {"job": job, "queue": q}

fn tq_complete(q: dict, job: dict) -> dict
    job["status"] = "completed"
    push(q["completed"], job)
    q

fn tq_fail(q: dict, job: dict, error: string) -> dict
    job["retries"] = job["retries"] + 1
    if job["retries"] < q["max_retries"]
        job["status"] = "pending"
        push(q["jobs"], job)
    else
        job["status"] = "failed"
        job["error"] = error
        push(q["failed"], job)
    q

fn tq_pending_count(q: dict) -> int
    len(q["jobs"])

fn tq_completed_count(q: dict) -> int
    len(q["completed"])

fn tq_failed_count(q: dict) -> int
    len(q["failed"])

fn tq_set_workers(q: dict, count: int) -> dict
    q["workers"] = count
    q

fn tq_set_max_retries(q: dict, n: int) -> dict
    q["max_retries"] = n
    q

fn tq_promote_scheduled(q: dict, current_time: int) -> dict
    let remaining = []
    let i = 0
    while i < len(q["scheduled"])
        let job = q["scheduled"][i]
        if job["run_at"] <= current_time
            job["status"] = "pending"
            push(q["jobs"], job)
        else
            push(remaining, job)
        i += 1
    q["scheduled"] = remaining
    q

fn tq_stats(q: dict) -> dict
    {"name": q["name"], "pending": len(q["jobs"]), "completed": len(q["completed"]), "failed": len(q["failed"]), "scheduled": len(q["scheduled"]), "workers": q["workers"]}

fn _tq_next_id(q: dict) -> int
    len(q["jobs"]) + len(q["completed"]) + len(q["failed"]) + len(q["scheduled"]) + 1
