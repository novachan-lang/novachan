// forge_jsonld -- Schema.org JSON-LD structured-data builders for SEO. These are the
// <script type="application/ld+json"> blocks that Google/Bing parse to build rich results:
// article cards, breadcrumb trails, organization knowledge panels, product listings with
// price/availability, and the Sitelinks search box. Each builder assembles a NOVA dict with
// the schema.org "@context"/"@type" keys and json_stringify's it. The "@" is an ordinary
// character in a NOVA string literal; the JSON braces are produced by json_stringify, never
// written as literal { } in source. LEAF -- imports NOTHING. Built-ins: json_stringify, push,
// len, str, contains.

// schema.org Article -- a news/blog post rich card. `author` becomes a nested Person object.
fn jsonld_article(headline: string, author: string, date_published: string, image: string, url: string) -> string
    let author_dict = {"@type": "Person", "name": author}
    let d = {"@context": "https://schema.org", "@type": "Article", "headline": headline, "image": image, "url": url, "datePublished": date_published, "author": author_dict}
    json_stringify(d)

// schema.org Organization -- the entity behind the org knowledge panel (name/url/logo).
fn jsonld_organization(name: string, url: string, logo: string) -> string
    let d = {"@context": "https://schema.org", "@type": "Organization", "name": name, "url": url, "logo": logo}
    json_stringify(d)

// schema.org BreadcrumbList -- the "Home > Category > Page" trail Google shows above a result.
// `items` is a list of dicts each with "name" and "url"; positions are 1-based.
fn jsonld_breadcrumb(items: list) -> string
    let elements = [{"@type": "ListItem", "position": i + 1, "name": items[i]["name"], "item": items[i]["url"]} for i in 0..len(items)]
    let d = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": elements}
    json_stringify(d)

// schema.org Product -- a product listing with a nested Offer (price/currency/availability).
fn jsonld_product(name: string, description: string, image: string, price: string, currency: string) -> string
    let offers = {"@type": "Offer", "price": price, "priceCurrency": currency, "availability": "https://schema.org/InStock"}
    let d = {"@context": "https://schema.org", "@type": "Product", "name": name, "description": description, "image": image, "offers": offers}
    json_stringify(d)

// schema.org WebSite with the Google Sitelinks Searchbox potentialAction (SearchAction).
// `search_url_template` is the query URL with the {search_term_string} placeholder the client fills.
fn jsonld_website(name: string, url: string, search_url_template: string) -> string
    let action = {"@type": "SearchAction", "target": search_url_template, "query-input": "required name=search_term_string"}
    let d = {"@context": "https://schema.org", "@type": "WebSite", "name": name, "url": url, "potentialAction": action}
    json_stringify(d)

// Wrap a JSON-LD string in the HTML <script type="application/ld+json"> tag for embedding in <head>.
fn jsonld_script(json_str: string) -> string
    "<script type=\"application/ld+json\">{json_str}</script>"
