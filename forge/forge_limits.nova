// ══════════════════════════════════════════════════════════════════════════════
// forge_limits — DoS-resistance primitives for NOVA web services (Sprint S4 / Layer 3).
//
// A LEAF module: imports NOTHING (only core builtins channel/spawn/send/receive/contains),
// so any app can `import forge_limits` without pulling forge into a module diamond. Provides
// request-size caps (pure), a token-bucket rate limiter, a concurrent-connection guard, and
// the N>1-SAFE ACTOR wrappers (rate_limiter / conn_guard) that the spawn-per-connection server
// can share across carriers. The pure dict-mutating forms are single-owner-only (an N>1 data
// race if shared); the actors serialize all state mutation through one owning green task, so
// they are race-free by construction. Wire mw_rate_limit (forge_auth) over rate_limiter for
// per-request limiting; wire conn_guard at the accept loop for accept-storm backpressure (503).
// ══════════════════════════════════════════════════════════════════════════════

// ── Request size caps (reject before allocating) ───────────────────────────────

// 1 if a body of `content_length` bytes is within max_bytes (and non-negative).
fn limit_body_ok(content_length: int, max_bytes: int) -> int
    if content_length < 0
        return 0
    if content_length > max_bytes
        return 0
    1

fn limit_line_ok(line: string, max_len: int) -> int
    if len(line) > max_len
        return 0
    1

fn limit_headers_ok(count: int, max_headers: int) -> int
    if count > max_headers
        return 0
    1

// ── Token-bucket rate limiter (pure; single-owner) ─────────────────────────────
// capacity tokens, refilled at refill_per_ms tokens/ms. Each allowed request costs tokens; when
// the bucket is empty the request is denied. Caller supplies a monotonic now_ms (deterministic +
// testable). State is a dict, mutated in place -- share ONLY within one task (else use rate_limiter).

fn rate_new(capacity: float, refill_per_ms: float) -> dict
    {"cap": capacity, "tokens": capacity, "refill": refill_per_ms, "last": 0}

fn _rate_min(a: float, b: float) -> float
    if a < b
        return a
    b

// returns 1 if allowed (and deducts cost), 0 if rate-limited
fn rate_allow(b: dict, now_ms: int, cost: float) -> int
    let elapsed = now_ms - b["last"]
    if elapsed < 0
        elapsed = 0
    let refilled = b["tokens"] + (elapsed + 0.0) * b["refill"]
    let tokens = _rate_min(b["cap"], refilled)
    b["last"] = now_ms
    if tokens >= cost
        b["tokens"] = tokens - cost
        return 1
    b["tokens"] = tokens
    0

// ── Concurrent-connection guard (pure; single-owner) ────────────────────────────

fn conn_new(max_conns: int) -> dict
    {"max": max_conns, "cur": 0}

// returns 1 if a slot was acquired, 0 if at capacity (caller should reject/503)
fn conn_acquire(g: dict) -> int
    if g["cur"] >= g["max"]
        return 0
    g["cur"] = g["cur"] + 1
    1

fn conn_release(g: dict)
    let c = g["cur"] - 1
    if c < 0
        c = 0
    g["cur"] = c

fn conn_count(g: dict) -> int
    g["cur"]

// ── Rate-limiter ACTOR (N>1-safe: single-owner, per-key token buckets) ────────────────────────────
// The pure rate_allow above mutates ONE bucket dict -- unsafe to share across the spawn-per-connection
// boundary (both an N>1 data race AND the deep-copied-dict new-key bug). This wraps it in a serializing
// ACTOR: per-key buckets are BORN IN THE LOOP and only the actor touches them, so it is race-free and
// dict-bug-free by construction. rate_check(lim, key, now_ms) -> 1 allow / 0 limited. This is the
// N>1-correct rate limiter the live serve loop / a mw_rate_limit middleware can safely call.
fn _ratelimiter_loop(lim)
    let buckets = {}
    let cap = lim["cap"]
    let refill = lim["refill"]
    let running = 1
    while running == 1
        let env = receive(lim["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "check"
            let key = env["key"]
            if contains(buckets, key) == false
                buckets[key] = rate_new(cap, refill)
            send(env["reply"], rate_allow(buckets[key], env["now_ms"], 1.0))

fn rate_limiter(capacity: float, refill_per_ms: float) -> any
    let lim = {}
    lim["req"] = channel()
    lim["cap"] = capacity
    lim["refill"] = refill_per_ms
    spawn _ratelimiter_loop(lim)
    lim

fn rate_check(lim, key: string, now_ms: int) -> int
    let rc = channel()
    let env = {}
    env["op"] = "check"
    env["key"] = key
    env["now_ms"] = now_ms
    env["reply"] = rc
    send(lim["req"], env)
    receive(rc)

fn rate_limiter_stop(lim)
    let env = {}
    env["op"] = "stop"
    env["reply"] = 0
    send(lim["req"], env)

// ── Conn-guard ACTOR (N>1-safe: mirrors rate_limiter) ──────────────────────────────────────────────
// The pure conn_new/conn_acquire dict counter races at NOVA_CARRIERS>1: the acceptor increments while a
// worker task decrements on close -> a torn `cur`. This ACTOR serializes acquire/release through one
// owning task, so the connection cap is exact under any carrier count. cg_acquire -> 1 slot / 0 at cap
// (caller sends 503 + closes without spawning the handler); cg_release on connection end.
fn _connguard_loop(g)
    let cur = 0
    let mx = g["max"]
    let running = 1
    while running == 1
        let env = receive(g["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "acquire"
            if cur >= mx
                send(env["reply"], 0)
            else
                cur = cur + 1
                send(env["reply"], 1)
        else if op == "release"
            cur = cur - 1
            if cur < 0
                cur = 0

fn conn_guard(max_conns: int) -> any
    let g = {}
    g["req"] = channel()
    g["max"] = max_conns
    spawn _connguard_loop(g)
    g

fn cg_acquire(g) -> int
    let rc = channel()
    let env = {}
    env["op"] = "acquire"
    env["reply"] = rc
    send(g["req"], env)
    receive(rc)

fn cg_release(g)
    let env = {}
    env["op"] = "release"
    env["reply"] = 0
    send(g["req"], env)

fn conn_guard_stop(g)
    let env = {}
    env["op"] = "stop"
    env["reply"] = 0
    send(g["req"], env)
