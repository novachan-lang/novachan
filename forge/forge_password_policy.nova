// forge_password_policy — password strength validation with configurable rules and Result API.

fn pp_new(min_len: int) -> dict
    let p = {}
    p["min_len"] = min_len
    p["require_upper"] = 0
    p["require_digit"] = 0
    p["require_special"] = 0
    p["checks"] = 0
    p["passes"] = 0
    p["failures"] = 0
    p

fn pp_require_upper(p: dict) -> dict
    p["require_upper"] = 1
    p

fn pp_require_digit(p: dict) -> dict
    p["require_digit"] = 1
    p

fn pp_require_special(p: dict) -> dict
    p["require_special"] = 1
    p

fn pp_check(p: dict, password: string) -> Result
    p["checks"] = p["checks"] + 1
    if len(password) < p["min_len"]
        p["failures"] = p["failures"] + 1
        return err("too short")
    if p["require_upper"] == 1
        let has_upper = 0
        for i in 0..len(password)
            let ch = slice(password, i, i + 1)
            if ch >= "A"
                if ch <= "Z"
                    has_upper = 1
        if has_upper == 0
            p["failures"] = p["failures"] + 1
            return err("missing uppercase")
    if p["require_digit"] == 1
        let has_digit = 0
        for j in 0..len(password)
            let ch2 = slice(password, j, j + 1)
            if ch2 >= "0"
                if ch2 <= "9"
                    has_digit = 1
        if has_digit == 0
            p["failures"] = p["failures"] + 1
            return err("missing digit")
    p["passes"] = p["passes"] + 1
    ok("strong")

fn pp_total_checks(p: dict) -> int
    p["checks"]

fn pp_pass_count(p: dict) -> int
    p["passes"]

fn pp_fail_count(p: dict) -> int
    p["failures"]
