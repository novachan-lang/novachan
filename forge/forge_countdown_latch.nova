// forge_countdown_latch — One-shot latch that releases when count reaches zero.

fn latch_new(count: int) -> dict
    let l = {}
    l["initial"] = count
    l["remaining"] = count
    l["released"] = 0
    l["countdowns"] = 0
    l

fn latch_countdown(l: dict) -> dict
    if l["remaining"] > 0
        l["remaining"] = l["remaining"] - 1
        l["countdowns"] = l["countdowns"] + 1
        if l["remaining"] == 0
            l["released"] = 1
    l

fn latch_is_released(l: dict) -> int
    l["released"]

fn latch_remaining(l: dict) -> int
    l["remaining"]

fn latch_initial_count(l: dict) -> int
    l["initial"]

fn latch_total_countdowns(l: dict) -> int
    l["countdowns"]

fn latch_progress(l: dict) -> int
    if l["initial"] == 0
        return 100
    (l["initial"] - l["remaining"]) * 100 / l["initial"]
