// forge_pwned -- Have-I-Been-Pwned k-anonymity password-breach check helper. SHA-1-hashes a password,
// uppercases the hex, and splits into a 5-char PREFIX (sent to the HIBP range API) + a 35-char SUFFIX (matched
// locally against the API response) -- so the full password/hash NEVER leaves the client. This module produces
// the prefix/suffix and matches a response; the caller makes the HTTP GET. Composes forge_crypto sha1.
import forge_crypto

fn _pwned_sha1_upper(password: string) -> string
    let bytes = []
    let i = 0
    while i < len(password)
        push(bytes, ord(char_at(password, i)))
        i = i + 1
    upper(hex_of(sha1_bytes(bytes)))

// The 5-char range-query prefix (send this to https://api.pwnedpasswords.com/range/<prefix>).
fn pwned_prefix(password: string) -> string
    slice(_pwned_sha1_upper(password), 0, 5)

// The 35-char suffix to match against the API response lines.
fn pwned_suffix(password: string) -> string
    let h = _pwned_sha1_upper(password)
    slice(h, 5, len(h))

// Given the range-API response body (lines "SUFFIX:count"), the breach count for this suffix (0 = not found).
fn pwned_count(suffix: string, response: string) -> int
    let lines = split(response, chr(10))
    let want = upper(trim(suffix))
    let i = 0
    while i < len(lines)
        let line = trim(lines[i])
        let colon = find(line, ":")
        if colon > 0
            if upper(slice(line, 0, colon)) == want
                return parse_int(slice(line, colon + 1, len(line)))
        i = i + 1
    0

// Convenience: was the password found in the response (count > 0)?
fn pwned_is_breached(password: string, response: string) -> bool
    pwned_count(pwned_suffix(password), response) > 0
