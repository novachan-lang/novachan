// forge_canary_deploy — Canary deployment with traffic splitting.

fn cd_new(canary_pct: int) -> dict
    let c = {}
    c["canary_pct"] = canary_pct
    c["canary_version"] = ""
    c["stable_version"] = ""
    c["canary_requests"] = 0
    c["stable_requests"] = 0
    c["canary_errors"] = 0
    c["stable_errors"] = 0
    c["status"] = "idle"
    c

fn cd_start(c: dict, stable_ver: string, canary_ver: string) -> dict
    c["stable_version"] = stable_ver
    c["canary_version"] = canary_ver
    c["status"] = "active"
    c

fn cd_route(c: dict, rand_pct: int) -> dict
    let result = {}
    if rand_pct < c["canary_pct"]
        c["canary_requests"] = c["canary_requests"] + 1
        result["version"] = c["canary_version"]
        result["is_canary"] = 1
    else
        c["stable_requests"] = c["stable_requests"] + 1
        result["version"] = c["stable_version"]
        result["is_canary"] = 0
    result["c"] = c
    result

fn cd_record_error(c: dict, is_canary: int) -> dict
    if is_canary == 1
        c["canary_errors"] = c["canary_errors"] + 1
    else
        c["stable_errors"] = c["stable_errors"] + 1
    c

fn cd_canary_error_rate(c: dict) -> int
    if c["canary_requests"] == 0
        return 0
    c["canary_errors"] * 100 / c["canary_requests"]

fn cd_promote(c: dict) -> dict
    c["stable_version"] = c["canary_version"]
    c["status"] = "promoted"
    c

fn cd_rollback(c: dict) -> dict
    c["canary_version"] = ""
    c["status"] = "rolled_back"
    c

fn cd_status(c: dict) -> string
    c["status"]
