// PRIVATE: alpha-3 -> alpha-2, for reverse lookup.
fn _c_a3_to_a2() -> dict
    let m = {}
    m["USA"] = "US"
    m["CAN"] = "CA"
    m["GBR"] = "GB"
    m["DEU"] = "DE"
    m["FRA"] = "FR"
    m["ITA"] = "IT"
    m["ESP"] = "ES"
    m["NLD"] = "NL"
    m["BEL"] = "BE"
    m["CHE"] = "CH"
    m["AUT"] = "AT"
    m["SWE"] = "SE"
    m["NOR"] = "NO"
    m["DNK"] = "DK"
    m["FIN"] = "FI"
    m["IRL"] = "IE"
    m["PRT"] = "PT"
    m["POL"] = "PL"
    m["RUS"] = "RU"
    m["UKR"] = "UA"
    m["IND"] = "IN"
    m["CHN"] = "CN"
    m["JPN"] = "JP"
    m["KOR"] = "KR"
    m["AUS"] = "AU"
    m["NZL"] = "NZ"
    m["BRA"] = "BR"
    m["MEX"] = "MX"
    m["ARG"] = "AR"
    m["CHL"] = "CL"
    m["COL"] = "CO"
    m["ZAF"] = "ZA"
    m["NGA"] = "NG"
    m["EGY"] = "EG"
    m["KEN"] = "KE"
    m["SAU"] = "SA"
    m["ARE"] = "AE"
    m["ISR"] = "IL"
    m["TUR"] = "TR"
    m["GRC"] = "GR"
    m["CZE"] = "CZ"
    m["HUN"] = "HU"
    m["ROU"] = "RO"
    m["SGP"] = "SG"
    m["MYS"] = "MY"
    m["THA"] = "TH"
    m["IDN"] = "ID"
    m["PHL"] = "PH"
    m["VNM"] = "VN"
    m["PAK"] = "PK"
    m

// True if the uppercased 2-letter code is a known country.
fn country_valid(alpha2: string) -> bool
    let m = _c_names()
    contains(m, upper(trim(alpha2)))

// The English name for an alpha-2 code, or "" if unknown.
fn country_name(alpha2: string) -> string
    let m = _c_names()
    let k = upper(trim(alpha2))
    if contains(m, k)
        return m[k]
    ""

// The alpha-3 code for an alpha-2 code, or "".
fn country_alpha3(alpha2: string) -> string
    let m = _c_alpha3()
    let k = upper(trim(alpha2))
    if contains(m, k)
        return m[k]
    ""

// The telephone calling code (e.g. "US" -> "1", "GB" -> "44"), or "".
fn country_calling_code(alpha2: string) -> string
    let m = _c_calling()
    let k = upper(trim(alpha2))
    if contains(m, k)
        return m[k]
    ""

// The alpha-2 code for a given alpha-3 (reverse lookup), or "".
fn country_from_alpha3(alpha3: string) -> string
    let m = _c_a3_to_a2()
    let k = upper(trim(alpha3))
    if contains(m, k)
        return m[k]
    ""
