// forge_logfmt -- logfmt structured logging: `key=value key2="quoted value"` lines (Heroku/go-kit/Splunk's
// native format, and the friendliest structured log for humans AND `grep`). Sits alongside JSON logging: JSON
// is machine-first, logfmt is the eyeball-and-grep-first line format. Encodes a dict to a logfmt line and
// decodes a line back to a dict, with correct quoting (a value containing a space, '=' or '"' is double-quoted
// with '"' and '\' backslash-escaped) and unquoting. A bare key with no '=' decodes to the string "true" (the
// logfmt boolean-flag convention). LEAF -- imports NOTHING.

// PRIVATE: does this value need quoting? (contains a space, '=', or a double-quote, or is empty AND we still
// emit it bare -- empty is emitted as `key=` which round-trips to "").
fn _lf_needs_quote(s: string) -> bool
    if find(s, " ") >= 0
        return true
    if find(s, "=") >= 0
        return true
    if find(s, chr(34)) >= 0
        return true
    false

// PRIVATE: escape '"' and '\' inside a value body for quoting.
fn _lf_escape(s: string) -> string
    let bs = chr(92)
    let q = chr(34)
    let out = ""
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        if c == bs
            out = out + bs + bs
        else
            if c == q
                out = out + bs + q
            else
                out = out + c
        i = i + 1
    out

// PRIVATE: render one value -- quoted+escaped when needed, otherwise bare.
fn _lf_value(s: string) -> string
    if _lf_needs_quote(s)
        return chr(34) + _lf_escape(s) + chr(34)
    s

// Encode a dict to a single logfmt line (keys in the dict's own order). Non-string values are str()'d first.
fn logfmt_encode(d: dict) -> string
    let ks = keys(d)
    let out = ""
    let i = 0
    while i < len(ks)
        let k = ks[i]
        let v = d[k]
        let vs = ""
        if type_of(v) == "string"
            vs = v
        else
            vs = str(v)
        if i > 0
            out = out + " "
        out = out + k + "=" + _lf_value(vs)
        i = i + 1
    out

// Decode a logfmt line into a dict of string values. Quoted values are unescaped; a bare key -> "true".
fn logfmt_decode(line: string) -> dict
    let d = {}
    let n = len(line)
    let q = chr(34)
    let bs = chr(92)
    let i = 0
    while i < n
        // skip inter-pair spaces
        while i < n and char_at(line, i) == " "
            i = i + 1
        if i >= n
            return d
        // read key up to '=' or space
        let ks = i
        while i < n and not (char_at(line, i) == "=") and not (char_at(line, i) == " ")
            i = i + 1
        let key = slice(line, ks, i)
        if i < n and char_at(line, i) == "="
            i = i + 1
            if i < n and char_at(line, i) == q
                // quoted value: consume until an unescaped closing quote
                i = i + 1
                let vb = ""
                while i < n and not (char_at(line, i) == q)
                    let c = char_at(line, i)
                    if c == bs and i + 1 < n
                        i = i + 1
                        vb = vb + char_at(line, i)
                    else
                        vb = vb + c
                    i = i + 1
                if i < n
                    i = i + 1
                if len(key) > 0
                    d[key] = vb
            else
                // bare value up to next space
                let vs = i
                while i < n and not (char_at(line, i) == " ")
                    i = i + 1
                if len(key) > 0
                    d[key] = slice(line, vs, i)
        else
            // bare key, no '=' -> boolean-flag convention
            if len(key) > 0
                d[key] = "true"
    d
