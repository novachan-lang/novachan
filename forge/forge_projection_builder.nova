// forge_projection_builder — Build read-model projections from event streams.

fn proj_new(name: string) -> dict
    {"name": name, "state": {}, "processed": 0, "last_version": 0, "errors": 0}

fn proj_apply(p: dict, event_type: string, key: string, value: string, version: int) -> dict
    if version <= p["last_version"]
        return p
    if event_type == "set"
        p["state"][key] = value
        p["processed"] += 1
        p["last_version"] = version
    else if event_type == "delete"
        let new_state = {}
        let ks = keys(p["state"])
        for i in 0..len(ks)
            if ks[i] != key
                new_state[ks[i]] = p["state"][ks[i]]
        p["state"] = new_state
        p["processed"] += 1
        p["last_version"] = version
    else
        p["errors"] += 1
    p

fn proj_get(p: dict, key: string) -> string
    if key not in p["state"]
        return ""
    p["state"][key]

fn proj_has(p: dict, key: string) -> int
    1 if key in p["state"] else 0

fn proj_size(p: dict) -> int
    len(keys(p["state"]))

fn proj_processed(p: dict) -> int
    p["processed"]

fn proj_last_version(p: dict) -> int
    p["last_version"]

fn proj_error_count(p: dict) -> int
    p["errors"]

fn proj_name(p: dict) -> string
    p["name"]
