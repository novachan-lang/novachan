// forge_message_priority — Priority message queue (flat dict, no lists-in-dicts).

fn mp_new() -> dict
    let m = {}
    m["msgs"] = {}
    m["msg_count"] = 0
    m["dequeued"] = 0
    m

fn mp_enqueue(m: dict, payload: string, priority: int) -> dict
    let k = str(m["msg_count"])
    m["msgs"][k + "_payload"] = payload
    m["msgs"][k + "_priority"] = priority
    m["msgs"][k + "_active"] = 1
    m["msg_count"] = m["msg_count"] + 1
    m

fn mp_dequeue(m: dict) -> dict
    let result = {}
    let best_idx = -1
    let best_pri = -1
    let i = 0
    while i < m["msg_count"]
        let k = str(i)
        let active = m["msgs"][k + "_active"]
        if active == 1
            let pri = m["msgs"][k + "_priority"]
            if pri > best_pri
                best_pri = pri
                best_idx = i
        i = i + 1
    if best_idx == -1
        result["found"] = 0
        result["payload"] = ""
        result["m"] = m
        return result
    let bk = str(best_idx)
    result["found"] = 1
    result["payload"] = m["msgs"][bk + "_payload"]
    result["priority"] = best_pri
    m["msgs"][bk + "_active"] = 0
    m["dequeued"] = m["dequeued"] + 1
    result["m"] = m
    result

fn mp_pending_count(m: dict) -> int
    let count = 0
    let i = 0
    while i < m["msg_count"]
        if m["msgs"][str(i) + "_active"] == 1
            count = count + 1
        i = i + 1
    count

fn mp_total_enqueued(m: dict) -> int
    m["msg_count"]

fn mp_total_dequeued(m: dict) -> int
    m["dequeued"]
