// forge_message_priority — Priority message queue (flat dict, no lists-in-dicts).

fn mp_new() -> dict
    {"msgs": {}, "msg_count": 0, "dequeued": 0}

fn mp_enqueue(m: dict, payload: string, priority: int) -> dict
    let k = str(m["msg_count"])
    m["msgs"][k + "_payload"] = payload
    m["msgs"][k + "_priority"] = priority
    m["msgs"][k + "_active"] = 1
    m["msg_count"] += 1
    m

fn mp_dequeue(m: dict) -> dict
    let best_idx = -1
    let best_pri = -1
    for i in 0..m["msg_count"]
        let k = str(i)
        let active = m["msgs"][k + "_active"]
        if active == 1
            let pri = m["msgs"][k + "_priority"]
            if pri > best_pri
                best_pri = pri
                best_idx = i
    if best_idx == -1
        return {"found": 0, "payload": "", "m": m}
    let bk = str(best_idx)
    let payload = m["msgs"][bk + "_payload"]
    m["msgs"][bk + "_active"] = 0
    m["dequeued"] += 1
    {"found": 1, "payload": payload, "priority": best_pri, "m": m}

fn mp_pending_count(m: dict) -> int
    len([i for i in 0..m["msg_count"] if m["msgs"][str(i) + "_active"] == 1])

fn mp_total_enqueued(m: dict) -> int
    m["msg_count"]

fn mp_total_dequeued(m: dict) -> int
    m["dequeued"]
