// forge_span_tracker — distributed tracing span tracking with Result API.

fn st_new() -> dict
    let s = {}
    s["spans"] = {}
    s["span_count"] = 0
    s["active"] = 0
    s["completed"] = 0
    s

fn st_start(s: dict, span_id: string, name: string, start_time: int) -> dict
    let key = "sp_" + span_id
    s["spans"][key] = name
    let tk = "ts_" + span_id
    s["spans"][tk] = start_time
    let sk = "st_" + span_id
    s["spans"][sk] = "active"
    s["span_count"] = s["span_count"] + 1
    s["active"] = s["active"] + 1
    s

fn st_end(s: dict, span_id: string, end_time: int) -> Result
    let sk = "st_" + span_id
    if contains(s["spans"], sk) != true
        return err("span not found")
    if s["spans"][sk] != "active"
        return err("span not active")
    s["spans"][sk] = "done"
    let ek = "te_" + span_id
    s["spans"][ek] = end_time
    s["active"] = s["active"] - 1
    s["completed"] = s["completed"] + 1
    ok(s)

fn st_duration(s: dict, span_id: string) -> Result
    let sk = "st_" + span_id
    if contains(s["spans"], sk) != true
        return err("span not found")
    if s["spans"][sk] != "done"
        return err("span not completed")
    let tk = "ts_" + span_id
    let ek = "te_" + span_id
    ok(s["spans"][ek] - s["spans"][tk])

fn st_name(s: dict, span_id: string) -> Result
    let key = "sp_" + span_id
    if contains(s["spans"], key) != true
        return err("span not found")
    ok(s["spans"][key])

fn st_is_active(s: dict, span_id: string) -> int
    let sk = "st_" + span_id
    if contains(s["spans"], sk) == true
        if s["spans"][sk] == "active"
            return 1
    0

fn st_active_count(s: dict) -> int
    s["active"]

fn st_completed_count(s: dict) -> int
    s["completed"]

fn st_total_count(s: dict) -> int
    s["span_count"]
