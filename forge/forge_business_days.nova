// forge_business_days -- business-day arithmetic (skip weekends). Imports forge_date.
import forge_date

fn _bd_is_weekend(epoch_day: int) -> bool
    let ymd = date_from_epoch_days(epoch_day)
    let wd = date_weekday(ymd[0], ymd[1], ymd[2])
    wd == 0 or wd == 6

fn is_business_day(y: int, m: int, d: int) -> bool
    not _bd_is_weekend(date_to_epoch_days(y, m, d))

fn business_days_between(y1: int, m1: int, d1: int, y2: int, m2: int, d2: int) -> int
    let a = date_to_epoch_days(y1, m1, d1)
    let b = date_to_epoch_days(y2, m2, d2)
    if b < a
        return 0
    let count = 0
    let day = a
    while day <= b
        if not _bd_is_weekend(day)
            count += 1
        day += 1
    count

fn add_business_days(y: int, m: int, d: int, n: int) -> list
    let day = date_to_epoch_days(y, m, d)
    let added = 0
    while added < n
        day += 1
        if not _bd_is_weekend(day)
            added += 1
    date_from_epoch_days(day)
