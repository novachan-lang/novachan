// forge_dag -- directed-acyclic-graph topological ordering + cycle detection: the scheduler behind build
// systems, task runners, DB-migration ordering, and dependency resolution. Declare nodes + "A depends on B"
// edges, then dag_topo_sort returns a valid execution order (every dependency before its dependents) or []
// if a cycle exists. Simple repeated-ready-emission (Kahn-style). LEAF -- imports NOTHING.

fn dag_new() -> dict
    let g = {}
    g["deps"] = {}
    g["nodes"] = []
    g

fn _dag_ensure(g: dict, node: string)
    let nodes = g["nodes"]
    if contains(nodes, node) == false
        push(nodes, node)
    let deps = g["deps"]
    if contains(deps, node) == false
        deps[node] = []

// Declare that `node` depends on `dependency` (the dependency must run first). Fluent.
fn dag_add(g: dict, node: string, dependency: string) -> dict
    _dag_ensure(g, node)
    _dag_ensure(g, dependency)
    let d = g["deps"]
    let dl = d[node]
    if contains(dl, dependency) == false
        push(dl, dependency)
    g

// Register a standalone node with no dependencies. Fluent.
fn dag_node(g: dict, node: string) -> dict
    _dag_ensure(g, node)
    g

// A topological order (dependencies before dependents), or [] if the graph has a cycle.
fn dag_topo_sort(g: dict) -> list
    let nodes = g["nodes"]
    let deps = g["deps"]
    let done = {}
    let order = []
    let progress = true
    while len(order) < len(nodes) and progress
        progress = false
        let i = 0
        while i < len(nodes)
            let node = nodes[i]
            if contains(done, node) == false
                let d = deps[node]
                let ready = true
                let j = 0
                while j < len(d)
                    if contains(done, d[j]) == false
                        ready = false
                    j = j + 1
                if ready
                    push(order, node)
                    done[node] = 1
                    progress = true
            i = i + 1
    if len(order) < len(nodes)
        return []
    order

// True if the graph contains a cycle (topological sort is impossible).
fn dag_has_cycle(g: dict) -> bool
    len(dag_topo_sort(g)) < len(g["nodes"])
