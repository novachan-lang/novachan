// forge_circuit_panel — multi-circuit dashboard with aggregate stats and Result API.

fn cpanel_new() -> dict
    let c = {}
    c["circuit_count"] = 0
    c["total_trips"] = 0
    c

fn cpanel_add_circuit(c: dict, name: string, threshold: int) -> dict
    c["cc_" + name + "_threshold"] = threshold
    c["cc_" + name + "_failures"] = 0
    c["cc_" + name + "_state"] = "closed"
    c["cc_" + name + "_calls"] = 0
    c["circuit_count"] = c["circuit_count"] + 1
    c

fn cpanel_record_success(c: dict, name: string) -> Result
    let sk = "cc_" + name + "_state"
    if sk not in c
        return err("circuit not found: " + name)
    c["cc_" + name + "_calls"] = c["cc_" + name + "_calls"] + 1
    c["cc_" + name + "_failures"] = 0
    if c[sk] == "open"
        c[sk] = "closed"
    ok(c)

fn cpanel_record_failure(c: dict, name: string) -> Result
    let sk = "cc_" + name + "_state"
    if sk not in c
        return err("circuit not found: " + name)
    c["cc_" + name + "_calls"] = c["cc_" + name + "_calls"] + 1
    c["cc_" + name + "_failures"] = c["cc_" + name + "_failures"] + 1
    if c["cc_" + name + "_failures"] >= c["cc_" + name + "_threshold"]
        if c[sk] != "open"
            c[sk] = "open"
            c["total_trips"] = c["total_trips"] + 1
    ok(c)

fn cpanel_state(c: dict, name: string) -> Result
    let sk = "cc_" + name + "_state"
    if sk not in c
        return err("circuit not found: " + name)
    ok(c[sk])

fn cpanel_failures(c: dict, name: string) -> Result
    let fk = "cc_" + name + "_failures"
    if fk not in c
        return err("circuit not found: " + name)
    ok(c[fk])

fn cpanel_circuit_count(c: dict) -> int
    c["circuit_count"]

fn cpanel_total_trips(c: dict) -> int
    c["total_trips"]
