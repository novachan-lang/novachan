// forge_compress -- opt-in gzip response compression for Forge. Bundles the pure-NOVA RFC-1951 DEFLATE
// engine (deflatex) and the gzip wrapper, exposed as a middleware. Kept OUT of base forge so apps that
// don't compress don't pull the deflate code. Usage:
//   import forge
//   import forge_compress
//   forge.use(app, forge_compress.mw_compress())
// The compressed body is a first-class NovaBytes, so it rides the binary Response wire path (tcp_send_bytes).
import forge
import deflatex

// Build a first-class NovaBytes from a list of byte values (deflatex emits compressed output as a list).
fn _list_to_bytes(lst)
    let n = len(lst)
    let b = bytes(n)
    let i = 0
    while i < n
        bytes_set(b, i, lst[i])
        i = i + 1
    b

// gzip-compress a string -> a binary NovaBytes (RFC 1952: gzip header + DEFLATE + CRC32 + ISIZE).
fn gzip_bytes(s: string)
    _list_to_bytes(deflatex.gzip_compress(deflatex.str_to_bytes(s)))

// Middleware: when the client sends Accept-Encoding: gzip and the response is a text body over the
// threshold, replace the body with its gzip bytes and set Content-Encoding: gzip. Binary bodies
// (type_name != "string"), small bodies, and clients that don't accept gzip pass through unchanged.
fn _compress_next(req, next)
    let resp = next(req)
    let ae = forge.req_header(req, "accept-encoding")
    if find(ae, "gzip") < 0
        return resp
    if type_name(resp.body) != "string"
        return resp
    if len(resp.body) < 1024
        return resp
    resp.headers["Content-Encoding"] = "gzip"
    resp.body = gzip_bytes(resp.body)
    resp

fn mw_compress()
    return fn(req, next) _compress_next(req, next)
