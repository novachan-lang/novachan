// forge_pub_sub_broker — In-process pub/sub broker with topics.

fn psb_new() -> dict
    {"subs": {}, "sub_count": 0, "msgs": {}, "msg_count": 0, "published": 0, "delivered": 0}

fn psb_subscribe(b: dict, topic: string, subscriber: string) -> dict
    let k = str(b["sub_count"])
    b["subs"]["{k}_topic"] = topic
    b["subs"]["{k}_sub"] = subscriber
    b["sub_count"] += 1
    b

fn psb_publish(b: dict, topic: string, payload: string) -> dict
    b["published"] += 1
    for i in 0..b["sub_count"]
        let k = str(i)
        if b["subs"]["{k}_topic"] == topic
            let mk = str(b["msg_count"])
            b["msgs"]["{mk}_sub"] = b["subs"]["{k}_sub"]
            b["msgs"]["{mk}_topic"] = topic
            b["msgs"]["{mk}_payload"] = payload
            b["msg_count"] += 1
            b["delivered"] += 1
    b

fn psb_pending_count(b: dict) -> int
    b["msg_count"]

fn psb_sub_count_for(b: dict, topic: string) -> int
    let count = 0
    for i in 0..b["sub_count"]
        let k = str(i)
        if b["subs"]["{k}_topic"] == topic
            count += 1
    count

fn psb_total_published(b: dict) -> int
    b["published"]

fn psb_total_delivered(b: dict) -> int
    b["delivered"]

fn psb_msg_payload(b: dict, idx: int) -> string
    let k = str(idx)
    b["msgs"]["{k}_payload"]

fn psb_msg_subscriber(b: dict, idx: int) -> string
    let k = str(idx)
    b["msgs"]["{k}_sub"]
