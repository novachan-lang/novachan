// forge_shellquote -- POSIX shell-argument quoting to PREVENT COMMAND INJECTION when a program must build a
// shell command line (CLI wrappers, subprocess invocation). Wrapping an argument in single quotes and escaping
// embedded single quotes as '\'' makes the shell treat it as ONE literal token -- no $ ` " \ ; | & newline is
// ever interpreted. (Prefer a real argv-array exec API where available; use this only when a string command
// line is unavoidable.) LEAF -- imports NOTHING.

// Single-quote `arg` so the POSIX shell sees exactly one literal token. An embedded ' becomes the 4-char
// sequence '\'' (close-quote, escaped-quote, reopen-quote).
fn shell_quote(arg: string) -> string
    let q = chr(39)
    let bs = chr(92)
    let out = q
    let i = 0
    while i < len(arg)
        let c = char_at(arg, i)
        if c == q
            out = out + q + bs + q + q
        else
            out = out + c
        i = i + 1
    out + q

// Quote each arg and join into one space-separated command line.
fn shell_join(args: list) -> string
    let out = ""
    let i = 0
    while i < len(args)
        if i > 0
            out = out + " "
        out = out + shell_quote(args[i])
        i = i + 1
    out

// Is `arg` composed only of shell-safe chars (alnum plus - _ . / @ %), so it needs no quoting? Informational --
// shell_quote is always safe to apply regardless.
fn shell_is_safe(arg: string) -> bool
    if len(arg) == 0
        return false
    let safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_./@%"
    let i = 0
    while i < len(arg)
        if find(safe, char_at(arg, i)) < 0
            return false
        i = i + 1
    true
