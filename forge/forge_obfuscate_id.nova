// forge_obfuscate_id -- REVERSIBLY scramble a sequential integer id so consecutive ids don't look consecutive
// in public URLs (hide row order + total count, with NO lookup table). Uses a modular-multiplicative
// permutation over M = 2^31-1 (a Mersenne prime): encode = (id*K) mod M; decode = (x*Kinv) mod M, where Kinv is
// K's modular inverse (Fermat/extended-Euclid). Bijective for ids in [1, M-1]. Pair with forge_base62 for a
// short opaque code. LEAF -- imports NOTHING.

fn _obf_m() -> int
    2147483647

fn _obf_k() -> int
    1500450271

// PRIVATE: modular inverse of a mod m (extended Euclid).
fn _obf_inverse(a: int, m: int) -> int
    let t = 0
    let newt = 1
    let r = m
    let newr = a
    while newr != 0
        let q = r / newr
        let tmp = newt
        newt = t - q * newt
        t = tmp
        let tmp2 = newr
        newr = r - q * newr
        r = tmp2
    if t < 0
        t = t + m
    t

// Scramble an id (1 .. 2^31-2) to an opaque number. id*K fits in i64 before the mod.
fn obfuscate_encode(id: int) -> int
    (id * _obf_k()) % _obf_m()

// Recover the original id.
fn obfuscate_decode(x: int) -> int
    (x * _obf_inverse(_obf_k(), _obf_m())) % _obf_m()
