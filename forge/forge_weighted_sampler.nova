// forge_weighted_sampler — weighted random sampling with Result API.

fn ws_new() -> dict
    let w = {}
    w["items"] = {}
    w["weights"] = {}
    w["total_weight"] = 0
    w["item_count"] = 0
    w

fn ws_add(w: dict, item: string, weight: int) -> dict
    let ik = "i_" + str(w["item_count"])
    let wk = "w_" + str(w["item_count"])
    w["items"][ik] = item
    w["weights"][wk] = weight
    w["total_weight"] = w["total_weight"] + weight
    w["item_count"] = w["item_count"] + 1
    w

fn ws_sample(w: dict, seed: int) -> Result
    if w["item_count"] == 0
        return err("no items")
    let target = seed % w["total_weight"]
    if target < 0
        target = 0 - target
    let cumulative = 0
    let i = 0
    while i < w["item_count"]
        let wk = "w_" + str(i)
        cumulative += w["weights"][wk]
        if target < cumulative
            let ik = "i_" + str(i)
            return ok(w["items"][ik])
        i += 1
    let last = "i_" + str(w["item_count"] - 1)
    ok(w["items"][last])

fn ws_total_weight(w: dict) -> int
    w["total_weight"]

fn ws_item_count(w: dict) -> int
    w["item_count"]

fn ws_weight_at(w: dict, index: int) -> Result
    if index < 0 or index >= w["item_count"]
        return err("index out of range")
    let wk = "w_" + str(index)
    ok(w["weights"][wk])
