// forge_binomial -- binomial and Poisson probability distributions.
// Imports forge_combinatorics (n-choose-k).

import forge_combinatorics

fn binom_pmf(n: int, k: int, p: float) -> float
    if k < 0 or k > n
        return 0.0
    let c = n_choose(n, k) * 1.0
    let pk = pow(p * 1.0, k * 1.0)
    let qnk = pow(1.0 - p * 1.0, (n - k) * 1.0)
    c * pk * qnk

fn binom_cdf(n: int, k: int, p: float) -> float
    let total = 0.0
    for i in 0..min(k, n) + 1
        total += binom_pmf(n, i, p)
    total

fn binom_mean(n: int, p: float) -> float
    (n * 1.0) * (p * 1.0)

fn binom_variance(n: int, p: float) -> float
    (n * 1.0) * (p * 1.0) * (1.0 - p * 1.0)

fn poisson_pmf(k: int, lambda: float) -> float
    if k < 0
        return 0.0
    let ratio = 1.0
    for i in 1..k + 1
        ratio = ratio * (lambda * 1.0) / (i * 1.0)
    ratio * exp(-lambda * 1.0)

fn poisson_cdf(k: int, lambda: float) -> float
    let total = 0.0
    for i in 0..k + 1
        total += poisson_pmf(i, lambda)
    total
