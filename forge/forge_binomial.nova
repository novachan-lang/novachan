// forge_binomial -- the binomial and Poisson probability distributions: the math of "how likely is exactly k
// successes?" The BINOMIAL answers it for n independent yes/no trials each succeeding with probability p --
// conversion counts in an A/B test, defects in a batch, heads in coin flips, "at least k of n servers up". The
// POISSON is its limit for rare events over an interval given an average rate lambda -- arrivals per minute,
// requests per second, typos per page, defects per meter. Both give the point probability (pmf), the cumulative
// probability up to k (cdf), and the distribution's mean/variance for quick sanity checks and capacity planning.
// Imports forge_combinatorics (n-choose-k). Poisson is computed by an incremental product (no factorial
// overflow, exp used inline).

import forge_combinatorics

// Binomial pmf: P(exactly k successes in n trials) = C(n,k) * p^k * (1-p)^(n-k). 0 if k out of range.
fn binom_pmf(n: int, k: int, p: float) -> float
    let out = 0.0
    if k >= 0 and k <= n
        let c = n_choose(n, k) * 1.0
        let pk = pow(p * 1.0, k * 1.0)
        let qnk = pow(1.0 - p * 1.0, (n - k) * 1.0)
        out = c * pk * qnk
    out

// Binomial cdf: P(at most k successes) = sum_{i=0}^{k} pmf(n,i,p).
fn binom_cdf(n: int, k: int, p: float) -> float
    let total = 0.0
    let i = 0
    while i <= k and i <= n
        total += binom_pmf(n, i, p)
        i += 1
    total

// Mean of a binomial(n,p) = n*p.
fn binom_mean(n: int, p: float) -> float
    let m = (n * 1.0) * (p * 1.0)
    m

// Variance of a binomial(n,p) = n*p*(1-p).
fn binom_variance(n: int, p: float) -> float
    let v = (n * 1.0) * (p * 1.0) * (1.0 - p * 1.0)
    v

// Poisson pmf: P(exactly k events) = e^(-lambda) * lambda^k / k!. Computed incrementally to avoid overflow;
// exp is applied inline. lambda >= 0, k >= 0.
fn poisson_pmf(k: int, lambda: float) -> float
    let out = 0.0
    if k >= 0
        // running product p = lambda^k / k!, then multiply by e^(-lambda) inline at the end
        let ratio = 1.0
        let i = 1
        while i <= k
            ratio = ratio * (lambda * 1.0) / (i * 1.0)
            i += 1
        out = ratio * exp(0.0 - lambda * 1.0)
    out

// Poisson cdf: P(at most k events) = sum_{i=0}^{k} poisson_pmf(i, lambda).
fn poisson_cdf(k: int, lambda: float) -> float
    let total = 0.0
    let i = 0
    while i <= k
        total += poisson_pmf(i, lambda)
        i += 1
    total
