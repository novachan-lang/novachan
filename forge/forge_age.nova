// forge_age -- compute a person's age in whole YEARS from a birthdate + reference date, correctly handling
// whether this year's birthday has already passed. For age-gating (18+/21+), eligibility checks, and profile
// display. Pure y/m/d comparison. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. The "has this year's birthday happened yet" test was a nested if/else subtracting
// 1 from a mutable `years`, with the month case and the same-month/day case in separate branches. That
// is one comparison: is (ref_m, ref_d) before (birth_m, birth_d)? Stated directly as _before_in_year,
// it is checkable at a glance -- which matters for a function whose whole job is an off-by-one, and
// which gates 18+ decisions.
//
// Every function took SIX loose integers, so a caller could transpose month and day (or birth and
// reference) and get a plausible wrong answer with no error. A date is one thing: `type Ymd` makes
// that transposition a compile error, and the six-argument entry points are kept as thin adapters
// because existing callers pass loose ints.

// A calendar date. Three loose ints in a fixed order is exactly the shape that gets transposed.
type Ymd
    y: int
    m: int
    d: int

// PRIVATE: is (m, d) of `a` earlier in the year than (m, d) of `b`? Chained comparison on the pair,
// which is the whole of the birthday-not-yet-reached rule.
fn _before_in_year(a: Ymd, b: Ymd) -> bool
    a.m < b.m or (a.m == b.m and a.d < b.d)

// Age in whole years on the `ref` date. Subtracts one if the birthday hasn't occurred yet this year.
// A future birthdate -> 0. Exact-birthday counts as reached (it is not "before").
fn age_of(birth: Ymd, ref: Ymd) -> int
    let years = ref.y - birth.y
    let adjusted = years - 1 if _before_in_year(ref, birth) else years
    max(adjusted, 0)

// Six-int entry point, contract UNCHANGED.
fn age_years(birth_y: int, birth_m: int, birth_d: int, ref_y: int, ref_m: int, ref_d: int) -> int
    age_of(Ymd(birth_y, birth_m, birth_d), Ymd(ref_y, ref_m, ref_d))

// Is the person at least `min_age` on the reference date? (age-gating). Exact-birthday counts as reached.
fn age_at_least_of(birth: Ymd, ref: Ymd, min_age: int) -> bool
    age_of(birth, ref) >= min_age

fn age_at_least(birth_y: int, birth_m: int, birth_d: int, ref_y: int, ref_m: int, ref_d: int, min_age: int) -> bool
    age_at_least_of(Ymd(birth_y, birth_m, birth_d), Ymd(ref_y, ref_m, ref_d), min_age)

// Is today the person's birthday? Age-gating's companion question, and the one place the day-of-year
// comparison is an equality rather than an ordering.
fn age_is_birthday(birth: Ymd, ref: Ymd) -> bool
    birth.m == ref.m and birth.d == ref.d

// Whole years until the person reaches `target_age`, or 0 if already reached. What an eligibility
// screen shows next to a rejection.
fn age_years_until(birth: Ymd, ref: Ymd, target_age: int) -> int
    max(target_age - age_of(birth, ref), 0)

// Everyone in `births` who is at least `min_age` on `ref` -- a filtered comprehension, so a
// bulk eligibility screen is not a loop at every call site.
fn age_eligible(births: list, ref: Ymd, min_age: int) -> list
    [b for b in births if age_at_least_of(b, ref, min_age)]

// Is EVERY person old enough? / is ANY person too young? Short-circuiting, which is what a
// group-eligibility gate wants -- it should stop at the first failure.
fn age_all_at_least(births: list, ref: Ymd, min_age: int) -> bool
    all_match(births, (b) => age_at_least_of(b, ref, min_age))

fn age_any_under(births: list, ref: Ymd, min_age: int) -> bool
    any_match(births, (b) => not age_at_least_of(b, ref, min_age))
