// forge_network_simulator — Simulate network latency and packet loss.

fn ns_new() -> dict
    let n = {}
    n["links"] = {}
    n["link_count"] = 0
    n["packets_sent"] = 0
    n["packets_dropped"] = 0
    n

fn ns_add_link(n: dict, from_n: string, to_n: string, latency_ms: int, loss_pct: int) -> dict
    let k = str(n["link_count"])
    n["links"][k + "_from"] = from_n
    n["links"][k + "_to"] = to_n
    n["links"][k + "_latency"] = latency_ms
    n["links"][k + "_loss"] = loss_pct
    n["link_count"] = n["link_count"] + 1
    n

fn ns_find_link(n: dict, from_n: string, to_n: string) -> int
    let i = 0
    while i < n["link_count"]
        let k = str(i)
        if n["links"][k + "_from"] == from_n
            if n["links"][k + "_to"] == to_n
                return i
        i += 1
    -1

fn ns_send(n: dict, from_n: string, to_n: string, rand_pct: int) -> dict
    let result = {}
    n["packets_sent"] = n["packets_sent"] + 1
    let idx = ns_find_link(n, from_n, to_n)
    if idx == -1
        result["delivered"] = 0
        result["latency"] = 0
        result["reason"] = "no_link"
        result["n"] = n
        return result
    let loss = n["links"][str(idx) + "_loss"]
    if rand_pct < loss
        n["packets_dropped"] = n["packets_dropped"] + 1
        result["delivered"] = 0
        result["latency"] = 0
        result["reason"] = "dropped"
        result["n"] = n
        return result
    result["delivered"] = 1
    result["latency"] = n["links"][str(idx) + "_latency"]
    result["reason"] = ""
    result["n"] = n
    result

fn ns_total_sent(n: dict) -> int
    n["packets_sent"]

fn ns_total_dropped(n: dict) -> int
    n["packets_dropped"]

fn ns_delivery_rate(n: dict) -> int
    if n["packets_sent"] == 0
        return 100
    (n["packets_sent"] - n["packets_dropped"]) * 100 / n["packets_sent"]
