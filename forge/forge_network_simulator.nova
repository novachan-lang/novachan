// forge_network_simulator — Simulate network latency and packet loss.

fn ns_new() -> dict
    {"links": {}, "link_count": 0, "packets_sent": 0, "packets_dropped": 0}

fn ns_add_link(n: dict, from_n: string, to_n: string, latency_ms: int, loss_pct: int) -> dict
    let k = str(n["link_count"])
    n["links"]["{k}_from"] = from_n
    n["links"]["{k}_to"] = to_n
    n["links"]["{k}_latency"] = latency_ms
    n["links"]["{k}_loss"] = loss_pct
    n["link_count"] += 1
    n

fn ns_find_link(n: dict, from_n: string, to_n: string) -> int
    for i in 0..n["link_count"]
        let k = str(i)
        if n["links"]["{k}_from"] == from_n
            if n["links"]["{k}_to"] == to_n
                return i
    -1

fn ns_send(n: dict, from_n: string, to_n: string, rand_pct: int) -> dict
    n["packets_sent"] += 1
    let idx = ns_find_link(n, from_n, to_n)
    if idx == -1
        return {"delivered": 0, "latency": 0, "reason": "no_link", "n": n}
    let k = str(idx)
    let loss = n["links"]["{k}_loss"]
    if rand_pct < loss
        n["packets_dropped"] += 1
        return {"delivered": 0, "latency": 0, "reason": "dropped", "n": n}
    let lat = n["links"]["{k}_latency"]
    {"delivered": 1, "latency": lat, "reason": "", "n": n}

fn ns_total_sent(n: dict) -> int
    n["packets_sent"]

fn ns_total_dropped(n: dict) -> int
    n["packets_dropped"]

fn ns_delivery_rate(n: dict) -> int
    if n["packets_sent"] == 0
        return 100
    (n["packets_sent"] - n["packets_dropped"]) * 100 / n["packets_sent"]
