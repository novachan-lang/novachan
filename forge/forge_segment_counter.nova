// forge_segment_counter — Count events in time segments (windowed counters).

fn sc_new(segment_duration: int) -> dict
    let s = {}
    s["duration"] = segment_duration
    s["segments"] = {}
    s["total"] = 0
    s

fn sc_segment_key(duration: int, timestamp: int) -> string
    let seg = timestamp / duration
    str(seg)

fn sc_increment(s: dict, timestamp: int) -> dict
    let k = sc_segment_key(s["duration"], timestamp)
    let has = contains(s["segments"], k)
    if has == true
        s["segments"][k] = s["segments"][k] + 1
    else
        s["segments"][k] = 1
    s["total"] = s["total"] + 1
    s

fn sc_count_at(s: dict, timestamp: int) -> int
    let k = sc_segment_key(s["duration"], timestamp)
    let has = contains(s["segments"], k)
    if has != true
        return 0
    s["segments"][k]

fn sc_count_range(s: dict, start_ts: int, end_ts: int) -> int
    let total = 0
    let t = start_ts
    while t < end_ts
        total += sc_count_at(s, t)
        t += s["duration"]
    total

fn sc_total(s: dict) -> int
    s["total"]

fn sc_segment_count(s: dict) -> int
    len(keys(s["segments"]))
