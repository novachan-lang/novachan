// forge_orderset -- an ordered SET with ORDER STATISTICS: a collection of distinct integers kept in sorted order
// that, beyond the usual add/remove/contains, answers the two questions a plain set or dict CAN'T -- "what is the
// k-th smallest element?" (select) and "how many elements are smaller than x?" (rank). Those power leaderboards
// ("what rank is this score? who is in 5th place?"), running percentiles/medians over a live dataset, "how many
// values so far are below this threshold", and nearest-neighbor lookups (floor/ceiling). It's backed by a sorted
// array with binary search, so contains/rank/select/floor/ceiling are O(log n) (select is O(1)) and add/remove are
// O(n) shifts -- ideal for moderate sets that are queried far more than they change. Elements are integers and
// unique (a set). floor/ceiling return [found, value] to avoid an ambiguous sentinel. LEAF -- imports NOTHING.

// A new empty ordered set.
fn os_new() -> list
    []

// PRIVATE: first index i with s[i] >= x (0..len).
fn _os_lower(s: list, x: int) -> int
    let lo = 0
    let hi = len(s)
    while lo < hi
        let mid = (lo + hi) / 2
        if s[mid] < x
            lo = mid + 1
        else
            hi = mid
    lo

// PRIVATE: first index i with s[i] > x (0..len).
fn _os_upper(s: list, x: int) -> int
    let lo = 0
    let hi = len(s)
    while lo < hi
        let mid = (lo + hi) / 2
        if s[mid] <= x
            lo = mid + 1
        else
            hi = mid
    lo

// Add x (no effect if already present). Keeps the set sorted.
fn os_add(s: list, x: int)
    let p = _os_lower(s, x)
    if p >= len(s) or s[p] != x
        // insert x at position p by shifting right
        push(s, 0)
        let i = len(s) - 1
        while i > p
            s[i] = s[i - 1]
            i = i - 1
        s[p] = x

// Remove x if present; returns true if something was removed.
fn os_remove(s: list, x: int) -> bool
    let out = false
    let p = _os_lower(s, x)
    if p < len(s) and s[p] == x
        let i = p
        while i < len(s) - 1
            s[i] = s[i + 1]
            i = i + 1
        pop(s)
        out = true
    out

// True if x is in the set.
fn os_contains(s: list, x: int) -> bool
    let p = _os_lower(s, x)
    let out = false
    if p < len(s) and s[p] == x
        out = true
    out

// The number of elements strictly less than x (its rank / how many come before it).
fn os_rank(s: list, x: int) -> int
    _os_lower(s, x)

// The k-th smallest element (0-indexed). Caller ensures 0 <= k < size.
fn os_kth(s: list, k: int) -> int
    s[k]

// The number of elements in the inclusive range [lo, hi].
fn os_count_range(s: list, lo: int, hi: int) -> int
    _os_upper(s, hi) - _os_lower(s, lo)

// The elements in [lo, hi] inclusive, ascending.
fn os_range(s: list, lo: int, hi: int) -> list
    let out = []
    let i = _os_lower(s, lo)
    let end = _os_upper(s, hi)
    while i < end
        push(out, s[i])
        i = i + 1
    out

// The largest element <= x, as [found, value].
fn os_floor(s: list, x: int) -> list
    let idx = _os_upper(s, x) - 1
    let out = [0, 0]
    if idx >= 0
        out = [1, s[idx]]
    out

// The smallest element >= x, as [found, value].
fn os_ceiling(s: list, x: int) -> list
    let idx = _os_lower(s, x)
    let out = [0, 0]
    if idx < len(s)
        out = [1, s[idx]]
    out

// The number of elements.
fn os_size(s: list) -> int
    len(s)
