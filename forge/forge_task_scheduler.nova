// forge_task_scheduler — Priority-based task scheduler with deadlines.

fn ts_new() -> dict
    let ts = {}
    ts["tasks"] = {}
    ts["count"] = 0
    ts["completed"] = 0
    ts["failed"] = 0
    ts["next_id"] = 1
    ts

fn ts_add(ts: dict, name: string, priority: int, deadline: int) -> dict
    let id = ts["next_id"]
    let k = str(id)
    ts["next_id"] = id + 1
    ts["tasks"][k + "_name"] = name
    ts["tasks"][k + "_priority"] = priority
    ts["tasks"][k + "_deadline"] = deadline
    ts["tasks"][k + "_status"] = "pending"
    ts["count"] = ts["count"] + 1
    ts

fn ts_next(ts: dict) -> dict
    let result = {}
    result["name"] = ""
    result["id"] = 0
    result["priority"] = 0
    let best_pri = -1
    let best_id = 0
    let i = 1
    while i < ts["next_id"]
        let k = str(i)
        let has = contains(ts["tasks"], k + "_status")
        if has == true
            if ts["tasks"][k + "_status"] == "pending"
                let pri = ts["tasks"][k + "_priority"]
                if pri > best_pri
                    best_pri = pri
                    best_id = i
        i = i + 1
    if best_id > 0
        let bk = str(best_id)
        result["name"] = ts["tasks"][bk + "_name"]
        result["id"] = best_id
        result["priority"] = ts["tasks"][bk + "_priority"]
    result

fn ts_complete(ts: dict, task_id: int) -> dict
    let k = str(task_id)
    let has = contains(ts["tasks"], k + "_status")
    if has == true
        ts["tasks"][k + "_status"] = "completed"
        ts["completed"] = ts["completed"] + 1
    ts

fn ts_fail(ts: dict, task_id: int) -> dict
    let k = str(task_id)
    let has = contains(ts["tasks"], k + "_status")
    if has == true
        ts["tasks"][k + "_status"] = "failed"
        ts["failed"] = ts["failed"] + 1
    ts

fn ts_pending_count(ts: dict) -> int
    let count = 0
    let i = 1
    while i < ts["next_id"]
        let k = str(i)
        let has = contains(ts["tasks"], k + "_status")
        if has == true
            if ts["tasks"][k + "_status"] == "pending"
                count = count + 1
        i = i + 1
    count

fn ts_completed_count(ts: dict) -> int
    ts["completed"]

fn ts_total_count(ts: dict) -> int
    ts["count"]
