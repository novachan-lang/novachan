// forge_task_scheduler — priority task scheduler with Result API.

fn ts_new() -> dict
    let s = {}
    s["tasks"] = {}
    s["task_count"] = 0
    s["completed"] = 0
    s["failed"] = 0
    s

fn ts_add(s: dict, name: string, priority: int) -> dict
    let key = "task_" + str(s["task_count"])
    s["tasks"][key + "_name"] = name
    s["tasks"][key + "_priority"] = priority
    s["tasks"][key + "_status"] = "pending"
    s["task_count"] = s["task_count"] + 1
    s

fn ts_next(s: dict) -> Result
    let best_idx = -1
    let best_pri = -1
    let i = 0
    while i < s["task_count"]
        let key = "task_" + str(i)
        if s["tasks"][key + "_status"] == "pending"
            if s["tasks"][key + "_priority"] > best_pri
                best_pri = s["tasks"][key + "_priority"]
                best_idx = i
        i = i + 1
    if best_idx == -1
        return err("no pending tasks")
    let key = "task_" + str(best_idx)
    ok(s["tasks"][key + "_name"])

fn ts_complete(s: dict, name: string) -> Result
    let i = 0
    while i < s["task_count"]
        let key = "task_" + str(i)
        if s["tasks"][key + "_name"] == name and s["tasks"][key + "_status"] == "pending"
            s["tasks"][key + "_status"] = "completed"
            s["completed"] = s["completed"] + 1
            return ok(s)
        i = i + 1
    err("task not found or not pending: " + name)

fn ts_fail(s: dict, name: string) -> Result
    let i = 0
    while i < s["task_count"]
        let key = "task_" + str(i)
        if s["tasks"][key + "_name"] == name and s["tasks"][key + "_status"] == "pending"
            s["tasks"][key + "_status"] = "failed"
            s["failed"] = s["failed"] + 1
            return ok(s)
        i = i + 1
    err("task not found or not pending: " + name)

fn ts_pending_count(s: dict) -> int
    s["task_count"] - s["completed"] - s["failed"]

fn ts_completion_rate(s: dict) -> int
    if s["task_count"] == 0
        return 0
    s["completed"] * 100 / s["task_count"]

fn ts_task_count(s: dict) -> int
    s["task_count"]
