// forge_content_store — Content management (CMS-lite).
// Content types, entries, versioning, publish/draft status.

fn cms_new() -> dict
    let c = {}
    c["types"] = {}
    c["entries"] = {}
    c["next_id"] = 1
    c

fn cms_define_type(cms: dict, name: string, fields: list) -> dict
    let t = {}
    t["fields"] = fields
    cms["types"][name] = t
    cms

fn cms_create_entry(cms: dict, content_type: string, data: dict) -> dict
    let id = cms["next_id"]
    cms["next_id"] = id + 1
    let entry = {}
    entry["id"] = id
    entry["type"] = content_type
    entry["data"] = data
    entry["status"] = "draft"
    entry["version"] = 1
    cms["entries"][str(id)] = entry
    cms["_last_id"] = id
    cms

fn cms_last_id(cms: dict) -> int
    cms["_last_id"]

fn cms_publish(cms: dict, id: int) -> dict
    let sid = str(id)
    let has_entry = contains(cms["entries"], sid)
    if has_entry == true
        cms["entries"][sid]["status"] = "published"
    cms

fn cms_unpublish(cms: dict, id: int) -> dict
    let sid = str(id)
    let has_entry = contains(cms["entries"], sid)
    if has_entry == true
        cms["entries"][sid]["status"] = "draft"
    cms

fn cms_update(cms: dict, id: int, field: string, value: any) -> dict
    let sid = str(id)
    let has_entry = contains(cms["entries"], sid)
    if has_entry == true
        cms["entries"][sid]["data"][field] = value
        cms["entries"][sid]["version"] = cms["entries"][sid]["version"] + 1
    cms

fn cms_get(cms: dict, id: int) -> dict
    let sid = str(id)
    let has_entry = contains(cms["entries"], sid)
    if has_entry == true
        return cms["entries"][sid]
    let empty = {}
    empty

fn cms_query_type(cms: dict, content_type: string) -> list
    let result = []
    let ids = keys(cms["entries"])
    for i in 0..len(ids)
        let entry = cms["entries"][ids[i]]
        if entry["type"] == content_type
            if entry["status"] == "published"
                push(result, entry)
    result

fn cms_entry_count(cms: dict) -> int
    len(keys(cms["entries"]))

fn cms_type_count(cms: dict) -> int
    len(keys(cms["types"]))
