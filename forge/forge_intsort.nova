// forge_intsort -- LINEAR-time non-comparison sorting for non-negative integers: counting sort and LSD radix sort.
// Comparison sorts (quicksort/mergesort) can't beat O(n log n) because they only ever ASK "is a < b?". When the
// keys are small integers you can do better by using the key AS an index: counting sort tallies how many of each
// value there are and lays them out directly in O(n + k) for keys in 0..k (ideal when k is small -- ages, byte
// values, scores, histogram buckets). Radix sort removes the "k must be small" limit by sorting one digit at a
// time (here base 256, least-significant first) with a stable counting-sort pass each round, giving O(d*(n+256))
// -- effectively O(n) for fixed-width integers, and the workhorse behind fast integer/string sorting. Both are
// STABLE (equal keys keep their input order). Inputs must be non-negative. LEAF -- imports NOTHING.

// PRIVATE: the maximum of a list (0 for empty).
fn _is_max(xs: list) -> int
    let m = 0
    let i = 0
    while i < len(xs)
        if xs[i] > m
            m = xs[i]
        i = i + 1
    m

// Stable counting sort of non-negative integers. O(n + max). Best when the value range is small.
fn counting_sort(xs: list) -> list
    let n = len(xs)
    let out = []
    if n > 0
        let mx = _is_max(xs)
        // tally counts
        let count = []
        let c = 0
        while c <= mx
            push(count, 0)
            c = c + 1
        let i = 0
        while i < n
            count[xs[i]] = count[xs[i]] + 1
            i = i + 1
        // prefix sums -> starting index of each value
        let acc = 0
        let v = 0
        while v <= mx
            let cur = count[v]
            count[v] = acc
            acc = acc + cur
            v = v + 1
        // place (forward scan keeps equal keys stable)
        let z = 0
        while z < n
            push(out, 0)
            z = z + 1
        let j = 0
        while j < n
            let key = xs[j]
            out[count[key]] = key
            count[key] = count[key] + 1
            j = j + 1
    out

// PRIVATE: one stable counting-sort pass on the byte at the given bit shift (radix 256).
fn _is_pass(xs: list, shift: int) -> list
    let n = len(xs)
    let count = []
    let c = 0
    while c < 256
        push(count, 0)
        c = c + 1
    let i = 0
    while i < n
        let b = (xs[i] >> shift) & 255
        count[b] = count[b] + 1
        i = i + 1
    let acc = 0
    let v = 0
    while v < 256
        let cur = count[v]
        count[v] = acc
        acc = acc + cur
        v = v + 1
    let out = []
    let z = 0
    while z < n
        push(out, 0)
        z = z + 1
    let j = 0
    while j < n
        let b = (xs[j] >> shift) & 255
        out[count[b]] = xs[j]
        count[b] = count[b] + 1
        j = j + 1
    out

// Stable LSD radix sort (base 256) of non-negative integers. O(d*(n+256)); scales to large value ranges where
// plain counting sort's O(max) blows up.
fn radix_sort(xs: list) -> list
    let out = xs
    let n = len(xs)
    if n > 1
        let mx = _is_max(xs)
        let shift = 0
        // one pass per byte, up to the highest non-zero byte of the max value
        while (mx >> shift) > 0
            out = _is_pass(out, shift)
            shift = shift + 8
    out

// True if the list is in non-decreasing order.
fn is_sorted(xs: list) -> bool
    let ok = true
    let i = 1
    while i < len(xs)
        if xs[i] < xs[i - 1]
            ok = false
        i = i + 1
    ok
