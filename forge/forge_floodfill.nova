// forge_floodfill -- fill a connected region on a 2D grid, the "paint bucket" operation. Starting from one cell,
// it spreads to every orthogonally-adjacent cell holding the SAME value and repaints them -- exactly what an
// image editor's bucket tool does, and the core of region labeling (how big is this blob?), connected-component
// counting (how many separate islands/rooms/clusters?), maze/reachability solving, and territory scoring. The
// grid is a list of rows (lists) of integer cell values; flood_fill repaints in place and reports how many cells
// it changed, region_size measures a blob without altering it, and count_regions counts the separate connected
// groups of a target value. 4-connected (up/down/left/right). Uses parallel scalar stacks (no list-of-lists to
// corrupt). LEAF -- imports NOTHING.

// Repaint the connected region of equal value containing (sr, sc) with `newval`, in place. Returns the number
// of cells changed. 4-connected.
fn flood_fill(grid: list, sr: int, sc: int, newval) -> int
    let rows = len(grid)
    if rows == 0
        return 0
    let cols = len(grid[0])
    if sr < 0 or sr >= rows or sc < 0 or sc >= cols
        return 0
    let target = grid[sr][sc]
    if target == newval
        return 0
    let sr_stack = []
    let sc_stack = []
    push(sr_stack, sr)
    push(sc_stack, sc)
    let count = 0
    while len(sr_stack) > 0
        let top = len(sr_stack) - 1
        let r = sr_stack[top]
        let c = sc_stack[top]
        pop(sr_stack)
        pop(sc_stack)
        if r >= 0 and r < rows and c >= 0 and c < cols and grid[r][c] == target
            grid[r][c] = newval
            count += 1
            push(sr_stack, r - 1)
            push(sc_stack, c)
            push(sr_stack, r + 1)
            push(sc_stack, c)
            push(sr_stack, r)
            push(sc_stack, c - 1)
            push(sr_stack, r)
            push(sc_stack, c + 1)
    count

// The number of cells in the connected region of equal value at (sr, sc), WITHOUT modifying the grid.
fn region_size(grid: list, sr: int, sc: int) -> int
    let rows = len(grid)
    let out = 0
    if rows > 0
        let cols = len(grid[0])
        if sr >= 0 and sr < rows and sc >= 0 and sc < cols
            let target = grid[sr][sc]
            let seen = {}
            let sr_stack = []
            let sc_stack = []
            push(sr_stack, sr)
            push(sc_stack, sc)
            while len(sr_stack) > 0
                let top = len(sr_stack) - 1
                let r = sr_stack[top]
                let c = sc_stack[top]
                pop(sr_stack)
                pop(sc_stack)
                let key = str(r) + "," + str(c)
                if r >= 0 and r < rows and c >= 0 and c < cols and key not in seen and grid[r][c] == target
                    seen[key] = 1
                    out += 1
                    push(sr_stack, r - 1)
                    push(sc_stack, c)
                    push(sr_stack, r + 1)
                    push(sc_stack, c)
                    push(sr_stack, r)
                    push(sc_stack, c - 1)
                    push(sr_stack, r)
                    push(sc_stack, c + 1)
    out

// The number of separate connected regions (components) whose cells equal `target`.
fn count_regions(grid: list, target) -> int
    let rows = len(grid)
    let regions = 0
    if rows > 0
        let cols = len(grid[0])
        let seen = {}
        for r in 0..rows
            for c in 0..cols
                let key = str(r) + "," + str(c)
                if grid[r][c] == target and key not in seen
                    regions += 1
                    // BFS-mark this whole component
                    let sr_stack = []
                    let sc_stack = []
                    push(sr_stack, r)
                    push(sc_stack, c)
                    while len(sr_stack) > 0
                        let top = len(sr_stack) - 1
                        let cr = sr_stack[top]
                        let cc = sc_stack[top]
                        pop(sr_stack)
                        pop(sc_stack)
                        let k2 = str(cr) + "," + str(cc)
                        if cr >= 0 and cr < rows and cc >= 0 and cc < cols and k2 not in seen and grid[cr][cc] == target
                            seen[k2] = 1
                            push(sr_stack, cr - 1)
                            push(sc_stack, cc)
                            push(sr_stack, cr + 1)
                            push(sc_stack, cc)
                            push(sr_stack, cr)
                            push(sc_stack, cc - 1)
                            push(sr_stack, cr)
                            push(sc_stack, cc + 1)
    regions
