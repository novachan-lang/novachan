// forge_ini -- INI config parser ([section] + key=value; the format git config, php.ini, systemd units, and
// setup.cfg use). Parses into a nested dict: config[section][key] = value; keys before any section go under
// the "" (default) section. Supports ; and # comments and single/double-quoted values. LEAF -- imports NOTHING.

fn _ini_unquote(s: string) -> string
    if len(s) >= 2
        let f = char_at(s, 0)
        if (f == chr(34) or f == chr(39)) and char_at(s, len(s) - 1) == f
            return slice(s, 1, len(s) - 1)
    s

fn ini_parse(text: string) -> dict
    let out = {}
    out[""] = {}
    let section = ""
    let lines = split(text, chr(10))
    for i in 0..len(lines)
        let line = trim(lines[i])
        if len(line) > 0 and starts_with(line, ";") == false and starts_with(line, "#") == false
            if starts_with(line, "[") and ends_with(line, "]")
                section = trim(slice(line, 1, len(line) - 1))
                if section in out == false
                    out[section] = {}
            else
                let eq = find(line, "=")
                if eq > 0
                    let sec = out[section]
                    sec[trim(slice(line, 0, eq))] = _ini_unquote(trim(slice(line, eq + 1, len(line))))
    out

// Look up section.key with a default fallback ("" section for top-level keys).
fn ini_get(config: dict, section: string, key: string, default: string) -> string
    if section in config
        let sec = config[section]
        if key in sec
            return sec[key]
    default
