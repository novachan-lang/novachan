// forge_hex -- hex encode/decode of a string's bytes (hexdump, wire-protocol debugging, binary-in-text
// transport). Each byte -> 2 lowercase hex digits and back. Complements base32/base62/base64. NOTE: hex_decode
// of data containing a 0x00 byte truncates at that byte (NOVA strings are NUL-terminated) -- use the bytes type
// for true binary; for text/ASCII payloads this is exact. LEAF -- imports NOTHING.

fn hex_encode(s: string) -> string
    let alpha = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(s)
        let b = ord(char_at(s, i))
        out = out + char_at(alpha, b / 16) + char_at(alpha, b % 16)
        i = i + 1
    out

fn hex_decode(s: string) -> string
    let alpha = "0123456789abcdef"
    let out = ""
    let i = 0
    while i + 2 <= len(s)
        let hi = find(alpha, lower(char_at(s, i)))
        let lo = find(alpha, lower(char_at(s, i + 1)))
        if hi < 0 or lo < 0
            return out
        out = out + chr(hi * 16 + lo)
        i = i + 2
    out

// A spaced hexdump ("48 69 21") -- byte pairs separated by spaces, for readable wire logging.
fn hex_spaced(s: string) -> string
    let alpha = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(s)
        if i > 0
            out = out + " "
        let b = ord(char_at(s, i))
        out = out + char_at(alpha, b / 16) + char_at(alpha, b % 16)
        i = i + 1
    out
