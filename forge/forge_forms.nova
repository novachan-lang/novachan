// forge_forms -- form objects (define/validate/render) = the Django Form round-trip (a failed submit
// re-renders with the user's values + per-field errors); auto-escaped; run over body_form(req) data.
// "Verified by reasoning": a required empty field -> errors[name]="required"; an int field with "ab" ->
// "must be a number"; form_render shows value='...' + an error span per broken field.
//
// A field spec is a 3-element list: [name, type, required]
//   name     : string -- the HTML input name attribute
//   type     : "text" | "int" | "email"
//   required : bool -- true means a blank value is rejected
//
// Imports forge_html for esc() (single-level; forge_html is a leaf).
import forge_html

// form_define: wrap a list of field specs into a form descriptor dict.
// fields: list of [name, type, required] specs.
// Returns {"fields": fields} so callers pass this dict to form_validate / form_render.
fn form_define(fields: list) -> dict
    let form = {}
    form["fields"] = fields
    form

// _form_is_digits: true iff every character in s is an ASCII digit (0-9). Empty string -> false.
// Used by form_validate to detect a non-numeric value in an "int" field.
fn _form_is_digits(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let i = 0
    while i < n
        let c = s[i]
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
            i += 1
        else
            return false
    true

// form_validate: apply required + type rules to submitted data dict.
// For each field: extract value (default ""), check required, check int/email format.
// Returns {"valid": bool, "errors": dict} where errors maps field name -> error message.
fn form_validate(form: dict, data: dict) -> dict
    let fields = form["fields"]
    let errors = {}
    for i in 0..len(fields)
        let spec = fields[i]
        let fname = spec[0]
        let ftype = spec[1]
        let freq = spec[2]
        let value = ""
        if fname in data
            value = data[fname]
        if freq and len(value) == 0
            errors[fname] = "required"
        else
            if ftype == "int" and len(value) > 0
                if not _form_is_digits(value)
                    errors[fname] = "must be a number"
            if ftype == "email" and len(value) > 0
                if find(value, "@") < 0
                    errors[fname] = "must be an email"
    let valid = len(errors) == 0
    let result = {}
    result["valid"] = valid
    result["errors"] = errors
    result

// form_render: produce HTML for the form fields with current values and inline error spans.
// For each field: <label> wrapping the field name and an <input>, plus an error <span> if present, plus <br>.
// All user values and error messages are esc()-d to prevent attribute/HTML injection.
// Single-quoted attributes throughout (HTML5-valid, avoids the chr(34) noise for inner strings).
fn form_render(form: dict, values: dict, errors: dict) -> string
    let fields = form["fields"]
    let out_parts = []
    for i in 0..len(fields)
        let spec = fields[i]
        let fname = spec[0]
        let value = ""
        if fname in values
            value = str(values[fname])
        let safe_val = esc(value)
        let safe_name = esc(fname)
        let label_open = "<label>" + safe_name + " "
        let input_tag = "<input name='" + safe_name + "' value='" + safe_val + "'>"
        let label_close = "</label>"
        let row = label_open + input_tag + label_close
        if fname in errors
            let errmsg = errors[fname]
            let safe_err = esc(errmsg)
            row += "<span class='error'>" + safe_err + "</span>"
        push(out_parts, row + "<br>")
    let out = join(out_parts, "")
    out
