// forge_matrix -- small dense-matrix linear algebra: multiply, transpose, identity, add, and 2x2/3x3
// determinants. The primitive graphics transforms (rotate/scale/project via matrix products), physics, and
// classical-ML math all reduce to these. A matrix is a list of row lists (row-major); elements are numbers.
// This is the CPU/host-side companion to NOVA's tensor work -- exact integer results for integer matrices,
// float results for float matrices (the * and + operators carry the element type through). LEAF.

// Multiply A (p x q) by B (q x r) -> (p x r). Assumes conformable dimensions (cols(A) == rows(B)).
fn mat_mul(a: list, b: list) -> list
    let p = len(a)
    let q = len(b)
    let r = len(b[0])
    let out = []
    for i in 0..p
        let row = []
        let j = 0
        while j < r
            let acc = a[i][0] * b[0][j]
            let k = 1
            while k < q
                acc += a[i][k] * b[k][j]
                k += 1
            push(row, acc)
            j += 1
        push(out, row)
    out

// Transpose an m x n matrix to n x m.
fn mat_transpose(a: list) -> list
    let m = len(a)
    let n = len(a[0])
    let out = []
    for j in 0..n
        let row = []
        let i = 0
        while i < m
            push(row, a[i][j])
            i += 1
        push(out, row)
    out

// The n x n identity matrix (integer 1/0 entries).
fn mat_identity(n: int) -> list
    let out = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            if i == j
                push(row, 1)
            else
                push(row, 0)
            j += 1
        push(out, row)
    out

// Element-wise sum of two same-shape matrices.
fn mat_add(a: list, b: list) -> list
    let m = len(a)
    let out = []
    for i in 0..m
        let row = []
        let n = len(a[i])
        let j = 0
        while j < n
            push(row, a[i][j] + b[i][j])
            j += 1
        push(out, row)
    out

// Determinant of a 2x2 matrix: ad - bc.
fn mat_det2(a: list) -> int
    a[0][0] * a[1][1] - a[0][1] * a[1][0]

// Determinant of a 3x3 matrix by cofactor expansion along the first row.
fn mat_det3(a: list) -> int
    let m00 = a[0][0]
    let m01 = a[0][1]
    let m02 = a[0][2]
    let c0 = a[1][1] * a[2][2] - a[1][2] * a[2][1]
    let c1 = a[1][0] * a[2][2] - a[1][2] * a[2][0]
    let c2 = a[1][0] * a[2][1] - a[1][1] * a[2][0]
    m00 * c0 - m01 * c1 + m02 * c2
