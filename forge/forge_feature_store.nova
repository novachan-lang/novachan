// forge_feature_store — ML feature store with versioning and Result.

fn fs_new() -> dict
    let f = {}
    f["features"] = {}
    f["versions"] = {}
    f["count"] = 0
    f["reads"] = 0
    f

fn fs_set(f: dict, entity: string, feature: string, value: string, version: int) -> dict
    let key = entity + ":" + feature
    f["features"][key] = value
    f["versions"][key] = version
    let has = contains(f["features"], key)
    f["count"] = f["count"] + 1
    f

fn fs_get(f: dict, entity: string, feature: string) -> Result
    let key = entity + ":" + feature
    let has = contains(f["features"], key)
    if has != true
        return err("feature not found: " + feature)
    f["reads"] = f["reads"] + 1
    ok(f["features"][key])

fn fs_get_version(f: dict, entity: string, feature: string) -> Result
    let key = entity + ":" + feature
    let has = contains(f["versions"], key)
    if has != true
        return err("no version for: " + feature)
    ok(f["versions"][key])

fn fs_has(f: dict, entity: string, feature: string) -> int
    let key = entity + ":" + feature
    let has = contains(f["features"], key)
    if has == true
        return 1
    0

fn fs_total_sets(f: dict) -> int
    f["count"]

fn fs_total_reads(f: dict) -> int
    f["reads"]
