        [67108843, 26], [134217702, 27], [67108844, 26], [67108845, 26],
        [134217703, 27], [134217704, 27], [134217705, 27], [134217706, 27],
        [134217707, 27], [268435454, 28], [134217708, 27], [134217709, 27],
        [134217710, 27], [134217711, 27], [134217712, 27], [67108846, 26]
    ]

// Reverse index "nbits:code" -> symbol. Prefix-free => the shortest matching prefix is the unique symbol.
fn _huff_rev(t: list) -> dict
    {"{t[i][1]}:{t[i][0]}": i for i in 0..len(t)}

// Huffman-encode a string -> coded byte list. Bits are MSB-first; the final byte is padded with 1-bits.
fn hpack_huffman_encode(s: string) -> list
    let t = _huff_table()
    let out = []
    let acc = 0
    let nb = 0
    for i in 0..len(s)
        let e = t[ord(char_at(s, i))]
        acc = acc * _pow2(e[1]) + e[0]
        nb += e[1]
        // bit-drain: the step depends on the accumulated bit count, so this inner loop stays a while
        while nb >= 8
            nb -= 8
            push(out, (acc / _pow2(nb)) % 256)
        acc = acc % _pow2(nb)
    if nb > 0
        let pad = 8 - nb
        push(out, (acc * _pow2(pad) + (_pow2(pad) - 1)) % 256)
    out

// Huffman-decode `length` octets of `buf` starting at `off` into a string. Walks bits; after each input
// byte, drains every complete code (shortest-prefix match, unambiguous for a prefix-free code). Leftover
// all-1 padding (shorter than the shortest code) is left unmatched and ignored.
fn hpack_huffman_decode_range(buf: list, off: int, length: int) -> string
    let t = _huff_table()
    let rev = _huff_rev(t)
    // decoded symbols are collected then joined ONCE -- `out = out + chr(..)` per symbol reallocated
    // and copied the whole decoded string on every symbol, i.e. quadratic in the header length.
    let parts = []
    let acc = 0
    let nb = 0
    for i in 0..length
        acc = acc * 256 + buf[off + i]
        nb += 8
        // bit-scan state machine (shortest-prefix match, data-dependent consumption): stays a while
        let go = 1
        while go == 1
            go = 0
            let clen = 5
            while clen <= 30
                if nb >= clen
                    let codeval = (acc / _pow2(nb - clen)) % _pow2(clen)
                    let key = "{clen}:{codeval}"
                    if key in rev
                        push(parts, chr(rev[key]))
                        nb -= clen
                        acc = acc % _pow2(nb)
                        go = 1
                        clen = 31
                clen += 1
    join(parts, "")

// Decode a whole byte list as Huffman.
fn hpack_huffman_decode(buf: list) -> string
    hpack_huffman_decode_range(buf, 0, len(buf))

// Encode a Huffman (H=1) string literal: [1 | 7-bit length][huffman octets]. Appends to `out`.
fn hpack_encode_string_huffman(out: list, s: string) -> list
    let coded = hpack_huffman_encode(s)
    out = hpack_encode_int(out, len(coded), 7, 128)
    for c in coded
        push(out, c)
    out
