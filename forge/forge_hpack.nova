// Reverse index "nbits:code" -> symbol. Prefix-free => the shortest matching prefix is the unique symbol.
fn _huff_rev(t: list) -> dict
    let r = {}
    let i = 0
    while i < len(t)
        let e = t[i]
        r[str(e[1]) + ":" + str(e[0])] = i
        i = i + 1
    r

// Huffman-encode a string -> coded byte list. Bits are MSB-first; the final byte is padded with 1-bits.
fn hpack_huffman_encode(s: string) -> list
    let t = _huff_table()
    let out = []
    let acc = 0
    let nb = 0
    let i = 0
    while i < len(s)
        let e = t[ord(char_at(s, i))]
        acc = acc * _huff_pow2(e[1]) + e[0]
        nb = nb + e[1]
        while nb >= 8
            nb = nb - 8
            push(out, (acc / _huff_pow2(nb)) % 256)
        acc = acc % _huff_pow2(nb)
        i = i + 1
    if nb > 0
        let pad = 8 - nb
        push(out, (acc * _huff_pow2(pad) + (_huff_pow2(pad) - 1)) % 256)
    out

// Huffman-decode `length` octets of `buf` starting at `off` into a string. Walks bits; after each input
// byte, drains every complete code (shortest-prefix match, unambiguous for a prefix-free code). Leftover
// all-1 padding (shorter than the shortest code) is left unmatched and ignored.
fn hpack_huffman_decode_range(buf: list, off: int, length: int) -> string
    let t = _huff_table()
    let rev = _huff_rev(t)
    let out = ""
    let acc = 0
    let nb = 0
    let i = 0
    while i < length
        acc = acc * 256 + buf[off + i]
        nb = nb + 8
        i = i + 1
        let go = 1
        while go == 1
            go = 0
            let clen = 5
            while clen <= 30
                if nb >= clen
                    let codeval = (acc / _huff_pow2(nb - clen)) % _huff_pow2(clen)
                    let key = str(clen) + ":" + str(codeval)
                    if contains(rev, key)
                        out = out + chr(rev[key])
                        nb = nb - clen
                        acc = acc % _huff_pow2(nb)
                        go = 1
                        clen = 31
                clen = clen + 1
    out

// Decode a whole byte list as Huffman.
fn hpack_huffman_decode(buf: list) -> string
    hpack_huffman_decode_range(buf, 0, len(buf))

// Encode a Huffman (H=1) string literal: [1 | 7-bit length][huffman octets]. Appends to `out`.
fn hpack_encode_string_huffman(out: list, s: string) -> list
    let coded = hpack_huffman_encode(s)
    out = hpack_encode_int(out, len(coded), 7, 128)
    let i = 0
    while i < len(coded)
        push(out, coded[i])
        i = i + 1
    out
