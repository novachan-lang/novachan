// ══════════════════════════════════════════════════════════════════════════════
// forge_hpack — HPACK (RFC 7541) header compression for HTTP/2. LEAF module (byte-list based, no sockets,
// no forge dependency) so it stays out of any module diamond and is testable byte-exact against the RFC
// vectors. This unit: §5.1 prefix-integer coding. Follow-ups (see NOVA_DESIGN/HTTP2_PLAN.md): §5.2 Huffman,
// the static (61) + dynamic tables, and the header-block encode/decode (§6).
// ══════════════════════════════════════════════════════════════════════════════

// 2^k by doubling (avoids the broken 1<<64 edge and any shift ambiguity). k <= 0 -> 1.
// An accumulator loop on purpose: this is called per bit-scan step in the Huffman decoder, so a
// reduce over a freshly-allocated [2, 2, ...] list would allocate in the hottest loop in the file.
fn _pow2(k: int) -> int
    let r = 1
    for i in 0..k
        r = r * 2
    r

// Encode integer `value` with an `n`-bit prefix, appending to byte list `out`. `high` is OR'd into the top
// (8-n) bits of the FIRST byte (the representation flags, e.g. 0x80 indexed, 0x40 literal-with-incremental).
// RFC 7541 §5.1: if value fits in the prefix, one byte; else the prefix is all-ones and the remainder is a
// little-endian base-128 varint with continuation bits.
fn hpack_encode_int(out: list, value: int, n: int, high: int) -> list
    let maxp = _pow2(n) - 1
    if value < maxp
        push(out, high | value)
        return out
    push(out, high | maxp)
    let v = value - maxp
    while v >= 128
        push(out, (v % 128) + 128)
        v = v / 128
    push(out, v)
    out

// Decode an `n`-bit-prefix integer from byte list `buf` at offset `off`. Returns [value, next_off].
fn hpack_decode_int(buf: list, off: int, n: int) -> list
    let maxp = _pow2(n) - 1
    let i = buf[off] & maxp
    let pos = off + 1
    if i < maxp
        return [i, pos]
    let m = 0
    let cont = 1
    while cont == 1
        let b = buf[pos]
        pos += 1
        i += (b & 127) * _pow2(m)
        m += 7
        if (b & 128) == 0
            cont = 0
    [i, pos]

// The HPACK static table (RFC 7541 Appendix A), 61 entries as [name, value] (index i = _hpack_static()[i-1]).
fn _hpack_static() -> list
    [
        [":authority", ""],
        [":method", "GET"],
        [":method", "POST"],
        [":path", "/"],
        [":path", "/index.html"],
        [":scheme", "http"],
        [":scheme", "https"],
        [":status", "200"],
        [":status", "204"],
        [":status", "206"],
        [":status", "304"],
        [":status", "400"],
        [":status", "404"],
        [":status", "500"],
        ["accept-charset", ""],
        ["accept-encoding", "gzip, deflate"],
        ["accept-language", ""],
        ["accept-ranges", ""],
        ["accept", ""],
        ["access-control-allow-origin", ""],
        ["age", ""],
        ["allow", ""],
        ["authorization", ""],
        ["cache-control", ""],
        ["content-disposition", ""],
        ["content-encoding", ""],
        ["content-language", ""],
        ["content-length", ""],
        ["content-location", ""],
        ["content-range", ""],
        ["content-type", ""],
        ["cookie", ""],
        ["date", ""],
        ["etag", ""],
        ["expect", ""],
        ["expires", ""],
        ["from", ""],
        ["host", ""],
        ["if-match", ""],
        ["if-modified-since", ""],
        ["if-none-match", ""],
        ["if-range", ""],
        ["if-unmodified-since", ""],
        ["last-modified", ""],
        ["link", ""],
        ["location", ""],
        ["max-forwards", ""],
        ["proxy-authenticate", ""],
        ["proxy-authorization", ""],
        ["range", ""],
        ["referer", ""],
        ["refresh", ""],
        ["retry-after", ""],
        ["server", ""],
        ["set-cookie", ""],
        ["strict-transport-security", ""],
        ["transfer-encoding", ""],
        ["user-agent", ""],
        ["vary", ""],
        ["via", ""],
        ["www-authenticate", ""]
    ]

// Look up an index in the combined static(1..61) + dynamic(62..) address space (dyn is most-recent-first).
fn hpack_lookup(dyn: list, index: int) -> list
    if index >= 1 and index <= 61
        return _hpack_static()[index - 1]
    let di = index - 62
    if di >= 0 and di < len(dyn)
        return dyn[di]
    ["", ""]

// Decode an HPACK string literal at `off`: [H-bit | 7-bit length][octets]. Returns [string, next_off, huff].
// Handles BOTH raw octets (H=0) and Huffman-coded literals (H=1, via hpack_huffman_decode_range) — real
// clients (browsers/curl) send Huffman, so this is required for interop. RFC C.3 uses raw, C.4/C.6 Huffman.
fn hpack_decode_string(buf: list, off: int) -> list
    let huff = 0
    if (buf[off] & 128) != 0
        huff = 1
    let li = hpack_decode_int(buf, off, 7)
    let length = li[0]
    let pos = li[1]
    let s = ""
    if huff == 1
        s = hpack_huffman_decode_range(buf, pos, length)
    else
        // raw octets: one chr() per byte, joined ONCE (s = s + chr(..) per byte was quadratic)
        s = join([chr(buf[pos + i]) for i in 0..length], "")
    [s, pos + length, huff]

// Encode a raw (H=0) string literal: [0 | 7-bit length][octets]. Appends to `out`.
fn hpack_encode_string(out: list, s: string) -> list
    out = hpack_encode_int(out, len(s), 7, 0)
    for i in 0..len(s)
        push(out, ord(char_at(s, i)))
    out

// First static-table index whose NAME equals `name` (value ignored), or 0 if none.
fn _hpack_static_name_index(name: string) -> int
    let st = _hpack_static()
    // short-circuits on the FIRST match (the RFC index), so it stays a loop -- but a for-range one
    for i in 0..len(st)
        if st[i][0] == name
            return i + 1
    0

// Encode a header list ([[name,value],...]) as an HPACK block. v1: each field as literal-with-incremental
// indexing (§6.2.1) using the static table for the NAME when available (index), else a literal name; RAW
// values (Huffman is a follow-up). Decodes cleanly with hpack_decode_header_block (round-trip tested).
fn hpack_encode_header_block(headers: list) -> list
    let out = []
    for h in headers
        let ni = _hpack_static_name_index(h[0])
        if ni > 0
            out = hpack_encode_int(out, ni, 6, 64)
        else
            out = hpack_encode_int(out, 0, 6, 64)
            out = hpack_encode_string(out, h[0])
        out = hpack_encode_string(out, h[1])
    out

fn _prepend(lst: list, item) -> list
    [item, ...lst]

// PRIVATE: a §6.2 literal field's NAME -> [name, next_off]. idx > 0 = indexed name (static/dynamic),
// idx == 0 = an inline string literal. Identical in the with-incremental (§6.2.1) and the
// without/never-indexed (§6.2.2/§6.2.3) branches below, which is why it lives here once.
fn _hpack_read_name(buf: list, pos: int, d: list, idx: int) -> list
    if idx > 0
        return [hpack_lookup(d, idx)[0], pos]
    let ns = hpack_decode_string(buf, pos)
    [ns[0], ns[1]]

// Decode a full HPACK header block (buf) against the current dynamic table `dyn`. Returns
// [headers (list of [name,value]), updated_dyn]. Handles: §6.1 indexed, §6.2.1 literal+incremental (adds to
// dyn), §6.2.2/§6.2.3 literal without/never indexed, §6.3 dynamic-table size update (skipped). RAW literals
// (Huffman is the next unit). This is the decode path serve_h2 uses to turn HEADERS into a request.
fn hpack_decode_header_block(buf: list, dyn: list) -> list
    let headers = []
    let d = dyn
    let pos = 0
    let n = len(buf)
    while pos < n
        let b = buf[pos]
        if (b & 128) != 0
            let ii = hpack_decode_int(buf, pos, 7)
            push(headers, hpack_lookup(d, ii[0]))
            pos = ii[1]
        else if (b & 64) != 0
            let ii = hpack_decode_int(buf, pos, 6)
            let nm = _hpack_read_name(buf, ii[1], d, ii[0])
            let name = nm[0]
            let vs = hpack_decode_string(buf, nm[1])
            pos = vs[1]
            push(headers, [name, vs[0]])
            d = _prepend(d, [name, vs[0]])
        else if (b & 32) != 0
            let ii = hpack_decode_int(buf, pos, 5)
            pos = ii[1]
        else
            let ii = hpack_decode_int(buf, pos, 4)
            let nm = _hpack_read_name(buf, ii[1], d, ii[0])
            let name = nm[0]
            let vs = hpack_decode_string(buf, nm[1])
            pos = vs[1]
            push(headers, [name, vs[0]])
    [headers, d]

// -- HPACK Huffman coding (RFC 7541 section 5.2 + Appendix B static table) --------------------------------
// Real HTTP/2 peers (browsers, curl, grpc clients) Huffman-code header literals, so DECODE is required for
// interop; ENCODE lets Forge shrink its own responses. The 256-symbol static table below is generated
// verbatim from RFC 7541 Appendix B (code as a decimal int + bit length), indexed by byte value. EOS
// (symbol 256) is only the padding marker: the final byte is padded with 1-bits, and trailing 1-bit
// padding shorter than any code is ignored on decode (the codes are prefix-free, so decode is unambiguous).

// The RFC 7541 Appendix B table: index = byte value, value = [code, nbits].
fn _huff_table() -> list
    [
        [8184, 13], [8388568, 23], [268435426, 28], [268435427, 28],
