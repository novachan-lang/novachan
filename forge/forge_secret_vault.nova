// forge_secret_vault — Secure secret storage with access tracking.

fn sv_new() -> dict
    let v = {}
    v["secrets"] = {}
    v["access_log"] = {}
    v["log_count"] = 0
    v["locked"] = 0
    v

fn sv_store(v: dict, name: string, value: string) -> dict
    if v["locked"] == 1
        return v
    v["secrets"][name] = value
    v

fn sv_retrieve(v: dict, name: string, accessor: string) -> dict
    let result = {}
    let has = contains(v["secrets"], name)
    if has == true
        result["found"] = 1
        result["value"] = v["secrets"][name]
        let idx = v["log_count"]
        v["access_log"][str(idx) + "_name"] = name
        v["access_log"][str(idx) + "_by"] = accessor
        v["log_count"] = idx + 1
    else
        result["found"] = 0
        result["value"] = ""
    result["v"] = v
    result

fn sv_lock(v: dict) -> dict
    v["locked"] = 1
    v

fn sv_unlock(v: dict) -> dict
    v["locked"] = 0
    v

fn sv_is_locked(v: dict) -> int
    v["locked"]

fn sv_has_secret(v: dict, name: string) -> int
    let has = contains(v["secrets"], name)
    if has == true
        return 1
    0

fn sv_access_count(v: dict) -> int
    v["log_count"]

fn sv_secret_count(v: dict) -> int
    len(keys(v["secrets"]))
