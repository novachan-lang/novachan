// forge_eertree -- palindromic tree (a.k.a. "eertree", Rubinchik & Shur 2015): the automaton of all
// DISTINCT palindromic substrings of a string, built online in O(n) (alphabet-factor).
// forge_manacher counts palindromic substrings WITH MULTIPLICITY and finds the longest one; the eertree
// answers a genuinely different and harder set of questions in linear time:
//   - the NUMBER OF DISTINCT palindromic substrings of s (= number of eertree nodes minus the 2 roots)
//   - how many distinct palindromes END at each position (via the suffix-link chain length)
//   - the OCCURRENCE COUNT of every distinct palindrome (propagated down suffix links)
//   - the set of all distinct palindromic substrings themselves
// It has at most n+2 nodes (a beautiful, non-obvious fact: adding one character creates at most one new
// distinct palindrome). Two "roots": an imaginary length -1 root and the empty length 0 root. Each node
// stores its palindrome length, a suffix link to the longest proper palindromic suffix, and edges by
// character to the palindrome obtained by wrapping this one in that character. Uses: bioinformatics
// (palindrome/hairpin detection in DNA/RNA), text analysis, competitive programming palindrome problems.
//
// API:
//   ee_build(s) -> tree                         build the palindromic tree for string s
//   ee_num_distinct_palindromes(tree) -> int    count of distinct non-empty palindromic substrings
//   ee_num_nodes(tree) -> int                   total nodes including the 2 roots (<= n+2)
//   ee_distinct_palindromes(tree) -> list       list of all distinct palindromic substrings (strings)
//   ee_occurrence_counts(tree, s) -> dict       palindrome-string -> number of occurrences in s
// LEAF (imports nothing).

// tree = [len_arr, link_arr, trans_arr, cnt_arr, series_len_arr, s]
// Node 0 = imaginary root (len -1), Node 1 = empty root (len 0). trans_arr[i] = dict char->node.
fn ee_build(s: str) -> list
    let len_arr = []
    let link_arr = []
    let trans_arr = []
    let cnt_arr = []
    // root 0: length -1, link to itself
    push(len_arr, 0 - 1)
    push(link_arr, 0)
    push(trans_arr, {})
    push(cnt_arr, 0)
    // root 1: length 0, link to root 0
    push(len_arr, 0)
    push(link_arr, 0)
    push(trans_arr, {})
    push(cnt_arr, 0)
    let last = 1
    let n = len(s)
    for i in 0..n
        last = _ee_add(len_arr, link_arr, trans_arr, cnt_arr, s, i, last)
    return [len_arr, link_arr, trans_arr, cnt_arr, s]

// Find the longest palindromic suffix of s[0..pos] (ending at pos) that can be extended by s[pos]:
// walk suffix links from `start` until s[pos - len - 1] == s[pos].
fn _ee_find_link(len_arr: list, link_arr: list, s: str, pos: int, start: int) -> int
    let cur = start
    let done = false
    while not done
        let l = len_arr[cur]
        let idx = pos - l - 1
        if idx >= 0 and char_at(s, idx) == char_at(s, pos)
            done = true
        else
            cur = link_arr[cur]
    return cur

// Add character at position pos. Returns the new `last` node.
fn _ee_add(len_arr: list, link_arr: list, trans_arr: list, cnt_arr: list, s: str, pos: int, last: int) -> int
    let c = char_at(s, pos)
    // find the node to extend
    let cur = _ee_find_link(len_arr, link_arr, s, pos, last)
    let tcur = trans_arr[cur]
    if c in tcur
        // palindrome already exists; just bump its count
        let existing = get(tcur, c, 0)
        cnt_arr[existing] = cnt_arr[existing] + 1
        return existing
    // create a new node
    let node = len(len_arr)
    push(len_arr, len_arr[cur] + 2)
    push(link_arr, 1)
    push(trans_arr, {})
    push(cnt_arr, 1)
    // add edge cur --c--> node
    tcur[c] = node
    // set suffix link of node
    if len_arr[node] == 1
        // single-char palindrome links to empty root
        link_arr[node] = 1
    else
        // walk further from link_arr[cur] to find suffix palindrome
        let link_cur = _ee_find_link(len_arr, link_arr, s, pos, link_arr[cur])
        let tlink = trans_arr[link_cur]
        link_arr[node] = get(tlink, c, 1)
    return node

// Number of distinct non-empty palindromic substrings = total nodes - 2 roots.
fn ee_num_distinct_palindromes(tree: list) -> int
    let len_arr = tree[0]
    return len(len_arr) - 2

fn ee_num_nodes(tree: list) -> int
    let len_arr = tree[0]
    return len(len_arr)

// Reconstruct the actual palindrome string for each node by finding an occurrence in s.
// For a node of length L, we scan s for the first substring of length L that is a palindrome and
// matches the character-edge structure. Simpler robust approach: BFS from roots building strings.
// We build strings top-down: a node reached by edge c from parent p represents c + string(p) + c,
// with special handling for the roots.
fn ee_distinct_palindromes(tree: list) -> list
    let len_arr = tree[0]
    let trans_arr = tree[2]
    let num = len(len_arr)
    // node_str[i] = the palindrome for node i (roots -> special)
    let node_str = ["" for i in 0..num]
    // BFS from both roots, following edges; edge c from parent -> child = c + parent_str + c,
    // except children of root 0 (len -1) are single chars c, and children of root 1 (len 0) are c+c.
    let out = []
    // process nodes in increasing node id (parents always created before children in eertree)
    for node in 2..num
        // find parent + edge char by scanning all nodes' transitions (small alphabet)
        let found_parent = 0 - 1
        let found_c = ""
        let p = 0
        while p < num and found_parent == 0 - 1
            let tp = trans_arr[p]
            let ks = keys(tp)
            let ki = 0
            while ki < len(ks) and found_parent == 0 - 1
                let ch = ks[ki]
                if get(tp, ch, 0) == node
                    found_parent = p
                    found_c = ch
                ki += 1
            p += 1
        if found_parent == 0
            // parent is imaginary root -> single char
            node_str[node] = found_c
        else
            node_str[node] = found_c + node_str[found_parent] + found_c
        push(out, node_str[node])
    return out

// Occurrence counts: propagate cnt down suffix links (a palindrome occurs everywhere its suffix
// palindromes occur), then map each distinct palindrome string to its total occurrence count.
fn ee_occurrence_counts(tree: list, s: str) -> dict
    let len_arr = tree[0]
    let link_arr = tree[1]
    let cnt_arr = tree[2 + 1]
    let num = len(len_arr)
    // copy cnt so we don't mutate the tree
    let cnt = [cnt_arr[i] for i in 0..num]
    // propagate in REVERSE node order (children created after parents; suffix link points to shorter)
    let node = num - 1
    while node >= 2
        let link = link_arr[node]
        if link >= 2
            cnt[link] = cnt[link] + cnt[node]
        node -= 1
    // build palindrome strings and map to counts
    let palindromes = ee_distinct_palindromes(tree)
    let result = {}
    for j in 0..len(palindromes)
        // palindromes[j] corresponds to node j+2
        result[palindromes[j]] = cnt[j + 2]
    return result
