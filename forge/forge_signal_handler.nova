// forge_signal_handler — signal/event handler registry with Result API.

fn sh_new() -> dict
    let s = {}
    s["handlers"] = {}
    s["fire_counts"] = {}
    s["handler_count"] = 0
    s["total_fired"] = 0
    s

fn sh_register(s: dict, signal: string, handler: string) -> dict
    let hk = "h_" + signal
    s["handlers"][hk] = handler
    let fk = "f_" + signal
    if contains(s["fire_counts"], fk) != true
        s["fire_counts"][fk] = 0
        s["handler_count"] = s["handler_count"] + 1
    s

fn sh_fire(s: dict, signal: string) -> Result
    let hk = "h_" + signal
    if contains(s["handlers"], hk) != true
        return err("no handler for signal: " + signal)
    let fk = "f_" + signal
    s["fire_counts"][fk] = s["fire_counts"][fk] + 1
    s["total_fired"] = s["total_fired"] + 1
    ok(s["handlers"][hk])

fn sh_fire_count(s: dict, signal: string) -> int
    let fk = "f_" + signal
    if contains(s["fire_counts"], fk) == true
        return s["fire_counts"][fk]
    0

fn sh_unregister(s: dict, signal: string) -> Result
    let hk = "h_" + signal
    if contains(s["handlers"], hk) != true
        return err("not registered")
    s["handlers"][hk] = ""
    s["handler_count"] = s["handler_count"] - 1
    ok(s)

fn sh_handler_count(s: dict) -> int
    s["handler_count"]

fn sh_total_fired(s: dict) -> int
    s["total_fired"]
