// forge_complex -- complex-number arithmetic: add/sub/mul/div, conjugate, modulus, argument. The number system
// under signal processing (an FFT is all complex multiplies), control theory, AC circuit analysis, and 2D
// rotation. A complex value is a 2-element list [re, im] of numbers; division/modulus/argument return floats.
// Companion to forge_vec3 / forge_matrix. LEAF -- imports NOTHING (uses sqrt + atan2 builtins).

// Sum (a+bi) + (c+di) = (a+c) + (b+d)i.
fn complex_add(x: list, y: list) -> list
    [x[0] + y[0], x[1] + y[1]]

// Difference.
fn complex_sub(x: list, y: list) -> list
    [x[0] - y[0], x[1] - y[1]]

// Product (a+bi)(c+di) = (ac - bd) + (ad + bc)i.
fn complex_mul(x: list, y: list) -> list
    [x[0] * y[0] - x[1] * y[1], x[0] * y[1] + x[1] * y[0]]

// Complex conjugate: (a + bi) -> (a - bi).
fn complex_conj(x: list) -> list
    [x[0], 0 - x[1]]

// Modulus |a + bi| = sqrt(a^2 + b^2).
fn complex_abs(x: list) -> float
    sqrt(x[0] * 1.0 * x[0] + x[1] * 1.0 * x[1])

// Argument (phase angle) in radians, atan2(im, re), range (-pi, pi].
fn complex_arg(x: list) -> float
    atan2(x[1] * 1.0, x[0] * 1.0)

// Quotient (a+bi)/(c+di) = ((ac+bd) + (bc-ad)i) / (c^2 + d^2). Returns [0,0] when the divisor is zero.
fn complex_div(x: list, y: list) -> list
    let denom = y[0] * 1.0 * y[0] + y[1] * 1.0 * y[1]
    if denom == 0.0
        return [0.0, 0.0]
    let re = (x[0] * y[0] + x[1] * y[1]) / denom
    let im = (x[1] * y[0] - x[0] * y[1]) / denom
    [re, im]
