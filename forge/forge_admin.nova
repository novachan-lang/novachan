// forge_admin -- an auto-generated admin CRUD over forge_db, in a few lines. admin_resource(app, pool,
// table, cols) wires GET /admin/<table> (list), GET /admin/<table>/new (form), POST /admin/<table>
// (create), POST /admin/<table>/:id/delete (delete). The view + CRUD logic are plain functions (directly
// testable over a sqlite pool); the routes are thin closures over them. All values are HTML-escaped
// (forge_html.esc) and all writes are parameterized (pool_query binds, never string-concats values) ->
// XSS- and injection-safe by construction. HTML attributes use single quotes so no NOVA-string escaping.
import forge
import forge_db
import forge_html

// Render rows (name-keyed dicts from db_all) as an HTML table over `cols`, with a delete button per row.
fn admin_render_table(table: string, cols, rows) -> string
    let h = "<h1>" + esc(table) + "</h1><table border='1'><tr>"
    let i = 0
    while i < len(cols)
        h = h + "<th>" + esc(cols[i]) + "</th>"
        i = i + 1
    h = h + "<th>actions</th></tr>"
    let r = 0
    while r < len(rows)
        let row = rows[r]
        h = h + "<tr>"
        let c = 0
        while c < len(cols)
            let v = ""
            if contains(row, cols[c])
                v = str(row[cols[c]])
            h = h + "<td>" + esc(v) + "</td>"
            c = c + 1
        let idv = ""
        if contains(row, "id")
            idv = str(row["id"])
        h = h + "<td><form method='post' action='/admin/" + esc(table) + "/" + esc(idv) + "/delete'><button>delete</button></form></td></tr>"
        r = r + 1
    h + "</table>"

// Render a create form with an input per column.
fn admin_render_form(table: string, cols) -> string
    let h = "<h2>new " + esc(table) + "</h2><form method='post' action='/admin/" + esc(table) + "'>"
    let i = 0
    while i < len(cols)
        h = h + "<label>" + esc(cols[i]) + " <input name='" + esc(cols[i]) + "'></label><br>"
        i = i + 1
    h + "<button>create</button></form>"

// The list view's HTML (db_all + render).
fn admin_list_html(pool, table: string, cols) -> string
    admin_render_table(table, cols, db_all(pool, table))

// Insert a row from a `fields` dict (col -> value), parameterized. Returns 0.
fn admin_create(pool, table: string, cols, fields) -> int
    let collist = ""
    let ph = ""
    let params = []
    let i = 0
    while i < len(cols)
        let c = cols[i]
        if len(params) == 0
            collist = c
            ph = "?"
        else
            collist = collist + "," + c
            ph = ph + ",?"
        let v = ""
        if contains(fields, c)
            v = fields[c]
        push(params, v)
        i = i + 1
    pool_query(pool, "INSERT INTO " + table + " (" + collist + ") VALUES (" + ph + ")", params)
    0

fn admin_delete(pool, table: string, id) -> int
    db_delete(pool, table, id)

// ── Route wiring (thin closures over the tested logic above) ──────────────────────────────────────
fn _admin_list_resp(pool, table, cols)
    html(200, admin_list_html(pool, table, cols))

fn _admin_create_resp(req, pool, table, cols)
    admin_create(pool, table, cols, body_form(req))
    html(200, admin_list_html(pool, table, cols))

fn _admin_delete_resp(req, pool, table, cols)
    admin_delete(pool, table, req.params["id"])
    html(200, admin_list_html(pool, table, cols))

fn admin_resource(app, pool, table: string, cols)
    let base = "/admin/" + table
    get(app, base, fn(req) _admin_list_resp(pool, table, cols))
    get(app, base + "/new", fn(req) html(200, admin_render_form(table, cols)))
    post(app, base, fn(req) _admin_create_resp(req, pool, table, cols))
    post(app, base + "/:id/delete", fn(req) _admin_delete_resp(req, pool, table, cols))
    app

// ── Model-driven admin: columns AUTO-DERIVED from a struct + full CRUD incl. edit/update ────────────────
// This is the Django admin's "admin.site.register(User)" — but the model is a plain NOVA struct, no
// admin.py, no ModelAdmin subclass. admin_resource_model(app, pool, table, User()) derives the columns
// from the struct via the RTTI keystone (field_names works through `any`), so adding a field to the struct
// automatically adds it to the admin — zero annotation, zero duplication.

// Column names auto-derived from a model struct instance (zero annotation).
fn admin_cols_of(model_sample) -> list
    field_names(model_sample)

// Form/editable columns = every column except the auto-generated "id" primary key (comprehension filter).
fn admin_form_cols(cols) -> list
    [c for c in cols if c != "id"]

// Create form over the EDITABLE columns only (id is DB-generated, never a form input).
fn admin_render_create_form(table: string, cols) -> string
    admin_render_form(table, admin_form_cols(cols))

// List table WITH edit + delete actions per row (+ a "new" link). Values HTML-escaped; the model variant
// uses this instead of admin_render_table so the existing renderer's output stays byte-stable for its test.
fn admin_render_table_ed(table: string, cols, rows) -> string
    let h = "<h1>" + esc(table) + "</h1><p><a href='/admin/" + esc(table) + "/new'>+ new</a></p><table border='1'><tr>"
    let i = 0
    while i < len(cols)
        h = h + "<th>" + esc(cols[i]) + "</th>"
        i = i + 1
    h = h + "<th>actions</th></tr>"
    let r = 0
    while r < len(rows)
        let row = rows[r]
        h = h + "<tr>"
        let c = 0
        while c < len(cols)
            let v = ""
            if contains(row, cols[c])
                v = str(row[cols[c]])
            h = h + "<td>" + esc(v) + "</td>"
            c = c + 1
        let idv = ""
        if contains(row, "id")
            idv = str(row["id"])
        h = h + "<td><a href='/admin/" + esc(table) + "/" + esc(idv) + "/edit'>edit</a> "
        h = h + "<form method='post' action='/admin/" + esc(table) + "/" + esc(idv) + "/delete' style='display:inline'><button>delete</button></form></td></tr>"
        r = r + 1
    h + "</table>"

// Pre-filled edit form (editable cols), posts to /admin/<table>/<id>/update. Values go into single-quoted
// attributes; esc() escapes ' (&#39;) and " (&quot;) so a value can't break out (attribute-injection-safe).
fn admin_render_edit_form(table: string, cols, row) -> string
    let ec = admin_form_cols(cols)
    let idv = ""
    if contains(row, "id")
        idv = str(row["id"])
    let h = "<h2>edit " + esc(table) + " #" + esc(idv) + "</h2><form method='post' action='/admin/" + esc(table) + "/" + esc(idv) + "/update'>"
    let i = 0
    while i < len(ec)
        let c = ec[i]
        let v = ""
        if contains(row, c)
            v = str(row[c])
        h = h + "<label>" + esc(c) + " <input name='" + esc(c) + "' value='" + esc(v) + "'></label><br>"
        i = i + 1
    h + "<button>update</button></form>"

// Parameterized UPDATE of the editable columns for row `id`. Column names come from the model struct
// (developer-controlled, not user input); VALUES and the id are bound (?), never concatenated -> injection-
// safe, same trust model as admin_create. No-op (returns 0) if the model has no editable columns.
fn admin_update(pool, table: string, cols, id, fields) -> int
    let ec = admin_form_cols(cols)
    if len(ec) == 0
        return 0
    let setclause = ""
    let params = []
    let i = 0
    while i < len(ec)
        let c = ec[i]
        if len(params) == 0
            setclause = c + "=?"
        else
            setclause = setclause + "," + c + "=?"
        let v = ""
        if contains(fields, c)
            v = fields[c]
        push(params, v)
        i = i + 1
    push(params, id)
    pool_query(pool, "UPDATE " + table + " SET " + setclause + " WHERE id=?", params)
    0

fn _admin_list_resp_ed(pool, table, cols)
    html(200, admin_render_table_ed(table, cols, db_all(pool, table)))

fn _admin_create_resp_ed(req, pool, table, cols)
    admin_create(pool, table, admin_form_cols(cols), body_form(req))
    html(200, admin_render_table_ed(table, cols, db_all(pool, table)))

fn _admin_edit_resp(req, pool, table, cols)
    html(200, admin_render_edit_form(table, cols, db_find(pool, table, req.params["id"])))

fn _admin_update_resp(req, pool, table, cols)
    admin_update(pool, table, cols, req.params["id"], body_form(req))
    html(200, admin_render_table_ed(table, cols, db_all(pool, table)))

fn _admin_delete_resp_ed(req, pool, table, cols)
    admin_delete(pool, table, req.params["id"])
    html(200, admin_render_table_ed(table, cols, db_all(pool, table)))

// Full CRUD admin for a model struct — list (with edit/delete/new), create, edit, update, delete.
// Columns auto-derived from the struct; no cols argument needed.
fn admin_resource_model(app, pool, table: string, model_sample)
    let cols = admin_cols_of(model_sample)
    let base = "/admin/" + table
    get(app, base, fn(req) _admin_list_resp_ed(pool, table, cols))
    get(app, base + "/new", fn(req) html(200, admin_render_create_form(table, cols)))
    post(app, base, fn(req) _admin_create_resp_ed(req, pool, table, cols))
    get(app, base + "/:id/edit", fn(req) _admin_edit_resp(req, pool, table, cols))
    post(app, base + "/:id/update", fn(req) _admin_update_resp(req, pool, table, cols))
    post(app, base + "/:id/delete", fn(req) _admin_delete_resp_ed(req, pool, table, cols))
    app

// -- D7.2: list search + sort (Django list_display/search parity) --------------------------------------
// A searchable/sortable admin list: `?q=` does a LIKE across `search_cols` (values PARAMETERIZED, %q%),
// `?sort=` orders by a column WHITELISTED against the model's fields (so ?sort=... can't inject SQL). The
// search box submits a GET. search_cols are developer-supplied (a subset of the struct's fields).

// "(col1 LIKE ? OR col2 LIKE ?)" for the search columns (empty -> "").
fn _admin_like_where(search_cols) -> string
    if len(search_cols) == 0
        return ""
    "(" + join([c + " LIKE ?" for c in search_cols], " OR ") + ")"

// ORDER BY only if order_col is a KNOWN column (whitelist -> injection-safe; ?sort=DROP... is ignored).
fn _admin_order_clause(cols, order_col) -> string
    if len(order_col) == 0
        return ""
    if contains(cols, order_col) == false
        return ""
    " ORDER BY " + order_col

// Build a parameterized search+sort SELECT. Returns [sql, params]. q="" -> no WHERE.
fn admin_search_sql(table: string, cols, search_cols, q: string, order_col: string) -> list
    let sql = "SELECT * FROM " + table
    let params = []
    if len(q) > 0 and len(search_cols) > 0
        sql = sql + " WHERE " + _admin_like_where(search_cols)
        let i = 0
        while i < len(search_cols)
            push(params, "%" + q + "%")
            i = i + 1
    sql = sql + _admin_order_clause(cols, order_col)
    [sql, params]

// A GET search box (submits ?q=). Value goes into a single-quoted attr; esc() escapes ' and " (attr-safe).
fn admin_search_box(table: string, q: string) -> string
    "<form method='get' action='/admin/" + esc(table) + "'><input name='q' value='" + esc(q) + "' placeholder='search'><button>search</button></form>"

// The searched/sorted list HTML: search box + the edit-enabled table over the matching rows.
fn admin_list_search(pool, table: string, cols, search_cols, q: string, order_col: string) -> string
    let built = admin_search_sql(table, cols, search_cols, q, order_col)
    let rows = pool_query_dicts(pool, built[0], built[1], cols)
    admin_search_box(table, q) + admin_render_table_ed(table, cols, rows)

fn _admin_list_search_resp(req, pool, table, cols, search_cols)
    let q = ""
    if contains(req.query, "q")
        q = req.query["q"]
    let sort = ""
    if contains(req.query, "sort")
        sort = req.query["sort"]
    html(200, admin_list_search(pool, table, cols, search_cols, q, sort))

// Full model CRUD admin whose LIST supports ?q= search + ?sort= (whitelisted). search_cols = the fields to
// search. Everything else mirrors admin_resource_model.
fn admin_resource_searchable(app, pool, table: string, model_sample, search_cols)
    let cols = admin_cols_of(model_sample)
    let base = "/admin/" + table
    get(app, base, fn(req) _admin_list_search_resp(req, pool, table, cols, search_cols))
    get(app, base + "/new", fn(req) html(200, admin_render_create_form(table, cols)))
    post(app, base, fn(req) _admin_create_resp_ed(req, pool, table, cols))
    get(app, base + "/:id/edit", fn(req) _admin_edit_resp(req, pool, table, cols))
    post(app, base + "/:id/update", fn(req) _admin_update_resp(req, pool, table, cols))
    post(app, base + "/:id/delete", fn(req) _admin_delete_resp_ed(req, pool, table, cols))
    app

// -- D7.3: FK picker + bulk-action render helpers --------------------------------------------------
// FK picker: render a <select> of related rows (Django FK widget parity). admin_fk_select renders
// a <select name='field'> whose options are [value, label] pairs (related rows' id + display label);
// the option matching `selected` gets the `selected` attribute.
//
// Bulk actions: admin_bulk_form renders a POST form to /admin/<table>/bulk/<action> with one
// checkbox per row (name='ids' value=row id) + a submit button. admin_action_ids extracts the
// checked ids from the incoming POST request's form field "ids" (may be a single string or a list).
//
// This is the RENDER + extract layer; the caller registers the bulk route and supplies the FK
// options (a query of the related table). "Verified by reasoning":
//   admin_fk_select("user_id", [["1","alice"],["2","bob"]], "2")
//   -> <select name='user_id'><option value='1'>alice</option><option value='2' selected>bob</option></select>

// Render an HTML <select> for a foreign-key field. `options` is a list of [value, label] pairs;
// `selected` is the currently-selected value ("" for none). Every value/label/field is HTML-escaped.
fn admin_fk_select(field: string, options, selected: string) -> string
    let h = "<select name='" + esc(field) + "'>"
    let i = 0
    while i < len(options)
        let opt = options[i]
        let val = str(opt[0])
        let lbl = str(opt[1])
        if val == selected
            h = h + "<option value='" + esc(val) + "' selected>" + esc(lbl) + "</option>"
        else
            h = h + "<option value='" + esc(val) + "'>" + esc(lbl) + "</option>"
        i = i + 1
    h + "</select>"

// Render a bulk-action form: POST to /admin/<table>/bulk/<action>, one checkbox per row (name='ids'
// value=row id), plus a submit button. `rows` is a list of name-keyed dicts each containing "id".
fn admin_bulk_form(table: string, action: string, rows) -> string
    let h = "<form method='post' action='/admin/" + esc(table) + "/bulk/" + esc(action) + "'>"
    let i = 0
    while i < len(rows)
        let row = rows[i]
        let idv = ""
        if contains(row, "id")
            idv = str(row["id"])
        h = h + "<label><input type='checkbox' name='ids' value='" + esc(idv) + "'> " + esc(idv) + "</label><br>"
        i = i + 1
    h + "<button>" + esc(action) + "</button></form>"

// Extract the selected ids from a bulk POST. The form field "ids" may be a single string or a list
// (when multiple checkboxes are checked). Returns a list of id strings; empty list if absent.
fn admin_action_ids(req) -> list
    let f = body_form(req)
    if contains(f, "ids")
        let v = f["ids"]
        if type_of(v) == "list"
            return v
        return [v]
    []

// -- D7.4 + D7.5: object-level permissions + audit log -----------------------------------------------
// Object-level perms (a perms_fn(actor,obj,action)->bool gate; no fn = allow) + an audit log (a
// LogEntry row per mutation, Django parity). "Verified by reasoning":
//   admin_can(0, "u","user","edit") -> true (no gate);
//   admin_audit_ddl shape;
//   admin_audit_record binds 4 params.

// admin_can -- object-level permission gate.
// perms_fn is either the int sentinel 0 (no check -> allow all) or a fn(actor, obj, action) -> bool.
// Detect via type_of: "int" means no gate was supplied -> return true. Otherwise call through the fn.
fn admin_can(perms_fn, actor: string, obj: string, action: string) -> bool
    if type_of(perms_fn) == "int"
        return true
    let f = perms_fn
    f(actor, obj, action)

// admin_audit_ddl -- returns the CREATE TABLE statement for the audit log table.
// Call once at startup (pool_query(pool, admin_audit_ddl(), [])) to ensure the table exists.
fn admin_audit_ddl() -> string
    "CREATE TABLE IF NOT EXISTS admin_audit (id INTEGER PRIMARY KEY, action TEXT, tbl TEXT, row_id TEXT, actor TEXT)"

// admin_audit_record -- append one audit row (injection-safe: all four values are bound params).
// action = the operation ("create"/"update"/"delete"), table = target table name,
// row_id = the affected row's id as string, actor = the user who performed the action.
fn admin_audit_record(pool, action: string, table: string, row_id: string, actor: string) -> int
    pool_query(pool, "INSERT INTO admin_audit (action, tbl, row_id, actor) VALUES (?, ?, ?, ?)", [action, table, row_id, actor])
    0

// admin_audit_all -- return all rows from the audit log as a list of name-keyed dicts.
fn admin_audit_all(pool) -> list
    db_all(pool, "admin_audit")
