// forge_units -- everyday unit conversions (temperature, distance, weight) for weather, fitness, cooking, and
// international apps. Integer-rounded (whole-number display). LEAF -- imports NOTHING.

// Celsius -> Fahrenheit (rounded). c_to_f(100)=212, c_to_f(0)=32.
fn c_to_f(c: int) -> int
    (c * 9) / 5 + 32

// Fahrenheit -> Celsius (rounded).
fn f_to_c(f: int) -> int
    ((f - 32) * 5) / 9

// Celsius -> Kelvin (approx, 273).
fn c_to_k(c: int) -> int
    c + 273

// Miles -> kilometers (rounded).
fn mi_to_km(mi: int) -> int
    (mi * 1609 + 500) / 1000

// Kilometers -> miles (rounded).
fn km_to_mi(km: int) -> int
    (km * 1000 + 805) / 1609

// Pounds -> kilograms (rounded).
fn lb_to_kg(lb: int) -> int
    (lb * 4536 + 5000) / 10000

// Kilograms -> pounds (rounded).
fn kg_to_lb(kg: int) -> int
    (kg * 10000 + 2268) / 4536
