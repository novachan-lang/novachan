// forge_indicators -- the classic technical-analysis indicators for a price/metric series: RSI, Bollinger
// Bands, and MACD. These turn a raw sequence of numbers into trading/monitoring signals. RSI (Relative Strength
// Index) is a 0-100 momentum oscillator -- above ~70 is "overbought", below ~30 "oversold". BOLLINGER BANDS
// wrap a moving average in +/- k standard deviations, so you can see when a value is unusually far from its
// recent norm (volatility breakout / mean-reversion). MACD (Moving Average Convergence Divergence) is the gap
// between a fast and a slow exponential moving average -- positive means the short-term trend is above the
// long-term one. Useful beyond finance too: any KPI/latency/temperature series you want momentum and
// volatility signals from. Prices are a list of numbers. Imports forge_movingavg (for EMA).

import forge_movingavg

// RSI over the last `period` price changes: 100 * avg_gain / (avg_gain + avg_loss), in [0,100]. Needs more than
// `period` prices. Returns 100 if there were no losses, 0 if no gains, 50 for balanced.
fn rsi(prices: list, period: int) -> float
    let out = 0.0
    let n = len(prices)
    if n > period and period > 0
        let gain = 0.0
        let loss = 0.0
        let start = n - period
        let i = start
        while i < n
            let ch = prices[i] * 1.0 - prices[i - 1] * 1.0
            if ch > 0.0
                gain += ch
            else
                loss -= ch
            i += 1
        let avg_gain = gain / (period * 1.0)
        let avg_loss = loss / (period * 1.0)
        if avg_loss == 0.0
            out = 100.0
        else
            let rs = avg_gain / avg_loss
            out = 100.0 - 100.0 / (1.0 + rs)
    out

// Bollinger Bands over the last `period` values: [upper, middle, lower] where middle is the SMA and the bands
// are +/- k standard deviations (population). k is typically 2.0.
fn bollinger(prices: list, period: int, k: float) -> list
    let n = len(prices)
    let out = [0.0, 0.0, 0.0]
    if n >= period and period > 0
        let start = n - period
        let sum = 0.0
        let i = start
        while i < n
            sum += prices[i] * 1.0
            i += 1
        let mean = sum / (period * 1.0)
        let sumsq = 0.0
        let j = start
        while j < n
            let d = prices[j] * 1.0 - mean
            sumsq += d * d
            j += 1
        let variance = sumsq / (period * 1.0)
        let kk = k * 1.0
        // inline sqrt in the band expressions (never store a sqrt result in a local used in arithmetic)
        out = [mean + kk * sqrt(variance), mean, mean - kk * sqrt(variance)]
    out

// The width of the Bollinger channel (upper - lower) -- a simple volatility gauge.
fn bollinger_bandwidth(prices: list, period: int, k: float) -> float
    let b = bollinger(prices, period, k)
    let w = b[0] * 1.0 - b[2] * 1.0
    w

// MACD line: EMA(fast) - EMA(slow) of the series (typically fast=12, slow=26). Positive => short-term trend is
// above the long-term trend (bullish momentum); negative => below.
fn macd_line(prices: list, fast: int, slow: int) -> float
    let ef = ema_new_span(fast)
    let es = ema_new_span(slow)
    for i in 0..len(prices)
        ema_add(ef, prices[i])
        ema_add(es, prices[i])
    let out = ema_value(ef) * 1.0 - ema_value(es) * 1.0
    out
