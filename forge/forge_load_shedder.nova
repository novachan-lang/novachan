// forge_load_shedder — Drop low-priority requests under overload.

fn ls_new(capacity: int) -> dict
    {"capacity": capacity, "inflight": 0, "accepted": 0, "shed": 0}

fn ls_admit(ls: dict, priority: int) -> dict
    let result = {}
    if ls["inflight"] < ls["capacity"]
        ls["inflight"] += 1
        ls["accepted"] += 1
        result["admitted"] = 1
    else if priority >= 10
        ls["inflight"] += 1
        ls["accepted"] += 1
        result["admitted"] = 1
    else
        ls["shed"] += 1
        result["admitted"] = 0
    result["ls"] = ls
    result

fn ls_complete(ls: dict) -> dict
    ls["inflight"] = (ls["inflight"] - 1) if ls["inflight"] > 0 else ls["inflight"]
    ls

fn ls_inflight(ls: dict) -> int
    ls["inflight"]

fn ls_total_accepted(ls: dict) -> int
    ls["accepted"]

fn ls_total_shed(ls: dict) -> int
    ls["shed"]

fn ls_shed_rate(ls: dict) -> int
    let total = ls["accepted"] + ls["shed"]
    0 if total == 0 else ls["shed"] * 100 / total

fn ls_utilization(ls: dict) -> int
    0 if ls["capacity"] == 0 else ls["inflight"] * 100 / ls["capacity"]
