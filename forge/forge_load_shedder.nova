// forge_load_shedder — Drop low-priority requests under overload.

fn ls_new(capacity: int) -> dict
    let ls = {}
    ls["capacity"] = capacity
    ls["inflight"] = 0
    ls["accepted"] = 0
    ls["shed"] = 0
    ls

fn ls_admit(ls: dict, priority: int) -> dict
    let result = {}
    if ls["inflight"] < ls["capacity"]
        ls["inflight"] = ls["inflight"] + 1
        ls["accepted"] = ls["accepted"] + 1
        result["admitted"] = 1
    else
        if priority >= 10
            ls["inflight"] = ls["inflight"] + 1
            ls["accepted"] = ls["accepted"] + 1
            result["admitted"] = 1
        else
            ls["shed"] = ls["shed"] + 1
            result["admitted"] = 0
    result["ls"] = ls
    result

fn ls_complete(ls: dict) -> dict
    if ls["inflight"] > 0
        ls["inflight"] = ls["inflight"] - 1
    ls

fn ls_inflight(ls: dict) -> int
    ls["inflight"]

fn ls_total_accepted(ls: dict) -> int
    ls["accepted"]

fn ls_total_shed(ls: dict) -> int
    ls["shed"]

fn ls_shed_rate(ls: dict) -> int
    let total = ls["accepted"] + ls["shed"]
    if total == 0
        return 0
    ls["shed"] * 100 / total

fn ls_utilization(ls: dict) -> int
    if ls["capacity"] == 0
        return 0
    ls["inflight"] * 100 / ls["capacity"]
