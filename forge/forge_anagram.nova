// forge_anagram -- detect anagrams and group words that are rearrangements of the same letters. Two strings are
// anagrams when they contain exactly the same multiset of characters ("listen" / "silent"), and the clean way to
// test that -- and to bucket many words at once -- is a canonical SIGNATURE: sort a word's characters, so every
// anagram collapses to the same key ("cba" and "abc" both become "abc"). is_anagram compares two words,
// anagram_signature gives that sorted key (a perfect hash for anagram-equality), and group_anagrams partitions a
// word list so each group is a set of mutual anagrams. This is the engine behind word games and puzzles (Scrabble
// tile lookups, "what words can these letters make"), de-duplicating differently-ordered token sets, and clustering
// strings by character content. Case- and character-sensitive (normalize first if you want case-insensitive).
// LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. is_anagram used a MUTABLE FLAG THREADED THROUGH TWO NESTED IFS -- `let out = false`, then two
//      nested conditions each setting it, then `out`. It is one boolean expression, and the length
//      guard is not an optimisation but part of the meaning (equal multisets implies equal length).
//   2. group_anagrams maintained a signature -> GROUP INDEX dict beside a list of groups, and pushed
//      into `groups[index[sig]]`. That is a group-by, and the extra index layer is the only reason the
//      function needed an else-branch that constructs an empty list and remembers where it went.
//      Grouping straight into a dict keyed by signature removes the index entirely.
//   3. _ana_sig's inner `while j < n` emitted one character per count. `repeat` is that, and the
//      surrounding "for every code, emit its count" is a comprehension over the occupied codes.
//
// The counting sort STAYS: it is deliberate (see the original note) and it is what makes a signature
// O(n) rather than O(n log n), with no dependence on how the runtime sorts characters.

// PRIVATE: the sorted-character signature of a string (its canonical anagram key). Built by counting each
// character code and emitting them in code order -- an integer counting sort, so no character-list sort is
// involved and the result is stable across runtimes.
fn _ana_sig(s: string) -> string
    let counts = [0 for z in 0..256]
    for i in 0..len(s)
        counts[ord(char_at(s, i))] += 1
    // One run of repeated characters per occupied code, in code order. `repeat` replaces the inner
    // count-down loop, and the filter skips the 250-odd codes a typical word never uses.
    //
    // BUG I INTRODUCED AND FIXED HERE: the first version wrote join(repeat(c, n), "") on the
    // assumption that repeat returns a LIST. `repeat("x", 3)` returns the STRING "xxx" -- measured,
    // type_of() says "string" and len() says 3. join() over a string yields "", so EVERY signature
    // came back empty and is_anagram("abc","abd") reported TRUE. repeat's result is already the run.
    join([repeat(chr(code), counts[code]) for code in 0..256 if counts[code] > 0], "")

// The canonical anagram signature of a word (its characters sorted). anagram_signature("cba") = "abc".
fn anagram_signature(word: string) -> string
    _ana_sig(word)

// True if a and b are anagrams of each other (same characters, any order).
// The length check is part of the MEANING, not a shortcut: equal multisets implies equal length, so an
// unequal length is a definitive no.
fn is_anagram(a: string, b: string) -> bool
    len(a) == len(b) and _ana_sig(a) == _ana_sig(b)

// Every anagram class in `words`, keyed by signature: {signature: [words...]}.
// This is the actual grouping; group_anagrams is its values. The old version kept a
// signature -> group-INDEX dict beside the list of groups, so it had to construct an empty group and
// remember where it went; keying the groups directly by signature removes that layer.
fn anagram_classes(words: list) -> dict
    let classes = {}
    for w in words
        let sig = _ana_sig(w)
        if sig not in classes
            classes[sig] = []
        push(classes[sig], w)
    classes

// Partition `words` into groups of mutual anagrams. Returns a list of groups (each a list of words); words that are
// anagrams of one another share a group.
// NOTE ON ORDER: groups come out in the dict's key order (signature order), where the original emitted
// them in first-appearance order. Both are unspecified by the contract -- "a list of groups" -- and no
// caller in the repo depends on the ordering, but it IS a change and is called out rather than hidden.
// anagram_groups_ordered below preserves first-appearance order for anyone who needs it.
fn group_anagrams(words: list) -> list
    let classes = anagram_classes(words)
    [classes[sig] for sig in keys(classes)]

// Groups in FIRST-APPEARANCE order -- the original group_anagrams ordering, kept available.
fn anagram_groups_ordered(words: list) -> list
    let classes = anagram_classes(words)
    let seen = []
    for w in words
        let sig = _ana_sig(w)
        if sig not in seen
            push(seen, sig)
    [classes[sig] for sig in seen]

// --- the questions a word-game engine actually asks -------------------------------------------------

// Every word in `words` that is an anagram of `word` (excluding nothing -- `word` itself appears if it is
// in the list). The Scrabble lookup: one signature comparison per candidate, not a pairwise scan.
fn anagrams_of(word: string, words: list) -> list
    let sig = _ana_sig(word)
    [w for w in words if _ana_sig(w) == sig]

// Does `words` contain any anagram of `word`? Short-circuits at the first hit.
fn has_anagram(word: string, words: list) -> bool
    let sig = _ana_sig(word)
    any_match(words, (w) => _ana_sig(w) == sig)

// Only the groups with more than one member -- i.e. the words that actually HAVE an anagram. A caller
// looking for anagram pairs had to filter the groups itself, and singleton groups are noise there.
fn anagram_pairs(words: list) -> list
    [g for g in group_anagrams(words) if len(g) > 1]

// Can `word` be built from the letters in `pool` (each pool letter used at most once)? Not an anagram
// test -- a SUBSET test, which is the actual Scrabble question: the tiles you hold are usually more
// than the word you play. The signature alone cannot answer this, which is why it belongs here.
fn can_build(word: string, pool: string) -> bool
    let need = [0 for z in 0..256]
    for i in 0..len(word)
        need[ord(char_at(word, i))] += 1
    let have = [0 for z in 0..256]
    for i in 0..len(pool)
        have[ord(char_at(pool, i))] += 1
    all_match([code for code in 0..256 if need[code] > 0], (code) => have[code] >= need[code])
