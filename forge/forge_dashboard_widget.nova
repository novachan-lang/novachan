fn dw_new()
    let s = {}
    s["widget_count"] = 0
    s["widget_names"] = ""
    return s

fn dw_add(s, widget_name, widget_type, data_source)
    let idx = int(s["widget_count"])
    s["w_" + str(idx) + "_name"] = widget_name
    s["w_" + str(idx) + "_type"] = widget_type
    s["w_" + str(idx) + "_source"] = data_source
    s["w_" + str(idx) + "_visible"] = 1
    s["widget_count"] = idx + 1
    if s["widget_names"] == ""
        s["widget_names"] = widget_name
    else
        s["widget_names"] = str(s["widget_names"]) + "," + widget_name
    return s

fn dw_get_type(s, widget_name) -> Result
    let count = int(s["widget_count"])
    let i = 0
    while i < count
        let wname = str(s["w_" + str(i) + "_name"])
        if wname == widget_name
            return ok(str(s["w_" + str(i) + "_type"]))
        i = i + 1
    return err("widget not found: " + widget_name)

fn dw_get_source(s, widget_name) -> Result
    let count = int(s["widget_count"])
    let i = 0
    while i < count
        let wname = str(s["w_" + str(i) + "_name"])
        if wname == widget_name
            return ok(str(s["w_" + str(i) + "_source"]))
        i = i + 1
    return err("widget not found: " + widget_name)

fn dw_set_visible(s, widget_name, visible) -> Result
    let count = int(s["widget_count"])
    let i = 0
    while i < count
        let wname = str(s["w_" + str(i) + "_name"])
        if wname == widget_name
            s["w_" + str(i) + "_visible"] = visible
            return ok(s)
        i = i + 1
    return err("widget not found: " + widget_name)

fn dw_is_visible(s, widget_name) -> Result
    let count = int(s["widget_count"])
    let i = 0
    while i < count
        let wname = str(s["w_" + str(i) + "_name"])
        if wname == widget_name
            return ok(int(s["w_" + str(i) + "_visible"]))
        i = i + 1
    return err("widget not found: " + widget_name)

fn dw_widget_count(s)
    return int(s["widget_count"])

fn dw_visible_count(s)
    let count = int(s["widget_count"])
    let vis = 0
    let i = 0
    while i < count
        if int(s["w_" + str(i) + "_visible"]) == 1
            vis = vis + 1
        i = i + 1
    return vis

fn dw_widget_list(s)
    return str(s["widget_names"])

fn dw_has_widget(s, widget_name)
    let count = int(s["widget_count"])
    let i = 0
    while i < count
        let wname = str(s["w_" + str(i) + "_name"])
        if wname == widget_name
            return 1
        i = i + 1
    return 0
