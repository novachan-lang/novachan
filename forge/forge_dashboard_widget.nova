fn dw_new()
    return {"widget_count": 0, "widget_names": ""}

fn dw_add(s, widget_name, widget_type, data_source)
    let idx = int(s["widget_count"])
    s["w_{idx}_name"] = widget_name
    s["w_{idx}_type"] = widget_type
    s["w_{idx}_source"] = data_source
    s["w_{idx}_visible"] = 1
    s["widget_count"] = idx + 1
    s["widget_names"] = widget_name if s["widget_names"] == "" else str(s["widget_names"]) + "," + widget_name
    return s

fn dw_get_type(s, widget_name) -> Result
    let count = int(s["widget_count"])
    for i in 0..count
        let wname = str(s["w_{i}_name"])
        if wname == widget_name
            return ok(str(s["w_{i}_type"]))
    return err("widget not found: {widget_name}")

fn dw_get_source(s, widget_name) -> Result
    let count = int(s["widget_count"])
    for i in 0..count
        let wname = str(s["w_{i}_name"])
        if wname == widget_name
            return ok(str(s["w_{i}_source"]))
    return err("widget not found: {widget_name}")

fn dw_set_visible(s, widget_name, visible) -> Result
    let count = int(s["widget_count"])
    for i in 0..count
        let wname = str(s["w_{i}_name"])
        if wname == widget_name
            s["w_{i}_visible"] = visible
            return ok(s)
    return err("widget not found: {widget_name}")

fn dw_is_visible(s, widget_name) -> Result
    let count = int(s["widget_count"])
    for i in 0..count
        let wname = str(s["w_{i}_name"])
        if wname == widget_name
            return ok(int(s["w_{i}_visible"]))
    return err("widget not found: {widget_name}")

fn dw_widget_count(s)
    return int(s["widget_count"])

fn dw_visible_count(s)
    let count = int(s["widget_count"])
    let vis = 0
    for i in 0..count
        if int(s["w_{i}_visible"]) == 1
            vis += 1
    return vis

fn dw_widget_list(s)
    return str(s["widget_names"])

fn dw_has_widget(s, widget_name)
    let count = int(s["widget_count"])
    for i in 0..count
        let wname = str(s["w_{i}_name"])
        if wname == widget_name
            return 1
    return 0
