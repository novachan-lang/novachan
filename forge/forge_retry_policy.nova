// forge_retry_policy — Configurable retry strategies.
// Fixed, linear, exponential backoff with jitter, max retries, budget.

fn rp_fixed(delay_ms: int, max_retries: int) -> dict
    {"strategy": "fixed", "delay_ms": delay_ms, "max_retries": max_retries,
     "attempts": 0, "successes": 0, "failures": 0, "exhausted": 0}

fn rp_linear(base_ms: int, increment_ms: int, max_retries: int) -> dict
    {"strategy": "linear", "base_ms": base_ms, "increment_ms": increment_ms, "max_retries": max_retries,
     "attempts": 0, "successes": 0, "failures": 0, "exhausted": 0}

fn rp_exponential(base_ms: int, max_ms: int, max_retries: int) -> dict
    {"strategy": "exponential", "base_ms": base_ms, "max_ms": max_ms, "max_retries": max_retries,
     "attempts": 0, "successes": 0, "failures": 0, "exhausted": 0}

fn rp_should_retry(rp: dict) -> int
    0 if rp["attempts"] >= rp["max_retries"] else 1

fn rp_next_delay(rp: dict) -> int
    let attempt = rp["attempts"]
    if rp["strategy"] == "fixed"
        return rp["delay_ms"]
    if rp["strategy"] == "linear"
        return rp["base_ms"] + attempt * rp["increment_ms"]
    if rp["strategy"] == "exponential"
        let delay = rp["base_ms"]
        for i in 0..attempt
            delay = delay * 2
        return rp["max_ms"] if delay > rp["max_ms"] else delay
    0

fn rp_record_attempt(rp: dict) -> dict
    rp["attempts"] += 1
    rp

fn rp_record_success(rp: dict) -> dict
    rp["successes"] += 1
    rp

fn rp_record_failure(rp: dict) -> dict
    rp["failures"] += 1
    if rp["attempts"] >= rp["max_retries"]
        rp["exhausted"] = 1
    rp

fn rp_reset(rp: dict) -> dict
    rp["attempts"] = 0
    rp["exhausted"] = 0
    rp

fn rp_is_exhausted(rp: dict) -> int
    rp["exhausted"]

fn rp_stats(rp: dict) -> dict
    {"strategy": rp["strategy"], "attempts": rp["attempts"], "successes": rp["successes"],
     "failures": rp["failures"], "max_retries": rp["max_retries"], "exhausted": rp["exhausted"]}
