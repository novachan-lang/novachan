// forge_retry_policy — Configurable retry strategies.
// Fixed, linear, exponential backoff with jitter, max retries, budget.

fn rp_fixed(delay_ms: int, max_retries: int) -> dict
    let rp = {}
    rp["strategy"] = "fixed"
    rp["delay_ms"] = delay_ms
    rp["max_retries"] = max_retries
    rp["attempts"] = 0
    rp["successes"] = 0
    rp["failures"] = 0
    rp["exhausted"] = 0
    rp

fn rp_linear(base_ms: int, increment_ms: int, max_retries: int) -> dict
    let rp = {}
    rp["strategy"] = "linear"
    rp["base_ms"] = base_ms
    rp["increment_ms"] = increment_ms
    rp["max_retries"] = max_retries
    rp["attempts"] = 0
    rp["successes"] = 0
    rp["failures"] = 0
    rp["exhausted"] = 0
    rp

fn rp_exponential(base_ms: int, max_ms: int, max_retries: int) -> dict
    let rp = {}
    rp["strategy"] = "exponential"
    rp["base_ms"] = base_ms
    rp["max_ms"] = max_ms
    rp["max_retries"] = max_retries
    rp["attempts"] = 0
    rp["successes"] = 0
    rp["failures"] = 0
    rp["exhausted"] = 0
    rp

fn rp_should_retry(rp: dict) -> int
    if rp["attempts"] >= rp["max_retries"]
        return 0
    1

fn rp_next_delay(rp: dict) -> int
    let attempt = rp["attempts"]
    if rp["strategy"] == "fixed"
        return rp["delay_ms"]
    if rp["strategy"] == "linear"
        return rp["base_ms"] + attempt * rp["increment_ms"]
    if rp["strategy"] == "exponential"
        let delay = rp["base_ms"]
        for i in 0..attempt
            delay = delay * 2
        if delay > rp["max_ms"]
            return rp["max_ms"]
        return delay
    0

fn rp_record_attempt(rp: dict) -> dict
    rp["attempts"] = rp["attempts"] + 1
    rp

fn rp_record_success(rp: dict) -> dict
    rp["successes"] = rp["successes"] + 1
    rp

fn rp_record_failure(rp: dict) -> dict
    rp["failures"] = rp["failures"] + 1
    if rp["attempts"] >= rp["max_retries"]
        rp["exhausted"] = 1
    rp

fn rp_reset(rp: dict) -> dict
    rp["attempts"] = 0
    rp["exhausted"] = 0
    rp

fn rp_is_exhausted(rp: dict) -> int
    rp["exhausted"]

fn rp_stats(rp: dict) -> dict
    let s = {}
    s["strategy"] = rp["strategy"]
    s["attempts"] = rp["attempts"]
    s["successes"] = rp["successes"]
    s["failures"] = rp["failures"]
    s["max_retries"] = rp["max_retries"]
    s["exhausted"] = rp["exhausted"]
    s
