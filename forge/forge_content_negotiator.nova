// forge_content_negotiator — HTTP content-type negotiation with Result API.

fn cn_new() -> dict
    {"type_count": 0, "negotiations": 0}

fn cn_add_type(c: dict, media_type: string, quality: int) -> dict
    let idx = c["type_count"]
    let tk = "t_{idx}"
    c["{tk}_type"] = media_type
    c["{tk}_q"] = quality
    c["type_count"] = idx + 1
    c

fn cn_negotiate(c: dict, accepted: string) -> Result
    c["negotiations"] += 1
    let best_idx = -1
    let best_q = -1
    for i in 0..c["type_count"]
        let mt = c["t_{i}_type"]
        if mt == accepted
            let q = c["t_{i}_q"]
            if q > best_q
                best_q = q
                best_idx = i
    if best_idx == -1
        return err("no matching type for: {accepted}")
    ok(c["t_{best_idx}_type"])

fn cn_best(c: dict) -> Result
    if c["type_count"] == 0
        return err("no types registered")
    let best_idx = 0
    let best_q = c["t_0_q"]
    for i in 1..c["type_count"]
        let q = c["t_{i}_q"]
        if q > best_q
            best_q = q
            best_idx = i
    ok(c["t_{best_idx}_type"])

fn cn_type_count(c: dict) -> int
    c["type_count"]

fn cn_negotiation_count(c: dict) -> int
    c["negotiations"]
