// forge_webhook_dispatcher — webhook registration and dispatch tracking with Result API.

fn wd_new() -> dict
    let w = {}
    w["hook_count"] = 0
    w["dispatches"] = 0
    w["failures"] = 0
    w

fn wd_register(w: dict, event: string, url: string) -> dict
    let idx = w["hook_count"]
    w["h_" + str(idx) + "_event"] = event
    w["h_" + str(idx) + "_url"] = url
    w["h_" + str(idx) + "_active"] = 1
    w["hook_count"] = idx + 1
    w

fn wd_dispatch(w: dict, event: string) -> int
    let sent = 0
    let i = 0
    while i < w["hook_count"]
        if w["h_" + str(i) + "_event"] == event
            if w["h_" + str(i) + "_active"] == 1
                sent += 1
        i += 1
    w["dispatches"] = w["dispatches"] + sent
    sent

fn wd_disable(w: dict, index: int) -> Result
    if index < 0 or index >= w["hook_count"]
        return err("webhook index out of range")
    w["h_" + str(index) + "_active"] = 0
    ok(w)

fn wd_enable(w: dict, index: int) -> Result
    if index < 0 or index >= w["hook_count"]
        return err("webhook index out of range")
    w["h_" + str(index) + "_active"] = 1
    ok(w)

fn wd_url(w: dict, index: int) -> Result
    if index < 0 or index >= w["hook_count"]
        return err("webhook index out of range")
    ok(w["h_" + str(index) + "_url"])

fn wd_hook_count(w: dict) -> int
    w["hook_count"]

fn wd_total_dispatches(w: dict) -> int
    w["dispatches"]
