// forge_rsdecode -- the CORRECTING half of Reed-Solomon: not just detecting corruption (forge_rs) but locating and
// REPAIRING it. Given a codeword produced by forge_rs.rs_encode over GF(2^8) with nsym parity symbols, this recovers
// the original data even after up to nsym/2 of its bytes have been changed to anything at all -- the magic that lets
// a QR code work with a chunk torn off, a CD play through a scratch, and a spacecraft's telemetry survive noise.
// It runs the classic three-stage pipeline: SYNDROMES (evaluate the received word at the generator's roots 3^i; all
// zero means no errors), the BERLEKAMP-MASSEY algorithm to find the error-locator polynomial from those syndromes,
// a CHIEN search to turn that polynomial's roots into the exact byte positions that are wrong, and FORNEY's formula
// to compute what each of those bytes should have been. As a safety net it re-checks the syndromes after
// correcting: rs_correct returns the repaired codeword only if the result is genuinely a valid codeword, and an
// EMPTY list if there were too many errors to fix -- so it never silently hands back wrong data. Polynomials here
// are low-endian (index i is the x^i coefficient); imports forge_gf256 (a leaf) -- forge-only, compiler untouched.

import forge_gf256 as gf
import forge_rs as rs

// PRIVATE: deep copy of a list (produces a mutable duplicate).
fn _rd_dup(a: list) -> list
    return [v for v in a]

// PRIVATE: evaluate a LOW-endian polynomial (index i is the x^i coefficient) at x.
fn _rd_eval_le(p: list, x: int) -> int
    let y = 0
    // Horner from the HIGHEST coefficient down. Written as a counted range with an explicit descending
    // index rather than `for v in reverse(p)`: reverse() allocates a fresh list, and this runs once per
    // codeword position inside the Chien search.
    for k in 0..len(p)
        y = gf.gf_mul(y, x) ^ p[len(p) - 1 - k]
    return y

// The nsym syndromes of a received codeword: syndrome i = codeword evaluated at 3^i (i from 0). All zero iff the
// codeword is uncorrupted.
// DELEGATED to forge_rs.rs_syndromes: this module's _rd_syndromes/_rd_eval_high pair was a character-for-character
// copy of rs_syndromes/_rs_poly_eval (same Horner loop over a HIGH-endian codeword, same gf_pow(3, i) roots, same
// behaviour on nsym <= 0 -> [] and on an empty codeword -> the same out-of-range read). Verified by reading both.
fn _rd_syndromes(codeword: list, nsym: int) -> list
    return rs.rs_syndromes(codeword, nsym)

// PRIVATE: the shared body of both Berlekamp-Massey update branches -- grow C to len(B)+m and XOR in
// coef*B shifted by m. It was written out TWICE, once per branch, with only the surrounding bookkeeping
// differing. `c` is updated in place and returned.
fn _rd_update_c(c: list, b: list, m: int, coef: int) -> list
    // KEPT as `while`: grows `c` until a length condition holds -- the bound IS the thing being changed.
    while len(c) < len(b) + m
        push(c, 0)
    for j in 0..len(b)
        c[j + m] = c[j + m] ^ gf.gf_mul(coef, b[j])
    return c

// PRIVATE: Berlekamp-Massey over GF(2^8). Given syndromes S[0..nsym-1], returns the error-locator polynomial
// Lambda (low-endian, Lambda[0] == 1) whose degree is the number of errors.
// The iteration itself is an ALGORITHM STATE MACHINE (c, b, ll, m, bb carry across steps) -- left structurally
// intact; only the counted loops and the duplicated update block were raised.
fn _rd_berlekamp(s: list, nsym: int) -> list
    let c = [1]
    let b = [1]
    let ll = 0
    let m = 1
    let bb = 1
    for n in 0..nsym
        // discrepancy (coefficients beyond the current length of c are implicitly 0)
        let delta = s[n]
        for i in 1..(ll + 1)
            if i < len(c)
                delta = delta ^ gf.gf_mul(c[i], s[n - i])
        if delta == 0
            m += 1
        else
            if 2 * ll <= n
                let t = _rd_dup(c)
                c = _rd_update_c(c, b, m, gf.gf_div(delta, bb))
                ll = n + 1 - ll
                b = t
                bb = delta
                m = 1
            else
                c = _rd_update_c(c, b, m, gf.gf_div(delta, bb))
                m += 1
    return c

// PRIVATE: multiply two low-endian polynomials over GF(2^8), keeping only coefficients of degree < limit.
fn _rd_polymul_trunc(a: list, b: list, limit: int) -> list
    let out = [0 for z in 0..limit]
    for i in 0..len(a)
        if i < limit and a[i] != 0
            // the original inner guard `j < len(b) and i + j < limit` is exactly this bound (and the outer
            // `i < limit` guarantees limit - i >= 1, so the range is never negative)
            for j in 0..min(len(b), limit - i)
                out[i + j] = out[i + j] ^ gf.gf_mul(a[i], b[j])
    return out

// PRIVATE: formal derivative of a low-endian polynomial over GF(2^8): in characteristic 2 the even-degree terms
// vanish, so d/dx of sum L[i] x^i keeps the odd-index coefficients, shifted down by one (L' [i] = L[i+1] when i is
// even, else 0).
fn _rd_derivative(p: list) -> list
    return [(p[i] if i % 2 == 1 else 0) for i in 1..len(p)]

// Correct up to nsym/2 errors in a received codeword. Returns the repaired codeword (equal to the original clean
// codeword) or an EMPTY list if it could not be corrected (too many errors). Never returns wrong data: the result
// is re-validated by recomputing its syndromes.
fn rs_correct(codeword: list, nsym: int) -> list
    let n = len(codeword)
    let s = _rd_syndromes(codeword, nsym)
    // no errors? (all-zero syndromes; an empty syndrome list counts as clean, as before)
    if all([v == 0 for v in s])
        return _rd_dup(codeword)

    let lam = _rd_berlekamp(s, nsym)
    let nu = len(lam) - 1
    // Chien search: positions k whose locator 3^(n-1-k) inverse is a root of Lambda
    let err_pos = []
    let err_x = []
    for k in 0..n
        let xk = gf.gf_pow(3, n - 1 - k)
        if _rd_eval_le(lam, gf.gf_inv(xk)) == 0
            push(err_pos, k)
            push(err_x, xk)
    if len(err_pos) != nu or nu == 0
        return []

    // Forney: Omega = (S * Lambda) mod x^nsym ; magnitude_k = X_k * Omega(X_k^-1) / Lambda'(X_k^-1)
    let omega = _rd_polymul_trunc(s, lam, nsym)
    let lderiv = _rd_derivative(lam)
    let fixed = _rd_dup(codeword)
    let ok = true
    // err_pos and err_x are filled in lockstep, so one index/value walk covers both
    for idx, xk in err_x
        let xk_inv = gf.gf_inv(xk)
        let num = gf.gf_mul(xk, _rd_eval_le(omega, xk_inv))
        let den = _rd_eval_le(lderiv, xk_inv)
        if den == 0
            ok = false
        else
            fixed[err_pos[idx]] = fixed[err_pos[idx]] ^ gf.gf_div(num, den)
    if ok == false
        return []

    // re-validate: a genuine correction zeroes every syndrome
    if all([v == 0 for v in _rd_syndromes(fixed, nsym)])
        return fixed
    return []
