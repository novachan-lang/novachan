// forge_geocoder — Simple geocoder (lookup-based) with Result.

fn geo_new() -> dict
    {"locations": {}, "count": 0, "lookups": 0}

fn geo_add(g: dict, name: string, lat: int, lon: int) -> dict
    g["locations"][name + "_lat"] = lat
    g["locations"][name + "_lon"] = lon
    g["locations"][name + "_exists"] = 1
    g["count"] += 1
    g

fn geo_lookup(g: dict, name: string) -> Result
    g["lookups"] += 1
    if (name + "_exists") not in g["locations"]
        return err("location not found: " + name)
    ok(name)

fn geo_lat(g: dict, name: string) -> Result
    if (name + "_exists") not in g["locations"]
        return err("unknown location")
    ok(g["locations"][name + "_lat"])

fn geo_lon(g: dict, name: string) -> Result
    if (name + "_exists") not in g["locations"]
        return err("unknown location")
    ok(g["locations"][name + "_lon"])

fn geo_count(g: dict) -> int
    g["count"]

fn geo_total_lookups(g: dict) -> int
    g["lookups"]
