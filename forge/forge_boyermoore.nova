// forge_boyermoore -- standalone Boyer-Moore-Horspool wrapper (was a thin,
// self-recursive stub over std/text/boyermoore; std defines the SAME public names
// (bm_search/bm_count) as this module, which is a real codegen collision, not just
// delegation -- so bm_search/bm_count now get genuine bodies built on this file's
// own bm_find_all, and the dead std import is removed).

fn _bm_shift(pattern: string) -> dict
    let m = len(pattern)
    let tbl = {}
    for i in 0..(m - 1)
        tbl[char_at(pattern, i)] = m - 1 - i
    tbl

// bm_search: index of the first occurrence of pattern in text, or -1 if absent.
// Delegates to bm_find_all (this file's own working implementation) for the
// general case; handles the empty-pattern and pattern-longer-than-text edge
// cases explicitly since bm_find_all only searches when 0 < m <= n.
fn bm_search(text: string, pattern: string) -> int
    let n = len(text)
    let m = len(pattern)
    if m == 0
        return 0
    if m > n
        return -1
    let all = bm_find_all(text, pattern)
    if len(all) > 0
        return all[0]
    -1

fn bm_find_all(text: string, pattern: string) -> list
    let n = len(text)
    let m = len(pattern)
    let out = []
    if m > 0 and m <= n
        let tbl = _bm_shift(pattern)
        let pos = 0
        while pos <= n - m
            let j = m - 1
            while j >= 0 and char_at(text, pos + j) == char_at(pattern, j)
                j -= 1
            if j < 0
                push(out, pos)
                pos += 1
            else
                let c = char_at(text, pos + m - 1)
                pos += get(tbl, c, m)
    out

// bm_count: number of (possibly overlapping) occurrences of pattern in text.
// Same edge-case handling as bm_search; otherwise the length of bm_find_all's result.
fn bm_count(text: string, pattern: string) -> int
    let n = len(text)
    let m = len(pattern)
    if m == 0
        return 0
    if m > n
        return 0
    len(bm_find_all(text, pattern))

fn bm_contains(text: string, pattern: string) -> bool
    bm_search(text, pattern) >= 0

