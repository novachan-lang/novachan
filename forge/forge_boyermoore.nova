// forge_boyermoore -- Boyer-Moore-Horspool string search. LEAF -- imports NOTHING.

fn _bm_shift(pattern: string) -> dict
    let m = len(pattern)
    let tbl = {}
    for i in 0..(m - 1)
        tbl[char_at(pattern, i)] = m - 1 - i
    tbl

fn bm_search(text: string, pattern: string) -> int
    let n = len(text)
    let m = len(pattern)
    if m == 0
        return 0
    if m > n
        return -1
    let tbl = _bm_shift(pattern)
    let pos = 0
    while pos <= n - m
        let j = m - 1
        while j >= 0 and char_at(text, pos + j) == char_at(pattern, j)
            j -= 1
        if j < 0
            return pos
        let c = char_at(text, pos + m - 1)
        pos += get(tbl, c, m)
    -1

fn bm_find_all(text: string, pattern: string) -> list
    let n = len(text)
    let m = len(pattern)
    let out = []
    if m > 0 and m <= n
        let tbl = _bm_shift(pattern)
        let pos = 0
        while pos <= n - m
            let j = m - 1
            while j >= 0 and char_at(text, pos + j) == char_at(pattern, j)
                j -= 1
            if j < 0
                push(out, pos)
                pos += 1
            else
                let c = char_at(text, pos + m - 1)
                pos += get(tbl, c, m)
    out

fn bm_count(text: string, pattern: string) -> int
    len(bm_find_all(text, pattern))

fn bm_contains(text: string, pattern: string) -> bool
    bm_search(text, pattern) >= 0
