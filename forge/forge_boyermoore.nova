// forge_boyermoore -- Boyer-Moore-Horspool string search, the algorithm that is FASTEST in practice for a single
// pattern (it's the core idea behind grep, editors' find, and memmem). Unlike KMP/Z (forge_kmp/forge_zalgo) which
// scan left-to-right and never skip a text character, Boyer-Moore compares the pattern RIGHT-to-left and, on a
// mismatch, uses a "bad-character" table to JUMP AHEAD -- often by the whole pattern length -- so it can be
// SUBLINEAR, examining far fewer than n characters on typical text. The longer the pattern and the larger the
// alphabet, the bigger the skips (searching a 20-char needle in English prose touches maybe n/10 characters).
// Horspool is the clean, widely-used simplification that keeps only the bad-character rule, keyed on the text
// character aligned with the pattern's LAST position. Best when the pattern is long and reused across big texts.
// LEAF -- imports NOTHING.

// PRIVATE: the Horspool bad-character shift table. For each character that appears in pattern[0..m-2], the shift
// is m-1 minus its LAST such position; any other character (and the pattern's final character) shifts by m.
fn _bm_shift(pattern: string) -> dict
    let m = len(pattern)
    let tbl = {}
    let i = 0
    while i < m - 1
        tbl[char_at(pattern, i)] = m - 1 - i
        i = i + 1
    tbl

// The index of the FIRST occurrence of pattern in text, or -1 if absent. Empty pattern -> 0.
fn bm_search(text: string, pattern: string) -> int
    let n = len(text)
    let m = len(pattern)
    let out = 0 - 1
    if m == 0
        out = 0
    else
        if m <= n
            let tbl = _bm_shift(pattern)
            let pos = 0
            while pos <= n - m and out < 0
                // compare from the right
                let j = m - 1
                while j >= 0 and char_at(text, pos + j) == char_at(pattern, j)
                    j = j - 1
                if j < 0
                    out = pos
                else
                    // Horspool shift keyed on the last aligned text character
                    let c = char_at(text, pos + m - 1)
                    pos = pos + get(tbl, c, m)
    out

// Every start index where pattern occurs in text (overlapping included), ascending. On a match it advances by one
// so overlapping occurrences are not skipped; on a mismatch it uses the full bad-character jump.
fn bm_find_all(text: string, pattern: string) -> list
    let n = len(text)
    let m = len(pattern)
    let out = []
    if m > 0 and m <= n
        let tbl = _bm_shift(pattern)
        let pos = 0
        while pos <= n - m
            let j = m - 1
            while j >= 0 and char_at(text, pos + j) == char_at(pattern, j)
                j = j - 1
            if j < 0
                push(out, pos)
                pos = pos + 1
            else
                let c = char_at(text, pos + m - 1)
                pos = pos + get(tbl, c, m)
    out

// How many times pattern occurs in text (overlapping counted).
fn bm_count(text: string, pattern: string) -> int
    len(bm_find_all(text, pattern))

// True if pattern occurs anywhere in text.
fn bm_contains(text: string, pattern: string) -> bool
    let ok = false
    if bm_search(text, pattern) >= 0
        ok = true
    ok
