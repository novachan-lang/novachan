// forge_search_index — Inverted index for text search with Result.

fn si_new() -> dict
    let s = {}
    s["docs"] = {}
    s["index"] = {}
    s["doc_count"] = 0
    s["searches"] = 0
    s

fn si_add_doc(s: dict, doc_id: string, text: string) -> dict
    s["docs"][doc_id] = text
    s["doc_count"] = s["doc_count"] + 1
    let i = 0
    let word = ""
    while i <= len(text)
        let ch = ""
        if i < len(text)
            ch = text[i]
        if ch == " " or i == len(text)
            if len(word) > 0
                let key = word + ":" + doc_id
                s["index"][key] = 1
                let has = contains(s["index"], word + "_count")
                if has != true
                    s["index"][word + "_count"] = 1
                else
                    s["index"][word + "_count"] = s["index"][word + "_count"] + 1
            word = ""
        else
            word += ch
        i += 1
    s

fn si_search(s: dict, term: string) -> Result
    s["searches"] = s["searches"] + 1
    let has = contains(s["index"], term + "_count")
    if has != true
        return err("no results for: " + term)
    ok(s["index"][term + "_count"])

fn si_has_doc(s: dict, term: string, doc_id: string) -> int
    let key = term + ":" + doc_id
    let has = contains(s["index"], key)
    if has == true
        return 1
    0

fn si_doc_count(s: dict) -> int
    s["doc_count"]

fn si_total_searches(s: dict) -> int
    s["searches"]
