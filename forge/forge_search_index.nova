// forge_search_index — Inverted index for text search with Result.

fn si_new() -> dict
    {"docs": {}, "index": {}, "doc_count": 0, "searches": 0}

fn si_add_doc(s: dict, doc_id: string, text: string) -> dict
    s["docs"][doc_id] = text
    s["doc_count"] += 1
    let i = 0
    let word = ""
    while i <= len(text)
        let ch = text[i] if i < len(text) else ""
        if ch == " " or i == len(text)
            if len(word) > 0
                s["index"][word + ":" + doc_id] = 1
                s["index"][word + "_count"] = get(s["index"], word + "_count", 0) + 1
            word = ""
        else
            word += ch
        i += 1
    s

fn si_search(s: dict, term: string) -> Result
    s["searches"] += 1
    if term + "_count" not in s["index"]
        return err("no results for: {term}")
    ok(s["index"][term + "_count"])

fn si_has_doc(s: dict, term: string, doc_id: string) -> int
    1 if (term + ":" + doc_id) in s["index"] else 0

fn si_doc_count(s: dict) -> int
    s["doc_count"]

fn si_total_searches(s: dict) -> int
    s["searches"]
