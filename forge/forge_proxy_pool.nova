// forge_proxy_pool — rotating proxy pool with health tracking and Result API.

fn pp_new() -> dict
    let p = {}
    p["proxy_count"] = 0
    p["current"] = 0
    p["total_requests"] = 0
    p["failures"] = 0
    p

fn pp_add_proxy(p: dict, address: string) -> dict
    let idx = p["proxy_count"]
    p["px_" + str(idx) + "_addr"] = address
    p["px_" + str(idx) + "_healthy"] = 1
    p["px_" + str(idx) + "_uses"] = 0
    p["proxy_count"] = idx + 1
    p

fn pp_next(p: dict) -> Result
    if p["proxy_count"] == 0
        return err("no proxies")
    let attempts = 0
    while attempts < p["proxy_count"]
        let idx = p["current"]
        p["current"] = (idx + 1) - ((idx + 1) / p["proxy_count"]) * p["proxy_count"]
        if p["px_" + str(idx) + "_healthy"] == 1
            p["px_" + str(idx) + "_uses"] = p["px_" + str(idx) + "_uses"] + 1
            p["total_requests"] = p["total_requests"] + 1
            return ok(p["px_" + str(idx) + "_addr"])
        attempts = attempts + 1
    err("all proxies unhealthy")

fn pp_mark_failed(p: dict, index: int) -> Result
    if index < 0 or index >= p["proxy_count"]
        return err("proxy index out of range")
    p["px_" + str(index) + "_healthy"] = 0
    p["failures"] = p["failures"] + 1
    ok(p)

fn pp_mark_healthy(p: dict, index: int) -> Result
    if index < 0 or index >= p["proxy_count"]
        return err("proxy index out of range")
    p["px_" + str(index) + "_healthy"] = 1
    ok(p)

fn pp_proxy_count(p: dict) -> int
    p["proxy_count"]

fn pp_total_requests(p: dict) -> int
    p["total_requests"]

fn pp_failure_count(p: dict) -> int
    p["failures"]
