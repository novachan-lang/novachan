// forge_dead_letter_queue — Failed messages for inspection/replay.

fn dlq_new(max_retries: int) -> dict
    let d = {}
    d["max_retries"] = max_retries
    d["msgs"] = {}
    d["msg_count"] = 0
    d["retries"] = {}
    d["total_dead"] = 0
    d["total_replayed"] = 0
    d

fn dlq_fail(d: dict, msg_id: string, reason: string) -> dict
    let has = contains(d["retries"], msg_id)
    let retries = 0
    if has == true
        retries = d["retries"][msg_id]
    retries += 1
    d["retries"][msg_id] = retries
    if retries >= d["max_retries"]
        let k = str(d["msg_count"])
        d["msgs"][k + "_id"] = msg_id
        d["msgs"][k + "_reason"] = reason
        d["msgs"][k + "_retries"] = retries
        d["msg_count"] = d["msg_count"] + 1
        d["total_dead"] = d["total_dead"] + 1
    d

fn dlq_count(d: dict) -> int
    d["msg_count"]

fn dlq_msg_id(d: dict, idx: int) -> string
    d["msgs"][str(idx) + "_id"]

fn dlq_msg_reason(d: dict, idx: int) -> string
    d["msgs"][str(idx) + "_reason"]

fn dlq_replay(d: dict, idx: int) -> dict
    let result = {}
    if idx < 0
        result["ok"] = 0
        result["d"] = d
        return result
    if idx >= d["msg_count"]
        result["ok"] = 0
        result["d"] = d
        return result
    result["ok"] = 1
    result["msg_id"] = d["msgs"][str(idx) + "_id"]
    d["total_replayed"] = d["total_replayed"] + 1
    result["d"] = d
    result

fn dlq_retry_count(d: dict, msg_id: string) -> int
    let has = contains(d["retries"], msg_id)
    if has != true
        return 0
    d["retries"][msg_id]

fn dlq_total_dead(d: dict) -> int
    d["total_dead"]

fn dlq_total_replayed(d: dict) -> int
    d["total_replayed"]
