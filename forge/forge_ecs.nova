// forge_ecs — Entity-Component-System for Reactor game engine.
// Entities, components, systems, queries.

fn ecs_world() -> dict
    {"next_id": 1, "entities": {}, "components": {}, "systems": []}

fn ecs_spawn(world: dict) -> dict
    let id = world["next_id"]
    world["next_id"] = id + 1
    world["entities"][str(id)] = {"id": id, "alive": true}
    world["_last_spawned"] = id
    world

fn ecs_last_id(world: dict) -> int
    world["_last_spawned"]

fn ecs_attach(world: dict, entity_id: int, component_name: string, data: any) -> dict
    let eid = str(entity_id)
    if component_name not in world["components"]
        world["components"][component_name] = {}
    world["components"][component_name][eid] = data
    world

fn ecs_get(world: dict, entity_id: int, component_name: string) -> any
    let eid = str(entity_id)
    if component_name not in world["components"]
        return ""
    let store = world["components"][component_name]
    if eid not in store
        return ""
    store[eid]

fn ecs_has(world: dict, entity_id: int, component_name: string) -> bool
    let eid = str(entity_id)
    if component_name not in world["components"]
        return false
    let store = world["components"][component_name]
    eid in store

fn ecs_query(world: dict, component_name: string) -> list
    let result = []
    if component_name not in world["components"]
        return result
    let store = world["components"][component_name]
    let eids = keys(store)
    for i in 0..len(eids)
        let eid = eids[i]
        if eid in world["entities"]
            let ent = world["entities"][eid]
            if ent["alive"] == true
                push(result, {"entity_id": parse_int(eid), "data": store[eid]})
    result

fn ecs_despawn(world: dict, entity_id: int) -> dict
    let eid = str(entity_id)
    if eid in world["entities"]
        world["entities"][eid]["alive"] = false
    world

fn ecs_alive(world: dict, entity_id: int) -> bool
    let eid = str(entity_id)
    if eid not in world["entities"]
        return false
    world["entities"][eid]["alive"] == true

fn ecs_entity_count(world: dict) -> int
    let count = 0
    let eids = keys(world["entities"])
    for i in 0..len(eids)
        if world["entities"][eids[i]]["alive"] == true
            count += 1
    count

fn ecs_register_system(world: dict, name: string, component: string) -> dict
    push(world["systems"], {"name": name, "component": component})
    world

fn ecs_list_systems(world: dict) -> list
    [world["systems"][i]["name"] for i in 0..len(world["systems"])]
