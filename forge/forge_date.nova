// forge_date -- civil (proleptic Gregorian) DATE arithmetic with integer-exact algorithms (Howard Hinnant's
// days_from_civil / civil_from_days, the same math libc++ <chrono> uses). Real date handling was a gap: this
// gives ISO 8601 parse/format, weekday, add/diff days, days-in-month, leap-year, epoch<->date -- all in pure
// integer math (no floats, no libc time struct, deterministic and timezone-free/UTC). LEAF -- imports NOTHING.

// Days since 1970-01-01 for a civil date (y,m,d). Exact for all Gregorian dates.
fn _days_from_civil(y: int, m: int, d: int) -> int
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    if yy < 0
        era = (yy - 399) / 400
    let yoe = yy - era * 400
    let mm = m - 3
    if m <= 2
        mm = m + 9
    let doy = (153 * mm + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

// Inverse: [y, m, d] for days since 1970-01-01.
fn _civil_from_days(z0: int) -> list
    let z = z0 + 719468
    let era = z / 146097
    if z < 0
        era = (z - 146096) / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    let yr = y
    if m <= 2
        yr = y + 1
    [yr, m, d]

fn is_leap(y: int) -> bool
    if y % 4 != 0
        return false
    if y % 100 != 0
        return true
    y % 400 == 0

fn days_in_month(y: int, m: int) -> int
    if m == 2
        if is_leap(y)
            return 29
        return 28
    if contains([1, 3, 5, 7, 8, 10, 12], m)
        return 31
    30

// Epoch-day helpers (the canonical serializable form).
fn date_to_epoch_days(y: int, m: int, d: int) -> int
    _days_from_civil(y, m, d)

fn date_from_epoch_days(days: int) -> list
    _civil_from_days(days)

// 0=Sunday .. 6=Saturday (1970-01-01 was a Thursday).
fn date_weekday(y: int, m: int, d: int) -> int
    let w = (_days_from_civil(y, m, d) + 4) % 7
    if w < 0
        return w + 7
    w

fn date_weekday_name(wd: int) -> string
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    if wd < 0 or wd > 6
        return ""
    names[wd]

// [y,m,d] shifted by n days (n may be negative). Handles month/year rollover exactly.
fn date_add_days(y: int, m: int, d: int, n: int) -> list
    _civil_from_days(_days_from_civil(y, m, d) + n)

// Signed day count from date1 to date2 (date2 - date1).
fn date_diff_days(y1: int, m1: int, d1: int, y2: int, m2: int, d2: int) -> int
    _days_from_civil(y2, m2, d2) - _days_from_civil(y1, m1, d1)

fn _z2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

fn _z4(n: int) -> string
    let s = str(n)
    while len(s) < 4
        s = "0" + s
    s

// "YYYY-MM-DD" from (y,m,d).
fn date_format_iso(y: int, m: int, d: int) -> string
    _z4(y) + "-" + _z2(m) + "-" + _z2(d)

// Parse "YYYY-MM-DD" (or the date portion of an ISO datetime) -> [y,m,d]; [] if too short.
fn date_parse_iso(s: string) -> list
    if len(s) < 10
        return []
    [parse_int(slice(s, 0, 4)), parse_int(slice(s, 5, 7)), parse_int(slice(s, 8, 10))]

// Today (UTC) as [y,m,d] from the wall clock.
fn date_today() -> list
    _civil_from_days(time_ms() / 86400000)
