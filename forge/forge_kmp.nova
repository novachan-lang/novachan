// forge_kmp -- Knuth-Morris-Pratt string search: find a pattern inside a text in LINEAR time, O(n+m), no matter
// how the pattern repeats. The naive "try every start position" search can degrade to O(n*m) on adversarial input
// (text "aaaa...a", pattern "aaa...ab") because it re-examines the same text characters over and over. KMP
// precomputes a "failure" table (the longest proper prefix of the pattern that is also a suffix, at each
// position) so that after a mismatch it slides the pattern forward WITHOUT ever moving the text cursor backward --
// each text character is looked at once. Use it for substring search, counting/locating ALL occurrences (log
// scanning, DNA motif finding, find-in-file, deduping), and as the building block for streaming matchers. The
// failure table itself is useful: its last value reveals the string's shortest repeating period. LEAF.

// The KMP failure table (a.k.a. the "partial match" / LPS table) for a pattern: fail[i] = the length of the
// longest proper prefix of pattern[0..i] that is also a suffix of it. This is what lets the search skip ahead
// after a mismatch without rescanning text.
fn kmp_failure(pattern: string) -> list
    let m = len(pattern)
    let fail = [0 for i in 0..m]
    let k = 0
    for q in 1..m
        while k > 0 and char_at(pattern, k) != char_at(pattern, q)
            k = fail[k - 1]
        if char_at(pattern, k) == char_at(pattern, q)
            k += 1
        fail[q] = k
    fail

// The index of the FIRST occurrence of pattern in text, or -1 if absent. Empty pattern matches at 0.
fn kmp_search(text: string, pattern: string) -> int
    let n = len(text)
    let m = len(pattern)
    let out = 0 - 1
    if m == 0
        out = 0
    else
        let fail = kmp_failure(pattern)
        let q = 0
        let i = 0
        while i < n and out < 0
            while q > 0 and char_at(pattern, q) != char_at(text, i)
                q = fail[q - 1]
            if char_at(pattern, q) == char_at(text, i)
                q += 1
            if q == m
                out = i - m + 1
            i += 1
    out

// Every start index where pattern occurs in text (overlapping matches included), in ascending order.
fn kmp_find_all(text: string, pattern: string) -> list
    let n = len(text)
    let m = len(pattern)
    let out = []
    if m == 0
        out
    else
        let fail = kmp_failure(pattern)
        let q = 0
        for i in 0..n
            while q > 0 and char_at(pattern, q) != char_at(text, i)
                q = fail[q - 1]
            if char_at(pattern, q) == char_at(text, i)
                q += 1
            if q == m
                push(out, i - m + 1)
                q = fail[q - 1]
        out

// How many times pattern occurs in text (overlapping counted).
fn kmp_count(text: string, pattern: string) -> int
    len(kmp_find_all(text, pattern))

// The length of the SHORTEST repeating unit (period) of s: if s is k copies of a block, returns the block length;
// otherwise returns len(s). E.g. "abcabcabc" -> 3, "abcd" -> 4. Derived from the failure table.
fn kmp_period(s: string) -> int
    let n = len(s)
    let out = n
    if n > 0
        let fail = kmp_failure(s)
        let p = n - fail[n - 1]
        if n % p == 0
            out = p
    out
