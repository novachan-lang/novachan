// forge_kmp -- thin wrapper over std/text/kmp (canonical implementation).
import std/text/kmp

fn kmp_failure(pattern: string) -> list
    return km_failure(pattern)

fn kmp_search(text: string, pattern: string) -> int
    return km_search(text, pattern)

fn kmp_find_all(text: string, pattern: string) -> list
    return km_search_all(text, pattern)

fn kmp_count(text: string, pattern: string) -> int
    return km_count(text, pattern)

fn kmp_period(s: string) -> int
    let n = len(s)
    let out = n
    if n > 0
        let fail = kmp_failure(s)
        let p = n - fail[n - 1]
        if n % p == 0
            out = p
    out

