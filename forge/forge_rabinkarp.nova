// forge_rabinkarp -- standalone Rabin-Karp wrapper (was a thin, self-recursive stub
// over std/text/rabinkarp; std defines the SAME public names (rk_search/rk_count) as
// this module, which is a real codegen collision, not just delegation -- so
// rk_search/rk_count now get genuine bodies built on this file's own rk_find_all,
// and the dead std import is removed).

fn _rk_base() -> int
    256

fn _rk_mod() -> int
    1000000007

// The polynomial (Horner) hash of a string: h = ((...(c0*B + c1)*B + c2)...)*B + c_{n-1}) mod P.

fn rk_hash(s: string) -> int
    let h = 0
    let b = _rk_base()
    let p = _rk_mod()
    for i in 0..len(s)
        h = (h * b + ord(char_at(s, i))) % p
    h

// The index of the FIRST occurrence of pattern in text, or -1 if absent. Empty pattern -> 0.

// rk_search: index of the FIRST occurrence of pattern in text, or -1 if absent.
// Delegates to rk_find_all (this file's own working implementation) for the
// general case; handles the empty-pattern and pattern-longer-than-text edge
// cases explicitly since rk_find_all only searches when 0 < m <= n.
fn rk_search(text: string, pattern: string) -> int
    let n = len(text)
    let m = len(pattern)
    if m == 0
        return 0
    if m > n
        return -1
    let all = rk_find_all(text, pattern)
    if len(all) > 0
        return all[0]
    -1

fn rk_find_all(text: string, pattern: string) -> list
    let out = []
    let n = len(text)
    let m = len(pattern)
    if m > 0 and m <= n
        let b = _rk_base()
        let p = _rk_mod()
        let high = 1
        for e in 0..(m - 1)
            high = (high * b) % p
        let phash = rk_hash(pattern)
        let whash = rk_hash(slice(text, 0, m))
        let i = 0
        while i + m <= n
            if whash == phash and slice(text, i, i + m) == pattern
                push(out, i)
            if i + m < n
                whash = (whash - (ord(char_at(text, i)) * high) % p + p) % p
                whash = (whash * b + ord(char_at(text, i + m))) % p
            i += 1
    out

// How many times pattern occurs in text (overlapping counted).

// rk_count: how many times pattern occurs in text (overlapping counted).
fn rk_count(text: string, pattern: string) -> int
    len(rk_find_all(text, pattern))

