// forge_rabinkarp -- Rabin-Karp string search via a ROLLING HASH. Instead of comparing characters, it hashes the
// pattern once and then slides a window across the text, updating the window's hash in O(1) per step (add the new
// character, subtract the one leaving) rather than recomputing it. When a window's hash equals the pattern's hash
// it verifies the actual characters (to rule out the rare hash collision). Average O(n+m). Its real superpower is
// MULTI-PATTERN and 2D search: hash a whole SET of patterns into a table and scan the text once (plagiarism
// detection, virus signatures, deduplicating file chunks by content). The same rolling hash underlies content-
// defined chunking (rsync/backup dedup) and Karp-Rabin fingerprinting. Uses a polynomial hash mod a large prime.
// LEAF -- imports NOTHING.

// PRIVATE: base and modulus for the polynomial rolling hash. Products stay < 256 * 1e9 < 2^63, so no overflow.
fn _rk_base() -> int
    256

fn _rk_mod() -> int
    1000000007

// The polynomial (Horner) hash of a string: h = ((...(c0*B + c1)*B + c2)...)*B + c_{n-1}) mod P.
fn rk_hash(s: string) -> int
    let h = 0
    let b = _rk_base()
    let p = _rk_mod()
    let i = 0
    while i < len(s)
        h = (h * b + ord(char_at(s, i))) % p
        i = i + 1
    h

// The index of the FIRST occurrence of pattern in text, or -1 if absent. Empty pattern -> 0.
fn rk_search(text: string, pattern: string) -> int
    let out = 0 - 1
    let n = len(text)
    let m = len(pattern)
    if m == 0
        out = 0
    else
        if m <= n
            let b = _rk_base()
            let p = _rk_mod()
            // B^(m-1) mod P, the weight of the leading character
            let high = 1
            let e = 0
            while e < m - 1
                high = (high * b) % p
                e = e + 1
            let phash = rk_hash(pattern)
            // hash of the first window
            let whash = rk_hash(slice(text, 0, m))
            let i = 0
            while i + m <= n and out < 0
                if whash == phash and slice(text, i, i + m) == pattern
                    out = i
                else
                    // roll: drop text[i], add text[i+m]
                    if i + m < n
                        whash = (whash - (ord(char_at(text, i)) * high) % p + p) % p
                        whash = (whash * b + ord(char_at(text, i + m))) % p
                i = i + 1
    out

// Every start index where pattern occurs in text (overlapping included), ascending.
fn rk_find_all(text: string, pattern: string) -> list
    let out = []
    let n = len(text)
    let m = len(pattern)
    if m > 0 and m <= n
        let b = _rk_base()
        let p = _rk_mod()
        let high = 1
        let e = 0
        while e < m - 1
            high = (high * b) % p
            e = e + 1
        let phash = rk_hash(pattern)
        let whash = rk_hash(slice(text, 0, m))
        let i = 0
        while i + m <= n
            if whash == phash and slice(text, i, i + m) == pattern
                push(out, i)
            if i + m < n
                whash = (whash - (ord(char_at(text, i)) * high) % p + p) % p
                whash = (whash * b + ord(char_at(text, i + m))) % p
            i = i + 1
    out

// How many times pattern occurs in text (overlapping counted).
fn rk_count(text: string, pattern: string) -> int
    len(rk_find_all(text, pattern))
