// forge_delayed -- delayed / scheduled one-shot job execution (Sidekiq perform_in / Celery countdown /
// Bull delayed). Run an action after a delay without blocking the caller: spawn a green task that sleeps
// then runs. For recurring, use forge_aspects.every; for cron, forge_cron. LEAF -- spawn/sleep builtins.

fn _delayed_run(delay_ms, action)
    sleep(delay_ms)
    action()

// Run `action` (a 0-arg closure) after `delay_ms`. Returns immediately (fire-and-forget). The task is a
// green task -> thousands of pending delayed jobs cost ~nothing.
fn delay_run(delay_ms: int, action) -> int
    spawn _delayed_run(delay_ms, action)
    0
