// forge_language -- ISO 639-1 language reference data + RTL detection for i18n language pickers,
// Accept-Language handling, and setting the HTML dir="rtl" attribute. Maps an ISO 639-1 two-letter
// code ("en") to its English name ("English") and its native endonym ("Deutsch" for "de"), and tells
// whether a language is written right-to-left. Every lookup lowercases + trims its input first, so
// "EN", " en ", "En" all resolve. The two tables are built once inside private helpers as dicts keyed
// by the canonical lowercase code. Covers ~40 of the most common languages -- enough to power real
// language selectors and Accept-Language negotiation without pretending to be the full register.
// Complements forge_country (regions) and forge_i18n. LEAF -- imports NOTHING.

// PRIVATE: code -> English name.
fn _lang_names() -> dict
    {
        "en": "English",
        "es": "Spanish",
        "fr": "French",
        "de": "German",
        "it": "Italian",
        "pt": "Portuguese",
        "nl": "Dutch",
        "ru": "Russian",
        "pl": "Polish",
        "uk": "Ukrainian",
        "zh": "Chinese",
        "ja": "Japanese",
        "ko": "Korean",
        "ar": "Arabic",
        "he": "Hebrew",
        "hi": "Hindi",
        "bn": "Bengali",
        "tr": "Turkish",
        "fa": "Persian",
        "ur": "Urdu",
        "id": "Indonesian",
        "ms": "Malay",
        "th": "Thai",
        "vi": "Vietnamese",
        "sv": "Swedish",
        "no": "Norwegian",
        "da": "Danish",
        "fi": "Finnish",
        "cs": "Czech",
        "sk": "Slovak",
        "hu": "Hungarian",
        "ro": "Romanian",
        "el": "Greek",
        "bg": "Bulgarian",
        "hr": "Croatian",
        "sr": "Serbian",
        "ca": "Catalan",
        "sw": "Swahili",
        "ta": "Tamil",
        "af": "Afrikaans",
        "yi": "Yiddish"
    }

// PRIVATE: code -> native name (endonym). ASCII approximations where non-ASCII is awkward.
fn _lang_native() -> dict
    {
        "en": "English",
        "es": "Espanol",
        "fr": "Francais",
        "de": "Deutsch",
        "it": "Italiano",
        "pt": "Portugues",
        "nl": "Nederlands",
        "ru": "Russkij",
        "pl": "Polski",
        "uk": "Ukrainska",
        "zh": "Zhongwen",
        "ja": "Nihongo",
        "ko": "Hangugeo",
        "ar": "al-Arabiyah",
        "he": "Ivrit",
        "hi": "Hindi",
        "bn": "Bangla",
        "tr": "Turkce",
        "fa": "Farsi",
        "ur": "Urdu",
        "id": "Indonesia",
        "ms": "Melayu",
        "th": "Thai",
        "vi": "TiengViet",
        "sv": "Svenska",
        "no": "Norsk",
        "da": "Dansk",
        "fi": "Suomi",
        "cs": "Cestina",
        "sk": "Slovencina",
        "hu": "Magyar",
        "ro": "Romana",
        "el": "Ellinika",
        "bg": "Balgarski",
        "hr": "Hrvatski",
        "sr": "Srpski",
        "ca": "Catala",
        "sw": "Kiswahili",
        "ta": "Tamil",
        "af": "Afrikaans",
        "yi": "Yidish"
    }

// True if the lowercased 2-letter code is a known ISO 639-1 language.
fn language_valid(code: string) -> bool
    let m = _lang_names()
    lower(trim(code)) in m

// The English name for a code (e.g. "de" -> "German"), or "" if unknown.
fn language_name(code: string) -> string
    let m = _lang_names()
    let k = lower(trim(code))
    m[k] if k in m else ""

// The native endonym for a code (e.g. "de" -> "Deutsch"), or "".
fn language_native(code: string) -> string
    let m = _lang_native()
    let k = lower(trim(code))
    m[k] if k in m else ""

// True for right-to-left languages: ar (Arabic), he (Hebrew), fa (Persian), ur (Urdu), yi (Yiddish).
fn language_is_rtl(code: string) -> bool
    lower(trim(code)) in ["ar", "he", "fa", "ur", "yi"]

// "rtl" for right-to-left languages, else "ltr" -- for the HTML dir attribute.
fn language_dir(code: string) -> string
    "rtl" if language_is_rtl(code) else "ltr"
