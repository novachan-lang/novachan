// forge_multgroup -- the structure of the multiplicative group of integers mod n: the Moebius function, the order
// of an element, and primitive roots (generators). These answer "how do the units mod n cycle?" -- the questions
// that sit directly beneath forge_modsolve's discrete_log (a primitive root IS a generator; an element's order is
// the size of the cyclic subgroup it spins out) and beneath Diffie-Hellman parameter choice. mobius is the
// squarefree sign function at the heart of Moebius inversion, Mertens' function, and inclusion-exclusion sieves
// (counting squarefree / coprime things). multiplicative_order finds the smallest power that returns an element to
// 1 -- the period of a modular sequence, the exponent in RSA/Carmichael reasoning, the length of a repeating
// decimal (order of 10 mod n). primitive_root finds a generator that reaches every unit, which is exactly the base
// you want for a Diffie-Hellman group or a discrete-log problem. Integers only; keep n moderate (order is found by
// walking the cycle, and products reach n*n so n up to ~3e9 stays in signed 64-bit). Pairs with forge_modsolve,
// forge_modarith, forge_primes. LEAF.

// PRIVATE: base^exp mod m by square-and-multiply.
fn _mg_powmod(base: int, exp: int, m: int) -> int
    let result = 1
    let b = ((base % m) + m) % m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = (result * b) % m
        b = (b * b) % m
        e = e / 2
    result

// PRIVATE: gcd (non-negative).
fn _mg_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = -x
    x

// PRIVATE: the DISTINCT prime factors of n (n >= 1), ascending, by trial division.
fn _mg_distinct_primes(n: int) -> list
    let out = []
    let m = n
    let d = 2
    while d * d <= m
        if m % d == 0
            push(out, d)
            while m % d == 0
                m = m / d
        d += 1
    if m > 1
        push(out, m)
    out

// The Moebius function mu(n): 1 if n is a squarefree product of an even number of primes, -1 if squarefree with an
// odd number, and 0 if any prime squared divides n. mu(1) = 1. Returns 0 for n <= 0.
fn mobius(n: int) -> int
    let out = 1
    if n <= 0
        out = 0
    else
        let m = n
        let cnt = 0
        let d = 2
        let bad = false
        while d * d <= m and not bad
            if m % d == 0
                m = m / d
                cnt += 1
                if m % d == 0
                    bad = true
            d += 1
        if bad
            out = 0
        else
            if m > 1
                cnt += 1
            out = 1 if cnt % 2 == 0 else -1
    out

// The multiplicative order of a mod n: the smallest k >= 1 with a^k congruent to 1 (mod n), or -1 if a and n are
// not coprime (a is not a unit, so it has no order). This is the length of the cycle a, a^2, a^3, ... before it
// returns to 1.
fn multiplicative_order(a: int, n: int) -> int
    let out = -1
    if n >= 1 and _mg_gcd(a, n) == 1
        if n == 1
            out = 1
        else
            let aa = ((a % n) + n) % n
            let cur = aa
            let k = 1
            while cur != 1
                cur = (cur * aa) % n
                k += 1
            out = k
    out

// True if g is a primitive root modulo the prime p (a generator whose powers reach every unit). Tested fast:
// g is primitive iff g^((p-1)/q) is not 1 for every prime q dividing p-1.
fn is_primitive_root(g: int, p: int) -> bool
    let gg = ((g % p) + p) % p
    if gg == 0 or _mg_gcd(gg, p) != 1
        return false
    let phi = p - 1
    let fs = _mg_distinct_primes(phi)
    for i in 0..len(fs)
        if _mg_powmod(gg, phi / fs[i], p) == 1
            return false
    true

// The smallest primitive root modulo the prime p (a generator of the multiplicative group), or -1 if none exists.
// For p = 2 the primitive root is 1.
fn primitive_root(p: int) -> int
    if p == 2
        return 1
    for g in 2..p
        if is_primitive_root(g, p)
            return g
    -1
