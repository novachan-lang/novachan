// forge_strfind -- the bread-and-butter substring queries: where does a piece of text occur, how often, and does a
// string begin or end with it? index_of returns the position of the first occurrence (or -1), last_index_of the
// last, count_occurrences how many times it appears, and starts_with / ends_with / str_contains the yes/no tests.
// These are the operations you reach for constantly -- parsing out a field before a delimiter, checking a file
// extension or URL scheme, counting how many times a token appears in a log line, validating a prefix, or deciding
// whether to run a heavier match. They're the plain, direct scanners (fine for everyday strings); for repeatedly
// searching one long text with a fixed pattern reach for KMP/Boyer-Moore (forge_kmp / forge_boyermoore). The empty
// needle is found at position 0 (and everywhere), matching the usual convention. Case-sensitive, byte-oriented.
// LEAF -- imports NOTHING.

// The index of the FIRST occurrence of `needle` in `hay`, or -1 if absent. Empty needle -> 0.
fn index_of(hay: string, needle: string) -> int
    let n = len(hay)
    let m = len(needle)
    let out = 0 - 1
    if m == 0
        out = 0
    else
        let i = 0
        while i + m <= n and out < 0
            if slice(hay, i, i + m) == needle
                out = i
            i = i + 1
    out

// The index of the LAST occurrence of `needle` in `hay`, or -1 if absent. Empty needle -> len(hay).
fn last_index_of(hay: string, needle: string) -> int
    let n = len(hay)
    let m = len(needle)
    let out = 0 - 1
    if m == 0
        out = n
    else
        let i = n - m
        while i >= 0 and out < 0
            if slice(hay, i, i + m) == needle
                out = i
            i = i - 1
    out

// The number of (non-overlapping) occurrences of `needle` in `hay`.
fn count_occurrences(hay: string, needle: string) -> int
    let n = len(hay)
    let m = len(needle)
    let count = 0
    if m > 0
        let i = 0
        while i + m <= n
            if slice(hay, i, i + m) == needle
                count = count + 1
                i = i + m
            else
                i = i + 1
    count

// True if `hay` contains `needle`.
fn str_contains(hay: string, needle: string) -> bool
    let out = false
    if index_of(hay, needle) >= 0
        out = true
    out

// True if `hay` begins with `prefix`.
fn starts_with(hay: string, prefix: string) -> bool
    let out = false
    if len(prefix) <= len(hay) and slice(hay, 0, len(prefix)) == prefix
        out = true
    out

// True if `hay` ends with `suffix`.
fn ends_with(hay: string, suffix: string) -> bool
    let out = false
    if len(suffix) <= len(hay) and slice(hay, len(hay) - len(suffix), len(hay)) == suffix
        out = true
    out
