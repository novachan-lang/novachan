// forge_metric_exporter — Prometheus-style metric export with Result API.

fn me_new() -> dict
    let m = {}
    m["counters"] = {}
    m["gauges"] = {}
    m["counter_count"] = 0
    m["gauge_count"] = 0
    m

fn me_counter(m: dict, name: string) -> dict
    let ck = "c_" + name
    if contains(m["counters"], ck) != true
        m["counters"][ck] = 0
        m["counter_count"] = m["counter_count"] + 1
    m

fn me_inc(m: dict, name: string, amount: int) -> Result
    let ck = "c_" + name
    if contains(m["counters"], ck) != true
        return err("counter not found: " + name)
    m["counters"][ck] = m["counters"][ck] + amount
    ok(m)

fn me_gauge(m: dict, name: string) -> dict
    let gk = "g_" + name
    if contains(m["gauges"], gk) != true
        m["gauges"][gk] = 0
        m["gauge_count"] = m["gauge_count"] + 1
    m

fn me_set_gauge(m: dict, name: string, value: int) -> Result
    let gk = "g_" + name
    if contains(m["gauges"], gk) != true
        return err("gauge not found: " + name)
    m["gauges"][gk] = value
    ok(m)

fn me_get_counter(m: dict, name: string) -> Result
    let ck = "c_" + name
    if contains(m["counters"], ck) != true
        return err("counter not found")
    ok(m["counters"][ck])

fn me_get_gauge(m: dict, name: string) -> Result
    let gk = "g_" + name
    if contains(m["gauges"], gk) != true
        return err("gauge not found")
    ok(m["gauges"][gk])

fn me_counter_count(m: dict) -> int
    m["counter_count"]

fn me_gauge_count(m: dict) -> int
    m["gauge_count"]
