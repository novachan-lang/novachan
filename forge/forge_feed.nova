// forge_feed -- RSS 2.0 and Atom 1.0 feed generation for blog/news/podcast syndication.
// Build a syndication document from a list of item dicts. This is what Rome/ROME (Java),
// feedgen (Python), and Web::Feed do: turn structured entries into a valid XML feed a reader
// can consume. Every text value is XML-escaped so a title containing < & " can never break the
// document or inject markup. LEAF -- imports NOTHING; XML is built by hand (no forge_xml).

// PUBLIC: XML-escape a text value. Order matters: & MUST be replaced first, otherwise the &
// introduced by escaping < > " ' would itself be re-escaped into &amp;lt; etc. Single pass,
// char by char, so we never double-escape an already-produced entity.
fn feed_escape(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        if c == "&"
            out = out + "&amp;"
        else
            if c == "<"
                out = out + "&lt;"
            else
                if c == ">"
                    out = out + "&gt;"
                else
                    if c == "\""
                        out = out + "&quot;"
                    else
                        if c == "'"
                            out = out + "&apos;"
                        else
                            out = out + c
        i = i + 1
    out

// PRIVATE: DRY element builder -- <tag>escaped-value</tag>. Value is always escaped; the tag
// name is a trusted literal supplied by this module, never user input, so it is not escaped.
fn _feed_el(tag: string, value: string) -> string
    "<" + tag + ">" + feed_escape(value) + "</" + tag + ">"

// PRIVATE: read a string field from an item dict, or "" if absent. Keeps call sites terse.
fn _feed_get(item: dict, key: string) -> string
    if contains(item, key)
        return item[key]
    ""

// PUBLIC: render a complete RSS 2.0 document. `items` is a list of dicts, each with "title",
// "link", "description", and optionally "guid" and "pubDate" (a pre-formatted RFC-822 string;
// omitted when absent).
fn feed_rss(title: string, link: string, description: string, items: list) -> string
    let out = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
    out = out + "<rss version=\"2.0\"><channel>"
    out = out + _feed_el("title", title)
    out = out + _feed_el("link", link)
    out = out + _feed_el("description", description)
    for item in items
        out = out + "<item>"
        out = out + _feed_el("title", _feed_get(item, "title"))
        out = out + _feed_el("link", _feed_get(item, "link"))
        out = out + _feed_el("description", _feed_get(item, "description"))
        if contains(item, "guid")
            out = out + _feed_el("guid", item["guid"])
        if contains(item, "pubDate")
            out = out + _feed_el("pubDate", item["pubDate"])
        out = out + "</item>"
    out = out + "</channel></rss>"
    out

// PUBLIC: render a complete Atom 1.0 document. `updated` is a pre-formatted ISO-8601 string.
// Each entry dict has "title", "link", "id", and optionally "updated" and "summary". Per the
// Atom spec an entry link is an empty element carrying the target in an href attribute.
fn feed_atom(title: string, id: string, updated: string, items: list) -> string
    let out = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
    out = out + "<feed xmlns=\"http://www.w3.org/2005/Atom\">"
    out = out + _feed_el("title", title)
    out = out + _feed_el("id", id)
    out = out + _feed_el("updated", updated)
    for item in items
        out = out + "<entry>"
        out = out + _feed_el("title", _feed_get(item, "title"))
        out = out + _feed_el("id", _feed_get(item, "id"))
        out = out + "<link href=\"" + feed_escape(_feed_get(item, "link")) + "\"/>"
        if contains(item, "updated")
            out = out + _feed_el("updated", item["updated"])
        if contains(item, "summary")
            out = out + _feed_el("summary", item["summary"])
        out = out + "</entry>"
    out = out + "</feed>"
    out
