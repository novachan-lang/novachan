// forge_links -- RFC 5988 Link headers for pagination/navigation (the `Link: <url>; rel="next"` REST
// convention GitHub's API uses so clients follow links instead of constructing URLs). Build a Link header
// value from next/prev/first/last page URLs. LEAF -- imports NOTHING.

fn link_rel(url: string, rel: string) -> string
    let q = chr(34)
    "<" + url + ">; rel=" + q + rel + q

// links = list of [url, rel]; join into a single Link header value.
fn link_header(links: list) -> string
    let parts = [link_rel(links[i][0], links[i][1]) for i in 0..len(links)]
    join(parts, ", ")

// Build the pagination Link header (prev/next/first/last) for an offset page over `total` items.
fn pagination_links(base_url: string, page: int, per_page: int, total: int) -> string
    let links = []
    if page > 1
        push(links, [base_url + "?page=" + str(page - 1) + "&per_page=" + str(per_page), "prev"])
    let last_page = (total + per_page - 1) / per_page
    if last_page < 1
        last_page = 1
    if page < last_page
        push(links, [base_url + "?page=" + str(page + 1) + "&per_page=" + str(per_page), "next"])
    push(links, [base_url + "?page=1&per_page=" + str(per_page), "first"])
    push(links, [base_url + "?page=" + str(last_page) + "&per_page=" + str(per_page), "last"])
    link_header(links)
