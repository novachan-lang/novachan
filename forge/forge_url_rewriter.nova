// forge_url_rewriter — URL rewrite rules with Result API.

fn ur_new() -> dict
    {"rule_count": 0, "rewrites": 0, "misses": 0}

fn ur_add_rule(u: dict, from_path: string, to_path: string) -> dict
    let idx = u["rule_count"]
    u["rw_{idx}_from"] = from_path
    u["rw_{idx}_to"] = to_path
    u["rule_count"] += 1
    u

fn ur_rewrite(u: dict, path: string) -> Result
    for i in 0..u["rule_count"]
        if u["rw_{i}_from"] == path
            u["rewrites"] += 1
            return ok(u["rw_{i}_to"])
    u["misses"] += 1
    ok(path)

fn ur_rule_at(u: dict, index: int) -> Result
    if index < 0 or index >= u["rule_count"]
        return err("rule index out of range")
    let from_p = u["rw_{index}_from"]
    let to_p = u["rw_{index}_to"]
    ok("{from_p} -> {to_p}")

fn ur_rule_count(u: dict) -> int
    u["rule_count"]

fn ur_rewrite_count(u: dict) -> int
    u["rewrites"]

fn ur_miss_count(u: dict) -> int
    u["misses"]
