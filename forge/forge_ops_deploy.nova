// forge_ops_deploy — Deployment descriptor + rollout strategy for the Ops framework.
// Pure data structures describing HOW to deploy a service (container image, replicas,
// health checks, rollout strategy). No runtime I/O — generates deployment manifests
// as dicts that can be serialized to YAML/JSON for k8s, Docker Compose, or cloud APIs.
//
// Public API:
//   deploy_service(name, image, port)           -> deployment dict
//   deploy_replicas(d, count)                   -> updated deployment
//   deploy_env(d, key, value)                   -> add env var
//   deploy_health_check(d, path, interval_s)    -> add HTTP health check
//   deploy_resource_limits(d, cpu_m, mem_mb)    -> set resource limits
//   deploy_rolling_update(d, max_surge, max_unavail) -> rolling update strategy
//   deploy_to_k8s(d)                            -> k8s Deployment manifest dict
//   deploy_to_compose(d)                        -> Docker Compose service dict
//   deploy_canary(d, weight_pct)                -> canary split config
//   deploy_describe(d)                          -> human-readable summary string

fn deploy_service(name: string, image: string, port: int) -> dict
    {"name": name, "image": image, "port": port, "replicas": 1,
     "env": {}, "health_check": {}, "resources": {},
     "strategy": "rolling", "max_surge": 1, "max_unavail": 0, "canary_weight": 0}

fn deploy_replicas(d: dict, count: int) -> dict
    d["replicas"] = count
    d

fn deploy_env(d: dict, key: string, value: string) -> dict
    d["env"][key] = value
    d

fn deploy_health_check(d: dict, path: string, interval_s: int) -> dict
    d["health_check"] = {"path": path, "interval": interval_s}
    d

fn deploy_resource_limits(d: dict, cpu_m: int, mem_mb: int) -> dict
    d["resources"] = {"cpu_millicores": cpu_m, "memory_mb": mem_mb}
    d

fn deploy_rolling_update(d: dict, max_surge: int, max_unavail: int) -> dict
    d["strategy"] = "rolling"
    d["max_surge"] = max_surge
    d["max_unavail"] = max_unavail
    d

fn deploy_canary(d: dict, weight_pct: int) -> dict
    d["canary_weight"] = weight_pct
    d

fn deploy_to_k8s(d: dict) -> dict
    let container = {"name": d["name"], "image": d["image"],
                     "ports": [{"containerPort": d["port"]}]}
    let ek = keys(d["env"])
    let env_list = [{"name": ek[i], "value": d["env"][ek[i]]} for i in 0..len(ek)]
    if len(env_list) > 0
        container["env"] = env_list
    if "cpu_millicores" in d["resources"]
        container["resources"] = {"limits": {"cpu": "{d["resources"]["cpu_millicores"]}m",
                                              "memory": "{d["resources"]["memory_mb"]}Mi"}}
    if "path" in d["health_check"]
        container["livenessProbe"] = {"httpGet": {"path": d["health_check"]["path"],
                                                   "port": d["port"]},
                                       "periodSeconds": d["health_check"]["interval"]}
    let spec = {"replicas": d["replicas"],
                "selector": {"matchLabels": {"app": d["name"]}},
                "template": {"metadata": {"labels": {"app": d["name"]}},
                             "spec": {"containers": [container]}},
                "strategy": {"type": "RollingUpdate",
                             "rollingUpdate": {"maxSurge": d["max_surge"],
                                               "maxUnavailable": d["max_unavail"]}}}
    {"apiVersion": "apps/v1", "kind": "Deployment",
     "metadata": {"name": d["name"]}, "spec": spec}

fn deploy_to_compose(d: dict) -> dict
    let svc = {"image": d["image"], "ports": ["{d["port"]}:{d["port"]}"]}
    if len(keys(d["env"])) > 0
        svc["environment"] = d["env"]
    if d["replicas"] > 1
        svc["deploy"] = {"replicas": d["replicas"]}
    if "path" in d["health_check"]
        svc["healthcheck"] = {"test": "curl -f http://localhost:{d["port"]}{d["health_check"]["path"]} || exit 1",
                               "interval": "{d["health_check"]["interval"]}s"}
    svc

fn deploy_describe(d: dict) -> string
    let s = "Service: {d["name"]}\n"
    s += "  Image: {d["image"]}\n"
    s += "  Port: {d["port"]}\n"
    s += "  Replicas: {d["replicas"]}\n"
    s += "  Strategy: {d["strategy"]}\n"
    if d["canary_weight"] > 0
        s += "  Canary: {d["canary_weight"]}%\n"
    if len(keys(d["env"])) > 0
        s += "  Env vars: {len(keys(d["env"]))}\n"
    if "path" in d["health_check"]
        s += "  Health: {d["health_check"]["path"]} every {d["health_check"]["interval"]}s\n"
    if "cpu_millicores" in d["resources"]
        s += "  Limits: {d["resources"]["cpu_millicores"]}m CPU, {d["resources"]["memory_mb"]}MB RAM\n"
    s
