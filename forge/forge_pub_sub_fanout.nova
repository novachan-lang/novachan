// forge_pub_sub_fanout — Pub/sub with fan-out to multiple subscribers.
// Topics, subscribe, publish, per-subscriber delivery tracking.

fn psf_new() -> dict
    let psf = {}
    psf["topics"] = {}
    psf["deliveries"] = 0
    psf

fn psf_create_topic(psf: dict, topic: string) -> dict
    let has = contains(psf["topics"], topic)
    if has == true
        return psf
    let t = {}
    t["subscribers"] = []
    t["messages"] = 0
    psf["topics"][topic] = t
    psf

fn psf_subscribe(psf: dict, topic: string, subscriber: string) -> dict
    let has = contains(psf["topics"], topic)
    if has != true
        return psf
    let sub = {}
    sub["name"] = subscriber
    sub["received"] = 0
    push(psf["topics"][topic]["subscribers"], sub)
    psf

fn psf_publish(psf: dict, topic: string, message: string) -> int
    let has = contains(psf["topics"], topic)
    if has != true
        return 0
    psf["topics"][topic]["messages"] = psf["topics"][topic]["messages"] + 1
    let subs = psf["topics"][topic]["subscribers"]
    let delivered = 0
    for i in 0..len(subs)
        psf["topics"][topic]["subscribers"][i]["received"] = psf["topics"][topic]["subscribers"][i]["received"] + 1
        delivered += 1
        psf["deliveries"] = psf["deliveries"] + 1
    delivered

fn psf_subscriber_received(psf: dict, topic: string, subscriber: string) -> int
    let has = contains(psf["topics"], topic)
    if has != true
        return 0
    let subs = psf["topics"][topic]["subscribers"]
    for i in 0..len(subs)
        if subs[i]["name"] == subscriber
            return subs[i]["received"]
    0

fn psf_topic_count(psf: dict) -> int
    len(keys(psf["topics"]))

fn psf_subscriber_count(psf: dict, topic: string) -> int
    let has = contains(psf["topics"], topic)
    if has != true
        return 0
    len(psf["topics"][topic]["subscribers"])

fn psf_total_deliveries(psf: dict) -> int
    psf["deliveries"]

fn psf_topic_messages(psf: dict, topic: string) -> int
    let has = contains(psf["topics"], topic)
    if has != true
        return 0
    psf["topics"][topic]["messages"]
