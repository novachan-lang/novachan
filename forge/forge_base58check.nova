// forge_base58check -- Base58Check encoding (Bitcoin addresses, WIF private keys, and many other crypto/
// identity payloads). The existing forge_base58 encodes a 64-bit INTEGER; Base58Check must encode an arbitrary
// BYTE STRING (a 25-byte address is a ~200-bit number) with two extras the int form can't do: leading 0x00
// bytes map to leading '1' characters, and a 4-byte double-SHA-256 checksum is appended so a typo'd address is
// rejected. This module provides base58_encode_bytes (big-endian byte list -> Base58) and base58check_encode
// (version + payload + checksum). Composes forge_crypto (sha256_bytes). Verified against the canonical genesis
// address vector. Imports only forge_crypto.
//
// RAISED 2026-08-05. Three problems:
//
//   1. base58_encode_bytes reverse-digit output used a while-decrement loop + quadratic `out += char_at`.
//      reverse() + comprehension + join.
//   2. base58_encode_bytes leading-zeros prefix used a for-loop of `out += "1"`. repeat("1", zeros).
//   3. base58check_encode copied payload byte by byte. Spread operator.

import forge_crypto

fn _b58_alpha() -> string
    "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

fn base58_encode_bytes(data: list) -> string
    let alpha = _b58_alpha()
    let n = len(data)
    let zeros = 0
    while zeros < n and data[zeros] == 0
        zeros += 1
    let b = [data[i] for i in 0..n]
    let digits = []
    let start = zeros
    // STAYS a while: repeated base-256 → base-58 division, data-dependent.
    while start < n
        let remainder = 0
        let j = start
        while j < n
            let acc = remainder * 256 + b[j]
            b[j] = acc / 58
            remainder = acc % 58
            j += 1
        push(digits, remainder)
        while start < n and b[start] == 0
            start += 1
    let chars = [char_at(alpha, d) for d in reverse(digits)]
    repeat("1", zeros) + join(chars, "")

fn base58check_encode(version: int, payload: list) -> string
    let data = [version, ...payload]
    let h1 = sha256_bytes(data)
    let h2 = sha256_bytes(h1)
    push(data, h2[0])
    push(data, h2[1])
    push(data, h2[2])
    push(data, h2[3])
    base58_encode_bytes(data)
