// forge_base58check -- Base58Check encoding (Bitcoin addresses, WIF private keys, and many other crypto/
// identity payloads). The existing forge_base58 encodes a 64-bit INTEGER; Base58Check must encode an arbitrary
// BYTE STRING (a 25-byte address is a ~200-bit number) with two extras the int form can't do: leading 0x00
// bytes map to leading '1' characters, and a 4-byte double-SHA-256 checksum is appended so a typo'd address is
// rejected. This module provides base58_encode_bytes (big-endian byte list -> Base58) and base58check_encode
// (version + payload + checksum). Composes forge_crypto (sha256_bytes). Verified against the canonical genesis
// address vector. Imports only forge_crypto.

import forge_crypto

// Base58 alphabet (Bitcoin ordering: no 0, O, I, l).
fn _b58_alpha() -> string
    "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

// Encode a big-endian byte list to a Base58 string via repeated base-256 -> base-58 division. Leading zero
// bytes become leading '1's (Base58Check convention).
fn base58_encode_bytes(data: list) -> string
    let alpha = _b58_alpha()
    let n = len(data)
    // count leading zero bytes
    let zeros = 0
    while zeros < n and data[zeros] == 0
        zeros = zeros + 1
    // mutable working copy
    let b = []
    let i = 0
    while i < n
        push(b, data[i])
        i = i + 1
    // repeatedly divide the number (base 256) by 58, collecting remainders (little-endian base58 digits)
    let digits = []
    let start = zeros
    while start < n
        let remainder = 0
        let j = start
        while j < n
            let acc = remainder * 256 + b[j]
            b[j] = acc / 58
            remainder = acc % 58
            j = j + 1
        push(digits, remainder)
        while start < n and b[start] == 0
            start = start + 1
    // build output: one '1' per leading zero byte, then the base58 digits most-significant first
    let out = ""
    let z = 0
    while z < zeros
        out = out + "1"
        z = z + 1
    let k = len(digits) - 1
    while k >= 0
        out = out + char_at(alpha, digits[k])
        k = k - 1
    out

// Base58Check-encode a version byte + payload byte list: append the first 4 bytes of SHA256(SHA256(version ||
// payload)) as a checksum, then Base58-encode the whole thing.
fn base58check_encode(version: int, payload: list) -> string
    let data = [version]
    let i = 0
    while i < len(payload)
        push(data, payload[i])
        i = i + 1
    let h1 = sha256_bytes(data)
    let h2 = sha256_bytes(h1)
    push(data, h2[0])
    push(data, h2[1])
    push(data, h2[2])
    push(data, h2[3])
    base58_encode_bytes(data)
