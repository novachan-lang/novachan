// forge_ip6 -- IPv6 address validation (forge_ipcidr covers IPv4). Validates the 8-group hex form with optional
// "::" zero-compression (at most one run). For modern networking allow-lists, logging, and trusted-proxy checks.
// LEAF -- imports NOTHING.

fn _ip6_is_hex_group(g: string) -> bool
    if len(g) == 0 or len(g) > 4
        return false
    for i in 0..len(g)
        if find("0123456789abcdefABCDEF", char_at(g, i)) < 0
            return false
    true

fn _ip6_count(s: string, sub: string) -> int
    let n = 0
    let i = 0
    while i + len(sub) <= len(s)
        if slice(s, i, i + len(sub)) == sub
            n += 1
            i += len(sub)
        else
            i += 1
    n

// Count valid hex groups in a ":"-joined part (0 for empty); -1 if any group is invalid.
fn _ip6_groups(part: string) -> int
    if len(part) == 0
        return 0
    let parts = split(part, ":")
    for i in 0..len(parts)
        if not _ip6_is_hex_group(parts[i])
            return 0 - 1
    len(parts)

// Is `addr` a valid IPv6 address (full 8-group form OR a single "::" compression)?
fn ip6_valid(addr: string) -> bool
    let s = trim(addr)
    if len(s) == 0
        return false
    let dc = _ip6_count(s, "::")
    if dc > 1
        return false
    if dc == 0
        let g = _ip6_groups(s)
        return g == 8
    let idx = find(s, "::")
    let lg = _ip6_groups(slice(s, 0, idx))
    let rg = _ip6_groups(slice(s, idx + 2, len(s)))
    if lg < 0 or rg < 0
        return false
    lg + rg <= 7

// Is it the loopback address (::1)?
fn ip6_is_loopback(addr: string) -> bool
    trim(addr) == "::1"
