// forge_adaptive_throttle — Adaptive rate limiting.
// Adjust rate based on error rate and latency feedback.

fn at_new(base_rate: int, min_rate: int, max_rate: int) -> dict
    let at = {}
    at["base_rate"] = base_rate
    at["current_rate"] = base_rate
    at["min_rate"] = min_rate
    at["max_rate"] = max_rate
    at["total_requests"] = 0
    at["total_errors"] = 0
    at["total_allowed"] = 0
    at["total_rejected"] = 0
    at["window_count"] = 0
    at

fn at_request(at: dict) -> int
    at["total_requests"] = at["total_requests"] + 1
    if at["window_count"] < at["current_rate"]
        at["window_count"] = at["window_count"] + 1
        at["total_allowed"] = at["total_allowed"] + 1
        return 1
    at["total_rejected"] = at["total_rejected"] + 1
    0

fn at_record_error(at: dict) -> dict
    at["total_errors"] = at["total_errors"] + 1
    at

fn at_adjust(at: dict) -> dict
    let error_pct = 0
    if at["total_allowed"] > 0
        error_pct = (at["total_errors"] * 100) / at["total_allowed"]
    if error_pct > 50
        let new_rate = at["current_rate"] / 2
        if new_rate < at["min_rate"]
            at["current_rate"] = at["min_rate"]
        else
            at["current_rate"] = new_rate
    else
        if error_pct < 10
            let new_rate = at["current_rate"] + (at["current_rate"] / 4)
            if new_rate > at["max_rate"]
                at["current_rate"] = at["max_rate"]
            else
                at["current_rate"] = new_rate
    at["window_count"] = 0
    at

fn at_current_rate(at: dict) -> int
    at["current_rate"]

fn at_total_allowed(at: dict) -> int
    at["total_allowed"]

fn at_total_rejected(at: dict) -> int
    at["total_rejected"]

fn at_error_rate(at: dict) -> int
    if at["total_allowed"] == 0
        return 0
    (at["total_errors"] * 100) / at["total_allowed"]

fn at_reset_window(at: dict) -> dict
    at["window_count"] = 0
    at
