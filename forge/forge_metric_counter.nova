// forge_metric_counter — Named counters with labels for metrics collection.

fn mc_new() -> dict
    {"counters": {}}

fn mc_inc(m: dict, name: string) -> dict
    if name in m["counters"]
        m["counters"][name] += 1
    else
        m["counters"][name] = 1
    m

fn mc_add(m: dict, name: string, amount: int) -> dict
    if name in m["counters"]
        m["counters"][name] += amount
    else
        m["counters"][name] = amount
    m

fn mc_get(m: dict, name: string) -> int
    if name not in m["counters"]
        return 0
    m["counters"][name]

fn mc_reset(m: dict, name: string) -> dict
    if name in m["counters"]
        m["counters"][name] = 0
    m

fn mc_counter_count(m: dict) -> int
    len(keys(m["counters"]))

fn mc_total(m: dict) -> int
    let ks = keys(m["counters"])
    let total = 0
    for i in 0..len(ks)
        total += m["counters"][ks[i]]
    total
