// forge_lfu_cache -- thin wrapper over std/collections/lfu_cache (canonical implementation).
import std/collections/lfu_cache

fn lfu_new(capacity: int) -> dict
    return lfu_new(capacity)

fn lfu_get(c: dict, key: string) -> Result
    return lfu_get(c, key)

fn lfu_put(c: dict, key: string, value: string) -> dict
    return lfu_put(c, key, value)

fn lfu_count(c: dict) -> int
    c["count"]

fn lfu_hit_rate(c: dict) -> int
    let total = c["hits"] + c["misses"]
    0 if total == 0 else c["hits"] * 100 / total

