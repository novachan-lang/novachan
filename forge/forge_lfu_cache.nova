// forge_lfu_cache — least-frequently-used cache with Result API.

fn lfu_new(capacity: int) -> dict
    {"data": {}, "capacity": capacity, "count": 0, "hits": 0, "misses": 0}

fn lfu_get(c: dict, key: string) -> Result
    let dk = "d_{key}"
    if dk not in c["data"]
        c["misses"] += 1
        return err("cache miss: {key}")
    c["data"]["{dk}_freq"] += 1
    c["hits"] += 1
    ok(c["data"][dk])

fn lfu_put(c: dict, key: string, value: string) -> dict
    let dk = "d_{key}"
    if dk in c["data"]
        c["data"][dk] = value
        return c
    if c["count"] >= c["capacity"]
        let min_freq = 999999999
        let min_key = ""
        for i in 0..c["count"]
            let ik = "idx_{i}"
            if ik in c["data"]
                let ikval = c["data"][ik]
                let fk = "d_{ikval}_freq"
                if fk in c["data"] and c["data"][fk] < min_freq
                    min_freq = c["data"][fk]
                    min_key = c["data"][ik]
        if min_key != ""
            c["data"]["d_{min_key}"] = ""
            c["count"] -= 1
    c["data"][dk] = value
    c["data"]["{dk}_freq"] = 1
    let cnt = c["count"]
    let idx_key = "idx_{cnt}"
    c["data"][idx_key] = key
    c["count"] += 1
    c

fn lfu_count(c: dict) -> int
    c["count"]

fn lfu_hit_rate(c: dict) -> int
    let total = c["hits"] + c["misses"]
    0 if total == 0 else c["hits"] * 100 / total
