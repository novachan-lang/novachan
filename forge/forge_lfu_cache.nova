// forge_lfu_cache — least-frequently-used cache with Result API.

fn lfu_new(capacity: int) -> dict
    let c = {}
    c["data"] = {}
    c["capacity"] = capacity
    c["count"] = 0
    c["hits"] = 0
    c["misses"] = 0
    c

fn lfu_get(c: dict, key: string) -> Result
    let dk = "d_" + key
    let has = contains(c["data"], dk)
    if has != true
        c["misses"] = c["misses"] + 1
        return err("cache miss: " + key)
    c["data"][dk + "_freq"] = c["data"][dk + "_freq"] + 1
    c["hits"] = c["hits"] + 1
    ok(c["data"][dk])

fn lfu_put(c: dict, key: string, value: string) -> dict
    let dk = "d_" + key
    let has = contains(c["data"], dk)
    if has == true
        c["data"][dk] = value
        return c
    if c["count"] >= c["capacity"]
        let min_freq = 999999999
        let min_key = ""
        let i = 0
        while i < c["count"]
            let ik = "idx_" + str(i)
            let has_i = contains(c["data"], ik)
            if has_i == true
                let fk = "d_" + c["data"][ik] + "_freq"
                let has_f = contains(c["data"], fk)
                if has_f == true
                    if c["data"][fk] < min_freq
                        min_freq = c["data"][fk]
                        min_key = c["data"][ik]
            i += 1
        if min_key != ""
            c["data"]["d_" + min_key] = ""
            c["count"] = c["count"] - 1
    c["data"][dk] = value
    c["data"][dk + "_freq"] = 1
    let idx_key = "idx_" + str(c["count"])
    c["data"][idx_key] = key
    c["count"] = c["count"] + 1
    c

fn lfu_count(c: dict) -> int
    c["count"]

fn lfu_hit_rate(c: dict) -> int
    let total = c["hits"] + c["misses"]
    if total == 0
        return 0
    c["hits"] * 100 / total
