// forge_chaos_monkey — Chaos engineering: inject random faults.

fn cm_new() -> dict
    let c = {}
    c["targets"] = {}
    c["target_count"] = 0
    c["faults_injected"] = 0
    c["active"] = 1
    c

fn cm_add_target(c: dict, name: string, fault_type: string) -> dict
    let k = str(c["target_count"])
    c["targets"][k + "_name"] = name
    c["targets"][k + "_type"] = fault_type
    c["targets"][k + "_enabled"] = 1
    c["targets"][k + "_hits"] = 0
    c["target_count"] = c["target_count"] + 1
    c

fn cm_inject(c: dict, rand_pct: int, threshold: int) -> dict
    let result = {}
    if c["active"] != 1
        result["injected"] = 0
        result["target"] = ""
        result["fault_type"] = ""
        result["c"] = c
        return result
    if rand_pct >= threshold
        result["injected"] = 0
        result["target"] = ""
        result["fault_type"] = ""
        result["c"] = c
        return result
    let idx = rand_pct - (rand_pct / c["target_count"]) * c["target_count"]
    if idx < 0
        idx = 0
    if idx >= c["target_count"]
        idx = 0
    let k = str(idx)
    if c["targets"][k + "_enabled"] != 1
        result["injected"] = 0
        result["target"] = ""
        result["fault_type"] = ""
        result["c"] = c
        return result
    c["targets"][k + "_hits"] = c["targets"][k + "_hits"] + 1
    c["faults_injected"] = c["faults_injected"] + 1
    result["injected"] = 1
    result["target"] = c["targets"][k + "_name"]
    result["fault_type"] = c["targets"][k + "_type"]
    result["c"] = c
    result

fn cm_pause(c: dict) -> dict
    c["active"] = 0
    c

fn cm_resume(c: dict) -> dict
    c["active"] = 1
    c

fn cm_total_faults(c: dict) -> int
    c["faults_injected"]

fn cm_target_hits(c: dict, idx: int) -> int
    c["targets"][str(idx) + "_hits"]
