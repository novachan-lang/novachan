// forge_chaos_monkey — Chaos engineering: inject random faults.

fn cm_new() -> dict
    {"targets": {}, "target_count": 0, "faults_injected": 0, "active": 1}

fn cm_add_target(c: dict, name: string, fault_type: string) -> dict
    let k = str(c["target_count"])
    c["targets"]["{k}_name"] = name
    c["targets"]["{k}_type"] = fault_type
    c["targets"]["{k}_enabled"] = 1
    c["targets"]["{k}_hits"] = 0
    c["target_count"] += 1
    c

fn cm_inject(c: dict, rand_pct: int, threshold: int) -> dict
    let no_inject = {"injected": 0, "target": "", "fault_type": "", "c": c}
    if c["active"] != 1
        return no_inject
    if rand_pct >= threshold
        return no_inject
    let idx = rand_pct - (rand_pct / c["target_count"]) * c["target_count"]
    if idx < 0
        idx = 0
    if idx >= c["target_count"]
        idx = 0
    let k = str(idx)
    if c["targets"]["{k}_enabled"] != 1
        return no_inject
    c["targets"]["{k}_hits"] += 1
    c["faults_injected"] += 1
    {"injected": 1, "target": c["targets"]["{k}_name"], "fault_type": c["targets"]["{k}_type"], "c": c}

fn cm_pause(c: dict) -> dict
    c["active"] = 0
    c

fn cm_resume(c: dict) -> dict
    c["active"] = 1
    c

fn cm_total_faults(c: dict) -> int
    c["faults_injected"]

fn cm_target_hits(c: dict, idx: int) -> int
    let k = str(idx)
    c["targets"]["{k}_hits"]
