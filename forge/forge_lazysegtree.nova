// forge_lazysegtree -- a segment tree with LAZY PROPAGATION: apply an update to a whole RANGE of an array and
// query the sum of any range, both in O(log n), even as the array keeps changing. A Fenwick tree
// (forge_fenwick2d / forge_fenwick) updates ONE cell at a time; here you can "add 5 to every element from i to j"
// in a single logarithmic operation. The trick is laziness: instead of pushing a range update all the way down to
// every leaf, each internal node remembers a PENDING amount ("lazy tag") and only pushes it to its children when a
// later query actually needs to look inside -- so bulk updates stay cheap. This is the workhorse for interval
// bookkeeping: seat/inventory reservations over date ranges, cumulative range increments, brightness/volume
// adjustments over a span, range toggles, and competitive-programming range queries. This module implements the
// common range-ADD / range-SUM variant over integers. LEAF -- imports NOTHING.

// PRIVATE: build the tree over arr[start..end] rooted at `node`.
fn _lseg_build(tree: list, arr: list, node: int, start: int, end: int)
    if start == end
        tree[node] = arr[start]
    else
        let mid = (start + end) / 2
        _lseg_build(tree, arr, 2 * node, start, mid)
        _lseg_build(tree, arr, 2 * node + 1, mid + 1, end)
        tree[node] = tree[2 * node] + tree[2 * node + 1]

// Build a lazy segment tree from an array. Returns [tree, lazy, n] for the range functions.
fn lseg_build(arr: list) -> list
    let n = len(arr)
    let tree = [0 for z in 0..(4 * n)]
    let lazy = [0 for z in 0..(4 * n)]
    if n > 0
        _lseg_build(tree, arr, 1, 0, n - 1)
    [tree, lazy, n]

// PRIVATE: push a node's pending lazy add down to its two children.
fn _lseg_push(tree: list, lazy: list, node: int, start: int, end: int)
    if lazy[node] == 0
        return
    let mid = (start + end) / 2
    let lc = 2 * node
    let rc = 2 * node + 1
    tree[lc] += lazy[node] * (mid - start + 1)
    lazy[lc] += lazy[node]
    tree[rc] += lazy[node] * (end - mid)
    lazy[rc] += lazy[node]
    lazy[node] = 0

// PRIVATE: add `delta` to every element of arr[l..r] within the segment [start,end] rooted at node.
fn _lseg_update(tree: list, lazy: list, node: int, start: int, end: int, l: int, r: int, delta: int)
    if r < start or l > end
        return
    if l <= start and end <= r
        tree[node] += delta * (end - start + 1)
        lazy[node] += delta
    else
        _lseg_push(tree, lazy, node, start, end)
        let mid = (start + end) / 2
        _lseg_update(tree, lazy, 2 * node, start, mid, l, r, delta)
        _lseg_update(tree, lazy, 2 * node + 1, mid + 1, end, l, r, delta)
        tree[node] = tree[2 * node] + tree[2 * node + 1]

// PRIVATE: sum of arr[l..r] within segment [start,end] rooted at node.
fn _lseg_query(tree: list, lazy: list, node: int, start: int, end: int, l: int, r: int) -> int
    if r < start or l > end
        return 0
    if l <= start and end <= r
        return tree[node]
    _lseg_push(tree, lazy, node, start, end)
    let mid = (start + end) / 2
    _lseg_query(tree, lazy, 2 * node, start, mid, l, r) + _lseg_query(tree, lazy, 2 * node + 1, mid + 1, end, l, r)

// Add `delta` to every element in the inclusive range [l, r].
fn lseg_range_add(pack: list, l: int, r: int, delta: int)
    _lseg_update(pack[0], pack[1], 1, 0, pack[2] - 1, l, r, delta)

// The sum of the elements in the inclusive range [l, r].
fn lseg_range_sum(pack: list, l: int, r: int) -> int
    _lseg_query(pack[0], pack[1], 1, 0, pack[2] - 1, l, r)
