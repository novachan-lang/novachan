// forge_ulid -- ULID generation (Universally Unique Lexicographically Sortable Identifier). A 26-char
// Crockford-base32 id = 48-bit millisecond timestamp (first 10 chars) + 80 bits of CSPRNG randomness (last
// 16). Unlike a random UUIDv4, ULIDs sort in creation order as plain strings -> they make EXCELLENT database
// primary keys (no B-tree page splits from random inserts, natural time ordering, still globally unique).
// The timestamp is recoverable from the id. Crockford base32 excludes I/L/O/U (no ambiguity, case-insensitive).
//
// LEAF -- imports NOTHING. Built-ins: time_ms (wall clock), secure_bytes/bytes_get (CSPRNG), char_at, find.

// 256 is exactly divisible by 32, so (a CSPRNG byte % 32) is a UNIFORM base32 symbol -- no modulo bias.
fn _ulid_rand() -> string
    let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let b = secure_bytes(16)
    let out_parts = [char_at(alpha, bytes_get(b, i) % 32) for i in 0..16]
    let out = join(out_parts, "")
    out

// Encode a 48-bit ms timestamp as 10 Crockford-base32 chars, most-significant first (so byte order == time
// order). Extracted via /32 and %32 (no bit-shifts -- NOVA's 1<<64 is broken and we avoid shift edge cases).
fn _ulid_time(ms: int) -> string
    let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let chars = []
    let v = ms
    for i in 0..10
        push(chars, char_at(alpha, v % 32))
        v = v / 32
    let s_parts = []
    let j = len(chars) - 1
    while j >= 0
        push(s_parts, chars[j])
        j -= 1
    let s = join(s_parts, "")
    s

// A fresh ULID at the current wall-clock time.
fn ulid() -> string
    _ulid_time(time_ms()) + _ulid_rand()

// A ULID stamped with a caller-supplied ms time (for backfilling / deterministic tests).
fn ulid_at(ms: int) -> string
    _ulid_time(ms) + _ulid_rand()

// Recover the ms timestamp encoded in a ULID's first 10 chars (inverse of _ulid_time).
fn ulid_timestamp(id: string) -> int
    let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let v = 0
    for i in 0..10
        v = v * 32 + find(alpha, char_at(id, i))
    v
