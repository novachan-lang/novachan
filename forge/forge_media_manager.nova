// forge_media_manager — Media asset management with Result.

fn mm_new() -> dict
    {"assets": {}, "count": 0, "total_size": 0}

fn mm_upload(m: dict, name: string, content_type: string, size: int) -> dict
    m["assets"]["{name}_type"] = content_type
    m["assets"]["{name}_size"] = size
    m["assets"]["{name}_exists"] = 1
    m["count"] += 1
    m["total_size"] += size
    m

fn mm_get(m: dict, name: string) -> Result
    let exists_key = "{name}_exists"
    if exists_key not in m["assets"]
        return err("asset not found: {name}")
    ok(m["assets"]["{name}_type"])

fn mm_size(m: dict, name: string) -> Result
    let exists_key = "{name}_exists"
    if exists_key not in m["assets"]
        return err("asset not found: {name}")
    ok(m["assets"]["{name}_size"])

fn mm_delete(m: dict, name: string) -> Result
    let exists_key = "{name}_exists"
    if exists_key not in m["assets"]
        return err("asset not found: {name}")
    m["assets"][exists_key] = 0
    m["total_size"] -= m["assets"]["{name}_size"]
    ok(m)

fn mm_count(m: dict) -> int
    m["count"]

fn mm_total_size(m: dict) -> int
    m["total_size"]
