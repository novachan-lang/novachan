// forge_color -- color utilities for theming + accessibility: hex<->RGB, RGB->HSL, WCAG 2.1 relative
// luminance, and the WCAG contrast ratio (so a UI can pick text colors that pass AA/AAA). The contrast ratio
// is the exact number browsers/axe/Lighthouse compute; color_passes_aa gates the 4.5:1 normal-text threshold.
// Float math internally (channels/255.0), rounded to ints where the API returns ints. LEAF -- imports NOTHING.

// One hex nibble '0'-'9','a'-'f','A'-'F' -> 0..15, or -1 if not a hex digit. Single-char find() gives the
// index directly (which IS the nibble value); lower() folds the uppercase A-F onto a-f.
fn _hex_nibble(c: string) -> int
    find("0123456789abcdef", lower(c))

// Two lowercase hex digits for a byte 0..255 (clamped first). No literal braces in the string.
fn _hex2(n: int) -> string
    let x = n
    if x < 0
        x = 0
    if x > 255
        x = 255
    let digits = "0123456789abcdef"
    char_at(digits, x / 16) + char_at(digits, x % 16)

fn _fmax(a: float, b: float) -> float
    if a > b
        a
    else
        b

fn _fmin(a: float, b: float) -> float
    if a < b
        a
    else
        b

// Round a NON-NEGATIVE float to the nearest int (all HSL magnitudes are >= 0). round() is the LLVM
// round-half-away-from-zero intrinsic; int() truncates toward zero, exact on an already-integral double.
fn _iround(x: float) -> int
    int(round(x))

// Parse "#RRGGBB" / "RRGGBB", or 3-digit "#RGB" / "RGB" (each nibble doubled), into [r, g, b] ints 0..255.
// Any malformed input (bad length or a non-hex digit) -> [0, 0, 0].
fn color_hex_to_rgb(hex: string) -> list
    let h = hex
    if starts_with(h, "#")
        h = slice(h, 1, len(h))
    let n = len(h)
    // Expand 3-digit shorthand "RGB" -> "RRGGBB" so the 6-digit path handles everything.
    if n == 3
        let e_parts = []
        for k in 0..3
            let d = char_at(h, k)
            push(e_parts, d + d)
        let e = join(e_parts, "")
        h = e
        n = 6
    if n != 6
        return [0, 0, 0]
    for i in 0..6
        if _hex_nibble(char_at(h, i)) < 0
            return [0, 0, 0]
    let r = _hex_nibble(char_at(h, 0)) * 16 + _hex_nibble(char_at(h, 1))
    let g = _hex_nibble(char_at(h, 2)) * 16 + _hex_nibble(char_at(h, 3))
    let b = _hex_nibble(char_at(h, 4)) * 16 + _hex_nibble(char_at(h, 5))
    [r, g, b]

// [r, g, b] -> "#rrggbb" lowercase, each channel clamped 0..255 and zero-padded to 2 digits.
fn color_rgb_to_hex(r: int, g: int, b: int) -> string
    "#" + _hex2(r) + _hex2(g) + _hex2(b)

// RGB -> [h, s, l] with h in 0..360 degrees (int), s and l in 0..100 percent (int). Standard HSL from
// the normalized channels; achromatic (max==min) gives h=0, s=0.
fn color_rgb_to_hsl(r: int, g: int, b: int) -> list
    let rf = r / 255.0
    let gf = g / 255.0
    let bf = b / 255.0
    let mx = _fmax(rf, _fmax(gf, bf))
    let mn = _fmin(rf, _fmin(gf, bf))
    let l = (mx + mn) / 2.0
    let h = 0.0
    let s = 0.0
    if mx == mn
        h = 0.0
        s = 0.0
    else
        let d = mx - mn
        if l < 0.5
            s = d / (mx + mn)
        else
            s = d / (2.0 - mx - mn)
        if mx == rf
            let hg = (gf - bf) / d
            if gf < bf
                hg += 6.0
            h = hg
        else if mx == gf
            h = (bf - rf) / d + 2.0
        else
            h = (rf - gf) / d + 4.0
        h = h * 60.0
    [_iround(h), _iround(s * 100.0), _iround(l * 100.0)]

// Linearize one sRGB channel already normalized to [0, 1] (the WCAG piecewise transfer curve).
fn _srgb_linear(c: float) -> float
    if c <= 0.03928
        c / 12.92
    else
        pow((c + 0.055) / 1.055, 2.4)

// WCAG 2.1 relative luminance in [0, 1]: L = 0.2126*R + 0.7152*G + 0.0722*B over the linearized channels.
fn color_luminance(r: int, g: int, b: int) -> float
    let rl = _srgb_linear(r / 255.0)
    let gl = _srgb_linear(g / 255.0)
    let bl = _srgb_linear(b / 255.0)
    0.2126 * rl + 0.7152 * gl + 0.0722 * bl

// WCAG contrast ratio between two hex colors: (lighter + 0.05) / (darker + 0.05). ~1.0 (identical) .. 21.0
// (pure black vs pure white). Order-independent.
fn color_contrast(hex1: string, hex2: string) -> float
    let c1 = color_hex_to_rgb(hex1)
    let c2 = color_hex_to_rgb(hex2)
    let l1 = color_luminance(c1[0], c1[1], c1[2])
    let l2 = color_luminance(c2[0], c2[1], c2[2])
    let lighter = _fmax(l1, l2)
    let darker = _fmin(l1, l2)
    (lighter + 0.05) / (darker + 0.05)

// True if the pair meets WCAG AA for normal text (contrast ratio >= 4.5:1).
fn color_passes_aa(hex1: string, hex2: string) -> bool
    color_contrast(hex1, hex2) >= 4.5

// ── HSL/HSV <-> RGB (the color-model conversions a picker / theme generator needs) ───────────────────
// PRIVATE: absolute value of a float.
fn _cabs(x: float) -> float
    if x < 0.0
        return -x
    x

// PRIVATE: given hue' = h/60 in [0,6], chroma c, and mid component x, the pre-`m` [r1,g1,b1] for the hextant.
fn _hue_rgb1(hp: float, c: float, x: float) -> list
    let sector = int(hp)
    if sector == 0
        return [c, x, 0.0]
    if sector == 1
        return [x, c, 0.0]
    if sector == 2
        return [0.0, c, x]
    if sector == 3
        return [0.0, x, c]
    if sector == 4
        return [x, 0.0, c]
    [c, 0.0, x]

// HSL (h 0..360, s 0..100, l 0..100) -> [r, g, b] 0..255 -- the exact inverse of color_rgb_to_hsl.
fn color_hsl_to_rgb(h: int, s: int, l: int) -> list
    let sf = s / 100.0
    let lf = l / 100.0
    if sf == 0.0
        let g = _iround(lf * 255.0)
        return [g, g, g]
    let c = (1.0 - _cabs(2.0 * lf - 1.0)) * sf
    let hp = (h * 1.0) / 60.0
    let hmod = hp - 2.0 * int(hp / 2.0)
    let x = c * (1.0 - _cabs(hmod - 1.0))
    let m = lf - c / 2.0
    let t = _hue_rgb1(hp, c, x)
    [_iround((t[0] + m) * 255.0), _iround((t[1] + m) * 255.0), _iround((t[2] + m) * 255.0)]

// RGB -> HSV/HSB [h 0..360, s 0..100, v 0..100] (the model color pickers use: value = max channel).
fn color_rgb_to_hsv(r: int, g: int, b: int) -> list
    let rf = r / 255.0
    let gf = g / 255.0
    let bf = b / 255.0
    let mx = _fmax(rf, _fmax(gf, bf))
    let mn = _fmin(rf, _fmin(gf, bf))
    let d = mx - mn
    let s = 0.0
    if mx > 0.0
        s = d / mx
    let h = 0.0
    if d > 0.0
        if mx == rf
            let hg = (gf - bf) / d
            if gf < bf
                hg += 6.0
            h = hg
        else if mx == gf
            h = (bf - rf) / d + 2.0
        else
            h = (rf - gf) / d + 4.0
        h = h * 60.0
    [_iround(h), _iround(s * 100.0), _iround(mx * 100.0)]

// HSV/HSB (h 0..360, s 0..100, v 0..100) -> [r, g, b] 0..255 -- the inverse of color_rgb_to_hsv.
fn color_hsv_to_rgb(h: int, s: int, v: int) -> list
    let sf = s / 100.0
    let vf = v / 100.0
    if sf == 0.0
        let g = _iround(vf * 255.0)
        return [g, g, g]
    let c = vf * sf
    let hp = (h * 1.0) / 60.0
    let hmod = hp - 2.0 * int(hp / 2.0)
    let x = c * (1.0 - _cabs(hmod - 1.0))
    let m = vf - c
    let t = _hue_rgb1(hp, c, x)
    [_iround((t[0] + m) * 255.0), _iround((t[1] + m) * 255.0), _iround((t[2] + m) * 255.0)]
