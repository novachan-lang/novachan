// forge_inbox — message inbox with read/unread tracking and Result API.

fn inbox_new() -> dict
    {"messages": {}, "read_status": {}, "total": 0, "unread": 0}

fn inbox_add(b: dict, msg_id: string, sender: string, subject: string) -> dict
    let mk = "msg_" + msg_id
    b["messages"][mk] = sender + ": " + subject
    let sk = "from_" + msg_id
    b["messages"][sk] = sender
    let rk = "r_" + msg_id
    b["read_status"][rk] = "unread"
    b["total"] += 1
    b["unread"] += 1
    b

fn inbox_read(b: dict, msg_id: string) -> Result
    let mk = "msg_" + msg_id
    if mk not in b["messages"]
        return err("message not found")
    let rk = "r_" + msg_id
    if b["read_status"][rk] == "unread"
        b["read_status"][rk] = "read"
        b["unread"] -= 1
    ok(b["messages"][mk])

fn inbox_delete(b: dict, msg_id: string) -> Result
    let mk = "msg_" + msg_id
    if mk not in b["messages"]
        return err("message not found")
    let rk = "r_" + msg_id
    if b["read_status"][rk] == "unread"
        b["unread"] -= 1
    b["messages"][mk] = ""
    b["read_status"][rk] = "deleted"
    b["total"] -= 1
    ok(b)

fn inbox_is_read(b: dict, msg_id: string) -> int
    let rk = "r_" + msg_id
    1 if rk in b["read_status"] and b["read_status"][rk] == "read" else 0

fn inbox_sender(b: dict, msg_id: string) -> Result
    let sk = "from_" + msg_id
    if sk not in b["messages"]
        return err("message not found")
    ok(b["messages"][sk])

fn inbox_total(b: dict) -> int
    b["total"]

fn inbox_unread_count(b: dict) -> int
    b["unread"]
