fn dm_new()
    let state = {}
    state["record_count"] = 0
    state["check_count"] = 0
    state["failure_count"] = 0
    state["last_checked"] = ""
    return state

fn dm_add_record(state, domain, record_type, expected_value)
    let idx = state["record_count"]
    let key_d = "rec_" + str(idx) + "_domain"
    let key_t = "rec_" + str(idx) + "_type"
    let key_v = "rec_" + str(idx) + "_value"
    let key_s = "rec_" + str(idx) + "_status"
    state[key_d] = domain
    state[key_t] = record_type
    state[key_v] = expected_value
    state[key_s] = "unknown"
    state["record_count"] = idx + 1
    return state

fn dm_check(state, domain, record_type, actual_value)
    state["check_count"] = state["check_count"] + 1
    state["last_checked"] = domain
    let i = 0
    let n = state["record_count"]
    while i < n
        let key_d = "rec_" + str(i) + "_domain"
        let key_t = "rec_" + str(i) + "_type"
        let key_v = "rec_" + str(i) + "_value"
        let key_s = "rec_" + str(i) + "_status"
        if state[key_d] == domain and state[key_t] == record_type
            if state[key_v] == actual_value
                state[key_s] = "healthy"
                return ok(state)
            else
                state[key_s] = "degraded"
                state["failure_count"] = state["failure_count"] + 1
                return ok(state)
        i = i + 1
    return err("record not found: " + domain)

fn dm_status(state, domain, record_type)
    let i = 0
    let n = state["record_count"]
    while i < n
        let key_d = "rec_" + str(i) + "_domain"
        let key_t = "rec_" + str(i) + "_type"
        if state[key_d] == domain and state[key_t] == record_type
            let key_s = "rec_" + str(i) + "_status"
            return ok(state[key_s])
        i = i + 1
    return err("not found")

fn dm_record_count(state)
    return state["record_count"]

fn dm_check_count(state)
    return state["check_count"]

fn dm_failure_count(state)
    return state["failure_count"]

fn dm_last_checked(state)
    if state["last_checked"] == ""
        return err("no checks yet")
    return ok(state["last_checked"])

fn dm_healthy_count(state)
    let count = 0
    let i = 0
    let n = state["record_count"]
    while i < n
        let key_s = "rec_" + str(i) + "_status"
        if state[key_s] == "healthy"
            count = count + 1
        i = i + 1
    return count

fn dm_degraded_count(state)
    let count = 0
    let i = 0
    let n = state["record_count"]
    while i < n
        let key_s = "rec_" + str(i) + "_status"
        if state[key_s] == "degraded"
            count = count + 1
        i = i + 1
    return count
