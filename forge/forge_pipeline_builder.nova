// forge_pipeline_builder — Pipeline builder for data processing.
// Define stages, build pipeline, track execution stats.

fn pb_new(name: string) -> dict
    let pb = {}
    pb["name"] = name
    pb["stages"] = []
    pb["runs"] = 0
    pb["items_in"] = 0
    pb["items_out"] = 0
    pb

fn pb_add_stage(pb: dict, stage_name: string, stage_type: string) -> dict
    let s = {}
    s["name"] = stage_name
    s["type"] = stage_type
    s["processed"] = 0
    s["dropped"] = 0
    push(pb["stages"], s)
    pb

fn pb_run(pb: dict, input_count: int) -> dict
    pb["runs"] = pb["runs"] + 1
    pb["items_in"] = pb["items_in"] + input_count
    let current = input_count
    let i = 0
    while i < len(pb["stages"])
        let stage = pb["stages"][i]
        pb["stages"][i]["processed"] = pb["stages"][i]["processed"] + current
        if stage["type"] == "filter"
            let dropped = current / 4
            pb["stages"][i]["dropped"] = pb["stages"][i]["dropped"] + dropped
            current = current - dropped
        i = i + 1
    pb["items_out"] = pb["items_out"] + current
    pb

fn pb_stage_count(pb: dict) -> int
    len(pb["stages"])

fn pb_total_runs(pb: dict) -> int
    pb["runs"]

fn pb_total_in(pb: dict) -> int
    pb["items_in"]

fn pb_total_out(pb: dict) -> int
    pb["items_out"]

fn pb_stage_processed(pb: dict, stage_name: string) -> int
    let i = 0
    while i < len(pb["stages"])
        if pb["stages"][i]["name"] == stage_name
            return pb["stages"][i]["processed"]
        i = i + 1
    0

fn pb_stage_dropped(pb: dict, stage_name: string) -> int
    let i = 0
    while i < len(pb["stages"])
        if pb["stages"][i]["name"] == stage_name
            return pb["stages"][i]["dropped"]
        i = i + 1
    0

fn pb_throughput_pct(pb: dict) -> int
    if pb["items_in"] == 0
        return 0
    (pb["items_out"] * 100) / pb["items_in"]
