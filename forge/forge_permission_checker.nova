// forge_permission_checker — Role-based permission checking.

fn pc_new() -> dict
    {"roles": {}, "checks": 0, "grants": 0, "denials": 0}

fn pc_grant(p: dict, role: string, permission: string) -> dict
    let k = role + ":" + permission
    p["roles"][k] = 1
    p

fn pc_revoke(p: dict, role: string, permission: string) -> dict
    let k = role + ":" + permission
    let new_roles = {}
    let ks = keys(p["roles"])
    for i in 0..len(ks)
        if ks[i] != k
            new_roles[ks[i]] = p["roles"][ks[i]]
    p["roles"] = new_roles
    p

fn pc_check(p: dict, role: string, permission: string) -> dict
    p["checks"] += 1
    let k = role + ":" + permission
    let result = {}
    if k in p["roles"]
        p["grants"] += 1
        result = {"allowed": 1}
    else
        p["denials"] += 1
        result = {"allowed": 0}
    result["p"] = p
    result

fn pc_has_permission(p: dict, role: string, permission: string) -> int
    let k = role + ":" + permission
    1 if k in p["roles"] else 0

fn pc_total_checks(p: dict) -> int
    p["checks"]

fn pc_grant_rate(p: dict) -> int
    if p["checks"] == 0
        return 0
    p["grants"] * 100 / p["checks"]
