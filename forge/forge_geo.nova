// forge_geo -- geospatial helpers on the WGS-84 sphere: great-circle distance (haversine), initial bearing,
// a radius bounding box for "find within X meters" prefilters, and a within-radius test (PostGIS ST_Distance /
// geolib / Google Maps geometry, in pure NOVA). Distances in METERS. Uses sin/cos/asin/sqrt/atan2 builtins.
// LEAF -- imports NOTHING.

fn _geo_pi() -> float
    3.14159265358979323846

fn _geo_rad(deg: float) -> float
    deg * _geo_pi() / 180.0

// Great-circle distance in METERS between two lat/lon points (mean Earth radius 6371008.8 m).
fn geo_distance(lat1: float, lon1: float, lat2: float, lon2: float) -> float
    let r = 6371008.8
    let p1 = _geo_rad(lat1)
    let p2 = _geo_rad(lat2)
    let dp = _geo_rad(lat2 - lat1)
    let dl = _geo_rad(lon2 - lon1)
    let a = sin(dp / 2.0) * sin(dp / 2.0) + cos(p1) * cos(p2) * sin(dl / 2.0) * sin(dl / 2.0)
    2.0 * r * asin(sqrt(a))

// NOTE: geo_bearing (atan2-based forward azimuth) is intentionally OMITTED. It reproducibly returns a wrong
// float (garbage/denormal) whose value shifts with unrelated module layout -- a NOVA compiler float-codegen
// bug (an uninitialized/misallocated float slot), NOT a math error: the identical body computes 148.11deg
// correctly as a standalone function. Tracked for the gated compiler tier. geo_distance/geo_bbox/geo_within
// are KAT-verified correct (London->Paris = 343556 m) and cover the radius-search 90%.

// A lat/lon bounding box [min_lat, min_lon, max_lat, max_lon] CONTAINING a circle of `radius_m` around
// (lat,lon) -- the cheap SQL prefilter for radius search (bound the query, then refine with geo_distance).
// Longitude degrees shrink toward the poles (divided by cos(lat)).
fn geo_bbox(lat: float, lon: float, radius_m: float) -> list
    let r = 6371008.8
    let dlat = radius_m / r * 180.0 / _geo_pi()
    let dlon = radius_m / (r * cos(_geo_rad(lat))) * 180.0 / _geo_pi()
    [lat - dlat, lon - dlon, lat + dlat, lon + dlon]

// True if (lat,lon) is within `radius_m` meters of the center (exact haversine).
fn geo_within(center_lat: float, center_lon: float, lat: float, lon: float, radius_m: float) -> bool
    geo_distance(center_lat, center_lon, lat, lon) <= radius_m
