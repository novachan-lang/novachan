// forge_gossip_state — gossip protocol state dissemination with Result API.

fn gs_new() -> dict
    let g = {}
    g["node_count"] = 0
    g["gossip_rounds"] = 0
    g

fn gs_add_node(g: dict, node: string) -> dict
    g["n_" + node + "_alive"] = 1
    g["n_" + node + "_gen"] = 0
    g["node_count"] = g["node_count"] + 1
    g

fn gs_set_state(g: dict, node: string, key: string, value: string) -> Result
    if contains(g, "n_" + node + "_alive") != true
        return err("node not found: " + node)
    g["n_" + node + "_" + key] = value
    g["n_" + node + "_gen"] = g["n_" + node + "_gen"] + 1
    ok(g)

fn gs_get_state(g: dict, node: string, key: string) -> Result
    if contains(g, "n_" + node + "_alive") != true
        return err("node not found: " + node)
    let sk = "n_" + node + "_" + key
    if contains(g, sk) != true
        return err("key not found: " + key)
    ok(g[sk])

fn gs_mark_dead(g: dict, node: string) -> Result
    if contains(g, "n_" + node + "_alive") != true
        return err("node not found: " + node)
    g["n_" + node + "_alive"] = 0
    ok(g)

fn gs_is_alive(g: dict, node: string) -> int
    let ak = "n_" + node + "_alive"
    if contains(g, ak) == true
        return g[ak]
    0

fn gs_generation(g: dict, node: string) -> Result
    let gk = "n_" + node + "_gen"
    if contains(g, gk) != true
        return err("node not found: " + node)
    ok(g[gk])

fn gs_gossip(g: dict) -> dict
    g["gossip_rounds"] = g["gossip_rounds"] + 1
    g

fn gs_node_count(g: dict) -> int
    g["node_count"]

fn gs_gossip_rounds(g: dict) -> int
    g["gossip_rounds"]
