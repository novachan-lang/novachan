// forge_saga -- SAGA orchestration for distributed-transaction patterns.
//
// A saga is a sequence of steps each with a local action and a COMPENSATION (undo).
// If any step fails, every already-completed step is compensated in REVERSE ORDER.
// This is the correct pattern for distributed workflows: local transactions are durable,
// compensations are best-effort, and no two-phase-commit (2PC) coordinator is required.
//
// Why this beats alternatives:
//   * Hand-rolled try/catch rollback: ad-hoc, grows duplicated undo logic, no ordering guarantee.
//   * Spring @Saga / Axon: annotation-driven, JVM-only, event-sourcing infra required.
//   * 2PC: requires a distributed lock coordinator; blocks on network partition; single point of failure.
//   NOVA sagas: first-class data, pure functions, zero framework, works across any transport.
//
// Context threading: `ctx` (a dict) is passed explicitly through every action. Each action
// receives the current ctx and returns ok(updated_ctx) or err(msg). Compensations receive
// the ctx at the point of failure (best-effort; no return value required).
//
// LEAF MODULE -- no imports; uses only NOVA built-ins.

// saga_new() -> dict
// Create a new, empty saga. The returned dict holds the ordered step list.
fn saga_new() -> dict
    let s = {}
    s["steps"] = []
    s

// saga_step(s, name, action, comp) -> dict
// Append one step to the saga. Returns s so calls can be chained.
//   name   -- human-readable label (string); used in error messages on failure.
//   action -- fn(ctx: dict) -> Result<dict>; does the step's work; returns ok(updated_ctx) or err(msg).
//   comp   -- fn(ctx: dict); compensates (undoes) this step; best-effort, no return needed.
fn saga_step(s: dict, name: string, action, comp) -> dict
    let step = []
    push(step, name)
    push(step, action)
    push(step, comp)
    push(s["steps"], step)
    s

// saga_run(s, ctx) -> Result<dict>
// Execute the saga against the initial context dict.
// Steps run in order; ctx is threaded and updated after each successful step.
// On any failure: compensate completed steps in REVERSE order, then return err.
// On full success: return ok(final_ctx).
fn saga_run(s: dict, ctx: dict) -> Result<dict>
    let steps = s["steps"]
    let done = []
    let cur = ctx
    let i = 0
    while i < len(steps)
        let step = steps[i]
        let act = step[1]
        let r = act(cur)
        if is_err(r)
            let j = len(done) - 1
            while j >= 0
                let ci = done[j]
                let cstep = steps[ci]
                let comp = cstep[2]
                comp(cur)
                j = j - 1
            return err("saga: step failed at " + step[0])
        cur = unwrap(r)
        push(done, i)
        i = i + 1
    ok(cur)

// saga_len(s) -> int
// Return the number of steps registered in the saga.
fn saga_len(s: dict) -> int
    len(s["steps"])
