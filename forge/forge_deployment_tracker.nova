// forge_deployment_tracker — deployment history and rollback tracking with Result API.

fn dt_new() -> dict
    {"deploy_count": 0, "rollbacks": 0, "current_version": ""}

fn dt_deploy(d: dict, version: string, deployer: string) -> dict
    let idx = d["deploy_count"]
    d["d_" + str(idx) + "_ver"] = version
    d["d_" + str(idx) + "_who"] = deployer
    d["d_" + str(idx) + "_status"] = "active"
    d["deploy_count"] += 1
    d["current_version"] = version
    d

fn dt_rollback(d: dict) -> Result
    if d["deploy_count"] < 2
        return err("no previous version to rollback to")
    let cur = d["deploy_count"] - 1
    d["d_" + str(cur) + "_status"] = "rolled_back"
    let prev = cur - 1
    d["current_version"] = d["d_" + str(prev) + "_ver"]
    d["rollbacks"] += 1
    ok(d)

fn dt_version_at(d: dict, index: int) -> Result
    if index < 0 or index >= d["deploy_count"]
        return err("deploy index out of range")
    ok(d["d_" + str(index) + "_ver"])

fn dt_deployer_at(d: dict, index: int) -> Result
    if index < 0 or index >= d["deploy_count"]
        return err("deploy index out of range")
    ok(d["d_" + str(index) + "_who"])

fn dt_status_at(d: dict, index: int) -> Result
    if index < 0 or index >= d["deploy_count"]
        return err("deploy index out of range")
    ok(d["d_" + str(index) + "_status"])

fn dt_current_version(d: dict) -> string
    d["current_version"]

fn dt_deploy_count(d: dict) -> int
    d["deploy_count"]

fn dt_rollback_count(d: dict) -> int
    d["rollbacks"]
