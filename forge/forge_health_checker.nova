// forge_health_checker — service health check registry with Result.

fn hc_new() -> dict
    let h = {}
    h["checks"] = {}
    h["check_count"] = 0
    h["pass_count"] = 0
    h["fail_count"] = 0
    h["last_failed"] = ""
    h

fn hc_add_check(h: dict, name: string, check_type: string) -> dict
    let key = "chk_" + name
    h["checks"][key] = check_type
    h["check_count"] = h["check_count"] + 1
    h

fn hc_run_check(h: dict, name: string, passed: int) -> Result
    let key = "chk_" + name
    let has = contains(h["checks"], key)
    if has != true
        return err("unknown check: " + name)
    if passed == 1
        h["pass_count"] = h["pass_count"] + 1
    else
        h["fail_count"] = h["fail_count"] + 1
        h["last_failed"] = name
    ok(h)

fn hc_status(h: dict) -> string
    if h["fail_count"] > 0
        return "unhealthy"
    if h["pass_count"] > 0
        return "healthy"
    "unknown"

fn hc_check_count(h: dict) -> int
    h["check_count"]

fn hc_pass_rate(h: dict) -> int
    let total = h["pass_count"] + h["fail_count"]
    if total == 0
        return 0
    h["pass_count"] * 100 / total

fn hc_last_failed(h: dict) -> Result
    if h["last_failed"] == ""
        return err("no failures")
    ok(h["last_failed"])

fn hc_is_healthy(h: dict) -> int
    if h["fail_count"] == 0 and h["pass_count"] > 0
        return 1
    0
