// forge_shortlink -- URL shortener: map a sequential id <-> a short base62 code and build/resolve short URLs
// (the core of a bit.ly-style service). Store the code<->target mapping in your DB; this module handles the
// code math + URL assembly. Composes forge_base62. Imports forge_base62.
import forge_base62

// The short code for a numeric id. shortlink_code(125) -> a base62 string.
fn shortlink_code(id: int) -> string
    base62_encode(id)

// The id for a short code (inverse of shortlink_code).
fn shortlink_id(code: string) -> int
    base62_decode(code)

// A full short URL from a base domain + id. shortlink_url("https://sho.rt", 125) -> "https://sho.rt/<code>".
fn shortlink_url(base: string, id: int) -> string
    let b = base
    while len(b) > 0 and char_at(b, len(b) - 1) == "/"
        b = slice(b, 0, len(b) - 1)
    b + "/" + shortlink_code(id)

// The id encoded in a short URL's trailing code (inverse of shortlink_url).
fn shortlink_resolve(short_url: string) -> int
    let idx = 0 - 1
    let i = 0
    while i < len(short_url)
        if char_at(short_url, i) == "/"
            idx = i
        i = i + 1
    if idx < 0
        return shortlink_id(short_url)
    shortlink_id(slice(short_url, idx + 1, len(short_url)))
