fn tm_new()
    let state = {}
    state["threat_count"] = 0
    state["mitigation_count"] = 0
    state["asset_count"] = 0
    return state

fn tm_add_asset(state, asset_name, asset_type)
    state["asset_" + asset_name + "_type"] = asset_type
    state["asset_" + asset_name + "_threats"] = 0
    state["asset_count"] = state["asset_count"] + 1
    return state

fn tm_add_threat(state, threat_id, asset_name, category, severity)
    let akey = "asset_" + asset_name + "_type"
    if akey in state != true
        return err("unknown asset: " + asset_name)
    let idx = state["threat_count"]
    state["t_" + str(idx) + "_id"] = threat_id
    state["t_" + str(idx) + "_asset"] = asset_name
    state["t_" + str(idx) + "_cat"] = category
    state["t_" + str(idx) + "_sev"] = severity
    state["t_" + str(idx) + "_mitigated"] = 0
    state["t_" + threat_id + "_idx"] = idx
    state["threat_count"] = idx + 1
    state["asset_" + asset_name + "_threats"] = state["asset_" + asset_name + "_threats"] + 1
    return ok(state)

fn tm_mitigate(state, threat_id, mitigation_desc)
    let ikey = "t_" + threat_id + "_idx"
    if ikey in state != true
        return err("unknown threat: " + threat_id)
    let idx = state[ikey]
    state["t_" + str(idx) + "_mitigated"] = 1
    state["t_" + str(idx) + "_mitigation"] = mitigation_desc
    state["mitigation_count"] = state["mitigation_count"] + 1
    return ok(state)

fn tm_is_mitigated(state, threat_id)
    let ikey = "t_" + threat_id + "_idx"
    if ikey in state != true
        return err("unknown threat")
    let idx = state[ikey]
    return ok(state["t_" + str(idx) + "_mitigated"])

fn tm_severity(state, threat_id)
    let ikey = "t_" + threat_id + "_idx"
    if ikey in state != true
        return err("unknown threat")
    let idx = state[ikey]
    return ok(state["t_" + str(idx) + "_sev"])

fn tm_category(state, threat_id)
    let ikey = "t_" + threat_id + "_idx"
    if ikey in state != true
        return err("unknown threat")
    let idx = state[ikey]
    return ok(state["t_" + str(idx) + "_cat"])

fn tm_threat_count(state)
    return state["threat_count"]

fn tm_mitigation_count(state)
    return state["mitigation_count"]

fn tm_asset_count(state)
    return state["asset_count"]

fn tm_asset_threats(state, asset_name)
    let tkey = "asset_" + asset_name + "_threats"
    if tkey in state != true
        return err("unknown asset")
    return ok(state[tkey])

fn tm_unmitigated_count(state)
    let count = 0
    let i = 0
    let n = state["threat_count"]
    while i < n
        if state["t_" + str(i) + "_mitigated"] == 0
            count += 1
        i += 1
    return count
