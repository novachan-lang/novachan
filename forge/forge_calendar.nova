// forge_calendar -- the classic calendar-computation algorithms: which weekday a date falls on, the date of Easter,
// and conversion to/from the Julian Day Number (a continuous count of days used in astronomy and as a
// calendar-agnostic way to do date arithmetic). These are the exact integer formulas -- Sakamoto's for the day of
// week, the Anonymous Gregorian "Computus" for Easter, and Fliegel-Van Flandern for the Julian day -- so results
// are precise for any Gregorian date with no lookup tables. Julian Day Numbers make "how many days between two
// dates" and "what date is N days from here" trivial subtraction/addition, sidestepping month-length and
// leap-year bookkeeping entirely. forge_date handles parsing/formatting/leap-year; this module is the day-math.
// LEAF -- imports NOTHING.

// The day of the week for a Gregorian date, 0 = Sunday .. 6 = Saturday (Sakamoto's algorithm).
fn day_of_week(y: int, m: int, d: int) -> int
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    let yy = y
    if m < 3
        yy -= 1
    (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7

// The weekday name for a date ("Sunday".."Saturday").
fn day_name(y: int, m: int, d: int) -> string
    let names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    names[day_of_week(y, m, d)]

// True if the date is a Saturday or Sunday.
fn is_weekend(y: int, m: int, d: int) -> bool
    let dw = day_of_week(y, m, d)
    dw == 0 or dw == 6

// The date of Easter Sunday in the given Gregorian year, as [month, day] (Anonymous Gregorian Computus).
fn easter(year: int) -> list
    let a = year % 19
    let b = year / 100
    let c = year % 100
    let d = b / 4
    let e = b % 4
    let f = (b + 8) / 25
    let g = (b - f + 1) / 3
    let h = (19 * a + b - d - g + 15) % 30
    let i = c / 4
    let k = c % 4
    let l = (32 + 2 * e + 2 * i - h - k) % 7
    let mm = (a + 11 * h + 22 * l) / 451
    let month = (h + l - 7 * mm + 114) / 31
    let day = ((h + l - 7 * mm + 114) % 31) + 1
    [month, day]

// The Julian Day Number for a Gregorian date (Fliegel-Van Flandern): a continuous day count where 2000-01-01 is
// 2451545. Use differences of these for exact date arithmetic.
fn julian_day(y: int, m: int, d: int) -> int
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045

// The Gregorian date [year, month, day] for a Julian Day Number (inverse of julian_day).
fn from_julian_day(jdn: int) -> list
    let a = jdn + 32044
    let b = (4 * a + 3) / 146097
    let c = a - (146097 * b) / 4
    let dd = (4 * c + 3) / 1461
    let e = c - (1461 * dd) / 4
    let mrow = (5 * e + 2) / 153
    let day = e - (153 * mrow + 2) / 5 + 1
    let month = mrow + 3 - 12 * (mrow / 10)
    let year = 100 * b + dd - 4800 + mrow / 10
    [year, month, day]

// The number of days from the first date to the second (positive if the second is later). Exact via Julian days.
fn days_between(y1: int, m1: int, d1: int, y2: int, m2: int, d2: int) -> int
    julian_day(y2, m2, d2) - julian_day(y1, m1, d1)

// The date [year, month, day] that is `n` days after the given date (n may be negative to go backward).
fn add_days(y: int, m: int, d: int, n: int) -> list
    from_julian_day(julian_day(y, m, d) + n)
