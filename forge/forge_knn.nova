// forge_knn -- thin wrapper over std/ml/knn (canonical implementation).
import std/ml/knn

fn knn_distance_sq(a: list, b: list) -> float
    let total = 0.0
    for i in 0..len(a)
        let d = a[i] * 1.0 - b[i] * 1.0
        total += d * d
    total

// The indices of the k points nearest to `query`, closest first. O(n*k-ish via insertion sort; fine for
// the moderate n this method targets. Uses PARALLEL scalar arrays (dists + idxs) sorted together -- moving
// list-typed elements while holding a reference to one corrupts under NOVA's list semantics.)
// A k <= 0, or a k larger than the point set, is clamped rather than being an error.

fn knn_nearest(points: list, query: list, k: int) -> list
    let dists = [knn_distance_sq(points[i], query) for i in 0..len(points)]
    let idxs = [i for i in 0..len(points)]
    // Insertion sort both arrays together by distance ascending (scalar moves only).
    // KEPT as a loop, and the inner scan KEPT as a `while`: a sort is an in-place data-dependent
    // permutation, and the inner shift SHORT-CIRCUITS on the first element that is not greater.
    for a in 1..len(dists)
        let cd = dists[a] * 1.0
        let ci = idxs[a]
        let b = a - 1
        while b >= 0 and (dists[b] * 1.0) > cd
            dists[b + 1] = dists[b]
            idxs[b + 1] = idxs[b]
            b -= 1
        dists[b + 1] = cd
        idxs[b + 1] = ci
    let m = k if k < len(idxs) else len(idxs)
    [idxs[j] for j in 0..m]

// Classify `query` by the majority label among its k nearest neighbors. `labels` are strings parallel to
// `points`. Ties are broken toward the label of the CLOSEST tied neighbor.
// NOTE: returns "" when there are no neighbors (empty `points`, or k <= 0) -- a sentinel that a caller
// cannot distinguish from a genuine empty label. Preserved deliberately; changing it to a Result would
// break every caller's signature. Flagged rather than silently "fixed".

fn knn_classify(points: list, labels: list, query: list, k: int) -> string
    return kn_classify(points, labels, query, k)

fn knn_regress(points: list, values: list, query: list, k: int) -> float
    let idxs = knn_nearest(points, query, k)
    let total = 0.0
    for ix in idxs
        total += values[ix] * 1.0
    let n = len(idxs)
    total / (n * 1.0) if n > 0 else 0.0

