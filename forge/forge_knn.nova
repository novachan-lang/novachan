// forge_knn -- k-nearest-neighbors: the simplest, most intuitive machine-learning method. Given a set of
// labelled example points, classify a new point by the majority label of its k closest examples ("this new
// user looks like these 5 churned users"), predict a number by averaging its neighbors (regression), or just
// find the k most similar items (recommendations, "customers who bought this", nearest stores, deduplication).
// No training phase -- it reasons directly from the examples. Points are feature vectors (lists of numbers of
// equal length); distance is EUCLIDEAN. We rank by SQUARED distance (same ordering, and it skips the sqrt), so
// results are exact and there is no floating-point square-root edge. LEAF -- imports NOTHING.

// Squared Euclidean distance between two equal-length feature vectors.
fn knn_distance_sq(a: list, b: list) -> float
    let sum = 0.0
    let i = 0
    while i < len(a)
        let d = a[i] * 1.0 - b[i] * 1.0
        sum = sum + d * d
        i = i + 1
    sum

// The indices of the k points nearest to `query`, closest first. O(n*k-ish via insertion sort; fine for
// the moderate n this method targets. Uses PARALLEL scalar arrays (dists + idxs) sorted together -- moving
// list-typed elements while holding a reference to one corrupts under NOVA's list semantics.)
fn knn_nearest(points: list, query: list, k: int) -> list
    let dists = []
    let idxs = []
    let i = 0
    while i < len(points)
        push(dists, knn_distance_sq(points[i], query))
        push(idxs, i)
        i = i + 1
    // insertion sort both arrays together by distance ascending (scalar moves only)
    let a = 1
    while a < len(dists)
        let cd = dists[a] * 1.0
        let ci = idxs[a]
        let b = a - 1
        while b >= 0 and (dists[b] * 1.0) > cd
            dists[b + 1] = dists[b]
            idxs[b + 1] = idxs[b]
            b = b - 1
        dists[b + 1] = cd
        idxs[b + 1] = ci
        a = a + 1
    let out = []
    let m = k
    if m > len(idxs)
        m = len(idxs)
    let j = 0
    while j < m
        push(out, idxs[j])
        j = j + 1
    out

// Classify `query` by the majority label among its k nearest neighbors. `labels` are strings parallel to
// `points`. Ties are broken toward the label of the CLOSEST tied neighbor.
fn knn_classify(points: list, labels: list, query: list, k: int) -> string
    let idxs = knn_nearest(points, query, k)
    let counts = {}
    let i = 0
    while i < len(idxs)
        let lbl = str(labels[idxs[i]])
        let c = 0
        if contains(counts, lbl)
            c = counts[lbl]
        counts[lbl] = c + 1
        i = i + 1
    // pick max count; iterate neighbors closest-first so ties favor the nearer label
    let best_label = ""
    let best_count = 0
    let seen = {}
    let j = 0
    while j < len(idxs)
        let lbl = str(labels[idxs[j]])
        if contains(seen, lbl) == false
            seen[lbl] = 1
            let cnt = counts[lbl]
            if cnt > best_count
                best_count = cnt
                best_label = lbl
        j = j + 1
    best_label

// Predict a numeric value for `query` as the average of its k nearest neighbors' values (KNN regression).
fn knn_regress(points: list, values: list, query: list, k: int) -> float
    let idxs = knn_nearest(points, query, k)
    let sum = 0.0
    let i = 0
    while i < len(idxs)
        sum = sum + values[idxs[i]] * 1.0
        i = i + 1
    let avg = 0.0
    if len(idxs) > 0
        avg = sum / (len(idxs) * 1.0)
    avg
