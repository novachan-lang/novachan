// forge_multipart_parser — multipart form data parser simulation with Result API.

fn mp_new() -> dict
    {"part_count": 0, "total_size": 0}

fn mp_add_part(m: dict, name: string, content: string, content_type: string) -> dict
    let idx = m["part_count"]
    let ik = str(idx)
    m["p_{ik}_name"] = name
    m["p_{ik}_content"] = content
    m["p_{ik}_type"] = content_type
    m["p_{ik}_size"] = len(content)
    m["part_count"] = idx + 1
    m["total_size"] += len(content)
    m

fn mp_get_part(m: dict, name: string) -> Result
    for i in 0..m["part_count"]
        let ik = str(i)
        if m["p_{ik}_name"] == name
            return ok(m["p_{ik}_content"])
    err("part not found: {name}")

fn mp_content_type(m: dict, index: int) -> Result
    if index < 0 or index >= m["part_count"]
        return err("part index out of range")
    let ik = str(index)
    ok(m["p_{ik}_type"])

fn mp_part_size(m: dict, index: int) -> Result
    if index < 0 or index >= m["part_count"]
        return err("part index out of range")
    let ik = str(index)
    ok(m["p_{ik}_size"])

fn mp_part_count(m: dict) -> int
    m["part_count"]

fn mp_total_size(m: dict) -> int
    m["total_size"]
