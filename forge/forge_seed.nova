// forge_seed -- S16: database seeding / fixtures (Rails db/seeds, Django fixtures, Spring data.sql). Build
// parameterized INSERTs for a batch of fixture rows (dev/test data). Pure [sql, params] builders -- the
// caller runs each via orm_exec/pool_query. Injection-safe (values bound). LEAF -- imports NOTHING.

// INSERT [sql, params] for one fixture row (a {col: value} dict) into `table`.
fn seed_row_sql(table: string, row: dict) -> list
    let cols = []
    let phs = []
    let params = []
    for k in keys(row)
        push(cols, k)
        push(phs, "?")
        push(params, row[k])
    ["INSERT INTO " + table + " (" + join(cols, ", ") + ") VALUES (" + join(phs, ", ") + ")", params]

// The INSERTs for a list of fixture rows -> list of [sql, params].
fn seed_all_sql(table: string, rows: list) -> list
    let out = []
    let i = 0
    while i < len(rows)
        push(out, seed_row_sql(table, rows[i]))
        i = i + 1
    out
