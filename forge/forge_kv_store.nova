// forge_kv_store — key-value store with TTL and Result API.

fn kv_new() -> dict
    let s = {}
    s["data"] = {}
    s["ttls"] = {}
    s["count"] = 0
    s["hits"] = 0
    s["misses"] = 0
    s

fn kv_set(s: dict, key: string, value: string, ttl: int) -> dict
    s["data"]["k_" + key] = value
    s["ttls"]["t_" + key] = ttl
    s["count"] = s["count"] + 1
    s

fn kv_get(s: dict, key: string, now: int) -> Result
    let dk = "k_" + key
    let has = contains(s["data"], dk)
    if has != true
        s["misses"] = s["misses"] + 1
        return err("key not found: " + key)
    let tk = "t_" + key
    if s["ttls"][tk] > 0 and now > s["ttls"][tk]
        s["misses"] = s["misses"] + 1
        return err("key expired: " + key)
    s["hits"] = s["hits"] + 1
    ok(s["data"][dk])

fn kv_delete(s: dict, key: string) -> Result
    let dk = "k_" + key
    let has = contains(s["data"], dk)
    if has != true
        return err("key not found")
    s["data"][dk] = ""
    s["count"] = s["count"] - 1
    ok(s)

fn kv_count(s: dict) -> int
    s["count"]

fn kv_hit_rate(s: dict) -> int
    let total = s["hits"] + s["misses"]
    if total == 0
        return 0
    s["hits"] * 100 / total
