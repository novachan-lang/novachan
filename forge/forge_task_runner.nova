// forge_task_runner — Task dependency runner (make-like).
// DAG of tasks, dependency resolution, execution order.

fn tr_new() -> dict
    {"tasks": {}, "execution_log": []}

fn tr_add_task(runner: dict, name: string, deps: list) -> dict
    runner["tasks"][name] = {"deps": deps, "status": "pending"}
    runner

fn tr_is_ready(runner: dict, name: string) -> bool
    if name not in runner["tasks"]
        return false
    let deps = runner["tasks"][name]["deps"]
    for i in 0..len(deps)
        let dep = deps[i]
        if dep not in runner["tasks"]
            return false
        if runner["tasks"][dep]["status"] != "done"
            return false
    true

fn tr_run(runner: dict, name: string) -> dict
    if name not in runner["tasks"]
        return runner
    runner["tasks"][name]["status"] = "running"
    runner

fn tr_complete(runner: dict, name: string) -> dict
    if name not in runner["tasks"]
        return runner
    runner["tasks"][name]["status"] = "done"
    push(runner["execution_log"], name)
    runner

fn tr_fail(runner: dict, name: string) -> dict
    if name not in runner["tasks"]
        return runner
    runner["tasks"][name]["status"] = "failed"
    runner

fn tr_status(runner: dict, name: string) -> string
    if name not in runner["tasks"]
        return "unknown"
    runner["tasks"][name]["status"]

fn tr_ready_tasks(runner: dict) -> list
    let names = keys(runner["tasks"])
    [name for name in names if runner["tasks"][name]["status"] == "pending" and tr_is_ready(runner, name)]

fn tr_all_done(runner: dict) -> bool
    let names = keys(runner["tasks"])
    for i in 0..len(names)
        if runner["tasks"][names[i]]["status"] != "done"
            return false
    true

fn tr_execution_order(runner: dict) -> list
    runner["execution_log"]

fn tr_task_count(runner: dict) -> int
    len(keys(runner["tasks"]))
