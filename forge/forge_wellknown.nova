// forge_wellknown -- /.well-known document builders: the standardized discovery endpoints that make a service
// interoperable. OIDC discovery (openid-configuration) lets any OIDC client auto-configure against your
// identity provider; OAuth 2.0 Authorization Server Metadata (RFC 8414) does the same for OAuth; security.txt
// (RFC 9116) advertises your security contact; and a JWKS wrapper packages already-encoded JWK dicts. Pure
// JSON/text assembly (uses json_stringify). LEAF -- imports NOTHING.

// OpenID Connect discovery document (served at /.well-known/openid-configuration). `issuer` is your base URL;
// the endpoint paths are appended to it. Advertises the S256 PKCE + code flow forge_oauth_pkce implements.
fn oidc_discovery(issuer: string) -> string
    let d = {}
    d["issuer"] = issuer
    d["authorization_endpoint"] = issuer + "/authorize"
    d["token_endpoint"] = issuer + "/token"
    d["userinfo_endpoint"] = issuer + "/userinfo"
    d["jwks_uri"] = issuer + "/.well-known/jwks.json"
    d["response_types_supported"] = ["code"]
    d["subject_types_supported"] = ["public"]
    d["id_token_signing_alg_values_supported"] = ["RS256", "ES256"]
    d["scopes_supported"] = ["openid", "profile", "email"]
    d["token_endpoint_auth_methods_supported"] = ["client_secret_basic", "none"]
    d["code_challenge_methods_supported"] = ["S256"]
    json_stringify(d)

// OAuth 2.0 Authorization Server Metadata (RFC 8414, /.well-known/oauth-authorization-server).
fn oauth_metadata(issuer: string) -> string
    let d = {}
    d["issuer"] = issuer
    d["authorization_endpoint"] = issuer + "/authorize"
    d["token_endpoint"] = issuer + "/token"
    d["response_types_supported"] = ["code"]
    d["grant_types_supported"] = ["authorization_code", "refresh_token"]
    d["code_challenge_methods_supported"] = ["S256"]
    json_stringify(d)

// Wrap a list of already-encoded JWK dicts (each {kty,kid,n,e,...}) into a JWKS document (/.well-known/jwks.json).
fn jwks(keys_list: list) -> string
    let d = {}
    d["keys"] = keys_list
    json_stringify(d)

// security.txt body (RFC 9116, served at /.well-known/security.txt). `contact` = a mailto:/https: URL;
// `expires` = an ISO-8601 timestamp. Advertises where to report vulnerabilities.
fn security_txt(contact: string, expires: string) -> string
    let nl = chr(10)
    "Contact: " + contact + nl + "Expires: " + expires + nl + "Preferred-Languages: en" + nl
