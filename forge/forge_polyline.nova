// forge_polyline -- Google's Encoded Polyline Algorithm: pack a list of (lat, lng) GPS coordinates into a short
// ASCII string, and unpack it back. A route with hundreds of points becomes a compact URL-safe token instead of
// a bulky JSON array -- this is the format the Google Maps / Directions / Roads APIs use, and what map libraries
// (Leaflet, Mapbox) decode to draw a path. Great for storing GPS tracks, sharing routes in a link, or shrinking
// a payload. It works by scaling each coordinate to 1e5 (5 decimal places, ~1 m precision), storing DELTAS from
// the previous point (so nearby points cost few bytes), zig-zag encoding the signed delta, and emitting 5-bit
// chunks offset by 63 into printable ASCII. Round-trips to ~1e-5 precision. LEAF -- imports NOTHING.

// PRIVATE: encode one signed scaled integer (a coordinate delta) to the polyline chunk string.
fn _poly_enc(v: int) -> string
    // zig-zag: map signed -> non-negative (v<<1, invert bits if negative). ~x == -x-1 in two's complement.
    let sv = v << 1
    if v < 0
        sv = -sv - 1
    let s = ""
    let done = false
    while done == false
        if sv >= 32
            s = s + chr((32 + (sv & 31)) + 63)
            sv = sv / 32
        else
            s = s + chr(sv + 63)
            done = true
    s

// PRIVATE: decode one value starting at index `idx`; returns [signed_delta, next_index].
fn _poly_dec(s: string, idx: int) -> list
    let shift = 0
    let result = 0
    let i = idx
    let done = false
    while done == false
        let b = ord(char_at(s, i)) - 63
        i = i + 1
        result = result + ((b & 31) << shift)
        shift = shift + 5
        if b < 32
            done = true
    // zig-zag decode
    let d = result / 2
    if (result & 1) == 1
        d = -d - 1
    [d, i]

// Encode a list of [lat, lng] float pairs into an encoded-polyline string.
fn polyline_encode(points: list) -> string
    let s = ""
    let plat = 0
    let plng = 0
    let i = 0
    while i < len(points)
        let lat = round(points[i][0] * 100000.0)
        let lng = round(points[i][1] * 100000.0)
        s = s + _poly_enc(lat - plat)
        s = s + _poly_enc(lng - plng)
        plat = lat
        plng = lng
        i = i + 1
    s

// Decode an encoded-polyline string back into a list of [lat, lng] float pairs.
fn polyline_decode(s: string) -> list
    let pts = []
    let idx = 0
    let lat = 0
    let lng = 0
    let n = len(s)
    while idx < n
        let rlat = _poly_dec(s, idx)
        lat = lat + rlat[0]
        idx = rlat[1]
        let rlng = _poly_dec(s, idx)
        lng = lng + rlng[0]
        idx = rlng[1]
        push(pts, [(lat * 1.0) / 100000.0, (lng * 1.0) / 100000.0])
    pts
