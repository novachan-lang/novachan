// forge_blue_green_deploy — blue/green deployment switching with Result API.

fn bg_new() -> dict
    let b = {}
    b["active"] = "blue"
    b["blue_ver"] = ""
    b["green_ver"] = ""
    b["switches"] = 0
    b["deploy_count"] = 0
    b

fn bg_deploy(b: dict, slot: string, version: string) -> Result
    if slot != "blue"
        if slot != "green"
            return err("slot must be blue or green")
    b[slot + "_ver"] = version
    b["deploy_count"] = b["deploy_count"] + 1
    ok(b)

fn bg_switch(b: dict) -> dict
    if b["active"] == "blue"
        b["active"] = "green"
    else
        b["active"] = "blue"
    b["switches"] = b["switches"] + 1
    b

fn bg_active_slot(b: dict) -> string
    b["active"]

fn bg_active_version(b: dict) -> Result
    let ver = b[b["active"] + "_ver"]
    if ver == ""
        return err("no version deployed to active slot")
    ok(ver)

fn bg_inactive_slot(b: dict) -> string
    if b["active"] == "blue"
        return "green"
    "blue"

fn bg_inactive_version(b: dict) -> Result
    let slot = bg_inactive_slot(b)
    let ver = b[slot + "_ver"]
    if ver == ""
        return err("no version deployed to inactive slot")
    ok(ver)

fn bg_switch_count(b: dict) -> int
    b["switches"]

fn bg_deploy_count(b: dict) -> int
    b["deploy_count"]
