// forge_radix -- ONE positional-radix codec, shared by every base-N integer module.
//
// forge_base36, forge_base58 and forge_base62 each carried their own byte-for-byte copy of the same
// two loops, differing only in the alphabet, the radix, and what zero renders as. Three copies of one
// rule is three places for it to drift -- and they had already drifted in the same direction, each
// building its output by PREPENDING (`out = char + out`), which is quadratic: every symbol allocates a
// new string and recopies everything emitted so far.
//
// One implementation here; each base-N module keeps its public names as thin adapters. Callers are
// unaffected. LEAF -- imports NOTHING.

// Encode a non-negative integer in `alpha`. The radix is len(alpha), so a module supplies only its
// alphabet.
//
// `zero` is a parameter rather than a constant because the family genuinely disagrees: base58 renders
// zero as "1" (Bitcoin's leading-zero symbol) while base36 and base62 render it as "0". Folding that
// into the shared function would have silently changed base58's output.
//
// Digits are PUSHED least-significant-first and reversed once, instead of prepended per symbol.
fn radix_encode(n: int, alpha: string, zero: string) -> string
    if n <= 0
        return zero
    let base = len(alpha)
    let digits = []
    let v = n
    // The `while` stays: the loop runs until the value is exhausted, so the count is not known up front.
    while v > 0
        push(digits, char_at(alpha, v % base))
        v = v / base
    join(reverse(digits), "")

// Decode `s` in `alpha`, KEEPING the reason on failure.
//
// The bare *_decode entry points return 0 for a bad character -- which collides with the perfectly
// legitimate value 0, so a caller cannot tell "the code decodes to zero" from "the code is corrupt".
// That ambiguity is preserved for existing callers via unwrap_or; this is the form to use when the
// difference matters (validating a short link, a Bitcoin address, an id from a URL).
//
// `fold` is a per-character transform applied before lookup -- identity for case-sensitive alphabets,
// `lower` for base36, which is case-insensitive by definition.
fn radix_decode(s: string, alpha: string, fold) -> Result
    let base = len(alpha)
    let v = 0
    // Not a comprehension: this SHORT-CIRCUITS on the first bad character rather than scanning the
    // whole string, and it carries a running accumulator.
    for i in 0..len(s)
        let c = fold(char_at(s, i))
        let d = find(alpha, c)
        if d < 0
            return err("radix: '{c}' at index {i} is not in the alphabet")
        v = v * base + d
    ok(v)

// Case-sensitive decode -- the common case.
fn radix_decode_exact(s: string, alpha: string) -> Result
    radix_decode(s, alpha, (c) => c)
