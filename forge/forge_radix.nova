// forge_radix -- thin wrapper over std/math/radix (canonical implementation).
import std/math/radix

fn radix_encode(n: int, alpha: string, zero: string) -> string
    return rx_to_base(n, alpha, zero)

fn radix_decode(s: string, alpha: string, fold) -> Result
    return rx_from_base(s, alpha, fold)

fn radix_decode_exact(s: string, alpha: string) -> Result
    radix_decode(s, alpha, (c) => c)

