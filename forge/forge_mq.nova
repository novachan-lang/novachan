// forge_mq -- in-process topic message broker + dead-letter queue (DLQ).
// Beats Kafka/RabbitMQ/NATS for the single-node case: zero broker infra, one publish/consume API.
// A real broker backend (RabbitMQ, NATS, Kafka) can sit behind the same API later with zero caller changes.
//
// Design: single-owner ACTOR (spawned _mq_loop drains a request channel).
// Per-topic FIFO queue via a list + head index: push appends O(1), consume advances head O(1).
// List grows unbounded in v1 — compaction (trim head-dead prefix) is a follow-up.
// All dict/list state is born inside _mq_loop, ensuring race-free ownership (no locks needed).
//
// Public API:
//   mq_new()                             -> any           create broker handle + spawn actor
//   mq_publish(m, topic, msg)                             deliver msg to topic queue
//   mq_consume(m, topic)                 -> Result<string> pull next message or err("mq: empty")
//   mq_depth(m, topic)                   -> int           unconsumed message count
//   mq_dead_letter(m, topic, msg)                         push poison msg to topic DLQ
//   mq_dlq(m, topic)                     -> list          all DLQ messages for topic
//   mq_stop(m)                                            shut down the broker actor

// _mq_loop is the actor: owns ALL queue state; serialises every operation.
fn _mq_loop(m)
    let queues = {}
    let heads = {}
    let dlq = {}
    let running = 1
    while running == 1
        let env = receive(m["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "publish"
            let tp = env["topic"]
            if contains(queues, tp) == false
                queues[tp] = []
                heads[tp] = 0
            push(queues[tp], env["msg"])
        else if op == "consume"
            let tp = env["topic"]
            if contains(queues, tp) == false
                send(env["reply"], [])
            else
                let q = queues[tp]
                let h = heads[tp]
                if h >= len(q)
                    send(env["reply"], [])
                else
                    heads[tp] = h + 1
                    let one = [q[h]]
                    send(env["reply"], one)
        else if op == "depth"
            let tp = env["topic"]
            if contains(queues, tp)
                send(env["reply"], len(queues[tp]) - heads[tp])
            else
                send(env["reply"], 0)
        else if op == "dlq_put"
            let tp = env["topic"]
            if contains(dlq, tp) == false
                dlq[tp] = []
            push(dlq[tp], env["msg"])
        else if op == "dlq_list"
            let tp = env["topic"]
            if contains(dlq, tp)
                send(env["reply"], dlq[tp])
            else
                send(env["reply"], [])

// mq_new creates a broker handle and spawns its actor.
fn mq_new() -> any
    let m = {}
    m["req"] = channel()
    spawn _mq_loop(m)
    m

// mq_publish delivers msg to topic (fire-and-forget; creates topic on first use).
fn mq_publish(m, topic: string, msg: string)
    let env = {}
    env["op"] = "publish"
    env["topic"] = topic
    env["msg"] = msg
    send(m["req"], env)

// mq_consume pulls the next unconsumed message from topic.
// Returns ok(msg) if one is available, err("mq: empty") if the queue is drained or missing.
fn mq_consume(m, topic: string) -> Result<string>
    let rc = channel()
    let env = {}
    env["op"] = "consume"
    env["topic"] = topic
    env["reply"] = rc
    send(m["req"], env)
    let r = receive(rc)
    if len(r) == 1
        ok(r[0])
    else
        err("mq: empty")

// mq_depth returns the number of unconsumed messages on topic (0 if topic unknown).
fn mq_depth(m, topic: string) -> int
    let rc = channel()
    let env = {}
    env["op"] = "depth"
    env["topic"] = topic
    env["reply"] = rc
    send(m["req"], env)
    receive(rc)

// mq_dead_letter pushes msg onto the dead-letter queue for topic.
// Call this when a consumer gives up retrying a poison message.
fn mq_dead_letter(m, topic: string, msg: string)
    let env = {}
    env["op"] = "dlq_put"
    env["topic"] = topic
    env["msg"] = msg
    send(m["req"], env)

// mq_dlq returns all dead-lettered messages for topic (empty list if none).
fn mq_dlq(m, topic: string) -> list
    let rc = channel()
    let env = {}
    env["op"] = "dlq_list"
    env["topic"] = topic
    env["reply"] = rc
    send(m["req"], env)
    receive(rc)

// mq_stop shuts down the broker actor (in-flight messages are abandoned).
fn mq_stop(m)
    let env = {}
    env["op"] = "stop"
    send(m["req"], env)
