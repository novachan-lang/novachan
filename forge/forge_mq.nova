// forge_mq -- an in-process message broker: NAMED queues with work-sharing (each message is delivered to
// exactly ONE consumer, vs forge.hub() which broadcasts to ALL). This is the "background jobs / task
// queue" substrate -- the thing apps reach for RabbitMQ/Sidekiq to do. The broker is a single-owner ACTOR
// (a spawned loop draining a request channel) -> race-free queue registry, no locks. Queues are bounded
// channels (natural backpressure + buffering so a publish doesn't block before a consumer exists).
//
// v1 = named FIFO queues + work-sharing + a DEAD-LETTER queue (poison-message sink). A dead-letter queue
// is just another named queue by convention (name + "._dlq"), drained like any other -- exactly how real
// brokers model it. Follow-ons (design, not yet built): explicit ack/nack + redelivery on consumer crash,
// topic->queue routing, and disk persistence for durability.

fn _mq_loop(req)
    let queues = {}
    let running = 1
    while running == 1
        let env = receive(req)
        let op = env["op"]
        if op == "stop"
            running = 0
        else
            // "queue": ensure the named queue exists, reply with its (shared) channel handle
            let nm = env["q"]
            if contains(queues, nm) == false
                queues[nm] = channel_bounded(1024)
            send(env["reply"], queues[nm])

// Create a broker (spawns its actor). Use mq_publish / mq_consumer against the returned handle.
fn mq_broker() -> any
    let b = {}
    b["req"] = channel()
    spawn _mq_loop(b["req"])
    b

// Look up (or create) a queue's channel via the broker. Internal -- callers use publish/consumer.
fn _mq_queue(b, name)
    let rc = channel()
    let env = {}
    env["op"] = "queue"
    env["q"] = name
    env["reply"] = rc
    send(b["req"], env)
    receive(rc)

// Publish a message onto a named queue (creates the queue on first use).
fn mq_publish(b, name, msg) -> int
    send(_mq_queue(b, name), msg)
    0

// Get a consumer handle for a named queue. Multiple consumers on the same queue SHARE the work: each
// message goes to exactly one of them (channel semantics). Pull messages with mq_pull (blocks/parks until
// one is available).
fn mq_consumer(b, name) -> any
    _mq_queue(b, name)

fn mq_pull(consumer) -> any
    receive(consumer)

// ── Dead-letter queue (poison-message sink) ─────────────────────────────────────────────────────────
// The DLQ for queue `name` is the conventional queue `name + "._dlq"`. When a consumer decides a message
// is unprocessable (bad payload, exceeded retries), it dead-letters it here instead of dropping it, so an
// operator can inspect/replay poison messages. Drained with mq_pull on the dlq consumer, like any queue.
fn _mq_dlq_name(name) -> string
    name + "._dlq"

// Route a poison message to queue `name`'s dead-letter queue.
fn mq_dead_letter(b, name, msg) -> int
    mq_publish(b, _mq_dlq_name(name), msg)

// A consumer handle for queue `name`'s dead-letter queue (pull dead messages with mq_pull).
fn mq_dlq_consumer(b, name) -> any
    mq_consumer(b, _mq_dlq_name(name))

// Stop the broker's actor (queues are abandoned; in-flight messages are dropped).
fn mq_stop(b) -> int
    let env = {}
    env["op"] = "stop"
    env["q"] = ""
    env["reply"] = b["req"]
    send(b["req"], env)
    0

// -- D5.1: typed publish/consume (one API surface; JSON on the wire) ------------------------------------
// Publish a struct/dict/scalar and consume it back, JSON-encoded across the queue. The struct IS the
// message (json_stringify rides the RTTI keystone) -- no schema file. A real broker codec (NATS/Kafka)
// swaps behind these same two calls later; the channel broker is the in-memory backend.
fn mq_publish_typed(b, name, value) -> int
    mq_publish(b, name, json_stringify(value))

// Pull the next message from a consumer handle and JSON-decode it (-> dict for a struct/object payload).
fn mq_consume_typed(consumer) -> any
    json_decode(mq_pull(consumer))
