// forge_bimatch -- maximum bipartite matching: pair up as MANY items as possible across two groups when only
// certain pairings are allowed, with each item used at most once. Think assigning workers to jobs each is qualified
// for, students to projects they picked, time slots to meetings, or taxis to nearby riders -- you want the most
// simultaneous valid pairings. Unlike the Hungarian algorithm (forge_hungarian), which minimizes a COST over a
// full assignment, this maximizes the COUNT of pairings when edges are simply allowed-or-not (unweighted). It uses
// Kuhn's algorithm: for each left item, search for an "augmenting path" that reshuffles existing pairings to free
// up a partner, growing the matching by one each time it succeeds. By Konig's theorem the size of the maximum
// matching also equals the minimum vertex cover of a bipartite graph, and a perfect matching exists iff Hall's
// condition holds -- so this one routine answers those classic questions too. Edges are [left, right] index pairs.
// LEAF -- imports NOTHING.

// PRIVATE: try to find an augmenting path from left vertex u, updating match_right in place.
fn _bm_try(u: int, adj: list, match_right: list, visited: list) -> int
    let out = 0
    let nbrs = adj[u]
    let i = 0
    while i < len(nbrs) and out == 0
        let v = nbrs[i]
        if visited[v] == 0
            visited[v] = 1
            if match_right[v] == 0 - 1 or _bm_try(match_right[v], adj, match_right, visited) == 1
                match_right[v] = u
                out = 1
        i += 1
    out

// Maximum matching between nl left vertices (0..nl-1) and nr right vertices (0..nr-1) given allowed [left,right]
// edges. Returns [count, match_right] where match_right[v] is the left vertex matched to right v (or -1).
fn max_bipartite_matching(nl: int, nr: int, edges: list) -> list
    // adjacency: left -> list of rights
    let adj = [[] for z in 0..nl]
    for e in 0..len(edges)
        let edge = edges[e]
        push(adj[edge[0]], edge[1])
    let match_right = [0 - 1 for r in 0..nr]
    let count = 0
    for u in 0..nl
        let visited = []
        let q = 0
        while q < nr
            push(visited, 0)
            q += 1
        if _bm_try(u, adj, match_right, visited) == 1
            count += 1
    [count, match_right]

// Just the size of the maximum matching (which also equals the minimum vertex cover, by Konig's theorem).
fn matching_size(nl: int, nr: int, edges: list) -> int
    let m = max_bipartite_matching(nl, nr, edges)
    m[0]
