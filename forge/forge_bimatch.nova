// forge_bimatch -- maximum bipartite matching via Kuhn's augmenting-path algorithm.
// Edges are [left, right] index pairs. LEAF -- imports NOTHING.

fn _bm_try(u: int, adj: list, match_right: list, visited: list) -> int
    let nbrs = adj[u]
    for i in 0..len(nbrs)
        let v = nbrs[i]
        if visited[v] == 0
            visited[v] = 1
            if match_right[v] == -1 or _bm_try(match_right[v], adj, match_right, visited) == 1
                match_right[v] = u
                return 1
    0

fn max_bipartite_matching(nl: int, nr: int, edges: list) -> list
    let adj = [[] for z in 0..nl]
    for edge in edges
        push(adj[edge[0]], edge[1])
    let match_right = [-1 for r in 0..nr]
    let count = 0
    for u in 0..nl
        let visited = [0 for _ in 0..nr]
        if _bm_try(u, adj, match_right, visited) == 1
            count += 1
    [count, match_right]

fn matching_size(nl: int, nr: int, edges: list) -> int
    let m = max_bipartite_matching(nl, nr, edges)
    m[0]
