// forge_query -- composable SQL query-fragment builder, written in HIGH-LEVEL NOVA (list comprehensions +
// join), so the query layer reads like the query instead of a StringBuilder. Beats Ecto's cryptic macros
// and JPA Criteria's verbosity. Emits PARAMETERIZED fragments ("field = ?") -- values are bound by the
// driver, never concatenated, so it's injection-safe by construction. LEAF module (only built-ins:
// join, len, str, push).

// SELECT <cols>. cols already a list of column expressions.
fn q_select(cols: list) -> string
    "SELECT " + join(cols, ", ")

// Qualify columns with a table alias -- q_qualify("u", ["id","name"]) -> ["u.id","u.name"].
// (List comprehension: the high-level, "simpler than Python" form.)
fn q_qualify(alias: string, cols: list) -> list
    [alias + "." + c for c in cols]

// "field = ?" equality conditions from field names -- q_eq_conds(["a","b"]) -> ["a = ?","b = ?"].
// Feed the result to q_where_all (WHERE) or q_set (UPDATE ... SET). (Comprehension.)
fn q_eq_conds(fields: list) -> list
    [f + " = ?" for f in fields]

// "field = ?" SET assignments for UPDATE -- q_set(["name","email"]) -> " SET name = ?, email = ?".
fn q_set(fields: list) -> string
    " SET " + join([f + " = ?" for f in fields], ", ")

// WHERE with all conditions AND-ed (empty -> no clause). conds is a list of condition strings.
fn q_where_all(conds: list) -> string
    if len(conds) == 0
        return ""
    " WHERE " + join(conds, " AND ")

// WHERE with conditions OR-ed (empty -> no clause).
fn q_where_any(conds: list) -> string
    if len(conds) == 0
        return ""
    " WHERE " + join(conds, " OR ")

fn q_order_by(cols: list) -> string
    if len(cols) == 0
        return ""
    " ORDER BY " + join(cols, ", ")

fn q_limit(n: int) -> string
    " LIMIT " + str(n)

fn _q_range(n: int) -> list
    let r = [i for i in 0..n]
    r

// "field IN (?, ?, ?)" for n bound values -- q_in("id", 3) -> "id IN (?, ?, ?)".
// (Comprehension builds the n placeholders; join stitches them.)
fn q_in(field: string, n: int) -> string
    field + " IN (" + join(["?" for x in _q_range(n)], ", ") + ")"

// Assemble a full SELECT: q_build(cols, "users u", conds, order_cols, limit).
//   q_build(q_qualify("u", ["id","name"]), "users u", q_eq_conds(["u.active"]), ["u.name"], 20)
//   -> "SELECT u.id, u.name FROM users u WHERE u.active = ? ORDER BY u.name LIMIT 20"
fn q_build(cols: list, from_tbl: string, conds: list, order: list, limit: int) -> string
    q_select(cols) + " FROM " + from_tbl + q_where_all(conds) + q_order_by(order) + q_limit(limit)
