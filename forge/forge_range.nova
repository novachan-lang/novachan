// forge_range -- HTTP Range requests (RFC 7233): 206 Partial Content for video/audio streaming (seek),
// resumable downloads, and paged blob reads. Parse a "Range: bytes=START-END" header against a resource
// length, compute the response window + the Content-Range header. Supports all three forms: "bytes=0-499"
// (explicit), "bytes=500-" (open-ended to EOF), "bytes=-500" (suffix / last N bytes). LEAF -- imports NOTHING.

// Parse a Range header value against `total` bytes. Returns [ok, start, end]; end is INCLUSIVE (RFC semantics).
// ok=false -> malformed or unsatisfiable (the caller replies 416). Only the first range of a multi-range list
// is returned (the common streaming case).
fn range_parse(header: string, total: int) -> list
    let prefix = "bytes="
    if not starts_with(header, prefix)
        return [false, 0, 0]
    let spec = slice(header, len(prefix), len(header))
    let comma = find(spec, ",")
    if comma >= 0
        spec = slice(spec, 0, comma)
    spec = trim(spec)
    let dash = find(spec, "-")
    if dash < 0
        return [false, 0, 0]
    let start_s = slice(spec, 0, dash)
    let end_s = slice(spec, dash + 1, len(spec))
    let start = 0
    let end = 0
    if len(start_s) == 0
        if len(end_s) == 0
            return [false, 0, 0]
        let n = parse_int(end_s)
        if n <= 0
            return [false, 0, 0]
        if n > total
            n = total
        start = total - n
        end = total - 1
    else
        start = parse_int(start_s)
        if len(end_s) == 0
            end = total - 1
        else
            end = parse_int(end_s)
    if start < 0 or start > end or start >= total
        return [false, 0, 0]
    if end >= total
        end = total - 1
    [true, start, end]

// Content-Range header value for a satisfied range: "bytes START-END/TOTAL".
fn range_content_range(start: int, end: int, total: int) -> string
    "bytes {start}-{end}/{total}"

// Content-Range for a 416 Range Not Satisfiable response: "bytes */TOTAL".
fn range_unsatisfiable(total: int) -> string
    "bytes */{total}"

// Number of bytes in a satisfied [start,end] inclusive range (the 206 Content-Length).
fn range_length(start: int, end: int) -> int
    end - start + 1
