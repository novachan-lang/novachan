// forge_scc -- strongly connected components of a directed graph: the maximal groups of nodes where every node
// can reach every other (i.e. mutually reachable cycles). This is the tool for CYCLE and dependency analysis:
// find circular imports in a module graph, detect deadlock cycles in a wait-for graph, collapse a package/build
// dependency graph into an ordering (each SCC is a unit; a graph with no cycles is one SCC per node), spot
// feedback loops in a state machine or citation network, and condense a graph for higher-level analysis. Uses
// Kosaraju's algorithm: one DFS to get finish order, then a DFS on the reversed graph in that order -- each tree
// is one component. Edges are [from, to] with string node ids; iterative DFS (no recursion-depth limit). LEAF.

// PRIVATE: distinct node ids in first-seen order.
fn _scc_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    let i = 0
    while i < len(edges)
        let u = edges[i][0]
        if contains(seen, u) == false
            seen[u] = 1
            push(nodes, u)
        let v = edges[i][1]
        if contains(seen, v) == false
            seen[v] = 1
            push(nodes, v)
        i = i + 1
    nodes

// PRIVATE: build adjacency dict (node -> out-neighbor list); reversed if `rev`.
fn _scc_adj(edges: list, nodes: list, rev: bool) -> dict
    let adj = {}
    let i = 0
    while i < len(nodes)
        adj[nodes[i]] = []
        i = i + 1
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        if rev
            push(adj[v], u)
        else
            push(adj[u], v)
        e = e + 1
    adj

// The strongly connected components as a list of node-id lists.
fn scc(edges: list) -> list
    let nodes = _scc_nodes(edges)
    let adj = _scc_adj(edges, nodes, false)
    let radj = _scc_adj(edges, nodes, true)
    // pass 1: finish order via iterative post-order DFS
    let visited = {}
    let order = []
    let ni = 0
    while ni < len(nodes)
        let start = nodes[ni]
        if contains(visited, start) == false
            let snode = []
            let sfin = []
            push(snode, start)
            push(sfin, 0)
            while len(snode) > 0
                let top = len(snode) - 1
                let v = snode[top]
                let f = sfin[top]
                pop(snode)
                pop(sfin)
                if f == 1
                    push(order, v)
                else
                    if contains(visited, v) == false
                        visited[v] = 1
                        push(snode, v)
                        push(sfin, 1)
                        let nb = adj[v]
                        let j = 0
                        while j < len(nb)
                            if contains(visited, nb[j]) == false
                                push(snode, nb[j])
                                push(sfin, 0)
                            j = j + 1
        ni = ni + 1
    // pass 2: DFS on reversed graph in reverse finish order
    let assigned = {}
    let comps = []
    let idx = len(order) - 1
    while idx >= 0
        let s = order[idx]
        if contains(assigned, s) == false
            let comp = []
            let st = []
            push(st, s)
            while len(st) > 0
                let top2 = len(st) - 1
                let v = st[top2]
                pop(st)
                if contains(assigned, v) == false
                    assigned[v] = 1
                    push(comp, v)
                    let nb = radj[v]
                    let j = 0
                    while j < len(nb)
                        if contains(assigned, nb[j]) == false
                            push(st, nb[j])
                        j = j + 1
            push(comps, comp)
        idx = idx - 1
    comps

// The number of strongly connected components.
fn scc_count(edges: list) -> int
    len(scc(edges))

// True if u and v are in the same strongly connected component (mutually reachable).
fn scc_same(edges: list, u, v) -> bool
    let comps = scc(edges)
    let out = false
    let i = 0
    while i < len(comps)
        let has_u = false
        let has_v = false
        let j = 0
        while j < len(comps[i])
            if comps[i][j] == u
                has_u = true
            if comps[i][j] == v
                has_v = true
            j = j + 1
        if has_u and has_v
            out = true
        i = i + 1
    out
