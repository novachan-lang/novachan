// forge_secret_manager — Secret/credential management.
// Versioned secrets, access control, rotation tracking.

fn sm_new() -> dict
    {"secrets": {}, "access_log": []}

fn sm_store(sm: dict, name: string, value: string) -> dict
    if name in sm["secrets"]
        sm["secrets"][name]["value"] = value
        sm["secrets"][name]["version"] += 1
    else
        sm["secrets"][name] = {"value": value, "version": 1, "rotated": false, "access_count": 0}
    sm

fn sm_get(sm: dict, name: string, accessor: string) -> string
    if name not in sm["secrets"]
        return ""
    sm["secrets"][name]["access_count"] += 1
    push(sm["access_log"], {"secret": name, "accessor": accessor})
    sm["secrets"][name]["value"]

fn sm_version(sm: dict, name: string) -> int
    if name not in sm["secrets"]
        return 0
    sm["secrets"][name]["version"]

fn sm_mark_rotated(sm: dict, name: string) -> dict
    if name in sm["secrets"]
        sm["secrets"][name]["rotated"] = true
    sm

fn sm_needs_rotation(sm: dict, name: string) -> bool
    if name not in sm["secrets"]
        return false
    not sm["secrets"][name]["rotated"]

fn sm_access_log(sm: dict) -> list
    sm["access_log"]

fn sm_list_secrets(sm: dict) -> list
    keys(sm["secrets"])

fn sm_secret_count(sm: dict) -> int
    len(keys(sm["secrets"]))
