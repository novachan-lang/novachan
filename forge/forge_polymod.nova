// forge_polymod -- polynomial arithmetic over the prime field GF(p): add, multiply, divide-with-remainder, and take
// GCDs of polynomials whose coefficients are integers modulo a prime. Working "mod p" is what makes polynomial
// algebra EXACT and finite -- no fractions, no floating-point drift, no coefficient blow-up -- which is exactly why
// it sits underneath so much real machinery: Reed-Solomon and BCH error-correction, Shamir secret sharing and its
// verifiable variants, the number-theoretic transform (fast convolution), cyclic redundancy and CRC over GF(2),
// building and searching finite fields GF(p^k), and computer-algebra factoring. Polynomials are coefficient lists
// in ASCENDING degree order (p[0] is the constant term, p[i] the coefficient of x^i). pm_divmod performs true
// polynomial long division (inverting the divisor's leading coefficient in the field), returning quotient and
// remainder with deg(remainder) < deg(divisor); pm_gcd runs the Euclidean algorithm and returns a MONIC gcd
// (leading coefficient 1). The modulus must be prime (so every nonzero coefficient is invertible) and small enough
// that coefficient products stay in signed 64-bit. Pairs with forge_shamir / forge_modarith / forge_gf256. LEAF.

// PRIVATE: modular exponentiation.
fn _pm_modexp(base: int, exp: int, m: int) -> int
    let result = 1
    let b = ((base % m) + m) % m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = (result * b) % m
        b = (b * b) % m
        e = e / 2
    result

// PRIVATE: modular inverse mod the prime p (Fermat).
fn _pm_modinv(a: int, p: int) -> int
    _pm_modexp(((a % p) + p) % p, p - 2, p)

// The degree of a polynomial: the index of its highest nonzero coefficient, or -1 for the zero polynomial.
fn pm_degree(a: list, prime: int) -> int
    let d = 0 - 1
    let i = 0
    while i < len(a)
        if (((a[i] % prime) + prime) % prime) != 0
            d = i
        i = i + 1
    d

// Reduce all coefficients into [0, prime) and strip high-degree zeros (keeping at least a single 0 for the zero
// polynomial). Returns a canonical form.
fn pm_normalize(a: list, prime: int) -> list
    let d = pm_degree(a, prime)
    let out = []
    if d < 0
        push(out, 0)
    else
        let i = 0
        while i <= d
            push(out, ((a[i] % prime) + prime) % prime)
            i = i + 1
    out

// Sum of two polynomials mod prime.
fn pm_add(a: list, b: list, prime: int) -> list
    let n = len(a)
    if len(b) > n
        n = len(b)
    let out = []
    let i = 0
    while i < n
        let av = 0
        if i < len(a)
            av = a[i]
        let bv = 0
        if i < len(b)
            bv = b[i]
        push(out, (((av + bv) % prime) + prime) % prime)
        i = i + 1
    pm_normalize(out, prime)

// Difference a - b mod prime.
fn pm_sub(a: list, b: list, prime: int) -> list
    let n = len(a)
    if len(b) > n
        n = len(b)
    let out = []
    let i = 0
    while i < n
        let av = 0
        if i < len(a)
            av = a[i]
        let bv = 0
        if i < len(b)
            bv = b[i]
        push(out, (((av - bv) % prime) + prime) % prime)
        i = i + 1
    pm_normalize(out, prime)

// Product of two polynomials mod prime (schoolbook convolution).
fn pm_mul(a: list, b: list, prime: int) -> list
    let out = []
    if len(a) == 0 or len(b) == 0
        push(out, 0)
    else
        let n = len(a) + len(b) - 1
        let z = 0
        while z < n
            push(out, 0)
            z = z + 1
        let i = 0
        while i < len(a)
            let ai = ((a[i] % prime) + prime) % prime
            if ai != 0
                let j = 0
                while j < len(b)
                    out[i + j] = (out[i + j] + ai * (((b[j] % prime) + prime) % prime)) % prime
                    j = j + 1
            i = i + 1
    pm_normalize(out, prime)

// Evaluate a polynomial at x mod prime (Horner from the highest degree).
fn pm_eval(a: list, x: int, prime: int) -> int
    let y = 0
    let i = len(a) - 1
    let xr = ((x % prime) + prime) % prime
    while i >= 0
        y = (y * xr + (((a[i] % prime) + prime) % prime)) % prime
        i = i - 1
    y

// Divide a by b over GF(p): returns a list holding [quotient, remainder] (each a coefficient list) with
// deg(remainder) < deg(b). Requires b to be nonzero. Returns [[0],[0]] if b is the zero polynomial.
fn pm_divmod(a: list, b: list, prime: int) -> list
    let an = pm_normalize(a, prime)
    let bn = pm_normalize(b, prime)
    let dega = pm_degree(an, prime)
    let degb = pm_degree(bn, prime)
    let out = []
    if degb < 0
        push(out, [0])
        push(out, [0])
    else
        if dega < degb
            push(out, [0])
            push(out, an)
        else
            // quotient coefficients 0..(dega-degb); remainder = copy of an
            let quotient = []
            let z = 0
            while z <= dega - degb
                push(quotient, 0)
                z = z + 1
            let rem = []
            let r = 0
            while r < len(an)
                push(rem, an[r])
                r = r + 1
            let binv = _pm_modinv(bn[degb], prime)
            let i = dega - degb
            while i >= 0
                let coef = (rem[degb + i] * binv) % prime
                quotient[i] = coef
                if coef != 0
                    let j = 0
                    while j <= degb
                        rem[i + j] = (((rem[i + j] - coef * bn[j]) % prime) + prime) % prime
                        j = j + 1
                i = i - 1
            push(out, pm_normalize(quotient, prime))
            push(out, pm_normalize(rem, prime))
    out

// The MONIC greatest common divisor of a and b over GF(p), via the Euclidean algorithm. gcd of two zero
// polynomials is [0].
fn pm_gcd(a: list, b: list, prime: int) -> list
    let x = pm_normalize(a, prime)
    let y = pm_normalize(b, prime)
    while pm_degree(y, prime) >= 0
        let dm = pm_divmod(x, y, prime)
        x = y
        y = dm[1]
    // make x monic
    let out = x
    let d = pm_degree(x, prime)
    if d >= 0
        let lead = x[d]
        if lead != 1
            let inv = _pm_modinv(lead, prime)
            let mon = []
            let i = 0
            while i < len(x)
                push(mon, (x[i] * inv) % prime)
                i = i + 1
            out = pm_normalize(mon, prime)
    out

// True if two polynomials are equal mod prime (after normalization).
fn pm_equal(a: list, b: list, prime: int) -> bool
    let an = pm_normalize(a, prime)
    let bn = pm_normalize(b, prime)
    let out = len(an) == len(bn)
    if out
        let i = 0
        while i < len(an)
            if an[i] != bn[i]
                out = false
            i = i + 1
    out
