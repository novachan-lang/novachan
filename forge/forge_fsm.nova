// forge_fsm -- a finite STATE MACHINE for workflow/entity lifecycles (Spring StateMachine, Ruby AASM, XState).
// Model an order (pending->paid->shipped->delivered) or any entity whose valid transitions must be ENFORCED:
// declare the allowed (event, from -> to) transitions, then fire events; an illegal transition is rejected
// instead of silently corrupting state. Pure data (a dict) -- no async; put one machine per process if you
// want concurrency isolation. LEAF -- imports NOTHING.

fn fsm_new(initial: string) -> dict
    let m = {}
    m["state"] = initial
    m["transitions"] = {}
    m

// Declare: on `event` while in `from_state`, move to `to_state`. Fluent (chain many).
fn fsm_add(m: dict, event: string, from_state: string, to_state: string) -> dict
    let t = m["transitions"]
    t[event + "|" + from_state] = to_state
    m

// Can `event` legally fire from the current state?
fn fsm_can(m: dict, event: string) -> bool
    contains(m["transitions"], event + "|" + m["state"])

// Fire `event`: if the transition is declared, move and return true; otherwise stay put and return false
// (the caller can surface a 409 / validation error). State is never corrupted by an unknown event.
fn fsm_fire(m: dict, event: string) -> bool
    let key = event + "|" + m["state"]
    let t = m["transitions"]
    if key in t == false
        return false
    m["state"] = t[key]
    true

fn fsm_state(m: dict) -> string
    m["state"]

// Every event firable from the current state (build a UI of available actions / validate an allowed set).
fn fsm_events(m: dict) -> list
    let out = []
    let t = m["transitions"]
    let cur = m["state"]
    let ks = keys(t)
    for i in 0..len(ks)
        let k = ks[i]
        let bar = find(k, "|")
        if bar >= 0
            if slice(k, bar + 1, len(k)) == cur
                push(out, slice(k, 0, bar))
    out
