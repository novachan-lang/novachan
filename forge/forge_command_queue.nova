// forge_command_queue — CQRS command queue.
// Enqueue commands with priority, dequeue FIFO within priority, retry on failure.

fn cq_new() -> dict
    let cq = {}
    cq["queues"] = {}
    cq["processed"] = 0
    cq["failed"] = 0
    cq["retried"] = 0
    cq

fn cq_enqueue(cq: dict, cmd_type: string, payload: string, priority: int) -> dict
    let pkey = str(priority)
    let has = contains(cq["queues"], pkey)
    if has != true
        cq["queues"][pkey] = []
    let cmd = {}
    cmd["type"] = cmd_type
    cmd["payload"] = payload
    cmd["priority"] = priority
    cmd["retries"] = 0
    cmd["status"] = "pending"
    push(cq["queues"][pkey], cmd)
    cq

fn cq_dequeue(cq: dict, priority: int) -> dict
    let pkey = str(priority)
    let has = contains(cq["queues"], pkey)
    if has != true
        let empty = {}
        empty["type"] = ""
        empty["found"] = 0
        return empty
    let q = cq["queues"][pkey]
    if len(q) == 0
        let empty = {}
        empty["type"] = ""
        empty["found"] = 0
        return empty
    let cmd = q[0]
    let new_q = []
    let i = 1
    while i < len(q)
        push(new_q, q[i])
        i = i + 1
    cq["queues"][pkey] = new_q
    cmd["found"] = 1
    cmd

fn cq_mark_done(cq: dict) -> dict
    cq["processed"] = cq["processed"] + 1
    cq

fn cq_mark_failed(cq: dict) -> dict
    cq["failed"] = cq["failed"] + 1
    cq

fn cq_retry(cq: dict, cmd_type: string, payload: string, priority: int) -> dict
    cq["retried"] = cq["retried"] + 1
    cq = cq_enqueue(cq, cmd_type, payload, priority)
    cq

fn cq_pending_count(cq: dict, priority: int) -> int
    let pkey = str(priority)
    let has = contains(cq["queues"], pkey)
    if has != true
        return 0
    len(cq["queues"][pkey])

fn cq_total_pending(cq: dict) -> int
    let total = 0
    let pkeys = keys(cq["queues"])
    let i = 0
    while i < len(pkeys)
        total = total + len(cq["queues"][pkeys[i]])
        i = i + 1
    total

fn cq_processed(cq: dict) -> int
    cq["processed"]

fn cq_failed(cq: dict) -> int
    cq["failed"]

fn cq_retried(cq: dict) -> int
    cq["retried"]
