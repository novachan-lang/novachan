// forge_inbox_outbox — Transactional outbox pattern.
// Store outbound messages alongside business data, then relay.

fn io_new() -> dict
    {"outbox": [], "sent": 0, "failed": 0}

fn io_add(io: dict, msg_id: string, topic: string, payload: string) -> dict
    push(io["outbox"], {"id": msg_id, "topic": topic, "payload": payload, "status": "pending", "retries": 0})
    io

fn io_relay_next(io: dict) -> dict
    for i in 0..len(io["outbox"])
        if io["outbox"][i]["status"] == "pending"
            io["outbox"][i]["status"] = "sent"
            io["sent"] += 1
            return io
    io

fn io_relay_fail(io: dict, msg_id: string) -> dict
    for i in 0..len(io["outbox"])
        if io["outbox"][i]["id"] == msg_id
            io["outbox"][i]["status"] = "failed"
            io["outbox"][i]["retries"] += 1
            io["failed"] += 1
            return io
    io

fn io_retry_failed(io: dict) -> dict
    for i in 0..len(io["outbox"])
        if io["outbox"][i]["status"] == "failed"
            io["outbox"][i]["status"] = "pending"
    io

fn io_pending_count(io: dict) -> int
    let count = 0
    for i in 0..len(io["outbox"])
        if io["outbox"][i]["status"] == "pending"
            count += 1
    count

fn io_sent_count(io: dict) -> int
    io["sent"]

fn io_failed_count(io: dict) -> int
    io["failed"]

fn io_total_count(io: dict) -> int
    len(io["outbox"])

fn io_get(io: dict, msg_id: string) -> dict
    for i in 0..len(io["outbox"])
        if io["outbox"][i]["id"] == msg_id
            return io["outbox"][i]
    {"id": ""}
