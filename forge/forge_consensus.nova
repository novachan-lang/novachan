// forge_consensus — simple majority-vote consensus with Result API.

fn cons_new(node_count: int) -> dict
    {"node_count": node_count, "rounds": 0, "agreements": 0}

fn cons_propose(c: dict, proposal: string) -> dict
    let idx = c["rounds"]
    let rk = "r_{idx}"
    c["{rk}_proposal"] = proposal
    c["{rk}_yes"] = 0
    c["{rk}_no"] = 0
    c["{rk}_decided"] = 0
    c["rounds"] = idx + 1
    c

fn cons_vote(c: dict, round: int, approve: int) -> Result
    if round < 0 or round >= c["rounds"]
        return err("round out of range")
    let rk = "r_{round}"
    let yk = "{rk}_yes"
    let nk = "{rk}_no"
    let dk = "{rk}_decided"
    if approve == 1
        c[yk] += 1
    else
        c[nk] += 1
    let majority = c["node_count"] / 2 + 1
    if c[yk] >= majority
        if c[dk] == 0
            c[dk] = 1
            c["agreements"] += 1
    if c[nk] >= majority
        if c[dk] == 0
            c[dk] = 2
    ok(c)

fn cons_is_decided(c: dict, round: int) -> int
    if round < 0 or round >= c["rounds"]
        return 0
    if c["r_{round}_decided"] > 0
        return 1
    0

fn cons_result(c: dict, round: int) -> Result
    if round < 0 or round >= c["rounds"]
        return err("round out of range")
    let decided = c["r_{round}_decided"]
    if decided == 0
        return err("not yet decided")
    if decided == 1
        return ok("accepted")
    ok("rejected")

fn cons_proposal(c: dict, round: int) -> Result
    if round < 0 or round >= c["rounds"]
        return err("round out of range")
    ok(c["r_{round}_proposal"])

fn cons_round_count(c: dict) -> int
    c["rounds"]

fn cons_agreement_count(c: dict) -> int
    c["agreements"]
