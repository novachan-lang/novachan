// forge_consensus — simple majority-vote consensus with Result API.

fn cons_new(node_count: int) -> dict
    let c = {}
    c["node_count"] = node_count
    c["rounds"] = 0
    c["agreements"] = 0
    c

fn cons_propose(c: dict, proposal: string) -> dict
    let idx = c["rounds"]
    c["r_" + str(idx) + "_proposal"] = proposal
    c["r_" + str(idx) + "_yes"] = 0
    c["r_" + str(idx) + "_no"] = 0
    c["r_" + str(idx) + "_decided"] = 0
    c["rounds"] = idx + 1
    c

fn cons_vote(c: dict, round: int, approve: int) -> Result
    if round < 0 or round >= c["rounds"]
        return err("round out of range")
    if approve == 1
        c["r_" + str(round) + "_yes"] = c["r_" + str(round) + "_yes"] + 1
    else
        c["r_" + str(round) + "_no"] = c["r_" + str(round) + "_no"] + 1
    let total = c["r_" + str(round) + "_yes"] + c["r_" + str(round) + "_no"]
    let majority = c["node_count"] / 2 + 1
    if c["r_" + str(round) + "_yes"] >= majority
        if c["r_" + str(round) + "_decided"] == 0
            c["r_" + str(round) + "_decided"] = 1
            c["agreements"] = c["agreements"] + 1
    if c["r_" + str(round) + "_no"] >= majority
        if c["r_" + str(round) + "_decided"] == 0
            c["r_" + str(round) + "_decided"] = 2
    ok(c)

fn cons_is_decided(c: dict, round: int) -> int
    if round < 0 or round >= c["rounds"]
        return 0
    if c["r_" + str(round) + "_decided"] > 0
        return 1
    0

fn cons_result(c: dict, round: int) -> Result
    if round < 0 or round >= c["rounds"]
        return err("round out of range")
    let decided = c["r_" + str(round) + "_decided"]
    if decided == 0
        return err("not yet decided")
    if decided == 1
        return ok("accepted")
    ok("rejected")

fn cons_proposal(c: dict, round: int) -> Result
    if round < 0 or round >= c["rounds"]
        return err("round out of range")
    ok(c["r_" + str(round) + "_proposal"])

fn cons_round_count(c: dict) -> int
    c["rounds"]

fn cons_agreement_count(c: dict) -> int
    c["agreements"]
