// forge_data_lake — Data lake layer management with Result.

fn dl_new() -> dict
    {"layers": {}, "objects": {}, "obj_count": 0, "layer_count": 0}

fn dl_add_layer(d: dict, name: string, format: string) -> dict
    d["layers"][name] = format
    d["layer_count"] += 1
    d

fn dl_ingest(d: dict, layer: string, key: string, value: string) -> Result
    if layer not in d["layers"]
        return err("unknown layer: " + layer)
    let full_key = layer + "/" + key
    d["objects"][full_key] = value
    d["obj_count"] += 1
    ok(d)

fn dl_read(d: dict, layer: string, key: string) -> Result
    let full_key = layer + "/" + key
    if full_key not in d["objects"]
        return err("object not found: " + full_key)
    ok(d["objects"][full_key])

fn dl_layer_format(d: dict, layer: string) -> Result
    if layer not in d["layers"]
        return err("unknown layer: " + layer)
    ok(d["layers"][layer])

fn dl_object_count(d: dict) -> int
    d["obj_count"]

fn dl_layer_count(d: dict) -> int
    d["layer_count"]
