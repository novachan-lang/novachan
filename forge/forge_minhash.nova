// forge_minhash -- MinHash: estimate how SIMILAR two sets are (Jaccard similarity) from tiny fixed-size
// signatures, so you can find near-duplicates across a huge corpus WITHOUT comparing every pair in full.
// forge_cosine / forge_setsim give EXACT similarity but need the whole set each time (O(set) per compare,
// O(n^2) over a corpus); MinHash reduces each document to a short signature of N integers, and the fraction
// of signature slots that AGREE estimates the Jaccard similarity of the originals. This is how large-scale
// dedup, plagiarism/near-dup detection, "more like this", and clustering pipelines scale (the technique
// behind search-engine shingling and LSH). Signatures from different documents are DIRECTLY comparable
// because every signature uses the same deterministic family of hash functions. LEAF -- imports NOTHING.

// Mersenne prime modulus 2^31 - 1 (keeps a*x + b within i64 with no overflow: a,x < 2^31 => product < 2^62).
fn _mh_prime() -> int
    2147483647

// PRIVATE: FNV-1a 32-bit hash of a token string, reduced into [0, prime).
fn _mh_fnv(s: string) -> int
    let mask = 4294967295
    let h = 2166136261
    let i = 0
    while i < len(s)
        h = h ^ ord(char_at(s, i))
        h = (h * 16777619) & mask
        i = i + 1
    h % _mh_prime()

// PRIVATE: a splitmix-style integer mix, used to derive deterministic hash-function coefficients from an index.
fn _mh_mix(x: int) -> int
    let mask = 4294967295
    let z = (x + 2654435761) & mask
    z = ((z ^ (z / 65536)) * 2246822519) & mask
    z = ((z ^ (z / 8192)) * 3266489917) & mask
    z = z ^ (z / 32768)
    z & mask

// PRIVATE: build the [a_list, b_list] coefficient family for `n` hash functions h_i(x) = (a_i*x + b_i) mod p.
// Deterministic in i, so ANY two signatures of the same size use the identical functions and are comparable.
fn _mh_coeffs(n: int) -> list
    let p = _mh_prime()
    let a = []
    let b = []
    let i = 0
    while i < n
        let ai = _mh_mix(2 * i + 1) % p
        if ai == 0
            ai = 1
        push(a, ai)
        push(b, _mh_mix(2 * i + 2) % p)
        i = i + 1
    [a, b]

// Compute the MinHash signature of a token set: a list of `num_hashes` integers. Duplicate tokens don't
// matter (it's a SET). Larger num_hashes = more accurate estimate (error ~ 1/sqrt(num_hashes)).
fn minhash_signature(tokens: list, num_hashes: int) -> list
    let p = _mh_prime()
    let co = _mh_coeffs(num_hashes)
    let a = co[0]
    let b = co[1]
    let sig = []
    let j = 0
    while j < num_hashes
        push(sig, p)
        j = j + 1
    let t = 0
    while t < len(tokens)
        let x = _mh_fnv(str(tokens[t]))
        let i = 0
        while i < num_hashes
            let hv = (a[i] * x + b[i]) % p
            if hv < sig[i]
                sig[i] = hv
            i = i + 1
        t = t + 1
    sig

// Estimated Jaccard similarity in [0,1] from two signatures of equal length: the fraction of slots that match.
fn minhash_similarity(sig_a: list, sig_b: list) -> float
    let n = len(sig_a)
    if n == 0 or len(sig_b) != n
        return 0.0
    let matches = 0
    let i = 0
    while i < n
        if sig_a[i] == sig_b[i]
            matches = matches + 1
        i = i + 1
    (matches * 1.0) / (n * 1.0)

// Convenience: estimated Jaccard similarity of two token sets directly (signatures computed internally).
fn minhash_estimate(tokens_a: list, tokens_b: list, num_hashes: int) -> float
    let sa = minhash_signature(tokens_a, num_hashes)
    let sb = minhash_signature(tokens_b, num_hashes)
    minhash_similarity(sa, sb)
