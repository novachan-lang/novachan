// forge_minhash -- thin wrapper over std/sketch/minhash (canonical implementation).
import std/sketch/minhash

fn minhash_signature(tokens: list, num_hashes: int) -> list
    return mh_signature(tokens, num_hashes)

fn minhash_similarity(sig_a: list, sig_b: list) -> float
    return mh_similarity(sig_a, sig_b)

fn minhash_estimate(tokens_a: list, tokens_b: list, num_hashes: int) -> float
    let sa = minhash_signature(tokens_a, num_hashes)
    let sb = minhash_signature(tokens_b, num_hashes)
    minhash_similarity(sa, sb)

