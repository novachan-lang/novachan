// forge_distributed_counter — distributed counter with per-node tracking and Result API.

fn dc_new() -> dict
    let d = {}
    d["node_count"] = 0
    d["total_ops"] = 0
    d

fn dc_add_node(d: dict, node: string) -> dict
    d["dn_" + node + "_val"] = 0
    d["node_count"] = d["node_count"] + 1
    d

fn dc_increment(d: dict, node: string, amount: int) -> Result
    let nk = "dn_" + node + "_val"
    if contains(d, nk) != true
        return err("node not found: " + node)
    d[nk] = d[nk] + amount
    d["total_ops"] = d["total_ops"] + 1
    ok(d)

fn dc_node_value(d: dict, node: string) -> Result
    let nk = "dn_" + node + "_val"
    if contains(d, nk) != true
        return err("node not found: " + node)
    ok(d[nk])

fn dc_global_value(d: dict, nodes: string) -> int
    let total = 0
    let i = 0
    let start = 0
    while i <= len(nodes)
        let at_end = 0
        if i == len(nodes)
            at_end = 1
        else
            let ch = slice(nodes, i, i + 1)
            if ch == ","
                at_end = 1
        if at_end == 1
            let name = slice(nodes, start, i)
            let nk = "dn_" + name + "_val"
            if contains(d, nk) == true
                total = total + d[nk]
            start = i + 1
        i = i + 1
    total

fn dc_node_count(d: dict) -> int
    d["node_count"]

fn dc_total_ops(d: dict) -> int
    d["total_ops"]
