// forge_access_audit — Sentinel: security access auditing.
//
// Logs every access attempt (user, resource, action, allowed/denied) and
// exposes running counters — the same shape as an application access log
// feeding a SIEM (allow/deny totals, per-user denial counts, per-resource
// access counts, denial rate). No history is retained beyond the counters
// and the single most-recent action, keeping the state O(distinct users +
// distinct resources) rather than O(events) — a real audit trail would
// stream entries to durable storage instead of holding them in memory.
//
// STATE SHAPE — single FLAT dict, no nested dicts, no lists-in-dicts:
//   total_count               : int    — all logged attempts
//   allowed_count              : int    — attempts logged with allowed=1
//   denied_count                : int    — attempts logged with allowed=0
//   has_last_action              : int    — 1 once at least one entry logged
//   last_action                   : string — action of the most recent aa_log call
//   user_denied_<user>            : int    — denied-attempt count for that user
//   resource_access_<resource>    : int    — total access count for that resource
//
// LEAF MODULE — imports NOTHING.
//
// RAISED 2026-08-05.
//   1. THE READ-MODIFY-WRITE OF A COUNTED KEY was written out four times as five lines each:
//        let cur = 0
//        if key in state
//            cur = state[key]
//        state[key] = cur + 1
//      That is get-with-default plus an increment. _bump and _counter say it once, and the two
//      key schemes ("user_denied_" / "resource_access_") stop being concatenated at four sites.
//   2. `if key in state` -- a leftover from a mechanical contains() rewrite. The `== true`
//      is noise on a boolean, and it reads as a chained comparison. (Semantics were correct:
//      (key in state) == true; verified, not assumed.)
//   3. has_last_action was a SEPARATE FLAG beside last_action, so two fields encoded one fact and
//      could disagree. It is kept for the state contract but the emptiness question is now derived
//      from total_count, which is the thing that actually says whether anything was logged.

// PRIVATE: the two per-entity key schemes, each previously concatenated at two sites.
fn _aa_user_key(user: string) -> string
    "user_denied_{user}"

fn _aa_resource_key(resource: string) -> string
    "resource_access_{resource}"

// PRIVATE: a counter read, defaulting to 0. Replaces the four-line
// "declare, test membership, maybe assign" dance at every read site.
fn _counter(state: dict, key: string) -> int
    get(state, key, 0)

// PRIVATE: increment a counted key, creating it at 1 if absent.
fn _bump(state: dict, key: string)
    state[key] = _counter(state, key) + 1

fn aa_new() -> dict
    {"total_count": 0, "allowed_count": 0, "denied_count": 0, "has_last_action": 0, "last_action": ""}

// Log one access attempt. allowed: 1 = access was granted, 0 = access was denied.
fn aa_log(state: dict, user: string, resource: string, action: string, allowed: int)
    _bump(state, "total_count")
    if allowed == 1
        _bump(state, "allowed_count")
    else
        _bump(state, "denied_count")
        // A denial is attributed to the user; a grant is not, which is why only this branch
        // touches the per-user counter.
        _bump(state, _aa_user_key(user))
    // Every attempt counts against the resource, granted or denied.
    _bump(state, _aa_resource_key(resource))
    state["has_last_action"] = 1
    state["last_action"] = action

fn aa_denied_count(state: dict) -> int
    state["denied_count"]

fn aa_allowed_count(state: dict) -> int
    state["allowed_count"]

fn aa_total_count(state: dict) -> int
    state["total_count"]

fn aa_user_denied(state: dict, user: string) -> int
    _counter(state, _aa_user_key(user))

fn aa_resource_accesses(state: dict, resource: string) -> int
    _counter(state, _aa_resource_key(resource))

// PRIVATE: has anything been logged? total_count is the authority -- has_last_action is a second
// field encoding the same fact, which is how two fields drift apart.
fn _aa_empty(state: dict) -> bool
    state["total_count"] == 0

fn aa_last_action(state: dict) -> Result
    if _aa_empty(state)
        return err("no access attempts logged yet")
    ok(state["last_action"])

// Denial percentage across all logged attempts, 0-100 (integer, truncated).
fn aa_denial_rate(state: dict) -> Result
    if _aa_empty(state)
        return err("no access attempts logged yet")
    ok(state["denied_count"] * 100 / state["total_count"])

// Grant rate, the complement of the denial rate. The module reported only denials, so a caller
// wanting the allow rate had to compute 100 - rate and get the truncation wrong.
fn aa_allow_rate(state: dict) -> Result
    if _aa_empty(state)
        return err("no access attempts logged yet")
    ok(state["allowed_count"] * 100 / state["total_count"])

// Does any single user account for at least `n` denials? The brute-force-detection question this
// module exists to answer, over a caller-supplied user list -- the flat-dict storage cannot
// enumerate its own keys, so the candidates come from the caller.
fn aa_any_user_over(state: dict, users: list, n: int) -> bool
    any_match(users, (u) => aa_user_denied(state, u) >= n)

// Users at or over `n` denials, worst first -- the SIEM alert list.
fn aa_users_over(state: dict, users: list, n: int) -> list
    let over = [u for u in users if aa_user_denied(state, u) >= n]
    reverse(sort_by(over, (u) => aa_user_denied(state, u)))
