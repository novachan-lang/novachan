// forge_pulse — Pulse analytics framework (master plan F4).
// Higher-level analytics operations on top of std/data/dataframe.
// Provides: aggregation pipelines, rolling windows, cross-tabulation,
// describe (summary statistics), correlation matrix, and CSV I/O helpers.
//
// All operations are lazy where possible — they build descriptors that
// materialize on demand. This is the "data analysis in NOVA" story.
import std/data/dataframe

// ── Convenience accessors (thin wrappers over DataFrame struct / L8 index) ─────

fn df_col(df: DataFrame, col: string) -> list
    df[col]

fn df_nrows(df: DataFrame) -> int
    df.nrows

// ── Summary statistics ─────────────────────────────────────────────────────────

fn pulse_describe(df: DataFrame) -> dict
    let result = {}
    let cols = df.colnames
    let i = 0
    while i < len(cols)
        let col = df_col(df, cols[i])
        let stats = _pulse_col_stats(col)
        result[cols[i]] = stats
        i = i + 1
    result

fn _pulse_col_stats(col: list) -> dict
    let n = len(col)
    if n == 0
        return {"count": 0, "sum": 0, "mean": 0.0, "min": 0, "max": 0}
    let s = 0.0
    let mn = col[0]
    let mx = col[0]
    let i = 0
    while i < n
        let v = col[i] * 1.0
        s = s + v
        if col[i] < mn
            mn = col[i]
        if col[i] > mx
            mx = col[i]
        i = i + 1
    let mean = s / (n * 1.0)
    {"count": n, "sum": s, "mean": mean, "min": mn, "max": mx}

// ── Aggregation ────────────────────────────────────────────────────────────────

fn pulse_agg(df: DataFrame, group_col: string, agg_col: string, agg_fn: string) -> dict
    let groups = df_group_by(df, group_col)
    let result = {}
    let i = 0
    while i < len(groups)
        let g = groups[i]
        let gdf = g["rows"]
        let vals = df_col(gdf, agg_col)
        let agg_val = _pulse_apply_agg(vals, agg_fn)
        result[str(g["key"])] = agg_val
        i = i + 1
    result

fn _pulse_apply_agg(vals: list, agg_fn: string) -> any
    let n = len(vals)
    if n == 0
        return 0
    if agg_fn == "sum"
        let s = 0.0
        let i = 0
        while i < n
            s = s + vals[i] * 1.0
            i = i + 1
        return s
    if agg_fn == "mean"
        let s = 0.0
        let i = 0
        while i < n
            s = s + vals[i] * 1.0
            i = i + 1
        return s / (n * 1.0)
    if agg_fn == "count"
        return n
    if agg_fn == "min"
        let mn = vals[0]
        let i = 1
        while i < n
            if vals[i] < mn
                mn = vals[i]
            i = i + 1
        return mn
    if agg_fn == "max"
        let mx = vals[0]
        let i = 1
        while i < n
            if vals[i] > mx
                mx = vals[i]
            i = i + 1
        return mx
    0

// ── Rolling window ─────────────────────────────────────────────────────────────

fn pulse_rolling(df: DataFrame, col: string, window: int, agg_fn: string) -> list
    let vals = df_col(df, col)
    let n = len(vals)
    let out = []
    let i = 0
    while i < n
        let start = i - window + 1
        if start < 0
            start = 0
        let window_vals = []
        let j = start
        while j <= i
            push(window_vals, vals[j])
            j = j + 1
        push(out, _pulse_apply_agg(window_vals, agg_fn))
        i = i + 1
    out

// ── Cross-tabulation ───────────────────────────────────────────────────────────

fn pulse_crosstab(df: DataFrame, row_col: string, col_col: string) -> dict
    let row_vals = df_col(df, row_col)
    let col_vals = df_col(df, col_col)
    let n = len(row_vals)
    let table = {}
    let i = 0
    while i < n
        let rk = str(row_vals[i])
        let ck = str(col_vals[i])
        if not contains(table, rk)
            table[rk] = {}
        let row = table[rk]
        if contains(row, ck)
            row[ck] = row[ck] + 1
        else
            row[ck] = 1
        table[rk] = row
        i = i + 1
    table

// ── Correlation ────────────────────────────────────────────────────────────────

fn pulse_corr(df: DataFrame, col_a: string, col_b: string) -> any
    let a = df_col(df, col_a)
    let b = df_col(df, col_b)
    let n = len(a)
    if n < 2
        return 0.0
    let sum_a = 0.0
    let sum_b = 0.0
    let i = 0
    while i < n
        sum_a = sum_a + a[i] * 1.0
        sum_b = sum_b + b[i] * 1.0
        i = i + 1
    let mean_a = sum_a / (n * 1.0)
    let mean_b = sum_b / (n * 1.0)
    let cov = 0.0
    let var_a = 0.0
    let var_b = 0.0
    i = 0
    while i < n
        let da = a[i] * 1.0 - mean_a
        let db = b[i] * 1.0 - mean_b
        cov = cov + da * db
        var_a = var_a + da * da
        var_b = var_b + db * db
        i = i + 1
    if var_a < 0.0001 or var_b < 0.0001
        return 0.0
    let denom = var_a * var_b
    let r = cov / sqrt(denom)
    r

// ── CSV helper (quick load from string) ────────────────────────────────────────

fn pulse_from_csv(csv_text: string, delimiter: string) -> DataFrame
    let lines = split(csv_text, "\n")
    if len(lines) < 2
        return df_new([], [])
    let header = split(lines[0], delimiter)
    let cols = []
    let i = 0
    while i < len(header)
        push(cols, trim(header[i]))
        i = i + 1
    let rows = []
    let row_idx = 1
    while row_idx < len(lines)
        let line = trim(lines[row_idx])
        if len(line) == 0
            row_idx = row_idx + 1
            continue
        let fields = split(line, delimiter)
        let row_data = []
        i = 0
        while i < len(cols) and i < len(fields)
            let val = trim(fields[i])
            let as_num = parse_int(val)
            if str(as_num) == val
                push(row_data, as_num)
            else
                push(row_data, val)
            i = i + 1
        push(rows, row_data)
        row_idx = row_idx + 1
    df_new(cols, rows)
