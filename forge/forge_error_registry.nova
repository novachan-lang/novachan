// forge_error_registry — Typed error registry with codes and messages.

fn ereg_new() -> dict
    let e = {}
    e["codes"] = {}
    e["messages"] = {}
    e["severities"] = {}
    e["counts"] = {}
    e["total_errors"] = 0
    e

fn ereg_register(e: dict, code: string, message: string, severity: string) -> dict
    e["codes"][code] = 1
    e["messages"][code] = message
    e["severities"][code] = severity
    e["counts"][code] = 0
    e

fn ereg_raise(e: dict, code: string) -> dict
    let has = contains(e["codes"], code)
    if has != true
        return e
    e["counts"][code] = e["counts"][code] + 1
    e["total_errors"] = e["total_errors"] + 1
    e

fn ereg_message(e: dict, code: string) -> string
    let has = contains(e["messages"], code)
    if has != true
        return "unknown error"
    e["messages"][code]

fn ereg_severity(e: dict, code: string) -> string
    let has = contains(e["severities"], code)
    if has != true
        return "unknown"
    e["severities"][code]

fn ereg_count(e: dict, code: string) -> int
    let has = contains(e["counts"], code)
    if has != true
        return 0
    e["counts"][code]

fn ereg_total(e: dict) -> int
    e["total_errors"]

fn ereg_most_frequent(e: dict) -> string
    let ks = keys(e["counts"])
    if len(ks) == 0
        return ""
    let best = ks[0]
    let best_count = e["counts"][best]
    let i = 1
    while i < len(ks)
        if e["counts"][ks[i]] > best_count
            best_count = e["counts"][ks[i]]
            best = ks[i]
        i = i + 1
    best

fn ereg_is_critical(e: dict, code: string) -> int
    let sev = ereg_severity(e, code)
    if sev == "critical"
        return 1
    0
