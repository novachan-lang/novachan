// forge_error_registry — Typed error registry with codes and messages.

fn ereg_new() -> dict
    {"codes": {}, "messages": {}, "severities": {}, "counts": {}, "total_errors": 0}

fn ereg_register(e: dict, code: string, message: string, severity: string) -> dict
    e["codes"][code] = 1
    e["messages"][code] = message
    e["severities"][code] = severity
    e["counts"][code] = 0
    e

fn ereg_raise(e: dict, code: string) -> dict
    if code not in e["codes"]
        return e
    e["counts"][code] += 1
    e["total_errors"] += 1
    e

fn ereg_message(e: dict, code: string) -> string
    if code not in e["messages"]
        return "unknown error"
    e["messages"][code]

fn ereg_severity(e: dict, code: string) -> string
    if code not in e["severities"]
        return "unknown"
    e["severities"][code]

fn ereg_count(e: dict, code: string) -> int
    if code not in e["counts"]
        return 0
    e["counts"][code]

fn ereg_total(e: dict) -> int
    e["total_errors"]

fn ereg_most_frequent(e: dict) -> string
    let ks = keys(e["counts"])
    if len(ks) == 0
        return ""
    let best = ks[0]
    let best_count = e["counts"][best]
    for i in 1..len(ks)
        if e["counts"][ks[i]] > best_count
            best_count = e["counts"][ks[i]]
            best = ks[i]
    best

fn ereg_is_critical(e: dict, code: string) -> int
    1 if ereg_severity(e, code) == "critical" else 0
