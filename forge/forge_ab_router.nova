// forge_ab_router — A/B test routing with variant tracking.
//
// RAISED 2026-08-05. The variant was a bare string tested by if/else in three places, and
// ab_convert credited ANY string that was not "A" to B -- so ab_convert(a, "a") or a typo silently
// inflated B's conversions and skewed the experiment. The A and B paths were also written out
// separately in five functions, and five counters were incremented by hand.
//
// The variant is now an ENUM: a closed set of exactly two, so the compiler -- not a reader --
// guarantees every branch handles both, and a `match` that forgets one is a compile error (E1009).
// This shape did not compile until the variant/enum unification fix landed in nova_compiler.nova
// (a function returning two different variants of one enum failed to unify them, E1001); it is the
// first module in forge to use a typed ADT end to end.

// The variant. Exactly two, and the compiler enforces that every match covers both.
enum Variant
    VariantA()
    VariantB()

fn variant_name(v: Variant) -> string
    match v
        VariantA() => "A"
        VariantB() => "B"

// Every variant, so callers and reports never enumerate them by hand.
fn ab_variants() -> list
    [VariantA(), VariantB()]

// Parse a variant name, KEEPING the reason. "A"/"B" only -- the old permissive behaviour (anything
// not "A" counts as B) is precisely what let a typo corrupt an experiment.
fn variant_of(name: string) -> Result
    if name == "A"
        return ok(VariantA())
    if name == "B"
        return ok(VariantB())
    err("unknown variant '{name}' (expected A or B)")

fn ab_is_variant(name: string) -> bool
    is_ok(variant_of(name))

// PRIVATE: the state field each variant owns. One match per field instead of an A-path and a B-path
// in every operation.
fn _ab_count_key(v: Variant) -> string
    match v
        VariantA() => "a_count"
        VariantB() => "b_count"

fn _ab_conv_key(v: Variant) -> string
    match v
        VariantA() => "a_conversions"
        VariantB() => "b_conversions"

fn ab_new(variant_a_pct: int) -> dict
    {"a_pct": variant_a_pct, "a_count": 0, "b_count": 0, "a_conversions": 0, "b_conversions": 0}

// Which variant does `rand_pct` (0..99) fall into? The split rule, stated once.
fn ab_variant_for(a: dict, rand_pct: int) -> Variant
    VariantA() if rand_pct < a["a_pct"] else VariantB()

// Record an impression and return {variant, a}. Contract UNCHANGED -- the shape callers read.
fn ab_route(a: dict, rand_pct: int) -> dict
    let v = ab_variant_for(a, rand_pct)
    a[_ab_count_key(v)] += 1
    {"variant": variant_name(v), "a": a}

// Credit a conversion to `variant`.
// CONTRACT UNCHANGED, hole included: an unrecognised name is credited to B. That is a silent
// experiment-corrupting bug, but existing callers depend on the permissive behaviour, so it stays --
// now as an explicit fallback rather than as the accidental `else` of an if/else. New code should use
// ab_convert_checked.
fn ab_convert(a: dict, variant: string) -> dict
    let parsed = variant_of(variant)
    let v = unwrap(parsed) if is_ok(parsed) else VariantB()
    a[_ab_conv_key(v)] += 1
    a

// The STRICT door: an unknown variant name is an error, not a silent credit to B.
//     state = ab_convert_checked(state, name)?
fn ab_convert_checked(a: dict, variant: string) -> Result
    let v = variant_of(variant)?
    a[_ab_conv_key(v)] += 1
    ok(a)

// Conversion rate in whole percent, 0 when the variant has had no traffic. ONE rate function taking a
// variant; ab_a_rate and ab_b_rate each carried the same three lines.
fn ab_rate(a: dict, v: Variant) -> int
    let n = a[_ab_count_key(v)]
    0 if n == 0 else a[_ab_conv_key(v)] * 100 / n

fn ab_a_rate(a: dict) -> int
    ab_rate(a, VariantA())

fn ab_b_rate(a: dict) -> int
    ab_rate(a, VariantB())

fn ab_winner(a: dict) -> string
    let ra = ab_a_rate(a)
    let rb = ab_b_rate(a)
    if ra > rb
        return "A"
    "B" if rb > ra else "tie"

// Impressions summed over the variants rather than by naming both counters.
fn ab_total_traffic(a: dict) -> int
    sum([a[_ab_count_key(v)] for v in ab_variants()])

fn ab_count(a: dict, v: Variant) -> int
    a[_ab_count_key(v)]

fn ab_a_count(a: dict) -> int
    ab_count(a, VariantA())

fn ab_b_count(a: dict) -> int
    ab_count(a, VariantB())

// The whole experiment as data: {name: [impressions, conversions, rate_pct]}. A dict comprehension
// over the variants, so reporting never names A or B.
fn ab_report(a: dict) -> dict
    {variant_name(v): [ab_count(a, v), a[_ab_conv_key(v)], ab_rate(a, v)] for v in ab_variants()}
