// forge_ab_router — A/B test routing with variant tracking.

fn ab_new(variant_a_pct: int) -> dict
    let a = {}
    a["a_pct"] = variant_a_pct
    a["a_count"] = 0
    a["b_count"] = 0
    a["a_conversions"] = 0
    a["b_conversions"] = 0
    a

fn ab_route(a: dict, rand_pct: int) -> dict
    let result = {}
    if rand_pct < a["a_pct"]
        a["a_count"] = a["a_count"] + 1
        result["variant"] = "A"
    else
        a["b_count"] = a["b_count"] + 1
        result["variant"] = "B"
    result["a"] = a
    result

fn ab_convert(a: dict, variant: string) -> dict
    if variant == "A"
        a["a_conversions"] = a["a_conversions"] + 1
    else
        a["b_conversions"] = a["b_conversions"] + 1
    a

fn ab_a_rate(a: dict) -> int
    if a["a_count"] == 0
        return 0
    a["a_conversions"] * 100 / a["a_count"]

fn ab_b_rate(a: dict) -> int
    if a["b_count"] == 0
        return 0
    a["b_conversions"] * 100 / a["b_count"]

fn ab_winner(a: dict) -> string
    let ra = ab_a_rate(a)
    let rb = ab_b_rate(a)
    if ra > rb
        return "A"
    if rb > ra
        return "B"
    "tie"

fn ab_total_traffic(a: dict) -> int
    a["a_count"] + a["b_count"]

fn ab_a_count(a: dict) -> int
    a["a_count"]

fn ab_b_count(a: dict) -> int
    a["b_count"]
