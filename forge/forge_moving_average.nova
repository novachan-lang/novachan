// forge_moving_average — simple and exponential moving average with Result API.

fn sma_new(window: int) -> dict
    let m = {}
    m["window"] = window
    m["values"] = {}
    m["count"] = 0
    m["sum"] = 0
    m["head"] = 0
    m

fn sma_add(m: dict, value: int) -> dict
    if m["count"] >= m["window"]
        let old_key = "v_" + str(m["head"])
        m["sum"] = m["sum"] - m["values"][old_key]
        m["values"][old_key] = value
        m["sum"] = m["sum"] + value
        m["head"] = (m["head"] + 1) % m["window"]
    else
        let key = "v_" + str(m["count"])
        m["values"][key] = value
        m["sum"] = m["sum"] + value
        m["count"] = m["count"] + 1
    m

fn sma_average(m: dict) -> Result
    if m["count"] == 0
        return err("no data")
    ok(m["sum"] / m["count"])

fn sma_sum(m: dict) -> int
    m["sum"]

fn sma_count(m: dict) -> int
    m["count"]

fn sma_window(m: dict) -> int
    m["window"]

fn sma_is_full(m: dict) -> int
    if m["count"] >= m["window"]
        return 1
    0
