// forge_moving_average — simple and exponential moving average with Result API.

fn sma_new(window: int) -> dict
    {"window": window, "values": {}, "count": 0, "sum": 0, "head": 0}

fn sma_add(m: dict, value: int) -> dict
    if m["count"] >= m["window"]
        let head = m["head"]
        let old_key = "v_{head}"
        m["sum"] -= m["values"][old_key]
        m["values"][old_key] = value
        m["sum"] += value
        m["head"] = (m["head"] + 1) % m["window"]
    else
        let count = m["count"]
        let key = "v_{count}"
        m["values"][key] = value
        m["sum"] += value
        m["count"] += 1
    m

fn sma_average(m: dict) -> Result
    if m["count"] == 0
        return err("no data")
    ok(m["sum"] / m["count"])

fn sma_sum(m: dict) -> int
    m["sum"]

fn sma_count(m: dict) -> int
    m["count"]

fn sma_window(m: dict) -> int
    m["window"]

fn sma_is_full(m: dict) -> int
    1 if m["count"] >= m["window"] else 0
