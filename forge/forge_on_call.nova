fn oc_new()
    return {"schedule_count": 0, "schedule_names": "", "page_count": 0}

fn oc_add_schedule(s, schedule_name)
    let idx = int(s["schedule_count"])
    s["sched_{idx}_name"] = schedule_name
    s["sched_{idx}_primary"] = ""
    s["sched_{idx}_secondary"] = ""
    s["sched_{idx}_pages"] = 0
    s["schedule_count"] = idx + 1
    s["schedule_names"] = schedule_name if s["schedule_names"] == "" else str(s["schedule_names"]) + "," + schedule_name
    return s

fn _oc_find(s, schedule_name)
    let cnt = int(s["schedule_count"])
    for i in 0..cnt
        if str(s["sched_{i}_name"]) == schedule_name
            return i
    return -1

fn oc_set_primary(s, schedule_name, person) -> Result
    let si = _oc_find(s, schedule_name)
    if si < 0
        return err("schedule not found: {schedule_name}")
    s["sched_{si}_primary"] = person
    return ok(s)

fn oc_set_secondary(s, schedule_name, person) -> Result
    let si = _oc_find(s, schedule_name)
    if si < 0
        return err("schedule not found: {schedule_name}")
    s["sched_{si}_secondary"] = person
    return ok(s)

fn oc_primary(s, schedule_name) -> Result
    let si = _oc_find(s, schedule_name)
    if si < 0
        return err("schedule not found: {schedule_name}")
    let p = str(s["sched_{si}_primary"])
    if p == ""
        return err("no primary assigned")
    return ok(p)

fn oc_secondary(s, schedule_name) -> Result
    let si = _oc_find(s, schedule_name)
    if si < 0
        return err("schedule not found: {schedule_name}")
    let sec = str(s["sched_{si}_secondary"])
    if sec == ""
        return err("no secondary assigned")
    return ok(sec)

fn oc_page(s, schedule_name, severity, message) -> Result
    let si = _oc_find(s, schedule_name)
    if si < 0
        return err("schedule not found: {schedule_name}")
    let p = str(s["sched_{si}_primary"])
    if p == ""
        return err("no one on call")
    s["sched_{si}_pages"] = int(s["sched_{si}_pages"]) + 1
    s["page_count"] = int(s["page_count"]) + 1
    s["last_page_sched"] = schedule_name
    s["last_page_sev"] = severity
    s["last_page_msg"] = message
    return ok(s)

fn oc_page_count(s, schedule_name) -> Result
    let si = _oc_find(s, schedule_name)
    if si < 0
        return err("schedule not found: {schedule_name}")
    return ok(int(s["sched_{si}_pages"]))

fn oc_schedule_count(s)
    return int(s["schedule_count"])

fn oc_total_pages(s)
    return int(s["page_count"])

fn oc_schedule_list(s)
    return str(s["schedule_names"])

fn oc_has_schedule(s, schedule_name)
    let si = _oc_find(s, schedule_name)
    return 1 if si >= 0 else 0
