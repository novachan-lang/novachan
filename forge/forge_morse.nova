// forge_morse -- International Morse Code encode/decode. Letters and digits map to dot/dash strings; within a
// word letters are separated by a single space, and words by " / ". Useful for accessibility tooling, ham/CW
// radio, retro/教学 demos, and as a compact reversible text codec. Case-insensitive on encode. LEAF.

// PRIVATE: the Morse pattern for one uppercase letter/digit, or "" if unmapped.
fn _morse_for(c: string) -> string
    if c == "A"
        return ".-"
    if c == "B"
        return "-..."
    if c == "C"
        return "-.-."
    if c == "D"
        return "-.."
    if c == "E"
        return "."
    if c == "F"
        return "..-."
    if c == "G"
        return "--."
    if c == "H"
        return "...."
    if c == "I"
        return ".."
    if c == "J"
        return ".---"
    if c == "K"
        return "-.-"
    if c == "L"
        return ".-.."
    if c == "M"
        return "--"
    if c == "N"
        return "-."
    if c == "O"
        return "---"
    if c == "P"
        return ".--."
    if c == "Q"
        return "--.-"
    if c == "R"
        return ".-."
    if c == "S"
        return "..."
    if c == "T"
        return "-"
    if c == "U"
        return "..-"
    if c == "V"
        return "...-"
    if c == "W"
        return ".--"
    if c == "X"
        return "-..-"
    if c == "Y"
        return "-.--"
    if c == "Z"
        return "--.."
    if c == "0"
        return "-----"
    if c == "1"
        return ".----"
    if c == "2"
        return "..---"
    if c == "3"
        return "...--"
    if c == "4"
        return "....-"
    if c == "5"
        return "....."
    if c == "6"
        return "-...."
    if c == "7"
        return "--..."
    if c == "8"
        return "---.."
    if c == "9"
        return "----."
    ""

// Encode text to Morse: letters separated by " ", words by " / ". Unmapped characters are skipped; a space
// starts a new word.
fn morse_encode(text: string) -> string
    let up = upper(text)
    let out = ""
    let i = 0
    while i < len(up)
        let c = char_at(up, i)
        if c == " "
            out = out + " / "
        else
            let code = _morse_for(c)
            if len(code) > 0
                if len(out) > 0 and ends_with(out, " ") == false
                    out = out + " "
                out = out + code
        i = i + 1
    out

// PRIVATE: the letter/digit for a Morse pattern, or "" if unknown. Linear reverse lookup over A-Z 0-9.
fn _morse_rev(code: string) -> string
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    let i = 0
    while i < len(letters)
        let c = char_at(letters, i)
        if _morse_for(c) == code
            return c
        i = i + 1
    ""

// Decode a Morse string (letters separated by spaces, words by "/") back to uppercase text.
fn morse_decode(morse: string) -> string
    let words = split(morse, "/")
    let out = ""
    let w = 0
    while w < len(words)
        if w > 0
            out = out + " "
        let letters = split(trim(words[w]), " ")
        let i = 0
        while i < len(letters)
            let code = trim(letters[i])
            if len(code) > 0
                out = out + _morse_rev(code)
            i = i + 1
        w = w + 1
    out
