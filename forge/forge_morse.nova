// forge_morse -- thin wrapper over std/encoding/morse (canonical implementation).
import std/encoding/morse

fn _morse_fail_text(f) -> string
    match f
        UnknownSymbol(s) => "unknown Morse symbol '{s}'"
        BadSymbol(s) => "'{s}' is not dots and dashes"
        Unencodable(s) => "no Morse code for '{s}'"

// â”€â”€ the table â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// The ONE place the alphabet<->code correspondence is written. Pairs are adjacent, so a wrong code is
// visible on the line it is on -- unlike the old if-ladder, where the letter and its code were three
// lines apart, thirty-six times over.
//
// A function and not a module-level `let`: a module-level `let` holding a CONTAINER reads back EMPTY from
// inside a module (verified -- index yields 0, `keys()` yields [], `in` yields false, and a write to it is
// discarded). Only scalars and strings survive up there. Rebuilding costs 36 dict inserts per call, which
// is cheaper than what it replaces: the old ladder cost up to 36 string compares per character ENCODED
// and 36 whole ladder walks per symbol DECODED.

fn _morse_units(text: string) -> list
    let table = _morse_table()
    let up = upper(text)
    [_morse_classify(table, char_at(up, i)) for i in 0..len(up)]

// Render classified units. `need_sep` is EXACTLY the old `len(out) > 0 and ends_with(out, " ") == false`
// test, hoisted out of the accumulated string: a letter separator is due only after a symbol, never at
// the start and never straight after a word break. Carrying it as a flag lets the output be JOINED once
// instead of grown with `+=`, which was quadratic in the length of the message.

fn _morse_render(units: list) -> string
    let parts = []
    let need_sep = false
    for u in units
        match u
            WordBreak(b) =>
                push(parts, " / ")
                need_sep = false
            Symbol(code) =>
                if need_sep
                    push(parts, " ")
                push(parts, code)
                need_sep = true
            // An unmapped character contributes nothing AND does not break the letter run: "A@B"
            // encodes exactly as "AB" does. `need_sep` is deliberately left alone.
            Unmapped(c) => 0
    join(parts, "")

// Encode text to Morse: letters separated by " ", words by " / ". Unmapped characters are skipped; a
// space starts a new word. Read as the pipeline it is -- classify, then render.

fn _morse_unmapped(units: list) -> list
    let bad = []
    for u in units
        match u
            Unmapped(c) => push(bad, c)
            WordBreak(b) => 0
            Symbol(s) => 0
    bad

// Encode, REFUSING text that contains a character with no Morse code instead of dropping it silently:
//   ok("... --- ...")             every character encodable
//   err("no Morse code for '@'")  it was not -- and the message names every offending character
// Both entry points share `_morse_units`, so "which characters are encodable" is decided in one place.

fn _morse_walk(morse: string, on_unresolved) -> Result
    let rev = _morse_rev_table()
    let words = split(morse, "/")
    let out_parts = []
    for w, word in words
        if w > 0
            push(out_parts, " ")
        for sym in split(trim(word), " ")
            let code = trim(sym)
            if len(code) > 0
                let step = _morse_symbol(rev, code)
                if is_err(step)
                    step = on_unresolved(step)
                if is_err(step)
                    return step
                push(out_parts, unwrap(step))
    ok(join(out_parts, ""))

// Decode a Morse string back to uppercase text, KEEPING the reason on failure:
//   ok("SOS")                              every symbol resolved
//   err("unknown Morse symbol '......'")   the first symbol that did not, named
// The strict policy is the IDENTITY on the failed step -- propagate it as it stands.

fn morse_encode(text: string) -> string
    return mo_encode(text)

fn morse_encode_checked(text: string) -> Result
    let units = _morse_units(text)
    let bad = _morse_unmapped(units)
    if len(bad) > 0
        return err(_morse_fail_text(Unencodable(join(bad, ""))))
    ok(_morse_render(units))

// ── decode ───────────────────────────────────────────────────────────────────────────────────────────
// A symbol is well-formed iff every character is a dot or a dash. all_match states that rule once over
// every character instead of an early-return scan.

fn morse_decode_checked(morse: string) -> Result
    _morse_walk(morse, (bad) => bad)

// Decode a Morse string (letters separated by spaces, words by "/") back to uppercase text, DROPPING any
// symbol that does not resolve. That silent shortening is the long-standing behaviour of this function
// and is PRESERVED for current callers -- reach for morse_decode_checked when a malformed symbol must not
// pass unnoticed. The lossy policy never errs, so the unwrap_or default is unreachable; it is there to
// keep the function total.

fn morse_decode(morse: string) -> string
    return mo_decode(morse)

