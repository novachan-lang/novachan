// forge_cache — in-process keyed memo cache for the Forge web framework.
// Single-owner actor over a request channel; correct under N>1 NOVA_CARRIERS by construction.
// LEAF module — imports NOTHING.

fn _cache_loop(c)
    let store = {}
    loop
        let env = receive(c["req"])
        let op = env["op"]
        if op == "stop"
            break
        else if op == "put"
            store[env["key"]] = [env["val"]]
        else if op == "delete"
            if env["key"] in store
                store[env["key"]] = []
        else if op == "clear"
            store = {}
        else if op == "get"
            if env["key"] in store
                let entry = store[env["key"]]
                send(env["reply"], entry if len(entry) == 1 else [])
            else
                send(env["reply"], [])

fn cache_new() -> any
    let c = {"req": channel()}
    spawn _cache_loop(c)
    c

fn cache_put(c, key: string, val: string)
    send(c["req"], {"op": "put", "key": key, "val": val})

fn cache_get(c, key: string) -> Result<string>
    let rc = channel()
    send(c["req"], {"op": "get", "key": key, "reply": rc})
    let r = receive(rc)
    if len(r) == 1
        return ok(r[0])
    err("cache: miss")

fn cache_delete(c, key: string)
    send(c["req"], {"op": "delete", "key": key})

fn cache_clear(c)
    send(c["req"], {"op": "clear"})

fn cache_stop(c)
    send(c["req"], {"op": "stop"})

fn cache_get_or(c, key: string, fallback: string) -> string
    let r = cache_get(c, key)
    if is_ok(r)
        return unwrap(r)
    cache_put(c, key, fallback)
    fallback
