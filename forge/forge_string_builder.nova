// forge_string_builder — efficient string building with Result API.

fn sb_new() -> dict
    let s = {}
    s["parts"] = {}
    s["count"] = 0
    s["total_len"] = 0
    s

fn sb_append(s: dict, text: string) -> dict
    let key = "p_" + str(s["count"])
    s["parts"][key] = text
    s["count"] = s["count"] + 1
    s["total_len"] = s["total_len"] + len(text)
    s

fn sb_build(s: dict) -> string
    let result = ""
    let i = 0
    while i < s["count"]
        let key = "p_" + str(i)
        result = result + s["parts"][key]
        i = i + 1
    result

fn sb_build_with_sep(s: dict, sep: string) -> string
    let result = ""
    let i = 0
    while i < s["count"]
        if i > 0
            result = result + sep
        let key = "p_" + str(i)
        result = result + s["parts"][key]
        i = i + 1
    result

fn sb_count(s: dict) -> int
    s["count"]

fn sb_total_length(s: dict) -> int
    s["total_len"]

fn sb_clear(s: dict) -> dict
    s["parts"] = {}
    s["count"] = 0
    s["total_len"] = 0
    s
