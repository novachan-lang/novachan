// forge_string_builder — efficient string building with Result API.

fn sb_new() -> dict
    {"parts": {}, "count": 0, "total_len": 0}

fn sb_append(s: dict, text: string) -> dict
    let cnt = s["count"]
    let key = "p_{cnt}"
    s["parts"][key] = text
    s["count"] += 1
    s["total_len"] += len(text)
    s

fn sb_build(s: dict) -> string
    let result = ""
    for i in 0..s["count"]
        let key = "p_{i}"
        result += s["parts"][key]
    result

fn sb_build_with_sep(s: dict, sep: string) -> string
    let result_parts = []
    for i in 0..s["count"]
        if i > 0
            push(result_parts, sep)
        let key = "p_{i}"
        push(result_parts, s["parts"][key])
    let result = join(result_parts, "")
    result

fn sb_count(s: dict) -> int
    s["count"]

fn sb_total_length(s: dict) -> int
    s["total_len"]

fn sb_clear(s: dict) -> dict
    s["parts"] = {}
    s["count"] = 0
    s["total_len"] = 0
    s
