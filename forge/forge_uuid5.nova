// forge_uuid5 -- deterministic NAME-based UUIDv5 (RFC 9562/4122): the same namespace + name ALWAYS yields the
// same UUID, so you get idempotent, storage-free ids from a string (e.g. a stable id per URL or per external
// key). uuid = SHA-1(namespace_bytes || name), first 16 bytes with version 5 + variant bits set. Composes
// forge_crypto sha1. Imports forge_crypto. (forge_uuid handles random v4 + time-ordered v7.)
import forge_crypto

// The standard DNS namespace UUID (6ba7b810-9dad-11d1-80b4-00c04fd430c8) as a 16-byte list.
fn uuid5_ns_dns() -> list
    [107, 167, 184, 16, 157, 173, 17, 209, 128, 180, 0, 192, 79, 212, 48, 200]

// The URL namespace UUID (6ba7b811-9dad-11d1-80b4-00c04fd430c8).
fn uuid5_ns_url() -> list
    [107, 167, 184, 17, 157, 173, 17, 209, 128, 180, 0, 192, 79, 212, 48, 200]

fn _u5_render(bytes: list) -> string
    let hex = "0123456789abcdef"
    let out_parts = []
    for i in 0..16
        push(out_parts, char_at(hex, bytes[i] / 16) + char_at(hex, bytes[i] % 16))
        if i == 3 or i == 5 or i == 7 or i == 9
            push(out_parts, "-")
    let out = join(out_parts, "")
    out

// The UUIDv5 for a `namespace` (16-byte list) + `name` string.
fn uuid5(namespace: list, name: string) -> string
    let msg = []
    for i in 0..len(namespace)
        push(msg, namespace[i])
    for j in 0..len(name)
        push(msg, ord(char_at(name, j)))
    let hash = sha1_bytes(msg)
    let b = [hash[k] for k in 0..16]
    b[6] = (b[6] % 16) + 80
    b[8] = (b[8] % 64) + 128
    _u5_render(b)

// Convenience: a DNS-namespaced UUIDv5 for a name.
fn uuid5_dns(name: string) -> string
    uuid5(uuid5_ns_dns(), name)
