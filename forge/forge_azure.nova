// forge_azure -- Azure REST API client builder: OAuth2 client-credentials token requests against
// Azure AD (Microsoft Entra ID) plus URL builders for the four REST-shaped Azure data services
// (Blob Storage, Key Vault, Cosmos DB) and a SQL Database connection string. This is a pure request
// BUILDER (mirrors forge_awssigv4's role for AWS) -- it hands back plain dicts describing the method,
// URL, headers, and body; the caller sends them over whatever HTTP client is on hand (forge's http_*
// or a raw socket). No network I/O lives here, so the module is trivially testable and has zero
// transport dependencies.
//
// AUTH MODEL: Azure AD's OAuth2 client-credentials flow (RFC 6749 §4.4) trades a tenant-scoped
// client_id/client_secret pair for a short-lived bearer access_token, which every subsequent Azure
// REST call carries as `Authorization: Bearer <token>`. This is the same shape Google Cloud and AWS
// STS use for service-to-service auth, but Azure's token endpoint is per-TENANT
// (login.microsoftonline.com/{tenant_id}/...) rather than one global endpoint -- the tenant_id is
// baked into the client so every token request is automatically scoped to the right directory.
//
// LEAF: no imports. The one piece of string-building logic (RFC 3986 percent-encoding) is hand-rolled
// here rather than pulled from forge.nova's url_encode, to keep this module usable standalone (same
// call this project made for forge_awssigv4) -- ASCII-safe like forge.nova's own _pct_encode.
//
// RAISED 2026-08-05. Five problems:
//
//   1. _az_pct_encode used a while-index loop. for-in range.
//   2. _az_path_encode used a push loop with `if i > 0` separator logic, then a dead binding.
//      Comprehension + join.
//   3. azure_token_request body used 4 separate `+=` concat lines. Single interpolated string.
//   4. All URL builders used multi-part string concat. Interpolation.
//   5. azure_token_request returned a dict built incrementally. Dict literal.

fn _az_hex2(n: int) -> string
    let d = "0123456789ABCDEF"
    "{char_at(d, (n >> 4) & 15)}{char_at(d, n & 15)}"

fn _az_pct_encode(s: string) -> string
    let out = ""
    for i in 0..len(s)
        let c = s[i]
        let o = ord(c)
        if (o >= 65 and o <= 90) or (o >= 97 and o <= 122) or (o >= 48 and o <= 57) or o == 45 or o == 95 or o == 46 or o == 126
            out += c
        else
            out += "%{_az_hex2(o)}"
    out

fn _az_path_encode(path: string) -> string
    join([_az_pct_encode(seg) for seg in split(path, "/")], "/")

fn azure_client(tenant_id: string, client_id: string, client_secret: string) -> dict
    {"tenant_id": tenant_id, "client_id": client_id, "client_secret": client_secret}

fn azure_token_request(client: dict) -> dict
    let tid = _az_pct_encode(client["tenant_id"])
    let cid = _az_pct_encode(client["client_id"])
    let csec = _az_pct_encode(client["client_secret"])
    let scope_enc = _az_pct_encode("https://management.azure.com/.default")
    let url = "https://login.microsoftonline.com/{tid}/oauth2/v2.0/token"
    let body = "grant_type=client_credentials&client_id={cid}&client_secret={csec}&scope={scope_enc}"
    {"method": "POST", "url": url, "headers": {"Content-Type": "application/x-www-form-urlencoded"}, "body": body}

fn azure_request(method: string, url: string, token: string, body: string) -> dict
    {"method": method, "url": url, "headers": {"Authorization": "Bearer {token}", "Content-Type": "application/json"}, "body": body}

fn azure_blob_url(account: string, container: string, blob: string) -> string
    let cont = _az_pct_encode(container)
    let bp = _az_path_encode(blob)
    "https://{account}.blob.core.windows.net/{cont}/{bp}"

fn azure_keyvault_url(vault: string, secret_name: string) -> string
    let sn = _az_pct_encode(secret_name)
    "https://{vault}.vault.azure.net/secrets/{sn}?api-version=7.4"

fn azure_sql_url(server: string, database: string) -> string
    "Server=tcp:{server}.database.windows.net,1433;Database={database};Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"

fn azure_cosmosdb_url(account: string, database: string, container: string) -> string
    let db = _az_pct_encode(database)
    let cont = _az_pct_encode(container)
    "https://{account}.documents.azure.com/dbs/{db}/colls/{cont}"
