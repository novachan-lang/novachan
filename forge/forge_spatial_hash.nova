// forge_spatial_hash — 2D spatial hashing for collision detection.

fn sh_new(cell_size: int) -> dict
    let s = {}
    s["cell_size"] = cell_size
    s["objects"] = {}
    s["obj_count"] = 0
    s

fn sh_cell_key(cell_size: int, x: int, y: int) -> string
    let cx = x / cell_size
    let cy = y / cell_size
    str(cx) + ":" + str(cy)

fn sh_insert(s: dict, name: string, x: int, y: int) -> dict
    let k = str(s["obj_count"])
    s["objects"][k + "_name"] = name
    s["objects"][k + "_x"] = x
    s["objects"][k + "_y"] = y
    s["objects"][k + "_cell"] = sh_cell_key(s["cell_size"], x, y)
    s["obj_count"] = s["obj_count"] + 1
    s

fn sh_query_cell(s: dict, x: int, y: int) -> int
    let target = sh_cell_key(s["cell_size"], x, y)
    let count = 0
    let i = 0
    while i < s["obj_count"]
        if s["objects"][str(i) + "_cell"] == target
            count = count + 1
        i = i + 1
    count

fn sh_nearby(s: dict, x: int, y: int, radius: int) -> int
    let count = 0
    let i = 0
    while i < s["obj_count"]
        let k = str(i)
        let dx = s["objects"][k + "_x"] - x
        let dy = s["objects"][k + "_y"] - y
        if dx < 0
            dx = 0 - dx
        if dy < 0
            dy = 0 - dy
        if dx <= radius
            if dy <= radius
                count = count + 1
        i = i + 1
    count

fn sh_count(s: dict) -> int
    s["obj_count"]

fn sh_obj_name(s: dict, idx: int) -> string
    s["objects"][str(idx) + "_name"]
