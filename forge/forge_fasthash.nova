// forge_fasthash -- fast NON-cryptographic hash functions: FNV-1a, djb2, sdbm, plus a hash combiner and a bucket
// mapper. These are the workhorses behind hash tables/maps, bloom filters, sharding and consistent hashing, cache
// keys, checksums and deduplication -- anywhere you need to turn a string (or a sequence of values) into a
// well-spread integer FAST. They are NOT for security: unlike forge_crypto's SHA/HMAC they are trivially
// reversible and collidable on purpose, trading cryptographic strength for speed and simplicity. FNV-1a is the
// usual default (great distribution, tiny code); djb2 and sdbm are the classic alternatives worth having when you
// want a second independent hash (e.g. double hashing in a bloom filter). All produce a 32-bit non-negative result
// (masked to 0..2^32-1). NUL-free strings, byte-oriented. LEAF -- imports NOTHING.

// PRIVATE: 32-bit mask.
fn _fh_mask() -> int
    4294967295

// FNV-1a 32-bit hash (the recommended default: XOR the byte, then multiply by the FNV prime). Canonical:
// fnv1a_32("")=2166136261, ("a")=3826002220, ("foobar")=3214735720.
fn fnv1a_32(s: string) -> int
    let h = 2166136261
    for i in 0..len(s)
        h = h ^ ord(char_at(s, i))
        h = (h * 16777619) & 4294967295
    h

// djb2 hash (Dan Bernstein): h = h*33 + c. djb2("")=5381, ("a")=177670.
fn djb2(s: string) -> int
    let h = 5381
    for i in 0..len(s)
        h = ((h << 5) + h + ord(char_at(s, i))) & 4294967295
    h

// sdbm hash: h = c + h*65599 (expressed with shifts). sdbm("")=0, ("a")=97.
fn sdbm(s: string) -> int
    let h = 0
    for i in 0..len(s)
        h = (ord(char_at(s, i)) + (h << 6) + (h << 16) - h) & 4294967295
    h

// Combine a running hash `seed` with another integer value (Boost-style mixer) -- for hashing tuples/records where
// order matters. Fold values in sequence: seed = hash_combine(hash_combine(0, a), b), ...
fn hash_combine(seed: int, value: int) -> int
    let s = seed & 4294967295
    let v = value & 4294967295
    let mixed = (v + 2654435769 + (s << 6) + (s >> 2)) & 4294967295
    (s ^ mixed) & 4294967295

// Map a string to a bucket in [0, n) via FNV-1a -- the primitive for sharding, hash-table placement, and load
// distribution across n slots. n must be > 0.
fn hash_bucket(s: string, n: int) -> int
    fnv1a_32(s) % n
