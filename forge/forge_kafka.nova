// forge_kafka -- pure-NOVA Apache Kafka wire-protocol client codec over raw TCP (reuses tcp_* the same way
// forge_pg / forge_mysql do). Kafka's classic (non-flexible) wire format: everything BIG-ENDIAN; a request
// is int32-size-prefixed; strings are int16-length-prefixed UTF-8 (nullable: -1 = null); byte blobs are
// int32-length-prefixed (nullable: -1 = null); arrays are int32-count-prefixed (no compact/varint tagged
// fields -- this module targets the classic v0 request/response layouts, which are structurally identical
// to the flexible ones minus the tagged-field varints). Legacy (v0/v1 magic-byte) message records use plain
// CRC32 (IEEE), not CRC32C -- CRC32C only appears in the modern RecordBatch v2 container.
import std/hash/crc32

// ---- frame assembly ------------------------------------------------------------------------------------
// Concatenate a list of `bytes` pieces. `acc = bytes_concat(acc, piece)` inside a loop is QUADRATIC:
// bytes_concat allocates a fresh buffer and memcpys EVERYTHING accumulated so far on every step, so a
// k-piece frame of n total bytes copies n*k/2 bytes (a 10k-message ProduceRequest copies gigabytes).
// Pairwise halving merges neighbours and halves the list each round: O(n log k) copied, still at memcpy
// speed (unlike a per-byte bytes_append loop, which would be linear but ~100x slower per byte).
// Empty list -> empty bytes; a single piece is returned as-is (safe: nothing in this module mutates
// bytes, every value here is build-once-then-read).
fn _kf_cat(pieces: list) -> any
    if len(pieces) == 0
        return bytes(0)
    let cur = pieces
    while len(cur) > 1
        let n = len(cur)
        let half = (n + 1) / 2
        cur = [bytes_concat(cur[2 * k], cur[2 * k + 1]) if 2 * k + 1 < n else cur[2 * k] for k in 0..half]
    cur[0]

// ---- big-endian integer codecs -----------------------------------------------------------------------
// ONE width-parameterized encoder backs be16/be32/be64 (the three were byte-for-byte the same shift ladder
// at three lengths). Shift+mask extraction is sign-agnostic: bit (8*k .. 8*k+7) of a 64-bit two's-complement
// value never depends on how the shift fills vacated high bits, so this is correct for negative n (e.g. the
// -1 null-length markers) without any overflow-prone modulo-offset arithmetic.
fn _kf_be(n: int, width: int) -> any
    bytes_from_list([(n >> (8 * (width - 1 - i))) & 255 for i in 0..width])

fn kf_be16(n: int) -> any
    _kf_be(n, 2)

fn kf_be32(n: int) -> any
    _kf_be(n, 4)

fn kf_be64(n: int) -> any
    _kf_be(n, 8)

// Unsigned 16-bit read (0..65535) -- raw big-endian bit pattern, no sign extension.
// The reads below stay as explicit inline arithmetic ON PURPOSE: they are the hottest instructions in the
// module (every field of every record of a multi-megabyte FetchResponse goes through them), and a
// width-parameterized reduce(...) form would replace 4 inline multiplies with a list allocation plus 4
// any-boxed closure calls.
fn kf_rd_u16(b, off: int) -> int
    (bytes_get(b, off) * 256) + bytes_get(b, off + 1)

// Signed 16-bit read (Kafka string lengths use -1 as the null sentinel).
fn kf_rd_i16(b, off: int) -> int
    let u = kf_rd_u16(b, off)
    u - 65536 if u >= 32768 else u

// Unsigned 32-bit read (0..4294967295) -- fits an i64 with room to spare.
fn kf_rd_u32(b, off: int) -> int
    (bytes_get(b, off) * 16777216) + (bytes_get(b, off + 1) * 65536) + (bytes_get(b, off + 2) * 256) + bytes_get(b, off + 3)

// Signed 32-bit read (correlation ids, error codes, bytes/array lengths use -1 as a sentinel).
fn kf_rd_i32(b, off: int) -> int
    let u = kf_rd_u32(b, off)
    u - 4294967296 if u >= 2147483648 else u

// Signed 64-bit read (offsets, timestamps). Built by shift+or across all 8 bytes -- this naturally lands on
// the correct two's-complement i64 result (positive or negative) since the accumulator is exactly 64 bits
// wide, so no separate unsigned-then-rebase step is needed (unlike the 16/32-bit reads above).
fn kf_rd_i64(b, off: int) -> int
    let v = 0
    for i in 0..8
        v = (v << 8) | bytes_get(b, off + i)
    v

// ---- Kafka strings / bytes ----------------------------------------------------------------------------
// STRING: int16 length + UTF-8 bytes (length must be >= 0).
fn kf_wr_string(s: string) -> any
    let sb = str_to_bytes(s)
    bytes_concat(kf_be16(bytes_len(sb)), sb)

// NULLABLE_STRING: -1 (two 0xFF bytes) if `s` is null, else the same as kf_wr_string.
fn kf_wr_nullable_string(s) -> any
    kf_be16(0 - 1) if s == null else kf_wr_string(s)

// -> [string, next_off]. Non-nullable (a -1 length here is a protocol violation of the caller's contract).
// SOUNDNESS: `n` comes straight off the wire (any int16 value, including negative-but-not-(-1)
// junk). Without clamping, `start + n` can land BEFORE `start` (e.g. n = -5), handing the caller a
// next_off that moves the parse cursor BACKWARD. Every caller in this module (kf_parse_produce_response
// / kf_parse_fetch_response) advances its own position purely from the returned next_off with no
// independent monotonicity check, so a single malformed/hostile length field silently desynchronizes
// the whole parse. Clamping n to >= 0 guarantees next_off is always >= start (forward progress),
// matching the read as an empty string instead of corrupting the cursor.
fn kf_rd_string(b, off: int) -> any
    let raw = kf_rd_i16(b, off)
    let n = 0 if raw < 0 else raw
    let start = off + 2
    [bytes_to_str(bytes_slice(b, start, start + n)), start + n]

// -> [string_or_null, next_off]. Only -1 means null; every other length (including other negatives) is
// handled exactly as kf_rd_string handles it, so the two share ONE body.
fn kf_rd_nullable_string(b, off: int) -> any
    if kf_rd_i16(b, off) == 0 - 1
        return [null, off + 2]
    kf_rd_string(b, off)

// BYTES: int32 length + raw bytes.
fn kf_wr_bytes(bs) -> any
    bytes_concat(kf_be32(bytes_len(bs)), bs)

// NULLABLE_BYTES: -1 (four 0xFF bytes) if `v` is null; a `bytes` value is written as-is; a `string` value is
// UTF-8-encoded first (convenience for message keys/values, which are almost always given as plain strings).
fn kf_wr_nullable_bytes(v) -> any
    if v == null
        return kf_be32(0 - 1)
    kf_wr_bytes(str_to_bytes(v) if type_of(v) == "string" else v)

// -> [bytes_or_null, next_off]. SOUNDNESS: same negative-non-sentinel clamp as kf_rd_string above --
// only -1 means null; any other negative length is malformed input and must not push next_off
// backward past `start`.
fn kf_rd_bytes(b, off: int) -> any
    let raw = kf_rd_i32(b, off)
    if raw == 0 - 1
        return [null, off + 4]
    let n = 0 if raw < 0 else raw
    let start = off + 4
    [bytes_slice(b, start, start + n), start + n]

// -> [string_or_null, next_off] (bytes decoded as UTF-8; convenience mirror of kf_rd_bytes for text payloads).
fn kf_rd_nullable_bytes_str(b, off: int) -> any
    let r = kf_rd_bytes(b, off)
    [null, r[1]] if r[0] == null else [bytes_to_str(r[0]), r[1]]

// ---- request header + outer size-prefixed framing ------------------------------------------------------
// RequestHeader (v1) => api_key(int16) api_version(int16) correlation_id(int32) client_id(nullable string).
fn kf_request_header(api_key: int, api_version: int, correlation_id: int, client_id) -> any
    _kf_cat([kf_be16(api_key), kf_be16(api_version), kf_be32(correlation_id), kf_wr_nullable_string(client_id)])

// -> [api_key, api_version, correlation_id, client_id_or_null, next_off]. Inverse of kf_request_header,
// reading starting at `off` (NOT including any outer size prefix).
fn kf_parse_request_header(b, off: int) -> any
    let api_key = kf_rd_i16(b, off)
    let api_version = kf_rd_i16(b, off + 2)
    let correlation_id = kf_rd_i32(b, off + 4)
    let cr = kf_rd_nullable_string(b, off + 8)
    [api_key, api_version, correlation_id, cr[0], cr[1]]

// Full request = int32 size (of everything that follows) + header + body.
fn kf_frame_request(header, body) -> any
    let payload = bytes_concat(header, body)
    bytes_concat(kf_be32(bytes_len(payload)), payload)

// Read the leading int32 size prefix of a frame (request or response).
fn kf_frame_size(b) -> int
    kf_rd_i32(b, 0)

// ResponseHeader (v0, matching the classic/non-flexible APIs this module targets) => correlation_id(int32).
// -> [correlation_id, body_off] reading a full frame `b` that STARTS AT the size prefix (byte 0).
fn kf_parse_response_header(b) -> any
    let corr = kf_rd_i32(b, 4)
    [corr, 8]

// ---- Message (legacy v0 record format: magic=0, plain CRC32) -------------------------------------------
// Message => Crc(int32) MagicByte(int8=0) Attributes(int8=0, no compression) Key(nullable bytes) Value(nullable bytes).
// Crc is CRC32(IEEE) of everything from MagicByte onward.
fn _kf_message_bytes(key, value) -> any
    let body = _kf_cat([bytes_from_list([0, 0]), kf_wr_nullable_bytes(key), kf_wr_nullable_bytes(value)])
    bytes_concat(kf_be32(h_crc32_bytes(body)), body)

// One MessageSet entry: Offset(int64) MessageSize(int32) Message. `m` = [key, value].
fn _kf_message_entry(m) -> any
    let mb = _kf_message_bytes(m[0], m[1])
    _kf_cat([kf_be64(0), kf_be32(bytes_len(mb)), mb])

// MessageSet: back-to-back { Offset(int64) MessageSize(int32) Message } entries, no outer count (the
// caller wraps it in a length-prefixed field). `messages` = list of [key, value] (each any: string or null).
fn _kf_message_set(messages: list) -> any
    _kf_cat([_kf_message_entry(m) for m in messages])

// Parse a MessageSet occupying b[off:end] -> list of [offset, key_or_null, value_or_null] where key/value
// are raw `bytes` (or null) -- NOT decoded as UTF-8 text. Kafka record keys/values are arbitrary binary
// payloads (protobuf, avro, compressed data, images -- not guaranteed NUL-free UTF-8), so this path MUST
// stay binary-safe end-to-end; routing them through kf_rd_nullable_bytes_str (bytes_to_str) would silently
// truncate any value containing an embedded 0x00 byte at the first NUL. Callers who know a field IS text
// may convert explicitly with bytes_to_str() themselves. A trailing message whose declared size runs past
// `end` is a normal, expected truncation (brokers may cut a FetchResponse mid-record to respect MaxBytes)
// -- it is silently dropped rather than treated as an error.
// The `while` stays: `p` advances by a DATA-DEPENDENT, wire-declared step and the loop short-circuits on
// the first malformed/truncated record -- not a counted loop.
fn _kf_parse_message_set(b, off: int, end: int) -> any
    let out = []
    let p = off
    while p + 12 <= end
        let msg_offset = kf_rd_i64(b, p)
        let msg_size = kf_rd_i32(b, p + 8)
        let mstart = p + 12
        // SOUNDNESS: msg_size is an untrusted int32 taken straight off the wire and used to compute the
        // NEXT loop position (`p = mstart + msg_size`). Without rejecting negative values here, a crafted
        // record can make `p` non-monotonic: e.g. msg_size == -12 makes the new p equal the OLD p, so
        // `while p + 12 <= end` never terminates -- a guaranteed infinite loop (100% CPU hang) from a
        // single malicious/corrupted FetchResponse. A more negative msg_size drives p far below `off`;
        // bytes_get/bytes_slice clamp out-of-range reads to 0 rather than crashing, so the loop keeps
        // "succeeding" on fabricated zero-filled records while crawling p back up 12 bytes/iteration --
        // up to ~2^31/12 (~179M) wasted iterations before it would ever reach `end`. Rejecting msg_size <
        // 0 up front (same "malformed => stop like a truncated trailing message" contract as the
        // overrun check below) guarantees p strictly increases by at least 12 every iteration, so the
        // loop is hard-bounded by (end - off) / 12.
        if msg_size < 0
            return out
        if mstart + msg_size > end
            return out
        let kv_off = mstart + 6
        let kr = kf_rd_bytes(b, kv_off)
        let vr = kf_rd_bytes(b, kr[1])
        push(out, [msg_offset, kr[0], vr[0]])
        p = mstart + msg_size
    out

// ---- Produce request (api_key 0) / response ------------------------------------------------------------
// One produce partition entry: Partition(int32) MessageSetSize(int32) MessageSet. `p` = [partition, messages].
fn _kf_produce_partition(p) -> any
    let mset = _kf_message_set(p[1])
    _kf_cat([kf_be32(p[0]), kf_be32(bytes_len(mset)), mset])

// One produce topic entry: TopicName(string) PartitionCount(int32) partitions...
fn _kf_produce_topic(t) -> any
    let parts = t[1]
    _kf_cat([kf_wr_string(t[0]), kf_be32(len(parts)), _kf_cat([_kf_produce_partition(p) for p in parts])])

// topics = list of [name: string, partitions: list]; partitions = list of [partition: int, messages: list];
// messages = list of [key, value] (each any: string or null).
fn kf_produce_request(acks: int, timeout_ms: int, topics: list) -> any
    _kf_cat([kf_be16(acks), kf_be32(timeout_ms), kf_be32(len(topics)), _kf_cat([_kf_produce_topic(t) for t in topics])])

// -> [topics, next_off]; topics = list of [name, partition_responses]; partition_responses = list of
// [partition, error_code, base_offset].
// SOUNDNESS: `n` (topic count) and `pn` (partition count) are untrusted int32 fields taken straight off
// the wire, with NO relationship enforced to how much data actually remains in `b`. Every read this
// function performs is individually bounds-safe (bytes_get/bytes_slice clamp out-of-range access to
// 0/empty rather than crashing), so an attacker/corrupt broker cannot corrupt memory here -- but with
// nothing else bounding the loops, a response that simply DECLARES e.g. n = 2000000000 topics on a
// tiny buffer drives the parser through up to ~2^31 iterations of list/string allocation before the
// (unreachable) real data runs out: a pure CPU/allocation-exhaustion DoS from a single malicious frame.
// FIX: clamp each declared count to the maximum that the ACTUAL remaining bytes could possibly back,
// using each entry's minimum wire footprint (topic >= 2-byte string-len + 4-byte partition-count = 6;
// partition entry == fixed 14 bytes). Any well-formed response always has strictly MORE than the
// minimum-footprint bytes per real entry, so this can never truncate legitimate data -- it only rejects
// counts that are provably impossible given the bytes on hand. (A negative clamp is safe as a `for`
// bound: `0..negative` is an empty range, exactly like the `while i < n` it replaced.)
fn kf_parse_produce_response(b, off: int) -> any
    let blen = bytes_len(b)
    let raw_n = kf_rd_i32(b, off)
    let p = off + 4
    let max_topics = (blen - p) / 6
    let n = min(0 if raw_n < 0 else raw_n, max_topics)
    let topics = []
    for i in 0..n
        let nr = kf_rd_string(b, p)
        p = nr[1]
        let raw_pn = kf_rd_i32(b, p)
        p += 4
        let max_parts = (blen - p) / 14
        let pn = min(0 if raw_pn < 0 else raw_pn, max_parts)
        let prs = []
        for j in 0..pn
            push(prs, [kf_rd_i32(b, p), kf_rd_i16(b, p + 4), kf_rd_i64(b, p + 6)])
            p += 14
        push(topics, [nr[0], prs])
    [topics, p]

// ---- Fetch request (api_key 1) / response ----------------------------------------------------------------
// One fetch partition entry: Partition(int32) FetchOffset(int64) MaxBytes(int32).
fn _kf_fetch_partition(p) -> any
    _kf_cat([kf_be32(p[0]), kf_be64(p[1]), kf_be32(p[2])])

// One fetch topic entry: TopicName(string) PartitionCount(int32) partitions...
fn _kf_fetch_topic(t) -> any
    let parts = t[1]
    _kf_cat([kf_wr_string(t[0]), kf_be32(len(parts)), _kf_cat([_kf_fetch_partition(p) for p in parts])])

// topics = list of [name: string, partitions: list]; partitions = list of [partition: int, fetch_offset:
// int, max_bytes: int].
fn kf_fetch_request(replica_id: int, max_wait_ms: int, min_bytes: int, topics: list) -> any
    _kf_cat([kf_be32(replica_id), kf_be32(max_wait_ms), kf_be32(min_bytes), kf_be32(len(topics)), _kf_cat([_kf_fetch_topic(t) for t in topics])])

// -> [topics, next_off]; topics = list of [name, partition_responses]; partition_responses = list of
// [partition, error_code, high_watermark, messages] where messages = list of [offset, key, value] and
// key/value are raw `bytes` (or null) -- binary-safe, NOT UTF-8-decoded (see _kf_parse_message_set).
// SOUNDNESS (see kf_parse_produce_response for the full rationale): `n`/`pn` are clamped to the maximum
// count the remaining buffer could actually back (topic minimum 6 bytes, partition-entry-header minimum
// 18 bytes: partition(4)+error(2)+high_watermark(8)+message_set_size(4)), closing the same
// declared-count DoS. Additionally, `msize` (the per-partition message-set byte length) is itself an
// untrusted int32: previously `p = mset_off + msize` trusted it blindly, so a negative or
// past-buffer-end msize would either walk `p` BACKWARD (re-parsing/overlapping earlier data on every
// subsequent iteration) or hand `_kf_parse_message_set` an `end` far beyond the real buffer. Clamping
// `mset_end` to `mset_off` whenever msize is negative or would overrun `blen` keeps `p` monotonically
// forward (advancing by exactly the fixed 18-byte header on malformed input, matching this module's
// existing "malformed trailing content is silently truncated, not an error" contract) while leaving
// well-formed responses byte-for-byte unaffected (a legitimate msize is always <= the real remaining
// bytes, so the clamp never fires for real data).
fn kf_parse_fetch_response(b, off: int) -> any
    let blen = bytes_len(b)
    let raw_n = kf_rd_i32(b, off)
    let p = off + 4
    let max_topics = (blen - p) / 6
    let n = min(0 if raw_n < 0 else raw_n, max_topics)
    let topics = []
    for i in 0..n
        let nr = kf_rd_string(b, p)
        p = nr[1]
        let raw_pn = kf_rd_i32(b, p)
        p += 4
        let max_parts = (blen - p) / 18
        let pn = min(0 if raw_pn < 0 else raw_pn, max_parts)
        let prs = []
        for j in 0..pn
            let partition = kf_rd_i32(b, p)
            let err = kf_rd_i16(b, p + 4)
            let hw = kf_rd_i64(b, p + 6)
            let msize = kf_rd_i32(b, p + 14)
            let mset_off = p + 18
            let cand_end = mset_off + msize
            let mset_end = mset_off if (msize < 0 or cand_end > blen) else cand_end
            push(prs, [partition, err, hw, _kf_parse_message_set(b, mset_off, mset_end)])
            p = mset_end
        push(topics, [nr[0], prs])
    [topics, p]

// ---- TCP transport ---------------------------------------------------------------------------------------
fn kf_connect(host: string, port: int) -> any
    tcp_connect(host, port)

fn kf_close(sock)
    tcp_close(sock)

// Frame + send a request (header + body) over an already-open socket.
fn kf_send_request(sock, header, body)
    tcp_send_bytes(sock, kf_frame_request(header, body))

// Read from `sock` until `buf` holds at least `need` bytes (or the peer closes). The `while` stays: it is
// a data-dependent I/O drain that short-circuits on EOF. What changed is the ACCUMULATION -- chunks are
// collected into a list and merged ONCE via _kf_cat instead of `buf = bytes_concat(buf, chunk)` per
// chunk, which recopied the whole buffer on every read (a 10 MB response arriving in 64 KB chunks copied
// ~800 MB). A running `have` counter replaces the bytes_len(buf) test, so the merge happens exactly once.
fn _kf_recv_at_least(sock: int, buf, need: int) -> any
    if bytes_len(buf) >= need
        return buf
    let parts = [buf]
    let have = bytes_len(buf)
    while have < need
        let chunk = tcp_recv_bytes(sock)
        if bytes_len(chunk) == 0
            return _kf_cat(parts)
        push(parts, chunk)
        have += bytes_len(chunk)
    _kf_cat(parts)

// Read one full size-prefixed response frame -> [correlation_id, body_bytes, leftover_buf]. body_bytes
// excludes the size prefix AND the correlation_id (i.e. starts at the API-specific response body).
// correlation_id -1 = short read / connection closed before a full frame arrived.
fn kf_recv_response(sock: int, buf) -> any
    buf = _kf_recv_at_least(sock, buf, 4)
    if bytes_len(buf) < 4
        return [0 - 1, bytes(0), buf]
    let size = kf_rd_i32(buf, 0)
    // SOUNDNESS: a negative size prefix (corrupt/hostile peer) must be treated as malformed the same as
    // a short read. Without this check, `total = 4 + size` can be < 4 (even negative); `bytes_slice`
    // clamps a negative/backward range to empty, so the parse would fabricate a "successful" zero-length
    // response with correlation_id 0 -- masking a corrupt frame as valid data (a malformed-input
    // acceptance). Worse, the leftover-buffer slice `bytes_slice(buf, total, bytes_len(buf))` clamps the
    // negative `start` back to 0, returning the ENTIRE original buffer as "leftover" -- i.e. zero bytes
    // are ever consumed. A caller looping on kf_recv_response over the same socket would then reparse the
    // identical corrupt prefix forever: an unbounded infinite-loop DoS at the framing layer.
    if size < 0
        return [0 - 1, bytes(0), buf]
    let total = 4 + size
    buf = _kf_recv_at_least(sock, buf, total)
    if bytes_len(buf) < total
        return [0 - 1, bytes(0), buf]
    let frame = bytes_slice(buf, 0, total)
    let hdr = kf_parse_response_header(frame)
    [hdr[0], bytes_slice(frame, hdr[1], total), bytes_slice(buf, total, bytes_len(buf))]
