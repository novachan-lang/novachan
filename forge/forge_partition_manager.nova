// forge_partition_manager — Data partitioning (consistent hashing).

fn pm_new(partition_count: int) -> dict
    let p = {}
    p["count"] = partition_count
    p["owners"] = {}
    p["items"] = {}
    p["item_count"] = 0
    p

fn pm_hash_key(key: string, count: int) -> int
    let h = 0
    let i = 0
    while i < len(key)
        h = h * 31 + ord(key[i])
        if h < 0
            h = 0 - h
        i = i + 1
    h % count

fn pm_assign_owner(p: dict, partition: int, owner: string) -> dict
    p["owners"][str(partition)] = owner
    p

fn pm_put(p: dict, key: string) -> dict
    let part = pm_hash_key(key, p["count"])
    p["items"][key] = part
    p["item_count"] = p["item_count"] + 1
    p

fn pm_partition_for(p: dict, key: string) -> int
    pm_hash_key(key, p["count"])

fn pm_owner_for(p: dict, key: string) -> string
    let part = pm_hash_key(key, p["count"])
    let has = contains(p["owners"], str(part))
    if has != true
        return ""
    p["owners"][str(part)]

fn pm_partition_count(p: dict) -> int
    p["count"]

fn pm_item_count(p: dict) -> int
    p["item_count"]
