// forge_bit_set — Bit set using dict of int buckets (32 bits each).

fn bs_new() -> dict
    let b = {}
    b["buckets"] = {}
    b["count"] = 0
    b

fn bs_set(b: dict, bit: int) -> dict
    let bucket = bit / 32
    let offset = bit - bucket * 32
    let k = str(bucket)
    let has = contains(b["buckets"], k)
    let val = 0
    if has == true
        val = b["buckets"][k]
    let mask = 1
    let i = 0
    while i < offset
        mask = mask * 2
        i = i + 1
    let was_set = val / mask
    was_set = was_set - (was_set / 2) * 2
    if was_set == 0
        b["buckets"][k] = val + mask
        b["count"] = b["count"] + 1
    b

fn bs_test(b: dict, bit: int) -> int
    let bucket = bit / 32
    let offset = bit - bucket * 32
    let k = str(bucket)
    let has = contains(b["buckets"], k)
    if has != true
        return 0
    let val = b["buckets"][k]
    let mask = 1
    let i = 0
    while i < offset
        mask = mask * 2
        i = i + 1
    let r = val / mask
    r = r - (r / 2) * 2
    r

fn bs_clear(b: dict, bit: int) -> dict
    if bs_test(b, bit) == 1
        let bucket = bit / 32
        let offset = bit - bucket * 32
        let k = str(bucket)
        let val = b["buckets"][k]
        let mask = 1
        let i = 0
        while i < offset
            mask = mask * 2
            i = i + 1
        b["buckets"][k] = val - mask
        b["count"] = b["count"] - 1
    b

fn bs_count(b: dict) -> int
    b["count"]
