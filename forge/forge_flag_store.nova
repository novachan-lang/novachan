// forge_flag_store — feature flag management with rollout percentages and Result API.

fn fs_new() -> dict
    {"flags": {}, "rollouts": {}, "count": 0, "check_count": 0}

fn fs_create(f: dict, name: string, enabled: int) -> dict
    let fk = "f_" + name
    if fk not in f["flags"]
        f["count"] += 1
    f["flags"][fk] = "on" if enabled == 1 else "off"
    let rk = "r_" + name
    f["rollouts"][rk] = 100
    f

fn fs_set_rollout(f: dict, name: string, percent: int) -> Result
    let fk = "f_" + name
    if fk not in f["flags"]
        return err("flag not found")
    let rk = "r_" + name
    f["rollouts"][rk] = percent
    ok(f)

fn fs_is_enabled(f: dict, name: string, user_hash: int) -> int
    f["check_count"] += 1
    let fk = "f_" + name
    if fk not in f["flags"]
        return 0
    if f["flags"][fk] != "on"
        return 0
    let rk = "r_" + name
    let rollout = f["rollouts"][rk]
    let bucket = user_hash % 100
    if bucket < rollout
        return 1
    0

fn fs_toggle(f: dict, name: string) -> Result
    let fk = "f_" + name
    if fk not in f["flags"]
        return err("flag not found")
    f["flags"][fk] = "off" if f["flags"][fk] == "on" else "on"
    ok(f)

fn fs_flag_count(f: dict) -> int
    f["count"]

fn fs_check_count(f: dict) -> int
    f["check_count"]
