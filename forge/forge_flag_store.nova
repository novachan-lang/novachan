// forge_flag_store — feature flag management with rollout percentages and Result API.

fn fs_new() -> dict
    let f = {}
    f["flags"] = {}
    f["rollouts"] = {}
    f["count"] = 0
    f["check_count"] = 0
    f

fn fs_create(f: dict, name: string, enabled: int) -> dict
    let fk = "f_" + name
    if contains(f["flags"], fk) != true
        f["count"] = f["count"] + 1
    if enabled == 1
        f["flags"][fk] = "on"
    else
        f["flags"][fk] = "off"
    let rk = "r_" + name
    f["rollouts"][rk] = 100
    f

fn fs_set_rollout(f: dict, name: string, percent: int) -> Result
    let fk = "f_" + name
    if contains(f["flags"], fk) != true
        return err("flag not found")
    let rk = "r_" + name
    f["rollouts"][rk] = percent
    ok(f)

fn fs_is_enabled(f: dict, name: string, user_hash: int) -> int
    f["check_count"] = f["check_count"] + 1
    let fk = "f_" + name
    if contains(f["flags"], fk) != true
        return 0
    if f["flags"][fk] != "on"
        return 0
    let rk = "r_" + name
    let rollout = f["rollouts"][rk]
    let bucket = user_hash % 100
    if bucket < rollout
        return 1
    0

fn fs_toggle(f: dict, name: string) -> Result
    let fk = "f_" + name
    if contains(f["flags"], fk) != true
        return err("flag not found")
    if f["flags"][fk] == "on"
        f["flags"][fk] = "off"
    else
        f["flags"][fk] = "on"
    ok(f)

fn fs_flag_count(f: dict) -> int
    f["count"]

fn fs_check_count(f: dict) -> int
    f["check_count"]
