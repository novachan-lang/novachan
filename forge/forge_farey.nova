// forge_farey -- Farey sequences and the MEDIANT operation. The Farey sequence F_n is every fraction in [0,1] in
// lowest terms with denominator at most n, listed in increasing order (F_5 = 0/1, 1/5, 1/4, 1/3, 2/5, 1/2, 3/5,
// 2/3, 3/4, 4/5, 1/1). Its magic is that consecutive terms a/b < c/d always satisfy bc - ad = 1, and the next
// simplest fraction between them is their MEDIANT (a+c)/(b+d) -- which is how you insert a new value into a sorted
// set of fractions using the SMALLEST possible new denominator. This underlies best-rational-approximation with a
// bounded denominator, "simplest fraction in an interval" queries, the Stern-Brocot tree, rational clocking/gear
// ratios, and Ford-circle geometry. The sequence is generated in O(1) per term by a neat neighbor recurrence (no
// sorting, no gcd per term), and its length is 1 + sum of Euler's totient. Pure integer arithmetic. LEAF.

// The mediant of two fractions a/b and c/d: (a+c)/(b+d). It always lies strictly between them (for positive
// fractions) and, when they are Farey neighbors, is the unique simplest fraction between them.
fn mediant(a: int, b: int, c: int, d: int) -> list
    [a + c, b + d]

// The Farey sequence F_n as a list of [numerator, denominator] pairs in increasing order (from 0/1 to 1/1).
fn farey(n: int) -> list
    let result = []
    push(result, [0, 1])
    if n >= 1
        let a = 0
        let b = 1
        let c = 1
        let d = n
        push(result, [c, d])
        let go = true
        while go
            if c == 1 and d == 1
                go = false
            else
                let k = (n + b) / d
                let p = k * c - a
                let q = k * d - b
                push(result, [p, q])
                a = c
                b = d
                c = p
                d = q
    result

// PRIVATE: Euler's totient of k (count of integers in 1..k coprime to k).
fn _fy_totient(k: int) -> int
    let result = k
    let p = 2
    let m = k
    while p * p <= m
        if m % p == 0
            while m % p == 0
                m = m / p
            result -= result / p
        p += 1
    if m > 1
        result -= result / m
    result

// The number of terms in F_n (= 1 + sum of Euler's totient from 1 to n), without materializing the sequence.
fn farey_count(n: int) -> int
    let count = 1
    for k in 1..(n + 1)
        count += _fy_totient(k)
    count
