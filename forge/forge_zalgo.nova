// forge_zalgo -- the Z-algorithm: for each position i, the length of the longest substring starting at i that
// ALSO matches a prefix of the string. This "Z-array" is computed in linear O(n) by keeping a [l, r) window -- the
// rightmost prefix-match found so far -- and reusing values inside it instead of recomparing from scratch. It's a
// cousin of KMP (forge_kmp): concatenating pattern + separator + text and running the Z-function turns
// prefix-match lengths into occurrences (any position whose Z-value equals the pattern length is a match), giving
// O(n+m) substring search. The Z-array is also directly useful: it reveals all the string's borders/periods, the
// longest prefix that reappears, and powers string-compression and repetition analysis. LEAF -- imports NOTHING.

// The Z-array of s: z[i] = length of the longest common prefix of s and s[i..]. By convention z[0] = 0.
fn z_function(s: string) -> list
    let n = len(s)
    let z = [0 for i in 0..n]
    let l = 0
    let r = 0
    let k = 1
    while k < n
        if k < r
            let cand = r - k
            if z[k - l] < cand
                z[k] = z[k - l]
            else
                z[k] = cand
        while k + z[k] < n and char_at(s, z[k]) == char_at(s, k + z[k])
            z[k] = z[k] + 1
        if k + z[k] > r
            l = k
            r = k + z[k]
        k += 1
    z

// The index of the FIRST occurrence of pattern in text via the Z-algorithm, or -1 if absent. Empty pattern -> 0.
fn z_search(text: string, pattern: string) -> int
    let m = len(pattern)
    let out = 0 - 1
    if m == 0
        out = 0
    else
        // separator chr(1) cannot appear in normal text; guarantees no cross-boundary match
        let combined = pattern + chr(1) + text
        let z = z_function(combined)
        let i = m + 1
        while i < len(combined) and out < 0
            if z[i] >= m
                out = i - m - 1
            i += 1
    out

// Every start index where pattern occurs in text (overlapping included), ascending.
fn z_find_all(text: string, pattern: string) -> list
    let m = len(pattern)
    let out = []
    if m > 0
        let combined = pattern + chr(1) + text
        let z = z_function(combined)
        let i = m + 1
        while i < len(combined)
            if z[i] >= m
                push(out, i - m - 1)
            i += 1
    out

// The length of the longest proper prefix of s that appears again later in s (0 if none). Useful for detecting
// self-similarity / repeats.
fn longest_repeated_prefix(s: string) -> int
    let z = z_function(s)
    let best = 0
    for i in 1..len(z)
        if z[i] > best
            best = z[i]
    best
