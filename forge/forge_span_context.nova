// forge_span_context — Distributed tracing span context.
// Create/nest spans, record events, propagate trace context.

fn span_new(trace_id: string, name: string) -> dict
    {"trace_id": trace_id, "span_id": name, "parent_id": "", "name": name, "start_time": 0, "end_time": 0, "status": "unset", "events": [], "attributes": {}, "children": []}

fn span_start(s: dict, time: int) -> dict
    s["start_time"] = time
    s["status"] = "active"
    s

fn span_end(s: dict, time: int) -> dict
    s["end_time"] = time
    s["status"] = "ended"
    s

fn span_set_error(s: dict, msg: string) -> dict
    s["status"] = "error"
    s["attributes"]["error"] = msg
    s

fn span_add_event(s: dict, name: string, time: int) -> dict
    push(s["events"], {"name": name, "time": time})
    s

fn span_set_attr(s: dict, key: string, value: string) -> dict
    s["attributes"][key] = value
    s

fn span_child(parent: dict, name: string) -> dict
    let child = span_new(parent["trace_id"], name)
    child["parent_id"] = parent["span_id"]
    push(parent["children"], name)
    child

fn span_duration(s: dict) -> int
    if s["end_time"] == 0
        return 0
    s["end_time"] - s["start_time"]

fn span_event_count(s: dict) -> int
    len(s["events"])

fn span_child_count(s: dict) -> int
    len(s["children"])

fn span_is_root(s: dict) -> int
    if s["parent_id"] == ""
        return 1
    0

fn span_trace_header(s: dict) -> string
    let tid = s["trace_id"]
    let sid = s["span_id"]
    "{tid}-{sid}"
