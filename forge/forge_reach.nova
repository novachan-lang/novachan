// forge_reach -- reachability in a DIRECTED graph: starting from a node, which nodes can you eventually get to by
// following the arrows? This is the transitive-closure / "who depends on / who can influence whom" question that
// shows up constantly: which tasks are downstream of a change, which packages a build must pull in, whether one
// account can reach another in a permission or trust graph, which states a state machine can still enter, and
// the "does A eventually lead to B" test in any dependency, call, or flow graph. It BFS-follows the out-edges
// from a start node to collect everything reachable (transitively, not just direct neighbours). Directed edges
// are [from, to] with string node ids. LEAF -- imports NOTHING.

// PRIVATE: directed adjacency (node -> out-neighbor list).
fn _r_adj(edges: list) -> dict
    let adj = {}
    let e = 0
    while e < len(edges)
        let u = edges[e][0]
        let v = edges[e][1]
        if contains(adj, u) == false
            adj[u] = []
        push(adj[u], v)
        e = e + 1
    adj

// PRIVATE: BFS the reachable set from `start` over an adjacency dict; returns the visited-set dict.
fn _r_bfs(adj: dict, start) -> dict
    let visited = {}
    let queue = []
    push(queue, start)
    visited[start] = 1
    let qi = 0
    while qi < len(queue)
        let v = queue[qi]
        qi = qi + 1
        let nb = get(adj, v, [])
        let j = 0
        while j < len(nb)
            if contains(visited, nb[j]) == false
                visited[nb[j]] = 1
                push(queue, nb[j])
            j = j + 1
    visited

// All nodes reachable FROM `start` by following directed edges (transitively), excluding start itself unless a
// cycle leads back to it.
fn reachable_from(edges: list, start) -> list
    let adj = _r_adj(edges)
    let visited = _r_bfs(adj, start)
    let out = []
    let ks = keys(visited)
    let i = 0
    while i < len(ks)
        if ks[i] != start
            push(out, ks[i])
        i = i + 1
    out

// True if there is a directed path from u to v (v is reachable from u). u can always reach itself.
fn can_reach(edges: list, u, v) -> bool
    let out = false
    if u == v
        out = true
    else
        let adj = _r_adj(edges)
        let visited = _r_bfs(adj, u)
        out = contains(visited, v)
    out

// The number of nodes reachable from `start` (not counting start).
fn reachable_count(edges: list, start) -> int
    len(reachable_from(edges, start))
