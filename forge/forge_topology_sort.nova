// forge_topology_sort — Topological sort (Kahn's algorithm, flat dict).

fn ts_new() -> dict
    {"nodes": {}, "edges": {}, "node_count": 0, "edge_count": 0}

fn ts_add_node(t: dict, name: string) -> dict
    if name in t["nodes"]
        return t
    t["nodes"][name] = t["node_count"]
    t["node_count"] += 1
    t

fn ts_add_edge(t: dict, from_n: string, to_n: string) -> dict
    let k = str(t["edge_count"])
    t["edges"]["{k}_from"] = from_n
    t["edges"]["{k}_to"] = to_n
    t["edge_count"] += 1
    t

fn ts_in_degree(t: dict, node: string) -> int
    let count = 0
    for i in 0..t["edge_count"]
        if t["edges"]["{i}_to"] == node
            count += 1
    count

fn ts_sort(t: dict) -> dict
    let result = {}
    let sorted_count = 0
    let done = {}
    let remaining = t["node_count"]
    while remaining > 0
        let found_one = 0
        let nks = keys(t["nodes"])
        for i in 0..len(nks)
            let n = nks[i]
            if n not in done
                let indeg = 0
                for j in 0..t["edge_count"]
                    let k = str(j)
                    if t["edges"]["{k}_to"] == n
                        if t["edges"]["{k}_from"] not in done
                            indeg += 1
                if indeg == 0
                    result[str(sorted_count)] = n
                    sorted_count += 1
                    done[n] = 1
                    remaining -= 1
                    found_one = 1
        if found_one == 0
            result["has_cycle"] = 1
            result["count"] = sorted_count
            return result
    result["has_cycle"] = 0
    result["count"] = sorted_count
    result

fn ts_node_count(t: dict) -> int
    t["node_count"]

fn ts_edge_count(t: dict) -> int
    t["edge_count"]
