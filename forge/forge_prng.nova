// forge_prng -- a SEEDABLE, DETERMINISTIC pseudo-random number generator. Given the same seed it always produces
// the exact same stream of "random" numbers, which is the whole point: reproducible simulations and Monte-Carlo
// runs, deterministic unit tests that still exercise randomness, procedural generation (same seed -> same
// dungeon/terrain/name), randomized algorithms you can replay and debug, and shareable "daily puzzle" seeds. This
// is the opposite of a cryptographic RNG (forge_random_pick draws unpredictable bytes from the OS) -- here
// predictability is the feature, not a flaw, so do NOT use it for passwords, tokens or keys. It's a fast xorshift32
// generator (full 32-bit period) exposing the usual conveniences: a raw next value, a uniform integer in a range,
// a coin flip, a Fisher-Yates shuffle, sampling without replacement, and a random choice -- all driven off one
// seed you control. The generator state is a small list you thread through the calls. LEAF -- imports NOTHING.

// PRIVATE: one xorshift32 step on a 32-bit non-negative state.
fn _prng_step(x: int) -> int
    let v = x
    v = v ^ ((v << 13) & 4294967295)
    v = v ^ (v >> 17)
    v = v ^ ((v << 5) & 4294967295)
    v = v & 4294967295
    v

// A new generator seeded with `seed` (0 is remapped since xorshift can't start at zero). Pass the returned state to
// the other functions; they advance it in place.
fn prng_new(seed: int) -> list
    let s = seed & 4294967295
    if s == 0
        s = 2463534242
    [s]

// The next raw pseudo-random value (a 32-bit non-negative integer), advancing the generator.
fn prng_next(rng: list) -> int
    rng[0] = _prng_step(rng[0])
    rng[0]

// A uniform pseudo-random integer in [lo, hi] inclusive (advances the generator).
fn prng_int(rng: list, lo: int, hi: int) -> int
    let span = hi - lo + 1
    let out = lo
    if span > 0
        out = lo + (prng_next(rng) % span)
    out

// A pseudo-random coin flip: true or false.
fn prng_bool(rng: list) -> bool
    (prng_next(rng) & 1) == 1

// A shuffled COPY of `items` (Fisher-Yates using this generator). Same seed -> same shuffle.
fn prng_shuffle(rng: list, items: list) -> list
    let out = [items[i] for i in 0..len(items)]
    let j = len(out) - 1
    while j > 0
        let k = prng_int(rng, 0, j)
        let t = out[j]
        out[j] = out[k]
        out[k] = t
        j -= 1
    out

// A random single element of `items` (items must be non-empty).
fn prng_choice(rng: list, items: list)
    items[prng_int(rng, 0, len(items) - 1)]

// `k` distinct items sampled without replacement (fewer if k > len). Deterministic for a given seed.
fn prng_sample(rng: list, items: list, k: int) -> list
    let shuffled = prng_shuffle(rng, items)
    let out = [shuffled[i] for i in 0..min(len(shuffled), k)]
    out
