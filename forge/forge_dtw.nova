// forge_dtw -- Dynamic Time Warping: measure how similar two SEQUENCES are even when they run at different
// speeds or are shifted in time. A plain point-by-point (Euclidean) comparison fails the moment one signal lags
// or stretches; DTW finds the best non-linear alignment between the two series and reports the leftover
// distance. This is the standard tool for matching time series and shaped signals: sensor/IoT traces, stock
// patterns, gesture and handwriting recognition, speech/audio templates, and "find the most similar historical
// series". It fills a dynamic-programming table where each cell is the local distance plus the cheapest way to
// reach it (from the left, below, or diagonal), so a repeated or slow stretch in one series is aligned for
// (almost) free. Sequences are lists of numbers; the distance is 0 for identical series and grows with
// mismatch. LEAF -- imports NOTHING.

// PRIVATE: absolute value of a float.
fn _dtw_abs(x: float) -> float
    -x if x < 0.0 else x

// The DTW distance between two numeric sequences (the total local distance along the best alignment path).
// 0.0 for identical sequences; symmetric; non-negative.
fn dtw_distance(a: list, b: list) -> float
    let n = len(a)
    let m = len(b)
    let out = 0.0
    if n > 0 and m > 0
        let cols = m + 1
        // flat (n+1)*(m+1) DP table (1D avoids nested-list writes); init all to a large sentinel
        let INF = 1000000000.0
        let sz = (n + 1) * cols
        let dp = [INF for t in 0..sz]
        dp[0] = 0.0
        for i in 1..(n + 1)
            let ai = a[i - 1] * 1.0
            for j in 1..(m + 1)
                let cost = _dtw_abs(ai - b[j - 1] * 1.0)
                let d1 = dp[(i - 1) * cols + j] * 1.0
                let d2 = dp[i * cols + (j - 1)] * 1.0
                let d3 = dp[(i - 1) * cols + (j - 1)] * 1.0
                dp[i * cols + j] = cost + min(d1, min(d2, d3))
        out = dp[n * cols + m] * 1.0
    out

// DTW distance normalized by the combined sequence length (len(a)+len(b)) -- comparable across different-length
// pairs. 0.0 if either sequence is empty.
fn dtw_normalized(a: list, b: list) -> float
    let d = dtw_distance(a, b)
    let total = len(a) + len(b)
    d / (total * 1.0) if total > 0 else 0.0

// True if two sequences are within `tolerance` DTW distance of each other (a similarity threshold test).
fn dtw_similar(a: list, b: list, tolerance: float) -> bool
    let d = dtw_distance(a, b)
    d <= tolerance * 1.0
