// forge_delayed_queue — Messages delivered after a delay.

fn dq_new() -> dict
    let d = {}
    d["msgs"] = {}
    d["msg_count"] = 0
    d["delivered"] = 0
    d

fn dq_enqueue(d: dict, payload: string, deliver_at: int) -> dict
    let k = str(d["msg_count"])
    d["msgs"][k + "_payload"] = payload
    d["msgs"][k + "_deliver_at"] = deliver_at
    d["msgs"][k + "_delivered"] = 0
    d["msg_count"] = d["msg_count"] + 1
    d

fn dq_poll(d: dict, now: int) -> dict
    let result = {}
    let best_idx = -1
    let best_time = 999999999
    let i = 0
    while i < d["msg_count"]
        let k = str(i)
        if d["msgs"][k + "_delivered"] == 0
            let t = d["msgs"][k + "_deliver_at"]
            if t <= now
                if t < best_time
                    best_time = t
                    best_idx = i
        i = i + 1
    if best_idx == -1
        result["found"] = 0
        result["payload"] = ""
        result["d"] = d
        return result
    let bk = str(best_idx)
    result["found"] = 1
    result["payload"] = d["msgs"][bk + "_payload"]
    d["msgs"][bk + "_delivered"] = 1
    d["delivered"] = d["delivered"] + 1
    result["d"] = d
    result

fn dq_pending_count(d: dict) -> int
    let count = 0
    let i = 0
    while i < d["msg_count"]
        if d["msgs"][str(i) + "_delivered"] == 0
            count = count + 1
        i = i + 1
    count

fn dq_total_delivered(d: dict) -> int
    d["delivered"]

fn dq_next_delivery_time(d: dict) -> int
    let best = 999999999
    let i = 0
    while i < d["msg_count"]
        let k = str(i)
        if d["msgs"][k + "_delivered"] == 0
            let t = d["msgs"][k + "_deliver_at"]
            if t < best
                best = t
        i = i + 1
    if best == 999999999
        return -1
    best
