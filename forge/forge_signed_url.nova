// forge_signed_url -- HMAC-signed, self-expiring URLs and tokens (S3 presigned URLs, Rails signed_id, signed
// download / password-reset / unsubscribe links). Bind a payload + an absolute expiry to an HMAC-SHA-256
// signature so a link is tamper-proof and self-expiring WITHOUT any server-side session state -- the server
// needs only the shared secret to verify. Constant-work signature compare (no timing oracle). Uses the
// hmac_sha256 builtin (hex output). LEAF -- imports NOTHING.

// Constant-time string compare — delegates to the C runtime builtin (optnone).
fn _ct_eq(a: string, b: string) -> bool
    ct_eq(a, b) == 1

// Sign: "<payload>.<expiry>.<sig>", sig = HMAC-SHA-256(secret, payload + "." + expiry). `expiry` is an absolute
// unix-seconds deadline (0 = never expires). The payload MUST be '.'-free (use an opaque id / base32 / ULID).
fn sign_token(secret: string, payload: string, expiry: int) -> string
    let body = payload + "." + str(expiry)
    body + "." + hmac_sha256(secret, body)

// Verify at time `now_seconds`: recompute the signature (tamper check) then enforce the expiry. Returns the
// payload if valid, or "" if malformed / wrong signature / expired. Fails closed.
fn verify_token(secret: string, token: string, now_seconds: int) -> string
    let parts = split(token, ".")
    if len(parts) != 3
        return ""
    let body = parts[0] + "." + parts[1]
    if _ct_eq(parts[2], hmac_sha256(secret, body)) == false
        return ""
    let exp = parse_int(parts[1])
    if exp != 0 and now_seconds > exp
        return ""
    parts[0]

// Append a signed token to a base URL as t=<token> (choosing ? or & correctly). The full "presigned URL".
fn signed_url(base_url: string, secret: string, payload: string, expiry: int) -> string
    let sep = "?"
    if find(base_url, "?") >= 0
        sep = "&"
    base_url + sep + "t=" + sign_token(secret, payload, expiry)
