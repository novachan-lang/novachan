// forge_basic_auth -- HTTP Basic + Bearer authorization header encode/decode (RFC 7617/6750). Build
// "Basic <base64(user:password)>" for a client request; parse an inbound Authorization header back to
// [user, password]; and extract a Bearer token. Complements JWT/session auth for service-to-service +
// legacy endpoints. Uses base64_encode/base64_decode builtins. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. basic_auth_header used multi-part concat. Interpolation.
//   2. `starts_with(...) == false` at two sites. `not starts_with(...)`.
//   3. basic_auth_parse string concat for credential pair. Interpolation.

fn basic_auth_header(user: string, password: string) -> string
    let encoded = base64_encode("{user}:{password}")
    "Basic {encoded}"

fn basic_auth_parse(header: string) -> list
    let h = trim(header)
    if not starts_with(h, "Basic ")
        return []
    let decoded = base64_decode(trim(slice(h, 6, len(h))))
    let colon = find(decoded, ":")
    if colon < 0
        return []
    [slice(decoded, 0, colon), slice(decoded, colon + 1, len(decoded))]

fn bearer_from_header(header: string) -> string
    let h = trim(header)
    if not starts_with(h, "Bearer ")
        return ""
    trim(slice(h, 7, len(h)))
