// forge_canary_release — Canary release management.
// Track canary deployments, traffic weight, metrics, promotion/rollback.

fn cr_new(version: string) -> dict
    let cr = {}
    cr["version"] = version
    cr["status"] = "pending"
    cr["weight"] = 0
    cr["metrics"] = []
    cr["error_count"] = 0
    cr["success_count"] = 0
    cr["threshold"] = 5
    cr

fn cr_start(cr: dict, initial_weight: int) -> dict
    cr["status"] = "active"
    cr["weight"] = initial_weight
    cr

fn cr_set_weight(cr: dict, weight: int) -> dict
    cr["weight"] = weight
    cr

fn cr_set_threshold(cr: dict, max_errors: int) -> dict
    cr["threshold"] = max_errors
    cr

fn cr_record_success(cr: dict) -> dict
    cr["success_count"] = cr["success_count"] + 1
    let m = {}
    m["type"] = "success"
    push(cr["metrics"], m)
    cr

fn cr_record_error(cr: dict) -> dict
    cr["error_count"] = cr["error_count"] + 1
    let m = {}
    m["type"] = "error"
    push(cr["metrics"], m)
    if cr["error_count"] >= cr["threshold"]
        cr["status"] = "failed"
    cr

fn cr_promote(cr: dict) -> dict
    cr["status"] = "promoted"
    cr["weight"] = 100
    cr

fn cr_rollback(cr: dict) -> dict
    cr["status"] = "rolled_back"
    cr["weight"] = 0
    cr

fn cr_status(cr: dict) -> string
    cr["status"]

fn cr_weight(cr: dict) -> int
    cr["weight"]

fn cr_error_rate(cr: dict) -> int
    let total = cr["success_count"] + cr["error_count"]
    if total == 0
        return 0
    cr["error_count"] * 100 / total

fn cr_total_requests(cr: dict) -> int
    cr["success_count"] + cr["error_count"]

fn cr_should_promote(cr: dict, min_requests: int, max_error_pct: int) -> int
    let total = cr_total_requests(cr)
    if total < min_requests
        return 0
    let err_pct = cr_error_rate(cr)
    if err_pct > max_error_pct
        return 0
    1
