// forge_canary_release — canary deployment with traffic splitting, Result API.

fn cr_new() -> dict
    let c = {}
    c["stable_version"] = ""
    c["canary_version"] = ""
    c["canary_pct"] = 0
    c["canary_requests"] = 0
    c["canary_errors"] = 0
    c["stable_requests"] = 0
    c["stable_errors"] = 0
    c["promoted"] = 0
    c

fn cr_set_stable(c: dict, version: string) -> dict
    c["stable_version"] = version
    c

fn cr_start_canary(c: dict, version: string, pct: int) -> Result
    if c["stable_version"] == ""
        return err("no stable version set")
    if pct < 1 or pct > 100
        return err("percentage must be 1-100")
    c["canary_version"] = version
    c["canary_pct"] = pct
    c["canary_requests"] = 0
    c["canary_errors"] = 0
    ok(c)

fn cr_route(c: dict, request_hash: int) -> string
    if c["canary_version"] == ""
        return c["stable_version"]
    let bucket = request_hash % 100
    if bucket < c["canary_pct"]
        return c["canary_version"]
    c["stable_version"]

fn cr_record_canary(c: dict, success: int) -> dict
    c["canary_requests"] = c["canary_requests"] + 1
    if success == 0
        c["canary_errors"] = c["canary_errors"] + 1
    c

fn cr_record_stable(c: dict, success: int) -> dict
    c["stable_requests"] = c["stable_requests"] + 1
    if success == 0
        c["stable_errors"] = c["stable_errors"] + 1
    c

fn cr_canary_error_rate(c: dict) -> int
    if c["canary_requests"] == 0
        return 0
    c["canary_errors"] * 100 / c["canary_requests"]

fn cr_promote(c: dict) -> Result
    if c["canary_version"] == ""
        return err("no canary running")
    c["stable_version"] = c["canary_version"]
    c["canary_version"] = ""
    c["canary_pct"] = 0
    c["promoted"] = c["promoted"] + 1
    ok(c)

fn cr_abort(c: dict) -> Result
    if c["canary_version"] == ""
        return err("no canary to abort")
    c["canary_version"] = ""
    c["canary_pct"] = 0
    ok(c)

fn cr_is_canary_active(c: dict) -> int
    if c["canary_version"] != ""
        return 1
    0

fn cr_total_promoted(c: dict) -> int
    c["promoted"]
