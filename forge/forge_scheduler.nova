// forge_scheduler — Periodic task scheduler (cron-like).
// Define recurring tasks, check which are due, manage execution.

fn sched_new() -> dict
    let s = {}
    s["tasks"] = []
    s["history"] = []
    s

fn sched_add(sched: dict, name: string, interval_s: int) -> dict
    let task = {}
    task["name"] = name
    task["interval"] = interval_s
    task["last_run"] = 0
    task["enabled"] = true
    task["run_count"] = 0
    push(sched["tasks"], task)
    sched

fn sched_disable(sched: dict, name: string) -> dict
    let i = 0
    while i < len(sched["tasks"])
        if sched["tasks"][i]["name"] == name
            sched["tasks"][i]["enabled"] = false
        i = i + 1
    sched

fn sched_enable(sched: dict, name: string) -> dict
    let i = 0
    while i < len(sched["tasks"])
        if sched["tasks"][i]["name"] == name
            sched["tasks"][i]["enabled"] = true
        i = i + 1
    sched

fn sched_due(sched: dict, now: int) -> list
    let due = []
    let i = 0
    while i < len(sched["tasks"])
        let t = sched["tasks"][i]
        if t["enabled"] == true
            let elapsed = now - t["last_run"]
            if elapsed >= t["interval"]
                push(due, t["name"])
        i = i + 1
    due

fn sched_mark_run(sched: dict, name: string, now: int) -> dict
    let i = 0
    while i < len(sched["tasks"])
        if sched["tasks"][i]["name"] == name
            sched["tasks"][i]["last_run"] = now
            sched["tasks"][i]["run_count"] = sched["tasks"][i]["run_count"] + 1
            let entry = {}
            entry["name"] = name
            entry["at"] = now
            push(sched["history"], entry)
        i = i + 1
    sched

fn sched_remove(sched: dict, name: string) -> dict
    let new_tasks = []
    let i = 0
    while i < len(sched["tasks"])
        if sched["tasks"][i]["name"] != name
            push(new_tasks, sched["tasks"][i])
        i = i + 1
    sched["tasks"] = new_tasks
    sched

fn sched_list(sched: dict) -> list
    let result = []
    let i = 0
    while i < len(sched["tasks"])
        let t = sched["tasks"][i]
        push(result, t["name"])
        i = i + 1
    result

fn sched_next_run(sched: dict, name: string) -> int
    let i = 0
    while i < len(sched["tasks"])
        let t = sched["tasks"][i]
        if t["name"] == name
            return t["last_run"] + t["interval"]
        i = i + 1
    0
