// forge_scheduler — Periodic task scheduler (cron-like).
// Define recurring tasks, check which are due, manage execution.

fn sched_new() -> dict
    {"tasks": [], "history": []}

fn sched_add(sched: dict, name: string, interval_s: int) -> dict
    push(sched["tasks"], {"name": name, "interval": interval_s, "last_run": 0, "enabled": true, "run_count": 0})
    sched

fn sched_disable(sched: dict, name: string) -> dict
    for i in 0..len(sched["tasks"])
        if sched["tasks"][i]["name"] == name
            sched["tasks"][i]["enabled"] = false
    sched

fn sched_enable(sched: dict, name: string) -> dict
    for i in 0..len(sched["tasks"])
        if sched["tasks"][i]["name"] == name
            sched["tasks"][i]["enabled"] = true
    sched

fn sched_due(sched: dict, now: int) -> list
    [t["name"] for t in sched["tasks"] if t["enabled"] == true and now - t["last_run"] >= t["interval"]]

fn sched_mark_run(sched: dict, name: string, now: int) -> dict
    for i in 0..len(sched["tasks"])
        if sched["tasks"][i]["name"] == name
            sched["tasks"][i]["last_run"] = now
            sched["tasks"][i]["run_count"] += 1
            push(sched["history"], {"name": name, "at": now})
    sched

fn sched_remove(sched: dict, name: string) -> dict
    sched["tasks"] = [t for t in sched["tasks"] if t["name"] != name]
    sched

fn sched_list(sched: dict) -> list
    [t["name"] for t in sched["tasks"]]

fn sched_next_run(sched: dict, name: string) -> int
    for t in sched["tasks"]
        if t["name"] == name
            return t["last_run"] + t["interval"]
    0
