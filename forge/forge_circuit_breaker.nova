// forge_circuit_breaker — Circuit breaker pattern for resilience.
// States: closed (normal), open (rejecting), half-open (probing).

fn cb_new(name: string, threshold: int, reset_timeout: int) -> dict
    {"name": name, "state": "closed", "failure_count": 0, "success_count": 0, "threshold": threshold, "reset_timeout": reset_timeout, "last_failure_time": 0, "total_calls": 0, "total_failures": 0}

fn cb_allow(cb: dict, now: int) -> bool
    if cb["state"] == "closed"
        return true
    if cb["state"] == "open"
        let elapsed = now - cb["last_failure_time"]
        if elapsed >= cb["reset_timeout"]
            return true
        return false
    if cb["state"] == "half-open"
        return true
    false

fn cb_record_success(cb: dict) -> dict
    cb["total_calls"] += 1
    cb["success_count"] += 1
    if cb["state"] == "half-open"
        cb["state"] = "closed"
        cb["failure_count"] = 0
    cb

fn cb_record_failure(cb: dict, now: int) -> dict
    cb["total_calls"] += 1
    cb["total_failures"] += 1
    cb["failure_count"] += 1
    cb["last_failure_time"] = now
    if cb["failure_count"] >= cb["threshold"]
        cb["state"] = "open"
    cb

fn cb_try_half_open(cb: dict, now: int) -> dict
    if cb["state"] == "open"
        let elapsed = now - cb["last_failure_time"]
        if elapsed >= cb["reset_timeout"]
            cb["state"] = "half-open"
            cb["failure_count"] = 0
    cb

fn cb_state(cb: dict) -> string
    cb["state"]

fn cb_reset(cb: dict) -> dict
    cb["state"] = "closed"
    cb["failure_count"] = 0
    cb["success_count"] = 0
    cb

fn cb_failure_rate(cb: dict) -> int
    if cb["total_calls"] == 0
        return 0
    (cb["total_failures"] * 100) / cb["total_calls"]

fn cb_stats(cb: dict) -> dict
    {"name": cb["name"], "state": cb["state"], "total_calls": cb["total_calls"], "total_failures": cb["total_failures"], "failure_count": cb["failure_count"], "failure_rate": cb_failure_rate(cb)}
