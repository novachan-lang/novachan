// forge_object_pool — object pool for resource reuse with Result API.

fn pool_new(max_size: int) -> dict
    let p = {}
    p["items"] = {}
    p["available"] = 0
    p["in_use"] = 0
    p["max_size"] = max_size
    p["total_borrows"] = 0
    p["total_returns"] = 0
    p

fn pool_add(p: dict, item: string) -> Result
    let total = p["available"] + p["in_use"]
    if total >= p["max_size"]
        return err("pool full")
    let key = "itm_" + str(total)
    p["items"][key] = item
    p["items"][key + "_used"] = 0
    p["available"] = p["available"] + 1
    ok(p)

fn pool_borrow(p: dict) -> Result
    if p["available"] == 0
        return err("no available items")
    let i = 0
    let total = p["available"] + p["in_use"]
    while i < total
        let key = "itm_" + str(i)
        if p["items"][key + "_used"] == 0
            p["items"][key + "_used"] = 1
            p["available"] = p["available"] - 1
            p["in_use"] = p["in_use"] + 1
            p["total_borrows"] = p["total_borrows"] + 1
            return ok(p["items"][key])
        i = i + 1
    err("internal error")

fn pool_return_item(p: dict, item: string) -> Result
    let i = 0
    let total = p["available"] + p["in_use"]
    while i < total
        let key = "itm_" + str(i)
        if p["items"][key] == item and p["items"][key + "_used"] == 1
            p["items"][key + "_used"] = 0
            p["in_use"] = p["in_use"] - 1
            p["available"] = p["available"] + 1
            p["total_returns"] = p["total_returns"] + 1
            return ok(p)
        i = i + 1
    err("item not in pool or not in use")

fn pool_available(p: dict) -> int
    p["available"]

fn pool_in_use(p: dict) -> int
    p["in_use"]

fn pool_utilization(p: dict) -> int
    let total = p["available"] + p["in_use"]
    if total == 0
        return 0
    p["in_use"] * 100 / total
