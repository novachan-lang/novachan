// forge_object_pool — object pool for resource reuse with Result API.

fn pool_new(max_size: int) -> dict
    {"items": {}, "available": 0, "in_use": 0, "max_size": max_size, "total_borrows": 0, "total_returns": 0}

fn pool_add(p: dict, item: string) -> Result
    let total = p["available"] + p["in_use"]
    if total >= p["max_size"]
        return err("pool full")
    let ts = str(total)
    let key = "itm_{ts}"
    let uk = "{key}_used"
    p["items"][key] = item
    p["items"][uk] = 0
    p["available"] += 1
    ok(p)

fn pool_borrow(p: dict) -> Result
    if p["available"] == 0
        return err("no available items")
    let total = p["available"] + p["in_use"]
    for i in 0..total
        let ts = str(i)
        let key = "itm_{ts}"
        let uk = "{key}_used"
        if p["items"][uk] == 0
            p["items"][uk] = 1
            p["available"] -= 1
            p["in_use"] += 1
            p["total_borrows"] += 1
            return ok(p["items"][key])
    err("internal error")

fn pool_return_item(p: dict, item: string) -> Result
    let total = p["available"] + p["in_use"]
    for i in 0..total
        let ts = str(i)
        let key = "itm_{ts}"
        let uk = "{key}_used"
        if p["items"][key] == item and p["items"][uk] == 1
            p["items"][uk] = 0
            p["in_use"] -= 1
            p["available"] += 1
            p["total_returns"] += 1
            return ok(p)
    err("item not in pool or not in use")

fn pool_available(p: dict) -> int
    p["available"]

fn pool_in_use(p: dict) -> int
    p["in_use"]

fn pool_utilization(p: dict) -> int
    let total = p["available"] + p["in_use"]
    if total == 0
        return 0
    p["in_use"] * 100 / total
