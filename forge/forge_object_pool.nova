// forge_object_pool — Reusable object pool.

fn op_new(max_size: int) -> dict
    let p = {}
    p["max"] = max_size
    p["objs"] = {}
    p["obj_count"] = 0
    p["status"] = {}
    p["total_acquired"] = 0
    p["total_released"] = 0
    p

fn op_add(p: dict, name: string) -> dict
    if p["obj_count"] >= p["max"]
        return p
    p["objs"][name] = 1
    p["status"][name] = "available"
    p["obj_count"] = p["obj_count"] + 1
    p

fn op_acquire(p: dict) -> dict
    let result = {}
    let ks = keys(p["status"])
    let i = 0
    while i < len(ks)
        if p["status"][ks[i]] == "available"
            p["status"][ks[i]] = "in_use"
            p["total_acquired"] = p["total_acquired"] + 1
            result["ok"] = 1
            result["name"] = ks[i]
            result["p"] = p
            return result
        i = i + 1
    result["ok"] = 0
    result["name"] = ""
    result["p"] = p
    result

fn op_release(p: dict, name: string) -> dict
    let has = contains(p["status"], name)
    if has != true
        return p
    p["status"][name] = "available"
    p["total_released"] = p["total_released"] + 1
    p

fn op_available_count(p: dict) -> int
    let ks = keys(p["status"])
    let count = 0
    let i = 0
    while i < len(ks)
        if p["status"][ks[i]] == "available"
            count = count + 1
        i = i + 1
    count

fn op_in_use_count(p: dict) -> int
    let ks = keys(p["status"])
    let count = 0
    let i = 0
    while i < len(ks)
        if p["status"][ks[i]] == "in_use"
            count = count + 1
        i = i + 1
    count

fn op_total_acquired(p: dict) -> int
    p["total_acquired"]

fn op_utilization(p: dict) -> int
    if p["obj_count"] == 0
        return 0
    op_in_use_count(p) * 100 / p["obj_count"]
