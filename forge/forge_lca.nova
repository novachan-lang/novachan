// forge_lca -- Lowest Common Ancestor queries on a rooted tree using BINARY LIFTING. The LCA of two nodes is
// their deepest shared ancestor -- the point where the paths from each up to the root first meet. It answers
// "what's the nearest common manager of these two employees", "the most recent common ancestor of two species",
// the closest shared category in a taxonomy, and it's the key to computing the DISTANCE between any two nodes in a
// tree in O(log n). Binary lifting precomputes, for every node, its 2^k-th ancestor (its parent, grandparent,
// 4th-up, 8th-up, ...); then any query jumps in powers of two -- first raising the deeper node to the other's
// depth, then lifting both in lockstep until just below their meeting point. Build is O(n log n), each query
// O(log n). The tree is given as an adjacency list plus a root. LEAF -- imports NOTHING.

// Preprocess the tree (n nodes, adjacency list `adj`, given `root`) for LCA queries. Returns an opaque pack to
// pass to lca_query / lca_distance.
fn lca_build(n: int, adj: list, root: int) -> list
    // BFS for parent[] and depth[]
    let parent = []
    let depth = []
    let visited = []
    for z in 0..n
        push(parent, root)
        push(depth, 0)
        push(visited, 0)
    let queue = [root]
    visited[root] = 1
    parent[root] = root
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head += 1
        let nbrs = adj[u]
        for i in 0..len(nbrs)
            let v = nbrs[i]
            if visited[v] == 0
                visited[v] = 1
                parent[v] = u
                depth[v] = depth[u] + 1
                push(queue, v)
    // number of lifting levels
    let LOG = 1
    while (1 << LOG) < n
        LOG += 1
    LOG += 1
    // up[k*n + v] = 2^k-th ancestor of v
    let up = []
    let a = 0
    while a < LOG * n
        push(up, root)
        a += 1
    let v0 = 0
    while v0 < n
        up[v0] = parent[v0]
        v0 += 1
    for k in 1..LOG
        let v = 0
        while v < n
            let mid = up[(k - 1) * n + v]
            up[k * n + v] = up[(k - 1) * n + mid]
            v += 1
    [depth, up, LOG, n]

// The lowest common ancestor of nodes u and v, using a pack from lca_build.
fn lca_query(pack: list, u0: int, v0: int) -> int
    let depth = pack[0]
    let up = pack[1]
    let LOG = pack[2]
    let n = pack[3]
    let u = u0
    let v = v0
    // make u the deeper node
    if depth[u] < depth[v]
        let t = u
        u = v
        v = t
    // lift u up to depth[v]
    let diff = depth[u] - depth[v]
    for k in 0..LOG
        if ((diff >> k) & 1) == 1
            u = up[k * n + u]
    let out = u
    if u != v
        // lift both until their ancestors diverge
        let j = LOG - 1
        while j >= 0
            if up[j * n + u] != up[j * n + v]
                u = up[j * n + u]
                v = up[j * n + v]
            j -= 1
        out = up[u]
    out

// The number of edges on the path between u and v in the tree (their distance), via the LCA.
fn lca_distance(pack: list, u: int, v: int) -> int
    let depth = pack[0]
    let w = lca_query(pack, u, v)
    depth[u] + depth[v] - 2 * depth[w]
