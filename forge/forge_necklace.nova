// forge_necklace -- count the distinct NECKLACES and BRACELETS you can make from beads of k colors on a loop of n
// positions: arrangements considered the same when one is a rotation of another (a necklace), or a rotation OR flip
// of another (a bracelet). This is the classic Burnside / Polya counting problem, and it answers real "how many
// genuinely different..." questions: distinct circular DNA/RNA arrangements, ring and cycle colorings in chemistry
// (isomer counting), rhythmic cycles and modes in music theory, distinct roulette/turntable layouts, and cyclic
// codes. Rotating a loop by every amount and averaging the fixed arrangements (Burnside's lemma) gives the closed
// forms: necklaces number (1/n) * sum over divisors d of n of phi(d) * k^(n/d), and the count of APERIODIC
// necklaces -- exactly the Lyndon words of length n from forge_lyndon -- swaps Euler's phi for the Moebius function.
// Bracelets add the reflection symmetries of the dihedral group. All are exact integer formulas (Euler totient,
// Moebius, integer powers computed inline). Keep n and k modest since the counts, and k^n, grow fast. LEAF.

// PRIVATE: gcd.
fn _nk_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = x % y
        x = y
        y = t
    if x < 0
        x = 0 - x
    x

// PRIVATE: Euler's totient phi(n) -- count of integers in 1..n coprime to n.
fn _nk_totient(n: int) -> int
    let result = n
    let m = n
    let p = 2
    while p * p <= m
        if m % p == 0
            while m % p == 0
                m = m / p
            result = result - result / p
        p = p + 1
    if m > 1
        result = result - result / m
    result

// PRIVATE: Moebius function mu(n).
fn _nk_mobius(n: int) -> int
    let out = 1
    if n <= 0
        out = 0
    else
        let m = n
        let cnt = 0
        let d = 2
        let bad = false
        while d * d <= m and bad == false
            if m % d == 0
                m = m / d
                cnt = cnt + 1
                if m % d == 0
                    bad = true
            d = d + 1
        if bad
            out = 0
        else
            if m > 1
                cnt = cnt + 1
            if cnt % 2 == 0
                out = 1
            else
                out = 0 - 1
    out

// PRIVATE: integer power base^exp (exp >= 0).
fn _nk_ipow(base: int, exp: int) -> int
    let r = 1
    let b = base
    let e = exp
    while e > 0
        if e % 2 == 1
            r = r * b
        b = b * b
        e = e / 2
    r

// The number of distinct NECKLACES of n beads in k colors (arrangements up to rotation), by Burnside:
// (1/n) * sum over divisors d of n of phi(d) * k^(n/d).
fn necklace_count(n: int, k: int) -> int
    let total = 0
    let d = 1
    while d <= n
        if n % d == 0
            total = total + _nk_totient(d) * _nk_ipow(k, n / d)
        d = d + 1
    total / n

// The number of APERIODIC necklaces of n beads in k colors -- equivalently the number of Lyndon words of length n
// (see forge_lyndon): (1/n) * sum over divisors d of n of mu(d) * k^(n/d).
fn aperiodic_necklace_count(n: int, k: int) -> int
    let total = 0
    let d = 1
    while d <= n
        if n % d == 0
            total = total + _nk_mobius(d) * _nk_ipow(k, n / d)
        d = d + 1
    total / n

// The number of distinct BRACELETS of n beads in k colors (arrangements up to rotation AND reflection), using the
// dihedral group in Burnside's lemma: (1/(2n)) * [ necklace sum + reflection sum ].
fn bracelet_count(n: int, k: int) -> int
    // rotation part: sum over divisors of phi(d) * k^(n/d)
    let rot = 0
    let d = 1
    while d <= n
        if n % d == 0
            rot = rot + _nk_totient(d) * _nk_ipow(k, n / d)
        d = d + 1
    // reflection part
    let refl = 0
    if n % 2 == 1
        refl = n * _nk_ipow(k, (n + 1) / 2)
    else
        refl = (n / 2) * (_nk_ipow(k, n / 2) + _nk_ipow(k, n / 2 + 1))
    (rot + refl) / (2 * n)
