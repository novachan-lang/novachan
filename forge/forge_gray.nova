// forge_gray -- Gray code (reflected binary): an ordering of the integers where each successive value differs
// from the previous in EXACTLY ONE bit. Ordinary binary can flip many bits at once (3 = 011 -> 4 = 100 flips
// all three), which in physical hardware causes glitches while the bits settle. Gray code eliminates that: it's
// what rotary/position encoders, ADCs, and Karnaugh maps use so a reading is never momentarily garbage, and it's
// handy for enumerating configurations with a single change at each step (minimal-transition test sequences,
// mechanical dials, error-tolerant counters). encode maps binary->Gray, decode maps back, and gray_sequence
// lists a full single-bit-change cycle. Pure integer bit math, fully reliable. LEAF -- imports NOTHING.

// Convert an integer to its Gray code: n XOR (n >> 1).
fn gray_encode(n: int) -> int
    n ^ (n / 2)

// Convert a Gray code back to the integer it represents.
fn gray_decode(g: int) -> int
    let n = g
    let s = g / 2
    while s > 0
        n = n ^ s
        s = s / 2
    n

// The full Gray-code sequence for `bits` bits: 2^bits values, each differing from the previous (and the last
// from the first) in exactly one bit.
fn gray_sequence(bits: int) -> list
    let out = []
    let count = 1
    let b = 0
    while b < bits
        count = count * 2
        b = b + 1
    let i = 0
    while i < count
        push(out, gray_encode(i))
        i = i + 1
    out

// The number of bits that differ between two integers (Hamming distance) -- 1 for adjacent Gray codes.
fn gray_bitdiff(a: int, b: int) -> int
    let x = a ^ b
    let count = 0
    let v = x
    while v > 0
        count = count + (v & 1)
        v = v / 2
    count
