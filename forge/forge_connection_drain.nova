// forge_connection_drain — Graceful connection draining.
// Track active connections, drain on shutdown, wait for completion.

fn cd_new(max_drain_time: int) -> dict
    {"connections": {}, "draining": 0, "drain_start": 0, "max_drain_time": max_drain_time, "completed": 0, "timed_out": 0}

fn cd_add_conn(cd: dict, conn_id: string, start_time: int) -> dict
    if cd["draining"] == 1
        return cd
    cd["connections"][conn_id] = {"start_time": start_time, "active": 1}
    cd

fn cd_close_conn(cd: dict, conn_id: string) -> dict
    if conn_id not in cd["connections"]
        return cd
    cd["connections"][conn_id]["active"] = 0
    cd["completed"] += 1
    cd

fn cd_start_drain(cd: dict, now: int) -> dict
    cd["draining"] = 1
    cd["drain_start"] = now
    cd

fn cd_active_count(cd: dict) -> int
    let count = 0
    let ids = keys(cd["connections"])
    for i in 0..len(ids)
        if cd["connections"][ids[i]]["active"] == 1
            count += 1
    count

fn cd_is_drained(cd: dict) -> int
    if cd["draining"] != 1
        return 0
    if cd_active_count(cd) == 0
        return 1
    0

fn cd_is_timed_out(cd: dict, now: int) -> int
    if cd["draining"] != 1
        return 0
    let elapsed = now - cd["drain_start"]
    if elapsed >= cd["max_drain_time"]
        return 1
    0

fn cd_force_close_all(cd: dict) -> dict
    let ids = keys(cd["connections"])
    for i in 0..len(ids)
        if cd["connections"][ids[i]]["active"] == 1
            cd["connections"][ids[i]]["active"] = 0
            cd["timed_out"] += 1
    cd

fn cd_is_draining(cd: dict) -> int
    cd["draining"]

fn cd_total_completed(cd: dict) -> int
    cd["completed"]

fn cd_total_timed_out(cd: dict) -> int
    cd["timed_out"]

fn cd_total_connections(cd: dict) -> int
    len(keys(cd["connections"]))
