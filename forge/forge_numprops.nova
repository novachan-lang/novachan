// forge_numprops -- classic integer PROPERTIES and predicates: digit sum, digital root, and tests for perfect,
// Armstrong (narcissistic), happy, palindromic, and triangular numbers. Beyond puzzles and education, several
// are genuinely practical: digital_root is the "casting out nines" checksum used to sanity-check arithmetic and
// some ID schemes; palindrome and digit-sum tests show up in validation and number formatting; perfect/triangular
// appear in scoring, tiling, and combinatorics. All are simple, exact integer routines. LEAF -- imports NOTHING.

// The sum of the decimal digits of n (uses |n|).
fn digit_sum(n: int) -> int
    let m = n
    if m < 0
        m = -m
    let s = 0
    if m == 0
        return 0
    while m > 0
        s += m % 10
        m /= 10
    s

// The digital root: repeatedly sum the digits until one digit remains (equivalently 1 + (n-1) mod 9 for n>0).
fn digital_root(n: int) -> int
    let m = n
    if m < 0
        m = -m
    while m >= 10
        m = digit_sum(m)
    m

// True if n equals the sum of its proper divisors (6, 28, 496, 8128, ...).
fn is_perfect(n: int) -> bool
    let out = false
    if n > 1
        let sum = 1
        let d = 2
        while d * d <= n
            if n % d == 0
                sum += d
                let other = n / d
                if other != d
                    sum += other
            d += 1
        if sum == n
            out = true
    out

// True if n equals the sum of its own digits each raised to the power of the digit count (153, 370, 371, 9474).
fn is_armstrong(n: int) -> bool
    let out = false
    if n >= 0
        // count digits
        let ndig = 0
        let t = n
        if t == 0
            ndig = 1
        while t > 0
            ndig += 1
            t /= 10
        // sum of digit^ndig
        let sum = 0
        let m = n
        if m == 0
            sum = 0
        while m > 0
            let dig = m % 10
            let p = 1
            for e in 0..ndig
                p *= dig
            sum += p
            m /= 10
        if sum == n
            out = true
    out

// True if repeatedly replacing n with the sum of the squares of its digits eventually reaches 1 (else it loops).
fn is_happy(n: int) -> bool
    let m = n
    let seen = {}
    let out = false
    let going = true
    while going
        if m == 1
            out = true
            going = false
        else
            let key = str(m)
            if key in seen
                going = false
            else
                seen[key] = 1
                let s = 0
                let t = m
                while t > 0
                    let dig = t % 10
                    s += dig * dig
                    t = t / 10
                m = s
    out

// True if n reads the same forwards and backwards in decimal (negatives are never palindromes).
fn is_palindrome_number(n: int) -> bool
    let out = false
    if n >= 0
        let m = n
        let rev = 0
        while m > 0
            rev = rev * 10 + m % 10
            m /= 10
        out = rev == n
    out

// True if n is a triangular number k*(k+1)/2 for some k >= 0 (0,1,3,6,10,15,...).
fn is_triangular(n: int) -> bool
    let out = false
    if n == 0
        out = true
    if n > 0
        let t = 0
        let k = 1
        let going = true
        while going
            t += k
            if t == n
                out = true
                going = false
            else if t > n
                going = false
            k += 1
    out

// The number of decimal digits in n (its absolute value); digit_count(0) = 1.
fn digit_count(n: int) -> int
    let v = n
    if v < 0
        v = -v
    let count = 1
    while v >= 10
        v /= 10
        count += 1
    count

// n with its decimal digits reversed (sign preserved). reverse_digits(1230) = 321, reverse_digits(-45) = -54.
fn reverse_digits(n: int) -> int
    let neg = false
    let v = n
    if v < 0
        neg = true
        v = -v
    let rev = 0
    while v > 0
        rev = rev * 10 + (v % 10)
        v /= 10
    if neg
        rev = -rev
    rev

// The k-th decimal digit of n counting from the RIGHT, 0-indexed (nth_digit(4567, 0) = 7, nth_digit(4567, 2) = 5);
// 0 if k is beyond the number's length.
fn nth_digit(n: int, k: int) -> int
    let v = n
    if v < 0
        v = -v
    for i in 0..k
        v /= 10
    v % 10
