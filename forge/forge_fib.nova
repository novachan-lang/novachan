// forge_fib -- the Fibonacci and Lucas number sequences, and a test for whether a number is Fibonacci. Fibonacci
// (0,1,1,2,3,5,8,13,...) -- each term the sum of the previous two -- is the classic model of natural growth and
// shows up in phyllotaxis and spirals, the golden-ratio proportions used in design and UI layout, algorithm
// analysis (Fibonacci heaps, the worst case of the Euclidean gcd), Fibonacci retracement levels in trading, and
// countless coding exercises. Lucas numbers (2,1,3,4,7,11,...) follow the same rule from different seeds and
// pair with Fibonacci in many identities. Computed iteratively (exact for n up to 92; F(93) overflows a 64-bit
// integer). LEAF -- imports NOTHING.

// The n-th Fibonacci number (0-indexed: F(0)=0, F(1)=1, F(2)=1, ...). Exact through F(92).
fn fibonacci(n: int) -> int
    let out = 0
    if n > 0
        let a = 0
        let b = 1
        for i in 1..n
            let c = a + b
            a = b
            b = c
        out = b
    out

// The first `n` Fibonacci numbers as a list, starting from F(0)=0.
fn fib_sequence(n: int) -> list
    let out = []
    let a = 0
    let b = 1
    for i in 0..n
        push(out, a)
        let c = a + b
        a = b
        b = c
    out

// True if x is a Fibonacci number (0,1,1,2,3,5,8,... ; negatives are never Fibonacci).
fn is_fibonacci(x: int) -> bool
    let out = false
    if x >= 0
        let a = 0
        let b = 1
        let going = true
        while going
            if a == x
                out = true
                going = false
            else
                if a > x
                    going = false
                else
                    let c = a + b
                    a = b
                    b = c
    out

// The n-th Lucas number (0-indexed: L(0)=2, L(1)=1, L(2)=3, L(3)=4, ...).
fn lucas(n: int) -> int
    let a = 2
    let b = 1
    let out = 2
    if n > 0
        for i in 1..n
            let c = a + b
            a = b
            b = c
        out = b
    out
