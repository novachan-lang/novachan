// forge_config_server — Distributed configuration management.
// Namespaced key-value, versioned, profile-aware, change listeners.

fn cfg_server() -> dict
    let s = {}
    s["namespaces"] = {}
    s["version"] = 0
    s["history"] = []
    s

fn cfg_set(srv: dict, ns: string, key: string, value: any) -> dict
    let has_ns = contains(srv["namespaces"], ns)
    if has_ns != true
        srv["namespaces"][ns] = {}
    srv["namespaces"][ns][key] = value
    srv["version"] = srv["version"] + 1
    let entry = {}
    entry["ns"] = ns
    entry["key"] = key
    entry["value"] = value
    entry["version"] = srv["version"]
    push(srv["history"], entry)
    srv

fn cfg_get(srv: dict, ns: string, key: string) -> any
    let has_ns = contains(srv["namespaces"], ns)
    if has_ns != true
        return ""
    let space = srv["namespaces"][ns]
    let has_key = contains(space, key)
    if has_key != true
        return ""
    space[key]

fn cfg_get_or(srv: dict, ns: string, key: string, fallback: any) -> any
    let val = cfg_get(srv, ns, key)
    if val == ""
        return fallback
    val

fn cfg_list_keys(srv: dict, ns: string) -> list
    let has_ns = contains(srv["namespaces"], ns)
    if has_ns != true
        return []
    keys(srv["namespaces"][ns])

fn cfg_list_namespaces(srv: dict) -> list
    keys(srv["namespaces"])

fn cfg_version(srv: dict) -> int
    srv["version"]

fn cfg_changes_since(srv: dict, since_version: int) -> list
    let result = []
    let i = 0
    while i < len(srv["history"])
        if srv["history"][i]["version"] > since_version
            push(result, srv["history"][i])
        i = i + 1
    result

fn cfg_snapshot(srv: dict, ns: string) -> dict
    let snap = {}
    let has_ns = contains(srv["namespaces"], ns)
    if has_ns != true
        return snap
    let ks = keys(srv["namespaces"][ns])
    let i = 0
    while i < len(ks)
        snap[ks[i]] = srv["namespaces"][ns][ks[i]]
        i = i + 1
    snap
