// forge_base64url -- base64url encode/decode (RFC 4648 §5): the URL-safe base64 variant JWTs, JWS, WebAuthn,
// and URL tokens use (+ -> -, / -> _, no "=" padding). Wraps the base64_encode/base64_decode builtins. LEAF.
//
// RAISED 2026-08-05. Three problems:
//
//   1. base64url_encode had nested else+if chains. else if.
//   2. base64url_encode had a dead binding `let out = join(...); out`. Inlined.
//   3. base64url_decode had nested else+if chains. else if.

fn base64url_encode(s: string) -> string
    let std = base64_encode(s)
    let out_parts = []
    for i in 0..len(std)
        let c = char_at(std, i)
        if c == "+"
            push(out_parts, "-")
        else if c == "/"
            push(out_parts, "_")
        else if c != "="
            push(out_parts, c)
    join(out_parts, "")

fn base64url_decode(s: string) -> string
    let parts = []
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == "-"
            push(parts, "+")
        else if c == "_"
            push(parts, "/")
        else
            push(parts, c)
    let std = join(parts, "")
    while len(std) % 4 != 0
        std += "="
    base64_decode(std)
