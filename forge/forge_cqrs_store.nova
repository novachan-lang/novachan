// forge_cqrs_store — CQRS command/query separation with event log and Result API.

fn cqrs_new() -> dict
    let c = {}
    c["event_count"] = 0
    c["command_count"] = 0
    c["query_count"] = 0
    c

fn cqrs_command(c: dict, cmd_type: string, payload: string) -> dict
    let idx = c["event_count"]
    c["ev_" + str(idx) + "_type"] = cmd_type
    c["ev_" + str(idx) + "_data"] = payload
    c["ev_" + str(idx) + "_kind"] = "command"
    c["event_count"] = idx + 1
    c["command_count"] = c["command_count"] + 1
    c

fn cqrs_query(c: dict, query_type: string) -> Result
    c["query_count"] = c["query_count"] + 1
    let i = c["event_count"] - 1
    while i >= 0
        if c["ev_" + str(i) + "_type"] == query_type
            return ok(c["ev_" + str(i) + "_data"])
        i -= 1
    err("no event found for: " + query_type)

fn cqrs_event_at(c: dict, index: int) -> Result
    if index < 0 or index >= c["event_count"]
        return err("event index out of range")
    ok(c["ev_" + str(index) + "_data"])

fn cqrs_event_type(c: dict, index: int) -> Result
    if index < 0 or index >= c["event_count"]
        return err("event index out of range")
    ok(c["ev_" + str(index) + "_type"])

fn cqrs_event_count(c: dict) -> int
    c["event_count"]

fn cqrs_command_count(c: dict) -> int
    c["command_count"]

fn cqrs_query_count(c: dict) -> int
    c["query_count"]
