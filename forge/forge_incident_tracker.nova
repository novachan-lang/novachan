// forge_incident_tracker — Ops/SRE incident tracking and management.
// Open/resolve incidents with severity (1=critical .. 4=low), query via Result.

fn it_new() -> dict
    {"incidents": {}, "next_id": 1}

fn it_open(state: dict, title: string, severity: int) -> int
    let id = state["next_id"]
    state["incidents"][str(id)] = {"title": title, "severity": severity, "status": "open"}
    state["next_id"] += 1
    id

fn it_resolve(state: dict, incident_id: int) -> Result
    let key = str(incident_id)
    if key not in state["incidents"]
        return err("not found: " + key)
    if state["incidents"][key]["status"] == "resolved"
        return err("already resolved: " + key)
    state["incidents"][key]["status"] = "resolved"
    ok(incident_id)

fn it_get_title(state: dict, incident_id: int) -> Result
    let key = str(incident_id)
    if key not in state["incidents"]
        return err("not found: " + key)
    ok(state["incidents"][key]["title"])

fn it_get_severity(state: dict, incident_id: int) -> Result
    let key = str(incident_id)
    if key not in state["incidents"]
        return err("not found: " + key)
    ok(state["incidents"][key]["severity"])

fn it_get_status(state: dict, incident_id: int) -> Result
    let key = str(incident_id)
    if key not in state["incidents"]
        return err("not found: " + key)
    ok(state["incidents"][key]["status"])

fn it_open_count(state: dict) -> int
    let ids = keys(state["incidents"])
    let cnt = 0
    for i in 0..len(ids)
        if state["incidents"][ids[i]]["status"] == "open"
            cnt += 1
    cnt

fn it_resolved_count(state: dict) -> int
    let ids = keys(state["incidents"])
    let cnt = 0
    for i in 0..len(ids)
        if state["incidents"][ids[i]]["status"] == "resolved"
            cnt += 1
    cnt

fn it_total_count(state: dict) -> int
    len(keys(state["incidents"]))

fn it_critical_count(state: dict) -> int
    let ids = keys(state["incidents"])
    let cnt = 0
    for i in 0..len(ids)
        if state["incidents"][ids[i]]["severity"] == 1
            cnt += 1
    cnt
