// forge_lcs -- the Longest Common Subsequence of two strings: the longest run of characters that appears in BOTH,
// in the same relative order but not necessarily adjacent. It's the core of "how similar / how much is shared"
// tools: file and text diff (the unchanged lines/chars are the LCS; everything else is an edit), version-control
// merge, plagiarism and similarity scoring, and bio-sequence alignment (shared DNA/protein motifs). Unlike edit
// distance (forge_editops), which counts changes, LCS returns the shared content itself. Classic dynamic
// programming over a table, then a backtrace to recover one longest subsequence. Fully reliable integer logic.
// LEAF -- imports NOTHING.

// PRIVATE.
fn _lcs_dp(a: string, b: string) -> list
    let n = len(a)
    let m = len(b)
    let cols = m + 1
    let sz = (n + 1) * cols
    let dp = [0 for z in 0..sz]
    for i in 1..(n + 1)
        for j in 1..(m + 1)
            if char_at(a, i - 1) == char_at(b, j - 1)
                dp[i * cols + j] = dp[(i - 1) * cols + (j - 1)] + 1
            else
                let up = dp[(i - 1) * cols + j]
                let left = dp[i * cols + (j - 1)]
                dp[i * cols + j] = up if up >= left else left
    dp

// The length of the longest common subsequence of a and b.
fn lcs_length(a: string, b: string) -> int
    let n = len(a)
    let m = len(b)
    let dp = _lcs_dp(a, b)
    let cols = m + 1
    dp[n * cols + m]

// One actual longest common subsequence, as a string (there may be several of equal length).
fn lcs(a: string, b: string) -> string
    let n = len(a)
    let m = len(b)
    let cols = m + 1
    let dp = _lcs_dp(a, b)
    // backtrace from (n, m)
    let rev = []
    let i = n
    let j = m
    while i > 0 and j > 0
        if char_at(a, i - 1) == char_at(b, j - 1)
            push(rev, char_at(a, i - 1))
            i -= 1
            j -= 1
        else if dp[(i - 1) * cols + j] >= dp[i * cols + (j - 1)]
            i -= 1
        else
            j -= 1
    // reverse the collected characters
    join(reverse(rev), "")

// Similarity ratio in [0,1]: 2*LCS / (len(a)+len(b)) -- 1.0 for identical strings, 0.0 for nothing in common.
fn lcs_ratio(a: string, b: string) -> float
    let total = len(a) + len(b)
    (2 * lcs_length(a, b) * 1.0) / (total * 1.0) if total > 0 else 0.0
