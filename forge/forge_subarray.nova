// forge_subarray -- find the best contiguous run inside a sequence of numbers, in a single pass. The classic
// question "which consecutive stretch sums to the most?" (Kadane's algorithm) answers real problems: the most
// profitable window of daily returns, the strongest segment of a signal, the busiest span of traffic, the best
// contiguous score. This module gives the maximum subarray SUM (and WHERE it is), the maximum PRODUCT subarray
// (which must track the most-negative running value too, since two negatives flip to a big positive), and the
// single buy-then-sell trade that maximizes PROFIT on a price series. All run in O(n) with integer arithmetic --
// fast and fully reliable. LEAF -- imports NOTHING.

// The maximum sum of any non-empty contiguous subarray (Kadane's algorithm). 0 for an empty input.
fn max_subarray_sum(arr: list) -> int
    let out = 0
    if len(arr) > 0
        let best = arr[0]
        let cur = arr[0]
        for i in 1..len(arr)
            let v = arr[i]
            if cur + v > v
                cur += v
            else
                cur = v
            if cur > best
                best = cur
        out = best
    out

// The maximum contiguous subarray as [sum, start_index, end_index] (inclusive). [0,-1,-1] for empty input.
fn max_subarray(arr: list) -> list
    let out = [0, -1, -1]
    if len(arr) > 0
        let best = arr[0]
        let cur = arr[0]
        let start = 0
        let bstart = 0
        let bend = 0
        for i in 1..len(arr)
            let v = arr[i]
            if cur + v > v
                cur += v
            else
                cur = v
                start = i
            if cur > best
                best = cur
                bstart = start
                bend = i
        out = [best, bstart, bend]
    out

// The maximum product of any non-empty contiguous subarray. Tracks both the running max AND running min, because
// a negative times a negative can become the new maximum. 0 for empty input.
fn max_product_subarray(arr: list) -> int
    let out = 0
    if len(arr) > 0
        let best = arr[0]
        let curmax = arr[0]
        let curmin = arr[0]
        for i in 1..len(arr)
            let v = arr[i]
            let b = curmax * v
            let c = curmin * v
            let nmax = v
            if b > nmax
                nmax = b
            if c > nmax
                nmax = c
            let nmin = v
            if b < nmin
                nmin = b
            if c < nmin
                nmin = c
            curmax = nmax
            curmin = nmin
            if curmax > best
                best = curmax
        out = best
    out

// The maximum profit from a single buy-then-later-sell over a price series (0 if prices only fall).
fn best_buy_sell(prices: list) -> int
    let out = 0
    if len(prices) > 1
        let minsofar = prices[0]
        let profit = 0
        for i in 1..len(prices)
            let p = prices[i]
            if p - minsofar > profit
                profit = p - minsofar
            if p < minsofar
                minsofar = p
        out = profit
    out

// The minimum sum of any contiguous non-empty subarray (Kadane run for minimums).
fn min_subarray_sum(arr: list) -> int
    let out = 0
    if len(arr) > 0
        let cur = arr[0]
        let best = arr[0]
        for i in 1..len(arr)
            if arr[i] < cur + arr[i]
                cur = arr[i]
            else
                cur += arr[i]
            if cur < best
                best = cur
        out = best
    out

// The maximum sum of a contiguous subarray in a CIRCULAR array (the subarray may wrap around the end). Either the
// best non-wrapping subarray (ordinary Kadane) or the total minus the best "middle" to remove (a wrapping one);
// when every element is negative, the non-wrapping answer is used so the result isn't a spurious empty sum.
fn max_circular_subarray(arr: list) -> int
    let out = 0
    if len(arr) > 0
        let total = 0
        for i in 0..len(arr)
            total += arr[i]
        let best_max = max_subarray_sum(arr)
        if best_max < 0
            out = best_max
        else
            let wrap = total - min_subarray_sum(arr)
            out = best_max
            if wrap > out
                out = wrap
    out
