// forge_graph_store — graph database with Result API.

fn gs_new() -> dict
    let g = {}
    g["nodes"] = {}
    g["edges"] = {}
    g["node_count"] = 0
    g["edge_count"] = 0
    g

fn gs_add_node(g: dict, id: string, label: string) -> Result
    let nk = "n_" + id
    let has = contains(g["nodes"], nk)
    if has == true
        return err("node exists: " + id)
    g["nodes"][nk] = label
    g["node_count"] = g["node_count"] + 1
    ok(g)

fn gs_add_edge(g: dict, from: string, to: string, label: string) -> Result
    let fk = "n_" + from
    let has_f = contains(g["nodes"], fk)
    if has_f != true
        return err("unknown node: " + from)
    let tk = "n_" + to
    let has_t = contains(g["nodes"], tk)
    if has_t != true
        return err("unknown node: " + to)
    let ek = "e_" + from + "_" + to
    g["edges"][ek] = label
    g["edge_count"] = g["edge_count"] + 1
    ok(g)

fn gs_node_label(g: dict, id: string) -> Result
    let nk = "n_" + id
    let has = contains(g["nodes"], nk)
    if has != true
        return err("unknown node: " + id)
    ok(g["nodes"][nk])

fn gs_edge_label(g: dict, from: string, to: string) -> Result
    let ek = "e_" + from + "_" + to
    let has = contains(g["edges"], ek)
    if has != true
        return err("no edge: " + from + "->" + to)
    ok(g["edges"][ek])

fn gs_has_edge(g: dict, from: string, to: string) -> int
    let ek = "e_" + from + "_" + to
    let has = contains(g["edges"], ek)
    if has == true
        return 1
    0

fn gs_node_count(g: dict) -> int
    g["node_count"]

fn gs_edge_count(g: dict) -> int
    g["edge_count"]
