fn ap_new()
    let s = {}
    s["stage_count"] = 0
    s["stage_names"] = ""
    s["record_count"] = 0
    s["group_count"] = 0
    s["group_keys"] = ""
    return s

fn ap_add_stage(s, stage_name, stage_type)
    let idx = int(s["stage_count"])
    s["stage_" + str(idx) + "_name"] = stage_name
    s["stage_" + str(idx) + "_type"] = stage_type
    s["stage_count"] = idx + 1
    if s["stage_names"] == ""
        s["stage_names"] = stage_name
    else
        s["stage_names"] = str(s["stage_names"]) + "," + stage_name
    return s

fn ap_record(s, group_key, field_name, value)
    let sum_key = "g_" + group_key + "_" + field_name + "_sum"
    let cnt_key = "g_" + group_key + "_" + field_name + "_count"
    let min_key = "g_" + group_key + "_" + field_name + "_min"
    let max_key = "g_" + group_key + "_" + field_name + "_max"
    if contains(s, cnt_key) != true
        s[cnt_key] = 0
        s[sum_key] = 0
        s[min_key] = value
        s[max_key] = value
        if contains(s, "gk_" + group_key) != true
            s["gk_" + group_key] = 1
            s["group_count"] = int(s["group_count"]) + 1
            if s["group_keys"] == ""
                s["group_keys"] = group_key
            else
                s["group_keys"] = str(s["group_keys"]) + "," + group_key
    s[cnt_key] = int(s[cnt_key]) + 1
    s[sum_key] = int(s[sum_key]) + value
    if value < int(s[min_key])
        s[min_key] = value
    if value > int(s[max_key])
        s[max_key] = value
    s["record_count"] = int(s["record_count"]) + 1
    return s

fn ap_group_sum(s, group_key, field_name) -> Result
    let key = "g_" + group_key + "_" + field_name + "_sum"
    if contains(s, key) != true
        return err("group/field not found")
    return ok(int(s[key]))

fn ap_group_count(s, group_key, field_name) -> Result
    let key = "g_" + group_key + "_" + field_name + "_count"
    if contains(s, key) != true
        return err("group/field not found")
    return ok(int(s[key]))

fn ap_group_mean(s, group_key, field_name) -> Result
    let ckey = "g_" + group_key + "_" + field_name + "_count"
    if contains(s, ckey) != true
        return err("group/field not found")
    let cnt = int(s[ckey])
    if cnt == 0
        return err("empty group")
    let total = int(s["g_" + group_key + "_" + field_name + "_sum"])
    return ok(total / cnt)

fn ap_group_min(s, group_key, field_name) -> Result
    let key = "g_" + group_key + "_" + field_name + "_min"
    if contains(s, key) != true
        return err("group/field not found")
    return ok(int(s[key]))

fn ap_group_max(s, group_key, field_name) -> Result
    let key = "g_" + group_key + "_" + field_name + "_max"
    if contains(s, key) != true
        return err("group/field not found")
    return ok(int(s[key]))

fn ap_stage_count(s)
    return int(s["stage_count"])

fn ap_stage_names(s)
    return str(s["stage_names"])

fn ap_record_count(s)
    return int(s["record_count"])

fn ap_group_count_total(s)
    return int(s["group_count"])

fn ap_group_list(s)
    return str(s["group_keys"])
