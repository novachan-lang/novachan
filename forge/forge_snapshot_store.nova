// forge_snapshot_store — Store and retrieve state snapshots by version.

fn snap_new() -> dict
    let ss = {}
    ss["snapshots"] = {}
    ss["count"] = 0
    ss["latest_version"] = 0
    ss

fn snap_save(ss: dict, version: int, state: string) -> dict
    let k = str(version)
    ss["snapshots"][k] = state
    ss["count"] = ss["count"] + 1
    if version > ss["latest_version"]
        ss["latest_version"] = version
    ss

fn snap_load(ss: dict, version: int) -> dict
    let result = {}
    let k = str(version)
    let has = contains(ss["snapshots"], k)
    if has == true
        result["found"] = 1
        result["state"] = ss["snapshots"][k]
    else
        result["found"] = 0
        result["state"] = ""
    result

fn snap_latest(ss: dict) -> dict
    if ss["count"] == 0
        let result = {}
        result["found"] = 0
        result["state"] = ""
        result["version"] = 0
        return result
    let k = str(ss["latest_version"])
    let result = {}
    result["found"] = 1
    result["state"] = ss["snapshots"][k]
    result["version"] = ss["latest_version"]
    result

fn snap_count(ss: dict) -> int
    ss["count"]

fn snap_has(ss: dict, version: int) -> int
    let has = contains(ss["snapshots"], str(version))
    if has == true
        return 1
    0

fn snap_latest_version(ss: dict) -> int
    ss["latest_version"]
