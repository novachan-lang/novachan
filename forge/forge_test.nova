// forge_test — in-process test harness (dispatch through the real router, no socket) + response
// assertions — the Spring MockMvc / Django Client round-trip. Use in a forge_*_test.nova to exercise
// routes deterministically (kill-on-timeout-safe: no listener). "Verified by reasoning": test_get(app,
// "/health") -> a response string; assert_status(resp, 200) checks the status line; assert_contains
// checks the body.
import forge

// ── Request helpers (dispatch-through-router, no socket) ─────────────────────────────────────────
// Issue a GET request through the real router. Returns the full HTTP response string.
fn test_get(app, path: string) -> string
    forge.dispatch(app, "GET", path, "")

// Issue a POST request with a body. Returns the full HTTP response string.
fn test_post(app, path: string, body: string) -> string
    forge.dispatch(app, "POST", path, body)

// Issue any HTTP method with body through the router. Returns the full HTTP response string.
fn test_request(app, method: string, path: string, body: string) -> string
    forge.dispatch(app, method, path, body)

// ── Response assertions ───────────────────────────────────────────────────────────────────────────
// assert_status: return true iff the response string contains the HTTP status code.
// Checks " <code> " OR "HTTP/1.1 <code>" so it correctly identifies the status line.
// On failure, prints the first 80 chars of the response and returns false.
fn assert_status(resp: string, code: int) -> bool
    let needle_a = " {code} "
    let needle_b = "HTTP/1.1 {code}"
    let found = find(resp, needle_a) >= 0 or find(resp, needle_b) >= 0
    if found
        return true
    let preview = resp
    if len(preview) > 80
        preview = slice(preview, 0, 80)
    print("assert_status expected {code} in: {preview}")
    false

// assert_contains: return true iff needle appears anywhere in resp.
// On failure, prints the missing needle and returns false.
fn assert_contains(resp: string, needle: string) -> bool
    let hit = find(resp, needle) >= 0
    if hit
        return true
    print("assert_contains missing: {needle}")
    false

// assert_ok: shorthand — asserts the response carries a 200 status.
fn assert_ok(resp: string) -> bool
    assert_status(resp, 200)

// ── Generic boolean assertion ─────────────────────────────────────────────────────────────────────
// expect: if cond is true, return true; else print "FAIL: <label>" and return false.
fn expect(cond: bool, label: string) -> bool
    if cond
        return true
    print("FAIL: {label}")
    false

// ── Response decomposition (MockMvc-style: get at the parts, not just substring-match) ──────────────
// response_status: parse the numeric status code out of the "HTTP/1.1 <code> <reason>" status line. 0 if
// the response has no recognizable status line.
fn response_status(resp: string) -> int
    let sp = find(resp, " ")
    if sp < 0
        return 0
    let rest = slice(resp, sp + 1, len(resp))
    let sp2 = find(rest, " ")
    let codestr = rest
    if sp2 >= 0
        codestr = slice(rest, 0, sp2)
    parse_int(codestr)

// response_body: everything after the header/body separator (CRLF CRLF). "" if there is no separator.
fn response_body(resp: string) -> string
    let sep = chr(13) + chr(10) + chr(13) + chr(10)
    let idx = find(resp, sep)
    if idx < 0
        return ""
    slice(resp, idx + 4, len(resp))

// ── Extra assertions ────────────────────────────────────────────────────────────────────────────────
// assert_header: true iff a "<name>: <value>" header appears in the header section (before the blank line),
// so a value that merely occurs in the body does not false-positive. Prints the miss on failure.
fn assert_header(resp: string, name: string, value: string) -> bool
    let sep = chr(13) + chr(10) + chr(13) + chr(10)
    let idx = find(resp, sep)
    let headers = resp
    if idx >= 0
        headers = slice(resp, 0, idx)
    let needle = "{name}: {value}"
    if find(headers, needle) >= 0
        return true
    print("assert_header missing: {needle}")
    false

// assert_not_contains: the negative of assert_contains — true iff needle is ABSENT (e.g. a leaked secret,
// a stack trace, an unrendered template tag). Prints the offending needle on failure.
fn assert_not_contains(resp: string, needle: string) -> bool
    if find(resp, needle) >= 0
        print("assert_not_contains found (should be absent): {needle}")
        return false
    true

// assert_json_field: decode the response body as a JSON object and assert str(body[key]) == expected (the
// MockMvc jsonPath("$.key").value(...) equivalent for a top-level field). Handles int/string values via str().
fn assert_json_field(resp: string, key: string, expected: string) -> bool
    let obj = json_decode(response_body(resp))
    if not (type_of(obj) == "dict")
        print("assert_json_field: body is not a JSON object")
        return false
    if key not in obj
        print("assert_json_field missing key: {key}")
        return false
    let got = str(obj[key])
    if got == expected
        return true
    print("assert_json_field {key} expected {expected} got {got}")
    false

// ── Test case reporter ────────────────────────────────────────────────────────────────────────────
// run_case: print "PASS <name>" or "FAIL <name>" based on the passed flag.
fn run_case(name: string, passed: bool)
    if passed
        print("PASS {name}")
    else
        print("FAIL {name}")
