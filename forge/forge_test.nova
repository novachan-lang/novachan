// forge_test — in-process test harness (dispatch through the real router, no socket) + response
// assertions — the Spring MockMvc / Django Client round-trip. Use in a forge_*_test.nova to exercise
// routes deterministically (kill-on-timeout-safe: no listener). "Verified by reasoning": test_get(app,
// "/health") -> a response string; assert_status(resp, 200) checks the status line; assert_contains
// checks the body.
import forge

// ── Request helpers (dispatch-through-router, no socket) ─────────────────────────────────────────
// Issue a GET request through the real router. Returns the full HTTP response string.
fn test_get(app, path: string) -> string
    forge.dispatch(app, "GET", path, "")

// Issue a POST request with a body. Returns the full HTTP response string.
fn test_post(app, path: string, body: string) -> string
    forge.dispatch(app, "POST", path, body)

// Issue any HTTP method with body through the router. Returns the full HTTP response string.
fn test_request(app, method: string, path: string, body: string) -> string
    forge.dispatch(app, method, path, body)

// ── Response assertions ───────────────────────────────────────────────────────────────────────────
// assert_status: return true iff the response string contains the HTTP status code.
// Checks " <code> " OR "HTTP/1.1 <code>" so it correctly identifies the status line.
// On failure, prints the first 80 chars of the response and returns false.
fn assert_status(resp: string, code: int) -> bool
    let needle_a = " " + str(code) + " "
    let needle_b = "HTTP/1.1 " + str(code)
    let found = find(resp, needle_a) >= 0 or find(resp, needle_b) >= 0
    if found
        return true
    let preview = resp
    if len(preview) > 80
        preview = slice(preview, 0, 80)
    print("assert_status expected " + str(code) + " in: " + preview)
    false

// assert_contains: return true iff needle appears anywhere in resp.
// On failure, prints the missing needle and returns false.
fn assert_contains(resp: string, needle: string) -> bool
    let hit = find(resp, needle) >= 0
    if hit
        return true
    print("assert_contains missing: " + needle)
    false

// assert_ok: shorthand — asserts the response carries a 200 status.
fn assert_ok(resp: string) -> bool
    assert_status(resp, 200)

// ── Generic boolean assertion ─────────────────────────────────────────────────────────────────────
// expect: if cond is true, return true; else print "FAIL: <label>" and return false.
fn expect(cond: bool, label: string) -> bool
    if cond
        return true
    print("FAIL: " + label)
    false

// ── Test case reporter ────────────────────────────────────────────────────────────────────────────
// run_case: print "PASS <name>" or "FAIL <name>" based on the passed flag.
fn run_case(name: string, passed: bool)
    if passed
        print("PASS " + name)
    else
        print("FAIL " + name)
