// forge_distributed_cache — Distributed cache with partitioning.
// Shard keys across nodes, get/set/evict with TTL.

fn dcache_new(num_shards: int) -> dict
    let dc = {}
    dc["shards"] = {}
    dc["num_shards"] = num_shards
    dc["hits"] = 0
    dc["misses"] = 0
    let i = 0
    while i < num_shards
        dc["shards"][str(i)] = {}
        i = i + 1
    dc

fn _dcache_shard(dc: dict, key: string) -> string
    let h = len(key) % dc["num_shards"]
    str(h)

fn dcache_set(dc: dict, key: string, value: string, ttl: int, now: int) -> dict
    let shard = _dcache_shard(dc, key)
    let entry = {}
    entry["value"] = value
    entry["expires"] = now + ttl
    dc["shards"][shard][key] = entry
    dc

fn dcache_get(dc: dict, key: string, now: int) -> string
    let shard = _dcache_shard(dc, key)
    let has = contains(dc["shards"][shard], key)
    if has != true
        dc["misses"] = dc["misses"] + 1
        return ""
    let entry = dc["shards"][shard][key]
    if now >= entry["expires"]
        dc["misses"] = dc["misses"] + 1
        return ""
    dc["hits"] = dc["hits"] + 1
    entry["value"]

fn dcache_evict(dc: dict, key: string) -> dict
    let shard = _dcache_shard(dc, key)
    let new_shard = {}
    let shard_keys = keys(dc["shards"][shard])
    let i = 0
    while i < len(shard_keys)
        if shard_keys[i] != key
            new_shard[shard_keys[i]] = dc["shards"][shard][shard_keys[i]]
        i = i + 1
    dc["shards"][shard] = new_shard
    dc

fn dcache_hit_rate(dc: dict) -> int
    let total = dc["hits"] + dc["misses"]
    if total == 0
        return 0
    (dc["hits"] * 100) / total

fn dcache_total_keys(dc: dict) -> int
    let count = 0
    let i = 0
    while i < dc["num_shards"]
        count = count + len(keys(dc["shards"][str(i)]))
        i = i + 1
    count

fn dcache_shard_size(dc: dict, shard_id: int) -> int
    let sid = str(shard_id)
    let has = contains(dc["shards"], sid)
    if has != true
        return 0
    len(keys(dc["shards"][sid]))
