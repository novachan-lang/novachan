// forge_distributed_cache — Distributed cache with partitioning.
// Shard keys across nodes, get/set/evict with TTL.

fn dcache_new(num_shards: int) -> dict
    {"shards": {str(i): {} for i in 0..num_shards}, "num_shards": num_shards, "hits": 0, "misses": 0}

fn _dcache_shard(dc: dict, key: string) -> string
    let h = len(key) % dc["num_shards"]
    str(h)

fn dcache_set(dc: dict, key: string, value: string, ttl: int, now: int) -> dict
    let shard = _dcache_shard(dc, key)
    dc["shards"][shard][key] = {"value": value, "expires": now + ttl}
    dc

fn dcache_get(dc: dict, key: string, now: int) -> string
    let shard = _dcache_shard(dc, key)
    if key not in dc["shards"][shard]
        dc["misses"] += 1
        return ""
    let entry = dc["shards"][shard][key]
    if now >= entry["expires"]
        dc["misses"] += 1
        return ""
    dc["hits"] += 1
    entry["value"]

fn dcache_evict(dc: dict, key: string) -> dict
    let shard = _dcache_shard(dc, key)
    let old_shard = dc["shards"][shard]
    dc["shards"][shard] = {k: old_shard[k] for k in keys(old_shard) if k != key}
    dc

fn dcache_hit_rate(dc: dict) -> int
    let total = dc["hits"] + dc["misses"]
    if total == 0
        return 0
    (dc["hits"] * 100) / total

fn dcache_total_keys(dc: dict) -> int
    let count = 0
    for i in 0..dc["num_shards"]
        count += len(keys(dc["shards"][str(i)]))
    count

fn dcache_shard_size(dc: dict, shard_id: int) -> int
    let sid = str(shard_id)
    if sid not in dc["shards"]
        return 0
    len(keys(dc["shards"][sid]))
