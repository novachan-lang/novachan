// forge_iban -- IBAN (International Bank Account Number) validation via the ISO 13616 / ISO 7064 MOD-97-10
// check digit. Algorithm: move the first 4 chars to the end, map letters A..Z -> 10..35, then the resulting
// (very large) number mod 97 must equal 1. Computed incrementally so no big-integer/overflow is needed. Catches
// typos in SEPA/wire payment forms before they reach the banking rails. LEAF -- imports NOTHING.

// Strip spaces (IBANs print in groups of 4) and uppercase.
fn _iban_clean(iban: string) -> string
    let out = ""
    for i in 0..len(iban)
        let c = char_at(iban, i)
        if c != " "
            out += c
    upper(out)

// Valid IBAN? Length 15..34 and MOD-97 == 1. (Country-specific length tables are an optional refinement.)
fn iban_valid(iban: string) -> bool
    let s = _iban_clean(iban)
    let n = len(s)
    if n < 15 or n > 34
        return false
    let rearranged = slice(s, 4, n) + slice(s, 0, 4)
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let rem = 0
    for i in 0..len(rearranged)
        let c = char_at(rearranged, i)
        let li = find(alpha, c)
        if li >= 0
            rem = (rem * 100 + (li + 10)) % 97
        else
            let di = find("0123456789", c)
            if di < 0
                return false
            rem = (rem * 10 + di) % 97
    rem == 1

// The 2-letter country code (e.g. "DE"), or "" if too short.
fn iban_country(iban: string) -> string
    let s = _iban_clean(iban)
    if len(s) < 2
        return ""
    slice(s, 0, 2)

// Pretty-print grouped in 4s: "DE89 3704 0044 0532 0130 00".
fn iban_format(iban: string) -> string
    let s = _iban_clean(iban)
    let out_parts = []
    for i in 0..len(s)
        if i > 0 and i % 4 == 0
            push(out_parts, " ")
        push(out_parts, char_at(s, i))
    join(out_parts, "")
