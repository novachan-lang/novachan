// forge_service_mesh_proxy — Service mesh sidecar proxy.
// Route between services, load balance, retry, circuit break.

fn smp_new() -> dict
    {"services": {}, "routes": [], "requests": 0, "errors": 0}

fn smp_register(smp: dict, name: string, address: string) -> dict
    smp["services"][name] = {"address": address, "healthy": 1, "requests": 0}
    smp

fn smp_add_route(smp: dict, from_svc: string, to_svc: string, path: string) -> dict
    push(smp["routes"], {"from": from_svc, "to": to_svc, "path": path, "count": 0})
    smp

fn smp_route(smp: dict, from_svc: string, path: string) -> string
    smp["requests"] += 1
    for i in 0..len(smp["routes"])
        let r = smp["routes"][i]
        if r["from"] == from_svc
            if r["path"] == path
                if r["to"] in smp["services"]
                    if smp["services"][r["to"]]["healthy"] == 1
                        smp["routes"][i]["count"] += 1
                        smp["services"][r["to"]]["requests"] += 1
                        return smp["services"][r["to"]]["address"]
    smp["errors"] += 1
    ""

fn smp_set_health(smp: dict, name: string, healthy: int) -> dict
    if name in smp["services"]
        smp["services"][name]["healthy"] = healthy
    smp

fn smp_service_count(smp: dict) -> int
    len(keys(smp["services"]))

fn smp_route_count(smp: dict) -> int
    len(smp["routes"])

fn smp_total_requests(smp: dict) -> int
    smp["requests"]

fn smp_total_errors(smp: dict) -> int
    smp["errors"]

fn smp_service_requests(smp: dict, name: string) -> int
    if name not in smp["services"]
        return 0
    smp["services"][name]["requests"]
