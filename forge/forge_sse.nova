// forge_sse -- Server-Sent Events (SSE), the W3C EventSource wire format behind real-time server-to-browser
// streaming: live dashboards, chat token streams, LLM completions, progress bars, notification feeds. SSE is
// a plain HTTP response (Content-Type: text/event-stream) carrying a sequence of small text records, each
// terminated by a blank line. This module formats outbound records and parses inbound ones. LEAF -- imports
// NOTHING (built on core string/list/dict builtins only).
//
// Wire format (per record, fields optional except data):
//   id: <id>\n            -- last-event-id, resumed via the Last-Event-ID request header on reconnect
//   event: <name>\n        -- custom event type (default "message" if omitted)
//   data: <line>\n         -- repeated once per line of a multi-line payload
//   retry: <ms>\n          -- reconnection delay hint to the client
//   : <comment>\n          -- ignored by the client; used as a keep-alive ping
//   <blank line>           -- terminates the record and flushes it to the client

// Format the simplest possible SSE record: a single data line, no event type, no id.
fn sse_event(data: string) -> string
    "data: {data}\n\n"

// Format an SSE record with an explicit event type (dispatched client-side via addEventListener(name, ...)).
fn sse_event_named(event_name: string, data: string) -> string
    "event: {event_name}\ndata: {data}\n\n"

// Format a full SSE record: id (enables client auto-resume via Last-Event-ID), event type, and data.
fn sse_event_id(id: string, event_name: string, data: string) -> string
    "id: {id}\nevent: {event_name}\ndata: {data}\n\n"

// Format an SSE comment line -- ignored by EventSource but keeps idle HTTP connections/proxies alive.
fn sse_comment(text: string) -> string
    ": {text}\n"

// Format a retry directive: tells the client how long to wait (ms) before reconnecting after a drop.
fn sse_retry(ms: int) -> string
    "retry: {ms}\n\n"

// Format a multi-line data payload: SSE requires one "data: " line per line of the source text, so the
// client concatenates them (joined by \n) back into the original multi-line value.
fn sse_multiline(data: string) -> string
    let lines = split(data, "\n")
    let out = lines.map(fn(line) "data: " + line)
    join(out, "\n") + "\n\n"

// The response headers an SSE endpoint must send: no buffering/caching, and the connection stays open.
fn sse_headers() -> dict
    {"Content-Type": "text/event-stream", "Cache-Control": "no-cache", "Connection": "keep-alive"}

// Parse raw SSE text (one or more records separated by a blank line) into a list of event dicts:
// {event: string, data: string, id: string, retry: int}. Multi-line "data:" fields are concatenated with
// \n, matching EventSource client behavior. Comment lines (starting with ":") are ignored. Fields absent
// from a record fall back to SSE defaults: event="message", id="", retry=-1 (sentinel: not set).
fn sse_parse(raw: string) -> list
    let normalized = replace(raw, "\r\n", "\n")
    let blocks = split(normalized, "\n\n")
    let out = []
    for block in blocks
        if len(trim(block)) == 0
            continue
        let lines = split(block, "\n")
        let event_name = "message"
        let data_lines = []
        let id_val = ""
        let retry_val = -1
        for line in lines
            if len(line) == 0
                continue
            else if starts_with(line, ":")
                continue
            else if starts_with(line, "data:")
                push(data_lines, trim(slice(line, 5, len(line))))
            else if starts_with(line, "event:")
                event_name = trim(slice(line, 6, len(line)))
            else if starts_with(line, "id:")
                id_val = trim(slice(line, 3, len(line)))
            else if starts_with(line, "retry:")
                retry_val = parse_int(trim(slice(line, 6, len(line))))
        let data_val = join(data_lines, "\n")
        push(out, {"event": event_name, "data": data_val, "id": id_val, "retry": retry_val})
    out
