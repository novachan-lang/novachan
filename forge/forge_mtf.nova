// forge_mtf -- Move-To-Front coding, the transform that sits between the Burrows-Wheeler Transform (forge_bwt) and
// the entropy coder in bzip2. It keeps a list of every possible byte and, for each input character, outputs that
// character's CURRENT position in the list and then moves it to the front. The effect: a character that was used
// recently gets a small number, so text with local repetition -- and especially the long runs BWT produces --
// turns into a stream dominated by ZEROS and other tiny values. That skew is exactly what run-length coding and
// Huffman/arithmetic coding exploit to compress. It's fully reversible with the identical list on the decode side.
// Beyond bzip2 it's a general "recency" transform useful anywhere recently-seen symbols should cost less (caches,
// adaptive coders). Works on ordinary byte strings. LEAF -- imports NOTHING.

// PRIVATE: a fresh symbol table [0, 1, ..., 255].
fn _mtf_table() -> list
    let t = [i for i in 0..256]
    t

// PRIVATE: move the value at position idx to the front of the table (in place, scalar shifts).
fn _mtf_bump(table: list, idx: int)
    let v = table[idx]
    let j = idx
    while j > 0
        table[j] = table[j - 1]
        j -= 1
    table[0] = v

// Encode a string to a list of MTF indices. Recently-used bytes yield small indices (runs -> zeros).
fn mtf_encode(s: string) -> list
    let table = _mtf_table()
    let result = []
    for p in 0..len(s)
        let v = ord(char_at(s, p))
        // find v's current position
        let idx = 0
        while table[idx] != v
            idx += 1
        push(result, idx)
        _mtf_bump(table, idx)
    result

// Decode a list of MTF indices back into the original string.
fn mtf_decode(indices: list) -> string
    let table = _mtf_table()
    let out_parts = []
    for p in 0..len(indices)
        let idx = indices[p]
        let v = table[idx]
        push(out_parts, chr(v))
        _mtf_bump(table, idx)
    let out = join(out_parts, "")
    out
