// forge_mtf -- Move-to-Front transform.
//
// Same situation as forge_bwt: std/compress/mtf.nova defines its public API
// under the EXACT same names forge needs to expose (mtf_encode, mtf_decode).
// NOVA does not scope/mangle symbols per module, so declaring those names
// here while also importing std/compress/mtf emits two `define`s of the same
// global symbol and fails to link. (The previous stub avoided the link error
// by never importing successfully -- its bodies called themselves, i.e.
// infinite recursion, masked by that link failure.)
//
// So this module carries its OWN full implementation -- ported directly from
// std/compress/mtf.nova's proven-correct algorithm, with forge-local helper
// names (prefixed `_fmtf_` instead of std's `_mtf_`) so it never collides
// with std/compress/mtf even if some other module in the same build imports
// that too. There is no `import std/...` line: it would be dead code (this
// module no longer calls into it) and reintroduce the exact collision above.
//
// Algorithm (see std/compress/mtf.nova for the full derivation): maintain an
// ordered 256-symbol integer alphabet (ordinal k at position k initially, so
// the NUL-truncation hazard of a string-based alphabet is avoided). For each
// input character, emit the current position of its ordinal in the alphabet,
// then move that ordinal to the front.
//
// PUBLIC API:
//   mtf_encode(s: string) -> list   -- list of integer indices, one per char
//   mtf_decode(indices: list) -> string -- inverse of mtf_encode

fn _fmtf_default_alpha() -> list
    let alpha = [i for i in 0..256]
    alpha

fn _fmtf_find_ord(alpha, code) -> int
    let n = len(alpha)
    let i = 0
    let found = -1
    while i < n
        let v = alpha[i]
        if v == code
            if found == -1
                found = i
        i += 1
    found

fn _fmtf_move_front_list(alpha, pos) -> list
    let n = len(alpha)
    let moved = alpha[pos]
    let out = []
    push(out, moved)
    for i in 0..n
        if i != pos
            push(out, alpha[i])
    out

fn mtf_encode(s: string) -> list
    let alpha = _fmtf_default_alpha()
    let out = []
    let n = len(s)
    for i in 0..n
        let c = s[i]
        let code = ord(c)
        let pos = _fmtf_find_ord(alpha, code)
        push(out, pos)
        alpha = _fmtf_move_front_list(alpha, pos)
    out

fn mtf_decode(indices: list) -> string
    let alpha = _fmtf_default_alpha()
    let out_parts = []
    let n = len(indices)
    for i in 0..n
        let pos = indices[i]
        let code = alpha[pos]
        push(out_parts, chr(code))
        alpha = _fmtf_move_front_list(alpha, pos)
    let out = join(out_parts, "")
    out
