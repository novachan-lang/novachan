// forge_live_reload — Live reload / hot-swap management.
// Track file changes, trigger reloads, debounce.

fn lr_new() -> dict
    {"watches": [], "changes": [], "reload_count": 0, "last_reload": 0, "debounce_ms": 100}

fn lr_set_debounce(lr: dict, ms: int) -> dict
    lr["debounce_ms"] = ms
    lr

fn lr_watch(lr: dict, path: string, pattern: string) -> dict
    let w = {"path": path, "pattern": pattern, "active": 1}
    push(lr["watches"], w)
    lr

fn lr_record_change(lr: dict, path: string, change_type: string, timestamp: int) -> dict
    let ch = {"path": path, "type": change_type, "timestamp": timestamp}
    push(lr["changes"], ch)
    lr

fn lr_pending_changes(lr: dict) -> int
    len([ch for ch in lr["changes"] if ch["timestamp"] > lr["last_reload"]])

fn lr_should_reload(lr: dict, now: int) -> int
    let pending = lr_pending_changes(lr)
    if pending == 0
        return 0
    let since_last = now - lr["last_reload"]
    if since_last < lr["debounce_ms"]
        return 0
    1

fn lr_trigger_reload(lr: dict, now: int) -> dict
    lr["reload_count"] += 1
    lr["last_reload"] = now
    lr

fn lr_reload_count(lr: dict) -> int
    lr["reload_count"]

fn lr_watch_count(lr: dict) -> int
    len(lr["watches"])

fn lr_change_count(lr: dict) -> int
    len(lr["changes"])

fn lr_recent_changes(lr: dict, since: int) -> list
    [ch for ch in lr["changes"] if ch["timestamp"] >= since]
