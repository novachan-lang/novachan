// forge_gravatar -- Gravatar avatar URLs from an email (the globally-recognized-avatar service used as a photo
// fallback across apps). The email is trimmed + lowercased then MD5-hashed (Gravatar's identifier); the URL
// carries a pixel size and a default-image style (identicon / monsterid / robohash / retro / mp / 404).
// Composes forge_crypto md5_hex. Imports forge_crypto.
import forge_crypto

// Gravatar's identifier hash for an email: md5(lowercase(trim(email))).
fn gravatar_hash(email: string) -> string
    md5_hex(lower(trim(email)))

// The Gravatar image URL. `size` in px; `default_style` = identicon/monsterid/robohash/retro/mp/404.
fn gravatar_url(email: string, size: int, default_style: string) -> string
    "https://www.gravatar.com/avatar/" + gravatar_hash(email) + "?s=" + str(size) + "&d=" + default_style

// Convenience: 80px identicon fallback.
fn gravatar(email: string) -> string
    gravatar_url(email, 80, "identicon")
