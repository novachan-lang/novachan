// forge_cusip -- CUSIP validation & check-digit computation. A CUSIP is the 9-character North-American
// security id (8-char issuer+issue body + 1 check digit) that an ISIN wraps for US/Canada instruments (the
// forge_isin NSIN of a "US.."/"CA.." ISIN is its CUSIP). Companion to forge_isin. The check uses a "sum the
// digits" Luhn variant: every 2nd character (even 1-indexed position) is doubled, then the TENS and UNITS
// digits of each result are summed. Character values: '0'-'9' -> 0..9, 'A'-'Z' -> 10..35, '*' 36, '@' 37,
// '#' 38 (the three special CUSIP symbols). LEAF -- imports NOTHING.

// PRIVATE: a CUSIP char's value, or -1 if invalid.
fn _cusip_val(c: string) -> int
    if c >= "0" and c <= "9"
        return ord(c) - 48
    if c >= "A" and c <= "Z"
        return ord(c) - 55
    if c == "*"
        return 36
    if c == "@"
        return 37
    if c == "#"
        return 38
    0 - 1

// The check digit (0..9) for an 8-character CUSIP body, or -1 if a character is invalid.
fn cusip_check_digit(body8: string) -> int
    if len(body8) != 8
        return 0 - 1
    let sum = 0
    let i = 0
    while i < 8
        let v = _cusip_val(char_at(body8, i))
        if v < 0
            return 0 - 1
        // positions are 1-indexed; the 2nd,4th,6th,8th (odd i here: i=1,3,5,7) are doubled
        if i % 2 == 1
            v = v * 2
        sum = sum + (v / 10) + (v % 10)
        i = i + 1
    (10 - (sum % 10)) % 10

// True iff `cusip` is a well-formed, checksum-valid 9-character CUSIP.
fn cusip_valid(cusip: string) -> bool
    if len(cusip) != 9
        return false
    let last = char_at(cusip, 8)
    if not (last >= "0" and last <= "9")
        return false
    let cd = cusip_check_digit(slice(cusip, 0, 8))
    if cd < 0
        return false
    cd == ord(last) - 48
