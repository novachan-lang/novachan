// forge_finduniq -- three neat "find the odd one out" tricks that beat the obvious approaches on both time and
// memory. single_number finds the ONE value that appears once when every other value appears twice, by XOR-ing the
// whole array: identical numbers cancel to zero, leaving just the loner -- O(n) time, O(1) space, no hash set.
// missing_number finds the one integer absent from 0..n by XOR-ing all the indices with all the values (or, said
// another way, comparing the expected total to the actual) -- again O(1) space and immune to the integer overflow
// a sum could hit. find_duplicate finds the single repeated value in an array of n+1 numbers drawn from 1..n using
// Floyd's cycle detection: treat each value as a "next" pointer, and the duplicate is exactly the entrance to the
// cycle that must form -- O(n) time, O(1) space, and without modifying the array. These show up in data-integrity
// checks (a corrupted or duplicated record), reconciling id sets, and interview-classic array puzzles. LEAF.

// The value that appears exactly once in an array where every other value appears exactly twice (via XOR).
fn single_number(arr: list) -> int
    let x = 0
    let i = 0
    while i < len(arr)
        x = x ^ arr[i]
        i = i + 1
    x

// The single integer missing from an array containing all but one of 0..n (where n = len(arr)). Via XOR of indices
// and values (overflow-safe).
fn missing_number(arr: list) -> int
    let n = len(arr)
    let x = n
    let i = 0
    while i < n
        x = x ^ i ^ arr[i]
        i = i + 1
    x

// The one duplicated value in an array of n+1 integers each in 1..n, via Floyd's cycle detection (O(1) space, array
// left unmodified).
fn find_duplicate(arr: list) -> int
    let slow = arr[0]
    let fast = arr[0]
    // advance until they meet inside the cycle
    let go = true
    while go
        slow = arr[slow]
        fast = arr[arr[fast]]
        if slow == fast
            go = false
    // find the cycle entrance = the duplicate
    slow = arr[0]
    while slow != fast
        slow = arr[slow]
        fast = arr[fast]
    slow
