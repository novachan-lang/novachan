// forge_admission_control — Adaptive admission control based on error rate.

fn ac_new(target_error_pct: int) -> dict
    let ac = {}
    ac["target"] = target_error_pct
    ac["window_ok"] = 0
    ac["window_err"] = 0
    ac["total_admitted"] = 0
    ac["total_rejected"] = 0
    ac["throttle_pct"] = 0
    ac

fn ac_record_success(ac: dict) -> dict
    ac["window_ok"] = ac["window_ok"] + 1
    ac = ac_recalc(ac)
    ac

fn ac_record_error(ac: dict) -> dict
    ac["window_err"] = ac["window_err"] + 1
    ac = ac_recalc(ac)
    ac

fn ac_recalc(ac: dict) -> dict
    let total = ac["window_ok"] + ac["window_err"]
    if total < 10
        ac["throttle_pct"] = 0
        return ac
    let err_pct = ac["window_err"] * 100 / total
    if err_pct > ac["target"]
        let over = err_pct - ac["target"]
        ac["throttle_pct"] = over * 2
        if ac["throttle_pct"] > 90
            ac["throttle_pct"] = 90
    else
        ac["throttle_pct"] = 0
    ac

fn ac_should_admit(ac: dict, rand_pct: int) -> dict
    let result = {}
    if rand_pct >= ac["throttle_pct"]
        ac["total_admitted"] = ac["total_admitted"] + 1
        result["admitted"] = 1
    else
        ac["total_rejected"] = ac["total_rejected"] + 1
        result["admitted"] = 0
    result["ac"] = ac
    result

fn ac_throttle_pct(ac: dict) -> int
    ac["throttle_pct"]

fn ac_error_rate(ac: dict) -> int
    let total = ac["window_ok"] + ac["window_err"]
    if total == 0
        return 0
    ac["window_err"] * 100 / total

fn ac_reset_window(ac: dict) -> dict
    ac["window_ok"] = 0
    ac["window_err"] = 0
    ac["throttle_pct"] = 0
    ac
