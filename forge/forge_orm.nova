// forge_orm -- ONE universal, DB-agnostic ORM over every NOVA driver (SQLite via forge_db, PostgreSQL via
// forge_pg; more drivers slot in behind the same seam). The design is deliberately NOT one typed API per
// database. Instead there is a single agnostic layer and a thin per-driver seam:
//
//   * PER-DRIVER (the only thing a new database adds): connect, run a parameterized statement, and return
//     rows as name-keyed STRING dicts. That is it.
//   * AGNOSTIC, written ONCE (works for every driver): the typed struct mapping, query helpers, counting,
//     transactions. orm_all<T>/orm_one<T> reuse the compiler-generated <T>__from_dict_list / <T>__from_dict
//     (NAME-keyed, zero-annotation). Coercion is driven by the STRUCT's field types (int/float/bool/string),
//     NOT by per-database type codes -- so no per-DB decoding logic is ever needed.
//
// Simple to write:   let users: list<User> = orm_all(db, "SELECT * FROM users WHERE age > ?", [18])
//                     let u: Result<User>   = orm_one(db, "SELECT * FROM users WHERE id = ?", [id])
//                     orm_exec(db, "INSERT INTO users (name, age) VALUES (?, ?)", [name, age])
// Portable placeholders: write `?` everywhere; orm rewrites to `$1,$2,...` for PostgreSQL automatically.
// Injection-safe: values are always bound as parameters, never concatenated into SQL.
// High performance: every driver path is pooled + parameterized (prepared) -- no per-call connect, no
// string-built values.
import forge_db
import forge_pg
import forge_mysql
// sqlitex is imported directly (not just transitively via forge_db) so db_query_named/db_write are in
// scope for the sqlite branches of orm_all/orm_exec below -- NOVA does not re-export an imported module's
// names through a second hop (forge_db importing sqlitex does not put sqlitex's names in forge_orm's scope).
import sqlitex

// Default acquire timeout for the sqlite pool paths below (orm_all / orm_exec): a saturated pool degrades
// to a fast, catchable err()/[] instead of parking the calling task forever -- see forge_db.pool_acquire_to.
let _ORM_ACQUIRE_TIMEOUT_MS = 5000

// ---- typed handle -----------------------------------------------------------------------------------
// The handle used to be a RAW LIST -- ["orm", kind, pool, pool_size] -- read back by position as db[1],
// db[2], db[3] in 19 places, with the driver selected by comparing a bare `kind` STRING in if-chains that
// had no final else. Two concrete failures came out of that shape:
//   * the mysql branch built a THREE-element list (it had no pool), so every db[3] read on a mysql handle
//     was an out-of-bounds access waiting to happen;
//   * a `kind` that matched no branch fell out of the bottom and returned a wrong default -- orm_all gave
//     [] ("no rows"), which is indistinguishable from a successful empty query.
// Modelling the driver as an ENUM makes both impossible. Each variant CARRIES its own pool and size, so a
// driver cannot exist without them, and `match` over it is EXHAUSTIVENESS-CHECKED: adding a fourth database
// is a compile error (E1009 "non-exhaustive match on enum 'OrmDrv': missing ...") at every dispatch site
// rather than a silent wrong default. Field names are prefixed because field lookup is by NAME, not by
// (type, name) -- see the struct-field-collision hazard.
enum OrmDrv
    DSqlite(dsq_pool: any, dsq_size: int)
    DPostgres(dpg_pool: any, dpg_size: int)
    DMysql(dmy_pool: any, dmy_size: int)

// The driver plus the per-handle knobs a production deployment needs to tune. Kept as a struct around the
// enum (rather than more enum payload) because these are driver-INDEPENDENT: every driver wants an acquire
// budget, and adding one here does not touch any variant.
type OrmDb
    odb_drv: OrmDrv
    odb_timeout_ms: int

fn orm_pool(db: OrmDb) -> any
    match db.odb_drv
        DSqlite(p, n) => p
        DPostgres(p, n) => p
        DMysql(p, n) => p

fn orm_pool_size(db: OrmDb) -> int
    match db.odb_drv
        DSqlite(p, n) => n
        DPostgres(p, n) => n
        DMysql(p, n) => n

// Dialect tag, used only for identifier quoting (_orm_qident). Deliberately derived FROM the enum rather
// than stored, so the two can never disagree.
fn orm_kind(db: OrmDb) -> string
    match db.odb_drv
        DSqlite(p, n) => "sqlite"
        DPostgres(p, n) => "postgres"
        DMysql(p, n) => "mysql"

// ---- internal helpers -------------------------------------------------------------------------------

// NOTE: the private `_orm_find(s, sub)` that used to live here was a byte-for-byte duplicate of the
// `find` builtin -- verified equal on every edge case before deleting it (empty needle -> 0, empty
// haystack -> -1, both empty -> 0, needle longer than haystack -> -1, match at 0, match at the last
// index, no match -> -1). Every call site below now uses `find` directly.

// Translate portable `?` placeholders to PostgreSQL `$1,$2,...`. Skips `?` inside single-quoted string
// literals (a `?` in 'a?b' is data, not a placeholder; '' escaped-quotes stay balanced through the toggle).
// Pieces are pushed to a list and joined ONCE: `out = out + ch` per character is QUADRATIC (each += copies
// the whole accumulated SQL), which on a long statement dominated the entire rewrite.
fn _orm_pg_sql(sql: string) -> string
    let parts = []
    let n = 0
    let inq = 0
    for i in 0..len(sql)
        let ch = sql[i:i + 1]
        if ch == "'"
            if inq == 0
                inq = 1
            else
                inq = 0
            push(parts, ch)
        else if ch == "?" and inq == 0
            n += 1
            push(parts, "$" + str(n))
        else
            push(parts, ch)
    join(parts, "")

// PostgreSQL binds parameters in TEXT format -> stringify every value uniformly.
//
// BOOL ENCODING (was a total failure of the PG write path for any struct with a bool field): a NOVA
// bool must be sent as "1"/"0", NOT as str()'s "true"/"false". PostgreSQL accepts '1'/'0' as valid
// input for BOTH a boolean column AND an integer column, whereas 'true' into an INTEGER column is
// rejected outright with `invalid input syntax for type integer: "true"`. Storing a bool in an int
// column is exactly how bools are kept portable across sqlite/PG/MySQL, so EVERY orm_insert/orm_update
// of a struct carrying a bool field silently failed on PostgreSQL -- and silently SUCCEEDED on SQLite,
// which is loosely typed and accepts 'true' in an int column. That is why this only ever showed up on
// the live-PG path, which is skipped in CI unless PGPASSWORD is set.
//
// Detecting the bool is subtle, and MEASURED rather than assumed: a NOVA bool reports DIFFERENTLY
// depending on where it is observed. Read inline in a `for` loop it is str()="1" / type_name()="int";
// passed across a FUNCTION-CALL boundary (which is exactly what the comprehension below does) it is
// str()="true" / type_name()="bool". So the test is written to accept EITHER representation: any
// non-string value whose str() is "true"/"false" is a bool and becomes "1"/"0". Excluding strings is
// what keeps a genuine TEXT value of "true" untouched, so text columns are never corrupted into "1".
fn _orm_pg_param1(p) -> string
    let s = str(p)
    if type_name(p) != "string" and (s == "true" or s == "false")
        return "1" if s == "true" else "0"
    s

fn _orm_pg_params(params) -> list
    [_orm_pg_param1(p) for p in params]

// ---- NULL params -----------------------------------------------------------------------------------
// NOVA has no nullable value, so orm_null() returns a control-char-delimited sentinel string that no real
// text param would contain. _orm_apply_nulls rewrites each `?` bound to orm_null() into a literal SQL NULL
// (a keyword -> injection-safe) and drops it from the bound list -- BEFORE driver dispatch, so it works
// uniformly on every driver with no per-driver bind changes. (For a NULL *test* use `col IS NULL` in SQL;
// `col = ?` with a NULL value follows SQL three-valued logic and is never true, same as everywhere.)
fn _orm_null_marker() -> string
    chr(1) + "NOVA_ORM_NULL" + chr(1)

fn orm_null() -> string
    _orm_null_marker()

fn _orm_is_null_val(p) -> bool
    type_name(p) == "string" and p == _orm_null_marker()

fn _orm_apply_nulls(sql: string, params) -> any
    if not any([_orm_is_null_val(p) for p in params])
        return [sql, params]
    // Same single-quote-aware scan as _orm_pg_sql; pieces joined ONCE (see the quadratic note there).
    let parts = []
    let newp = []
    let pi = 0
    let inq = 0
    for j in 0..len(sql)
        let ch = sql[j:j + 1]
        if ch == "'"
            if inq == 0
                inq = 1
            else
                inq = 0
            push(parts, ch)
        else if ch == "?" and inq == 0
            if pi < len(params) and _orm_is_null_val(params[pi])
                push(parts, "NULL")
            else
                push(parts, "?")
                if pi < len(params)
                    push(newp, params[pi])
            pi += 1
        else
            push(parts, ch)
    [join(parts, ""), newp]


// ---- connection -------------------------------------------------------------------------------------

// Open a database from a URL. Returns ok(db) where db = ["orm", kind, pool, pool_size]. `pool_size`
// (sqlite + postgres only; mysql has no pool yet) is fixed at 4 in orm_open -- use orm_open_with_pool to
// raise the connection ceiling for real traffic. orm_close reads the SAME `pool_size` back out of `db` to
// drain exactly as many connections as were opened -- keep these two functions in sync if the db tuple's
// shape ever changes.
//   sqlite://<path>                               (e.g. sqlite://app.db)
//   postgres://user:password@host:port/dbname     (postgresql:// also accepted; ?query is ignored)
//
// NOTE ON `pool_size` NOT BEING A DEFAULTED PARAMETER: the obvious API is `orm_open(url, pool_size = 4)`
// (NOVA supports default parameter values -- see NOVA_LANGUAGE_FEATURES.md). Verified against the CURRENT
// toolchain first: a default parameter value is NOT honored across a module-import boundary (confirmed
// with a minimal 2-file repro -- a single-arg call to an imported fn with a defaulted 2nd param fails
// E1003 "expects 2 arguments, but got 1"), and orm_open is ALWAYS called cross-module (it's a library
// entry point; forge_orm_test.nova alone has 3 single-arg call sites). Falling back to two plain
// functions sharing one implementation, per the fleet instructions, rather than shipping a construct that
// only compiles from within forge_orm.nova itself.
fn orm_open(url: string) -> any
    _orm_open_impl(url, 4)

// Same as orm_open, but with an explicit connection-pool size (sqlite + postgres only) instead of the
// fixed default of 4 -- for an app that needs a higher connection ceiling than the default allows.
fn orm_open_with_pool(url: string, pool_size: int) -> any
    _orm_open_impl(url, pool_size)

// Parse the `user:password@host:port/dbname?query` body of a network DSN -- the part after the scheme.
// PostgreSQL and MySQL differ ONLY in their default port and default database name, so this is written
// ONCE and both drivers call it (it was two byte-identical 25-line copies). Returns
//   ok([user, password, host, port, dbname])  /  err(msg) when there is no `@`.
// Every split is FIRST-occurrence (find), matching the original character-scan exactly: a password may
// contain `:` (only the first `:` in the credentials splits user from password), a dbname may follow the
// first `/`, and a `?query` suffix is dropped.
fn _orm_parse_dsn(rest: string, default_port: int, default_db: string, scheme: string) -> any
    let at = find(rest, "@")
    if at < 0
        return err("orm: {scheme} url must be {scheme}://user:password@host:port/dbname")
    let creds = rest[0:at]
    let loc = rest[at + 1:len(rest)]
    let user = creds
    let password = ""
    let ci = find(creds, ":")
    if ci >= 0
        user = creds[0:ci]
        password = creds[ci + 1:len(creds)]
    let hostport = loc
    let dbname = default_db
    let slash = find(loc, "/")
    if slash >= 0
        hostport = loc[0:slash]
        dbname = loc[slash + 1:len(loc)]
    let q = find(dbname, "?")
    if q >= 0
        dbname = dbname[0:q]
    let host = hostport
    let port = default_port
    let pi = find(hostport, ":")
    if pi >= 0
        host = hostport[0:pi]
        port = parse_int(hostport[pi + 1:len(hostport)])
    ok([user, password, host, port, dbname])

fn _orm_open_impl(url: string, pool_size: int) -> any
    if starts_with(url, "sqlite://")
        let path = url[9:len(url)]
        let pool = forge_db.pool_open(path, pool_size)
        return ok(OrmDb(DSqlite(pool, pool_size), _ORM_ACQUIRE_TIMEOUT_MS))
    if starts_with(url, "postgresql://") or starts_with(url, "postgres://")
        let rest = url[11:len(url)]
        if starts_with(url, "postgresql://")
            rest = url[13:len(url)]
        // NOT `_orm_parse_dsn(...)?` -- `?` re-wraps the error with an "in <fn> at line N:" prefix,
        // which would change the exact err() text callers already match on. Propagate it verbatim.
        let pdsn = _orm_parse_dsn(rest, 5432, "postgres", "postgres")
        if is_err(pdsn)
            return pdsn
        let dsn = unwrap(pdsn)
        let r = forge_pg.pg_pool_open(dsn[2], dsn[3], dsn[0], dsn[4], dsn[1], pool_size)
        if is_ok(r)
            return ok(OrmDb(DPostgres(unwrap(r), pool_size), _ORM_ACQUIRE_TIMEOUT_MS))
        return r
    if starts_with(url, "mysql://")
        let rest = url[8:len(url)]
        let mdsn = _orm_parse_dsn(rest, 3306, "", "mysql")
        if is_err(mdsn)
            return mdsn
        let dsn = unwrap(mdsn)
        // MySQL now opens a real POOL, like every other driver. It previously called mysql_connect and
        // stored ONE connection, so every task in the process shared a single socket: MySQL's protocol
        // is strictly request/response with a per-command packet SEQUENCE NUMBER, so two concurrent
        // queries interleaved their writes and then each read the other's response packets -- silent
        // cross-request data corruption under any real concurrency. (forge_mysql already had the whole
        // pool API; orm_open simply never wired it up.) The handle also carried only three elements,
        // making every pool_size read on a mysql handle an out-of-bounds access.
        let r = forge_mysql.mysql_pool_open(dsn[2], dsn[3], dsn[0], dsn[4], dsn[1], pool_size)
        if is_ok(r)
            return ok(OrmDb(DMysql(unwrap(r), pool_size), _ORM_ACQUIRE_TIMEOUT_MS))
        return r
    err("orm: unsupported url scheme (use sqlite://, postgres://, or mysql://)")

// Drain and close every pooled connection. The size comes from the enum variant that was built at open
// time, so it can never disagree with how many were actually opened.
fn orm_close(db: OrmDb)
    let n = orm_pool_size(db)
    match db.odb_drv
        DSqlite(p, sz) => forge_db.pool_close(p, n)
        DPostgres(p, sz) => forge_pg.pg_pool_close(p, n)
        DMysql(p, sz) => forge_mysql.mysql_pool_close(p, n)

// ---- queries (agnostic) -----------------------------------------------------------------------------

// A driver failure that orm_all/orm_one CANNOT report (their return types are fixed by the compiler's
// typed-let rewrite -- see orm_all) is at least made LOUD here instead of vanishing. Silence is what made
// a database outage read as "the table is empty" for every caller.
fn _orm_report(where: string, sql: string, msg: string)
    print("[orm] {where} FAILED: {msg} | sql: {sql}")

// ---- sound, Result-returning primitives -------------------------------------------------------------
// PREFER THESE in new code. orm_all/orm_one below exist because the compiler's typed-let rewrite pins
// their return types (see the note on orm_all), so they cannot report failure at all.

// Per-driver row source. Each match arm is a single call, so the dispatch stays a flat, exhaustive
// three-liner and each driver's quirks live in its own named function.
fn _orm_sqlite_rows(pool, sql: string, params, ms: int) -> Result
    let acq = pool_acquire_to(pool, ms)
    if is_err(acq)
        return acq
    let c = unwrap(acq)
    // Release with pool_release, NEVER a bare `send`: pool_acquire_to REGISTERS a crash-safe release via
    // on_exit_send, and a bare send does not cancel that registration, so the connection would go back to
    // the pool TWICE -- once here and again when the task's cleanup registry drained at exit. That put
    // DUPLICATE handles in the pool, letting two tasks acquire the SAME physical sqlite connection and
    // interleave statements on it, and it grew the pool by one on every single call.
    let rows = db_query_named(c, sql, params)
    pool_release(pool, c)
    ok(rows)

// mysql_query/_params return ok(rows_list) for a SELECT but ok(affected_int) for an exec-style statement
// (an OK packet). This is a SELECT API, so a bare int must not escape as a "list" -- a caller would
// dereference it as a NovaList.
fn _orm_mysql_rows(pool, sql: string, params) -> Result
    let r = forge_mysql.mysql_pool_query_params(pool, sql, params) if len(params) > 0 else forge_mysql.mysql_pool_query(pool, sql)
    if is_err(r)
        return r
    let v = unwrap(r)
    if type_of(v) == "list"
        return ok(v)
    ok([])

// SELECT -> ok(list of name-keyed row dicts) / err(message). The sound counterpart of orm_all.
fn orm_rows(db: OrmDb, sql: string, params) -> Result
    let _na = _orm_apply_nulls(sql, params)
    let s = _na[0]
    let ps = _na[1]
    match db.odb_drv
        DSqlite(p, n) => _orm_sqlite_rows(p, s, ps, db.odb_timeout_ms)
        DPostgres(p, n) => forge_pg.pg_query_params_pool(p, _orm_pg_sql(s), _orm_pg_params(ps))
        DMysql(p, n) => _orm_mysql_rows(p, s, ps)

// SELECT -> list of name-keyed string row dicts. The name `orm_all` is recognized by the typed-let
// rewrite, so `let xs: list<T> = orm_all(db, sql, params)` yields a list<T> of real structs.
//
// WHY THIS CANNOT RETURN A Result: the compiler rewrites `let xs: list<T> = orm_all(...)` into
// `T__from_dict_list(orm_all(...))`, and the generated T__from_dict_list takes a bare `list` of dicts.
// Changing this signature to Result would feed a Result into that generated function. The name is
// therefore pinned by the compiler (as are orm_one/orm_get/orm_where/orm_fetch). Making the rewrite
// Result-aware is a COMPILER change -- deliberately not attempted here. What IS fixed: the failure is
// no longer SILENT. Use orm_rows when you need to handle the error.
fn orm_all(db: OrmDb, sql: string, params) -> list
    let r = orm_rows(db, sql, params)
    if is_err(r)
        _orm_report("orm_all", sql, str(unwrap_err(r)))
        return []
    unwrap(r)

// SELECT one -> a single name-keyed dict ({} if no row). `let r: Result<T> = orm_one(...)` -> Result<T>.
fn orm_one(db, sql: string, params) -> any
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return rows[0]
    {}

// db_write checks sqlite3_step's return code (see sqlitex.nova) -- an earlier version called db_query,
// which cannot report failure, and then ALWAYS returned ok(n), so a constraint violation, SQLITE_BUSY, or
// any other write failure was reported as success to every caller.
fn _orm_sqlite_exec(pool, sql: string, params, ms: int) -> Result
    let acq = pool_acquire_to(pool, ms)
    if is_err(acq)
        return acq
    let c = unwrap(acq)
    let wr = db_write(c, sql, params)
    pool_release(pool, c)          // NOT a bare send -- see the double-release note in _orm_sqlite_rows
    wr

fn _orm_mysql_exec(pool, sql: string, params) -> Result
    forge_mysql.mysql_pool_query_params(pool, sql, params) if len(params) > 0 else forge_mysql.mysql_pool_query(pool, sql)

// INSERT / UPDATE / DELETE / DDL. Returns ok(affected_rows) or err(message). Unlike orm_all this name is
// NOT pinned by the compiler rewrite, so it reports failure properly.
fn orm_exec(db: OrmDb, sql: string, params) -> Result
    let _na = _orm_apply_nulls(sql, params)
    let s = _na[0]
    let ps = _na[1]
    match db.odb_drv
        DSqlite(p, n) => _orm_sqlite_exec(p, s, ps, db.odb_timeout_ms)
        DPostgres(p, n) => forge_pg.pg_exec_params_pool(p, _orm_pg_sql(s), _orm_pg_params(ps))
        DMysql(p, n) => _orm_mysql_exec(p, s, ps)

// ---- transactions (agnostic) ------------------------------------------------------------------------
// Run `body(txdb)` inside ONE transaction on ONE connection, committing on ok() and rolling back on err().
//
// The trick that makes this usable: the acquired connection is wrapped in its OWN single-connection pool
// and handed to the body as a normal OrmDb. So every ordinary orm_* call inside the body transparently
// runs on THAT connection -- which is what a transaction requires, since a transaction cannot span
// connections. Without this the body would receive a raw driver connection and none of the ORM API would
// work inside a transaction.
//
// Each driver's own with_tx is used underneath, so the correct dialect is issued (START TRANSACTION on
// MySQL, BEGIN elsewhere) and -- since the drivers were fixed -- a failed BEGIN or a failed COMMIT is
// reported as err() instead of being discarded and reported as success.
// Sequential operations only: two CONCURRENT operations inside one body would contend for the single
// connection in the tx pool.
fn _orm_tx_wrap(db: OrmDb, conn, body) -> Result
    let txch = channel()
    send(txch, conn)
    let txdb = OrmDb(_orm_same_driver(db, txch, 1), db.odb_timeout_ms)
    let r = body(txdb)
    // drain the tx pool so the caller's driver can return the real connection to the real pool
    let back = select_timeout(txch, db.odb_timeout_ms)
    r

// Rebuild the SAME driver variant around a different pool -- keeps orm_with_tx driver-agnostic while
// staying exhaustive, so a fourth database cannot be forgotten here.
fn _orm_same_driver(db: OrmDb, pool, size: int) -> OrmDrv
    match db.odb_drv
        DSqlite(p, n) => DSqlite(pool, size)
        DPostgres(p, n) => DPostgres(pool, size)
        DMysql(p, n) => DMysql(pool, size)

fn orm_with_tx(db: OrmDb, body) -> Result
    match db.odb_drv
        DSqlite(p, n) => forge_db.with_tx(p, fn(c) _orm_tx_wrap(db, c, body))
        DPostgres(p, n) => forge_pg.pg_with_tx(p, fn(c) _orm_tx_wrap(db, c, body))
        DMysql(p, n) => forge_mysql.mysql_with_tx(p, fn(c) _orm_tx_wrap(db, c, body))

// Quote a SQL IDENTIFIER (table or column) for the active dialect so reserved words (Order, Group, User,
// Select, Table, Index, ...) -- and the zero-annotation, type-derived table/column names -- are always
// legal SQL rather than a syntax error that silently swallows into an empty result / lost write. MySQL
// quotes with backticks; SQLite and PostgreSQL (and the default) use ANSI double quotes. NOVA struct and
// field names ARE lexer-validated identifiers and cannot contain the quote character, so a struct-driven
// caller (orm_insert/orm_update/orm_create_table/...) never hits this -- but `name` here also carries
// plain caller-supplied strings (orm_count/orm_where/orm_get/q_from(table).columns(...) take a raw table
// name, and a generic/admin/reporting endpoint that lets a client PICK a table or column, e.g. a
// `?sort=`/`?resource=` request param, is a realistic way an untrusted, non-identifier string reaches
// here). Double any embedded quote character before wrapping -- the standard SQL-identifier escape (a
// literal quote inside a quoted identifier is written as two quotes) -- so `name = 'a" OR 1=1 --'` becomes
// an inert quoted identifier instead of breaking out of the quotes. NOTE: in PostgreSQL a quoted
// identifier is case-SENSITIVE; every struct-driven builder here quotes the SAME type_name-derived string,
// so create/insert/update/delete/fetch stay mutually consistent.
fn _orm_qident(kind: string, name: string) -> string
    if kind == "mysql"
        return "`" + name.replace("`", "``") + "`"
    "\"" + name.replace("\"", "\"\"") + "\""

// ---- inbuilt query functions ------------------------------------------------------------------------

// COUNT rows, optional WHERE (pass "" for none). orm_count(db, "users", "age > ?", [18]).
fn orm_count(db, table: string, where: string, params) -> int
    let tbl = _orm_qident(orm_kind(db), table)
    let sql = "SELECT count(*) AS n FROM {tbl} WHERE {where}" if len(where) > 0 else "SELECT count(*) AS n FROM {tbl}"
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return parse_int(rows[0]["n"])
    0

// EXISTS: does any row match the WHERE?
// This used to delegate to orm_count, i.e. `SELECT count(*)`, which on PostgreSQL is a full heap or
// index scan of EVERY matching row just to discover whether at least one exists -- O(n) work to answer
// an O(1) question, and on a large table the difference between a millisecond and a full-table scan.
// `SELECT 1 ... LIMIT 1` lets the planner stop at the first match.
fn orm_exists(db, table: string, where: string, params) -> bool
    let tbl = _orm_qident(orm_kind(db), table)
    let sql = "SELECT 1 FROM {tbl} WHERE {where} LIMIT 1" if len(where) > 0 else "SELECT 1 FROM {tbl} LIMIT 1"
    len(orm_all(db, sql, params)) > 0

// Aggregate function names orm_agg is willing to splice into SQL. fn_name is a keyword, not a value -- it
// CANNOT be bound as a parameter -- so unlike every other piece of this file it was being raw string-
// concatenated with no quoting or validation at all (the most directly injectable path in the ORM: an
// unwhitelisted fn_name like "count(*); DROP TABLE users; --" went straight into the query). Whitelisting
// against the aggregates every one of NOVA's driver dialects (SQLite/PostgreSQL/MySQL) agrees on closes
// that off entirely -- anything else is refused rather than executed.
fn _orm_is_valid_agg_fn(fn_name: string) -> bool
    fn_name in ["count", "sum", "avg", "min", "max"]

// MIN/MAX/SUM/AVG aggregate over a column (returns the text value, "" if no rows, or if fn_name isn't a
// recognized aggregate -- see _orm_is_valid_agg_fn). The caller coerces the returned text.
fn orm_agg(db, fn_name: string, col: string, table: string, where: string, params) -> string
    if not _orm_is_valid_agg_fn(fn_name)
        return ""
    let cq = _orm_qident(orm_kind(db), col)
    let tbl = _orm_qident(orm_kind(db), table)
    let sql = "SELECT {fn_name}({cq}) AS a FROM {tbl} WHERE {where}" if len(where) > 0 else "SELECT {fn_name}({cq}) AS a FROM {tbl}"
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return str(rows[0]["a"])
    ""

// ---- struct-driven CRUD (RTTI; no SQL to write) -----------------------------------------------------

// INSERT a struct: reflects the field names (RTTI), binds every value positionally (injection-safe) and
// runs INSERT INTO <table> (cols) VALUES (?,..). Portable across drivers. Set the id field explicitly (for
// an auto/serial key, use orm_exec with custom SQL). Returns ok(affected) / err(msg).
fn orm_insert(db, table: string, row) -> any
    let kind = orm_kind(db)
    // Skip an UNSET id (id == 0) so the DB auto-assigns the primary key (the "insert a new row, get its
    // id" hero flow). A non-zero id is inserted verbatim (explicit-id inserts still work). No id field
    // -> nothing skipped.
    let use = [nm for nm in field_names(row) if nm != "id" or field_get(row, nm) != 0]
    let cols = join([_orm_qident(kind, nm) for nm in use], ", ")
    let placeholders = join(["?" for nm in use], ", ")
    let params = [field_get(row, nm) for nm in use]
    let tbl = _orm_qident(kind, table)
    orm_exec(db, "INSERT INTO {tbl} ({cols}) VALUES ({placeholders})", params)

// UPDATE a struct by its `id` field: SET every non-id column WHERE id = the struct's id. The struct MUST
// have an id field. Returns ok(affected) (driver-reported where available) / err(msg).
fn orm_update(db, table: string, row) -> any
    let kind = orm_kind(db)
    let names = field_names(row)
    let cols = [nm for nm in names if nm != "id"]
    let setclause = join([_orm_qident(kind, nm) + " = ?" for nm in cols], ", ")
    let params = [field_get(row, nm) for nm in cols]
    // a struct with no `id` field binds 0, exactly as before (orm_modify refuses that case up front)
    let idval = field_get(row, "id") if "id" in names else 0
    push(params, idval)
    let tbl = _orm_qident(kind, table)
    orm_exec(db, "UPDATE {tbl} SET {setclause} WHERE id = ?", params)

// DELETE by id. Returns ok(affected) / err(msg).
fn orm_delete(db, table: string, id) -> any
    let tbl = _orm_qident(orm_kind(db), table)
    orm_exec(db, "DELETE FROM {tbl} WHERE id = ?", [id])

// ── Zero-annotation, zero-table-name persistence: the struct's TYPE *is* the table ───────────────────
// No @Entity, no @Table, no @Column, no table-name strings, no SQL. type_name(row) derives the table name;
// field reflection derives the columns/types. NOVA's "the struct IS the schema" taken all the way: define a
// struct, then persist it -- the compiler already knows its shape. Rails/JPA/Prisma all need a generator,
// annotations, or a schema file; here the plain struct is the whole contract.
//
//   type Todo
//       id: int
//       title: string
//       done: bool
//   orm_ensure(db, Todo(0, "", false))   // CREATE TABLE Todo (...) -- columns from the struct
//   orm_save(db, Todo(0, "ship it", false))
//   let todos: list<Todo> = orm_all(db, "SELECT * FROM Todo", [])   // typed reads (zero-SQL reads = TODO)

// orm_fetch(db): ZERO-SQL, ZERO-TABLE typed read. VALID ONLY as the RHS of a typed list-of-struct let:
//   let todos: list<Todo> = orm_fetch(db)
// The compiler rewrites that to `Todo__from_dict_list(orm_fetch_all(db, "Todo"))` -- table = T, columns via
// the struct, identifier dialect-quoted. The struct is the entire contract -- no table name, no SQL.
// LIMITATION (Phase-1): in ANY other context (bare `orm_fetch(db)`, an untyped `let x = orm_fetch(db)`, or a
// non-`list<Struct>` target) the type-directed rewrite cannot fire and this fallback returns [] -- the type
// is what carries the table, so there is nothing to fetch without it. Use `orm_fetch_all(db, table)` (below)
// or `orm_all` for a runtime-table read. (A compile diagnostic for the misuse is a tracked follow-up.)
fn orm_fetch(db) -> list
    []

// Runtime-table typed-read source: build a dialect-QUOTED `SELECT * FROM <table>` and return the untyped
// rows. This is the target of the orm_fetch compiler rewrite (so reserved-word type names are legal SQL),
// and is also usable directly: `let xs: list<Todo> = orm_fetch_all(db, "Todo")` when the table is dynamic.
fn orm_fetch_all(db, table: string) -> list
    let tbl = _orm_qident(orm_kind(db), table)
    orm_all(db, "SELECT * FROM {tbl}", [])

// Create the struct-type's table if it doesn't already exist (columns + SQL types derived from the fields).
fn orm_ensure(db, sample) -> any
    orm_create_table(db, type_name(sample), sample)

// Insert a struct as a row in its own type's table. Auto-id when the id field is 0 (see orm_insert).
fn orm_save(db, row) -> any
    orm_insert(db, type_name(row), row)

// Update a struct (matched by its id field) in its own type's table. A struct with no `id` field cannot be
// addressed by primary key, so refuse it with a clear error instead of building `WHERE id=?` against a
// non-existent column (which would silently affect the wrong rows or error opaquely at the driver).
fn orm_modify(db, row) -> any
    if "id" not in field_names(row)
        let tn = type_name(row)
        return err("orm_modify: struct '{tn}' has no 'id' field")
    orm_update(db, type_name(row), row)

// Delete a struct (by its id field) from its own type's table. Same id-field requirement as orm_modify.
fn orm_remove(db, row) -> any
    if "id" not in field_names(row)
        let tn = type_name(row)
        return err("orm_remove: struct '{tn}' has no 'id' field")
    orm_delete(db, type_name(row), field_get(row, "id"))

// ---- fluent query builder (NOVA's answer to JPA Criteria: zero annotations, transparent SQL) --------
// Build a SELECT fluently (incl. JOINs + pagination), then run it -- typed (via orm_all) or untyped (.run):
//   let q = q_from("users").where("age > ?", [18]).order_by("name").paginate(2, 20)
//   let users: list<User> = orm_all(db, q.sql(), q.params)
//   let rows = q.run(db)
//   JOIN: q_from("posts").join("users", "users.id = posts.user_id").where("users.active = ?", [1])
// `?` placeholders + bound params => injection-safe and portable ($N for PG) across every driver.
type OrmQuery
    table: string
    cols: string
    wheres: string
    joins: string
    params: list
    order: string
    lim: int
    off: int

fn q_from(table: string) -> OrmQuery
    OrmQuery { table: table, cols: "*", wheres: "", joins: "", params: [], order: "", lim: 0, off: 0 }

fn OrmQuery.columns(cols: string) -> OrmQuery
    OrmQuery { table: self.table, cols: cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.where(cond: string, ps) -> OrmQuery
    let np = [...self.params, ...ps]
    let w = self.wheres + " AND " + cond if len(self.wheres) > 0 else cond
    OrmQuery { table: self.table, cols: self.cols, wheres: w, joins: self.joins, params: np, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.inner_join(other: string, on: string) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins + " JOIN " + other + " ON " + on, params: self.params, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.left_join(other: string, on: string) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins + " LEFT JOIN " + other + " ON " + on, params: self.params, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.order_by(o: string) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: o, lim: self.lim, off: self.off }

fn OrmQuery.limit(n: int) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: n, off: self.off }

fn OrmQuery.offset(n: int) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: self.lim, off: n }

// Pagination, 1-based page: paginate(2, 20) -> rows 21..40 (LIMIT 20 OFFSET 20).
fn OrmQuery.paginate(page: int, per_page: int) -> OrmQuery
    let p = page
    if p < 1
        p = 1
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: per_page, off: (p - 1) * per_page }

fn OrmQuery.sql() -> string
    let parts = ["SELECT " + self.cols + " FROM " + self.table]
    if len(self.joins) > 0
        push(parts, self.joins)
    if len(self.wheres) > 0
        push(parts, " WHERE " + self.wheres)
    if len(self.order) > 0
        push(parts, " ORDER BY " + self.order)
    if self.lim > 0
        push(parts, " LIMIT " + str(self.lim))
    if self.off > 0
        push(parts, " OFFSET " + str(self.off))
    join(parts, "")

// Run the built query and return untyped rows. For typed results use orm_all(db, q.sql(), q.params).
fn OrmQuery.run(db) -> list
    orm_all(db, self.sql(), self.params)

// ---- SQL-free typed repository + relations (zero annotations; the JPA-repository win) ---------------
// Find one row by id:        let u: Result<User>   = orm_get(db, "users", id)
// Find rows by a condition:  let posts: list<Post> = orm_where(db, "posts", "user_id = ?", [uid])
// Relations need no special API or annotations: has-many = orm_where on the child's FK column;
// belongs-to = orm_get on the parent table by the FK value. Both are ONE typed call, no SQL ceremony.
fn orm_get(db, table: string, id) -> any
    let tbl = _orm_qident(orm_kind(db), table)
    orm_one(db, "SELECT * FROM {tbl} WHERE id = ?", [id])

fn orm_where(db, table: string, cond: string, params) -> list
    let tbl = _orm_qident(orm_kind(db), table)
    orm_all(db, "SELECT * FROM {tbl} WHERE {cond}", params)

// ---- migrations: schema generated from a struct (JPA's ddl-auto, zero annotations) ------------------
// orm_create_table(db, "users", User(0,"",0,false)) reflects a sample struct's field names + types and
// emits CREATE TABLE IF NOT EXISTS with portable per-driver column types. An `id` field becomes PRIMARY
// KEY. No annotations, no migration DSL -- the struct IS the schema.
// NOVA type -> portable SQL column type. A table lookup rather than an if-ladder; float is the only
// dialect-dependent entry, and any unmapped NOVA type falls back to TEXT (unchanged).
// The table is built HERE, not hoisted to a module-level `let`: a module-level dict literal reads back
// EMPTY at call time on the current toolchain, which silently made every column TEXT -- caught by the
// behaviour diff (an INTEGER id stopped being an alias for the sqlite rowid, so auto-PK assignment
// vanished, and `age > ?` started comparing as text: "30" > "1000"). Module-level ints are fine; a
// module-level dict is NOT.
fn _orm_sql_type_table() -> dict
    {"int": "INTEGER", "bool": "INTEGER", "string": "TEXT"}

fn _orm_sql_type(nova_type: string, kind: string, col: string) -> string
    let base = get(_orm_sql_type_table(), nova_type, "TEXT")
    if nova_type == "float"
        base = "DOUBLE PRECISION" if kind == "postgres" else "REAL"
    if col == "id"
        return "{base} PRIMARY KEY"
    base

fn orm_create_table(db, table: string, sample) -> any
    let names = field_names(sample)
    let types = field_types(sample)
    let kind = orm_kind(db)
    // quote the column identifier (keyword-safe); _orm_sql_type still sees the RAW name so its
    // `col == "id"` PRIMARY-KEY check is unaffected.
    let cols = join([_orm_qident(kind, names[i]) + " " + _orm_sql_type(types[i], kind, names[i]) for i in 0..len(names)], ", ")
    let tbl = _orm_qident(kind, table)
    orm_exec(db, "CREATE TABLE IF NOT EXISTS {tbl} ({cols})", [])

fn orm_drop_table(db, table: string) -> any
    let tbl = _orm_qident(orm_kind(db), table)
    orm_exec(db, "DROP TABLE IF EXISTS {tbl}", [])
