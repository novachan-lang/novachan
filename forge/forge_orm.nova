// forge_orm -- ONE universal, DB-agnostic ORM over every NOVA driver (SQLite via forge_db, PostgreSQL via
// forge_pg; more drivers slot in behind the same seam). The design is deliberately NOT one typed API per
// database. Instead there is a single agnostic layer and a thin per-driver seam:
//
//   * PER-DRIVER (the only thing a new database adds): connect, run a parameterized statement, and return
//     rows as name-keyed STRING dicts. That is it.
//   * AGNOSTIC, written ONCE (works for every driver): the typed struct mapping, query helpers, counting,
//     transactions. orm_all<T>/orm_one<T> reuse the compiler-generated <T>__from_dict_list / <T>__from_dict
//     (NAME-keyed, zero-annotation). Coercion is driven by the STRUCT's field types (int/float/bool/string),
//     NOT by per-database type codes -- so no per-DB decoding logic is ever needed.
//
// Simple to write:   let users: list<User> = orm_all(db, "SELECT * FROM users WHERE age > ?", [18])
//                     let u: Result<User>   = orm_one(db, "SELECT * FROM users WHERE id = ?", [id])
//                     orm_exec(db, "INSERT INTO users (name, age) VALUES (?, ?)", [name, age])
// Portable placeholders: write `?` everywhere; orm rewrites to `$1,$2,...` for PostgreSQL automatically.
// Injection-safe: values are always bound as parameters, never concatenated into SQL.
// High performance: every driver path is pooled + parameterized (prepared) -- no per-call connect, no
// string-built values.
import forge_db
import forge_pg
import forge_mysql

// Default acquire timeout for the sqlite pool paths below (orm_all / orm_exec): a saturated pool degrades
// to a fast, catchable err()/[] instead of parking the calling task forever -- see forge_db.pool_acquire_to.
let _ORM_ACQUIRE_TIMEOUT_MS = 5000

// ---- internal helpers -------------------------------------------------------------------------------

// First index of `sub` in `s`, or -1. (Self-contained; no dependency on a stdlib index_of.)
fn _orm_find(s: string, sub: string) -> int
    let sl = len(s)
    let bl = len(sub)
    if bl == 0
        return 0
    let i = 0
    while i + bl <= sl
        if s[i:i + bl] == sub
            return i
        i = i + 1
    -1

// Translate portable `?` placeholders to PostgreSQL `$1,$2,...`. Skips `?` inside single-quoted string
// literals (a `?` in 'a?b' is data, not a placeholder; '' escaped-quotes stay balanced through the toggle).
fn _orm_pg_sql(sql: string) -> string
    let out = ""
    let n = 0
    let i = 0
    let inq = 0
    while i < len(sql)
        let ch = sql[i:i + 1]
        if ch == "'"
            if inq == 0
                inq = 1
            else
                inq = 0
            out = out + ch
        else if ch == "?" and inq == 0
            n = n + 1
            out = out + "$" + str(n)
        else
            out = out + ch
        i = i + 1
    out

// PostgreSQL binds parameters in text format -> stringify every value uniformly.
fn _orm_pg_params(params) -> list
    let out = []
    let i = 0
    while i < len(params)
        push(out, str(params[i]))
        i = i + 1
    out

// ---- NULL params -----------------------------------------------------------------------------------
// NOVA has no nullable value, so orm_null() returns a control-char-delimited sentinel string that no real
// text param would contain. _orm_apply_nulls rewrites each `?` bound to orm_null() into a literal SQL NULL
// (a keyword -> injection-safe) and drops it from the bound list -- BEFORE driver dispatch, so it works
// uniformly on every driver with no per-driver bind changes. (For a NULL *test* use `col IS NULL` in SQL;
// `col = ?` with a NULL value follows SQL three-valued logic and is never true, same as everywhere.)
fn _orm_null_marker() -> string
    chr(1) + "NOVA_ORM_NULL" + chr(1)

fn orm_null() -> string
    _orm_null_marker()

fn _orm_is_null_val(p) -> bool
    type_name(p) == "string" and p == _orm_null_marker()

fn _orm_apply_nulls(sql: string, params) -> any
    let has = 0
    let i = 0
    while i < len(params)
        if _orm_is_null_val(params[i])
            has = 1
        i = i + 1
    if has == 0
        return [sql, params]
    let out = ""
    let newp = []
    let pi = 0
    let inq = 0
    let j = 0
    while j < len(sql)
        let ch = sql[j:j + 1]
        if ch == "'"
            if inq == 0
                inq = 1
            else
                inq = 0
            out = out + ch
        else if ch == "?" and inq == 0
            if pi < len(params) and _orm_is_null_val(params[pi])
                out = out + "NULL"
            else
                out = out + "?"
                if pi < len(params)
                    push(newp, params[pi])
            pi = pi + 1
        else
            out = out + ch
        j = j + 1
    [out, newp]


// ---- connection -------------------------------------------------------------------------------------

// Open a database from a URL. Returns ok(db) where db = ["orm", kind, pool, pool_size]. `pool_size`
// (sqlite + postgres only; mysql has no pool yet) is fixed at 4 in orm_open -- use orm_open_with_pool to
// raise the connection ceiling for real traffic. orm_close reads the SAME `pool_size` back out of `db` to
// drain exactly as many connections as were opened -- keep these two functions in sync if the db tuple's
// shape ever changes.
//   sqlite://<path>                               (e.g. sqlite://app.db)
//   postgres://user:password@host:port/dbname     (postgresql:// also accepted; ?query is ignored)
//
// NOTE ON `pool_size` NOT BEING A DEFAULTED PARAMETER: the obvious API is `orm_open(url, pool_size = 4)`
// (NOVA supports default parameter values -- see NOVA_LANGUAGE_FEATURES.md). Verified against the CURRENT
// toolchain first: a default parameter value is NOT honored across a module-import boundary (confirmed
// with a minimal 2-file repro -- a single-arg call to an imported fn with a defaulted 2nd param fails
// E1003 "expects 2 arguments, but got 1"), and orm_open is ALWAYS called cross-module (it's a library
// entry point; forge_orm_test.nova alone has 3 single-arg call sites). Falling back to two plain
// functions sharing one implementation, per the fleet instructions, rather than shipping a construct that
// only compiles from within forge_orm.nova itself.
fn orm_open(url: string) -> any
    _orm_open_impl(url, 4)

// Same as orm_open, but with an explicit connection-pool size (sqlite + postgres only) instead of the
// fixed default of 4 -- for an app that needs a higher connection ceiling than the default allows.
fn orm_open_with_pool(url: string, pool_size: int) -> any
    _orm_open_impl(url, pool_size)

fn _orm_open_impl(url: string, pool_size: int) -> any
    if starts_with(url, "sqlite://")
        let path = url[9:len(url)]
        let pool = forge_db.pool_open(path, pool_size)
        return ok(["orm", "sqlite", pool, pool_size])
    if starts_with(url, "postgresql://") or starts_with(url, "postgres://")
        let rest = url[11:len(url)]
        if starts_with(url, "postgresql://")
            rest = url[13:len(url)]
        let at = _orm_find(rest, "@")
        if at < 0
            return err("orm: postgres url must be postgres://user:password@host:port/dbname")
        let creds = rest[0:at]
        let loc = rest[at + 1:len(rest)]
        let user = creds
        let password = ""
        let ci = _orm_find(creds, ":")
        if ci >= 0
            user = creds[0:ci]
            password = creds[ci + 1:len(creds)]
        let hostport = loc
        let dbname = "postgres"
        let slash = _orm_find(loc, "/")
        if slash >= 0
            hostport = loc[0:slash]
            dbname = loc[slash + 1:len(loc)]
        let q = _orm_find(dbname, "?")
        if q >= 0
            dbname = dbname[0:q]
        let host = hostport
        let port = 5432
        let pi = _orm_find(hostport, ":")
        if pi >= 0
            host = hostport[0:pi]
            port = parse_int(hostport[pi + 1:len(hostport)])
        let r = forge_pg.pg_pool_open(host, port, user, dbname, password, pool_size)
        if is_ok(r)
            return ok(["orm", "postgres", unwrap(r), pool_size])
        return r
    if starts_with(url, "mysql://")
        let rest = url[8:len(url)]
        let at = _orm_find(rest, "@")
        if at < 0
            return err("orm: mysql url must be mysql://user:password@host:port/dbname")
        let creds = rest[0:at]
        let loc = rest[at + 1:len(rest)]
        let user = creds
        let password = ""
        let ci = _orm_find(creds, ":")
        if ci >= 0
            user = creds[0:ci]
            password = creds[ci + 1:len(creds)]
        let hostport = loc
        let dbname = ""
        let slash = _orm_find(loc, "/")
        if slash >= 0
            hostport = loc[0:slash]
            dbname = loc[slash + 1:len(loc)]
        let q = _orm_find(dbname, "?")
        if q >= 0
            dbname = dbname[0:q]
        let host = hostport
        let port = 3306
        let pi = _orm_find(hostport, ":")
        if pi >= 0
            host = hostport[0:pi]
            port = parse_int(hostport[pi + 1:len(hostport)])
        let r = forge_mysql.mysql_connect(host, port, user, dbname, password)
        if is_ok(r)
            return ok(["orm", "mysql", unwrap(r)])
        return r
    err("orm: unsupported url scheme (use sqlite://, postgres://, or mysql://)")

fn orm_close(db)
    let kind = db[1]
    let h = db[2]
    if kind == "sqlite"
        // db[3] is the SAME pool_size orm_open passed to forge_db.pool_open -- must drain exactly that
        // many connections (a hardcoded 4 here would hang forever draining a smaller pool, or leak
        // connections it never drained from a larger one, once orm_open's pool_size became configurable).
        forge_db.pool_close(h, db[3])
    if kind == "postgres"
        forge_pg.pg_pool_close(h, db[3])
    if kind == "mysql"
        forge_mysql.mysql_close(h)

// ---- queries (agnostic) -----------------------------------------------------------------------------

// SELECT -> list of name-keyed string row dicts. The name `orm_all` is recognized by the typed-let
// rewrite, so `let xs: list<T> = orm_all(db, sql, params)` yields a list<T> of real structs.
fn orm_all(db, sql: string, params) -> list
    let kind = db[1]
    let h = db[2]
    let _na = _orm_apply_nulls(sql, params)
    sql = _na[0]
    params = _na[1]
    if kind == "sqlite"
        let acq = pool_acquire_to(h, _ORM_ACQUIRE_TIMEOUT_MS)
        if is_err(acq)
            // orm_all's contract is `-> list` (the typed `list<T> = orm_all(...)` let-site rewrite depends
            // on it), so a pool-exhaustion timeout can't be surfaced as an err() Result here without
            // breaking that contract -- consistent with the postgres/mysql branches just below, which also
            // degrade ANY driver failure to [] rather than changing the return type. The production win is
            // still real: a saturated pool now returns FAST (bounded by _ORM_ACQUIRE_TIMEOUT_MS) instead of
            // parking this call forever.
            return []
        let c = unwrap(acq)
        defer send(h, c)
        return db_query_named(c, sql, params)
    if kind == "postgres"
        let r = forge_pg.pg_query_params_pool(h, _orm_pg_sql(sql), _orm_pg_params(params))
        if is_ok(r)
            return unwrap(r)
        return []
    if kind == "mysql"
        // mysql_query/_params return ok(rows_list) for a SELECT but ok(affected_int) for an exec-style
        // statement (OK packet). orm_all is a SELECT API declared `-> list`; guard against a bare int
        // slipping through as a "list" (which a caller would deref as a NovaList) if misused with non-SELECT.
        if len(params) == 0
            let mr = forge_mysql.mysql_query(h, sql)
            if is_ok(mr)
                let v = unwrap(mr)
                if type_of(v) == "list"
                    return v
                return []
            return []
        let mr2 = forge_mysql.mysql_query_params(h, sql, params)
        if is_ok(mr2)
            let v2 = unwrap(mr2)
            if type_of(v2) == "list"
                return v2
            return []
        return []
    []

// SELECT one -> a single name-keyed dict ({} if no row). `let r: Result<T> = orm_one(...)` -> Result<T>.
fn orm_one(db, sql: string, params) -> any
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return rows[0]
    {}

// INSERT / UPDATE / DELETE / DDL. Returns ok(affected_rows) or err(message).
fn orm_exec(db, sql: string, params) -> any
    let kind = db[1]
    let h = db[2]
    let _na = _orm_apply_nulls(sql, params)
    sql = _na[0]
    params = _na[1]
    if kind == "sqlite"
        let c = pool_acquire_to(h, _ORM_ACQUIRE_TIMEOUT_MS)?
        defer send(h, c)
        // db_write actually checks sqlite3_step's return code (see sqlitex.nova) -- previously this called
        // db_query (which can't report failure) and then ALWAYS returned ok(n), so a constraint violation,
        // SQLITE_BUSY, or any other write failure was reported as success to every orm_exec caller.
        return db_write(c, sql, params)
    if kind == "postgres"
        // pg_exec_params_pool returns ok(affected) from the CommandComplete tag (0 for DDL).
        return forge_pg.pg_exec_params_pool(h, _orm_pg_sql(sql), _orm_pg_params(params))
    if kind == "mysql"
        // mysql_query / mysql_query_params return ok(affected) from the OK packet for exec-style SQL.
        if len(params) == 0
            return forge_mysql.mysql_query(h, sql)
        return forge_mysql.mysql_query_params(h, sql, params)
    err("orm: unknown db kind")

// Quote a SQL IDENTIFIER (table or column) for the active dialect so reserved words (Order, Group, User,
// Select, Table, Index, ...) -- and the zero-annotation, type-derived table/column names -- are always
// legal SQL rather than a syntax error that silently swallows into an empty result / lost write. MySQL
// quotes with backticks; SQLite and PostgreSQL (and the default) use ANSI double quotes. NOVA struct and
// field names ARE lexer-validated identifiers and cannot contain the quote character, so a struct-driven
// caller (orm_insert/orm_update/orm_create_table/...) never hits this -- but `name` here also carries
// plain caller-supplied strings (orm_count/orm_where/orm_get/q_from(table).columns(...) take a raw table
// name, and a generic/admin/reporting endpoint that lets a client PICK a table or column, e.g. a
// `?sort=`/`?resource=` request param, is a realistic way an untrusted, non-identifier string reaches
// here). Double any embedded quote character before wrapping -- the standard SQL-identifier escape (a
// literal quote inside a quoted identifier is written as two quotes) -- so `name = 'a" OR 1=1 --'` becomes
// an inert quoted identifier instead of breaking out of the quotes. NOTE: in PostgreSQL a quoted
// identifier is case-SENSITIVE; every struct-driven builder here quotes the SAME type_name-derived string,
// so create/insert/update/delete/fetch stay mutually consistent.
fn _orm_qident(kind: string, name: string) -> string
    if kind == "mysql"
        return "`" + name.replace("`", "``") + "`"
    "\"" + name.replace("\"", "\"\"") + "\""

// ---- inbuilt query functions ------------------------------------------------------------------------

// COUNT rows, optional WHERE (pass "" for none). orm_count(db, "users", "age > ?", [18]).
fn orm_count(db, table: string, where: string, params) -> int
    let sql = "SELECT count(*) AS n FROM " + _orm_qident(db[1], table)
    if len(where) > 0
        sql = sql + " WHERE " + where
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return parse_int(rows[0]["n"])
    0

// EXISTS: does any row match the WHERE?
fn orm_exists(db, table: string, where: string, params) -> bool
    orm_count(db, table, where, params) > 0

// Aggregate function names orm_agg is willing to splice into SQL. fn_name is a keyword, not a value -- it
// CANNOT be bound as a parameter -- so unlike every other piece of this file it was being raw string-
// concatenated with no quoting or validation at all (the most directly injectable path in the ORM: an
// unwhitelisted fn_name like "count(*); DROP TABLE users; --" went straight into the query). Whitelisting
// against the aggregates every one of NOVA's driver dialects (SQLite/PostgreSQL/MySQL) agrees on closes
// that off entirely -- anything else is refused rather than executed.
fn _orm_is_valid_agg_fn(fn_name: string) -> bool
    fn_name in ["count", "sum", "avg", "min", "max"]

// MIN/MAX/SUM/AVG aggregate over a column (returns the text value, "" if no rows, or if fn_name isn't a
// recognized aggregate -- see _orm_is_valid_agg_fn). The caller coerces the returned text.
fn orm_agg(db, fn_name: string, col: string, table: string, where: string, params) -> string
    if not _orm_is_valid_agg_fn(fn_name)
        return ""
    let sql = "SELECT " + fn_name + "(" + _orm_qident(db[1], col) + ") AS a FROM " + _orm_qident(db[1], table)
    if len(where) > 0
        sql = sql + " WHERE " + where
    let rows = orm_all(db, sql, params)
    if len(rows) > 0
        return str(rows[0]["a"])
    ""

// ---- struct-driven CRUD (RTTI; no SQL to write) -----------------------------------------------------

// INSERT a struct: reflects the field names (RTTI), binds every value positionally (injection-safe) and
// runs INSERT INTO <table> (cols) VALUES (?,..). Portable across drivers. Set the id field explicitly (for
// an auto/serial key, use orm_exec with custom SQL). Returns ok(affected) / err(msg).
fn orm_insert(db, table: string, row) -> any
    let kind = db[1]
    let names = field_names(row)
    let cols = ""
    let placeholders = ""
    let params = []
    let i = 0
    while i < len(names)
        let nm = names[i]
        // Skip an UNSET id (id == 0) so the DB auto-assigns the primary key (the "insert a new row, get its
        // id" hero flow). A non-zero id is inserted verbatim (explicit-id inserts still work). No id field
        // -> nothing skipped.
        let skip = 0
        if nm == "id"
            if field_get(row, nm) == 0
                skip = 1
        if skip == 0
            if len(params) == 0
                cols = _orm_qident(kind, nm)
                placeholders = "?"
            else
                cols = cols + ", " + _orm_qident(kind, nm)
                placeholders = placeholders + ", ?"
            push(params, field_get(row, nm))
        i = i + 1
    orm_exec(db, "INSERT INTO " + _orm_qident(kind, table) + " (" + cols + ") VALUES (" + placeholders + ")", params)

// UPDATE a struct by its `id` field: SET every non-id column WHERE id = the struct's id. The struct MUST
// have an id field. Returns ok(affected) (driver-reported where available) / err(msg).
fn orm_update(db, table: string, row) -> any
    let kind = db[1]
    let names = field_names(row)
    let setclause = ""
    let params = []
    let idval = 0
    let i = 0
    while i < len(names)
        let nm = names[i]
        if nm == "id"
            idval = field_get(row, nm)
        else
            if len(params) == 0
                setclause = _orm_qident(kind, nm) + " = ?"
            else
                setclause = setclause + ", " + _orm_qident(kind, nm) + " = ?"
            push(params, field_get(row, nm))
        i = i + 1
    push(params, idval)
    orm_exec(db, "UPDATE " + _orm_qident(kind, table) + " SET " + setclause + " WHERE id = ?", params)

// DELETE by id. Returns ok(affected) / err(msg).
fn orm_delete(db, table: string, id) -> any
    orm_exec(db, "DELETE FROM " + _orm_qident(db[1], table) + " WHERE id = ?", [id])

// ── Zero-annotation, zero-table-name persistence: the struct's TYPE *is* the table ───────────────────
// No @Entity, no @Table, no @Column, no table-name strings, no SQL. type_name(row) derives the table name;
// field reflection derives the columns/types. NOVA's "the struct IS the schema" taken all the way: define a
// struct, then persist it -- the compiler already knows its shape. Rails/JPA/Prisma all need a generator,
// annotations, or a schema file; here the plain struct is the whole contract.
//
//   type Todo
//       id: int
//       title: string
//       done: bool
//   orm_ensure(db, Todo(0, "", false))   // CREATE TABLE Todo (...) -- columns from the struct
//   orm_save(db, Todo(0, "ship it", false))
//   let todos: list<Todo> = orm_all(db, "SELECT * FROM Todo", [])   // typed reads (zero-SQL reads = TODO)

// orm_fetch(db): ZERO-SQL, ZERO-TABLE typed read. VALID ONLY as the RHS of a typed list-of-struct let:
//   let todos: list<Todo> = orm_fetch(db)
// The compiler rewrites that to `Todo__from_dict_list(orm_fetch_all(db, "Todo"))` -- table = T, columns via
// the struct, identifier dialect-quoted. The struct is the entire contract -- no table name, no SQL.
// LIMITATION (Phase-1): in ANY other context (bare `orm_fetch(db)`, an untyped `let x = orm_fetch(db)`, or a
// non-`list<Struct>` target) the type-directed rewrite cannot fire and this fallback returns [] -- the type
// is what carries the table, so there is nothing to fetch without it. Use `orm_fetch_all(db, table)` (below)
// or `orm_all` for a runtime-table read. (A compile diagnostic for the misuse is a tracked follow-up.)
fn orm_fetch(db) -> list
    []

// Runtime-table typed-read source: build a dialect-QUOTED `SELECT * FROM <table>` and return the untyped
// rows. This is the target of the orm_fetch compiler rewrite (so reserved-word type names are legal SQL),
// and is also usable directly: `let xs: list<Todo> = orm_fetch_all(db, "Todo")` when the table is dynamic.
fn orm_fetch_all(db, table: string) -> list
    orm_all(db, "SELECT * FROM " + _orm_qident(db[1], table), [])

// Create the struct-type's table if it doesn't already exist (columns + SQL types derived from the fields).
fn orm_ensure(db, sample) -> any
    orm_create_table(db, type_name(sample), sample)

// Insert a struct as a row in its own type's table. Auto-id when the id field is 0 (see orm_insert).
fn orm_save(db, row) -> any
    orm_insert(db, type_name(row), row)

// Update a struct (matched by its id field) in its own type's table. A struct with no `id` field cannot be
// addressed by primary key, so refuse it with a clear error instead of building `WHERE id=?` against a
// non-existent column (which would silently affect the wrong rows or error opaquely at the driver).
fn orm_modify(db, row) -> any
    if not contains(field_names(row), "id")
        return err("orm_modify: struct '" + type_name(row) + "' has no 'id' field")
    orm_update(db, type_name(row), row)

// Delete a struct (by its id field) from its own type's table. Same id-field requirement as orm_modify.
fn orm_remove(db, row) -> any
    if not contains(field_names(row), "id")
        return err("orm_remove: struct '" + type_name(row) + "' has no 'id' field")
    orm_delete(db, type_name(row), field_get(row, "id"))

// ---- fluent query builder (NOVA's answer to JPA Criteria: zero annotations, transparent SQL) --------
// Build a SELECT fluently (incl. JOINs + pagination), then run it -- typed (via orm_all) or untyped (.run):
//   let q = q_from("users").where("age > ?", [18]).order_by("name").paginate(2, 20)
//   let users: list<User> = orm_all(db, q.sql(), q.params)
//   let rows = q.run(db)
//   JOIN: q_from("posts").join("users", "users.id = posts.user_id").where("users.active = ?", [1])
// `?` placeholders + bound params => injection-safe and portable ($N for PG) across every driver.
type OrmQuery
    table: string
    cols: string
    wheres: string
    joins: string
    params: list
    order: string
    lim: int
    off: int

fn q_from(table: string) -> OrmQuery
    OrmQuery { table: table, cols: "*", wheres: "", joins: "", params: [], order: "", lim: 0, off: 0 }

fn OrmQuery.columns(cols: string) -> OrmQuery
    OrmQuery { table: self.table, cols: cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.where(cond: string, ps) -> OrmQuery
    let np = []
    let i = 0
    while i < len(self.params)
        push(np, self.params[i])
        i = i + 1
    let j = 0
    while j < len(ps)
        push(np, ps[j])
        j = j + 1
    let w = self.wheres
    if len(w) > 0
        w = w + " AND " + cond
    else
        w = cond
    OrmQuery { table: self.table, cols: self.cols, wheres: w, joins: self.joins, params: np, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.inner_join(other: string, on: string) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins + " JOIN " + other + " ON " + on, params: self.params, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.left_join(other: string, on: string) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins + " LEFT JOIN " + other + " ON " + on, params: self.params, order: self.order, lim: self.lim, off: self.off }

fn OrmQuery.order_by(o: string) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: o, lim: self.lim, off: self.off }

fn OrmQuery.limit(n: int) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: n, off: self.off }

fn OrmQuery.offset(n: int) -> OrmQuery
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: self.lim, off: n }

// Pagination, 1-based page: paginate(2, 20) -> rows 21..40 (LIMIT 20 OFFSET 20).
fn OrmQuery.paginate(page: int, per_page: int) -> OrmQuery
    let p = page
    if p < 1
        p = 1
    OrmQuery { table: self.table, cols: self.cols, wheres: self.wheres, joins: self.joins, params: self.params, order: self.order, lim: per_page, off: (p - 1) * per_page }

fn OrmQuery.sql() -> string
    let s = "SELECT " + self.cols + " FROM " + self.table
    if len(self.joins) > 0
        s = s + self.joins
    if len(self.wheres) > 0
        s = s + " WHERE " + self.wheres
    if len(self.order) > 0
        s = s + " ORDER BY " + self.order
    if self.lim > 0
        s = s + " LIMIT " + str(self.lim)
    if self.off > 0
        s = s + " OFFSET " + str(self.off)
    s

// Run the built query and return untyped rows. For typed results use orm_all(db, q.sql(), q.params).
fn OrmQuery.run(db) -> list
    orm_all(db, self.sql(), self.params)

// ---- SQL-free typed repository + relations (zero annotations; the JPA-repository win) ---------------
// Find one row by id:        let u: Result<User>   = orm_get(db, "users", id)
// Find rows by a condition:  let posts: list<Post> = orm_where(db, "posts", "user_id = ?", [uid])
// Relations need no special API or annotations: has-many = orm_where on the child's FK column;
// belongs-to = orm_get on the parent table by the FK value. Both are ONE typed call, no SQL ceremony.
fn orm_get(db, table: string, id) -> any
    orm_one(db, "SELECT * FROM " + _orm_qident(db[1], table) + " WHERE id = ?", [id])

fn orm_where(db, table: string, cond: string, params) -> list
    orm_all(db, "SELECT * FROM " + _orm_qident(db[1], table) + " WHERE " + cond, params)

// ---- migrations: schema generated from a struct (JPA's ddl-auto, zero annotations) ------------------
// orm_create_table(db, "users", User(0,"",0,false)) reflects a sample struct's field names + types and
// emits CREATE TABLE IF NOT EXISTS with portable per-driver column types. An `id` field becomes PRIMARY
// KEY. No annotations, no migration DSL -- the struct IS the schema.
fn _orm_sql_type(nova_type: string, kind: string, col: string) -> string
    let base = "TEXT"
    if nova_type == "int"
        base = "INTEGER"
    else if nova_type == "float"
        if kind == "postgres"
            base = "DOUBLE PRECISION"
        else
            base = "REAL"
    else if nova_type == "bool"
        base = "INTEGER"
    else if nova_type == "string"
        base = "TEXT"
    if col == "id"
        return base + " PRIMARY KEY"
    base

fn orm_create_table(db, table: string, sample) -> any
    let names = field_names(sample)
    let types = field_types(sample)
    let kind = db[1]
    let cols = ""
    let i = 0
    while i < len(names)
        // quote the column identifier (keyword-safe); _orm_sql_type still sees the RAW name so its
        // `col == "id"` PRIMARY-KEY check is unaffected.
        let coldef = _orm_qident(kind, names[i]) + " " + _orm_sql_type(types[i], kind, names[i])
        if i == 0
            cols = coldef
        else
            cols = cols + ", " + coldef
        i = i + 1
    orm_exec(db, "CREATE TABLE IF NOT EXISTS " + _orm_qident(kind, table) + " (" + cols + ")", [])

fn orm_drop_table(db, table: string) -> any
    orm_exec(db, "DROP TABLE IF EXISTS " + _orm_qident(db[1], table), [])
