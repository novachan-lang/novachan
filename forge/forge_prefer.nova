// forge_prefer -- parse and build the HTTP Prefer / Preference-Applied headers (RFC 7240). A client uses
// `Prefer:` to ASK the server to tweak how it handles a request without changing the request itself: "return=
// minimal" (send back just an ID/headers, not the full body), "respond-async" (process in the background),
// "wait=10" (give up after N seconds), "handling=lenient" (best-effort instead of strict validation). The
// server echoes what it honored in `Preference-Applied:`. This is used by OData, batch/bulk APIs, and modern
// REST services to keep payloads small and long operations async. Parsing yields a dict of preference -> value
// (a token-only preference like respond-async maps to ""); lookups are case-insensitive per the spec, and
// quoted values are unquoted. LEAF -- imports NOTHING.

// PRIVATE: strip a surrounding pair of double quotes from a value, if present.
fn _prefer_unquote(s: string) -> string
    let q = chr(34)
    let out = s
    if len(s) >= 2 and char_at(s, 0) == q and char_at(s, len(s) - 1) == q
        out = slice(s, 1, len(s) - 1)
    out

// PRIVATE: parse a run of leading ASCII digits into a non-negative int (ignores any non-digits).
fn _prefer_atoi(s: string) -> int
    let n = 0
    for i in 0..len(s)
        let c = ord(char_at(s, i))
        if c >= 48 and c <= 57
            n = n * 10 + (c - 48)
    n

// Parse a Prefer header into a dict of lowercase-preference -> value. A token-only preference maps to "".
fn parse_prefer(header: string) -> dict
    let prefs = {}
    let parts = split(header, ",")
    for i in 0..len(parts)
        let token = trim(parts[i])
        if len(token) > 0
            let kv = split(token, "=")
            if len(kv) == 1
                prefs[lower(token)] = ""
            else
                let key = lower(trim(kv[0]))
                let val = kv[1]
                for j in 2..len(kv)
                    val += "=" + kv[j]
                prefs[key] = _prefer_unquote(trim(val))
    prefs

// The value of a named preference (case-insensitive), or `default` if absent. A token-only preference that IS
// present returns "" (use prefer_has to distinguish present-but-empty from absent).
fn prefer_get(header: string, name: string, default: string) -> string
    let prefs = parse_prefer(header)
    let key = lower(name)
    let out = default
    if key in prefs
        out = prefs[key]
    out

// True if the named preference is present (case-insensitive) -- the right test for token preferences like
// respond-async / return-representation.
fn prefer_has(header: string, name: string) -> bool
    let prefs = parse_prefer(header)
    lower(name) in prefs

// The `wait=N` preference in seconds, or -1 if not present.
fn prefer_wait(header: string) -> int
    let prefs = parse_prefer(header)
    let out = -1
    if "wait" in prefs
        out = _prefer_atoi(prefs["wait"])
    out

// Build a Preference-Applied response header value from a dict of applied preferences (value "" -> token only).
fn preference_applied(applied: dict) -> string
    let ks = keys(applied)
    join([(k + "=" + applied[k]) if len(applied[k]) > 0 else k for k in ks], ", ")
