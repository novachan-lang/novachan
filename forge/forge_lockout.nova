// forge_lockout -- S18: brute-force / account-lockout guard. Track failed attempts per key (username or IP);
// after `max` failures the account is locked until a successful login resets it -- the credential-stuffing
// defense Spring Security's login-lockout and Django-axes provide (the audit §F gap). Pair with mw_auth: on
// a bad password call lockout_fail; before checking, reject if lockout_locked; on success lockout_reset.
//
// LEAF MODULE -- imports NOTHING. Built-ins: contains.

fn lockout_new() -> dict
    {}

// Record a failed attempt for `key`; return the new failure count.
fn lockout_fail(store: dict, key: string) -> int
    let c = 0
    if key in store
        c = store[key]
    c += 1
    store[key] = c
    c

// Clear the counter for `key` (call on a successful login).
fn lockout_reset(store: dict, key: string) -> dict
    store[key] = 0
    store

// Is `key` locked out? (failures >= max). Check BEFORE verifying the credential.
fn lockout_locked(store: dict, key: string, max: int) -> bool
    if key in store
        return store[key] >= max
    false

// Failures remaining before lockout (for a "N attempts left" message); 0 if already locked.
fn lockout_remaining(store: dict, key: string, max: int) -> int
    let c = 0
    if key in store
        c = store[key]
    let rem = max - c
    if rem < 0
        return 0
    rem
