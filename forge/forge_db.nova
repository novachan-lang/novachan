// forge_db -- optional SQLite data layer for Forge.
//
// Import this SEPARATELY from forge (only when your app needs a database), so DB-less apps never
// link sqlite. Connection POOLING is a NOVA channel: recv = acquire (parks if all connections are
// busy -> natural backpressure), send = release. The handle is an int (opaque sqlite ptr); the
// channel copies the int while the underlying connection is shared -- no atomic-RC needed, and the
// int/pointer soundness fix means the channel treats the handle as a scalar (never deref'd). All
// queries are PARAMETERIZED (db_query binds positionally) -> injection-safe by construction.
import sqlitex

// Open a pool of N connections to `path`. Use a FILE path so the pooled connections share data
// (":memory:" gives each connection its OWN private database).
fn pool_open(path: string, n: int)
    let ch = channel()
    let i = 0
    while i < n
        send(ch, db_open(path))
        i = i + 1
    ch

// Acquire a connection (parks until one is free); release it back to the pool when done.
fn pool_acquire(pool)
    recv(pool)

fn pool_release(pool, db)
    send(pool, db)

// Forge T2.6: timeout-bounded acquire. `recv(pool)` already PARKS the green task (cooperatively
// yields the carrier -> no spin), but parks FOREVER if every connection stays busy. This bounds the
// wait via select_timeout (which also parks, not busy-polls): returns ok(db) once a connection frees,
// or err("pool acquire timeout") after `ms` -> a saturated pool degrades to a fast 503, never a hang.
// (pool stays a bare channel; callers pass `ms` explicitly. A pool wrapper carrying a default timeout
// would force every pool_* signature to change -> deferred, out of scope for this increment.)
fn pool_acquire_to(pool, ms: int) -> Result<int>
    let r = select_timeout(pool, ms)
    if r[0] == 0
        ok(r[1])
    else
        err("pool acquire timeout")

// Forge T2.7: run a body inside a DB TRANSACTION on a SINGLE pooled connection. Acquire one connection,
// BEGIN, run body_fn(db) (which does its writes via db_query(db, ...) on THAT SAME connection -- a
// transaction can't span connections), then COMMIT if the body returns ok(..) or ROLLBACK if it returns
// err(..) -> all-or-nothing. The connection is released back to the pool either way. Returns the body's
// Result. NOTE: this rolls back on a returned ERROR; rolling back on a PANIC would need runtime
// panic-recovery (which NOVA lacks today) -> a transaction signals failure via err(), never a panic.
fn with_tx(pool, body_fn) -> any
    let db = recv(pool)
    db_query(db, "BEGIN", [])
    let r = body_fn(db)
    if is_ok(r)
        db_query(db, "COMMIT", [])
    else
        db_query(db, "ROLLBACK", [])
    send(pool, db)
    r

// Parameterized query on a pooled connection (acquire -> query -> release). Returns a list of rows
// (each row a list of column-value strings). INSERT/UPDATE/DELETE return []. Injection-safe: pass
// values in `params`, never string-concatenate them into `sql`.
fn pool_query(pool, sql: string, params)
    let db = recv(pool)
    let rows = db_query(db, sql, params)
    send(pool, db)
    rows

// Parameterized query returning rows as DICTS keyed by the given column names (ergonomic
// column-name access vs positional row[i]). Values are strings (sqlite coerces columns to text);
// the caller parse_int/parse_float as needed. cols must match the SELECT's column order.
fn pool_query_dicts(pool, sql: string, params, cols)
    let rows = pool_query(pool, sql, params)
    let out = []
    let ri = 0
    while ri < len(rows)
        let r = rows[ri]
        let d = {}
        let ci = 0
        while ci < len(cols)
            d[cols[ci]] = r[ci]
            ci = ci + 1
        push(out, d)
        ri = ri + 1
    out

// Parameterized INSERT on a pooled connection, returning the new row's id (last_insert_rowid).
// The INSERT and the id read happen on the SAME acquired connection (required for correctness).
fn pool_insert(pool, sql: string, params)
    let db = recv(pool)
    db_query(db, sql, params)
    let id = db_last_id(db)
    send(pool, db)
    id

// Forge T2.5: struct-driven typed INSERT. Reflects field names from `row` (field_names/field_get,
// RTTI) and builds INSERT INTO <table> (cols) VALUES (?,..) with the field values bound as
// positional params -> injection-safe (only developer-controlled column identifiers are
// interpolated, never values). Skips an "id" field so an INTEGER PRIMARY KEY auto-assigns.
// Returns the new row's id (last_insert_rowid).
fn db_insert(pool, table: string, row) -> int
    let names = field_names(row)
    let cols = ""
    let placeholders = ""
    let params = []
    let i = 0
    while i < len(names)
        let nm = names[i]
        if nm != "id"
            if len(params) == 0
                cols = nm
                placeholders = "?"
            else
                cols = cols + "," + nm
                placeholders = placeholders + ",?"
            push(params, field_get(row, nm))
        i = i + 1
    let sql = "INSERT INTO " + table + " (" + cols + ") VALUES (" + placeholders + ")"
    let db = recv(pool)
    db_query(db, sql, params)
    let id = db_last_id(db)
    send(pool, db)
    id

// Forge T2.5: parameterized DELETE by id. Returns the affected row count (sqlite3_changes).
fn db_delete(pool, table: string, id) -> int
    let sql = "DELETE FROM " + table + " WHERE id = ?"
    let db = recv(pool)
    db_query(db, sql, [id])
    let n = db_affected(db)
    send(pool, db)
    n

// Forge T2.4: SELECT * as name-keyed row dicts. A typed `let xs: list<T> = db_all(pool, table)`
// maps each row to <T> via the generated <T>__from_dict_list (the list<T> let-site rewrite).
fn db_all(pool, table: string) -> list
    let db = recv(pool)
    let rows = db_query_named(db, "SELECT * FROM " + table, [])
    send(pool, db)
    rows

// Forge T2.4: one row by id as a name-keyed dict ({} if not found). A typed
// `let r: Result<T> = db_find(pool, table, id)` maps it via <T>__from_dict.
fn db_find(pool, table: string, id) -> any
    let db = recv(pool)
    let rows = db_query_named(db, "SELECT * FROM " + table + " WHERE id = ?", [id])
    send(pool, db)
    let result = {}
    if len(rows) > 0
        result = rows[0]
    result

// Execute DDL / a non-parameterized statement on a pooled connection. Returns rc (0 = ok).
fn pool_exec(pool, sql: string)
    let db = recv(pool)
    let rc = db_exec(db, sql)
    send(pool, db)
    rc

// Run a list of [sql, params] statements in a single transaction on ONE pooled connection: BEGIN,
// run all, COMMIT. Atomic against other connections. (Rollback-on-handler-panic via crash
// isolation is a later refinement; this is the explicit-statement-list form.)
fn tx(pool, statements)
    let db = recv(pool)
    db_exec(db, "BEGIN")
    let i = 0
    while i < len(statements)
        let s = statements[i]
        db_query(db, s[0], s[1])
        i = i + 1
    db_exec(db, "COMMIT")
    send(pool, db)

// Close all N connections in the pool.
fn pool_close(pool, n: int)
    let i = 0
    while i < n
        db_close(recv(pool))
        i = i + 1
