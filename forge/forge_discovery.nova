// forge_discovery -- in-process service registry + client-side round-robin load balancer.
//
// Architecture: a single-owner ACTOR (one spawned green task draining a request channel) owns
// ALL registry state. Every caller that invokes discovery_register / discovery_resolve /
// discovery_list sends an env dict over the request channel and parks on a reply channel until
// the actor responds.  This is CORRECT under N>1 NOVA_CARRIERS by construction — no locks,
// no atomics, no races.
//
// Beats Spring Cloud Eureka + Ribbon:
//   Eureka:  separate discovery SERVER, heartbeat polling, HTTP REST registration, 30-second
//            cache convergence lag, a Ribbon client bean per service.
//   NOVA:    zero separate process, zero network round-trip for registration, sub-microsecond
//            resolve latency (in-process channel send+receive), one function call per operation.
//
// Beats Consul agent sidecar: no daemon to install, no health-check HTTP endpoint to expose,
// no watch polling.  The registry IS the in-process actor — lighter than any sidecar model.
//
// Round-robin load balancing: discovery_resolve advances a per-service index on every call,
// distributing requests across all registered endpoints without any client configuration.
//
// Future: a DNS / Consul / etcd backend can replace the actor with a remote lookup behind the
// same API (discovery_new / discovery_register / discovery_resolve / discovery_list /
// discovery_stop) — callers are not coupled to the in-process store.
//
// LEAF module — imports NOTHING (only built-ins: channel, spawn, send, receive, contains,
// len, push).

// ── private actor loop ────────────────────────────────────────────────────────────────────────

// _disco_loop -- PRIVATE.  The single actor task that owns the service registry.
// `d` is the handle dict (contains d["req"]). Both `table` and `rr` are born HERE so that all
// new-service inserts and round-robin state updates happen inside the owning task — the
// deep-copy-on-spawn rule means dicts born outside and sent through spawn arrive without their
// dynamic key-insert capability.
//
// table: service-name (string) -> list of endpoint strings
// rr:    service-name (string) -> int (next round-robin cursor; advances on every resolve)
fn _disco_loop(d)
    let table = {}
    let rr = {}
    let running = 1
    while running == 1
        let env = receive(d["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "register"
            let svc = env["svc"]
            if svc not in table
                table[svc] = []
                rr[svc] = 0
            push(table[svc], env["ep"])
        else if op == "resolve"
            let svc = env["svc"]
            if svc not in table
                send(env["reply"], "")
            else
                let eps = table[svc]
                if len(eps) == 0
                    send(env["reply"], "")
                else
                    let idx = rr[svc] % len(eps)
                    rr[svc] = rr[svc] + 1
                    send(env["reply"], eps[idx])
        else if op == "list"
            let svc = env["svc"]
            if svc in table
                send(env["reply"], table[svc])
            else
                send(env["reply"], [])

// ── public API ────────────────────────────────────────────────────────────────────────────────

// discovery_new() -> any
// Create a new in-process service registry.  Returns a handle dict that all discovery_*
// functions accept.  Spawns the actor immediately; the registry is ready on return.
fn discovery_new() -> any
    let d = {}
    d["req"] = channel()
    spawn _disco_loop(d)
    d

// discovery_register(d, service, endpoint)
// Register `endpoint` (e.g. "192.168.1.10:8080") under `service` (e.g. "payments").
// Fire-and-forget: does not wait for the actor to acknowledge.  Calling multiple times with
// different endpoints adds them all to the pool; duplicate endpoints are allowed (they increase
// the round-robin weight for that endpoint).
fn discovery_register(d, service: string, endpoint: string)
    let env = {}
    env["op"] = "register"
    env["svc"] = service
    env["ep"] = endpoint
    send(d["req"], env)

// discovery_resolve(d, service) -> string
// Return the next endpoint for `service` using round-robin load balancing.  Each call advances
// the cursor by one, so successive calls distribute across all registered endpoints.
// Returns "" if no endpoints have been registered for `service`.
//
// This IS the client-side load balancer — no separate Ribbon/LoadBalancer bean required.
// Call it at request time; the actor atomically advances the index so concurrent callers get
// distinct endpoints without coordination.
fn discovery_resolve(d, service: string) -> string
    let rc = channel()
    let env = {}
    env["op"] = "resolve"
    env["svc"] = service
    env["reply"] = rc
    send(d["req"], env)
    receive(rc)

// discovery_list(d, service) -> list
// Return a snapshot of ALL currently registered endpoints for `service`.  The returned list is
// a copy produced by the actor; mutations to it do not affect the registry.
// Returns [] if `service` is unknown.
fn discovery_list(d, service: string) -> list
    let rc = channel()
    let env = {}
    env["op"] = "list"
    env["svc"] = service
    env["reply"] = rc
    send(d["req"], env)
    receive(rc)

// discovery_stop(d)
// Shut down the registry actor.  In-flight requests may not be served.  Call during graceful
// server shutdown or in test teardown when the handle will no longer be used.
fn discovery_stop(d)
    let env = {}
    env["op"] = "stop"
    send(d["req"], env)
