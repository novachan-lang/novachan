// forge_metric_aggregator — time-series metric aggregation with Result API.

fn ma_new() -> dict
    let m = {}
    m["metrics"] = {}
    m["counts"] = {}
    m["sums"] = {}
    m["mins"] = {}
    m["maxs"] = {}
    m["metric_count"] = 0
    m

fn ma_record(m: dict, name: string, value: int) -> dict
    let ck = "c_" + name
    let sk = "s_" + name
    let nk = "n_" + name
    let xk = "x_" + name
    if contains(m["counts"], ck) == true
        m["counts"][ck] = m["counts"][ck] + 1
        m["sums"][sk] = m["sums"][sk] + value
        if value < m["mins"][nk]
            m["mins"][nk] = value
        if value > m["maxs"][xk]
            m["maxs"][xk] = value
    else
        m["counts"][ck] = 1
        m["sums"][sk] = value
        m["mins"][nk] = value
        m["maxs"][xk] = value
        m["metric_count"] = m["metric_count"] + 1
    m

fn ma_count(m: dict, name: string) -> Result
    let ck = "c_" + name
    if contains(m["counts"], ck) != true
        return err("metric not found")
    ok(m["counts"][ck])

fn ma_sum(m: dict, name: string) -> Result
    let sk = "s_" + name
    if contains(m["sums"], sk) != true
        return err("metric not found")
    ok(m["sums"][sk])

fn ma_mean(m: dict, name: string) -> Result
    let ck = "c_" + name
    let sk = "s_" + name
    if contains(m["counts"], ck) != true
        return err("metric not found")
    ok(m["sums"][sk] / m["counts"][ck])

fn ma_min(m: dict, name: string) -> Result
    let nk = "n_" + name
    if contains(m["mins"], nk) != true
        return err("metric not found")
    ok(m["mins"][nk])

fn ma_max(m: dict, name: string) -> Result
    let xk = "x_" + name
    if contains(m["maxs"], xk) != true
        return err("metric not found")
    ok(m["maxs"][xk])

fn ma_metric_count(m: dict) -> int
    m["metric_count"]
