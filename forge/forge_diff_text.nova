// forge_diff_text -- line-level text diff via LCS (the algorithm behind `diff`, git, and PR review). Compares
// two texts line by line and emits [op, line] ops (op = "same"/"add"/"del") so a UI can render added/removed
// lines -- version history, change review, audit trails, config drift. Flat 1D DP table (na+1)*(nb+1) indexed
// i*w+j (avoids nested-list mutation). LEAF -- imports NOTHING.

fn _lcs_diff(a: list, b: list) -> list
    let na = len(a)
    let nb = len(b)
    let w = nb + 1
    let dp = []
    let total = (na + 1) * (nb + 1)
    let t = 0
    while t < total
        push(dp, 0)
        t = t + 1
    let i = na - 1
    while i >= 0
        let j = nb - 1
        while j >= 0
            if a[i] == b[j]
                dp[i * w + j] = dp[(i + 1) * w + (j + 1)] + 1
            else
                let down = dp[(i + 1) * w + j]
                let right = dp[i * w + (j + 1)]
                if down >= right
                    dp[i * w + j] = down
                else
                    dp[i * w + j] = right
            j = j - 1
        i = i - 1
    let out = []
    let x = 0
    let y = 0
    while x < na and y < nb
        if a[x] == b[y]
            push(out, ["same", a[x]])
            x = x + 1
            y = y + 1
        else
            if dp[(x + 1) * w + y] >= dp[x * w + (y + 1)]
                push(out, ["del", a[x]])
                x = x + 1
            else
                push(out, ["add", b[y]])
                y = y + 1
    while x < na
        push(out, ["del", a[x]])
        x = x + 1
    while y < nb
        push(out, ["add", b[y]])
        y = y + 1
    out

// Diff two multi-line texts -> list of [op, line] ("same"/"add"/"del"), longest-common-subsequence aligned.
fn diff_lines(old_text: string, new_text: string) -> list
    _lcs_diff(split(old_text, chr(10)), split(new_text, chr(10)))

// Render a diff in unified style: " " unchanged, "+" added, "-" removed line prefixes.
fn diff_unified(old_text: string, new_text: string) -> string
    let ops = diff_lines(old_text, new_text)
    let out = ""
    let i = 0
    while i < len(ops)
        let op = ops[i]
        let mark = " "
        if op[0] == "add"
            mark = "+"
        else
            if op[0] == "del"
                mark = "-"
        out = out + mark + op[1] + chr(10)
        i = i + 1
    out

// Count changed (added + removed) lines between two texts -- a quick "how much changed" metric.
fn diff_changes(old_text: string, new_text: string) -> int
    let ops = diff_lines(old_text, new_text)
    let n = 0
    let i = 0
    while i < len(ops)
        if ops[i][0] != "same"
            n = n + 1
        i = i + 1
    n
