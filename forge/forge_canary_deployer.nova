// forge_canary_deployer — canary deployment weight management with Result API.

fn canary_new() -> dict
    let c = {}
    c["deployments"] = 0
    c["promotions"] = 0
    c["rollbacks"] = 0
    c

fn canary_deploy(c: dict, version: string, weight: int) -> dict
    let idx = c["deployments"]
    c["cd_" + str(idx) + "_ver"] = version
    c["cd_" + str(idx) + "_wt"] = weight
    c["cd_" + str(idx) + "_status"] = "active"
    c["deployments"] = idx + 1
    c

fn canary_promote(c: dict, index: int) -> Result
    if index < 0 or index >= c["deployments"]
        return err("deployment index out of range")
    let sk = "cd_" + str(index) + "_status"
    if c[sk] != "active"
        return err("deployment not active")
    c[sk] = "promoted"
    c["cd_" + str(index) + "_wt"] = 100
    c["promotions"] = c["promotions"] + 1
    ok(c)

fn canary_rollback(c: dict, index: int) -> Result
    if index < 0 or index >= c["deployments"]
        return err("deployment index out of range")
    let sk = "cd_" + str(index) + "_status"
    if c[sk] != "active"
        return err("deployment not active")
    c[sk] = "rolled_back"
    c["cd_" + str(index) + "_wt"] = 0
    c["rollbacks"] = c["rollbacks"] + 1
    ok(c)

fn canary_version(c: dict, index: int) -> Result
    if index < 0 or index >= c["deployments"]
        return err("deployment index out of range")
    ok(c["cd_" + str(index) + "_ver"])

fn canary_weight(c: dict, index: int) -> Result
    if index < 0 or index >= c["deployments"]
        return err("deployment index out of range")
    ok(c["cd_" + str(index) + "_wt"])

fn canary_status(c: dict, index: int) -> Result
    if index < 0 or index >= c["deployments"]
        return err("deployment index out of range")
    ok(c["cd_" + str(index) + "_status"])

fn canary_deploy_count(c: dict) -> int
    c["deployments"]

fn canary_promotion_count(c: dict) -> int
    c["promotions"]

fn canary_rollback_count(c: dict) -> int
    c["rollbacks"]
