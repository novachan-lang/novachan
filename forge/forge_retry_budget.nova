// forge_retry_budget — Budget-constrained retries per service.

fn rb_new(budget_pct: int) -> dict
    let r = {}
    r["budget_pct"] = budget_pct
    r["requests"] = {}
    r["retries"] = {}
    r["total_requests"] = 0
    r["total_retries"] = 0
    r

fn rb_record_request(r: dict, service: string) -> dict
    let has = contains(r["requests"], service)
    if has == true
        r["requests"][service] = r["requests"][service] + 1
    else
        r["requests"][service] = 1
    r["total_requests"] = r["total_requests"] + 1
    r

fn rb_can_retry(r: dict, service: string) -> int
    let has = contains(r["requests"], service)
    if has != true
        return 0
    let reqs = r["requests"][service]
    if reqs == 0
        return 0
    let has_r = contains(r["retries"], service)
    let retries = 0
    if has_r == true
        retries = r["retries"][service]
    let pct = retries * 100 / reqs
    if pct >= r["budget_pct"]
        return 0
    1

fn rb_record_retry(r: dict, service: string) -> dict
    let has = contains(r["retries"], service)
    if has == true
        r["retries"][service] = r["retries"][service] + 1
    else
        r["retries"][service] = 1
    r["total_retries"] = r["total_retries"] + 1
    r

fn rb_retry_rate(r: dict, service: string) -> int
    let has = contains(r["requests"], service)
    if has != true
        return 0
    let reqs = r["requests"][service]
    if reqs == 0
        return 0
    let has_r = contains(r["retries"], service)
    if has_r != true
        return 0
    r["retries"][service] * 100 / reqs

fn rb_total_requests(r: dict) -> int
    r["total_requests"]

fn rb_total_retries(r: dict) -> int
    r["total_retries"]

fn rb_global_retry_rate(r: dict) -> int
    if r["total_requests"] == 0
        return 0
    r["total_retries"] * 100 / r["total_requests"]
