// forge_stats -- descriptive statistics over a list of numbers (sum/mean/min/max/median/variance/stddev/
// percentile) -- the analytics + monitoring math every dashboard, report, and SLA calculation needs. Numbers
// may be int or float; results are float. Uses the sqrt builtin. LEAF -- imports NOTHING.

fn stats_sum(xs: list) -> float
    let s = 0.0
    let i = 0
    while i < len(xs)
        s = s + xs[i] * 1.0
        i = i + 1
    s

fn stats_mean(xs: list) -> float
    if len(xs) == 0
        return 0.0
    stats_sum(xs) / (len(xs) * 1.0)

fn stats_min(xs: list) -> float
    if len(xs) == 0
        return 0.0
    let m = xs[0] * 1.0
    let i = 1
    while i < len(xs)
        let v = xs[i] * 1.0
        if v < m
            m = v
        i = i + 1
    m

fn stats_max(xs: list) -> float
    if len(xs) == 0
        return 0.0
    let m = xs[0] * 1.0
    let i = 1
    while i < len(xs)
        let v = xs[i] * 1.0
        if v > m
            m = v
        i = i + 1
    m

// PRIVATE: a new float list sorted ascending (insertion sort; O(n^2), fine for stats-sized samples).
fn _stats_sorted(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j = j - 1
        out[j] = v
        i = i + 1
    out

fn stats_median(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _stats_sorted(xs)
    if n % 2 == 1
        return s[n / 2]
    (s[n / 2 - 1] + s[n / 2]) / 2.0

// Population variance (mean of squared deviations).
fn stats_variance(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = stats_mean(xs)
    let acc = 0.0
    let i = 0
    while i < n
        let d = xs[i] * 1.0 - mu
        acc = acc + d * d
        i = i + 1
    acc / (n * 1.0)

fn stats_stddev(xs: list) -> float
    sqrt(stats_variance(xs))

// The p-th percentile (0..100), nearest-rank method (p=50 ~ median). For p95/p99 latency SLAs.
fn stats_percentile(xs: list, p: int) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _stats_sorted(xs)
    let rank = (p * n + 99) / 100
    if rank < 1
        rank = 1
    if rank > n
        rank = n
    s[rank - 1]

// ── Bivariate: covariance, Pearson correlation, and simple linear regression ─────────────────────────
// Population covariance of paired samples: mean of (xi - mean_x)(yi - mean_y). Uses the SAME /n convention as
// stats_variance so that slope = cov/var_x and correlation = cov/(sd_x*sd_y) cancel cleanly. 0.0 if the lists
// are empty or unequal length (nothing meaningful to pair).
fn stats_covariance(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    if len(ys) != n
        return 0.0
    let mx = stats_mean(xs)
    let my = stats_mean(ys)
    let acc = 0.0
    let i = 0
    while i < n
        acc = acc + (xs[i] * 1.0 - mx) * (ys[i] * 1.0 - my)
        i = i + 1
    acc / (n * 1.0)

// Pearson correlation coefficient r in [-1, 1]: cov(x,y) / (sd_x * sd_y). Returns 0.0 when either series is
// constant (zero variance -> correlation undefined; 0.0 is the safe, no-linear-relationship answer).
fn stats_correlation(xs: list, ys: list) -> float
    let sdx = stats_stddev(xs)
    let sdy = stats_stddev(ys)
    if sdx == 0.0
        return 0.0
    if sdy == 0.0
        return 0.0
    stats_covariance(xs, ys) / (sdx * sdy)

// Ordinary-least-squares slope of y on x: cov(x,y) / var(x). 0.0 if x is constant (vertical/undefined fit).
fn stats_linreg_slope(xs: list, ys: list) -> float
    let vx = stats_variance(xs)
    if vx == 0.0
        return 0.0
    stats_covariance(xs, ys) / vx

// OLS intercept: mean_y - slope * mean_x. Pair with stats_linreg_slope to get y = slope*x + intercept.
fn stats_linreg_intercept(xs: list, ys: list) -> float
    stats_mean(ys) - stats_linreg_slope(xs, ys) * stats_mean(xs)
