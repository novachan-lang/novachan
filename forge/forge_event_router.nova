// forge_event_router — Route events to handlers by topic.

fn er_new() -> dict
    let r = {}
    r["routes"] = {}
    r["route_count"] = 0
    r["routed"] = 0
    r["unrouted"] = 0
    r

fn er_add_route(r: dict, topic: string, handler: string) -> dict
    r["routes"][topic] = handler
    r["route_count"] = r["route_count"] + 1
    r

fn er_remove_route(r: dict, topic: string) -> dict
    let has = contains(r["routes"], topic)
    if has == true
        r["routes"][topic] = ""
        r["route_count"] = r["route_count"] - 1
    r

fn er_route(r: dict, topic: string) -> dict
    let result = {}
    let has = contains(r["routes"], topic)
    if has == true
        let handler = r["routes"][topic]
        if handler != ""
            result["found"] = 1
            result["handler"] = handler
            r["routed"] = r["routed"] + 1
            result["r"] = r
            return result
    result["found"] = 0
    result["handler"] = ""
    r["unrouted"] = r["unrouted"] + 1
    result["r"] = r
    result

fn er_has_route(r: dict, topic: string) -> int
    let has = contains(r["routes"], topic)
    if has != true
        return 0
    if r["routes"][topic] == ""
        return 0
    1

fn er_route_count(r: dict) -> int
    r["route_count"]

fn er_total_routed(r: dict) -> int
    r["routed"]

fn er_total_unrouted(r: dict) -> int
    r["unrouted"]

fn er_route_rate(r: dict) -> int
    let total = r["routed"] + r["unrouted"]
    if total == 0
        return 100
    r["routed"] * 100 / total
