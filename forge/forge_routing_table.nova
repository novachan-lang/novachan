// forge_routing_table — prefix-based routing table with longest-match and Result API.

fn rtbl_new() -> dict
    {"route_count": 0, "lookups": 0, "matches": 0}

fn rtbl_add(r: dict, prefix: string, target: string) -> dict
    let idx = r["route_count"]
    r["rt_" + str(idx) + "_prefix"] = prefix
    r["rt_" + str(idx) + "_target"] = target
    r["route_count"] = idx + 1
    r

fn rtbl_lookup(r: dict, path: string) -> Result
    r["lookups"] += 1
    let best_idx = -1
    let best_len = -1
    for i in 0..r["route_count"]
        let prefix = r["rt_" + str(i) + "_prefix"]
        let plen = len(prefix)
        if plen <= len(path) and slice(path, 0, plen) == prefix and plen > best_len
            best_len = plen
            best_idx = i
    if best_idx == -1
        return err("no route for: {path}")
    r["matches"] += 1
    ok(r["rt_" + str(best_idx) + "_target"])

fn rtbl_route_count(r: dict) -> int
    r["route_count"]

fn rtbl_total_lookups(r: dict) -> int
    r["lookups"]

fn rtbl_match_count(r: dict) -> int
    r["matches"]
