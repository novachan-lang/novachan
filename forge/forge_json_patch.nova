// forge_json_patch — Apply JSON Patch-like operations to dicts.

fn jp_new() -> dict
    let p = {}
    p["ops"] = {}
    p["op_count"] = 0
    p

fn jp_add(p: dict, path: string, value: string) -> dict
    let k = str(p["op_count"])
    p["ops"][k + "_op"] = "add"
    p["ops"][k + "_path"] = path
    p["ops"][k + "_value"] = value
    p["op_count"] = p["op_count"] + 1
    p

fn jp_remove(p: dict, path: string) -> dict
    let k = str(p["op_count"])
    p["ops"][k + "_op"] = "remove"
    p["ops"][k + "_path"] = path
    p["ops"][k + "_value"] = ""
    p["op_count"] = p["op_count"] + 1
    p

fn jp_replace(p: dict, path: string, value: string) -> dict
    let k = str(p["op_count"])
    p["ops"][k + "_op"] = "replace"
    p["ops"][k + "_path"] = path
    p["ops"][k + "_value"] = value
    p["op_count"] = p["op_count"] + 1
    p

fn jp_apply(p: dict, target: dict) -> dict
    let result = {}
    let ks = keys(target)
    for i in 0..len(ks)
        result[ks[i]] = target[ks[i]]
    let j = 0
    while j < p["op_count"]
        let k = str(j)
        let op = p["ops"][k + "_op"]
        let path = p["ops"][k + "_path"]
        let val = p["ops"][k + "_value"]
        if op == "add"
            result[path] = val
        if op == "replace"
            let has = contains(result, path)
            if has == true
                result[path] = val
        if op == "remove"
            let has2 = contains(result, path)
            if has2 == true
                result[path] = ""
        j += 1
    result

fn jp_op_count(p: dict) -> int
    p["op_count"]

fn jp_op_type(p: dict, idx: int) -> string
    p["ops"][str(idx) + "_op"]

fn jp_op_path(p: dict, idx: int) -> string
    p["ops"][str(idx) + "_path"]
