// forge_json_patch -- thin wrapper over std/data/json_patch (canonical implementation).
import std/data/json_patch

fn jp_new() -> dict
    {"ops": {}, "op_count": 0}

fn jp_add(p: dict, path: string, value: string) -> dict
    let k = str(p["op_count"])
    p["ops"]["{k}_op"] = "add"
    p["ops"]["{k}_path"] = path
    p["ops"]["{k}_value"] = value
    p["op_count"] += 1
    p

fn jp_remove(p: dict, path: string) -> dict
    return jsp_op_remove(p, path)

fn jp_replace(p: dict, path: string, value: string) -> dict
    let k = str(p["op_count"])
    p["ops"]["{k}_op"] = "replace"
    p["ops"]["{k}_path"] = path
    p["ops"]["{k}_value"] = value
    p["op_count"] += 1
    p

fn jp_apply(p: dict, target: dict) -> dict
    return jsp_apply(p, target)

fn jp_op_count(p: dict) -> int
    p["op_count"]

fn jp_op_type(p: dict, idx: int) -> string
    let k = str(idx)
    p["ops"]["{k}_op"]

fn jp_op_path(p: dict, idx: int) -> string
    let k = str(idx)
    p["ops"]["{k}_path"]

