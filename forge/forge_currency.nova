// forge_currency -- ISO 4217 currency data: map a currency code (USD/EUR/JPY) to its symbol, English name, and
// minor-unit decimal places (JPY/KRW=0, most=2, BHD/KWD=3). For multi-currency checkout, price display, and
// correct money rounding. Complements forge_money / forge_money_fmt / forge_country. LEAF -- imports NOTHING.

fn _cur_symbols() -> dict
    {
        "USD": "$",
        "CAD": "$",
        "AUD": "$",
        "EUR": "EUR",
        "GBP": "GBP",
        "JPY": "JPY",
        "CNY": "CNY",
        "INR": "INR",
        "CHF": "CHF",
        "SEK": "kr",
        "NOK": "kr",
        "DKK": "kr",
        "BRL": "R$",
        "MXN": "$",
        "ZAR": "R",
        "RUB": "RUB",
        "KRW": "KRW",
        "SGD": "$",
        "HKD": "$",
        "NZD": "$",
        "AED": "AED",
        "SAR": "SAR",
        "TRY": "TRY",
        "PLN": "zl",
        "BHD": "BHD",
        "KWD": "KWD"
    }

fn _cur_names() -> dict
    {
        "USD": "US Dollar",
        "CAD": "Canadian Dollar",
        "AUD": "Australian Dollar",
        "EUR": "Euro",
        "GBP": "British Pound",
        "JPY": "Japanese Yen",
        "CNY": "Chinese Yuan",
        "INR": "Indian Rupee",
        "CHF": "Swiss Franc",
        "SEK": "Swedish Krona",
        "NOK": "Norwegian Krone",
        "DKK": "Danish Krone",
        "BRL": "Brazilian Real",
        "MXN": "Mexican Peso",
        "ZAR": "South African Rand",
        "RUB": "Russian Ruble",
        "KRW": "South Korean Won",
        "SGD": "Singapore Dollar",
        "HKD": "Hong Kong Dollar",
        "NZD": "New Zealand Dollar",
        "AED": "UAE Dirham",
        "SAR": "Saudi Riyal",
        "TRY": "Turkish Lira",
        "PLN": "Polish Zloty",
        "BHD": "Bahraini Dinar",
        "KWD": "Kuwaiti Dinar"
    }

fn currency_valid(code: string) -> bool
    upper(trim(code)) in _cur_symbols()

fn currency_symbol(code: string) -> string
    let m = _cur_symbols()
    let k = upper(trim(code))
    if k in m
        return m[k]
    ""

fn currency_name(code: string) -> string
    let m = _cur_names()
    let k = upper(trim(code))
    if k in m
        return m[k]
    ""

// Minor-unit decimal places: 0 for JPY/KRW, 3 for BHD/KWD, else 2 (the ISO 4217 default).
fn currency_decimals(code: string) -> int
    let k = upper(trim(code))
    if k == "JPY" or k == "KRW"
        return 0
    if k == "BHD" or k == "KWD"
        return 3
    2
