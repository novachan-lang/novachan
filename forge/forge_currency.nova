// forge_currency -- ISO 4217 currency data: map a currency code (USD/EUR/JPY) to its symbol, English name, and
// minor-unit decimal places (JPY/KRW=0, most=2, BHD/KWD=3). For multi-currency checkout, price display, and
// correct money rounding. Complements forge_money / forge_money_fmt / forge_country. LEAF -- imports NOTHING.

fn _cur_symbols() -> dict
    let m = {}
    m["USD"] = "$"
    m["CAD"] = "$"
    m["AUD"] = "$"
    m["EUR"] = "EUR"
    m["GBP"] = "GBP"
    m["JPY"] = "JPY"
    m["CNY"] = "CNY"
    m["INR"] = "INR"
    m["CHF"] = "CHF"
    m["SEK"] = "kr"
    m["NOK"] = "kr"
    m["DKK"] = "kr"
    m["BRL"] = "R$"
    m["MXN"] = "$"
    m["ZAR"] = "R"
    m["RUB"] = "RUB"
    m["KRW"] = "KRW"
    m["SGD"] = "$"
    m["HKD"] = "$"
    m["NZD"] = "$"
    m["AED"] = "AED"
    m["SAR"] = "SAR"
    m["TRY"] = "TRY"
    m["PLN"] = "zl"
    m["BHD"] = "BHD"
    m["KWD"] = "KWD"
    m

fn _cur_names() -> dict
    let m = {}
    m["USD"] = "US Dollar"
    m["CAD"] = "Canadian Dollar"
    m["AUD"] = "Australian Dollar"
    m["EUR"] = "Euro"
    m["GBP"] = "British Pound"
    m["JPY"] = "Japanese Yen"
    m["CNY"] = "Chinese Yuan"
    m["INR"] = "Indian Rupee"
    m["CHF"] = "Swiss Franc"
    m["SEK"] = "Swedish Krona"
    m["NOK"] = "Norwegian Krone"
    m["DKK"] = "Danish Krone"
    m["BRL"] = "Brazilian Real"
    m["MXN"] = "Mexican Peso"
    m["ZAR"] = "South African Rand"
    m["RUB"] = "Russian Ruble"
    m["KRW"] = "South Korean Won"
    m["SGD"] = "Singapore Dollar"
    m["HKD"] = "Hong Kong Dollar"
    m["NZD"] = "New Zealand Dollar"
    m["AED"] = "UAE Dirham"
    m["SAR"] = "Saudi Riyal"
    m["TRY"] = "Turkish Lira"
    m["PLN"] = "Polish Zloty"
    m["BHD"] = "Bahraini Dinar"
    m["KWD"] = "Kuwaiti Dinar"
    m

fn currency_valid(code: string) -> bool
    contains(_cur_symbols(), upper(trim(code)))

fn currency_symbol(code: string) -> string
    let m = _cur_symbols()
    let k = upper(trim(code))
    if contains(m, k)
        return m[k]
    ""

fn currency_name(code: string) -> string
    let m = _cur_names()
    let k = upper(trim(code))
    if contains(m, k)
        return m[k]
    ""

// Minor-unit decimal places: 0 for JPY/KRW, 3 for BHD/KWD, else 2 (the ISO 4217 default).
fn currency_decimals(code: string) -> int
    let k = upper(trim(code))
    if k == "JPY" or k == "KRW"
        return 0
    if k == "BHD" or k == "KWD"
        return 3
    2
