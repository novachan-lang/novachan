// ══════════════════════════════════════════════════════════════════════════════
// forge_http_client — outbound HTTP(S) client (D7r.1). Forge ships a server; a universal-comms
// framework must also CALL OUT (service-to-service, webhooks, OAuth token endpoints, OTLP/SMTP,
// upstream feeds). This composes the shipped substrate — tcp_connect + the netpoller + the TLS
// externs (nova_rt_tls_*, verify-full) — into a real request/response client. It is the P3 unlock:
// resilience decorators (.timeout/.retry/.circuit_breaker), WS/SSE consume, idempotency, and the
// OTLP/SMTP exporters all layer ON this.
//
// v1 scope: all methods, custom headers, request body, https with certificate verification, chunked
// response de-framing, read-to-EOF via `Connection: close`. Body is returned as a string (text/JSON —
// the 95% client case). Follow-ups: keep-alive + connection pool, an app-level read deadline on the TLS
// path (plaintext honours `timeout_ms`), and a bytes body for binary downloads.
// ══════════════════════════════════════════════════════════════════════════════

// forge_otel (pure payload construction, no I/O -- see forge_otel.nova) supplies the full OTLP
// ExportTraceServiceRequest builder (kind/attributes/status/resource/scope). otlp_spans_json below is
// the legacy simple-span entry point (trace_id/span_id/name/start_ns/end_ns only, no resource
// attributes or instrumentation scope name) that this file's callers already use; it now rides
// forge_otel instead of duplicating the resourceSpans/scopeSpans/spans JSON assembly.
import forge_otel

extern fn nova_rt_tls_upgrade(sock: int, host: string, verify: int) -> int
extern fn nova_rt_tls_send_bytes(handle: int, b: bytes) -> int
extern fn nova_rt_tls_recv_bytes(handle: int) -> bytes

type HttpResponse
    status: int
    headers: dict
    body: string

// Parse "scheme://host[:port][/path]" -> [scheme, host, port, path]. Defaults: scheme http, port 80
// (443 for https), path "/". Query strings ride along inside `path` (the first '/' starts the path).
fn parse_url(url: string) -> list
    let scheme = "http"
    let rest = url
    if starts_with(url, "https://")
        scheme = "https"
        rest = slice(url, 8, len(url))
    else if starts_with(url, "http://")
        rest = slice(url, 7, len(url))
    let slash = find(rest, "/")
    let hostport = rest
    let path = "/"
    if slash >= 0
        hostport = slice(rest, 0, slash)
        path = slice(rest, slash, len(rest))
    let host = hostport
    let port = 80
    if scheme == "https"
        port = 443
    let colon = find(hostport, ":")
    if colon >= 0
        host = slice(hostport, 0, colon)
        let pr = parse_int_safe(slice(hostport, colon + 1, len(hostport)))
        if is_ok(pr)
            port = unwrap(pr)
    [scheme, host, port, path]

// Hex chunk-size -> int (lowercased; stops at the first non-hex char, e.g. a ';' chunk-extension).
fn _hexint(s: string) -> int
    let v = 0
    let i = 0
    let digits = "0123456789abcdef"
    let t = lower(s)
    while i < len(t)
        let d = find(digits, slice(t, i, i + 1))
        if d < 0
            i = len(t)
        else
            v = v * 16 + d
            i = i + 1
    v

// Decode a chunked (RFC 7230 §4.1) response body: repeated "<hexsize>[;ext]\r\n<data>\r\n" until a
// zero-size chunk. Returns the concatenated data. Malformed framing stops decoding (returns what it has).
fn _dechunk(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let j = i
        while j + 1 < n and slice(s, j, j + 2) != "\r\n"
            j = j + 1
        let size = _hexint(slice(s, i, j))
        if size <= 0
            return out
        let start = j + 2
        if start + size > n
            return out
        out = out + slice(s, start, start + size)
        i = start + size + 2
    out

// Parse a raw HTTP response into HttpResponse{status, headers(lowercased name->value), body}.
fn parse_response(raw: string) -> HttpResponse
    let he = find(raw, "\r\n\r\n")
    if he < 0
        return HttpResponse(0, {}, raw)
    let header_part = slice(raw, 0, he)
    let body_part = slice(raw, he + 4, len(raw))
    let lines = split(header_part, "\r\n")
    let status = 0
    if len(lines) > 0
        let sl = lines[0]
        // "HTTP/1.1 200 OK" -> the token after the first space
        let sp = find(sl, " ")
        if sp >= 0
            let rest = slice(sl, sp + 1, len(sl))
            let sp2 = find(rest, " ")
            let code = rest
            if sp2 >= 0
                code = slice(rest, 0, sp2)
            let cr = parse_int_safe(code)
            if is_ok(cr)
                status = unwrap(cr)
    let hdrs = {}
    let li = 1
    while li < len(lines)
        let line = lines[li]
        let c = find(line, ":")
        if c > 0
            let name = lower(trim(slice(line, 0, c)))
            let value = trim(slice(line, c + 1, len(line)))
            hdrs[name] = value
        li = li + 1
    let body = body_part
    if contains(hdrs, "transfer-encoding") and find(lower(hdrs["transfer-encoding"]), "chunked") >= 0
        body = _dechunk(body_part)
    HttpResponse(status, hdrs, body)

// The default Host-header value: bare host for a default port, host:port otherwise (RFC 7230 §5.4).
fn _host_header(scheme: string, host: string, port: int) -> string
    if scheme == "https" and port == 443
        return host
    if scheme == "http" and port == 80
        return host
    host + ":" + str(port)

// http_request_to(method, url, headers, body, timeout_ms) -> Result<HttpResponse>. `headers` is a dict of
// extra request headers (Host + Content-Length + Connection are set automatically). For https the socket is
// upgraded with certificate verification (verify=1). `timeout_ms` is an app-level read DEADLINE on the
// plaintext path: a server that stalls mid-response is dropped with err("read timeout") instead of hanging
// the caller (netpoller-parked wait, no busy-poll). timeout_ms <= 0 disables it. (TLS path: relies on the
// OS/connect timeout at v1; compose a resilience .timeout decorator for a hard bound until the TLS read
// deadline lands.) Returns err on connect/TLS/handshake failure or timeout.
fn http_request_to(method: string, url: string, headers: dict, body: string, timeout_ms: int) -> Result<HttpResponse>
    let u = parse_url(url)
    let scheme = u[0]
    let host = u[1]
    let port = u[2]
    let path = u[3]
    let sock = tcp_connect(host, port)
    if sock <= 0
        return err("connect failed: " + host + ":" + str(port))
    let is_tls = scheme == "https"
    let tls = 0
    if is_tls
        tls = unsafe nova_rt_tls_upgrade(sock, host, 1)
        if tls <= 0
            tcp_close(sock)
            return err("tls handshake failed: " + host)

    let req = method + " " + path + " HTTP/1.1\r\nHost: " + _host_header(scheme, host, port) + "\r\n"
    let hk = keys(headers)
    let ki = 0
    while ki < len(hk)
        let k = hk[ki]
        req = req + k + ": " + headers[k] + "\r\n"
        ki = ki + 1
    if len(body) > 0
        req = req + "Content-Length: " + str(len(body)) + "\r\n"
    req = req + "Connection: close\r\n\r\n" + body

    if is_tls
        unsafe nova_rt_tls_send_bytes(tls, str_to_bytes(req))
    else
        tcp_send(sock, req)

    // Read to EOF: `Connection: close` makes the server close after the full response, so read-until-empty
    // yields exactly the message (no Content-Length/keep-alive framing needed at v1).
    let raw = ""
    let alive = true
    let use_to = timeout_ms > 0 and scheme == "http"
    let deadline = (clock_ns() / 1000000) + timeout_ms
    while alive
        if is_tls
            let b = unsafe nova_rt_tls_recv_bytes(tls)
            if bytes_len(b) == 0
                alive = false
            else
                raw = raw + bytes_to_str(b)
        else
            if use_to
                let remaining = deadline - (clock_ns() / 1000000)
                if remaining <= 0
                    tcp_close(sock)
                    return err("read timeout")
                if tcp_wait_readable(sock, remaining) <= 0
                    tcp_close(sock)
                    return err("read timeout")
            let c = tcp_recv(sock)
            if len(c) == 0
                alive = false
            else
                raw = raw + c
    tcp_close(sock)
    ok(parse_response(raw))

// http_request with the default 30s read deadline (plaintext). Use http_request_to for a custom bound.
fn http_request(method: string, url: string, headers: dict, body: string) -> Result<HttpResponse>
    http_request_to(method, url, headers, body, 30000)

// ── Convenience wrappers ────────────────────────────────────────────────────────────────────────────
fn http_get(url: string) -> Result<HttpResponse>
    http_request("GET", url, {}, "")

fn http_get_h(url: string, headers: dict) -> Result<HttpResponse>
    http_request("GET", url, headers, "")

// True for the redirect status codes that carry a Location header to follow.
fn is_redirect(status: int) -> bool
    status == 301 or status == 302 or status == 303 or status == 307 or status == 308

// Origin (scheme://host[:port]) of a URL — everything before the path.
fn url_origin(url: string) -> string
    let sep = find(url, "://")
    if sep < 0
        return url
    let host_start = sep + 3
    let slash = find(slice(url, host_start, len(url)), "/")
    if slash < 0
        return url
    slice(url, 0, host_start + slash)

// Resolve a Location header against the request URL: absolute URLs pass through; a "/rooted" path
// joins the base origin; anything else is treated as origin-relative. (Full RFC-3986 relative
// resolution against the base PATH is a follow-on; this covers the redirects servers actually send.)
fn resolve_location(base: string, loc: string) -> string
    if starts_with(loc, "http://") or starts_with(loc, "https://")
        return loc
    let origin = url_origin(base)
    if starts_with(loc, "/")
        return "{origin}{loc}"
    "{origin}/{loc}"

// GET `url`, following up to `max` redirects (301/302/303/307/308 via Location) and returning the
// FINAL response. Absolute Location URLs are followed as-is; relative-Location resolution + a cookie
// jar are tracked follow-ons (#16 sub-cycles 2-3). Returns the first transport Err, or an Err once
// the redirect budget is exhausted (loop guard against redirect cycles).
fn http_get_follow(url: string, max: int) -> Result<HttpResponse>
    let cur = url
    let hops = 0
    while hops <= max
        match http_request("GET", cur, {}, "")
            Ok(resp) =>
                let loc = resp_header(resp, "location")
                if is_redirect(resp.status) and len(loc) > 0
                    cur = resolve_location(cur, loc)
                    hops = hops + 1
                else
                    return ok(resp)
            Err(e) =>
                return err(e)
    err("http_get_follow: exceeded {max} redirects starting at {url}")

// ── Cookie jar (#16 sub-cycle 2) ──────────────────────────────────────────────────────────────────
// Absorb a response's Set-Cookie into the jar (name -> value). Single cookie per response — the flat
// header dict keeps one Set-Cookie; a multi-cookie response needs a raw-header list (tracked follow-on).
fn jar_absorb(jar: dict, resp: HttpResponse)
    let sc = resp_header(resp, "set-cookie")
    if len(sc) == 0
        return 0
    let semi = find(sc, ";")
    let pair = sc
    if semi >= 0
        pair = slice(sc, 0, semi)
    let eq = find(pair, "=")
    if eq > 0
        jar[trim(slice(pair, 0, eq))] = trim(slice(pair, eq + 1, len(pair)))

// Build a Cookie request-header value from the jar: "n1=v1; n2=v2" (empty when the jar is empty).
fn cookie_header(jar: dict) -> string
    join(["{k}={jar[k]}" for k in keys(jar)], "; ")

// GET following redirects while maintaining a cookie jar: send stored cookies on every hop and absorb
// Set-Cookie from each response (the login-then-redirect session pattern). Mutates `jar` in place.
fn http_get_session(url: string, jar: dict, max: int) -> Result<HttpResponse>
    let cur = url
    let hops = 0
    while hops <= max
        let h = {}
        let ch = cookie_header(jar)
        if len(ch) > 0
            h["Cookie"] = ch
        match http_request("GET", cur, h, "")
            Ok(resp) =>
                jar_absorb(jar, resp)
                let loc = resp_header(resp, "location")
                if is_redirect(resp.status) and len(loc) > 0
                    cur = resolve_location(cur, loc)
                    hops = hops + 1
                else
                    return ok(resp)
            Err(e) =>
                return err(e)
    err("http_get_session: exceeded {max} redirects starting at {url}")

fn http_post(url: string, body: string) -> Result<HttpResponse>
    http_request("POST", url, {}, body)

// POST a JSON body (sets Content-Type: application/json).
fn http_post_json(url: string, body: string) -> Result<HttpResponse>
    let h = {}
    h["Content-Type"] = "application/json"
    http_request("POST", url, h, body)

fn http_put(url: string, body: string) -> Result<HttpResponse>
    http_request("PUT", url, {}, body)

fn http_delete(url: string) -> Result<HttpResponse>
    http_request("DELETE", url, {}, "")

// Fan-out GET: fetch every URL and return the list of Result<HttpResponse> (one per URL, in order). The
// BFF/API-gateway aggregation primitive -- call N upstreams, collect their responses. Written as a NOVA
// list COMPREHENSION (`[http_get(u) for u in urls]`) -- the high-level, "simpler than Python" form Forge
// favors for framework code, cleaner than a manual accumulation loop.
fn http_get_all(urls: list) -> list
    [http_get(u) for u in urls]

// Read a response header (lowercased lookup); "" if absent.
fn resp_header(r: HttpResponse, name: string) -> string
    let k = lower(name)
    if contains(r.headers, k)
        return r.headers[k]
    ""

// ── SSE (Server-Sent Events) CONSUME client (D7r.4) ──────────────────────────────────────────────────
// Consume an upstream text/event-stream (LLM token streams, event feeds, a Forge sse() endpoint). The
// stream state is a dict {"sock","buf"} (reference-semantic, so sse_next mutates the caller's buffer in
// place). v1: plaintext http:// (https/TLS SSE is a follow-up, same as the client body). Only the `data:`
// field is surfaced; `event:`/`id:`/`retry:`/comment lines are parsed-and-skipped.

// Earliest event boundary in `buf`: [index, len] for "\r\n\r\n" (4) or "\n\n" (2); [-1,0] if none yet.
fn _sse_boundary(buf: string) -> list
    let a = find(buf, "\r\n\r\n")
    let b = find(buf, "\n\n")
    if a >= 0 and (b < 0 or a <= b)
        return [a, 4]
    if b >= 0
        return [b, 2]
    [-1, 0]

// Concatenate the `data:` field value(s) of one event block (multiple data lines joined by "\n", per the
// SSE spec). One optional space after the colon is stripped. Non-data fields + ":" comments are ignored.
fn _sse_extract_data(block: string) -> string
    let lines = split(block, "\n")
    let data = ""
    let i = 0
    while i < len(lines)
        let line = lines[i]
        if len(line) > 0 and slice(line, len(line) - 1, len(line)) == "\r"
            line = slice(line, 0, len(line) - 1)
        if starts_with(line, "data:")
            let v = slice(line, 5, len(line))
            if len(v) > 0 and slice(v, 0, 1) == " "
                v = slice(v, 1, len(v))
            if len(data) == 0
                data = v
            else
                data = data + "\n" + v
        i = i + 1
    data

// sse_connect(url) -> Result<any>: open the stream. GET Accept: text/event-stream; verify 200; returns the
// stream state dict {"sock","buf"} (buf holds any bytes read past the response headers). Loop sse_next on it.
fn sse_connect(url: string) -> Result<any>
    let u = parse_url(url)
    let host = u[1]
    let port = u[2]
    let path = u[3]
    let sock = tcp_connect(host, port)
    if sock <= 0
        return err("sse connect failed: " + host + ":" + str(port))
    tcp_send(sock, "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nAccept: text/event-stream\r\nConnection: keep-alive\r\n\r\n")
    let hdr = ""
    let he = find(hdr, "\r\n\r\n")
    while he < 0
        let c = tcp_recv(sock)
        if len(c) == 0
            tcp_close(sock)
            return err("sse: stream closed before headers")
        hdr = hdr + c
        he = find(hdr, "\r\n\r\n")
    let r = parse_response(slice(hdr, 0, he) + "\r\n\r\n")
    if r.status != 200
        tcp_close(sock)
        return err("sse: unexpected status " + str(r.status))
    let s = {}
    s["sock"] = sock
    s["buf"] = slice(hdr, he + 4, len(hdr))
    ok(s)

// sse_next(s) -> Result<string>: block until the next event, return its `data:` payload. err on stream end.
fn sse_next(s) -> Result<string>
    let bd = _sse_boundary(s["buf"])
    while bd[0] < 0
        let c = tcp_recv(s["sock"])
        if len(c) == 0
            return err("sse: stream closed")
        s["buf"] = s["buf"] + c
        bd = _sse_boundary(s["buf"])
    let block = slice(s["buf"], 0, bd[0])
    s["buf"] = slice(s["buf"], bd[0] + bd[1], len(s["buf"]))
    ok(_sse_extract_data(block))

fn sse_close(s)
    tcp_close(s["sock"])

// ── OTLP span exporter (OTLP/HTTP) — rides the outbound client (D7r.3/obs) ─────────────────────────────
// Export tracing spans to an OpenTelemetry collector over OTLP/HTTP (POST <endpoint>/v1/traces). Each span
// is a dict {trace_id (hex), span_id (hex), name, start_ns, end_ns} -- the legacy simple shape; use
// forge_otel.otel_export_request directly for kind/attributes/status/resource-attributes/scope-name.
// Built as the OTLP protobuf-JSON mapping (resourceSpans -> scopeSpans -> spans) via forge_otel (which
// uses json_stringify internally for correct escaping); nanos are strings (int64 precision). This is the
// egress behind "automatic OTel" -- the trace propagation now has somewhere to go.
fn otlp_spans_json(spans: list) -> string
    forge_otel.otel_export_request(spans, {}, "")

// POST the spans to an OTLP/HTTP collector. endpoint is the base (e.g. "http://localhost:4318"); the
// standard traces path /v1/traces is appended. Returns the collector's HTTP response.
fn otlp_export(endpoint: string, spans: list) -> Result<HttpResponse>
    http_post_json(endpoint + "/v1/traces", otlp_spans_json(spans))

// ── SMTP send_mail — outbound mail over TCP (D7r.3/obs) ────────────────────────────────────────────────
// Build the RFC 5322 message (headers + body) that goes in the SMTP DATA phase.
fn smtp_message(from_addr: string, to_addr: string, subject: string, body: string) -> string
    "From: " + from_addr + "\r\nTo: " + to_addr + "\r\nSubject: " + subject + "\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n" + body

fn _smtp_expect(sock: int, code: string) -> bool
    starts_with(tcp_recv(sock), code)

// send_mail(host, port, from, to, subject, body) -> Result<string>: a plaintext SMTP conversation
// (220 greeting -> EHLO -> MAIL FROM -> RCPT TO -> DATA -> message + CRLF.CRLF -> QUIT). Aborts with err on
// any unexpected reply code. v1 is plaintext (no STARTTLS/AUTH -- a follow-up over the same TLS externs the
// client uses; and dot-stuffing of leading-dot body lines is a tracked follow-up).
fn send_mail(host: string, port: int, from_addr: string, to_addr: string, subject: string, body: string) -> Result<string>
    let sock = tcp_connect(host, port)
    if sock <= 0
        return err("smtp connect failed: " + host + ":" + str(port))
    if not _smtp_expect(sock, "220")
        tcp_close(sock)
        return err("smtp: no 220 greeting")
    tcp_send(sock, "EHLO forge\r\n")
    if not _smtp_expect(sock, "250")
        tcp_close(sock)
        return err("smtp: EHLO rejected")
    tcp_send(sock, "MAIL FROM:<" + from_addr + ">\r\n")
    if not _smtp_expect(sock, "250")
        tcp_close(sock)
        return err("smtp: MAIL FROM rejected")
    tcp_send(sock, "RCPT TO:<" + to_addr + ">\r\n")
    if not _smtp_expect(sock, "250")
        tcp_close(sock)
        return err("smtp: RCPT TO rejected")
    tcp_send(sock, "DATA\r\n")
    if not _smtp_expect(sock, "354")
        tcp_close(sock)
        return err("smtp: DATA rejected")
    tcp_send(sock, smtp_message(from_addr, to_addr, subject, body) + "\r\n.\r\n")
    if not _smtp_expect(sock, "250")
        tcp_close(sock)
        return err("smtp: message rejected")
    tcp_send(sock, "QUIT\r\n")
    tcp_close(sock)
    ok("sent")
