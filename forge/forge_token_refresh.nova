// forge_token_refresh — token lifecycle with expiry and refresh tracking and Result API.

fn tr_new() -> dict
    let t = {}
    t["token_count"] = 0
    t["refreshes"] = 0
    t["expirations"] = 0
    t

fn tr_issue(t: dict, token_id: string, ttl: int) -> dict
    t["tk_" + token_id + "_ttl"] = ttl
    t["tk_" + token_id + "_remaining"] = ttl
    t["tk_" + token_id + "_active"] = 1
    t["token_count"] = t["token_count"] + 1
    t

fn tr_refresh(t: dict, token_id: string) -> Result
    let ak = "tk_" + token_id + "_active"
    if ak in t != true
        return err("token not found: " + token_id)
    if t[ak] != 1
        return err("token expired: " + token_id)
    t["tk_" + token_id + "_remaining"] = t["tk_" + token_id + "_ttl"]
    t["refreshes"] = t["refreshes"] + 1
    ok(t)

fn tr_tick(t: dict, token_id: string, elapsed: int) -> Result
    let ak = "tk_" + token_id + "_active"
    if ak in t != true
        return err("token not found: " + token_id)
    if t[ak] != 1
        return err("token already expired")
    let rem = t["tk_" + token_id + "_remaining"] - elapsed
    if rem <= 0
        t["tk_" + token_id + "_remaining"] = 0
        t[ak] = 0
        t["expirations"] = t["expirations"] + 1
    else
        t["tk_" + token_id + "_remaining"] = rem
    ok(t)

fn tr_is_valid(t: dict, token_id: string) -> int
    let ak = "tk_" + token_id + "_active"
    if ak in t == true
        return t[ak]
    0

fn tr_remaining(t: dict, token_id: string) -> Result
    let rk = "tk_" + token_id + "_remaining"
    if rk in t != true
        return err("token not found: " + token_id)
    ok(t[rk])

fn tr_token_count(t: dict) -> int
    t["token_count"]

fn tr_refresh_count(t: dict) -> int
    t["refreshes"]

fn tr_expiration_count(t: dict) -> int
    t["expirations"]
