// forge_gaussint -- arithmetic on GAUSSIAN INTEGERS, the complex numbers a + b*i whose real and imaginary parts are
// both ordinary integers. They form a Euclidean domain -- you can do division-with-remainder and therefore a gcd,
// exactly like plain integers -- which makes them the natural setting for a cluster of classic number-theory facts
// that are awkward over the reals: which primes are a sum of two squares (p = a^2 + b^2 exactly when p = 2 or
// p is 1 mod 4, and the Gaussian gcd hands you the a,b), the structure of Gaussian primes, factoring in Z[i], and
// exact complex lattice computations. Each Gaussian integer is a two-element list [real, imag]. The NORM
// a^2 + b^2 plays the role of absolute value and is multiplicative (norm(z*w) = norm(z)*norm(w)), which is what
// makes the Euclidean algorithm terminate: gint_div rounds the true complex quotient to the NEAREST Gaussian
// integer, guaranteeing the remainder is strictly smaller in norm. gint_gcd returns a canonical associate (first
// quadrant). Integer parts; keep them modest so products (norms reach the square of the magnitude) stay in 64-bit.
// LEAF -- imports NOTHING.

// The norm a^2 + b^2 of z = [a,b] (the squared magnitude; a multiplicative size measure).
fn gint_norm(z: list) -> int
    z[0] * z[0] + z[1] * z[1]

// Sum of two Gaussian integers.
fn gint_add(z: list, w: list) -> list
    [z[0] + w[0], z[1] + w[1]]

// Difference of two Gaussian integers.
fn gint_sub(z: list, w: list) -> list
    [z[0] - w[0], z[1] - w[1]]

// Product (a+bi)(c+di) = (ac - bd) + (ad + bc)i.
fn gint_mul(z: list, w: list) -> list
    let a = z[0]
    let b = z[1]
    let c = w[0]
    let d = w[1]
    [a * c - b * d, a * d + b * c]

// Complex conjugate [a, -b].
fn gint_conj(z: list) -> list
    [z[0], 0 - z[1]]

// PRIVATE: nearest integer to n/den, with den > 0 (round half away from zero).
fn _gi_round_div(n: int, den: int) -> int
    let out = 0
    if n >= 0
        out = (2 * n + den) / (2 * den)
    else
        out = 0 - ((0 - 2 * n + den) / (2 * den))
    out

// Quotient of z by w rounded to the NEAREST Gaussian integer (integer "division" in Z[i]). w must be nonzero.
// z/w = z * conj(w) / norm(w); each component is rounded to nearest.
fn gint_div(z: list, w: list) -> list
    let a = z[0]
    let b = z[1]
    let c = w[0]
    let d = w[1]
    let nw = c * c + d * d
    // z * conj(w) = (a+bi)(c-di) = (ac + bd) + (bc - ad) i
    let re = a * c + b * d
    let im = b * c - a * d
    [_gi_round_div(re, nw), _gi_round_div(im, nw)]

// Remainder of z divided by w: r = z - (z div w) * w. Its norm is strictly less than norm(w).
fn gint_mod(z: list, w: list) -> list
    let q = gint_div(z, w)
    gint_sub(z, gint_mul(q, w))

// PRIVATE: multiply by whichever unit (1, i, -1, -i) lands the value in the canonical first quadrant: real > 0 and
// imag >= 0 (with [0,0] left as is). Makes gcd results deterministic.
fn _gi_normalize(z: list) -> list
    let a = z[0]
    let b = z[1]
    let out = [a, b]
    if a == 0 and b == 0
        out = [0, 0]
    else
        // rotate by i (multiply [a,b] by i -> [-b, a]) until real > 0 and imag >= 0
        let ra = a
        let rb = b
        let guard = 0
        while (ra <= 0 or rb < 0) and guard < 4
            let na = 0 - rb
            let nb = ra
            ra = na
            rb = nb
            guard += 1
        out = [ra, rb]
    out

// The greatest common divisor of two Gaussian integers via the Euclidean algorithm, returned as its canonical
// first-quadrant associate. gcd(z, [0,0]) is z normalized.
fn gint_gcd(z: list, w: list) -> list
    let a = [z[0], z[1]]
    let b = [w[0], w[1]]
    while b[0] != 0 or b[1] != 0
        let r = gint_mod(a, b)
        a = b
        b = r
    _gi_normalize(a)

// True if w divides z exactly (the remainder is zero) -- w is a Gaussian factor of z.
fn gint_divides(w: list, z: list) -> bool
    let r = gint_mod(z, w)
    r[0] == 0 and r[1] == 0
