// forge_snowflake -- Twitter Snowflake distributed IDs: a 64-bit, time-ordered, globally-unique id needing NO
// coordination. Layout: 41-bit ms timestamp (since a custom epoch) | 10-bit machine id | 12-bit per-ms
// sequence. Sortable by creation time, decodable back to the timestamp, collision-free across up to 1024
// machines each emitting up to 4096 ids/ms. State (last_ts + sequence) lives in a dict. LEAF -- imports NOTHING.

fn snowflake_new(machine_id: int, epoch_ms: int) -> dict
    {"machine": machine_id % 1024, "epoch": epoch_ms, "last_ts": -1, "seq": 0}

// Next id at wall-clock `now_ms`. Same ms -> increment the 12-bit sequence; new ms -> reset it. Returns the
// 64-bit id. (On sequence overflow within one ms the caller should advance now_ms; typical loads never hit it.)
fn snowflake_next(s: dict, now_ms: int) -> int
    let ts = now_ms - s["epoch"]
    if ts == s["last_ts"]
        s["seq"] = (s["seq"] + 1) % 4096
    else
        s["seq"] = 0
        s["last_ts"] = ts
    (ts << 22) + (s["machine"] << 12) + s["seq"]

// Absolute unix-ms timestamp encoded in an id.
fn snowflake_timestamp(id: int, epoch_ms: int) -> int
    (id >> 22) + epoch_ms

fn snowflake_machine(id: int) -> int
    (id >> 12) & 1023

fn snowflake_sequence(id: int) -> int
    id & 4095
