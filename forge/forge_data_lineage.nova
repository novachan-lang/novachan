// forge_data_lineage — Data lineage tracking: datasets + parent/child
// dependency edges (child depends on parent).
//
// STATE SHAPE (flat dict, no nesting):
//   state["datasets"]         — string, comma-separated list of every
//                                dataset name added.
//   state["source_"+name]     — string, source_type ("raw"/"derived"/
//                                "external") of `name`.
//   state["parents_"+name]    — string, comma-separated list of `name`'s
//                                parent dataset names (datasets `name`
//                                depends on).
//   state["children_"+name]   — string, comma-separated list of dataset
//                                names that depend on `name`.
//   state["dataset_count"]    — int, total datasets added.
//   state["dep_count"]        — int, total dependency edges added.
//
// LEAF MODULE — imports NOTHING; only NOVA builtins: contains/split/ok/err.

// _dl_has(state, name) -> int — PRIVATE. 1 if dataset `name` was added.
fn _dl_has(state: dict, name: string) -> int
    if ("source_" + name) in state
        return 1
    0

// _dl_token_in(csv, tok) -> int — PRIVATE. 1 if `tok` appears in the
// comma-separated list `csv`.
fn _dl_token_in(csv: string, tok: string) -> int
    let toks = split(csv, ",")
    for t in toks
        if t == tok
            return 1
    0

// _dl_append_token(csv, tok) -> string — PRIVATE. Append `tok` to a
// comma-separated list, unless already present.
fn _dl_append_token(csv: string, tok: string) -> string
    if _dl_token_in(csv, tok) == 1
        return csv
    if csv == ""
        return tok
    csv + "," + tok

// dl_new() -> dict
// Create an empty lineage tracker.
fn dl_new() -> dict
    let state = {}
    state["datasets"] = ""
    state["dataset_count"] = 0
    state["dep_count"] = 0
    state

// dl_add_dataset(state, name, source_type) -> dict
// Register a dataset. Re-adding an existing name is a no-op (source_type
// of the first registration wins).
fn dl_add_dataset(state: dict, name: string, source_type: string) -> dict
    if _dl_has(state, name) == 1
        return state
    state["datasets"] = _dl_append_token(state["datasets"], name)
    state["source_" + name] = source_type
    state["parents_" + name] = ""
    state["children_" + name] = ""
    state["dataset_count"] = state["dataset_count"] + 1
    state

// dl_add_dependency(state, child, parent) -> Result
// Record that `child` depends on `parent`. Both must already be
// registered datasets, else err("dataset not found"). Adding the same
// edge twice is a no-op (dep_count only rises on new edges).
fn dl_add_dependency(state: dict, child: string, parent: string) -> Result
    if _dl_has(state, child) == 0
        return err("dataset not found")
    if _dl_has(state, parent) == 0
        return err("dataset not found")
    if _dl_token_in(state["parents_" + child], parent) == 1
        return ok(state)
    state["parents_" + child] = _dl_append_token(state["parents_" + child], parent)
    state["children_" + parent] = _dl_append_token(state["children_" + parent], child)
    state["dep_count"] = state["dep_count"] + 1
    ok(state)

// dl_get_source(state, name) -> Result
// ok(source_type) of `name`, or err("dataset not found").
fn dl_get_source(state: dict, name: string) -> Result
    if _dl_has(state, name) == 0
        return err("dataset not found")
    ok(state["source_" + name])

// dl_parent_count(state, name) -> Result
// ok(number of parents) of `name`, or err("dataset not found").
fn dl_parent_count(state: dict, name: string) -> Result
    if _dl_has(state, name) == 0
        return err("dataset not found")
    if state["parents_" + name] == ""
        return ok(0)
    let toks = split(state["parents_" + name], ",")
    ok(len(toks))

// dl_child_count(state, name) -> Result
// ok(number of children) of `name`, or err("dataset not found").
fn dl_child_count(state: dict, name: string) -> Result
    if _dl_has(state, name) == 0
        return err("dataset not found")
    if state["children_" + name] == ""
        return ok(0)
    let toks = split(state["children_" + name], ",")
    ok(len(toks))

// dl_dataset_count(state) -> int
// Total number of registered datasets.
fn dl_dataset_count(state: dict) -> int
    state["dataset_count"]

// dl_dependency_count(state) -> int
// Total number of dependency edges recorded.
fn dl_dependency_count(state: dict) -> int
    state["dep_count"]

// dl_has_dataset(state, name) -> int
// Return 1 if `name` is a registered dataset, 0 otherwise.
fn dl_has_dataset(state: dict, name: string) -> int
    _dl_has(state, name)

// dl_is_root(state, name) -> Result
// ok(1) if `name` has no parents (a root/source dataset), ok(0) if it
// has parents, or err("dataset not found").
fn dl_is_root(state: dict, name: string) -> Result
    if _dl_has(state, name) == 0
        return err("dataset not found")
    if state["parents_" + name] == ""
        return ok(1)
    ok(0)
