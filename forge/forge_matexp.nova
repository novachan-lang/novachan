// forge_matexp -- matrix exponentiation: raise a matrix to a huge power in O(k^3 log n) by repeated squaring, the
// standard trick for jumping FAR ahead in any LINEAR RECURRENCE in logarithmic time. A recurrence like Fibonacci
// (a_n = a_{n-1} + a_{n-2}) can be written as multiplying a state vector by a fixed "companion" matrix; applying
// that matrix n times steps n places forward, and matrix power does all n steps with only ~log2(n) multiplies --
// so you can get the 10^18-th term (mod a prime) essentially instantly, where iterating would never finish. Beyond
// recurrences it counts walks of length k in a graph (the k-th power of the adjacency matrix), and powers linear
// maps in dynamics/DSP. Everything is EXACT integer arithmetic under a modulus (to keep entries bounded), so no
// floats. rec_nth solves an arbitrary constant-coefficient recurrence; mat_fib is the classic special case. LEAF.

// The n x n identity matrix.
fn mat_identity(n: int) -> list
    let m = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            if i == j
                push(row, 1)
            else
                push(row, 0)
            j = j + 1
        push(m, row)
        i = i + 1
    m

// Multiply matrices A (n x K) and B (K x p) modulo `mod`. Entries stay below mod, so products fit in 64 bits.
fn mat_mul(a: list, b: list, mod: int) -> list
    let n = len(a)
    let kk = len(b)
    let p = 0
    if kk > 0
        p = len(b[0])
    let out = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < p
            let s = 0
            let k = 0
            while k < kk
                s = (s + a[i][k] * b[k][j]) % mod
                k = k + 1
            push(row, s)
            j = j + 1
        push(out, row)
        i = i + 1
    out

// Raise square matrix A to the power `p` (p >= 0) modulo `mod`, via binary exponentiation.
fn mat_pow(a: list, p: int, mod: int) -> list
    let n = len(a)
    let result = mat_identity(n)
    let base = a
    let e = p
    while e > 0
        if e % 2 == 1
            result = mat_mul(result, base, mod)
        base = mat_mul(base, base, mod)
        e = e / 2
    result

// The n-th Fibonacci number modulo `mod` (fib(0)=0, fib(1)=1), via [[1,1],[1,0]]^n.
fn mat_fib(n: int, mod: int) -> int
    let m = []
    push(m, [1, 1])
    push(m, [1, 0])
    let mp = mat_pow(m, n, mod)
    mp[0][1]

// The n-th term of a linear recurrence a_i = coeffs[0]*a_{i-1} + coeffs[1]*a_{i-2} + ... + coeffs[k-1]*a_{i-k},
// given the first k terms `init` = [a_0, a_1, ..., a_{k-1}], modulo `mod`. O(k^3 log n).
fn rec_nth(coeffs: list, init: list, n: int, mod: int) -> int
    let k = len(coeffs)
    let out = 0
    if n < k
        out = ((init[n] % mod) + mod) % mod
    else
        // companion matrix: row 0 = coeffs, then a shifted identity below
        let m = []
        push(m, coeffs)
        let r = 1
        while r < k
            let row = []
            let c = 0
            while c < k
                if c == r - 1
                    push(row, 1)
                else
                    push(row, 0)
                c = c + 1
            push(m, row)
            r = r + 1
        let mp = mat_pow(m, n - k + 1, mod)
        // a_n = sum_j mp[0][j] * a_{k-1-j}
        let s = 0
        let j = 0
        while j < k
            let av = ((init[k - 1 - j] % mod) + mod) % mod
            s = (s + mp[0][j] * av) % mod
            j = j + 1
        out = s
    out
