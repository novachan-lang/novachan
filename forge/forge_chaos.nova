// forge_chaos — Chaos engineering toolkit.
// Inject faults (latency, errors, drops) into services for resilience testing.

fn chaos_new() -> dict
    {"faults": [], "log": [], "active": 1}

fn chaos_add_fault(c: dict, name: string, kind: string, target: string, probability: int) -> dict
    push(c["faults"], {"name": name, "kind": kind, "target": target, "probability": probability, "enabled": 1, "triggered": 0})
    c

fn chaos_should_inject(c: dict, target: string, request_id: int) -> dict
    let result = {"inject": 0, "fault": "", "kind": ""}
    if c["active"] != 1
        return result
    for i in 0..len(c["faults"])
        let f = c["faults"][i]
        if f["target"] == target and f["enabled"] == 1
            let hash = request_id % 100
            if hash < f["probability"]
                result["inject"] = 1
                result["fault"] = f["name"]
                result["kind"] = f["kind"]
                c["faults"][i]["triggered"] += 1
                push(c["log"], {"fault": f["name"], "target": target, "request_id": request_id})
                return result
    result

fn chaos_disable_fault(c: dict, name: string) -> dict
    for i in 0..len(c["faults"])
        if c["faults"][i]["name"] == name
            c["faults"][i]["enabled"] = 0
            return c
    c

fn chaos_enable_fault(c: dict, name: string) -> dict
    for i in 0..len(c["faults"])
        if c["faults"][i]["name"] == name
            c["faults"][i]["enabled"] = 1
            return c
    c

fn chaos_pause(c: dict) -> dict
    c["active"] = 0
    c

fn chaos_resume(c: dict) -> dict
    c["active"] = 1
    c

fn chaos_fault_count(c: dict) -> int
    len(c["faults"])

fn chaos_trigger_count(c: dict, name: string) -> int
    for i in 0..len(c["faults"])
        if c["faults"][i]["name"] == name
            return c["faults"][i]["triggered"]
    0

fn chaos_log_count(c: dict) -> int
    len(c["log"])
