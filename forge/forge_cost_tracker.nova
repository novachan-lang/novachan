// forge_cost_tracker — Track costs across services/resources.

fn ct_new() -> dict
    let c = {}
    c["costs"] = {}
    c["total"] = 0
    c

fn ct_add_cost(c: dict, service: string, amount: int) -> dict
    let has = contains(c["costs"], service)
    if has == true
        c["costs"][service] = c["costs"][service] + amount
    else
        c["costs"][service] = amount
    c["total"] = c["total"] + amount
    c

fn ct_get_cost(c: dict, service: string) -> int
    let has = contains(c["costs"], service)
    if has != true
        return 0
    c["costs"][service]

fn ct_total(c: dict) -> int
    c["total"]

fn ct_service_count(c: dict) -> int
    len(keys(c["costs"]))

fn ct_top_service(c: dict) -> string
    let ks = keys(c["costs"])
    if len(ks) == 0
        return ""
    let best = ks[0]
    let best_cost = c["costs"][best]
    for i in 1..len(ks)
        if c["costs"][ks[i]] > best_cost
            best_cost = c["costs"][ks[i]]
            best = ks[i]
    best

fn ct_pct_of_total(c: dict, service: string) -> int
    if c["total"] == 0
        return 0
    let has = contains(c["costs"], service)
    if has != true
        return 0
    c["costs"][service] * 100 / c["total"]
