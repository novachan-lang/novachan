// forge_csv_builder — Build CSV output row by row.

fn csv_new() -> dict
    let c = {}
    c["rows"] = {}
    c["row_count"] = 0
    c["col_count"] = 0
    c["header_set"] = 0
    c

fn csv_set_headers(c: dict, h1: string, h2: string, h3: string) -> dict
    c["rows"]["h_0"] = h1
    c["rows"]["h_1"] = h2
    c["rows"]["h_2"] = h3
    c["col_count"] = 3
    c["header_set"] = 1
    c

fn csv_add_row(c: dict, v1: string, v2: string, v3: string) -> dict
    let k = str(c["row_count"])
    c["rows"][k + "_0"] = v1
    c["rows"][k + "_1"] = v2
    c["rows"][k + "_2"] = v3
    c["row_count"] = c["row_count"] + 1
    c

fn csv_cell(c: dict, row: int, col: int) -> string
    c["rows"][str(row) + "_" + str(col)]

fn csv_header(c: dict, col: int) -> string
    c["rows"]["h_" + str(col)]

fn csv_render_row(c: dict, row: int) -> string
    let result = ""
    let i = 0
    while i < c["col_count"]
        if i > 0
            result += ","
        result += c["rows"][str(row) + "_" + str(i)]
        i += 1
    result

fn csv_render_header(c: dict) -> string
    let result_parts = []
    let i = 0
    while i < c["col_count"]
        if i > 0
            push(result_parts, ",")
        push(result_parts, c["rows"]["h_" + str(i)])
        i += 1
    let result = join(result_parts, "")
    result

fn csv_row_count(c: dict) -> int
    c["row_count"]
