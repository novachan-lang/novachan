// forge_experiment_tracker — ML experiment tracking.
// Start experiments with hyperparams, log metrics, track completion, find the best run.

fn et_new() -> dict
    let s = {}
    s["experiments"] = {}
    s["params"] = {}
    s["metrics"] = {}
    s["experiment_count"] = 0
    s["completed_count"] = 0
    s

fn et_start(state: dict, name: string, params_csv: string) -> dict
    let has = contains(state["experiments"], name)
    if has != true
        state["experiment_count"] = state["experiment_count"] + 1
    state["experiments"][name] = "running"
    state["params"][name] = params_csv
    state

fn et_log_metric(state: dict, name: string, metric_name: string, value: int) -> Result
    if contains(state["experiments"], name) != true
        return err("unknown experiment: " + name)
    let mkey = name + "::" + metric_name
    state["metrics"][mkey] = value
    ok(value)

fn et_complete(state: dict, name: string) -> Result
    if contains(state["experiments"], name) != true
        return err("unknown experiment: " + name)
    if state["experiments"][name] == "completed"
        return err("already completed: " + name)
    state["experiments"][name] = "completed"
    state["completed_count"] = state["completed_count"] + 1
    ok(name)

fn et_status(state: dict, name: string) -> Result
    if contains(state["experiments"], name) != true
        return err("unknown experiment: " + name)
    ok(state["experiments"][name])

fn et_metric(state: dict, name: string, metric_name: string) -> Result
    let mkey = name + "::" + metric_name
    if contains(state["metrics"], mkey) != true
        return err("no metric " + metric_name + " for " + name)
    ok(state["metrics"][mkey])

fn et_params(state: dict, name: string) -> Result
    if contains(state["experiments"], name) != true
        return err("unknown experiment: " + name)
    ok(state["params"][name])

fn et_experiment_count(state: dict) -> int
    state["experiment_count"]

fn et_completed_count(state: dict) -> int
    state["completed_count"]

fn et_best(state: dict, metric_name: string) -> Result
    let names = keys(state["experiments"])
    let best_name = ""
    let best_val = 0
    let found = false
    for i in 0..len(names)
        let mkey = names[i] + "::" + metric_name
        if contains(state["metrics"], mkey) == true
            let v = state["metrics"][mkey]
            if found != true
                best_val = v
                best_name = names[i]
                found = true
            else
                if v > best_val
                    best_val = v
                    best_name = names[i]
    if found != true
        return err("no experiments have metric " + metric_name)
    ok(best_name)
