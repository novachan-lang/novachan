// forge_quota_manager — per-key quota tracking with Result API.

fn qm_new() -> dict
    let q = {}
    q["quotas"] = {}
    q["usage"] = {}
    q["total_granted"] = 0
    q["total_denied"] = 0
    q

fn qm_set_quota(q: dict, key: string, limit: int) -> dict
    q["quotas"]["q_" + key] = limit
    let ukey = "u_" + key
    if contains(q["usage"], ukey) != true
        q["usage"][ukey] = 0
    q

fn qm_consume(q: dict, key: string, amount: int) -> Result
    let qk = "q_" + key
    if contains(q["quotas"], qk) != true
        return err("no quota set for " + key)
    let uk = "u_" + key
    let used = q["usage"][uk]
    let limit = q["quotas"][qk]
    if used + amount > limit
        q["total_denied"] = q["total_denied"] + 1
        return err("quota exceeded")
    q["usage"][uk] = used + amount
    q["total_granted"] = q["total_granted"] + 1
    ok(q)

fn qm_remaining(q: dict, key: string) -> Result
    let qk = "q_" + key
    if contains(q["quotas"], qk) != true
        return err("no quota for " + key)
    let uk = "u_" + key
    ok(q["quotas"][qk] - q["usage"][uk])

fn qm_reset(q: dict, key: string) -> Result
    let uk = "u_" + key
    if contains(q["usage"], uk) != true
        return err("no usage for " + key)
    q["usage"][uk] = 0
    ok(q)

fn qm_usage(q: dict, key: string) -> Result
    let uk = "u_" + key
    if contains(q["usage"], uk) != true
        return err("no usage for " + key)
    ok(q["usage"][uk])

fn qm_total_granted(q: dict) -> int
    q["total_granted"]

fn qm_total_denied(q: dict) -> int
    q["total_denied"]
