// forge_listutil -- in-memory list utilities: paginate, chunk (batch), flatten one level, and dedup preserving
// order. For paginating already-loaded arrays (search results, cached data), batching work, and cleaning data.
// Pairs with forge_pagination (metadata). LEAF -- imports NOTHING.

// One 1-based `page` of `per_page` items from `items` (empty if out of range).
fn list_page(items: list, page: int, per_page: int) -> list
    let p = page
    if p < 1
        p = 1
    let start = (p - 1) * per_page
    let out = []
    let i = start
    let stop = start + per_page
    while i < stop and i < len(items)
        push(out, items[i])
        i += 1
    out

// Split into chunks of size `n` -> a list of lists (batch processing). n<=0 -> [].
fn list_chunk(items: list, n: int) -> list
    let out = []
    if n <= 0
        return out
    let i = 0
    while i < len(items)
        let chunk = []
        let j = i
        while j < i + n and j < len(items)
            push(chunk, items[j])
            j += 1
        push(out, chunk)
        i += n
    out

// Flatten a list-of-lists one level into a flat list.
fn list_flatten(nested: list) -> list
    let out = []
    for i in 0..len(nested)
        let sub = nested[i]
        let j = 0
        while j < len(sub)
            push(out, sub[j])
            j += 1
    out

// Dedup preserving first-seen order (by string form of each element).
fn list_unique(items: list) -> list
    let seen = {}
    let out = []
    for i in 0..len(items)
        let v = str(items[i])
        if v in seen == false
            seen[v] = 1
            push(out, items[i])
    out
