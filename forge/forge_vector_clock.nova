// forge_vector_clock — Vector clocks for distributed ordering.
// Track per-node logical time, compare, merge.

fn vc_new() -> dict
    let vc = {}
    vc["clocks"] = {}
    vc

fn vc_increment(vc: dict, node: string) -> dict
    let has = contains(vc["clocks"], node)
    if has != true
        vc["clocks"][node] = 0
    vc["clocks"][node] = vc["clocks"][node] + 1
    vc

fn vc_get(vc: dict, node: string) -> int
    let has = contains(vc["clocks"], node)
    if has != true
        return 0
    vc["clocks"][node]

fn vc_merge(a: dict, b: dict) -> dict
    let result = {}
    result["clocks"] = {}
    let a_nodes = keys(a["clocks"])
    for i in 0..len(a_nodes)
        result["clocks"][a_nodes[i]] = a["clocks"][a_nodes[i]]
    let b_nodes = keys(b["clocks"])
    for j in 0..len(b_nodes)
        let has = contains(result["clocks"], b_nodes[j])
        if has != true
            result["clocks"][b_nodes[j]] = b["clocks"][b_nodes[j]]
        else
            if b["clocks"][b_nodes[j]] > result["clocks"][b_nodes[j]]
                result["clocks"][b_nodes[j]] = b["clocks"][b_nodes[j]]
    result

fn vc_happens_before(a: dict, b: dict) -> int
    let a_nodes = keys(a["clocks"])
    let i = 0
    let all_leq = 1
    let some_lt = 0
    while i < len(a_nodes)
        let a_val = a["clocks"][a_nodes[i]]
        let b_val = vc_get(b, a_nodes[i])
        if a_val > b_val
            return 0
        if a_val < b_val
            some_lt = 1
        i += 1
    let b_nodes = keys(b["clocks"])
    for j in 0..len(b_nodes)
        let has = contains(a["clocks"], b_nodes[j])
        if has != true
            if b["clocks"][b_nodes[j]] > 0
                some_lt = 1
    if all_leq == 1
        if some_lt == 1
            return 1
    0

fn vc_node_count(vc: dict) -> int
    len(keys(vc["clocks"]))
