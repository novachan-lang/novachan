// forge_queue_router — Message queue routing (topic→queue mapping).
// Bindings, routing keys, dead-letter, fan-out.

fn qr_new() -> dict
    let r = {}
    r["queues"] = {}
    r["bindings"] = []
    r["dead_letter"] = []
    r

fn qr_create_queue(router: dict, name: string) -> dict
    let q = {}
    q["messages"] = []
    q["consumers"] = 0
    router["queues"][name] = q
    router

fn qr_bind(router: dict, routing_key: string, queue_name: string) -> dict
    let b = {}
    b["key"] = routing_key
    b["queue"] = queue_name
    push(router["bindings"], b)
    router

fn qr_publish(router: dict, routing_key: string, message: any) -> dict
    let matched = false
    let i = 0
    while i < len(router["bindings"])
        let binding = router["bindings"][i]
        if binding["key"] == routing_key
            let qname = binding["queue"]
            let has_queue = contains(router["queues"], qname)
            if has_queue == true
                let msg = {}
                msg["key"] = routing_key
                msg["body"] = message
                msg["status"] = "ready"
                push(router["queues"][qname]["messages"], msg)
                matched = true
        i += 1
    if matched == false
        let dead = {}
        dead["key"] = routing_key
        dead["body"] = message
        push(router["dead_letter"], dead)
    router

fn qr_consume(router: dict, queue_name: string) -> any
    let has_queue = contains(router["queues"], queue_name)
    if has_queue != true
        return ""
    let msgs = router["queues"][queue_name]["messages"]
    if len(msgs) == 0
        return ""
    let msg = msgs[0]
    let new_msgs = [msgs[i] for i in 1..len(msgs)]
    router["queues"][queue_name]["messages"] = new_msgs
    msg["body"]

fn qr_queue_depth(router: dict, queue_name: string) -> int
    let has_queue = contains(router["queues"], queue_name)
    if has_queue != true
        return 0
    len(router["queues"][queue_name]["messages"])

fn qr_dead_letter_count(router: dict) -> int
    len(router["dead_letter"])

fn qr_list_queues(router: dict) -> list
    keys(router["queues"])
