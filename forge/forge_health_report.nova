// forge_health_report — system health reporting with Result API.

fn hr_new() -> dict
    let h = {}
    h["checks"] = {}
    h["statuses"] = {}
    h["check_count"] = 0
    h["healthy"] = 0
    h["unhealthy"] = 0
    h

fn hr_add_check(h: dict, name: string) -> dict
    let ck = "c_" + name
    if contains(h["checks"], ck) != true
        h["checks"][ck] = "pending"
        h["check_count"] = h["check_count"] + 1
    h

fn hr_report_healthy(h: dict, name: string) -> Result
    let ck = "c_" + name
    if contains(h["checks"], ck) != true
        return err("check not registered: " + name)
    let was = h["checks"][ck]
    h["checks"][ck] = "healthy"
    if was == "unhealthy"
        h["unhealthy"] = h["unhealthy"] - 1
    if was != "healthy"
        h["healthy"] = h["healthy"] + 1
    ok(h)

fn hr_report_unhealthy(h: dict, name: string, reason: string) -> Result
    let ck = "c_" + name
    if contains(h["checks"], ck) != true
        return err("check not registered")
    let was = h["checks"][ck]
    h["checks"][ck] = "unhealthy"
    let rk = "r_" + name
    h["statuses"][rk] = reason
    if was == "healthy"
        h["healthy"] = h["healthy"] - 1
    if was != "unhealthy"
        h["unhealthy"] = h["unhealthy"] + 1
    ok(h)

fn hr_status(h: dict, name: string) -> Result
    let ck = "c_" + name
    if contains(h["checks"], ck) != true
        return err("check not registered")
    ok(h["checks"][ck])

fn hr_reason(h: dict, name: string) -> Result
    let rk = "r_" + name
    if contains(h["statuses"], rk) != true
        return err("no reason recorded")
    ok(h["statuses"][rk])

fn hr_is_all_healthy(h: dict) -> int
    if h["unhealthy"] == 0
        if h["healthy"] > 0
            return 1
    0

fn hr_healthy_count(h: dict) -> int
    h["healthy"]

fn hr_unhealthy_count(h: dict) -> int
    h["unhealthy"]
