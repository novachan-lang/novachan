// forge_env_expand -- expand ${VAR} and $VAR references in a string from a variables dict (config templating,
// dotenv value interpolation, command templates). Both forms supported; an unknown variable expands to "".
// A lone $ or an unclosed ${ is emitted literally. LEAF -- imports NOTHING.

fn _env_is_namech(c: string) -> bool
    find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_", c) >= 0

fn _env_lookup(vars: dict, name: string) -> string
    if contains(vars, name)
        return str(vars[name])
    ""

// Expand ${VAR} / $VAR in `template` using `vars`. Unknown -> "".
fn env_expand(template: string, vars: dict) -> string
    let ob = chr(123)
    let cb = chr(125)
    let out = ""
    let i = 0
    let n = len(template)
    while i < n
        let c = char_at(template, i)
        if c == "$" and i + 1 < n
            let nx = char_at(template, i + 1)
            if nx == ob
                let rest = slice(template, i + 2, n)
                let close = find(rest, cb)
                if close >= 0
                    out = out + _env_lookup(vars, slice(template, i + 2, i + 2 + close))
                    i = i + 2 + close + 1
                else
                    out = out + c
                    i = i + 1
            else
                let j = i + 1
                while j < n and _env_is_namech(char_at(template, j))
                    j = j + 1
                if j > i + 1
                    out = out + _env_lookup(vars, slice(template, i + 1, j))
                    i = j
                else
                    out = out + c
                    i = i + 1
        else
            out = out + c
            i = i + 1
    out
