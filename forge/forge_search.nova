// forge_search -- lightweight full-text search (tokenize + inverted index + TF ranking). The full-text
// feature Postgres tsvector / Elasticsearch give, for the single-node case: index documents, query returns
// [docid, score] where score = summed term-frequency of the query terms. LEAF -- imports NOTHING.

// Tokenize: lowercase, split on non-alphanumeric, drop empties.
fn _search_tokens(text: string) -> list
    let out = []
    let cur = ""
    let i = 0
    let n = len(text)
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789"
    while i < n
        let c = lower(char_at(text, i))
        if find(allowed, c) >= 0
            cur += c
        else if len(cur) > 0
            push(out, cur)
            cur = ""
        i += 1
    if len(cur) > 0
        push(out, cur)
    out

fn search_new() -> dict
    {"docs": {}}

// Index a document's text under `docid`.
fn search_add(idx: dict, docid: string, text: string) -> dict
    let docs = idx["docs"]
    docs[docid] = _search_tokens(text)
    idx

fn _count_term(tokens: list, term: string) -> int
    len([t for t in tokens if t == term])

// Query: return [docid, score] for every doc matching >=1 query term (score = summed TF). Caller sorts by
// score desc for ranking. Empty query or no matches -> [].
fn search_query(idx: dict, query: string) -> list
    let qterms = _search_tokens(query)
    let results = []
    let docs = idx["docs"]
    for docid in keys(docs)
        let tokens = docs[docid]
        let score = 0
        for i in 0..len(qterms)
            score += _count_term(tokens, qterms[i])
        if score > 0
            push(results, [docid, score])
    results
