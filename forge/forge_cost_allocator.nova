// forge_cost_allocator — Ops/Finance cost allocation across teams/services.
// Register services with an owner, record costs, aggregate by service/owner.

fn ca_new() -> dict
    {"services": {}, "cost_count": 0, "total_spend": 0}

fn ca_add_service(state: dict, service_name: string, owner: string) -> dict
    if service_name not in state["services"]
        state["services"][service_name] = {"owner": owner, "total_cost": 0}
    state

fn ca_record_cost(state: dict, service_name: string, amount: int) -> Result
    if service_name not in state["services"]
        return err("unknown service: {service_name}")
    state["services"][service_name]["total_cost"] += amount
    state["total_spend"] += amount
    state["cost_count"] += 1
    ok(amount)

fn ca_total_cost(state: dict, service_name: string) -> Result
    if service_name not in state["services"]
        return err("unknown service: {service_name}")
    ok(state["services"][service_name]["total_cost"])

fn ca_owner_cost(state: dict, owner: string) -> int
    let names = keys(state["services"])
    let total = 0
    for i in 0..len(names)
        if state["services"][names[i]]["owner"] == owner
            total += state["services"][names[i]]["total_cost"]
    total

fn ca_service_count(state: dict) -> int
    len(keys(state["services"]))

fn ca_total_spend(state: dict) -> int
    state["total_spend"]

fn ca_top_service(state: dict) -> Result
    let names = keys(state["services"])
    if len(names) == 0
        return err("no services")
    let best = names[0]
    let best_cost = state["services"][names[0]]["total_cost"]
    for i in 1..len(names)
        let c = state["services"][names[i]]["total_cost"]
        if c > best_cost
            best_cost = c
            best = names[i]
    ok(best)

fn ca_has_service(state: dict, name: string) -> int
    1 if name in state["services"] else 0

fn ca_cost_count(state: dict) -> int
    state["cost_count"]
