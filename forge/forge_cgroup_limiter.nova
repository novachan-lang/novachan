// forge_cgroup_limiter — resource group limiting (CPU/memory style) with Result API.

fn cg_new() -> dict
    {"groups": {}, "limits": {}, "usage": {}, "group_count": 0, "violations": 0}

fn cg_add_group(c: dict, name: string, cpu_limit: int, mem_limit: int) -> dict
    c["limits"]["cpu_{name}"] = cpu_limit
    c["limits"]["mem_{name}"] = mem_limit
    c["usage"]["ucpu_{name}"] = 0
    c["usage"]["umem_{name}"] = 0
    c["group_count"] += 1
    c

fn cg_use_cpu(c: dict, name: string, amount: int) -> Result
    let ck = "cpu_{name}"
    if ck not in c["limits"]
        return err("group not found")
    let uck = "ucpu_{name}"
    if c["usage"][uck] + amount > c["limits"][ck]
        c["violations"] += 1
        return err("CPU limit exceeded")
    c["usage"][uck] += amount
    ok(c)

fn cg_use_mem(c: dict, name: string, amount: int) -> Result
    let mk = "mem_{name}"
    if mk not in c["limits"]
        return err("group not found")
    let umk = "umem_{name}"
    if c["usage"][umk] + amount > c["limits"][mk]
        c["violations"] += 1
        return err("memory limit exceeded")
    c["usage"][umk] += amount
    ok(c)

fn cg_cpu_usage(c: dict, name: string) -> Result
    let uck = "ucpu_{name}"
    if uck not in c["usage"]
        return err("group not found")
    ok(c["usage"][uck])

fn cg_mem_usage(c: dict, name: string) -> Result
    let umk = "umem_{name}"
    if umk not in c["usage"]
        return err("group not found")
    ok(c["usage"][umk])

fn cg_group_count(c: dict) -> int
    c["group_count"]

fn cg_violations(c: dict) -> int
    c["violations"]
