// forge_cgroup_limiter — resource group limiting (CPU/memory style) with Result API.

fn cg_new() -> dict
    let c = {}
    c["groups"] = {}
    c["limits"] = {}
    c["usage"] = {}
    c["group_count"] = 0
    c["violations"] = 0
    c

fn cg_add_group(c: dict, name: string, cpu_limit: int, mem_limit: int) -> dict
    let ck = "cpu_" + name
    let mk = "mem_" + name
    c["limits"][ck] = cpu_limit
    c["limits"][mk] = mem_limit
    let uck = "ucpu_" + name
    let umk = "umem_" + name
    c["usage"][uck] = 0
    c["usage"][umk] = 0
    c["group_count"] = c["group_count"] + 1
    c

fn cg_use_cpu(c: dict, name: string, amount: int) -> Result
    let ck = "cpu_" + name
    if contains(c["limits"], ck) != true
        return err("group not found")
    let uck = "ucpu_" + name
    if c["usage"][uck] + amount > c["limits"][ck]
        c["violations"] = c["violations"] + 1
        return err("CPU limit exceeded")
    c["usage"][uck] = c["usage"][uck] + amount
    ok(c)

fn cg_use_mem(c: dict, name: string, amount: int) -> Result
    let mk = "mem_" + name
    if contains(c["limits"], mk) != true
        return err("group not found")
    let umk = "umem_" + name
    if c["usage"][umk] + amount > c["limits"][mk]
        c["violations"] = c["violations"] + 1
        return err("memory limit exceeded")
    c["usage"][umk] = c["usage"][umk] + amount
    ok(c)

fn cg_cpu_usage(c: dict, name: string) -> Result
    let uck = "ucpu_" + name
    if contains(c["usage"], uck) != true
        return err("group not found")
    ok(c["usage"][uck])

fn cg_mem_usage(c: dict, name: string) -> Result
    let umk = "umem_" + name
    if contains(c["usage"], umk) != true
        return err("group not found")
    ok(c["usage"][umk])

fn cg_group_count(c: dict) -> int
    c["group_count"]

fn cg_violations(c: dict) -> int
    c["violations"]
