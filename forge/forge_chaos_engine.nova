// forge_chaos_engine -- chaos-engineering experiment runner (Ops). Each experiment moves through
// pending -> running -> passed|failed; ce_start/ce_complete enforce that ordering (no starting a
// running/finished experiment, no completing one that isn't running). Flat-key dict state (no nested
// dicts/lists), matching forge_session_store's convention -- state is mutated in place; callers do not
// need to reassign after Result-returning calls (only the fluent ce_add_experiment needs reassignment
// for chaining).

fn ce_new() -> dict
    {"experiment_count": 0, "passed_count": 0, "failed_count": 0, "running_count": 0}

// Register a chaos experiment (fault_type is informational: "kill" | "delay" | "corrupt" | ...).
// Re-adding an existing name resets it to "pending" without double-counting experiment_count.
fn ce_add_experiment(state: dict, name: string, target: string, fault_type: string) -> dict
    let k = "exp_{name}_registered"
    if k not in state
        state["experiment_count"] = int(state["experiment_count"]) + 1
    state[k] = 1
    state["exp_{name}_target"] = target
    state["exp_{name}_fault"] = fault_type
    state["exp_{name}_status"] = "pending"
    state

fn _ce_registered(state: dict, name: string) -> bool
    "exp_{name}_registered" in state

// ce_start(state, name) -> Result: pending -> running. Err if unknown or not currently pending.
fn ce_start(state: dict, name: string) -> Result
    if not _ce_registered(state, name)
        return err("experiment not found: {name}")
    let st = str(state["exp_{name}_status"])
    if st != "pending"
        return err("experiment not pending (status={st}): {name}")
    state["exp_{name}_status"] = "running"
    state["running_count"] = int(state["running_count"]) + 1
    ok(name)

// ce_complete(state, name, passed) -> Result: running -> passed|failed. Err if unknown or not running.
fn ce_complete(state: dict, name: string, passed: int) -> Result
    if not _ce_registered(state, name)
        return err("experiment not found: {name}")
    let st = str(state["exp_{name}_status"])
    if st != "running"
        return err("experiment not running (status={st}): {name}")
    state["running_count"] = int(state["running_count"]) - 1
    if passed == 1
        state["exp_{name}_status"] = "passed"
        state["passed_count"] = int(state["passed_count"]) + 1
    else
        state["exp_{name}_status"] = "failed"
        state["failed_count"] = int(state["failed_count"]) + 1
    ok(name)

fn ce_status(state: dict, name: string) -> Result
    if not _ce_registered(state, name)
        return err("experiment not found: {name}")
    ok(str(state["exp_{name}_status"]))

fn ce_experiment_count(state: dict) -> int
    int(state["experiment_count"])

fn ce_passed_count(state: dict) -> int
    int(state["passed_count"])

fn ce_failed_count(state: dict) -> int
    int(state["failed_count"])

fn ce_running_count(state: dict) -> int
    int(state["running_count"])

// ce_pass_rate(state) -> Result: pass percentage (0-100) over COMPLETED experiments (passed+failed).
// Err if no experiment has completed yet.
fn ce_pass_rate(state: dict) -> Result
    let passed = int(state["passed_count"])
    let failed = int(state["failed_count"])
    let total = passed + failed
    if total == 0
        return err("no completed experiments")
    ok((passed * 100) / total)
