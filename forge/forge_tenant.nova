// forge_tenant -- multi-tenancy (the SaaS isolation feature Spring/Django need a plugin for). Resolve the
// current tenant from a request (subdomain / X-Tenant-Id header / path prefix) and SCOPE every query to it,
// so one codebase serves many isolated tenants. Strategy here = shared DB + a tenant_id column (the common
// case); a per-tenant-schema strategy swaps behind the same resolve/scope calls. Set the resolved tenant in
// the request ctx (forge_config ctx) so services downstream see it without re-parsing.
//
// LEAF MODULE -- imports NOTHING. Built-ins: find, slice, len, push, str.

// Resolve the tenant slug from a Host header via subdomain: "acme.app.com" with base "app.com" -> "acme".
// The apex ("app.com") or a mismatch -> "" (no tenant).
fn tenant_from_host(host: string, base_domain: string) -> string
    let suffix = "." + base_domain
    let idx = find(host, suffix)
    if idx <= 0
        return ""
    slice(host, 0, idx)

// Resolve from an X-Tenant-Id header value (pass req_header(req,"x-tenant-id")). Returns it verbatim ("" if empty).
fn tenant_from_header(header_value: string) -> string
    header_value

// Resolve from a path prefix "/t/<tenant>/..." -> "<tenant>". "" if the path doesn't start with prefix.
fn tenant_from_path(path: string, prefix: string) -> string
    let idx = find(path, prefix)
    if idx != 0
        return ""
    let rest = slice(path, len(prefix), len(path))
    let slash = find(rest, "/")
    if slash < 0
        return rest
    slice(rest, 0, slash)

// Append tenant scoping to a conds/params pair: adds "tenant_id = ?" + the tenant param -> [conds2, params2].
// Every tenant-scoped query goes through this so cross-tenant leakage is impossible by construction.
fn tenant_scope(conds: list, params: list, tenant_id: string) -> list
    let c2 = [...conds, "tenant_id = ?"]
    let p2 = [...params, tenant_id]
    [c2, p2]

// A tenant-scoped SELECT for a table.
fn tenant_find_sql(table: string, tenant_id: string) -> list
    ["SELECT * FROM {table} WHERE tenant_id = ?", [tenant_id]]

// A tenant-stamped INSERT fields dict: set tenant_id on the row before insert (so writes are tenant-owned).
fn tenant_stamp(fields: dict, tenant_id: string) -> dict
    fields["tenant_id"] = tenant_id
    fields
