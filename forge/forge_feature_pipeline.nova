// forge_feature_pipeline — ML feature engineering pipeline.
// Register features (numeric/categorical/text), record values, query stats via Result.

fn fp_new() -> dict
    {"features": {}, "total_records": 0}

fn fp_add_feature(state: dict, name: string, feature_type: string) -> dict
    state["features"][name] = {"type": feature_type, "count": 0, "sum": 0, "min": 0, "max": 0}
    state

fn fp_record(state: dict, feature_name: string, value: any) -> Result
    if feature_name not in state["features"]
        return err("unknown feature: " + feature_name)
    let f = state["features"][feature_name]
    f["count"] += 1
    state["total_records"] += 1
    if f["type"] == "numeric"
        let n = int(value)
        f["sum"] += n
        if f["count"] == 1
            f["min"] = n
            f["max"] = n
        else
            if n < f["min"]
                f["min"] = n
            if n > f["max"]
                f["max"] = n
    ok(value)

fn fp_mean(state: dict, feature_name: string) -> Result
    if feature_name not in state["features"]
        return err("unknown feature: " + feature_name)
    let f = state["features"][feature_name]
    if f["type"] != "numeric"
        return err("not a numeric feature: " + feature_name)
    if f["count"] == 0
        return err("no values recorded for " + feature_name)
    ok(f["sum"] / f["count"])

fn fp_count(state: dict, feature_name: string) -> Result
    if feature_name not in state["features"]
        return err("unknown feature: " + feature_name)
    ok(state["features"][feature_name]["count"])

fn fp_min(state: dict, feature_name: string) -> Result
    if feature_name not in state["features"]
        return err("unknown feature: " + feature_name)
    let f = state["features"][feature_name]
    if f["type"] != "numeric"
        return err("not a numeric feature: " + feature_name)
    if f["count"] == 0
        return err("no values recorded for " + feature_name)
    ok(f["min"])

fn fp_max(state: dict, feature_name: string) -> Result
    if feature_name not in state["features"]
        return err("unknown feature: " + feature_name)
    let f = state["features"][feature_name]
    if f["type"] != "numeric"
        return err("not a numeric feature: " + feature_name)
    if f["count"] == 0
        return err("no values recorded for " + feature_name)
    ok(f["max"])

fn fp_feature_count(state: dict) -> int
    len(keys(state["features"]))

fn fp_total_records(state: dict) -> int
    state["total_records"]
