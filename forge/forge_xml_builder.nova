// forge_xml_builder — Build XML documents programmatically.

fn xb_new(root_tag: string) -> dict
    {"root": root_tag, "elems": {}, "elem_count": 0}

fn xb_add_elem(x: dict, tag: string, text: string) -> dict
    let k = str(x["elem_count"])
    x["elems"][k + "_tag"] = tag
    x["elems"][k + "_text"] = text
    x["elems"][k + "_attrs"] = ""
    x["elem_count"] += 1
    x

fn xb_add_elem_attr(x: dict, tag: string, text: string, attr_name: string, attr_val: string) -> dict
    let k = str(x["elem_count"])
    x["elems"][k + "_tag"] = tag
    x["elems"][k + "_text"] = text
    x["elems"][k + "_attrs"] = " " + attr_name + "=\"" + attr_val + "\""
    x["elem_count"] += 1
    x

fn xb_elem_tag(x: dict, idx: int) -> string
    x["elems"][str(idx) + "_tag"]

fn xb_elem_text(x: dict, idx: int) -> string
    x["elems"][str(idx) + "_text"]

fn xb_render_elem(x: dict, idx: int) -> string
    let k = str(idx)
    let tag = x["elems"][k + "_tag"]
    let text = x["elems"][k + "_text"]
    let attrs = x["elems"][k + "_attrs"]
    let lt = chr(60)
    let gt = chr(62)
    lt + tag + attrs + gt + text + lt + "/" + tag + gt

fn xb_render(x: dict) -> string
    let lt = chr(60)
    let gt = chr(62)
    let result = lt + x["root"] + gt
    for i in 0..x["elem_count"]
        result += xb_render_elem(x, i)
    result += lt + "/" + x["root"] + gt
    result

fn xb_elem_count(x: dict) -> int
    x["elem_count"]
