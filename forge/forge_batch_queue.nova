// forge_batch_queue — batched processing queue with flush threshold and Result API.

fn bq_new(batch_size: int) -> dict
    let q = {}
    q["items"] = {}
    q["batch_size"] = batch_size
    q["pending"] = 0
    q["total_flushed"] = 0
    q["flush_count"] = 0
    q["item_idx"] = 0
    q

fn bq_add(q: dict, item: string) -> dict
    let key = "i_" + str(q["item_idx"])
    q["items"][key] = item
    q["item_idx"] = q["item_idx"] + 1
    q["pending"] = q["pending"] + 1
    q

fn bq_should_flush(q: dict) -> int
    if q["pending"] >= q["batch_size"]
        return 1
    0

fn bq_flush(q: dict) -> Result
    if q["pending"] == 0
        return err("nothing to flush")
    q["total_flushed"] = q["total_flushed"] + q["pending"]
    q["flush_count"] = q["flush_count"] + 1
    q["pending"] = 0
    q["items"] = {}
    q["item_idx"] = 0
    ok(q)

fn bq_pending(q: dict) -> int
    q["pending"]

fn bq_total_flushed(q: dict) -> int
    q["total_flushed"]

fn bq_flush_count(q: dict) -> int
    q["flush_count"]

fn bq_batch_size(q: dict) -> int
    q["batch_size"]
