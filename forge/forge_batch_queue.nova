// forge_batch_queue — batched processing queue with flush threshold and Result API.
//
// RAISED 2026-08-05. Three problems:
//
//   1. bq_new built the state dict as six individual assignments. Dict literal.
//   2. bq_add used `"i_" + str(q["item_idx"])`. Interpolation.
//   3. bq_add / bq_flush used `q["x"] = q["x"] + 1`. Compound `+=`.

fn bq_new(batch_size: int) -> dict
    {"items": {}, "batch_size": batch_size, "pending": 0, "total_flushed": 0, "flush_count": 0, "item_idx": 0}

fn bq_add(q: dict, item: string) -> dict
    let idx = q["item_idx"]
    q["items"]["i_{idx}"] = item
    q["item_idx"] += 1
    q["pending"] += 1
    q

fn bq_should_flush(q: dict) -> int
    1 if q["pending"] >= q["batch_size"] else 0

fn bq_flush(q: dict) -> Result
    if q["pending"] == 0
        return err("nothing to flush")
    q["total_flushed"] += q["pending"]
    q["flush_count"] += 1
    q["pending"] = 0
    q["items"] = {}
    q["item_idx"] = 0
    ok(q)

fn bq_pending(q: dict) -> int
    q["pending"]

fn bq_total_flushed(q: dict) -> int
    q["total_flushed"]

fn bq_flush_count(q: dict) -> int
    q["flush_count"]

fn bq_batch_size(q: dict) -> int
    q["batch_size"]
