// forge_graph -- unweighted graph with BFS shortest-path and DFS reachability: the engine behind social
// "degrees of separation", dependency reachability, maze/routing, and network analysis. String-labeled
// nodes, directed OR undirected edges, stored as g["adj"] = dict mapping node -> list of neighbor nodes.
// graph_bfs_path returns the SHORTEST node path (fewest edges); graph_distance is that path's edge count.
// LEAF -- imports NOTHING.

fn graph_new() -> dict
    let g = {}
    g["adj"] = {}
    g

// Ensure a node has an adjacency entry so graph_neighbors never sees a missing key.
fn _graph_ensure(g: dict, node: string)
    let adj = g["adj"]
    if node not in adj
        adj[node] = []

// Add a DIRECTED edge from_node -> to_node (auto-creates both nodes, dedups neighbors). Fluent.
fn graph_edge(g: dict, from_node: string, to_node: string) -> dict
    _graph_ensure(g, from_node)
    _graph_ensure(g, to_node)
    let adj = g["adj"]
    let nbrs = adj[from_node]
    if to_node not in nbrs
        push(nbrs, to_node)
    g

// Add an UNDIRECTED edge a <-> b (both directions). Fluent.
fn graph_biedge(g: dict, a: string, b: string) -> dict
    graph_edge(g, a, b)
    graph_edge(g, b, a)
    g

// The neighbor list for a node ([] if the node is unknown).
fn graph_neighbors(g: dict, node: string) -> list
    let adj = g["adj"]
    if node not in adj
        return []
    adj[node]

// The SHORTEST path (list of nodes from start to goal inclusive) via BFS, or [] if unreachable.
// start == goal returns [start].
fn graph_bfs_path(g: dict, start: string, goal: string) -> list
    if start == goal
        let single = []
        push(single, start)
        return single
    let queue = []
    let qh = 0
    let visited = {}
    let parent = {}
    push(queue, start)
    visited[start] = 1
    let found = false
    while qh < len(queue)
        let node = queue[qh]
        qh += 1
        if node == goal
            found = true
        else
            let nbrs = graph_neighbors(g, node)
            for n in nbrs
                if n not in visited
                    visited[n] = 1
                    parent[n] = node
                    push(queue, n)
    if not found
        return []
    // Walk parent pointers from goal back to start, building the path reversed, then flip it.
    let rev = []
    let cur = goal
    push(rev, cur)
    while cur != start
        cur = parent[cur]
        push(rev, cur)
    let path = []
    let i = len(rev) - 1
    while i >= 0
        push(path, rev[i])
        i -= 1
    path

// True if goal is reachable from start.
fn graph_reachable(g: dict, start: string, goal: string) -> bool
    if start == goal
        return true
    len(graph_bfs_path(g, start, goal)) > 0

// Number of EDGES on the shortest path (0 if start == goal, -1 if unreachable).
fn graph_distance(g: dict, start: string, goal: string) -> int
    let path = graph_bfs_path(g, start, goal)
    if len(path) == 0
        return -1
    len(path) - 1
