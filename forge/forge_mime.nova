// forge_mime -- MIME type lookup by file extension, for setting the Content-Type header when serving static
// files (the map every static-file handler needs; modeled on nginx mime.types / Rack::Mime). Lookup is by the
// lowercased text after the LAST "." of the basename -- a dot inside a directory name never leaks in because we
// isolate the basename after the last "/" (or "\\") first. Unknown/absent extension -> application/octet-stream.
// LEAF -- imports NOTHING.

// Index of the last occurrence of a single character in s, or -1 if absent. There is no rfind builtin, so we
// scan forward and remember the most recent match (cheaper than a reverse walk and avoids negative indexing).
fn _last_index(s: string, ch: string) -> int
    let idx = -1
    let i = 0
    let n = len(s)
    while i < n
        if char_at(s, i) == ch
            idx = i
        i = i + 1
    idx

// The lowercased extension without the dot ("" if none). Only the basename after the last "/" (or "\\") and
// after that basename's last "." matters: "a/b/c.TXT" -> "txt", "my.dir/file" -> "" (the dotted directory is
// stripped before the dot search, so it does not count).
fn mime_ext(filename: string) -> string
    let n = len(filename)
    let slash = _last_index(filename, "/")
    let back = _last_index(filename, "\\")
    let cut = slash
    if back > cut
        cut = back
    let base = filename
    if cut >= 0
        base = slice(filename, cut + 1, n)
    let dot = _last_index(base, ".")
    if dot < 0
        return ""
    lower(slice(base, dot + 1, len(base)))

// The MIME type for a filename or path, from its lowercased extension. The extension->type table is built once
// here as a dict; unknown or extensionless names fall back to the generic binary type so a handler can always
// set a valid Content-Type.
fn mime_type(filename: string) -> string
    let ext = mime_ext(filename)
    if ext == ""
        return "application/octet-stream"
    let m = {}
    // Text / markup
    m["html"] = "text/html"
    m["htm"] = "text/html"
    m["css"] = "text/css"
    m["csv"] = "text/csv"
    m["txt"] = "text/plain"
    m["md"] = "text/markdown"
    m["xml"] = "application/xml"
    // Scripts / data
    m["js"] = "application/javascript"
    m["mjs"] = "application/javascript"
    m["json"] = "application/json"
    m["wasm"] = "application/wasm"
    // Images
    m["png"] = "image/png"
    m["jpg"] = "image/jpeg"
    m["jpeg"] = "image/jpeg"
    m["gif"] = "image/gif"
    m["webp"] = "image/webp"
    m["svg"] = "image/svg+xml"
    m["ico"] = "image/x-icon"
    m["bmp"] = "image/bmp"
    m["avif"] = "image/avif"
    // Fonts
    m["woff"] = "font/woff"
    m["woff2"] = "font/woff2"
    m["ttf"] = "font/ttf"
    m["otf"] = "font/otf"
    m["eot"] = "application/vnd.ms-fontobject"
    // Documents / archives
    m["pdf"] = "application/pdf"
    m["zip"] = "application/zip"
    m["gz"] = "application/gzip"
    m["tar"] = "application/x-tar"
    // Media
    m["mp3"] = "audio/mpeg"
    m["wav"] = "audio/wav"
    m["ogg"] = "audio/ogg"
    m["mp4"] = "video/mp4"
    m["webm"] = "video/webm"
    m["mov"] = "video/quicktime"
    // Office
    m["doc"] = "application/msword"
    m["xls"] = "application/vnd.ms-excel"
    if contains(m, ext)
        return m[ext]
    "application/octet-stream"

// True if the MIME type is textual (starts with "text/", or is one of the text-shaped application/* types or
// SVG) -- useful for deciding charset=utf-8 and whether the body is worth compressing.
fn mime_is_text(mime: string) -> bool
    if starts_with(mime, "text/")
        return true
    if mime == "application/json"
        return true
    if mime == "application/javascript"
        return true
    if mime == "application/xml"
        return true
    if mime == "image/svg+xml"
        return true
    false
