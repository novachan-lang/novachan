// forge_ipcidr -- IPv4 address / CIDR matching for allow-deny lists, trusted-proxy verification, and
// abuse/geo blocking (Spring Security hasIpAddress(), nginx allow/deny, Rails trusted_proxies). Parse a
// dotted-quad to a 32-bit int and test membership of a "a.b.c.d/prefix" block. Masking is done by flooring to
// a 2^host_bits boundary (no bitwise-AND operator needed). LEAF -- imports NOTHING.

// PRIVATE: non-empty and all ASCII digits (so a bogus octet like "1a" is rejected, not silently parsed).
fn _digits_only(s: string) -> bool
    if len(s) == 0
        return false
    let i = 0
    while i < len(s)
        if find("0123456789", char_at(s, i)) < 0
            return false
        i = i + 1
    true

fn _pow2(n: int) -> int
    let v = 1
    let i = 0
    while i < n
        v = v * 2
        i = i + 1
    v

// Dotted-quad -> 32-bit int (0 .. 4294967295), or -1 if malformed (wrong part count or an out-of-range octet).
fn ip_to_int(ip: string) -> int
    let parts = split(ip, ".")
    if len(parts) != 4
        return -1
    let v = 0
    let i = 0
    while i < 4
        if _digits_only(parts[i]) == false
            return -1
        let o = parse_int(parts[i])
        if o < 0 or o > 255
            return -1
        v = v * 256 + o
        i = i + 1
    v

// Is `ip` inside the CIDR block "a.b.c.d/prefix"? Both endpoints floored to the network boundary and compared.
// Malformed cidr or ip -> false. "/0" matches everything.
fn cidr_contains(cidr: string, ip: string) -> bool
    let slash = find(cidr, "/")
    if slash < 0
        return false
    let pstr = slice(cidr, slash + 1, len(cidr))
    if _digits_only(pstr) == false
        return false
    let prefix = parse_int(pstr)
    if prefix < 0 or prefix > 32
        return false
    let base = ip_to_int(slice(cidr, 0, slash))
    let addr = ip_to_int(ip)
    if base < 0 or addr < 0
        return false
    let block = _pow2(32 - prefix)
    (base / block) * block == (addr / block) * block

// Does `ip` fall in ANY of the CIDR blocks (an allow/deny list)?
fn ip_in_any(cidrs: list, ip: string) -> bool
    let i = 0
    while i < len(cidrs)
        if cidr_contains(cidrs[i], ip)
            return true
        i = i + 1
    false
