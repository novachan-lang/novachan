fn tb_new(bucket_size)
    {"bucket_size": bucket_size, "bucket_count": 0, "bucket_keys": "", "total_records": 0}

fn tb_record(s, timestamp, value)
    let bsize = int(s["bucket_size"])
    let bucket_id = timestamp / bsize
    let key = "b_{bucket_id}"
    let count_key = "{key}_count"
    let sum_key = "{key}_sum"
    let min_key = "{key}_min"
    let max_key = "{key}_max"
    if count_key not in s
        s[count_key] = 0
        s[sum_key] = 0
        s[min_key] = value
        s[max_key] = value
        s["bucket_count"] = int(s["bucket_count"]) + 1
        if s["bucket_keys"] == ""
            s["bucket_keys"] = str(bucket_id)
        else
            let existing = str(s["bucket_keys"])
            s["bucket_keys"] = "{existing},{bucket_id}"
    s[count_key] = int(s[count_key]) + 1
    s[sum_key] = int(s[sum_key]) + value
    if value < int(s[min_key])
        s[min_key] = value
    if value > int(s[max_key])
        s[max_key] = value
    s["total_records"] = int(s["total_records"]) + 1
    return s

fn tb_count(s, bucket_id) -> Result
    let key = "b_{bucket_id}_count"
    if key not in s
        return err("bucket not found")
    return ok(int(s[key]))

fn tb_sum(s, bucket_id) -> Result
    let key = "b_{bucket_id}_sum"
    if key not in s
        return err("bucket not found")
    return ok(int(s[key]))

fn tb_mean(s, bucket_id) -> Result
    let ckey = "b_{bucket_id}_count"
    if ckey not in s
        return err("bucket not found")
    let cnt = int(s[ckey])
    if cnt == 0
        return err("empty bucket")
    let total = int(s["b_{bucket_id}_sum"])
    return ok(total / cnt)

fn tb_min_val(s, bucket_id) -> Result
    let key = "b_{bucket_id}_min"
    if key not in s
        return err("bucket not found")
    return ok(int(s[key]))

fn tb_max_val(s, bucket_id) -> Result
    let key = "b_{bucket_id}_max"
    if key not in s
        return err("bucket not found")
    return ok(int(s[key]))

fn tb_bucket_count(s)
    return int(s["bucket_count"])

fn tb_total_records(s)
    return int(s["total_records"])

fn tb_bucket_list(s)
    return str(s["bucket_keys"])
