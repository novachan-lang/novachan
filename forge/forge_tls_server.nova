// forge_tls_server — a live TLS 1.3 server over real TCP sockets. Accepts a connection, completes the
// handshake (ServerHello + encrypted EncryptedExtensions/Certificate/CertificateVerify/Finished, signing
// the CertificateVerify with an Ed25519 server key), verifies the client Finished, then exchanges
// encrypted application data. Tested against `openssl s_client -tls1_3`.
import forge_tls
import forge_crypto
import forge_x509
import forge_chain
import forge_limits

// CSPRNG: real OS entropy for the ephemeral X25519 key, server random, and cert key. NOVA's random_int is
// C rand() (non-crypto); nova_rt_os_random uses the OS CSPRNG (CryptGenRandom / urandom). Reached via the
// @link extern FFI so no compiler change is needed (nova_runtime.o is always linked). NOTE: the cert key is
// freshly generated per handshake (self-signed, unverified demo cert); a production server would load a
// stable identity key -- but the ephemeral X25519 key MUST be fresh per handshake, which this guarantees.
extern fn nova_rt_os_random(n: int) -> bytes

// FIX 2 (real CA-issued certs): binary TLS I/O over the runtime's OS-native TLS listener (tls_listen/
// tls_accept are already plain builtins -- see forge_pg.nova for the identical extern pattern for these
// two symbols specifically; tls_close/tls_accept/tls_listen do NOT need extern, they resolve directly).
extern fn nova_rt_tls_send_bytes(handle: int, b: bytes) -> int
extern fn nova_rt_tls_recv_bytes(handle: int) -> bytes

fn _tlss_b2l(b) -> list
    [bytes_get(b, i) for i in 0..bytes_len(b)]

fn _tlss_l2b(lst)
    let b = bytes(0)
    for v in lst
        b = bytes_append(b, v)
    b

// (the old private `_tlss_cat` was byte-for-byte `x_cat` from forge_x509 -- already imported here --
//  which is itself just `[...a, ...b]`. Every former call site now spreads directly.)

fn _tlss_take(lst, n: int) -> list
    [lst[i] for i in 0..n]

fn _tlss_slice(lst, a: int, b: int) -> list
    // Clamp to the source length: a crafted/oversized length field in an attacker-controlled ClientHello
    // must truncate, never index out of range. An inverted or past-the-end range yields [] (verified),
    // exactly as the old `while i < b and i < m` did.
    let m = len(lst)
    let e = b if b < m else m
    [lst[i] for i in a..e]

fn _tlss_fill(sock, buf, need: int) -> list
    while len(buf) < need
        // Slowloris guard: bound each blocking read with an idle deadline. tcp_wait_readable parks on the
        // netpoller with a timeout (no busy-poll); ready!=1 means timed out (0) or error (-1) -> stop and
        // let the caller drop the connection rather than wait forever for a trickling/stalled client.
        let ready = tcp_wait_readable(sock, 15000)
        if ready != 1
            return buf
        let chunk = _tlss_b2l(tcp_recv_bytes(sock))
        if len(chunk) == 0
            return buf
        // append in place -- `buf = [...buf, ...chunk]` would re-copy the whole accumulator per record.
        for v in chunk
            push(buf, v)
    buf

fn _tlss_read_record(sock, buf) -> list
    let b2 = _tlss_fill(sock, buf, 5)
    if len(b2) < 5
        return [-1, [], b2]
    let ct = b2[0]
    let reclen = (b2[3] << 8) | b2[4]
    b2 = _tlss_fill(sock, b2, 5 + reclen)
    if len(b2) < 5 + reclen
        return [-1, [], b2]
    [ct, _tlss_slice(b2, 5, 5 + reclen), _tlss_slice(b2, 5 + reclen, len(b2))]

fn _tlss_send_record(sock, ct: int, ver_lo: int, body) -> int
    tcp_send_bytes(sock, _tlss_l2b([ct, 3, ver_lo, (len(body) >> 8) & 255, len(body) & 255, ...body]))

fn _tlss_wire(ct: int, body) -> list
    [ct, 3, 3, (len(body) >> 8) & 255, len(body) & 255, ...body]

// Parse a ClientHello handshake message -> [client_x25519_pubkey, session_id_bytes].
// Parse a ClientHello -> [client_x25519_pubkey, session_id]. Every direct index is bounds-guarded against
// `n` and every length field is clamped (via _tlss_slice / bounded loops), so a truncated or maliciously-
// sized ClientHello yields an empty/short key (-> handshake aborts in the caller) instead of an OOB panic.
fn _tlss_parse_ch(ch) -> list
    let n = len(ch)
    let p = 4                       // skip handshake header
    p += 2                       // legacy_version
    p += 32                      // random
    if p >= n
        return [[], []]
    let sidlen = ch[p]
    let session_id = _tlss_slice(ch, p + 1, p + 1 + sidlen)
    p += 1 + sidlen
    if p + 1 >= n
        return [[], session_id]
    let cslen = (ch[p] << 8) | ch[p + 1]
    p += 2 + cslen               // cipher_suites
    if p >= n
        return [[], session_id]
    let complen = ch[p]
    p += 1 + complen             // compression methods
    if p + 1 >= n
        return [[], session_id]
    let extlen = (ch[p] << 8) | ch[p + 1]
    p += 2
    let extend = p + extlen
    if extend > n
        extend = n
    let key = []
    while p + 4 <= extend
        let etype = (ch[p] << 8) | ch[p + 1]
        let elen = (ch[p + 2] << 8) | ch[p + 3]
        let edata = p + 4
        if etype == 51
            // KeyShareClientHello: client_shares opaque<uint16> of (group(2) + key_exchange opaque<uint16>)
            if edata + 2 <= n
                let listlen = (ch[edata] << 8) | ch[edata + 1]
                let q = edata + 2
                let qend = q + listlen
                if qend > n
                    qend = n
                while q + 4 <= qend
                    let group = (ch[q] << 8) | ch[q + 1]
                    let kelen = (ch[q + 2] << 8) | ch[q + 3]
                    if group == 29
                        key = _tlss_slice(ch, q + 4, q + 4 + kelen)
                    q += 4 + kelen
        p = edata + elen
    [key, session_id]

// Build a ServerHello handshake message offering TLS_AES_128_GCM_SHA256 + the server X25519 key_share.
fn _tlss_make_sh(server_pub, session_id) -> list
    // key_share (0x0033): group 0x001d || key_exchange opaque<uint16>(server_pub)
    let ks = [0, 29, ..._tls_lp16_s(server_pub)]
    // supported_versions (0x002b) selecting 0x0304, then the key_share extension
    let exts = [0, 43, 0, 2, 3, 4, 0, 51, ..._tls_lp16_s(ks)]
    // legacy_version 0x0303 | 32-byte random | legacy_session_id_echo | cipher_suite 0x1301 |
    // legacy_compression_method 0 | extensions
    let body = [3, 3, ...server_random(), ..._tls_lp8_s(session_id), 19, 1, 0, ..._tls_lp16_s(exts)]
    _tls_hsmsg(2, body)

// 32-byte server random (FIXED for now -- CSPRNG is a tracked follow-up).
fn server_random() -> list
    _tlss_b2l(unsafe nova_rt_os_random(32))

fn _tls_lp8_s(data) -> list
    [len(data), ...data]

fn _tls_lp16_s(data) -> list
    [(len(data) >> 8) & 255, len(data) & 255, ...data]

fn _tls_hsmsg(t: int, body) -> list
    [t, (len(body) >> 16) & 255, (len(body) >> 8) & 255, len(body) & 255, ...body]

// Self-signed Ed25519 server certificate (DER), signed by cert_sk. Fixed validity.
fn _tlss_make_cert(cert_sk) -> list
    let pub = ed25519_publickey(cert_sk)
    let oid = hex_to_blist("2b6570")
    let alg = der_enc(48, der_enc(6, oid))
    let spki = der_enc(48, x_cat(alg, der_enc(3, x_cat(hex_to_blist("00"), pub))))
    let cn = der_enc(6, hex_to_blist("550403"))
    let cnval = der_enc(19, str_to_blist("localhost"))
    let dn = der_enc(48, der_enc(49, der_enc(48, x_cat(cn, cnval))))
    let version = der_enc(160, der_enc(2, hex_to_blist("02")))
    let serial = der_enc(2, hex_to_blist("01"))
    let validity = der_enc(48, x_cat(der_enc(23, str_to_blist("250101000000Z")), der_enc(23, str_to_blist("350101000000Z"))))
    // TBSCertificate fields in DER order: version, serial, sigAlg, issuer, validity, subject, SPKI.
    // (was six sequential x_cat reassignments -- each one re-copied the whole accumulator.)
    let tbs = der_enc(48, [...version, ...serial, ...alg, ...dn, ...validity, ...dn, ...spki])
    let sig = ed25519_sign(cert_sk, tbs)
    der_enc(48, [...tbs, ...alg, ...der_enc(3, [...hex_to_blist("00"), ...sig])])

// Complete one TLS 1.3 server handshake on an accepted socket; returns
// [ok, c_ap_key, c_ap_iv, s_ap_key, s_ap_iv, sock, buf] (app keys for the data phase).
fn tls13_server_handshake(sock, cert_sk, srv_priv) -> list
    let rr = _tlss_read_record(sock, [])
    if rr[0] != 22
        return [0]
    let ch = rr[1]
    let buf = rr[2]
    let chp = _tlss_parse_ch(ch)
    let client_pub = chp[0]
    let session_id = chp[1]
    // Reject a malformed ClientHello (no/short X25519 key_share) BEFORE x25519 -> clean abort, not an OOB.
    if len(client_pub) != 32
        return [0]

    let srv_pub = x25519(srv_priv, _tlss_base9())
    let sh = _tlss_make_sh(srv_pub, session_id)
    _tlss_send_record(sock, 22, 3, sh)

    let transcript = [...ch, ...sh]
    let shared = x25519(srv_priv, client_pub)
    let hs = tls13_handshake_secret(shared)
    let th_ch_sh = sha256_bytes(transcript)
    let s_hs = tls13_derive_secret(hs, "s hs traffic", th_ch_sh)
    let c_hs = tls13_derive_secret(hs, "c hs traffic", th_ch_sh)

    // flight messages
    let ee = _tls_hsmsg(8, [0, 0])
    let cert = _tlss_make_cert(cert_sk)
    // Certificate: request_context (empty) || certificate_list<uint24>{ cert_data<uint24> || ext<uint16>=0 }
    let certmsg = _tls_hsmsg(11, [0, ..._tls_lp24_s([..._tls_lp24_s(cert), 0, 0])])
    transcript = [...transcript, ...ee, ...certmsg]
    let th_cert = sha256_bytes(transcript)
    let cvcontent = tls13_certverify_content("TLS 1.3, server CertificateVerify", th_cert)
    let cvsig = ed25519_sign(cert_sk, cvcontent)
    let cvmsg = _tls_hsmsg(15, [8, 7, ..._tls_lp16_s(cvsig)])
    transcript = [...transcript, ...cvmsg]
    let th_cv = sha256_bytes(transcript)
    let finmsg = _tls_hsmsg(20, tls13_client_finished(s_hs, th_cv))
    transcript = [...transcript, ...finmsg]

    let flight = [...ee, ...certmsg, ...cvmsg, ...finmsg]
    _tlss_send_record(sock, 20, 3, [1])     // ChangeCipherSpec (compat)
    let s_hs_key = tls13_traffic_key(s_hs)
    let s_hs_iv = tls13_traffic_iv(s_hs)
    tcp_send_bytes(sock, _tlss_l2b(tls13_record_seal(s_hs_key, s_hs_iv, 0, flight, 22, 0)))

    let th_sf = sha256_bytes(transcript)

    // read client's records until the encrypted Finished (skip ChangeCipherSpec)
    let c_hs_key = tls13_traffic_key(c_hs)
    let c_hs_iv = tls13_traffic_iv(c_hs)
    // bounded retry budget (was a flag `okfin` threaded through a `while okfin == 0 and guard < 16`)
    for guard in 0..16
        let rec = _tlss_read_record(sock, buf)
        buf = rec[2]
        if rec[0] == -1
            return [0]
        if rec[0] == 23
            let opened = tls13_record_open(c_hs_key, c_hs_iv, 0, _tlss_wire(23, rec[1]))
            if not opened[0]
                return [0]
            // opened[1] = client Finished handshake message
            let cm = tls13_hs_header(opened[1], 0)
            let cvd = _tlss_slice(opened[1], cm[2], cm[3])
            if tls13_verify_server_finished(c_hs, th_sf, cvd) != 1
                return [0]
            // application traffic keys
            let ms = tls13_master_secret(hs)
            let c_ap = tls13_derive_secret(ms, "c ap traffic", th_sf)
            let s_ap = tls13_derive_secret(ms, "s ap traffic", th_sf)
            return [1, tls13_traffic_key(c_ap), tls13_traffic_iv(c_ap), tls13_traffic_key(s_ap), tls13_traffic_iv(s_ap), sock, buf]
    [0]

// The X25519 base point u=9 (little-endian, 32 bytes).
fn _tlss_base9() -> list
    [9, ...[0 for i in 0..31]]

fn _tls_lp24_s(data) -> list
    [(len(data) >> 16) & 255, (len(data) >> 8) & 255, len(data) & 255, ...data]

// Accept one connection on `port` and complete the handshake. Returns the handshake result.
fn tls13_server_accept_once(port: int) -> list
    let cert_sk = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv_priv = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv = tcp_listen(port)
    if srv < 0
        return [0]
    let conn = tcp_accept(srv)
    if conn < 0
        tcp_close(srv)
        return [0]
    let hr = tls13_server_handshake(conn, cert_sk, srv_priv)
    tcp_close(srv)
    hr

// Accept one connection, complete the handshake, read the client's first application record, and send
// `response` (raw bytes) back encrypted. Returns 1 on success. Used by forge HTTPS serving.
fn tls13_serve_once(port: int, response) -> int
    let cert_sk = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv_priv = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv = tcp_listen(port)
    if srv < 0
        return 0
    let conn = tcp_accept(srv)
    if conn < 0
        tcp_close(srv)
        return 0
    let h = tls13_server_handshake(conn, cert_sk, srv_priv)
    if h[0] != 1
        return 0
    let c_ap_key = h[1]
    let c_ap_iv = h[2]
    let s_ap_key = h[3]
    let s_ap_iv = h[4]
    let buf = h[6]
    let cseq = 0
    // bounded retry budget (was `let guard = 0 / while guard < 16 / guard = guard + 1`)
    for guard in 0..16
        let rec = _tlss_read_record(conn, buf)
        buf = rec[2]
        if rec[0] == -1
            return 0
        if rec[0] == 23
            let opened = tls13_record_open(c_ap_key, c_ap_iv, cseq, _tlss_wire(23, rec[1]))
            cseq += 1
            if not opened[0]
                return 0
            if opened[2] == 23
                tcp_send_bytes(conn, _tlss_l2b(tls13_record_seal(s_ap_key, s_ap_iv, 0, response, 23, 0)))
                return 1
    0

// HTTPS serving: accept one connection, complete the TLS 1.3 handshake, read the decrypted HTTP request,
// pass it (as a string) to `handler`, and send the handler's response string back encrypted. Mirrors
// forge.serve(port, handler) but over TLS. Returns 1 on success.
// Serve ONE already-accepted connection: complete the TLS 1.3 handshake (cert signed with cert_sk, ECDHE
// via the ephemeral srv_priv), read the (decrypted) request, run `handler(request_string)`, seal + send the
// response. Returns 1 if a request was served, 0 on handshake/record failure. The per-connection core
// shared by forge_serve_tls (single) and forge_serve_tls_n (loop).
// Content-Length from a request's headers (case-insensitive), or 0 if absent. Digit value via find() on
// "0123456789" (NOVA has no ord()). Explicit bounds (no reliance on && short-circuit) so a header that ends
// mid-number can never index out of range.
fn _tlss_content_length(req) -> int
    let lo = lower(req)
    let idx = find(lo, "content-length:")
    if idx < 0
        return 0
    let p = idx + 15
    let n = len(req)
    while p < n and req[p] == " "
        p += 1
    let v = 0
    let seen = 0
    while p < n
        let d = find("0123456789", req[p])
        if d < 0
            break
        v = v * 10 + d
        seen = 1
        p += 1
    if seen == 0
        return 0
    v

// Is `acc` a COMPLETE HTTP/1.1 request? Complete = headers terminated by \r\n\r\n AND (when a body is
// declared) the body has reached Content-Length. Mirrors recv_request's framing so a request split across
// MULTIPLE TLS records is fully reassembled before dispatch (the old code dispatched only the first record).
fn _tlss_req_complete(acc) -> bool
    let sep = find(acc, "\r\n\r\n")
    if sep < 0
        return false
    let cl = _tlss_content_length(acc)
    if cl <= 0
        return true
    (len(acc) - (sep + 4)) >= cl

fn _tlss_serve_conn(conn: int, handler, cert_sk, srv_priv) -> int
    let h = tls13_server_handshake(conn, cert_sk, srv_priv)
    if h[0] != 1
        return 0
    let c_ap_key = h[1]
    let c_ap_iv = h[2]
    let s_ap_key = h[3]
    let s_ap_iv = h[4]
    let buf = h[6]
    let cseq = 0
    // `acc` stays a plain string accumulator: _tlss_req_complete() has to test the WHOLE accumulated
    // request every iteration, so a parts-list + join would cost exactly the same. Bounded at 64 records.
    let acc = ""
    for guard in 0..64
        let rec = _tlss_read_record(conn, buf)
        buf = rec[2]
        if rec[0] == -1
            return 0
        if rec[0] == 23
            let opened = tls13_record_open(c_ap_key, c_ap_iv, cseq, _tlss_wire(23, rec[1]))
            cseq += 1
            if not opened[0]
                return 0
            if opened[2] == 23
                // Reassemble the HTTP request across records; each app record has its own AEAD seq (cseq).
                acc += bytes_to_str(_tlss_l2b(opened[1]))
                if len(acc) > 1048576
                    return 0
                if _tlss_req_complete(acc)
                    let resp = handler(acc)
                    tcp_send_bytes(conn, _tlss_l2b(tls13_record_seal(s_ap_key, s_ap_iv, 0, str_to_blist(resp), 23, 0)))
                    return 1
    0

fn forge_serve_tls(port: int, handler) -> int
    let cert_sk = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv_priv = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv = tcp_listen(port)
    if srv < 0
        return 0
    let conn = tcp_accept(srv)
    if conn < 0
        tcp_close(srv)
        return 0
    let r = _tlss_serve_conn(conn, handler, cert_sk, srv_priv)
    tcp_close(conn)
    tcp_close(srv)
    r

// The inner per-connection worker: just runs the serve. Spawned + monitored by _tlss_serve_spawned so a
// handler PANIC (route handlers are arbitrary user code -- unwrap-on-Err, overflow, explicit panic) is
// CONTAINED here instead of longjmp'ing over the parent's cleanup.
fn _tlss_run(conn: int, handler, cert_sk, srv_priv)
    _tlss_serve_conn(conn, handler, cert_sk, srv_priv)

// FIX 1 (admission control): default concurrent in-flight cap for the spawn-per-connection loops below --
// matches the plain-HTTP path's default (forge.nova::_max_conns). Every accepted connection otherwise ran a
// full ECDHE + Ed25519 CertificateVerify signing UNCONDITIONALLY, with zero cap: an accept storm could spawn
// unbounded concurrent handshake tasks (CPU exhaustion, not just memory/FDs). Gating happens BEFORE the
// handshake starts (cg_acquire in the accept loop, before spawn), not after.
fn _tlss_max_conns() -> int
    10000

// Serve ONE connection in its own task, CRASH-ISOLATED. The serve runs in a monitored sub-process; whether
// it returns cleanly OR PANICS, the monitor fires and THIS frame (no user code -> never panics) ALWAYS runs
// tcp_close(conn) + cg_release(guard) + send(done_ch,1). Without this, a handler panic would longjmp over
// all three -> the conn fd leaks, the admission-control slot leaks (permanently shrinking the live cap), AND
// the accept loop's drain (receive n done signals) blocks forever (the listener never closes). Mirrors the
// HTTP path's dispatch_safe/_handle_req_safe_done. Connections are handled CONCURRENTLY so a slow handshake
// on one connection cannot block the others.
fn _tlss_serve_spawned(conn: int, handler, cert_sk, srv_priv, done_ch, guard)
    let p = spawn _tlss_run(conn, handler, cert_sk, srv_priv)
    let m = monitor(p)
    receive(m)
    tcp_close(conn)
    cg_release(guard)
    send(done_ch, 1)

// Serve n HTTPS requests (n connections) CONCURRENTLY, capped at _tlss_max_conns() in-flight handshakes+
// handlers via the conn_guard actor (forge_limits) -- N>1-SAFE admission control (a plain dict counter would
// race under NOVA_CARRIERS>1; the actor serializes acquire/release through one owning task). cg_acquire is
// checked BEFORE spawning the handler, i.e. before the (expensive) ECDHE+cert-signing handshake ever starts,
// so an accept storm past the cap is rejected (connection closed, no handshake, no task spawned) instead of
// piling up unbounded concurrent handshakes. The Ed25519 cert key (the server's IDENTITY) is STABLE for the
// server's lifetime; the ephemeral X25519 key is FRESH per connection (forward secrecy). The accept loop
// waits for all n ADMITTED handlers (the done channel) before closing the listener. Returns 1.
fn forge_serve_tls_n(port: int, handler, n: int) -> int
    let cert_sk = _tlss_b2l(unsafe nova_rt_os_random(32))
    let srv = tcp_listen(port)
    if srv < 0
        return 0
    let done_ch = channel()
    let guard = conn_guard(_tlss_max_conns())
    let spawned = 0
    while spawned < n
        let conn = tcp_accept(srv)
        if conn < 0
            break                    // listener error -> stop accepting; DRAIN what we already spawned (no orphans)
        if cg_acquire(guard) != 1
            tcp_close(conn)          // at capacity -- reject BEFORE the handshake; no handler spawned, no permit held
        else
            let srv_priv = _tlss_b2l(unsafe nova_rt_os_random(32))
            spawn _tlss_serve_spawned(conn, handler, cert_sk, srv_priv, done_ch, guard)
            spawned += 1
    // `spawned` is final here, so the drain is a plain counted loop.
    for got in 0..spawned
        receive(done_ch)
    tcp_close(srv)
    conn_guard_stop(guard)
    1

// ── FIX 2: real CA-issued certificates via the runtime's OS-native TLS listener ─────────────────────────
// Every entry point above draws its keypair EXCLUSIVELY from nova_rt_os_random -- a fresh SELF-SIGNED cert
// every process start, which no real client will trust. The runtime already has a working OS-native TLS
// listener (tls_listen -> nova_rt_tls_listen, SChannel on Windows / OpenSSL elsewhere) that loads a REAL
// cert/key from disk and does the complete handshake itself -- this section is purely ADDITIVE: it does not
// touch tls13_server_handshake or any hand-rolled path above, it just routes through the runtime's listener
// instead. cert_path/key_path are passed straight through to nova_rt_tls_listen: PEM file paths on the
// OpenSSL build; on the SChannel (Windows) build cert_path is a PFX file and key_path is its passphrase --
// a pre-existing platform difference in the runtime (nova_runtime.c), not something this module changes.

// Read one complete HTTP/1.1 request off an OS-native TLS handle (tls_recv_bytes already returns decrypted
// application data -- no record-layer bookkeeping needed here, unlike the hand-rolled path above). Bounded
// by the same 64-read / 1MB guards as _tlss_serve_conn; returns whatever was accumulated (possibly
// incomplete) once EOF, the guard, or the size cap is hit -- the caller checks completeness before dispatch.
fn _tlss_read_plain_request(handle) -> string
    let acc = ""
    for guard in 0..64
        let chunk = unsafe nova_rt_tls_recv_bytes(handle)
        if bytes_len(chunk) == 0
            return acc
        acc += bytes_to_str(chunk)
        if len(acc) > 1048576
            return acc
        if _tlss_req_complete(acc)
            return acc
    acc

// Serve ONE already-accepted OS-native TLS connection: read the (decrypted) request, run `handler`, send the
// response back encrypted. Returns 1 iff a complete request was actually served.
fn _tlss_serve_conn_file(handle, handler) -> int
    let acc = _tlss_read_plain_request(handle)
    if not _tlss_req_complete(acc)
        return 0
    let resp = handler(acc)
    unsafe nova_rt_tls_send_bytes(handle, str_to_bytes(resp))
    1

// Crash-isolation inner worker, mirrors _tlss_run for the OS-native path.
fn _tlss_run_file(handle, handler)
    _tlss_serve_conn_file(handle, handler)

// Crash-isolated per-connection wrapper, mirrors _tlss_serve_spawned for the OS-native path: whether the
// serve returns cleanly or PANICS, this frame (never panics) always closes the connection handle, releases
// the admission-control permit, and signals done -- no leaked fd, no leaked permit, no hung drain.
fn _tlss_serve_spawned_file(handle, handler, done_ch, guard)
    let p = spawn _tlss_run_file(handle, handler)
    let m = monitor(p)
    receive(m)
    tls_close(handle)
    cg_release(guard)
    send(done_ch, 1)

// Serve n HTTPS requests using a REAL cert/key loaded from disk instead of the hand-rolled self-signed
// identity -- for presenting a certificate a browser/client will actually trust. Mirrors forge_serve_tls_n's
// admission-control cap (conn_guard, gated before any per-connection work) and crash-isolation shape; the
// handshake itself is done entirely by the runtime's native TLS listener, not tls13_server_handshake.
fn forge_serve_tls_file(port: int, cert_path: string, key_path: string, handler, n: int) -> int
    let srv = tls_listen(port, cert_path, key_path)
    if srv == 0
        return 0
    let done_ch = channel()
    let guard = conn_guard(_tlss_max_conns())
    let spawned = 0
    while spawned < n
        let handle = tls_accept(srv)
        if handle == 0
            break                    // listener error/closed -> stop accepting; DRAIN what we already spawned
        if cg_acquire(guard) != 1
            tls_close(handle)        // at capacity -- reject; connection handle IS safely closeable (NovaTlsConn)
        else
            spawn _tlss_serve_spawned_file(handle, handler, done_ch, guard)
            spawned += 1
    // `spawned` is final here, so the drain is a plain counted loop.
    for got in 0..spawned
        receive(done_ch)
    conn_guard_stop(guard)
    // NOTE (known runtime gap; tracked for the runtime owner, NOT fixed here -- out of this module's scope):
    // there is no safe call that closes the LISTENER handle `srv`. nova_rt_tls_close unconditionally casts
    // its argument to the CONNECTION struct type; on the SChannel (Windows) backend the listener is a
    // DIFFERENT, differently-laid-out struct, so tls_close(srv) would misinterpret live SSPI handles as
    // socket/context fields -- a type-confused OOB read, not a clean close (confirmed by reading
    // nova_rt_tls_listen/nova_rt_tls_accept/nova_rt_tls_close in nova_runtime.c; also why the existing
    // _tls_server_test.nova never closes its listener either). Per-CONNECTION handles from tls_accept ARE
    // the connection struct type and ARE safely closed above. Leaking the listener's one fd+struct until
    // process exit is the correct tradeoff until the runtime grows a dedicated listener-close primitive.
    1
