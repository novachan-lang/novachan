// forge_tenant_manager — Multi-tenant isolation with Result.

fn tm_new() -> dict
    {"tenants": {}, "quotas": {}, "usage": {}, "count": 0}

fn tm_create(t: dict, tenant_id: string, plan: string) -> Result
    if tenant_id in t["tenants"]
        return err("tenant exists: {tenant_id}")
    t["tenants"][tenant_id] = plan
    t["usage"][tenant_id] = 0
    t["count"] += 1
    ok(t)

fn tm_set_quota(t: dict, tenant_id: string, quota: int) -> Result
    if tenant_id not in t["tenants"]
        return err("unknown tenant: {tenant_id}")
    t["quotas"][tenant_id] = quota
    ok(t)

fn tm_use(t: dict, tenant_id: string, amount: int) -> Result
    if tenant_id not in t["tenants"]
        return err("unknown tenant: {tenant_id}")
    if tenant_id in t["quotas"]
        let remaining = t["quotas"][tenant_id] - t["usage"][tenant_id]
        if amount > remaining
            return err("quota exceeded")
    t["usage"][tenant_id] += amount
    ok(t)

fn tm_plan(t: dict, tenant_id: string) -> Result
    if tenant_id not in t["tenants"]
        return err("unknown tenant")
    ok(t["tenants"][tenant_id])

fn tm_usage(t: dict, tenant_id: string) -> int
    t["usage"][tenant_id]

fn tm_tenant_count(t: dict) -> int
    t["count"]
