// forge_data_profiler — Pulse analytics: dataset column profiling.
// Register columns (int/float/string), record values, query stats via Result.

fn dp_new() -> dict
    {"columns": {}, "total_records": 0}

fn dp_add_column(state: dict, col_name: string, col_type: string) -> dict
    let col = {"type": col_type, "total": 0, "count": 0, "null_count": 0, "unique": 0, "seen": {}, "sum_i": 0, "sum_f": 0.0, "min_i": 0, "max_i": 0, "min_f": 0.0, "max_f": 0.0, "min_s": "", "max_s": ""}
    state["columns"][col_name] = col
    state

fn dp_record(state: dict, col_name: string, value: any) -> dict
    if col_name not in state["columns"]
        return state
    let col = state["columns"][col_name]
    col["total"] += 1
    state["total_records"] += 1
    let sval = str(value)
    if sval == ""
        col["null_count"] += 1
        return state
    col["count"] += 1
    if sval not in col["seen"]
        col["seen"][sval] = 1
        col["unique"] += 1
    let ctype = col["type"]
    if ctype == "int"
        let n = int(value)
        col["sum_i"] += n
        if col["count"] == 1
            col["min_i"] = n
            col["max_i"] = n
            col["min_s"] = str(n)
            col["max_s"] = str(n)
        else
            if n < col["min_i"]
                col["min_i"] = n
                col["min_s"] = str(n)
            if n > col["max_i"]
                col["max_i"] = n
                col["max_s"] = str(n)
    else if ctype == "float"
        let f = float(value)
        col["sum_f"] += f
        if col["count"] == 1
            col["min_f"] = f
            col["max_f"] = f
            col["min_s"] = str(f)
            col["max_s"] = str(f)
        else
            if f < col["min_f"]
                col["min_f"] = f
                col["min_s"] = str(f)
            if f > col["max_f"]
                col["max_f"] = f
                col["max_s"] = str(f)
    else if col["count"] == 1
        col["min_s"] = sval
        col["max_s"] = sval
    else
        if sval < col["min_s"]
            col["min_s"] = sval
        if sval > col["max_s"]
            col["max_s"] = sval
    state

fn dp_count(state: dict, col_name: string) -> Result
    if col_name not in state["columns"]
        return err("unknown column: " + col_name)
    ok(state["columns"][col_name]["count"])

fn dp_min(state: dict, col_name: string) -> Result
    if col_name not in state["columns"]
        return err("unknown column: " + col_name)
    if state["columns"][col_name]["count"] == 0
        return err("no data")
    ok(state["columns"][col_name]["min_s"])

fn dp_max(state: dict, col_name: string) -> Result
    if col_name not in state["columns"]
        return err("unknown column: " + col_name)
    if state["columns"][col_name]["count"] == 0
        return err("no data")
    ok(state["columns"][col_name]["max_s"])

fn dp_mean(state: dict, col_name: string) -> Result
    if col_name not in state["columns"]
        return err("unknown column: " + col_name)
    let col = state["columns"][col_name]
    if col["count"] == 0
        return err("no data")
    let ctype = col["type"]
    if ctype == "int"
        return ok(col["sum_i"] / col["count"])
    if ctype == "float"
        return ok(col["sum_f"] / float(col["count"]))
    err("mean not supported for column type: " + ctype)

fn dp_null_count(state: dict, col_name: string) -> Result
    if col_name not in state["columns"]
        return err("unknown column: " + col_name)
    ok(state["columns"][col_name]["null_count"])

fn dp_unique_count(state: dict, col_name: string) -> Result
    if col_name not in state["columns"]
        return err("unknown column: " + col_name)
    ok(state["columns"][col_name]["unique"])

fn dp_column_count(state: dict) -> int
    len(keys(state["columns"]))

fn dp_total_records(state: dict) -> int
    state["total_records"]
