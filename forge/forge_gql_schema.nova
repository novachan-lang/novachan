// forge_gql_schema — schema-from-types: emit GraphQL SDL (Schema Definition Language) directly
// from NOVA struct instances. Zero .graphql file required — the NOVA struct IS the schema.
//
// Scalar mapping:
//   "int"    -> "Int"
//   "float"  -> "Float"
//   "bool"   -> "Boolean"
//   "string" -> "String"
//   anything else -> "String"  (fallback for struct/list/dict fields)
//
// SDL braces are built via chr(123) for `{` and chr(125) for `}` because a literal `{` in a
// NOVA string triggers string interpolation. chr(10) is used for newlines.
//
// Verified by reasoning: gql_type_sdl("User", User(0,"",false)) where User{id:int,name:string,active:bool}
// produces:
//   type User {
//     id: Int
//     name: String
//     active: Boolean
//   }
//
// LEAF MODULE — imports NOTHING. Built-ins used: field_names, field_get, type_of, len, push,
// str, join, contains.

// _gql_scalar(t) -> string   PRIVATE
// Map a NOVA type_of() result to the corresponding GraphQL scalar name.
fn _gql_scalar(t: string) -> string
    if t == "int"
        return "Int"
    if t == "float"
        return "Float"
    if t == "bool"
        return "Boolean"
    "String"

// gql_field_type(sample, field) -> string
// Return the GraphQL scalar for one field of `sample` by inspecting its runtime type.
fn gql_field_type(sample, field: string) -> string
    _gql_scalar(type_of(field_get(sample, field)))

// gql_type_sdl(name, sample) -> string
// Emit the full SDL block for a single type, e.g.:
//   type User {
//     id: Int
//     name: String
//     active: Boolean
//   }
// Uses chr(123)/chr(125) for braces, chr(10) for newlines.
fn gql_type_sdl(name: string, sample) -> string
    let lbrace = chr(123)
    let rbrace = chr(125)
    let nl = chr(10)
    let fields = field_names(sample)
    let lines = []
    for i in 0..len(fields)
        let fname = fields[i]
        let ftype = gql_field_type(sample, fname)
        push(lines, "  " + fname + ": " + ftype)
    let body = join(lines, nl)
    "type " + name + " " + lbrace + nl + body + nl + rbrace

// gql_schema(defs) -> string
// defs is a list of [name, sample] pairs (one per type).
// Returns the SDL for all types joined by a blank line.
fn gql_schema(defs: list) -> string
    let nl = chr(10)
    let parts = []
    for i in 0..len(defs)
        let d = defs[i]
        push(parts, gql_type_sdl(d[0], d[1]))
    join(parts, nl + nl)
