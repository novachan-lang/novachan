// forge_math -- integer math helpers: GCD, LCM, fraction reduction, and integer square root. For ratios and
// aspect ratios, LCM-based scheduling, and number theory. LEAF -- imports NOTHING.

fn gcd(a: int, b: int) -> int
    let x = a
    if x < 0
        x = -x
    let y = b
    if y < 0
        y = -y
    while y != 0
        let t = y
        y = x % y
        x = t
    x

fn lcm(a: int, b: int) -> int
    if a == 0 or b == 0
        return 0
    let g = gcd(a, b)
    let x = a
    if x < 0
        x = -x
    let y = b
    if y < 0
        y = -y
    x / g * y

// Reduce a fraction to lowest terms -> [num, den]. reduce_fraction(6, 8) -> [3, 4].
fn reduce_fraction(num: int, den: int) -> list
    if den == 0
        return [num, 0]
    let g = gcd(num, den)
    if g == 0
        return [0, den]
    [num / g, den / g]

// Integer square root (floor). isqrt(17) -> 4.
fn isqrt(n: int) -> int
    if n < 0
        return 0
    if n == 0
        return 0
    let x = n
    let y = (x + 1) / 2
    while y < x
        x = y
        y = (x + n / x) / 2
    x
