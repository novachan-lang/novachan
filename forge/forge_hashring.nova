// forge_hashring -- consistent hashing (Ketama-style) to distribute keys across nodes/shards with MINIMAL
// remapping when a node is added/removed (the sharding primitive Cassandra/Riak/memcached use; naive
// modulo-hashing reshuffles almost everything on a node change, consistent hashing moves only ~1/N keys).
// Nodes are placed on a hash ring; a key maps to the next node clockwise (wrap-around). LEAF.

// FNV-1a-ish 32-bit string hash (deterministic; bounded < 2^31).
fn _hash_str(s: string) -> int
    let h = 2166136261
    for i in 0..len(s)
        h = (h * 16777619 + ord(char_at(s, i))) % 2147483647
    h

fn hashring_new() -> dict
    let r = {}
    r["nodes"] = []
    r

fn hashring_add(ring: dict, node: string) -> dict
    push(ring["nodes"], node)
    ring

// The node responsible for `key`: the node with the smallest hash >= hash(key); wraps to the smallest-hash
// node if none is larger (the ring). Deterministic given the node set.
fn hashring_node_for(ring: dict, key: string) -> string
    let nodes = ring["nodes"]
    if len(nodes) == 0
        return ""
    let kh = _hash_str(key)
    let best = ""
    let best_hash = 0 - 1
    let smallest = ""
    let smallest_hash = 0 - 1
    for i in 0..len(nodes)
        let nh = _hash_str(nodes[i])
        if smallest_hash < 0 or nh < smallest_hash
            smallest_hash = nh
            smallest = nodes[i]
        if nh >= kh
            if best_hash < 0 or nh < best_hash
                best_hash = nh
                best = nodes[i]
    if best == ""
        return smallest
    best
