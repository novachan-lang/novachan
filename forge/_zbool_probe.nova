import sqlitex

type Todo
    id: int
    title: string
    done: bool

fn main()
    let db = db_open(":memory:")
    print(db_exec(db, "CREATE TABLE Todo (id INTEGER PRIMARY KEY, title TEXT, done INTEGER)"))
    let t = Todo(0, "ship it", false)
    let names = [nm for nm in field_names(t) if nm != "id"]
    let params = [field_get(t, nm) for nm in names]
    print("params types:")
    for p in params
        print(type_name(p))
    print("binding false...")
    let r = db_write(db, "INSERT INTO Todo (title, done) VALUES (?, ?)", params)
    print(is_ok(r))
    let rows = db_query_named(db, "SELECT * FROM Todo", [])
    print(rows)
    print("binding true...")
    let t2 = Todo(0, "second", true)
    let p2 = [field_get(t2, nm) for nm in names]
    let r2 = db_write(db, "INSERT INTO Todo (title, done) VALUES (?, ?)", p2)
    print(is_ok(r2))
    let rows2 = db_query_named(db, "SELECT * FROM Todo", [])
    print(rows2)
    print("SURVIVED")
