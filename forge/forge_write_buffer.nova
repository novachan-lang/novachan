// forge_write_buffer — batched write buffer with flush threshold and Result API.

fn wb_new(threshold: int) -> dict
    let w = {}
    w["items"] = {}
    w["item_count"] = 0
    w["threshold"] = threshold
    w["total_flushed"] = 0
    w["flush_count"] = 0
    w

fn wb_write(w: dict, data: string) -> dict
    let idx = w["item_count"]
    w["items"]["i_" + str(idx)] = data
    w["item_count"] = idx + 1
    w

fn wb_should_flush(w: dict) -> int
    if w["item_count"] >= w["threshold"]
        return 1
    0

fn wb_flush(w: dict) -> Result
    let cnt = w["item_count"]
    if cnt == 0
        return err("buffer empty")
    w["total_flushed"] = w["total_flushed"] + cnt
    w["flush_count"] = w["flush_count"] + 1
    w["items"] = {}
    w["item_count"] = 0
    ok(w)

fn wb_pending(w: dict) -> int
    w["item_count"]

fn wb_total_flushed(w: dict) -> int
    w["total_flushed"]

fn wb_flush_count(w: dict) -> int
    w["flush_count"]

fn wb_threshold(w: dict) -> int
    w["threshold"]
