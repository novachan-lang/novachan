// forge_us_states -- US state reference data + validation for address forms, dropdowns, and shipping/tax
// logic. Maps a 2-letter USPS state code ("CA") to its full name ("California"), with reverse lookup and
// validation. Covers all 50 states plus the District of Columbia (51 entries). Every code lookup uppercases
// + trims its input, so "ca", " Ca ", "CA" all resolve; the reverse name lookup is case-insensitive. The
// single canonical table is built once inside a private helper as a dict keyed by the 2-letter code.
// Complements forge_country. LEAF -- imports NOTHING.

// PRIVATE: 2-letter code -> full state name (50 states + DC).
fn _state_names() -> dict
    let m = {}
    m["AL"] = "Alabama"
    m["AK"] = "Alaska"
    m["AZ"] = "Arizona"
    m["AR"] = "Arkansas"
    m["CA"] = "California"
    m["CO"] = "Colorado"
    m["CT"] = "Connecticut"
    m["DE"] = "Delaware"
    m["FL"] = "Florida"
    m["GA"] = "Georgia"
    m["HI"] = "Hawaii"
    m["ID"] = "Idaho"
    m["IL"] = "Illinois"
    m["IN"] = "Indiana"
    m["IA"] = "Iowa"
    m["KS"] = "Kansas"
    m["KY"] = "Kentucky"
    m["LA"] = "Louisiana"
    m["ME"] = "Maine"
    m["MD"] = "Maryland"
    m["MA"] = "Massachusetts"
    m["MI"] = "Michigan"
    m["MN"] = "Minnesota"
    m["MS"] = "Mississippi"
    m["MO"] = "Missouri"
    m["MT"] = "Montana"
    m["NE"] = "Nebraska"
    m["NV"] = "Nevada"
    m["NH"] = "New Hampshire"
    m["NJ"] = "New Jersey"
    m["NM"] = "New Mexico"
    m["NY"] = "New York"
    m["NC"] = "North Carolina"
    m["ND"] = "North Dakota"
    m["OH"] = "Ohio"
    m["OK"] = "Oklahoma"
    m["OR"] = "Oregon"
    m["PA"] = "Pennsylvania"
    m["RI"] = "Rhode Island"
    m["SC"] = "South Carolina"
    m["SD"] = "South Dakota"
    m["TN"] = "Tennessee"
    m["TX"] = "Texas"
    m["UT"] = "Utah"
    m["VT"] = "Vermont"
    m["VA"] = "Virginia"
    m["WA"] = "Washington"
    m["WV"] = "West Virginia"
    m["WI"] = "Wisconsin"
    m["WY"] = "Wyoming"
    m["DC"] = "District of Columbia"
    m

// True if the uppercased 2-letter code is a valid US state / DC code.
fn state_valid(code: string) -> bool
    let m = _state_names()
    contains(m, upper(trim(code)))

// The full state name for a code ("CA" -> "California"), or "" if unknown.
fn state_name(code: string) -> string
    let m = _state_names()
    let k = upper(trim(code))
    if contains(m, k)
        return m[k]
    ""

// The 2-letter code for a full state name ("California" -> "CA"), case-insensitive, or "".
fn state_code(name: string) -> string
    let m = _state_names()
    let target = lower(trim(name))
    for k in keys(m)
        if lower(m[k]) == target
            return k
    ""

// The number of entries (51: 50 states + DC).
fn state_count() -> int
    len(keys(_state_names()))
