// forge_auth -- authentication/authorization for Forge (Sprint S4). RBAC: the authenticated user's
// roles travel on the request (an upstream auth middleware sets req["roles"]); a route gates on a
// required role via the require_role middleware. Beats Spring Security's ceremony with plain functions.
// Sprint S5 additions: password hashing (PBKDF2-HMAC-SHA256, Django-style), mw_auth (resolver-driven
// authn middleware that sets req.state["user"]), requires(role) guard, and user_create/user_by_username
// DB helpers backed by forge_db. Production-grade: CSPRNG salt, 100k iterations, constant-time verify.
import forge
import forge_crypto
import forge_db
//
// RAISED 2026-08-05. Eight problems:
//
//   1. has_any_role used a for-index loop. for-in.
//   2. _bytes_to_blist returned through a dead binding. Inlined.
//   3. password_hash_with_iters used 4-part string concat. Interpolation.
//   4. _lockout_loop used `running == 1` flag. `loop` + `break`.
//   5. lockout_tracker / lockout_check / lockout_record_failure / lockout_record_success /
//      lockout_tracker_stop built env dicts as individual assignments. Dict literals.
//   6. `locked == 1` / `window_expired == 1` / `password_verify(...) == false` -- `not` / direct bool.
//   7. `fails[user] = fails[user] + 1` -- compound `+=`.
//   8. _oauth2_aud_ok / _oauth2_scope_ok used for-index loops. for-in.

// CSPRNG: OS entropy for the password salt. Same extern used by forge_pg / forge_tls.
extern fn nova_rt_os_random(n: int) -> bytes

// ── RBAC role checks (pure) ───────────────────────────────────────────────────────────────────────
fn has_role(roles, required: string) -> bool
    contains(roles, required)

fn has_any_role(roles, required_list) -> bool
    for r in required_list
        if r in roles
            return true
    false

// The roles of the authenticated user ([] if unauthenticated or no roles claim). Reads the JWT claims
// that mw_require_auth(secret) places at req.state["user"] -> the real authn->authz chain:
//   use(app, mw_require_auth(secret))   // authn: verify token, set req.state["user"] = claims
//   get(app, "/admin", h) ... wrapped in require_role("admin")   // authz: gate on the claims' roles
fn _req_roles(req: Request)
    let st = req.state
    if "user" in st
        let u = st["user"]
        if "roles" in u
            return u["roles"]
    []

// ── require_role middleware ───────────────────────────────────────────────────────────────────────
fn _require_role_next(req, next, role)
    if has_role(_req_roles(req), role)
        return next(req)
    resp_error(403, "forbidden: requires role {role}")

fn require_role(role: string)
    return fn(req, next) _require_role_next(req, next, role)

fn _require_any_role_next(req, next, roles_needed)
    if has_any_role(_req_roles(req), roles_needed)
        return next(req)
    resp_error(403, "forbidden: requires one of the listed roles")

fn require_any_role(roles_needed)
    return fn(req, next) _require_any_role_next(req, next, roles_needed)

// ── Password hashing (PBKDF2-HMAC-SHA256, Django-style) ──────────────────────────────────────────────
fn _bytes_to_blist(b: bytes) -> list
    [bytes_get(b, i) for i in 0..bytes_len(b)]

fn password_hash_with_iters(password: string, iterations: int) -> string
    let salt_bytes = _bytes_to_blist(unsafe nova_rt_os_random(16))
    let pw_blist = str_to_blist(password)
    let dk = pbkdf2_sha256_native(pw_blist, salt_bytes, iterations, 32)
    let salt_b64 = b64_encode_blist(salt_bytes)
    let dk_b64 = b64_encode_blist(dk)
    "pbkdf2_sha256${iterations}${salt_b64}${dk_b64}"

fn password_hash(password: string) -> string
    password_hash_with_iters(password, 100000)

fn _parse_pbkdf2_stored(stored: string) -> list
    let parts = split(stored, "$")
    if len(parts) != 4
        return []
    if parts[0] != "pbkdf2_sha256"
        return []
    parts

fn password_verify(password: string, stored: string) -> bool
    let parts = _parse_pbkdf2_stored(stored)
    if len(parts) != 4
        return false
    let iters_str = parts[1]
    let iters = parse_int(iters_str)
    if iters <= 0
        return false
    let salt_blist = b64_decode_blist(parts[2])
    if len(salt_blist) == 0
        return false
    let stored_dk_blist = b64_decode_blist(parts[3])
    if len(stored_dk_blist) == 0
        return false
    let pw_blist = str_to_blist(password)
    let derived = pbkdf2_sha256_native(pw_blist, salt_blist, iters, 32)
    ct_eq(hex_of(derived), hex_of(stored_dk_blist))

fn password_needs_rehash(stored: string, target_iters: int) -> bool
    let parts = _parse_pbkdf2_stored(stored)
    if len(parts) != 4
        return true
    let iters = parse_int(parts[1])
    if iters <= 0
        return true
    iters < target_iters

// ── Account lockout: brute-force / credential-stuffing defense ──────────────────────────────────────
fn _lockout_loop(lo)
    let fails = {}
    let starts = {}
    let max_failures = lo["max_failures"]
    let window_ms = lo["window_ms"]
    loop
        let env = receive(lo["req"])
        let op = env["op"]
        if op == "stop"
            break
        else if op == "check"
            let user = env["user"]
            let locked = user in fails and fails[user] >= max_failures and env["now_ms"] - starts[user] <= window_ms
            send(env["reply"], 0 if locked else 1)
        else if op == "fail"
            let user = env["user"]
            let now_ms = env["now_ms"]
            if user not in starts or now_ms - starts[user] > window_ms
                fails[user] = 1
                starts[user] = now_ms
            else
                fails[user] += 1
        else if op == "success"
            let user = env["user"]
            fails.del(user)
            starts.del(user)

fn lockout_tracker(max_failures: int = 5, window_ms: int = 900000) -> any
    let lo = {"req": channel(), "max_failures": max_failures, "window_ms": window_ms}
    spawn _lockout_loop(lo)
    lo

fn lockout_tracker_default() -> any
    lockout_tracker(5, 900000)

fn lockout_check(lo, username: string, now_ms: int) -> int
    let rc = channel()
    send(lo["req"], {"op": "check", "user": username, "now_ms": now_ms, "reply": rc})
    receive(rc)

fn lockout_record_failure(lo, username: string, now_ms: int)
    send(lo["req"], {"op": "fail", "user": username, "now_ms": now_ms})

fn lockout_record_success(lo, username: string)
    send(lo["req"], {"op": "success", "user": username})

fn lockout_tracker_stop(lo)
    send(lo["req"], {"op": "stop", "reply": 0})

fn login_verify(lo, username: string, password: string, stored_hash: string, now_ms: int) -> Result
    if lockout_check(lo, username, now_ms) == 0
        return err("account temporarily locked")
    if not password_verify(password, stored_hash)
        lockout_record_failure(lo, username, now_ms)
        return err("invalid credentials")
    lockout_record_success(lo, username)
    ok(username)

// ── mw_auth: resolver-driven authentication middleware ───────────────────────────────────────────────
fn _mw_auth_next(req: Request, next, resolver) -> Response
    let r = resolver(req)
    if is_ok(r)
        req.state["user"] = unwrap(r)
    else
        req.state["auth_error"] = unwrap_err(r)
    next(req)

fn mw_auth(resolver)
    return fn(req, next) _mw_auth_next(req, next, resolver)

// ── requires(role): per-route authorization guard ────────────────────────────────────────────────────
fn _requires_next(req: Request, next, role: string) -> Response
    let st = req.state
    if "user" not in st
        return resp_error(401, "unauthorized")
    if not has_role(_req_roles(req), role)
        return resp_error(403, "forbidden: requires role {role}")
    next(req)

fn requires(role: string)
    return fn(req, next) _requires_next(req, next, role)

// ── mw_oauth2: Bearer resource-server validation (T3.7) ─────────────────────────────────────────────
fn _oauth2_aud_ok(claims, audience: string) -> bool
    if "aud" not in claims
        return false
    let aud = claims["aud"]
    if type_name(aud) == "string"
        return aud == audience
    if type_name(aud) == "list"
        for item in aud
            if item == audience
                return true
    false

fn _oauth2_scope_ok(claims, required_scope: string) -> bool
    if len(required_scope) == 0
        return true
    if "scope" not in claims
        return false
    let sc = claims["scope"]
    if type_name(sc) == "list"
        for item in sc
            if item == required_scope
                return true
        return false
    if type_name(sc) == "string"
        let parts = split(sc, " ")
        for p in parts
            if p == required_scope
                return true
    false

fn _t_oauth2(req: Request, next, secret: string, audience: string, required_scope: string) -> Response
    let tok = bearer_token(req)
    if len(tok) == 0
        return resp_error(401, "unauthorized")
    let r = jwt_verify(tok, secret)
    if is_err(r)
        return resp_error(401, "unauthorized")
    let claims = unwrap(r)
    if not _oauth2_aud_ok(claims, audience)
        return resp_error(403, "forbidden: audience mismatch")
    if not _oauth2_scope_ok(claims, required_scope)
        return resp_error(403, "forbidden: missing required scope")
    req.state["user"] = claims
    next(req)

fn mw_oauth2(secret: string, audience: string, required_scope: string)
    return fn(req, next) _t_oauth2(req, next, secret, audience, required_scope)

// ── WebSocket join authorizers (batteries for forge.ws_guard) ────────────────────────────────────────
fn _ws_bearer_ok(req: Request, secret: string, audience: string, required_scope: string) -> bool
    let tok = bearer_token(req)
    if len(tok) == 0
        tok = req_query(req, "access_token")
    if len(tok) == 0
        return false
    let r = jwt_verify(tok, secret)
    if is_err(r)
        return false
    let claims = unwrap(r)
    if len(audience) > 0 and not _oauth2_aud_ok(claims, audience)
        return false
    if len(required_scope) > 0 and not _oauth2_scope_ok(claims, required_scope)
        return false
    true

fn ws_require_bearer(secret: string, audience: string, required_scope: string)
    return fn(req) _ws_bearer_ok(req, secret, audience, required_scope)

fn _ws_session_ok(req: Request, secret: string) -> bool
    len(session_get(req, secret)) > 0

fn ws_require_session(secret: string)
    return fn(req) _ws_session_ok(req, secret)

// ── User persistence (forge_db-backed) ───────────────────────────────────────────────────────────────
fn users_ddl() -> string
    "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, role TEXT NOT NULL)"

fn user_create(pool, username: string, password: string, role: string) -> int
    let ph = password_hash(password)
    pool_insert(pool, "INSERT INTO users (username, password_hash, role) VALUES (?, ?, ?)", [username, ph, role])

fn user_by_username(pool, username: string) -> any
    let cols = ["id", "username", "password_hash", "role"]
    let rows = pool_query_dicts(pool, "SELECT id, username, password_hash, role FROM users WHERE username = ?", [username], cols)
    if len(rows) == 0
        return {}
    rows[0]
