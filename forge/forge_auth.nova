// forge_auth -- authentication/authorization for Forge (Sprint S4). RBAC: the authenticated user's
// roles travel on the request (an upstream auth middleware sets req["roles"]); a route gates on a
// required role via the require_role middleware. Beats Spring Security's ceremony with plain functions.
import forge

// ── RBAC role checks (pure) ───────────────────────────────────────────────────────────────────────
fn has_role(roles, required: string) -> bool
    contains(roles, required)

fn has_any_role(roles, required_list) -> bool
    let i = 0
    while i < len(required_list)
        if contains(roles, required_list[i])
            return true
        i = i + 1
    false

// The roles attached to a request ([] if none / not authenticated).
fn _req_roles(req)
    if contains(req, "roles")
        return req["roles"]
    []

// ── require_role middleware ───────────────────────────────────────────────────────────────────────
// Allow the request only if the user has `role`, else 403. Compose with use(app, require_role("admin")).
// (Pattern: a top-level helper holds the logic; the middleware returns a single-line closure calling it.)
fn _require_role_next(req, next, role)
    if has_role(_req_roles(req), role)
        return next(req)
    resp_error(403, "forbidden: requires role " + role)

fn require_role(role: string)
    return fn(req, next) _require_role_next(req, next, role)

// Allow if the user has ANY of the listed roles, else 403.
fn _require_any_role_next(req, next, roles_needed)
    if has_any_role(_req_roles(req), roles_needed)
        return next(req)
    resp_error(403, "forbidden: requires one of the listed roles")

fn require_any_role(roles_needed)
    return fn(req, next) _require_any_role_next(req, next, roles_needed)
