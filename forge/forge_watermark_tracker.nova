// forge_watermark_tracker — high/low watermark tracking with Result API.

fn wt_new() -> dict
    {"metrics": {}, "highs": {}, "lows": {}, "count": 0}

fn wt_record(w: dict, name: string, value: int) -> dict
    let mk = "m_" + name
    let hk = "h_" + name
    let lk = "l_" + name
    if mk not in w["metrics"]
        w["metrics"][mk] = value
        w["highs"][hk] = value
        w["lows"][lk] = value
        w["count"] += 1
    else
        w["metrics"][mk] = value
        if value > w["highs"][hk]
            w["highs"][hk] = value
        if value < w["lows"][lk]
            w["lows"][lk] = value
    w

fn wt_current(w: dict, name: string) -> Result
    let mk = "m_" + name
    if mk not in w["metrics"]
        return err("metric not found")
    ok(w["metrics"][mk])

fn wt_high(w: dict, name: string) -> Result
    let hk = "h_" + name
    if hk not in w["highs"]
        return err("metric not found")
    ok(w["highs"][hk])

fn wt_low(w: dict, name: string) -> Result
    let lk = "l_" + name
    if lk not in w["lows"]
        return err("metric not found")
    ok(w["lows"][lk])

fn wt_range(w: dict, name: string) -> Result
    let hk = "h_" + name
    let lk = "l_" + name
    if hk not in w["highs"]
        return err("metric not found")
    ok(w["highs"][hk] - w["lows"][lk])

fn wt_metric_count(w: dict) -> int
    w["count"]
