// forge_topk -- thin wrapper over std/sketch/topk (canonical implementation).
import std/sketch/topk

fn topk_new(k: int) -> list
    return tk_new(k)

fn topk_add(t: list, score: int, item)
    return tk_add(t, score, item)

fn topk_size(t: list) -> int
    len(t[1])

// The retained [score, item] pairs, highest score first. O(k).

fn topk_entries(t: list) -> list
    let e = t[1]
    [[e[i][0], e[i][1]] for i in 0..len(e)]

// Just the items, highest score first. O(k).

fn topk_items(t: list) -> list
    return tk_items(t)

fn topk_scores(t: list) -> list
    let e = t[1]
    let out = [e[i][0] for i in 0..len(e)]
    out

// The current cut-off: the smallest retained score (what a new item must beat once the tracker is full),
// or null if empty.

fn topk_threshold(t: list)
    let e = t[1]
    let out = null
    if len(e) > 0
        out = e[len(e) - 1][0]
    out

