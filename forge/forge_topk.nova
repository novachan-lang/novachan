// forge_topk -- keep the top K items by score from a STREAM, in bounded memory, without sorting everything.
// Feed it (item, score) pairs one at a time and it retains only the K highest-scored ever seen -- the exact
// tool for "top 10 trending posts", live leaderboards, "most expensive N orders", best-N search hits, or the
// heavy-hitters shortlist you keep alongside a Count-Min sketch. Unlike sorting the whole dataset (O(n log n)
// and O(n) memory), this holds at most K entries and each update is O(K); an item that can't crack the current
// K-th best is dropped instantly. Entries are kept sorted best-first, so reading the ranking is free. Scores
// are INTEGERS (counts, points, timestamps, cents). LEAF -- imports NOTHING.

// A new top-k tracker holding at most k entries. Representation: [k, entries] where entries is a list of
// [score, item] pairs kept sorted by score DESCENDING.
fn topk_new(k: int) -> list
    [k, []]

// Observe (item, score). Keeps the tracker to its top-k highest scores. O(k). Ties keep the earlier item.
fn topk_add(t: list, score: int, item)
    let k = t[0]
    let e = t[1]
    let n = len(e)
    let admit = true
    if n >= k and n > 0 and score <= e[n - 1][0]
        admit = false
    if k <= 0
        admit = false
    if admit
        // insertion point in a descending list: first index whose score is strictly less than `score`
        let p = 0
        while p < len(e) and e[p][0] >= score
            p = p + 1
        insert(e, p, [score, item])
        while len(e) > k
            pop(e)

// The current number of retained entries (<= k).
fn topk_size(t: list) -> int
    len(t[1])

// The retained [score, item] pairs, highest score first. O(k).
fn topk_entries(t: list) -> list
    let e = t[1]
    let out = []
    let i = 0
    while i < len(e)
        push(out, [e[i][0], e[i][1]])
        i = i + 1
    out

// Just the items, highest score first. O(k).
fn topk_items(t: list) -> list
    let e = t[1]
    let out = []
    let i = 0
    while i < len(e)
        push(out, e[i][1])
        i = i + 1
    out

// Just the scores, descending. O(k).
fn topk_scores(t: list) -> list
    let e = t[1]
    let out = []
    let i = 0
    while i < len(e)
        push(out, e[i][0])
        i = i + 1
    out

// The current cut-off: the smallest retained score (what a new item must beat once the tracker is full),
// or null if empty.
fn topk_threshold(t: list)
    let e = t[1]
    let out = null
    if len(e) > 0
        out = e[len(e) - 1][0]
    out
