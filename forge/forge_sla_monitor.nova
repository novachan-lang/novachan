// forge_sla_monitor — SLA monitoring and uptime tracking.
// Track availability, latency targets, violations.

fn sla_new(name: string, target_pct: int) -> dict
    let s = {}
    s["name"] = name
    s["target_pct"] = target_pct
    s["total_checks"] = 0
    s["up_checks"] = 0
    s["violations"] = []
    s["latency_target_ms"] = 0
    s["latency_samples"] = []
    s

fn sla_record_up(sla: dict) -> dict
    sla["total_checks"] = sla["total_checks"] + 1
    sla["up_checks"] = sla["up_checks"] + 1
    sla

fn sla_record_down(sla: dict, reason: string) -> dict
    sla["total_checks"] = sla["total_checks"] + 1
    let v = {}
    v["reason"] = reason
    v["check_number"] = sla["total_checks"]
    push(sla["violations"], v)
    sla

fn sla_uptime_pct(sla: dict) -> int
    if sla["total_checks"] == 0
        return 100
    (sla["up_checks"] * 100) / sla["total_checks"]

fn sla_is_met(sla: dict) -> bool
    let pct = sla_uptime_pct(sla)
    if pct >= sla["target_pct"]
        return true
    false

fn sla_violation_count(sla: dict) -> int
    len(sla["violations"])

fn sla_set_latency_target(sla: dict, target_ms: int) -> dict
    sla["latency_target_ms"] = target_ms
    sla

fn sla_record_latency(sla: dict, ms: int) -> dict
    push(sla["latency_samples"], ms)
    sla

fn sla_avg_latency(sla: dict) -> int
    let n = len(sla["latency_samples"])
    if n == 0
        return 0
    let total = 0
    let i = 0
    while i < n
        total = total + sla["latency_samples"][i]
        i = i + 1
    total / n

fn sla_p99_latency(sla: dict) -> int
    let n = len(sla["latency_samples"])
    if n == 0
        return 0
    let sorted = []
    let i = 0
    while i < n
        push(sorted, sla["latency_samples"][i])
        i = i + 1
    let s = 0
    while s < len(sorted)
        let j = s + 1
        while j < len(sorted)
            if sorted[j] < sorted[s]
                let tmp = sorted[s]
                sorted[s] = sorted[j]
                sorted[j] = tmp
            j = j + 1
        s = s + 1
    let idx = (n * 99) / 100
    if idx >= n
        idx = n - 1
    sorted[idx]

fn sla_summary(sla: dict) -> dict
    let s = {}
    s["name"] = sla["name"]
    s["uptime_pct"] = sla_uptime_pct(sla)
    s["target_pct"] = sla["target_pct"]
    s["met"] = sla_is_met(sla)
    s["violations"] = sla_violation_count(sla)
    s["avg_latency"] = sla_avg_latency(sla)
    s
