// forge_sla_monitor — SLA monitoring and uptime tracking.
// Track availability, latency targets, violations.

fn sla_new(name: string, target_pct: int) -> dict
    let s = {}
    s["name"] = name
    s["target_pct"] = target_pct
    s["total_checks"] = 0
    s["up_checks"] = 0
    s["violations"] = []
    s["latency_target_ms"] = 0
    s["latency_samples"] = []
    s

fn sla_record_up(sla: dict) -> dict
    sla["total_checks"] = sla["total_checks"] + 1
    sla["up_checks"] = sla["up_checks"] + 1
    sla

fn sla_record_down(sla: dict, reason: string) -> dict
    sla["total_checks"] = sla["total_checks"] + 1
    let v = {}
    v["reason"] = reason
    v["check_number"] = sla["total_checks"]
    push(sla["violations"], v)
    sla

fn sla_uptime_pct(sla: dict) -> int
    if sla["total_checks"] == 0
        return 100
    (sla["up_checks"] * 100) / sla["total_checks"]

fn sla_is_met(sla: dict) -> bool
    let pct = sla_uptime_pct(sla)
    if pct >= sla["target_pct"]
        return true
    false

fn sla_violation_count(sla: dict) -> int
    len(sla["violations"])

fn sla_set_latency_target(sla: dict, target_ms: int) -> dict
    sla["latency_target_ms"] = target_ms
    sla

fn sla_record_latency(sla: dict, ms: int) -> dict
    push(sla["latency_samples"], ms)
    sla

fn sla_avg_latency(sla: dict) -> int
    let n = len(sla["latency_samples"])
    if n == 0
        return 0
    let total = 0
    let i = 0
    while i < n
        total = total + sla["latency_samples"][i]
        i = i + 1
    total / n

fn sla_p99_latency(sla: dict) -> int
    let n = len(sla["latency_samples"])
    if n == 0
        return 0
    let sorted = []
    let i = 0
    while i < n
        push(sorted, sla["latency_samples"][i])
        i = i + 1
    let s = 0
    while s < len(sorted)
        let j = s + 1
        while j < len(sorted)
            if sorted[j] < sorted[s]
                let tmp = sorted[s]
                sorted[s] = sorted[j]
                sorted[j] = tmp
            j = j + 1
        s = s + 1
    let idx = (n * 99) / 100
    if idx >= n
        idx = n - 1
    sorted[idx]

fn sla_summary(sla: dict) -> dict
    let s = {}
    s["name"] = sla["name"]
    s["uptime_pct"] = sla_uptime_pct(sla)
    s["target_pct"] = sla["target_pct"]
    s["met"] = sla_is_met(sla)
    s["violations"] = sla_violation_count(sla)
    s["avg_latency"] = sla_avg_latency(sla)
    s

// --- Multi-service SLA monitor (sm_ API) --------------------------------
// A second, independent state shape sharing this file: one monitor tracks
// SLA targets and pass/fail history for MANY named services at once
// (vs. the single-service `sla_` API above, which tracks one service's
// latency distribution in depth). No shared state between the two APIs.
//
// STATE SHAPE (flat dict, no nesting):
//   state["target_"+service]  — int, SLA target percentage for `service`.
//   state["succ_"+service]    — int, successful records for `service`.
//   state["total_"+service]   — int, total records for `service`.
//   state["services"]         — string, comma-separated registered service names.
//   state["service_count"]    — int, number of distinct services registered.
//   state["total_records"]    — int, total records across all services.

// sm_new() -> dict
// Create an empty multi-service SLA monitor.
fn sm_new() -> dict
    let s = {}
    s["service_count"] = 0
    s["total_records"] = 0
    s["services"] = ""
    s

// sm_add_sla(state, service, target_pct) -> dict
// Register (or update) an SLA target (0-100) for `service`.
fn sm_add_sla(state: dict, service: string, target_pct: int) -> dict
    let tk = "target_" + service
    if contains(state, tk) != true
        state["service_count"] = state["service_count"] + 1
        state["succ_" + service] = 0
        state["total_" + service] = 0
        if state["services"] == ""
            state["services"] = service
        else
            state["services"] = state["services"] + "," + service
    state[tk] = target_pct
    state

// sm_record(state, service, success) -> Result
// Record a result (1=success, 0=failure) for `service`. ok(state), or
// err if `service` was never registered via sm_add_sla.
fn sm_record(state: dict, service: string, success: int) -> Result
    let tk = "target_" + service
    if contains(state, tk) != true
        return err("unknown service: " + service)
    state["total_" + service] = state["total_" + service] + 1
    if success == 1
        state["succ_" + service] = state["succ_" + service] + 1
    state["total_records"] = state["total_records"] + 1
    ok(state)

// sm_uptime(state, service) -> Result
// ok(current uptime percentage for `service`; 100 if no records yet), or
// err if unregistered.
fn sm_uptime(state: dict, service: string) -> Result
    let tk = "target_" + service
    if contains(state, tk) != true
        return err("unknown service: " + service)
    let total = state["total_" + service]
    if total == 0
        return ok(100)
    ok(state["succ_" + service] * 100 / total)

// sm_is_breached(state, service) -> Result
// ok(1) if current uptime is below the registered target, ok(0)
// otherwise, or err if unregistered.
fn sm_is_breached(state: dict, service: string) -> Result
    let tk = "target_" + service
    if contains(state, tk) != true
        return err("unknown service: " + service)
    let up = unwrap(sm_uptime(state, service))
    if up < state[tk]
        return ok(1)
    ok(0)

// sm_breached_count(state) -> int
// Number of registered services currently below their SLA target.
fn sm_breached_count(state: dict) -> int
    if state["service_count"] == 0
        return 0
    let names = split(state["services"], ",")
    let n = len(names)
    let count = 0
    let i = 0
    while i < n
        let name = names[i]
        let up = unwrap(sm_uptime(state, name))
        if up < state["target_" + name]
            count = count + 1
        i = i + 1
    count

// sm_service_count(state) -> int
fn sm_service_count(state: dict) -> int
    state["service_count"]

// sm_total_records(state) -> int
fn sm_total_records(state: dict) -> int
    state["total_records"]

// sm_worst_service(state) -> Result
// ok(service name with the lowest current uptime; ties keep the first
// registered), or err if no services are registered.
fn sm_worst_service(state: dict) -> Result
    if state["service_count"] == 0
        return err("no services registered")
    let names = split(state["services"], ",")
    let n = len(names)
    let worst_name = names[0]
    let worst_up = unwrap(sm_uptime(state, names[0]))
    let i = 1
    while i < n
        let name = names[i]
        let up = unwrap(sm_uptime(state, name))
        if up < worst_up
            worst_up = up
            worst_name = name
        i = i + 1
    ok(worst_name)
