// forge_sla_tracker — Track SLA compliance per service.

fn sla_new() -> dict
    let s = {}
    s["targets"] = {}
    s["success"] = {}
    s["total"] = {}
    s["svc_count"] = 0
    s

fn sla_set_target(s: dict, service: string, target_pct: int) -> dict
    s["targets"][service] = target_pct
    s["success"][service] = 0
    s["total"][service] = 0
    s["svc_count"] = s["svc_count"] + 1
    s

fn sla_record(s: dict, service: string, success: int) -> dict
    s["total"][service] = s["total"][service] + 1
    if success == 1
        s["success"][service] = s["success"][service] + 1
    s

fn sla_pct(s: dict, service: string) -> int
    let t = s["total"][service]
    if t == 0
        return 100
    s["success"][service] * 100 / t

fn sla_is_met(s: dict, service: string) -> int
    let pct = sla_pct(s, service)
    let has = contains(s["targets"], service)
    if has != true
        return 1
    if pct >= s["targets"][service]
        return 1
    0

fn sla_worst_service(s: dict) -> string
    let ks = keys(s["targets"])
    let worst = ""
    let worst_pct = 101
    let i = 0
    while i < len(ks)
        let svc = ks[i]
        let pct = sla_pct(s, svc)
        if pct < worst_pct
            worst_pct = pct
            worst = svc
        i = i + 1
    worst

fn sla_service_count(s: dict) -> int
    s["svc_count"]

fn sla_violations(s: dict) -> int
    let ks = keys(s["targets"])
    let count = 0
    let i = 0
    while i < len(ks)
        let met = sla_is_met(s, ks[i])
        if met == 0
            count = count + 1
        i = i + 1
    count
