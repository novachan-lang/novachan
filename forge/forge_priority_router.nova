// forge_priority_router — priority-based request routing with Result API.

fn pr_new() -> dict
    let p = {}
    p["route_count"] = 0
    p["total_routed"] = 0
    p["misses"] = 0
    p

fn pr_add_route(p: dict, pattern: string, handler: string, priority: int) -> dict
    let idx = p["route_count"]
    p["r_" + str(idx) + "_pat"] = pattern
    p["r_" + str(idx) + "_handler"] = handler
    p["r_" + str(idx) + "_pri"] = priority
    p["route_count"] = idx + 1
    p

fn pr_route(p: dict, path: string) -> Result
    let best_idx = -1
    let best_pri = -1
    let i = 0
    while i < p["route_count"]
        let pat = p["r_" + str(i) + "_pat"]
        if pat == path
            let pri = p["r_" + str(i) + "_pri"]
            if pri > best_pri
                best_pri = pri
                best_idx = i
        i = i + 1
    if best_idx == -1
        p["misses"] = p["misses"] + 1
        return err("no route for: " + path)
    p["total_routed"] = p["total_routed"] + 1
    ok(p["r_" + str(best_idx) + "_handler"])

fn pr_handler_at(p: dict, index: int) -> Result
    if index < 0 or index >= p["route_count"]
        return err("route index out of range")
    ok(p["r_" + str(index) + "_handler"])

fn pr_priority_at(p: dict, index: int) -> Result
    if index < 0 or index >= p["route_count"]
        return err("route index out of range")
    ok(p["r_" + str(index) + "_pri"])

fn pr_route_count(p: dict) -> int
    p["route_count"]

fn pr_total_routed(p: dict) -> int
    p["total_routed"]

fn pr_miss_count(p: dict) -> int
    p["misses"]
