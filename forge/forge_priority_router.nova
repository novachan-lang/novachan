// forge_priority_router — priority-based request routing with Result API.

fn pr_new() -> dict
    {"route_count": 0, "total_routed": 0, "misses": 0}

fn pr_add_route(p: dict, pattern: string, handler: string, priority: int) -> dict
    let idx = p["route_count"]
    let ik = str(idx)
    p["r_{ik}_pat"] = pattern
    p["r_{ik}_handler"] = handler
    p["r_{ik}_pri"] = priority
    p["route_count"] += 1
    p

fn pr_route(p: dict, path: string) -> Result
    let best_idx = -1
    let best_pri = -1
    for i in 0..p["route_count"]
        let ik = str(i)
        let pat = p["r_{ik}_pat"]
        if pat == path
            let pri = p["r_{ik}_pri"]
            if pri > best_pri
                best_pri = pri
                best_idx = i
    if best_idx == -1
        p["misses"] += 1
        return err("no route for: {path}")
    p["total_routed"] += 1
    let bk = str(best_idx)
    ok(p["r_{bk}_handler"])

fn pr_handler_at(p: dict, index: int) -> Result
    if index < 0 or index >= p["route_count"]
        return err("route index out of range")
    let ik = str(index)
    ok(p["r_{ik}_handler"])

fn pr_priority_at(p: dict, index: int) -> Result
    if index < 0 or index >= p["route_count"]
        return err("route index out of range")
    let ik = str(index)
    ok(p["r_{ik}_pri"])

fn pr_route_count(p: dict) -> int
    p["route_count"]

fn pr_total_routed(p: dict) -> int
    p["total_routed"]

fn pr_miss_count(p: dict) -> int
    p["misses"]
