// forge_shlex -- split a command line into arguments the way a POSIX shell does, honoring single quotes, double
// quotes, and backslash escapes. Naive whitespace splitting breaks the moment an argument contains a space --
// `rm 'My Documents'` must be ONE argument, not two. This is the tokenizer you need to build a REPL or interactive
// prompt, parse a stored command string, read config that embeds shell-style commands, or safely interpret user-
// entered argument lists. The rules mirror Python's shlex / the shell word-splitting stage: whitespace separates
// tokens; single quotes take everything literally; double quotes group text but let backslash escape " and \;
// a bare backslash escapes the next character; and adjacent quoted and unquoted pieces fuse into one token
// (foo"bar" -> foobar). Unterminated quotes are treated leniently (the rest becomes one token). LEAF.

// PRIVATE: is c ASCII whitespace (space, tab, newline, carriage return)?
fn _sx_ws(c: string) -> bool
    let o = ord(c)
    if o == 32 or o == 9 or o == 10 or o == 13
        return true
    false

// Split a command-line string into a list of argument tokens (shell word-splitting with quotes and escapes).
fn shlex_split(s: string) -> list
    let dq = chr(34)
    let sq = chr(39)
    let bs = chr(92)
    let tokens = []
    let cur = ""
    let in_token = false
    let state = 0
    let n = len(s)
    let i = 0
    while i < n
        let c = char_at(s, i)
        if state == 0
            if _sx_ws(c)
                if in_token
                    push(tokens, cur)
                    cur = ""
                    in_token = false
            else
                if c == sq
                    state = 1
                    in_token = true
                else
                    if c == dq
                        state = 2
                        in_token = true
                    else
                        if c == bs
                            i += 1
                            if i < n
                                cur += char_at(s, i)
                            in_token = true
                        else
                            cur += c
                            in_token = true
        else
            if state == 1
                // single quote: everything literal until the closing quote
                if c == sq
                    state = 0
                else
                    cur += c
            else
                // double quote: literal, but backslash escapes " and \
                if c == dq
                    state = 0
                else
                    if c == bs
                        i += 1
                        if i < n
                            let nc = char_at(s, i)
                            if nc == dq or nc == bs
                                cur += nc
                            else
                                cur += bs + nc
                    else
                        cur += c
        i += 1
    if in_token
        push(tokens, cur)
    tokens

// The number of arguments shlex_split would produce (a quick arity check).
fn shlex_count(s: string) -> int
    len(shlex_split(s))
