// PROVE: pool_acquire_to + bare `send` (no cancel_on_exit_val) => DOUBLE RELEASE at task exit
import forge_db

fn borrow_wrong(pool) -> int
    let r = pool_acquire_to(pool, 1000)
    if is_err(r)
        return -1
    let c = unwrap(r)
    // exactly what forge_orm.orm_all / orm_exec do: bare send, no cancel
    send(pool, c)
    c

fn worker(pool, done)
    borrow_wrong(pool)
    send(done, 1)

fn main()
    let pool = channel()
    send(pool, 111)
    send(pool, 222)
    print("pool starts with 2 connections")
    let done = channel()
    spawn worker(pool, done)
    recv(done)
    // drain everything currently in the pool
    let got = []
    let i = 0
    while i < 8
        let r = select_timeout(pool, 200)
        if r[0] != 0
            i = 99
        else
            push(got, r[1])
            i += 1
    print("after ONE task borrowed+released once, pool contains:")
    print(got)
    print("count = {len(got)}  (expected 2)")
