// forge_roman -- thin wrapper over std/text/roman (canonical implementation).
import std/text/roman

fn _roman_canon(s: string) -> Result
    let n = roman_decode(s)?
    let enc = roman_encode(n)?
    ok(enc == upper(trim(s)))

fn roman_encode(n: int) -> Result
    return ok(rom_from_int(n))

fn roman_decode(s: string) -> Result
    return ok(rom_to_int(s))

fn to_roman(n: int) -> string
    return rom_from_int(n)

fn from_roman(s: string) -> int
    return rom_to_int(s)

fn roman_is_canonical(s: string) -> bool
    unwrap_or(_roman_canon(s), false)

