// forge_roman -- Roman numeral encode/decode (1994 <-> MCMXCIV). For copyright years, outline numbering, book
// volumes, and clock faces. Valid range 1..3999 (standard subtractive notation). LEAF -- imports NOTHING.

fn to_roman(n: int) -> string
    if n < 1 or n > 3999
        return ""
    let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    let out = ""
    let v = n
    let i = 0
    while i < len(vals)
        while v >= vals[i]
            out = out + syms[i]
            v = v - vals[i]
        i = i + 1
    out

fn _roman_val(c: string) -> int
    if c == "I"
        return 1
    if c == "V"
        return 5
    if c == "X"
        return 10
    if c == "L"
        return 50
    if c == "C"
        return 100
    if c == "D"
        return 500
    if c == "M"
        return 1000
    0

// Decode a Roman numeral to an int (0 if it contains an invalid character). Subtractive rule.
fn from_roman(s: string) -> int
    let r = upper(trim(s))
    let total = 0
    let i = 0
    let n = len(r)
    while i < n
        let cur = _roman_val(char_at(r, i))
        if cur == 0
            return 0
        if i + 1 < n and _roman_val(char_at(r, i + 1)) > cur
            total = total - cur
        else
            total = total + cur
        i = i + 1
    total
