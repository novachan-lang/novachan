// forge_url -- URL parsing + building (WHATWG URL / Java URI / Python urllib.parse shaped).
//
// LEAF module: imports NOTHING. Pure string surgery over NOVA builtins
// (find/slice/len/lower/parse_int/split/starts_with/str/char_at).
//
// Decomposes an absolute or relative URL into its components and reassembles one.
// The parse is a PROGRESSIVE PEEL: we keep `rest` and shave off fragment, then query,
// then scheme+authority, then split authority into userinfo/host/port -- left to right,
// so `find` (which returns the FIRST occurrence) is always looking at exactly the
// unconsumed remainder. This avoids the "find from index" gap: instead of tracking
// offsets, we reassign `rest` to the slice past what we already consumed.

// Parse an absolute or relative URL into a dict. ALL keys are always present:
//   scheme   -- lowercased, "" if none
//   host     -- "" if none
//   port     -- int, 0 if not specified
//   path     -- "" if none; but "/" if there is a host and no path
//   query    -- text after the first "?" (pre-fragment), WITHOUT the "?", "" if none
//   fragment -- text after the first "#", WITHOUT the "#", "" if none
//   userinfo -- the "user:pass" before "@" in the authority, "" if none
fn url_parse(url: string) -> dict
    let d = {}
    d["scheme"] = ""
    d["host"] = ""
    d["port"] = 0
    d["path"] = ""
    d["query"] = ""
    d["fragment"] = ""
    d["userinfo"] = ""

    let rest = url

    // 1. Fragment: everything after the FIRST "#".
    let hpos = find(rest, "#")
    if hpos >= 0
        d["fragment"] = slice(rest, hpos + 1, len(rest))
        rest = slice(rest, 0, hpos)

    // 2. Query: everything after the FIRST "?" in the remaining (pre-fragment) string.
    let qpos = find(rest, "?")
    if qpos >= 0
        d["query"] = slice(rest, qpos + 1, len(rest))
        rest = slice(rest, 0, qpos)

    // 3. Scheme + authority detection.
    //    "://" present  -> scheme = text before it (lowercased); rest = authority + path.
    //    starts with "//" -> protocol-relative (no scheme); rest (past "//") = authority + path.
    //    otherwise        -> no scheme/authority; the whole remainder is the path.
    let has_authority = false
    let sep = find(rest, "://")
    if sep >= 0
        d["scheme"] = lower(slice(rest, 0, sep))
        rest = slice(rest, sep + 3, len(rest))
        has_authority = true
    else if starts_with(rest, "//")
        rest = slice(rest, 2, len(rest))
        has_authority = true

    if has_authority
        // 4. Authority is up to the first "/" (or the whole thing if there's no "/").
        //    The path is from that "/" onward.
        let authority = rest
        let path = ""
        let slash = find(rest, "/")
        if slash >= 0
            authority = slice(rest, 0, slash)
            path = slice(rest, slash, len(rest))

        // 5. Split authority: "@" separates userinfo from host:port; ":" splits host/port.
        let hostport = authority
        let at = find(authority, "@")
        if at >= 0
            d["userinfo"] = slice(authority, 0, at)
            hostport = slice(authority, at + 1, len(authority))

        let host = hostport
        let colon = find(hostport, ":")
        if colon >= 0
            host = slice(hostport, 0, colon)
            let ptxt = slice(hostport, colon + 1, len(hostport))
            if ptxt != ""
                d["port"] = parse_int(ptxt)
        d["host"] = host

        // A host with no explicit path normalizes to "/".
        if path == ""
            path = "/"
        d["path"] = path
    else
        // No authority: the entire remainder is the path (may be "").
        d["path"] = rest

    d

// Reassemble a URL from the same keys `url_parse` produces. Missing keys are treated
// as empty / 0 via `contains` guards, so a partially-populated dict still builds.
fn url_build(parts: dict) -> string
    let out = ""

    let scheme = ""
    if "scheme" in parts
        scheme = parts["scheme"]
    if scheme != ""
        out += scheme + "://"

    let userinfo = ""
    if "userinfo" in parts
        userinfo = parts["userinfo"]
    if userinfo != ""
        out += userinfo + "@"

    let host = ""
    if "host" in parts
        host = parts["host"]
    out += host

    let port = 0
    if "port" in parts
        port = parts["port"]
    if port > 0
        out += ":" + str(port)

    let path = ""
    if "path" in parts
        path = parts["path"]
    out += path

    let query = ""
    if "query" in parts
        query = parts["query"]
    if query != ""
        out += "?" + query

    let fragment = ""
    if "fragment" in parts
        fragment = parts["fragment"]
    if fragment != ""
        out += "#" + fragment

    out

// Convenience: parse `url`, then look up `key` in its query string ("a=1&b=2" shape)
// and return its RAW (not percent-decoded) value, or "" if the key is absent.
// A bare key with no "=" (e.g. "flag&x=1") yields "" for that key.
fn url_query_get(url: string, key: string) -> string
    let parts = url_parse(url)
    let query = parts["query"]
    if query == ""
        return ""
    let pairs = split(query, "&")
    let result = ""
    let found = false
    for i in 0..len(pairs)
        if not found
            let pair = pairs[i]
            let eq = find(pair, "=")
            let k = pair
            let v = ""
            if eq >= 0
                k = slice(pair, 0, eq)
                v = slice(pair, eq + 1, len(pair))
            if k == key
                result = v
                found = true
    result
