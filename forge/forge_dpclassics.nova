// forge_dpclassics -- three canonical dynamic-programming problems whose SHAPES recur constantly in real code:
// matrix-chain ordering, rod cutting, and the egg-drop puzzle. Each shows a different DP pattern worth having
// ready-made. matrix_chain_order finds the cheapest way to PARENTHESIZE a chain of matrix multiplications
// (multiplication is associative, so (AB)C and A(BC) give the same result but wildly different costs) -- the same
// "best split point" DP behind optimal join ordering in databases and optimal expression evaluation. rod_cutting
// finds the most valuable way to cut a rod into pieces given a price for each length -- the archetypal
// unbounded-knapsack / "best way to partition a quantity" problem (cutting stock, making change for maximum value,
// ad-slot packing). egg_drop computes the minimum number of trials that GUARANTEES finding a critical threshold
// with a limited number of test items -- the classic worst-case/minimax search DP (A/B threshold finding, stress
// testing to a breaking point). All integer, exact. LEAF -- imports NOTHING.

// PRIVATE: large sentinel.
fn _dp_big() -> int
    1000000000

// The minimum number of scalar multiplications to multiply a chain of matrices, given `dims` where matrix i is
// dims[i] x dims[i+1] (so n = len(dims)-1 matrices). Chooses the optimal parenthesization.
fn matrix_chain_order(dims: list) -> int
    let n = len(dims) - 1
    let out = 0
    if n >= 1
        let dp = []
        for z in 0..(n * n)
            push(dp, 0)
        let lgt = 2
        while lgt <= n
            let i = 0
            while i <= n - lgt
                let j = i + lgt - 1
                let best = _dp_big()
                let k = i
                while k < j
                    let cost = dp[i * n + k] + dp[(k + 1) * n + j] + dims[i] * dims[k + 1] * dims[j + 1]
                    if cost < best
                        best = cost
                    k += 1
                dp[i * n + j] = best
                i += 1
            lgt += 1
        out = dp[n - 1]
    out

// The maximum revenue from cutting a rod of length n into pieces, where prices[k] is the price of a piece of length
// k+1. Unbounded (each length may be used any number of times).
fn rod_cutting(prices: list, n: int) -> int
    let dp = []
    let z = 0
    while z <= n
        push(dp, 0)
        z += 1
    let rl = 1
    while rl <= n
        let best = 0
        let cut = 1
        while cut <= rl and cut <= len(prices)
            let rev = prices[cut - 1] + dp[rl - cut]
            if rev > best
                best = rev
            cut += 1
        dp[rl] = best
        rl += 1
    dp[n]

// The minimum number of trials that GUARANTEES finding the critical floor (worst case) with `eggs` eggs and
// `floors` floors -- the egg-drop / minimax threshold-search DP.
fn egg_drop(eggs: int, floors: int) -> int
    let out = floors
    if floors > 1 and eggs > 1
        let w = floors + 1
        let dp = [0 for z in 0..((eggs + 1) * w)]
        // base cases: 1 egg -> f trials; 0/1 floors
        let f0 = 0
        while f0 <= floors
            dp[1 * w + f0] = f0
            f0 += 1
        let e0 = 1
        while e0 <= eggs
            dp[e0 * w + 1] = 1
            e0 += 1
        let e = 2
        while e <= eggs
            let f = 2
            while f <= floors
                let best = _dp_big()
                let x = 1
                while x <= f
                    let a = dp[(e - 1) * w + (x - 1)]
                    let b = dp[e * w + (f - x)]
                    let worst = a
                    if b > worst
                        worst = b
                    worst += 1
                    if worst < best
                        best = worst
                    x += 1
                dp[e * w + f] = best
                f += 1
            e += 1
        out = dp[eggs * w + floors]
    out
