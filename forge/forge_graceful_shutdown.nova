// forge_graceful_shutdown — Graceful shutdown orchestration.
// Register shutdown hooks, execute in order, timeout tracking.

fn gs_new() -> dict
    {"hooks": [], "status": "running", "completed": [], "failed": []}

fn gs_add_hook(gs: dict, name: string, priority: int) -> dict
    push(gs["hooks"], {"name": name, "priority": priority, "status": "pending"})
    gs

fn gs_initiate(gs: dict) -> dict
    gs["status"] = "shutting_down"
    gs

fn gs_complete_hook(gs: dict, name: string) -> dict
    for i in 0..len(gs["hooks"])
        if gs["hooks"][i]["name"] == name
            gs["hooks"][i]["status"] = "completed"
    push(gs["completed"], name)
    let all_done = 1
    for j in 0..len(gs["hooks"])
        if gs["hooks"][j]["status"] != "completed"
            if gs["hooks"][j]["status"] != "failed"
                all_done = 0
    if all_done == 1
        gs["status"] = "stopped"
    gs

fn gs_fail_hook(gs: dict, name: string, reason: string) -> dict
    for i in 0..len(gs["hooks"])
        if gs["hooks"][i]["name"] == name
            gs["hooks"][i]["status"] = "failed"
    push(gs["failed"], name)
    gs

fn gs_status(gs: dict) -> string
    gs["status"]

fn gs_hook_count(gs: dict) -> int
    len(gs["hooks"])

fn gs_completed_count(gs: dict) -> int
    len(gs["completed"])

fn gs_failed_count(gs: dict) -> int
    len(gs["failed"])

fn gs_pending_hooks(gs: dict) -> list
    [gs["hooks"][i]["name"] for i in 0..len(gs["hooks"]) if gs["hooks"][i]["status"] == "pending"]

fn gs_execution_order(gs: dict) -> list
    let sorted = [gs["hooks"][i] for i in 0..len(gs["hooks"])]
    for j in 0..len(sorted)
        for k in (j + 1)..len(sorted)
            if sorted[k]["priority"] < sorted[j]["priority"]
                let tmp = sorted[j]
                sorted[j] = sorted[k]
                sorted[k] = tmp
    [sorted[m]["name"] for m in 0..len(sorted)]
