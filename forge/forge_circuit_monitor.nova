// forge_circuit_monitor — Circuit breaker monitoring dashboard.
// Track multiple circuit breakers, their states, failure rates.

fn cm_new() -> dict
    let cm = {}
    cm["circuits"] = {}
    cm

fn cm_register(cm: dict, name: string, threshold: int) -> dict
    let c = {}
    c["state"] = "closed"
    c["failures"] = 0
    c["successes"] = 0
    c["threshold"] = threshold
    c["trips"] = 0
    cm["circuits"][name] = c
    cm

fn cm_record_success(cm: dict, name: string) -> dict
    let has = contains(cm["circuits"], name)
    if has != true
        return cm
    cm["circuits"][name]["successes"] = cm["circuits"][name]["successes"] + 1
    cm

fn cm_record_failure(cm: dict, name: string) -> dict
    let has = contains(cm["circuits"], name)
    if has != true
        return cm
    cm["circuits"][name]["failures"] = cm["circuits"][name]["failures"] + 1
    if cm["circuits"][name]["failures"] >= cm["circuits"][name]["threshold"]
        if cm["circuits"][name]["state"] == "closed"
            cm["circuits"][name]["state"] = "open"
            cm["circuits"][name]["trips"] = cm["circuits"][name]["trips"] + 1
    cm

fn cm_reset(cm: dict, name: string) -> dict
    let has = contains(cm["circuits"], name)
    if has != true
        return cm
    cm["circuits"][name]["state"] = "closed"
    cm["circuits"][name]["failures"] = 0
    cm

fn cm_half_open(cm: dict, name: string) -> dict
    let has = contains(cm["circuits"], name)
    if has != true
        return cm
    if cm["circuits"][name]["state"] == "open"
        cm["circuits"][name]["state"] = "half-open"
    cm

fn cm_state(cm: dict, name: string) -> string
    let has = contains(cm["circuits"], name)
    if has != true
        return ""
    cm["circuits"][name]["state"]

fn cm_failure_rate(cm: dict, name: string) -> int
    let has = contains(cm["circuits"], name)
    if has != true
        return 0
    let total = cm["circuits"][name]["failures"] + cm["circuits"][name]["successes"]
    if total == 0
        return 0
    (cm["circuits"][name]["failures"] * 100) / total

fn cm_circuit_count(cm: dict) -> int
    len(keys(cm["circuits"]))

fn cm_open_count(cm: dict) -> int
    let count = 0
    let names = keys(cm["circuits"])
    for i in 0..len(names)
        if cm["circuits"][names[i]]["state"] == "open"
            count += 1
    count

fn cm_trip_count(cm: dict, name: string) -> int
    let has = contains(cm["circuits"], name)
    if has != true
        return 0
    cm["circuits"][name]["trips"]
