// forge_coloring -- graph coloring: assign a "color" to every node so that no two connected nodes share the
// same color, using as few colors as a fast greedy pass can manage. This models any "assign resources so
// conflicting things differ" problem: register allocation in a compiler (variables that are live at once must go
// in different registers), exam/room/shift scheduling (overlapping events need different slots), radio-frequency
// assignment (nearby towers must not clash), Sudoku-style constraints, and the classic map coloring (adjacent
// regions get different colors). forge_bipartite answers the special two-color case; this handles any number.
// It's greedy (give each node the lowest color none of its already-colored neighbours use) -- fast and a good
// upper bound, though not always the theoretical minimum. Edges are [u, v] undirected, string ids. Colors are
// integers 0,1,2,.... LEAF -- imports NOTHING.

// PRIVATE.
fn _gc_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    let i = 0
    while i < len(edges)
        let u = edges[i][0]
        if contains(seen, u) == false
            seen[u] = 1
            push(nodes, u)
        let v = edges[i][1]
        if contains(seen, v) == false
            seen[v] = 1
            push(nodes, v)
        i = i + 1
    nodes

// PRIVATE: undirected adjacency.
fn _gc_adj(edges: list, nodes: list) -> dict
    let adj = {}
    let i = 0
    while i < len(nodes)
        adj[nodes[i]] = []
        i = i + 1
    let e = 0
    while e < len(edges)
        push(adj[edges[e][0]], edges[e][1])
        push(adj[edges[e][1]], edges[e][0])
        e = e + 1
    adj

// A greedy proper coloring as a dict node -> color (integer). No two adjacent nodes get the same color.
fn greedy_coloring(edges: list) -> dict
    let nodes = _gc_nodes(edges)
    let adj = _gc_adj(edges, nodes)
    let color = {}
    let i = 0
    while i < len(nodes)
        let v = nodes[i]
        let used = {}
        let nb = adj[v]
        let j = 0
        while j < len(nb)
            if contains(color, nb[j])
                used[str(color[nb[j]])] = 1
            j = j + 1
        let c = 0
        while contains(used, str(c))
            c = c + 1
        color[v] = c
        i = i + 1
    color

// The number of colors the greedy coloring used (an upper bound on the chromatic number).
fn color_count(edges: list) -> int
    let color = greedy_coloring(edges)
    let ks = keys(color)
    let maxc = 0 - 1
    let i = 0
    while i < len(ks)
        if color[ks[i]] > maxc
            maxc = color[ks[i]]
        i = i + 1
    maxc + 1

// Verify a coloring is proper: no edge connects two same-colored nodes.
fn is_proper_coloring(edges: list, color: dict) -> bool
    let ok = true
    let i = 0
    while i < len(edges)
        let u = edges[i][0]
        let v = edges[i][1]
        if contains(color, u) and contains(color, v)
            if color[u] == color[v]
                ok = false
        i = i + 1
    ok
