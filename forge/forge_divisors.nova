// forge_divisors -- the DIVISORS of a number and the classic quantities built from them. Where prime factorization
// (forge_primes) breaks n into its prime building blocks, this lists ALL the numbers that divide n evenly, and
// computes how many there are (the tau function), their sum (the sigma function), and the sum of just the PROPER
// divisors (the aliquot sum) -- which classifies every number as perfect (equals its proper-divisor sum, like 6
// and 28), abundant, or deficient. These show up in number theory, scheduling and tiling (which group sizes divide
// evenly), simplifying fractions, cryptography, and recreational math (perfect/amicable numbers). Divisors are
// found in O(sqrt n) by trial division, pairing each divisor i with n/i. Works on positive integers. LEAF.

// All divisors of n (including 1 and n), in ascending order.
fn divisors(n: int) -> list
    let out = []
    if n >= 1
        let i = 1
        while i * i <= n
            if n % i == 0
                push(out, i)
                if i != n / i
                    push(out, n / i)
            i = i + 1
        // sort ascending (insertion sort over ints)
        let a = 1
        while a < len(out)
            let key = out[a]
            let b = a - 1
            while b >= 0 and out[b] > key
                out[b + 1] = out[b]
                b = b - 1
            out[b + 1] = key
            a = a + 1
    out

// The number of divisors of n (the tau / d(n) function).
fn num_divisors(n: int) -> int
    let count = 0
    let i = 1
    while i * i <= n
        if n % i == 0
            count = count + 1
            if i != n / i
                count = count + 1
        i = i + 1
    count

// The sum of all divisors of n (the sigma function).
fn sum_divisors(n: int) -> int
    let total = 0
    let i = 1
    while i * i <= n
        if n % i == 0
            total = total + i
            if i != n / i
                total = total + n / i
        i = i + 1
    total

// The sum of the PROPER divisors of n (all divisors except n itself) -- the aliquot sum.
fn aliquot_sum(n: int) -> int
    sum_divisors(n) - n

// True if n is a PERFECT number (equals the sum of its proper divisors): 6, 28, 496, 8128, ...
fn is_perfect(n: int) -> bool
    let out = false
    if n >= 1 and aliquot_sum(n) == n
        out = true
    out

// True if n is ABUNDANT (proper-divisor sum exceeds n), e.g. 12, 18, 20.
fn is_abundant(n: int) -> bool
    let out = false
    if aliquot_sum(n) > n
        out = true
    out

// True if n is DEFICIENT (proper-divisor sum is less than n) -- all primes and powers of primes are deficient.
fn is_deficient(n: int) -> bool
    let out = false
    if aliquot_sum(n) < n
        out = true
    out
