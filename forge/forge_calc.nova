// forge_calc -- evaluate an arithmetic expression given as a string, with correct operator PRECEDENCE and
// parentheses: calc("1 + 2 * 3") is 7, not 9, and calc("(1 + 2) * 3") is 9. This is the little engine every
// calculator, spreadsheet cell, formula/config field ("width = (base + 2) * scale"), and rule expression needs --
// turning human-written math into a value. It's a textbook recursive-descent parser: an expression is a chain of
// +/- over terms, a term is a chain of * / % over factors, and a factor is a number, a parenthesized
// sub-expression, or a unary +/- -- a grammar that encodes precedence and left-to-right associativity directly in
// the call structure. Supports + - * / % , parentheses, unary minus, and whitespace, over 64-bit INTEGER
// arithmetic (/ is integer division). Division/mod by zero is treated leniently (the operation is skipped). LEAF.

// PRIVATE: split an expression into tokens. Each token is [kind, value]: kind 0 = number (value is the integer),
// kind 1 = operator (value is the one-character string).
fn _cx_tokenize(s: string) -> list
    let tokens = []
    let i = 0
    let n = len(s)
    while i < n
        let o = ord(char_at(s, i))
        if o == 32 or o == 9
            i = i + 1
        else
            if o >= 48 and o <= 57
                let num = 0
                while i < n and ord(char_at(s, i)) >= 48 and ord(char_at(s, i)) <= 57
                    num = num * 10 + (ord(char_at(s, i)) - 48)
                    i = i + 1
                push(tokens, [0, num])
            else
                push(tokens, [1, char_at(s, i)])
                i = i + 1
    tokens

// PRIVATE: is the current token the operator `ch`?
fn _cx_at(tokens: list, p: list, ch: string) -> bool
    let out = false
    if p[0] < len(tokens)
        let t = tokens[p[0]]
        if t[0] == 1 and t[1] == ch
            out = true
    out

// PRIVATE: factor = number | '(' expr ')' | ('-'|'+') factor
fn _cx_factor(tokens: list, p: list) -> int
    let out = 0
    if _cx_at(tokens, p, "-")
        p[0] = p[0] + 1
        out = 0 - _cx_factor(tokens, p)
    else
        if _cx_at(tokens, p, "+")
            p[0] = p[0] + 1
            out = _cx_factor(tokens, p)
        else
            if _cx_at(tokens, p, "(")
                p[0] = p[0] + 1
                out = _cx_expr(tokens, p)
                if _cx_at(tokens, p, ")")
                    p[0] = p[0] + 1
            else
                // number
                if p[0] < len(tokens)
                    let t = tokens[p[0]]
                    if t[0] == 0
                        out = t[1]
                        p[0] = p[0] + 1
    out

// PRIVATE: term = factor (('*'|'/'|'%') factor)*
fn _cx_term(tokens: list, p: list) -> int
    let v = _cx_factor(tokens, p)
    let go = true
    while go
        if _cx_at(tokens, p, "*")
            p[0] = p[0] + 1
            v = v * _cx_factor(tokens, p)
        else
            if _cx_at(tokens, p, "/")
                p[0] = p[0] + 1
                let d = _cx_factor(tokens, p)
                if d != 0
                    v = v / d
            else
                if _cx_at(tokens, p, "%")
                    p[0] = p[0] + 1
                    let m = _cx_factor(tokens, p)
                    if m != 0
                        v = v % m
                else
                    go = false
    v

// PRIVATE: expr = term (('+'|'-') term)*
fn _cx_expr(tokens: list, p: list) -> int
    let v = _cx_term(tokens, p)
    let go = true
    while go
        if _cx_at(tokens, p, "+")
            p[0] = p[0] + 1
            v = v + _cx_term(tokens, p)
        else
            if _cx_at(tokens, p, "-")
                p[0] = p[0] + 1
                v = v - _cx_term(tokens, p)
            else
                go = false
    v

// Evaluate an arithmetic expression string to an integer, honoring precedence and parentheses.
fn calc(expr: string) -> int
    let tokens = _cx_tokenize(expr)
    let p = [0]
    _cx_expr(tokens, p)
