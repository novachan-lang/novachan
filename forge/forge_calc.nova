// forge_calc -- evaluate an arithmetic expression string with correct precedence. LEAF.

fn _cx_tokenize(s: string) -> list
    let tokens = []
    let i = 0
    let n = len(s)
    while i < n
        let o = ord(char_at(s, i))
        if o == 32 or o == 9
            i += 1
        else if o >= 48 and o <= 57
            let num = 0
            while i < n and ord(char_at(s, i)) >= 48 and ord(char_at(s, i)) <= 57
                num = num * 10 + (ord(char_at(s, i)) - 48)
                i += 1
            push(tokens, [0, num])
        else
            push(tokens, [1, char_at(s, i)])
            i += 1
    tokens

fn _cx_at(tokens: list, p: list, ch: string) -> bool
    p[0] < len(tokens) and tokens[p[0]][0] == 1 and tokens[p[0]][1] == ch

fn _cx_factor(tokens: list, p: list) -> int
    if _cx_at(tokens, p, "-")
        p[0] += 1
        return -_cx_factor(tokens, p)
    else if _cx_at(tokens, p, "+")
        p[0] += 1
        return _cx_factor(tokens, p)
    else if _cx_at(tokens, p, "(")
        p[0] += 1
        let out = _cx_expr(tokens, p)
        if _cx_at(tokens, p, ")")
            p[0] += 1
        return out
    if p[0] < len(tokens) and tokens[p[0]][0] == 0
        let v = tokens[p[0]][1]
        p[0] += 1
        return v
    0

fn _cx_term(tokens: list, p: list) -> int
    let v = _cx_factor(tokens, p)
    loop
        if _cx_at(tokens, p, "*")
            p[0] += 1
            v = v * _cx_factor(tokens, p)
        else if _cx_at(tokens, p, "/")
            p[0] += 1
            let d = _cx_factor(tokens, p)
            if d != 0
                v = v / d
        else if _cx_at(tokens, p, "%")
            p[0] += 1
            let m = _cx_factor(tokens, p)
            if m != 0
                v = v % m
        else
            break
    v

fn _cx_expr(tokens: list, p: list) -> int
    let v = _cx_term(tokens, p)
    loop
        if _cx_at(tokens, p, "+")
            p[0] += 1
            v += _cx_term(tokens, p)
        else if _cx_at(tokens, p, "-")
            p[0] += 1
            v -= _cx_term(tokens, p)
        else
            break
    v

fn calc(expr: string) -> int
    _cx_expr(_cx_tokenize(expr), [0])
