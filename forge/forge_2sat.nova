// forge_2sat -- 2-SAT: decide whether a set of "either A or B" constraints over boolean variables can ALL be
// satisfied at once, and if so produce a satisfying assignment -- in LINEAR time. General boolean satisfiability
// is NP-hard, but the special case where every clause has exactly two literals is solvable fast, which makes 2-SAT
// a surprisingly powerful modeling tool: any problem you can phrase as "for each pair, at least one of these two
// choices must hold" (light on/off with adjacency rules, either-or scheduling, 2-coloring, conflict resolution,
// putting each item in one of two groups without violating pairwise constraints). The trick: each clause (a OR b)
// is equivalent to two implications (not a -> b) and (not b -> a); build that implication graph over the 2n
// literal-nodes, find its strongly connected components, and it's satisfiable exactly when no variable shares a
// component with its own negation -- with the SCC order handing you the assignment. Clauses use signed literals
// (+v = variable v true, -v = v false), variables numbered 1..n. LEAF -- imports NOTHING.

// PRIVATE: the implication-graph node for a signed literal (+v -> "v is true" node, -v -> "v is false" node).
fn _ts_node(lit: int) -> int
    let v = lit
    if v < 0
        v = 0 - v
    let base = 2 * (v - 1)
    if lit > 0
        base
    else
        base + 1

// PRIVATE: recursive Tarjan SCC. Shared state mutated in place; comp[] gets each node's component id.
fn _ts_tarjan(u: int, adj: list, disc: list, low: list, onstk: list, stk: list, comp: list, timer: list, ncomp: list)
    timer[0] = timer[0] + 1
    disc[u] = timer[0]
    low[u] = timer[0]
    push(stk, u)
    onstk[u] = 1
    let nbrs = adj[u]
    let i = 0
    while i < len(nbrs)
        let v = nbrs[i]
        if disc[v] == 0 - 1
            _ts_tarjan(v, adj, disc, low, onstk, stk, comp, timer, ncomp)
            if low[v] < low[u]
                low[u] = low[v]
        else
            if onstk[v] == 1 and disc[v] < low[u]
                low[u] = disc[v]
        i += 1
    if low[u] == disc[u]
        let done = false
        while done == false
            let w = pop(stk)
            onstk[w] = 0
            comp[w] = ncomp[0]
            if w == u
                done = true
        ncomp[0] = ncomp[0] + 1

// Solve a 2-SAT instance: n variables (1..n) and `clauses` (each [litA, litB] with signed literals). Returns
// [satisfiable, assignment] where satisfiable is 1/0 and assignment[i] is the 0/1 value of variable i+1 (empty if
// unsatisfiable).
fn two_sat(n: int, clauses: list) -> list
    let nodes = 2 * n
    // build implication graph
    let adj = [[] for z in 0..nodes]
    for ci in 0..len(clauses)
        let cl = clauses[ci]
        let a = cl[0]
        let b = cl[1]
        // (a OR b): (not a -> b) and (not b -> a)
        let na = _ts_node(a) ^ 1
        let nb = _ts_node(b) ^ 1
        push(adj[na], _ts_node(b))
        push(adj[nb], _ts_node(a))
    // Tarjan over all nodes
    let disc = []
    let low = []
    let onstk = []
    let comp = []
    for q in 0..nodes
        push(disc, 0 - 1)
        push(low, 0)
        push(onstk, 0)
        push(comp, 0 - 1)
    let stk = []
    let timer = [0]
    let ncomp = [0]
    for u in 0..nodes
        if disc[u] == 0 - 1
            _ts_tarjan(u, adj, disc, low, onstk, stk, comp, timer, ncomp)
    // check satisfiability + build assignment
    let sat = true
    let assign = []
    for v in 0..n
        if comp[2 * v] == comp[2 * v + 1]
            sat = false
    let out = [0, []]
    if sat
        for vv in 0..n
            // Tarjan numbers SCCs in reverse topological order; the literal whose component
            // was finalized later (smaller id) is the one placed later in topo order -> chosen true.
            if comp[2 * vv] < comp[2 * vv + 1]
                push(assign, 1)
            else
                push(assign, 0)
        out = [1, assign]
    out
