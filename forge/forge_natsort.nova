// forge_natsort -- natural / human sort comparison: order strings the way people expect by treating embedded
// digit runs as NUMBERS, so "file2" < "file10" (not lexical "file10" < "file2") and "v1.9" < "v1.10". The
// comparator behind file managers, version lists, and any user-facing sorted list.
//
// RAISED 2026-08-05. natcompare was one 38-line function carrying five nested loops and eight bare
// `return -1 / return 1` statements, with the -1/0/1 convention re-derived by hand at four separate places.
// The comparison ORDER is the contract here, so the scan itself is untouched -- what changed is that the
// three-way result is now produced in ONE place and the digit-run scan is named.
//
// Also adds the pieces this module was missing: natsort() and natsort_desc(), so a caller does not have
// to re-wrap the comparator, and natkey() for sorting by a derived field.
//
// VERIFIED + FIXED 2026-08-05: natkey (added by that raise) encoded the ordering rule a SECOND time and
// got it wrong, so natsort disagreed with natless on input as ordinary as ["file2", "file-1"]. natkey now
// encodes natcompare's stated rule -- stripped length, then lexical -- directly. See the note on natkey.

fn _ns_is_digit(c: string) -> bool
    find("0123456789", c) >= 0

// Strip leading zeros (keep at least one digit) so "007" compares as "7".
// The `while` STAYS: it walks to the first non-zero, a data-dependent stop.
fn _ns_strip0(s: string) -> string
    let i = 0
    while i < len(s) - 1 and char_at(s, i) == "0"
        i += 1
    slice(s, i, len(s))

// The -1/0/1 three-way result, in ONE place. It was open-coded as an if/return pair at four separate
// sites, each of which had to get the direction right independently.
fn _ns_cmp3(less: bool, greater: bool) -> int
    if less
        return 0 - 1
    1 if greater else 0

// Index just past the digit run starting at `p` (== p when there is no digit there).
// Named, so the two identical inline scans in natcompare become one function used twice.
fn _ns_run_end(s: string, p: int) -> int
    let k = p
    while k < len(s) and _ns_is_digit(char_at(s, k))
        k += 1
    k

// Natural compare: -1 if a<b, 0 equal, 1 if a>b. Digit runs are compared numerically (by stripped length
// then lexically), all other characters lexically. A shorter otherwise-equal string sorts first.
//
// The outer `while` STAYS and so does the two-pointer walk: i and j advance by a whole digit run or by one
// character depending on the DATA, which is precisely what a for-range cannot express. Rewriting this as a
// comprehension would also lose the short-circuit -- it must stop at the first difference.
fn natcompare(a: string, b: string) -> int
    let i = 0
    let j = 0
    let la = len(a)
    let lb = len(b)
    while i < la and j < lb
        let ca = char_at(a, i)
        let cb = char_at(b, j)
        if _ns_is_digit(ca) and _ns_is_digit(cb)
            let sa = i
            let sb = j
            i = _ns_run_end(a, i)
            j = _ns_run_end(b, j)
            let na = _ns_strip0(slice(a, sa, i))
            let nb = _ns_strip0(slice(b, sb, j))
            // More digits (after stripping) means a larger number; same width falls back to lexical,
            // which is correct for equal-length digit strings.
            if len(na) != len(nb)
                return _ns_cmp3(len(na) < len(nb), true)
            if na != nb
                return _ns_cmp3(na < nb, true)
        else
            if ca != cb
                return _ns_cmp3(ca < cb, true)
            i += 1
            j += 1
    // Both ran out together -> equal; otherwise the one with characters left sorts after.
    _ns_cmp3(la - i < lb - j, la - i > lb - j)

// Is a naturally less than b?
fn natless(a: string, b: string) -> bool
    natcompare(a, b) < 0

// Sort a list of strings naturally -- the operation a caller actually wants, which the module did not
// expose before. Sorting by natkey (rather than hand-rolling a comparator sort) keeps the builtin
// O(n log n) sort; natkey is order-equivalent to natcompare, so this ordering IS natcompare's.
fn natsort(xs: list) -> list
    sort_by(xs, (s) => natkey(s))

// Descending natural sort.
fn natsort_desc(xs: list) -> list
    reverse(natsort(xs))

// A sort KEY for natural order: lexically comparing two keys reproduces natcompare exactly. Lets a
// caller sort STRUCTS by a derived string field -- sort_by(rows, (r) => natkey(r.name)) -- which a bare
// comparator cannot do, and lets natsort use the builtin sort instead of a hand-rolled one.
//
// It encodes natcompare's rule DIRECTLY instead of approximating it. natcompare orders a digit run by
// its zero-stripped LENGTH first and only then lexically, so the key emits that length as a field ahead
// of the stripped run. Non-digit characters are copied verbatim; a digit can only ever appear inside a
// "<len-of-len><len><run>" group, so a length field can never be confused with content.
//
// FIXED 2026-08-05: the first version of this key padded each run with SPACES to width 12. Space is
// 0x20, BELOW every digit, so a run sorted after any character in "!\"#$%&'()*+,-./" -- while
// natcompare compares that character against the DIGIT and sorts it before. natsort and natless
// therefore contradicted each other on ordinary input:
//     natless("file-1", "file2")        -> true   (file-1 first)
//     natsort(["file2", "file-1"])      -> ["file2", "file-1"]   (file-1 LAST)
// Emitting the length field makes the two agree by construction: the field's leading character is
// always a digit, exactly what natcompare compares at that position.
//
// The length field is SELF-DELIMITING, not fixed-width: it is the digit count of the length, then the
// length, then the run ("5" -> "1" "1" "5"; a 12-digit run -> "2" "12" <run>). A fixed width of 3 was
// tried first and reintroduced the very bug above one order of magnitude out: a 1000-digit run keys as
// "1000..." and a 999-digit run as "999...", so lexically the LONGER number sorted FIRST while
// natcompare sorts it last. Emitting the width's own width first makes every comparison align at every
// scale -- two lengths of different digit-count are separated by that first character, two of the same
// digit-count compare as equal-width numerals, and the leading character is still always a digit, which
// is what keeps a digit run ordered against a neighbouring non-digit correctly. The bound is now a run
// of 10^9 digits, i.e. unreachable.
//
// The `while` STAYS: a digit run advances the cursor by the whole run, so the step is data-dependent.
fn natkey(s: string) -> string
    let parts = []
    let i = 0
    let n = len(s)
    while i < n
        if _ns_is_digit(char_at(s, i))
            let e = _ns_run_end(s, i)
            let run = _ns_strip0(slice(s, i, e))
            let w = str(len(run))
            push(parts, str(len(w)) + w + run)
            i = e
        else
            push(parts, char_at(s, i))
            i += 1
    join(parts, "")
