// forge_natsort -- natural / human sort comparison: order strings the way people expect by treating embedded
// digit runs as NUMBERS, so "file2" < "file10" (not lexical "file10" < "file2") and "v1.9" < "v1.10". The
// comparator behind file managers, version lists, and any user-facing sorted list. LEAF -- imports NOTHING.

fn _ns_is_digit(c: string) -> bool
    find("0123456789", c) >= 0

// Strip leading zeros (keep at least one digit) so "007" compares as "7".
fn _ns_strip0(s: string) -> string
    let i = 0
    while i < len(s) - 1 and char_at(s, i) == "0"
        i += 1
    slice(s, i, len(s))

// Natural compare: -1 if a<b, 0 equal, 1 if a>b. Digit runs are compared numerically (by stripped length then
// lexically), all other characters lexically. A shorter otherwise-equal string sorts first.
fn natcompare(a: string, b: string) -> int
    let i = 0
    let j = 0
    let la = len(a)
    let lb = len(b)
    while i < la and j < lb
        let ca = char_at(a, i)
        let cb = char_at(b, j)
        if _ns_is_digit(ca) and _ns_is_digit(cb)
            let sa = i
            while i < la and _ns_is_digit(char_at(a, i))
                i += 1
            let sb = j
            while j < lb and _ns_is_digit(char_at(b, j))
                j += 1
            let na = _ns_strip0(slice(a, sa, i))
            let nb = _ns_strip0(slice(b, sb, j))
            if len(na) != len(nb)
                if len(na) < len(nb)
                    return -1
                return 1
            if na != nb
                if na < nb
                    return -1
                return 1
        else
            if ca != cb
                if ca < cb
                    return -1
                return 1
            i += 1
            j += 1
    let ra = la - i
    let rb = lb - j
    if ra < rb
        return -1
    if ra > rb
        return 1
    0

// Is a naturally less than b?
fn natless(a: string, b: string) -> bool
    natcompare(a, b) < 0
