// forge_request_coalesce — Request coalescing / deduplication.
// Merge identical in-flight requests to avoid thundering herd.

fn rc_new() -> dict
    {"pending": {}, "coalesced": 0, "served": 0}

fn rc_request(rc: dict, key: string) -> dict
    if key in rc["pending"]
        rc["pending"][key] += 1
        rc["coalesced"] += 1
        return {"coalesced": 1, "waiters": rc["pending"][key]}
    rc["pending"][key] = 1
    {"coalesced": 0, "waiters": 1}

fn rc_complete(rc: dict, key: string) -> int
    if key not in rc["pending"]
        return 0
    let waiters = rc["pending"][key]
    rc["served"] += waiters
    let new_pending = {}
    let all_keys = keys(rc["pending"])
    for i in 0..len(all_keys)
        if all_keys[i] != key
            new_pending[all_keys[i]] = rc["pending"][all_keys[i]]
    rc["pending"] = new_pending
    waiters

fn rc_pending_count(rc: dict) -> int
    len(keys(rc["pending"]))

fn rc_total_coalesced(rc: dict) -> int
    rc["coalesced"]

fn rc_total_served(rc: dict) -> int
    rc["served"]

fn rc_waiters_for(rc: dict, key: string) -> int
    if key not in rc["pending"]
        return 0
    rc["pending"][key]
