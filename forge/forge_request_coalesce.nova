// forge_request_coalesce — Request coalescing / deduplication.
// Merge identical in-flight requests to avoid thundering herd.

fn rc_new() -> dict
    let rc = {}
    rc["pending"] = {}
    rc["coalesced"] = 0
    rc["served"] = 0
    rc

fn rc_request(rc: dict, key: string) -> dict
    let result = {}
    let has = contains(rc["pending"], key)
    if has == true
        rc["pending"][key] = rc["pending"][key] + 1
        rc["coalesced"] = rc["coalesced"] + 1
        result["coalesced"] = 1
        result["waiters"] = rc["pending"][key]
    else
        rc["pending"][key] = 1
        result["coalesced"] = 0
        result["waiters"] = 1
    result

fn rc_complete(rc: dict, key: string) -> int
    let has = contains(rc["pending"], key)
    if has != true
        return 0
    let waiters = rc["pending"][key]
    rc["served"] = rc["served"] + waiters
    let new_pending = {}
    let all_keys = keys(rc["pending"])
    let i = 0
    while i < len(all_keys)
        if all_keys[i] != key
            new_pending[all_keys[i]] = rc["pending"][all_keys[i]]
        i = i + 1
    rc["pending"] = new_pending
    waiters

fn rc_pending_count(rc: dict) -> int
    len(keys(rc["pending"]))

fn rc_total_coalesced(rc: dict) -> int
    rc["coalesced"]

fn rc_total_served(rc: dict) -> int
    rc["served"]

fn rc_waiters_for(rc: dict, key: string) -> int
    let has = contains(rc["pending"], key)
    if has != true
        return 0
    rc["pending"][key]
