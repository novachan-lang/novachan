// forge_service_discovery — Mesh service registry with health + version tracking.
// Register/lookup services by name; track endpoint, version, and health state.

fn sd_new() -> dict
    let s = {}
    s["endpoint"] = {}
    s["version"] = {}
    s["healthy"] = {}
    s["active"] = {}
    s["count"] = 0
    s

fn sd_register(s: dict, service_name: string, endpoint: string, version: string) -> dict
    let was_active = contains(s["active"], service_name) == true
    if was_active
        was_active = s["active"][service_name] == 1
    s["endpoint"][service_name] = endpoint
    s["version"][service_name] = version
    s["healthy"][service_name] = 1
    s["active"][service_name] = 1
    if was_active != true
        s["count"] = s["count"] + 1
    s

fn sd_deregister(s: dict, service_name: string) -> Result
    let is_active = contains(s["active"], service_name) == true
    if is_active
        is_active = s["active"][service_name] == 1
    if is_active != true
        return err("not registered: " + service_name)
    s["active"][service_name] = 0
    s["count"] = s["count"] - 1
    ok(service_name)

fn sd_lookup(s: dict, service_name: string) -> Result
    let is_active = contains(s["active"], service_name) == true
    if is_active
        is_active = s["active"][service_name] == 1
    if is_active != true
        return err("not found: " + service_name)
    ok(s["endpoint"][service_name])

fn sd_version(s: dict, service_name: string) -> Result
    let is_active = contains(s["active"], service_name) == true
    if is_active
        is_active = s["active"][service_name] == 1
    if is_active != true
        return err("not found: " + service_name)
    ok(s["version"][service_name])

fn sd_set_healthy(s: dict, service_name: string, healthy: int) -> Result
    let is_active = contains(s["active"], service_name) == true
    if is_active
        is_active = s["active"][service_name] == 1
    if is_active != true
        return err("not found: " + service_name)
    s["healthy"][service_name] = healthy
    ok(service_name)

fn sd_is_healthy(s: dict, service_name: string) -> Result
    let is_active = contains(s["active"], service_name) == true
    if is_active
        is_active = s["active"][service_name] == 1
    if is_active != true
        return err("not found: " + service_name)
    ok(s["healthy"][service_name])

fn sd_service_count(s: dict) -> int
    s["count"]

fn sd_healthy_count(s: dict) -> int
    let names = keys(s["active"])
    let i = 0
    let cnt = 0
    while i < len(names)
        let n = names[i]
        if s["active"][n] == 1
            if s["healthy"][n] == 1
                cnt = cnt + 1
        i = i + 1
    cnt

fn sd_service_list(s: dict) -> string
    let names = keys(s["active"])
    let i = 0
    let result = ""
    while i < len(names)
        let n = names[i]
        if s["active"][n] == 1
            if result == ""
                result = n
            else
                result = result + "," + n
        i = i + 1
    result
