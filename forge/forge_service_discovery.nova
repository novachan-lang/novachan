// forge_service_discovery — Service registry with health-aware discovery.

fn sd_new() -> dict
    let s = {}
    s["services"] = {}
    s["count"] = 0
    s["next_id"] = 1
    s

fn sd_register(s: dict, name: string, address: string, port: int) -> dict
    let id = s["next_id"]
    let k = str(id)
    s["services"][k + "_name"] = name
    s["services"][k + "_addr"] = address
    s["services"][k + "_port"] = port
    s["services"][k + "_healthy"] = 1
    s["next_id"] = id + 1
    s["count"] = s["count"] + 1
    s

fn sd_mark_unhealthy(s: dict, service_id: int) -> dict
    let k = str(service_id)
    let has = contains(s["services"], k + "_name")
    if has == true
        s["services"][k + "_healthy"] = 0
    s

fn sd_mark_healthy(s: dict, service_id: int) -> dict
    let k = str(service_id)
    let has = contains(s["services"], k + "_name")
    if has == true
        s["services"][k + "_healthy"] = 1
    s

fn sd_discover(s: dict, name: string) -> dict
    let result = {}
    result["found"] = 0
    result["address"] = ""
    result["port"] = 0
    let i = 1
    while i < s["next_id"]
        let k = str(i)
        let has = contains(s["services"], k + "_name")
        if has == true
            if s["services"][k + "_name"] == name
                if s["services"][k + "_healthy"] == 1
                    result["found"] = 1
                    result["address"] = s["services"][k + "_addr"]
                    result["port"] = s["services"][k + "_port"]
                    result["id"] = i
                    return result
        i = i + 1
    result

fn sd_healthy_count(s: dict, name: string) -> int
    let count = 0
    let i = 1
    while i < s["next_id"]
        let k = str(i)
        let has = contains(s["services"], k + "_name")
        if has == true
            if s["services"][k + "_name"] == name
                if s["services"][k + "_healthy"] == 1
                    count = count + 1
        i = i + 1
    count

fn sd_total_services(s: dict) -> int
    s["count"]
