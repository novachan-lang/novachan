// forge_debruijn -- generate De Bruijn sequences: the SHORTEST cyclic sequence over a k-symbol alphabet that
// contains every possible length-n string exactly once. For binary n=3 that's "00010111" (length 8) -- read it in
// a circle and each of the eight 3-bit patterns appears once and only once. This compactness makes De Bruijn
// sequences the trick behind brute-forcing every keypad/PIN combination with the fewest keypresses, exhaustive
// combinatorial test vectors (cover every length-n input in minimal space), the classic O(1) "find the lowest set
// bit" bit hack (a De Bruijn constant plus a small lookup table), and position encoding on rotary encoders and
// self-locating tags. It's built by the Frank-Ruskey (FKM) algorithm, which emits the lexicographically smallest
// such sequence by concatenating the Lyndon words whose length divides n. Symbols are 0..k-1; the result has
// length exactly k^n. LEAF -- imports NOTHING.

// PRIVATE: the FKM recursion. Shared `a` (working necklace) and `seq` (output) are mutated in place.
fn _db_rec(a: list, seq: list, t: int, p: int, k: int, n: int)
    if t > n
        if n % p == 0
            let j = 1
            while j <= p
                push(seq, a[j])
                j += 1
    else
        a[t] = a[t - p]
        _db_rec(a, seq, t + 1, p, k, n)
        let j = a[t - p] + 1
        while j < k
            a[t] = j
            _db_rec(a, seq, t + 1, t, k, n)
            j += 1

// The De Bruijn sequence B(k, n) as a list of symbols (each 0..k-1), length k^n. Every length-n string over the
// alphabet appears exactly once as a cyclic substring.
fn de_bruijn(k: int, n: int) -> list
    let a = []
    let z = 0
    while z <= k * n
        push(a, 0)
        z += 1
    let seq = []
    _db_rec(a, seq, 1, 1, k, n)
    seq

// The De Bruijn sequence rendered as a string of digits (for k <= 10). B(2,3) -> "00010111".
fn de_bruijn_string(k: int, n: int) -> string
    let seq = de_bruijn(k, n)
    let out_parts = []
    for i in 0..len(seq)
        push(out_parts, str(seq[i]))
    let out = join(out_parts, "")
    out
