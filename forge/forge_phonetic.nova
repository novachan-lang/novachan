// forge_phonetic -- Soundex phonetic encoding: match names that SOUND alike despite spelling
// ("Robert"/"Rupert", "Smith"/"Smyth" -> same code). Used for name search, deduplication, and
// "sounds-like" lookups (what a DB SOUNDEX() function or a fuzzy name index does). Classic American
// Soundex: first LETTER uppercased + 3 digits, e.g. "Robert" -> "R163". LEAF -- imports NOTHING.

// PRIVATE: the Soundex digit (1..6) for a single UPPERCASE letter, or 0 ("no digit") for
// a/e/i/o/u/y/h/w or any non-letter. Vowels + h/w return 0 so they reset the run and are dropped.
fn _soundex_digit(c: string) -> int
    if find("BFPV", c) >= 0
        return 1
    if find("CGJKQSXZ", c) >= 0
        return 2
    if find("DT", c) >= 0
        return 3
    if find("L", c) >= 0
        return 4
    if find("MN", c) >= 0
        return 5
    if find("R", c) >= 0
        return 6
    return 0

// The 4-char Soundex code for a word, e.g. "Robert" -> "R163". Non-letters are skipped;
// empty / no-letter input -> "0000".
fn soundex(word: string) -> string
    let up = upper(word)
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let n = len(up)

    // Find the first letter -- it becomes the code prefix.
    let i = 0
    let first = ""
    while i < n and len(first) == 0
        let c = char_at(up, i)
        if find(alpha, c) >= 0
            first = c
        i += 1

    if len(first) == 0
        return "0000"

    // prev_digit starts as the digit of the first letter so a second letter of the SAME
    // digit is dropped. i already points just past the first letter.
    let code = first
    let prev_digit = _soundex_digit(first)

    while i < n and len(code) < 4
        let c = char_at(up, i)
        if find(alpha, c) >= 0
            let d = _soundex_digit(c)
            if d != 0 and d != prev_digit
                code += str(d)
            // h/w preserve the previous digit (so h/w-separated same-digit letters still
            // collapse); every other letter -- coded OR vowel -- updates prev_digit (a vowel
            // sets it to 0, correctly resetting the run).
            if c != "H" and c != "W"
                prev_digit = d
        i += 1

    // Pad with "0" to length 4 (truncation to 4 is already enforced by the loop guard).
    while len(code) < 4
        code += "0"
    code

// The "sounds alike" test: true if two words share the same Soundex code.
fn soundex_match(a: string, b: string) -> bool
    soundex(a) == soundex(b)
