// forge_classiccipher -- the classic pen-and-paper ciphers: Caesar/ROT13, Atbash, Vigenere, and the Rail-Fence
// transposition. These are the historical roots of cryptography and a staple of teaching, puzzles, and CTF
// challenges. They are NOT secure (every one is broken by hand or trivial frequency analysis -- use forge_crypto
// for real encryption); the point is to understand the two fundamental ideas every modern cipher still builds on:
// SUBSTITUTION (replace each symbol -- Caesar shifts the alphabet, Atbash mirrors it, Vigenere shifts by a
// repeating key) and TRANSPOSITION (reorder the symbols -- Rail-Fence writes in a zigzag and reads by rows). All
// preserve non-letter characters and letter case. LEAF -- imports NOTHING.

// PRIVATE: shift a single letter by `shift` positions (0..25), wrapping within its case; non-letters unchanged.
fn _cc_shift_char(c: string, shift: int) -> string
    let o = ord(c)
    let out = c
    if o >= 65 and o <= 90
        out = chr(65 + (o - 65 + shift) % 26)
    if o >= 97 and o <= 122
        out = chr(97 + (o - 97 + shift) % 26)
    out

// PRIVATE: is c an ASCII letter?
fn _cc_alpha(c: string) -> bool
    let o = ord(c)
    let out = false
    if (o >= 65 and o <= 90) or (o >= 97 and o <= 122)
        out = true
    out

// PRIVATE: normalize a shift to 0..25.
fn _cc_norm(shift: int) -> int
    ((shift % 26) + 26) % 26

// Caesar cipher: shift every letter forward by `shift`. shift=3 turns "Hello" into "Khoor".
fn caesar_encrypt(s: string, shift: int) -> string
    let sh = _cc_norm(shift)
    let out = ""
    let i = 0
    while i < len(s)
        out = out + _cc_shift_char(char_at(s, i), sh)
        i = i + 1
    out

// Caesar decryption: shift back by `shift`.
fn caesar_decrypt(s: string, shift: int) -> string
    caesar_encrypt(s, 26 - _cc_norm(shift))

// ROT13: Caesar with shift 13 -- its own inverse (rot13(rot13(x)) == x).
fn rot13(s: string) -> string
    caesar_encrypt(s, 13)

// Atbash: mirror the alphabet (a<->z, b<->y, ...). Its own inverse.
fn atbash(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let o = ord(char_at(s, i))
        let c = char_at(s, i)
        if o >= 65 and o <= 90
            c = chr(90 - (o - 65))
        if o >= 97 and o <= 122
            c = chr(122 - (o - 97))
        out = out + c
        i = i + 1
    out

// PRIVATE: the per-letter shifts from a key ('a'/'A' -> 0, 'b'/'B' -> 1, ...); non-letters ignored.
fn _cc_keyshifts(key: string) -> list
    let shifts = []
    let i = 0
    while i < len(key)
        let o = ord(char_at(key, i))
        if o >= 65 and o <= 90
            push(shifts, o - 65)
        if o >= 97 and o <= 122
            push(shifts, o - 97)
        i = i + 1
    shifts

// PRIVATE: Vigenere core. dir = +1 encrypt, -1 decrypt. The key advances only on letters.
fn _cc_vig(s: string, key: string, dir: int) -> string
    let ks = _cc_keyshifts(key)
    let out = s
    if len(ks) > 0
        out = ""
        let ki = 0
        let i = 0
        while i < len(s)
            let c = char_at(s, i)
            if _cc_alpha(c)
                let sh = ks[ki % len(ks)]
                if dir < 0
                    sh = 26 - sh
                out = out + _cc_shift_char(c, sh % 26)
                ki = ki + 1
            else
                out = out + c
            i = i + 1
    out

// Vigenere cipher: shift each letter by the next letter of a repeating key. "ATTACKATDAWN"/"LEMON" -> "LXFOPVEFRNHR".
fn vigenere_encrypt(s: string, key: string) -> string
    _cc_vig(s, key, 1)

// Vigenere decryption with the same key.
fn vigenere_decrypt(s: string, key: string) -> string
    _cc_vig(s, key, 0 - 1)

// Rail-Fence transposition: write the text in a zigzag over `rails` rows, then read row by row.
fn railfence_encrypt(s: string, rails: int) -> string
    let out = s
    if rails > 1
        // per-rail buffers
        let rows = []
        let z = 0
        while z < rails
            push(rows, "")
            z = z + 1
        let r = 0
        let dir = 1
        let i = 0
        while i < len(s)
            rows[r] = rows[r] + char_at(s, i)
            if r == 0
                dir = 1
            else
                if r == rails - 1
                    dir = 0 - 1
            r = r + dir
            i = i + 1
        out = ""
        let k = 0
        while k < rails
            out = out + rows[k]
            k = k + 1
    out

// Rail-Fence decryption: reconstruct the zigzag and read it in order.
fn railfence_decrypt(cipher: string, rails: int) -> string
    let out = cipher
    if rails > 1
        let n = len(cipher)
        // the rail index for each output position
        let railOf = []
        let r = 0
        let dir = 1
        let i = 0
        while i < n
            push(railOf, r)
            if r == 0
                dir = 1
            else
                if r == rails - 1
                    dir = 0 - 1
            r = r + dir
            i = i + 1
        // how many characters land on each rail
        let counts = []
        let z = 0
        while z < rails
            push(counts, 0)
            z = z + 1
        let a = 0
        while a < n
            counts[railOf[a]] = counts[railOf[a]] + 1
            a = a + 1
        // slice the cipher into each rail's run
        let railStr = []
        let pos = 0
        let rr = 0
        while rr < rails
            push(railStr, slice(cipher, pos, pos + counts[rr]))
            pos = pos + counts[rr]
            rr = rr + 1
        // walk the zigzag, pulling the next char from the matching rail
        let idx = []
        let z2 = 0
        while z2 < rails
            push(idx, 0)
            z2 = z2 + 1
        out = ""
        let b = 0
        while b < n
            let rail = railOf[b]
            out = out + char_at(railStr[rail], idx[rail])
            idx[rail] = idx[rail] + 1
            b = b + 1
    out
