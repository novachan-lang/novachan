// forge_content_negotiation — HTTP content negotiation (Accept header matching).

fn cn_new() -> dict
    let cn = {}
    cn["types"] = {}
    cn["count"] = 0
    cn

fn cn_register(cn: dict, media_type: string, quality: int) -> dict
    cn["types"][media_type] = quality
    cn["count"] = cn["count"] + 1
    cn

fn cn_negotiate(cn: dict, accept: string) -> string
    let best = ""
    let best_q = 0
    let ks = keys(cn["types"])
    let i = 0
    while i < len(ks)
        let mt = ks[i]
        let q = cn["types"][mt]
        let found = contains_str(accept, mt)
        if found == 1
            if q > best_q
                best_q = q
                best = mt
        i = i + 1
    if len(best) > 0
        return best
    if len(ks) > 0
        let fallback = ks[0]
        let j = 1
        while j < len(ks)
            if cn["types"][ks[j]] > cn["types"][fallback]
                fallback = ks[j]
            j = j + 1
        return fallback
    ""

fn cn_supports(cn: dict, media_type: string) -> int
    let has = contains(cn["types"], media_type)
    if has == true
        return 1
    0

fn cn_type_count(cn: dict) -> int
    cn["count"]

fn contains_str(haystack: string, needle: string) -> int
    let hl = len(haystack)
    let nl = len(needle)
    if nl > hl
        return 0
    let i = 0
    while i <= hl - nl
        let matched = 1
        let j = 0
        while j < nl
            if haystack[i + j] != needle[j]
                matched = 0
                j = nl
            else
                j = j + 1
        if matched == 1
            return 1
        i = i + 1
    0
