// forge_content_negotiation — HTTP content negotiation (Accept header matching).

fn cn_new() -> dict
    {"types": {}, "count": 0}

fn cn_register(cn: dict, media_type: string, quality: int) -> dict
    cn["types"][media_type] = quality
    cn["count"] += 1
    cn

fn cn_negotiate(cn: dict, accept: string) -> string
    let best = ""
    let best_q = 0
    let ks = keys(cn["types"])
    for i in 0..len(ks)
        let mt = ks[i]
        let q = cn["types"][mt]
        let found = contains_str(accept, mt)
        if found == 1
            if q > best_q
                best_q = q
                best = mt
    if len(best) > 0
        return best
    if len(ks) > 0
        let fallback = ks[0]
        for j in 1..len(ks)
            if cn["types"][ks[j]] > cn["types"][fallback]
                fallback = ks[j]
        return fallback
    ""

fn cn_supports(cn: dict, media_type: string) -> int
    if media_type in cn["types"]
        return 1
    0

fn cn_type_count(cn: dict) -> int
    cn["count"]

fn contains_str(haystack: string, needle: string) -> int
    let hl = len(haystack)
    let nl = len(needle)
    if nl > hl
        return 0
    for i in 0..(hl - nl + 1)
        let matched = 1
        let j = 0
        while j < nl
            if haystack[i + j] != needle[j]
                matched = 0
                j = nl
            else
                j += 1
        if matched == 1
            return 1
    0
