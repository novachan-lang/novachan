// forge_test_prop -- property-based testing: deterministic pseudo-random value generators (int range, bool,
// string, one-of) driven by a seeded 31-bit LCG, plus a check recorder (pass/fail counts, pass rate, failed
// names) for turning generated values into a pass/fail report. Same seed -> same sequence, every run, every
// platform -- a failing property is always reproducible from its seed. LEAF -- imports NOTHING.

// PRIVATE: one step of a 31-bit linear congruential generator (same constants as forge_wrand's _wr_lcg, kept
// local so this module has zero imports). Always returns a value in [0, 2147483647].
fn _tp_lcg(seed: int) -> int
    (seed * 1103515245 + 12345) & 2147483647

// Create a new property-test state seeded with `seed`. Same seed => same generator sequence and an empty
// check ledger (0 pass, 0 fail, no failed names).
fn tp_new(seed: int) -> dict
    let s = {}
    s["seed"] = seed
    s["pass_count"] = 0
    s["fail_count"] = 0
    s["total"] = 0
    s["failed_names"] = ""
    s

// Advance the internal RNG by one LCG step, store it back into `state`, and return the new seed value.
// Every generator (tp_int_range/tp_bool/tp_string/tp_one_of) calls this, so the whole sequence is a single
// deterministic chain rooted at the seed passed to tp_new.
fn tp_next_seed(state: dict) -> int
    let nxt = _tp_lcg(state["seed"])
    state["seed"] = nxt
    nxt

// Current (last-drawn) seed value, without advancing the generator.
fn tp_current_seed(state: dict) -> int
    state["seed"]

// Deterministic int in [min_val, max_val] (inclusive both ends). err() if the range is empty (min_val > max_val).
fn tp_int_range(state: dict, min_val: int, max_val: int) -> Result
    if min_val > max_val
        return err("tp_int_range: min_val must be <= max_val")
    let range = max_val - min_val + 1
    let nxt = tp_next_seed(state)
    let offset = nxt - (nxt / range) * range
    ok(min_val + offset)

// Deterministic boolean: 0 or 1.
fn tp_bool(state: dict) -> int
    let nxt = tp_next_seed(state)
    nxt - (nxt / 2) * 2

// Deterministic string of 1..max_len random alphanumeric characters. err() if max_len <= 0.
fn tp_string(state: dict, max_len: int) -> Result
    if max_len <= 0
        return err("tp_string: max_len must be positive")
    let lenr = tp_int_range(state, 1, max_len)
    let slen = unwrap(lenr)
    let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    let nchars = len(chars)
    let out = ""
    let i = 0
    while i < slen
        let idxr = tp_int_range(state, 0, nchars - 1)
        let idx = unwrap(idxr)
        out = out + slice(chars, idx, idx + 1)
        i = i + 1
    ok(out)

// Pick one option from a comma-separated list, deterministically. err() if `options_csv` has no entries
// (split("", ",") yields a single empty entry, not zero entries, so the empty-string case is checked explicitly).
fn tp_one_of(state: dict, options_csv: string) -> Result
    if options_csv == ""
        return err("tp_one_of: no options provided")
    let opts = split(options_csv, ",")
    let n = len(opts)
    if n == 0
        return err("tp_one_of: no options provided")
    let idxr = tp_int_range(state, 0, n - 1)
    let idx = unwrap(idxr)
    ok(opts[idx])

// Record one property-check result: `passed` is 1 for pass, 0 for fail. On failure, `name` is appended to the
// comma-separated failed-names ledger. Updates the running pass/fail/total counters in `state`.
fn tp_check(state: dict, name: string, passed: int) -> int
    state["total"] = state["total"] + 1
    if passed == 1
        state["pass_count"] = state["pass_count"] + 1
    else
        state["fail_count"] = state["fail_count"] + 1
        if state["failed_names"] == ""
            state["failed_names"] = name
        else
            state["failed_names"] = state["failed_names"] + "," + name
    return 0

// Number of checks that passed so far.
fn tp_pass_count(state: dict) -> int
    state["pass_count"]

// Number of checks that failed so far.
fn tp_fail_count(state: dict) -> int
    state["fail_count"]

// Total number of checks recorded (pass + fail) so far.
fn tp_total_checks(state: dict) -> int
    state["total"]

// Pass rate as an integer percentage (0..100). err() if no checks have been recorded yet.
fn tp_pass_rate(state: dict) -> Result
    let total = state["total"]
    if total == 0
        return err("tp_pass_rate: no checks recorded")
    ok(state["pass_count"] * 100 / total)

// Comma-separated names of every failed check, in the order they failed ("" if none failed).
fn tp_failed_names(state: dict) -> string
    state["failed_names"]

// 1 if every recorded check passed (and at least one check ran), 0 otherwise.
fn tp_all_passed(state: dict) -> int
    if state["total"] == 0
        return 0
    if state["fail_count"] == 0
        return 1
    0
