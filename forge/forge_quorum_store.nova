// forge_quorum_store — Quorum-based read/write store.

fn qs_new(replicas: int, write_quorum: int, read_quorum: int) -> dict
    {"replicas": replicas, "write_q": write_quorum, "read_q": read_quorum, "data": {}, "versions": {}, "acks": {}, "writes": 0, "reads": 0}

fn qs_write(q: dict, key: string, value: string, ack_count: int) -> dict
    if ack_count >= q["write_q"]
        let v = (q["versions"][key] + 1) if key in q["versions"] else 1
        q["data"][key] = value
        q["versions"][key] = v
        q["writes"] += 1
        return {"ok": 1, "version": v, "q": q}
    {"ok": 0, "version": 0, "q": q}

fn qs_read(q: dict, key: string, ack_count: int) -> dict
    if ack_count < q["read_q"]
        return {"ok": 0, "value": "", "q": q}
    q["reads"] += 1
    if key not in q["data"]
        return {"ok": 0, "value": "", "q": q}
    {"ok": 1, "value": q["data"][key], "q": q}

fn qs_version(q: dict, key: string) -> int
    if key not in q["versions"]
        return 0
    q["versions"][key]

fn qs_total_writes(q: dict) -> int
    q["writes"]

fn qs_total_reads(q: dict) -> int
    q["reads"]

fn qs_is_strong_consistent(q: dict) -> int
    1 if q["write_q"] + q["read_q"] > q["replicas"] else 0
