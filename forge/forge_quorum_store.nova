// forge_quorum_store — Quorum-based read/write store.

fn qs_new(replicas: int, write_quorum: int, read_quorum: int) -> dict
    let q = {}
    q["replicas"] = replicas
    q["write_q"] = write_quorum
    q["read_q"] = read_quorum
    q["data"] = {}
    q["versions"] = {}
    q["acks"] = {}
    q["writes"] = 0
    q["reads"] = 0
    q

fn qs_write(q: dict, key: string, value: string, ack_count: int) -> dict
    let r = {}
    if ack_count >= q["write_q"]
        let has = contains(q["versions"], key)
        let v = 1
        if has == true
            v = q["versions"][key] + 1
        q["data"][key] = value
        q["versions"][key] = v
        q["writes"] = q["writes"] + 1
        r["ok"] = 1
        r["version"] = v
    else
        r["ok"] = 0
        r["version"] = 0
    r["q"] = q
    r

fn qs_read(q: dict, key: string, ack_count: int) -> dict
    let r = {}
    if ack_count < q["read_q"]
        r["ok"] = 0
        r["value"] = ""
        r["q"] = q
        return r
    q["reads"] = q["reads"] + 1
    let has = contains(q["data"], key)
    if has != true
        r["ok"] = 0
        r["value"] = ""
        r["q"] = q
        return r
    r["ok"] = 1
    r["value"] = q["data"][key]
    r["q"] = q
    r

fn qs_version(q: dict, key: string) -> int
    let has = contains(q["versions"], key)
    if has != true
        return 0
    q["versions"][key]

fn qs_total_writes(q: dict) -> int
    q["writes"]

fn qs_total_reads(q: dict) -> int
    q["reads"]

fn qs_is_strong_consistent(q: dict) -> int
    if q["write_q"] + q["read_q"] > q["replicas"]
        return 1
    0
