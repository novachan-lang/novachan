// forge_rollback_manager — version rollback tracking with Result API.

fn rm_new() -> dict
    let r = {}
    r["versions"] = {}
    r["current"] = ""
    r["version_count"] = 0
    r["rollback_count"] = 0
    r["deploy_count"] = 0
    r

fn rm_deploy(r: dict, version: string) -> dict
    r["deploy_count"] = r["deploy_count"] + 1
    let key = "v_" + str(r["deploy_count"])
    r["versions"][key] = version
    r["current"] = version
    r["version_count"] = r["version_count"] + 1
    r

fn rm_rollback(r: dict) -> Result
    if r["deploy_count"] <= 1
        return err("nothing to rollback to")
    let prev_key = "v_" + str(r["deploy_count"] - 1)
    if contains(r["versions"], prev_key) != true
        return err("previous version not found")
    r["current"] = r["versions"][prev_key]
    r["rollback_count"] = r["rollback_count"] + 1
    r["deploy_count"] = r["deploy_count"] - 1
    ok(r)

fn rm_current(r: dict) -> Result
    if r["current"] == ""
        return err("no deployments")
    ok(r["current"])

fn rm_version_at(r: dict, index: int) -> Result
    let key = "v_" + str(index)
    if contains(r["versions"], key) != true
        return err("version not found")
    ok(r["versions"][key])

fn rm_deploy_count(r: dict) -> int
    r["deploy_count"]

fn rm_rollback_count(r: dict) -> int
    r["rollback_count"]
