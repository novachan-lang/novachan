// forge_set -- a string SET (unique membership) with union / intersection / difference. For dedup, tag sets,
// permission sets, and "is X in the allowed set" checks. Backed by a dict (key -> 1). Since NOVA has no
// dict-delete, set_remove returns a NEW set without the element. LEAF -- imports NOTHING.

fn set_new() -> dict
    let s = {}
    s

fn set_add(s: dict, v: string) -> dict
    s[v] = 1
    s

fn set_has(s: dict, v: string) -> bool
    contains(s, v)

// Return a NEW set with `v` removed (dicts have no in-place delete).
fn set_remove(s: dict, v: string) -> dict
    let out = set_new()
    let ks = keys(s)
    for i in 0..len(ks)
        if ks[i] != v
            out[ks[i]] = 1
    out

fn set_size(s: dict) -> int
    len(keys(s))

fn set_to_list(s: dict) -> list
    keys(s)

// Build a set from a list (dedups).
fn set_of(values: list) -> dict
    let s = set_new()
    for i in 0..len(values)
        s[values[i]] = 1
    s

fn set_union(a: dict, b: dict) -> dict
    let out = set_new()
    let ka = keys(a)
    for i in 0..len(ka)
        out[ka[i]] = 1
    let kb = keys(b)
    for j in 0..len(kb)
        out[kb[j]] = 1
    out

fn set_intersect(a: dict, b: dict) -> dict
    let out = set_new()
    let ka = keys(a)
    for i in 0..len(ka)
        if ka[i] in b
            out[ka[i]] = 1
    out

fn set_diff(a: dict, b: dict) -> dict
    let out = set_new()
    let ka = keys(a)
    for i in 0..len(ka)
        if ka[i] in b == false
            out[ka[i]] = 1
    out
