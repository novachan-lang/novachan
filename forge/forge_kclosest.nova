// forge_kclosest -- select the k points nearest to a reference point, ranked by distance. Where forge_kdtree finds
// the SINGLE nearest neighbour with a prebuilt index, this answers the batch "give me the closest k" over a plain
// list -- the shape behind "N nearest stores/drivers/friends", k-nearest-neighbour classifiers picking their k
// voters, spatial recommendations, and showing the closest few results on a map. To stay exact and float-free it
// ranks by SQUARED distance (comparing d^2 avoids square roots and never rounds), and it sorts an index array
// rather than the point pairs so the coordinate lists are never corrupted by the sort. It returns the k closest
// points in increasing distance order; ties keep their original relative order. Points are [x, y] integer pairs.
// LEAF -- imports NOTHING.

// PRIVATE: squared distance between [x,y] point p and (tx, ty).
fn _kc_d2(p: list, tx: int, ty: int) -> int
    let dx = p[0] - tx
    let dy = p[1] - ty
    dx * dx + dy * dy

// The k points of `points` closest to (tx, ty), in increasing distance order (fewer if k > count).
fn k_closest_to(points: list, tx: int, ty: int, k: int) -> list
    let n = len(points)
    // index array sorted by squared distance (stable insertion sort keeps ties in order)
    let idx = [i for i in 0..n]
    for a in 1..n
        let key = idx[a]
        let kd = _kc_d2(points[key], tx, ty)
        let b = a - 1
        while b >= 0 and _kc_d2(points[idx[b]], tx, ty) > kd
            idx[b + 1] = idx[b]
            b -= 1
        idx[b + 1] = key
    let out = [points[idx[m]] for m in 0..(k and m < n)]
    out

// The k points closest to the ORIGIN (0,0), in increasing distance order.
fn k_closest_points(points: list, k: int) -> list
    k_closest_to(points, 0, 0, k)
