// forge_histogram — histogram/distribution tracking with Result API.

fn hist_new(bucket_size: int) -> dict
    let h = {}
    h["bucket_size"] = bucket_size
    h["buckets"] = {}
    h["total"] = 0
    h["min_val"] = 999999999
    h["max_val"] = -999999999
    h["sum"] = 0
    h

fn hist_record(h: dict, value: int) -> dict
    let bucket = value / h["bucket_size"]
    let bk = "b_" + str(bucket)
    let has = contains(h["buckets"], bk)
    if has == true
        h["buckets"][bk] = h["buckets"][bk] + 1
    else
        h["buckets"][bk] = 1
    h["total"] = h["total"] + 1
    h["sum"] = h["sum"] + value
    if value < h["min_val"]
        h["min_val"] = value
    if value > h["max_val"]
        h["max_val"] = value
    h

fn hist_count(h: dict) -> int
    h["total"]

fn hist_mean(h: dict) -> int
    if h["total"] == 0
        return 0
    h["sum"] / h["total"]

fn hist_min(h: dict) -> Result
    if h["total"] == 0
        return err("no data")
    ok(h["min_val"])

fn hist_max(h: dict) -> Result
    if h["total"] == 0
        return err("no data")
    ok(h["max_val"])

fn hist_bucket_count(h: dict, bucket: int) -> int
    let bk = "b_" + str(bucket)
    let has = contains(h["buckets"], bk)
    if has == true
        return h["buckets"][bk]
    0

// ── Static binning over a fixed dataset ─────────────────────────────────────
// The hist_* API above is a STREAMING recorder (record values one at a time into
// open-ended buckets of a fixed width). These histo_* functions are the other,
// equally common shape: bin an ENTIRE dataset into exactly N bins spanning a
// range. Different problem, so a separate API rather than overloading hist_*.
//
// Binning is half-open [edge_i, edge_i+1) with the TOP bin closed, so `hi`
// itself lands in the last bin instead of falling off the end -- the standard
// convention (numpy.histogram, matplotlib). Values outside [lo,hi] clamp into
// the end bins rather than being dropped or erroring.

// Bin index for `v` within `nbins` bins spanning [lo,hi]. Always in range.
fn histo_bin(v: int, lo: int, hi: int, nbins: int) -> int
    let r = 0
    if nbins <= 1
        r = 0
    else if hi <= lo
        // degenerate range (all values identical) -- everything is bin 0 rather
        // than a division by zero.
        r = 0
    else if v <= lo
        r = 0
    else if v >= hi
        r = nbins - 1
    else
        // integer math on purpose: (v-lo) and (hi-lo) are both > 0 here, so this
        // truncates toward zero with no negative-division ambiguity.
        r = (v - lo) * nbins / (hi - lo)
        if r > nbins - 1
            r = nbins - 1
    return r

// The nbins+1 bin boundaries spanning [lo,hi], inclusive of both ends.
fn histo_edges(lo: int, hi: int, nbins: int) -> list
    if nbins <= 0
        return []
    return [lo + (hi - lo) * i / nbins for i in 0..(nbins + 1)]

// Counts per bin for `data` over an EXPLICIT range [lo,hi].
fn histo_range(data: list, lo: int, hi: int, nbins: int) -> list
    if nbins <= 0
        return []
    let counts = [0 for i in 0..nbins]
    for v in data
        let b = histo_bin(v, lo, hi, nbins)
        counts[b] = counts[b] + 1
    return counts

// Counts per bin for `data` over its OWN min..max range.
// Returns [counts, min, max]. Empty data -> [[], 0, 0].
fn histo_of(data: list, nbins: int) -> list
    let out = []
    if len(data) == 0
        push(out, [])
        push(out, 0)
        push(out, 0)
        return out
    let lo = data[0]
    let hi = data[0]
    for v in data
        if v < lo
            lo = v
        if v > hi
            hi = v
    push(out, histo_range(data, lo, hi, nbins))
    push(out, lo)
    push(out, hi)
    return out

// `histogram` is the name callers reach for first; keep it as the primary
// spelling with histo_of as the explicit alias.
fn histogram(data: list, nbins: int) -> list
    return histo_of(data, nbins)
