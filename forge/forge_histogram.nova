// forge_histogram -- bin numeric data into equal-width buckets and count how many values fall in each: a
// histogram. Where frequency/mode (forge_mode) count how often each EXACT value occurs, a histogram groups a
// CONTINUOUS range into bins ("how many measurements landed between 0 and 10, 10 and 20, ...") -- the fundamental
// way to see the SHAPE of a distribution: where the data clusters, whether it's skewed, where the outliers sit.
// It's behind every distribution chart, image tone/exposure histogram, latency bucket (the kind Prometheus
// exports), and quick data sanity check. Given values and a bin count it finds the data range, splits it into that
// many equal buckets, and tallies each; you can also fix the range explicitly (to compare datasets on the same
// axis) or ask which bin a single value lands in. Integer values; the last bucket is inclusive of the maximum.
// LEAF -- imports NOTHING.

// The bin index (0..bins-1) that value v falls into for the range [lo, hi] split into `bins` equal buckets. Values
// at or above hi go in the last bin; below lo go in bin 0.
fn histo_bin(v: int, lo: int, hi: int, bins: int) -> int
    let out = 0
    if hi > lo and bins > 0
        let idx = (v - lo) * bins / (hi - lo)
        if idx < 0
            idx = 0
        if idx >= bins
            idx = bins - 1
        out = idx
    out

// Tally `data` into `bins` buckets spanning the explicit range [lo, hi]. Returns a list of bins counts.
fn histo_range(data: list, lo: int, hi: int, bins: int) -> list
    let counts = []
    let z = 0
    while z < bins
        push(counts, 0)
        z = z + 1
    let i = 0
    while i < len(data)
        let b = histo_bin(data[i], lo, hi, bins)
        counts[b] = counts[b] + 1
        i = i + 1
    counts

// Tally `data` into `bins` buckets over its own [min, max] range. Returns [counts, min, max].
fn histogram(data: list, bins: int) -> list
    let out = [[], 0, 0]
    if len(data) > 0
        let lo = data[0]
        let hi = data[0]
        let i = 1
        while i < len(data)
            if data[i] < lo
                lo = data[i]
            if data[i] > hi
                hi = data[i]
            i = i + 1
        out = [histo_range(data, lo, hi, bins), lo, hi]
    out

// The bin boundary values for the range [lo, hi] and `bins` buckets: a list of bins+1 edges.
fn histo_edges(lo: int, hi: int, bins: int) -> list
    let edges = []
    let i = 0
    while i <= bins
        push(edges, lo + (hi - lo) * i / bins)
        i = i + 1
    edges
