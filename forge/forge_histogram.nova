// forge_histogram — histogram/distribution tracking with Result API.

fn hist_new(bucket_size: int) -> dict
    let h = {}
    h["bucket_size"] = bucket_size
    h["buckets"] = {}
    h["total"] = 0
    h["min_val"] = 999999999
    h["max_val"] = -999999999
    h["sum"] = 0
    h

fn hist_record(h: dict, value: int) -> dict
    let bucket = value / h["bucket_size"]
    let bk = "b_" + str(bucket)
    let has = contains(h["buckets"], bk)
    if has == true
        h["buckets"][bk] = h["buckets"][bk] + 1
    else
        h["buckets"][bk] = 1
    h["total"] = h["total"] + 1
    h["sum"] = h["sum"] + value
    if value < h["min_val"]
        h["min_val"] = value
    if value > h["max_val"]
        h["max_val"] = value
    h

fn hist_count(h: dict) -> int
    h["total"]

fn hist_mean(h: dict) -> int
    if h["total"] == 0
        return 0
    h["sum"] / h["total"]

fn hist_min(h: dict) -> Result
    if h["total"] == 0
        return err("no data")
    ok(h["min_val"])

fn hist_max(h: dict) -> Result
    if h["total"] == 0
        return err("no data")
    ok(h["max_val"])

fn hist_bucket_count(h: dict, bucket: int) -> int
    let bk = "b_" + str(bucket)
    let has = contains(h["buckets"], bk)
    if has == true
        return h["buckets"][bk]
    0
