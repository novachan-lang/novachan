// forge_structured_log — Structured logging with levels and fields.

fn slog_new() -> dict
    let s = {}
    s["entries"] = {}
    s["count"] = 0
    s["min_level"] = 0
    s

fn slog_set_level(s: dict, level: int) -> dict
    s["min_level"] = level
    s

fn slog_log(s: dict, level: int, message: string, field_key: string, field_val: string) -> dict
    if level < s["min_level"]
        return s
    let idx = s["count"]
    let k = str(idx)
    s["entries"][k + "_level"] = level
    s["entries"][k + "_msg"] = message
    s["entries"][k + "_fk"] = field_key
    s["entries"][k + "_fv"] = field_val
    s["count"] = idx + 1
    s

fn slog_debug(s: dict, msg: string, fk: string, fv: string) -> dict
    slog_log(s, 0, msg, fk, fv)

fn slog_info(s: dict, msg: string, fk: string, fv: string) -> dict
    slog_log(s, 1, msg, fk, fv)

fn slog_warn(s: dict, msg: string, fk: string, fv: string) -> dict
    slog_log(s, 2, msg, fk, fv)

fn slog_error(s: dict, msg: string, fk: string, fv: string) -> dict
    slog_log(s, 3, msg, fk, fv)

fn slog_entry_count(s: dict) -> int
    s["count"]

fn slog_entry_msg(s: dict, index: int) -> string
    if index < 0
        return ""
    if index >= s["count"]
        return ""
    s["entries"][str(index) + "_msg"]

fn slog_entry_level(s: dict, index: int) -> int
    if index < 0
        return -1
    if index >= s["count"]
        return -1
    s["entries"][str(index) + "_level"]
