// forge_polygon -- thin wrapper over std/geometry/polygon (canonical implementation).
import std/geometry/polygon

fn point_in_polygon(px: float, py: float, poly: list) -> bool
    let n = len(poly)
    if n < 3
        return false
    let inside = false
    let j = n - 1
    for i in 0..n
        let xi = poly[i][0] * 1.0
        let yi = poly[i][1] * 1.0
        let xj = poly[j][0] * 1.0
        let yj = poly[j][1] * 1.0
        // does edge (i,j) straddle the horizontal line y = py, and is the crossing to the right of px?
        if (yi > py) != (yj > py)
            let xcross = (xj - xi) * (py - yi) / (yj - yi) + xi
            if px < xcross
                inside = not inside
        j = i
    inside

// Polygon area via the shoelace formula (absolute value, so vertex winding order doesn't matter). 0.0 for a
// degenerate polygon (< 3 vertices). In planar units of the coordinates squared.

fn polygon_area(poly: list) -> float
    return pg_area(poly)

