// forge_polygon -- 2D polygon geometry: is a point inside an arbitrary polygon (ray-casting / even-odd rule),
// and the polygon's area (shoelace formula). This is the geofencing primitive forge_geo lacks: geo_within only
// answers "within radius R of a center" (a circle), whereas real regions -- a delivery zone, a country border,
// a no-fly area -- are polygons. Coordinates are floats ([x, y] or [lon, lat]) and the polygon is a list of
// [x, y] vertex pairs in order (the ring is closed implicitly; do not repeat the first vertex). LEAF.

// Is point (px, py) inside the polygon? Ray-casting: shoot a horizontal ray and count edge crossings -- odd =
// inside. Robust for convex AND concave polygons. Points exactly on an edge are boundary cases (may return
// either) -- fine for geofencing where a fuzz margin is used anyway.
fn point_in_polygon(px: float, py: float, poly: list) -> bool
    let n = len(poly)
    if n < 3
        return false
    let inside = false
    let j = n - 1
    for i in 0..n
        let xi = poly[i][0] * 1.0
        let yi = poly[i][1] * 1.0
        let xj = poly[j][0] * 1.0
        let yj = poly[j][1] * 1.0
        // does edge (i,j) straddle the horizontal line y = py, and is the crossing to the right of px?
        if (yi > py) != (yj > py)
            let xcross = (xj - xi) * (py - yi) / (yj - yi) + xi
            if px < xcross
                inside = not inside
        j = i
    inside

// Polygon area via the shoelace formula (absolute value, so vertex winding order doesn't matter). 0.0 for a
// degenerate polygon (< 3 vertices). In planar units of the coordinates squared.
fn polygon_area(poly: list) -> float
    let n = len(poly)
    if n < 3
        return 0.0
    let acc = 0.0
    for i in 0..n
        let nx = i + 1
        if nx == n
            nx = 0
        acc += poly[i][0] * 1.0 * poly[nx][1] - poly[nx][0] * 1.0 * poly[i][1]
    let a = acc / 2.0
    if a < 0.0
        a = 0.0 - a
    a
