// forge_circuit -- a CIRCUIT BREAKER + registry (Resilience4j / Netflix Hystrix / Spring Cloud). Wraps calls
// to a flaky dependency so that after N consecutive failures the breaker OPENS and rejects calls fast (no
// piling up on a dead service); after a cooldown it goes HALF_OPEN to let ONE trial through, and a success
// CLOSES it again. This is the resilience primitive FORGE_FEATURE_AUDIT flagged missing for the "distributed
// depth" tier. States: "closed" (healthy), "open" (tripped, reject fast), "half_open" (one trial in flight).
//
// A breaker is a plain dict (mutated in place -- NOVA dicts are reference values). LEAF -- imports NOTHING.

fn cb_new(threshold: int, reset_ms: int) -> dict
    {"state": "closed", "failures": 0, "threshold": threshold, "reset_ms": reset_ms, "opened_at": 0}

// Should a call be allowed through NOW? closed -> yes. open -> yes only once reset_ms has elapsed since it
// opened (and it transitions to half_open to admit that one trial). half_open -> yes (trial in flight).
fn cb_allow(cb: dict, now_ms: int) -> bool
    let st = cb["state"]
    if st == "open"
        if now_ms - cb["opened_at"] >= cb["reset_ms"]
            cb["state"] = "half_open"
            return true
        return false
    true

// Record a success: collapses any state back to a healthy CLOSED breaker with a clean failure count.
fn cb_success(cb: dict) -> dict
    cb["state"] = "closed"
    cb["failures"] = 0
    cb

// Record a failure. In half_open a single failure re-OPENS immediately (the dependency is still sick). In
// closed, increment the run; at the threshold, OPEN and stamp opened_at for the cooldown clock.
fn cb_failure(cb: dict, now_ms: int) -> dict
    let st = cb["state"]
    if st == "half_open"
        cb["state"] = "open"
        cb["opened_at"] = now_ms
        return cb
    cb["failures"] += 1
    if cb["failures"] >= cb["threshold"]
        cb["state"] = "open"
        cb["opened_at"] = now_ms
    cb

fn cb_state(cb: dict) -> string
    cb["state"]

// ---- Registry: many named breakers behind one dict (one breaker per downstream dependency). ----

fn cb_registry() -> dict
    {}

// Get-or-create the breaker named `name` (created with threshold/reset_ms on first use). Same instance
// returned every time so its state persists across calls.
fn cb_get(reg: dict, name: string, threshold: int, reset_ms: int) -> dict
    if name not in reg
        reg[name] = cb_new(threshold, reset_ms)
    reg[name]
