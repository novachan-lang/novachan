// forge_live -- LiveView diff core (S5, the crown jewel). Phoenix's LiveView insight: a rendered view
// splits into STATIC parts (constant across renders -- the surrounding markup) and DYNAMIC parts (the
// slots that change with state). The statics are sent ONCE; every later update on the wire is ONLY the
// dynamics that actually changed -- a handful of bytes, not a re-render. That is what makes server-driven
// UI feel instant without shipping a client framework.
//
// This module is the PURE diff core (statics/dynamics model + diff + apply) -- no sockets, no spawn, so
// it is exhaustively testable in isolation. The per-connection live process (a spawned loop holding
// state, re-rendering on each event and pushing the patch over the existing Forge WebSocket) builds on
// top of this, as does the template helper that splits a markup string into statics/dynamics.
//
// Invariant: a rendered view has len(statics) == len(dynamics) + 1, so the full document interleaves
//   s0 + d0 + s1 + d1 + ... + d(n-1) + s(n)
// Dynamics are scalars (strings/numbers) in v1; equality is by rendered form (str()), which is exactly
// what the client cares about. A nested-fragment dynamic (a sub-view) is a later extension.

// Assemble the full document from statics + dynamics (the first render, or a server-side check).
fn live_html(statics, dynamics) -> string
    let out = ""
    let i = 0
    while i < len(dynamics)
        out = out + statics[i] + str(dynamics[i])
        i = i + 1
    out + statics[len(statics) - 1]

// Diff two dynamics lists -> a patch {changed:[{i, val}]} carrying ONLY the slots whose rendered value
// changed. Statics never travel after the first render. Same template -> same slot count, so the lists
// are the same length; a defensive bound on old_dyn handles a first-ever diff against an empty list.
fn live_diff(old_dyn, new_dyn) -> any
    let changed = []
    let i = 0
    while i < len(new_dyn)
        let same = false
        if i < len(old_dyn)
            if str(old_dyn[i]) == str(new_dyn[i])
                same = true
        if same == false
            let c = {}
            c["i"] = i
            c["val"] = new_dyn[i]
            push(changed, c)
        i = i + 1
    let patch = {}
    patch["changed"] = changed
    patch

// Apply a patch to an old dynamics list -> the new dynamics (what the client does on receipt). Returns a
// fresh list (no mutation of the input); only the patched indices differ.
fn live_apply(old_dyn, patch) -> any
    let out = []
    let i = 0
    while i < len(old_dyn)
        push(out, old_dyn[i])
        i = i + 1
    let changed = patch["changed"]
    let j = 0
    while j < len(changed)
        let c = changed[j]
        out[c["i"]] = c["val"]
        j = j + 1
    out

// Number of slots in a patch (the wire-size proxy -- 0 means "nothing to send").
fn patch_size(patch) -> int
    len(patch["changed"])

// ── Per-connection live process (the LiveView server) ─────────────────────────────────────────────
// A live view is a single-owner ACTOR: a spawned loop that holds the connection's state and the last
// rendered dynamics. On each inbound event it computes the next state (update_fn), re-renders the
// dynamics (view_fn), diffs against the previous render, and pushes ONLY the patch on its out-channel
// (which the WebSocket writer drains to the client). State lives in exactly one process -> no locks, no
// races, N>1-safe by construction -- the same shape as a GenServer.
//
// CONTRACTS:
//   view_fn(state)        -> dynamics list (the slots; statics are constant and live with the caller)
//   update_fn(state, ev)  -> the NEXT state. It MUST return a FRESH value (e.g. build a new dict); the
//                            handed-in state was deep-copied across the spawn boundary, so mutating it
//                            in place + re-adding keys hits the deep-copied-dict hazard. Returning fresh
//                            state (born inside this loop) sidesteps it entirely.
// The initial full render (statics + view_fn(initial_state)) is the caller's job, sent once at connect;
// this process streams only the deltas. A no-op event (state renders identically) sends NOTHING.
fn _live_loop(view_fn, update_fn, initial_state, in_ch, out_ch)
    let state = initial_state
    let prev_dyn = view_fn(state)
    let running = 1
    while running == 1
        let ev = receive(in_ch)
        let new_state = update_fn(state, ev)
        let new_dyn = view_fn(new_state)
        let patch = live_diff(prev_dyn, new_dyn)
        if patch_size(patch) > 0
            send(out_ch, patch)
        prev_dyn = new_dyn
        state = new_state

// Spawn a live view actor. Returns a handle {in, out}: send events on `in`, drain patches from `out`.
// view_fn/update_fn are passed straight to the spawned loop (the same way a GenServer hands its handler
// to its loop); the channels are shared across the spawn boundary, so the handle wires both directions.
fn live_view(view_fn, update_fn, initial_state) -> any
    let lv = {}
    lv["in"] = channel()
    lv["out"] = channel()
    spawn _live_loop(view_fn, update_fn, initial_state, lv["in"], lv["out"])
    lv

// Send an event into the live view (drives one state transition).
fn live_send(lv, ev) -> int
    send(lv["in"], ev)
    0

// Receive the next patch the live view emits (the WS writer / a test calls this).
fn live_recv(lv) -> any
    receive(lv["out"])

// ── Patch wire format ─────────────────────────────────────────────────────────────────────────────
// Serialize a patch to the COMPACT JSON the client receives over the WebSocket:
//   {"c":[{"i":0,"v":"1"},{"i":1,"v":"hello"}]}
// "c" = changed slots; each is {i: slot index, v: rendered string}. Values are stringified (the client
// substitutes text by index) and JSON-escaped so a value containing a quote or backslash cannot break
// the message framing. Braces/quotes are built via chr() -- a literal '{' interpolates in a NOVA string.
fn _json_escape(s: string) -> string
    let bs = chr(92)
    let q = chr(34)
    let out = ""
    let i = 0
    while i < len(s)
        let ch = char_at(s, i)
        if ch == bs
            out = out + bs + bs
        else if ch == q
            out = out + bs + q
        else
            out = out + ch
        i = i + 1
    out

fn patch_json(patch) -> string
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let changed = patch["changed"]
    let body = lb + q + "c" + q + ":["
    let i = 0
    while i < len(changed)
        let c = changed[i]
        if i > 0
            body = body + ","
        body = body + lb + q + "i" + q + ":" + str(c["i"]) + "," + q + "v" + q + ":" + q + _json_escape(str(c["val"])) + q + rb
        i = i + 1
    body + "]" + rb

// The MOUNT frame: the first message a client receives on connect. It carries the STATICS (sent exactly
// once) plus the initial DYNAMICS, so the client renders the full document and then applies every later
// patch frame by slot index:
//   {"s":["<p>n=","</p>"],"d":["0"]}
// Both lists are JSON-escaped; dynamics are stringified (text substitution by index, same as patches).
// Together with patch_json this is the complete LiveView wire protocol -- mount once, then deltas.
fn live_mount_json(statics, dynamics) -> string
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let body = lb + q + "s" + q + ":["
    let i = 0
    while i < len(statics)
        if i > 0
            body = body + ","
        body = body + q + _json_escape(statics[i]) + q
        i = i + 1
    body = body + "]," + q + "d" + q + ":["
    let j = 0
    while j < len(dynamics)
        if j > 0
            body = body + ","
        body = body + q + _json_escape(str(dynamics[j])) + q
        j = j + 1
    body + "]" + rb

// ── Per-connection driver (the transport-agnostic LiveView connection) ────────────────────────────
// live_conn is the loop the WS runner SPAWNS once per connection. Spawning it is what makes LiveView
// correct: the connection's state lives in THIS process, not in the reader's per-message arena (which is
// freed at each arena_exit -> reading prior-render state from it would be a use-after-free). So state +
// last-rendered dynamics persist here for the connection's lifetime.
//
// It emits STRING wire frames on `out` (transport-agnostic -- the WS runner wraps each as a text frame
// for the single socket writer; a test reads them directly): the MOUNT frame first (statics once +
// initial dynamics), then one patch frame per state-changing event (no-ops emit nothing). Client events
// arrive as strings on `events`; update_fn(state, ev) returns the next (fresh) state. "__stop__" ends it.
fn live_conn(statics, view_fn, update_fn, initial_state, events, out) -> int
    let dyn0 = view_fn(initial_state)
    send(out, live_mount_json(statics, dyn0))
    let state = initial_state
    let prev_dyn = dyn0
    let running = 1
    while running == 1
        let ev = receive(events)
        if ev == "__stop__"
            running = 0
        else
            let new_state = update_fn(state, ev)
            let new_dyn = view_fn(new_state)
            let patch = live_diff(prev_dyn, new_dyn)
            if patch_size(patch) > 0
                send(out, patch_json(patch))
            prev_dyn = new_dyn
            state = new_state
    0

// ── Client runtime + template helpers ─────────────────────────────────────────────────────────────
// live_client_js() returns the tiny browser client (serve it as a static asset, then include it). It
// opens a WebSocket to /live, renders the mount frame {s,d} into #live-root, applies each {c:[{i,v}]}
// patch by slot index, and exposes window.liveSend(ev) for client events. Authored with single quotes
// (so no double-quote escaping) and @/# placeholders for { } (a literal { interpolates in a NOVA string),
// materialized via replace -> the returned string is real, valid JS.
fn live_client_js() -> string
    let tpl = "(function()@var statics=[],dyn=[];function render()@var el=document.getElementById('live-root');if(!el)return;var out='';for(var i=0;i<dyn.length;i++)@out+=statics[i]+dyn[i];#out+=statics[statics.length-1];el.innerHTML=out;#var ws=new WebSocket((location.protocol==='https:'?'wss://':'ws://')+location.host+'/live');ws.onmessage=function(e)@var m=JSON.parse(e.data);if(m.s)@statics=m.s;dyn=m.d;render();#else if(m.c)@for(var i=0;i<m.c.length;i++)@dyn[m.c[i].i]=m.c[i].v;#render();##;window.liveSend=function(ev)@ws.send(ev);#;#)();"
    let withopen = replace(tpl, "@", chr(123))
    replace(withopen, "#", chr(125))

// Split a template's markup into the statics list on a caller-chosen marker (where dynamics go). The
// marker must be a non-brace token (e.g. "@@") since a literal { interpolates in NOVA strings. The
// dynamics are produced separately by the view_fn; len(statics) == len(dynamics)+1 must hold.
fn live_statics(markup: string, marker: string) -> any
    split(markup, marker)
