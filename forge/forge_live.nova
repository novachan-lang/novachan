// forge_live -- LiveView diff core (S5, the crown jewel). Phoenix's LiveView insight: a rendered view
// splits into STATIC parts (constant across renders -- the surrounding markup) and DYNAMIC parts (the
// slots that change with state). The statics are sent ONCE; every later update on the wire is ONLY the
// dynamics that actually changed -- a handful of bytes, not a re-render. That is what makes server-driven
// UI feel instant without shipping a client framework.
//
// This module is the PURE diff core (statics/dynamics model + diff + apply) -- no sockets, no spawn, so
// it is exhaustively testable in isolation. The per-connection live process (a spawned loop holding
// state, re-rendering on each event and pushing the patch over the existing Forge WebSocket) builds on
// top of this, as does the template helper that splits a markup string into statics/dynamics.
//
// Invariant: a rendered view has len(statics) == len(dynamics) + 1, so the full document interleaves
//   s0 + d0 + s1 + d1 + ... + d(n-1) + s(n)
// Dynamics are scalars (strings/numbers) in v1; equality is by rendered form (str()), which is exactly
// what the client cares about. A nested-fragment dynamic (a sub-view) is a later extension.

// Assemble the full document from statics + dynamics (the first render, or a server-side check).
fn live_html(statics, dynamics) -> string
    let out = ""
    let i = 0
    while i < len(dynamics)
        out = out + statics[i] + str(dynamics[i])
        i = i + 1
    out + statics[len(statics) - 1]

// Diff two dynamics lists -> a patch {changed:[{i, val}]} carrying ONLY the slots whose rendered value
// changed. Statics never travel after the first render. Same template -> same slot count, so the lists
// are the same length; a defensive bound on old_dyn handles a first-ever diff against an empty list.
fn live_diff(old_dyn, new_dyn) -> any
    let changed = []
    let i = 0
    while i < len(new_dyn)
        let same = false
        if i < len(old_dyn)
            if str(old_dyn[i]) == str(new_dyn[i])
                same = true
        if same == false
            let c = {}
            c["i"] = i
            c["val"] = new_dyn[i]
            push(changed, c)
        i = i + 1
    let patch = {}
    patch["changed"] = changed
    patch

// Apply a patch to an old dynamics list -> the new dynamics (what the client does on receipt). Returns a
// fresh list (no mutation of the input); only the patched indices differ.
fn live_apply(old_dyn, patch) -> any
    let out = []
    let i = 0
    while i < len(old_dyn)
        push(out, old_dyn[i])
        i = i + 1
    let changed = patch["changed"]
    let j = 0
    while j < len(changed)
        let c = changed[j]
        out[c["i"]] = c["val"]
        j = j + 1
    out

// Number of slots in a patch (the wire-size proxy -- 0 means "nothing to send").
fn patch_size(patch) -> int
    len(patch["changed"])
