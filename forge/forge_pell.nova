// forge_pell -- solve Pell's equation x*x - D*y*y = 1 in positive integers, one of the oldest problems in number
// theory (studied by Brahmagupta and Bhaskara centuries before Pell). For any D that is NOT a perfect square it has
// infinitely many integer solutions, and finding the smallest (the "fundamental" solution) is the key: every other
// solution is generated from it by a simple recurrence. Pell solutions give the best rational approximations
// p/q to sqrt(D) (x/y hugs sqrt(D) extraordinarily tightly), underlie square-triangular numbers and other figurate
// coincidences, appear in continued-fraction theory, and are the engine behind several integer-factoring and
// Diophantine-approximation methods. The fundamental solution is read off the periodic continued-fraction expansion
// of sqrt(D): iterate its convergents h/k and stop at the first with h*h - D*k*k = 1. Integers only, and Pell
// solutions grow FAST -- this stays exact only while x*x fits in signed 64-bit (fine for D up to ~61 and many
// beyond, but D like 109 or 151 overflow). Pairs with forge_contfrac. LEAF -- imports NOTHING.

// PRIVATE: integer square root (floor) of a non-negative integer.
fn _pl_isqrt(n: int) -> int
    let r = 0
    while (r + 1) * (r + 1) <= n
        r += 1
    r

// True if x and y solve Pell's equation for D: x*x - D*y*y == 1.
fn pell_check(d: int, x: int, y: int) -> bool
    x * x - d * y * y == 1

// The fundamental (smallest positive) solution [x, y] of x*x - D*y*y = 1, found from the continued-fraction
// expansion of sqrt(D). Returns an empty list if D is a perfect square or D <= 0 (no nontrivial solution exists).
fn pell_fundamental(d: int) -> list
    let out = []
    if d > 0
        let a0 = _pl_isqrt(d)
        if a0 * a0 != d
            // continued fraction of sqrt(d): m,dd,a recurrence; track convergents h/k
            let m = 0
            let dd = 1
            let a = a0
            let h_prev = 1
            let h = a0
            let k_prev = 0
            let k = 1
            let found = false
            let guard = 0
            while found == false and guard < 100000
                if h * h - d * k * k == 1
                    out = [h, k]
                    found = true
                else
                    m = dd * a - m
                    dd = (d - m * m) / dd
                    a = (a0 + m) / dd
                    let h_new = a * h + h_prev
                    let k_new = a * k + k_prev
                    h_prev = h
                    h = h_new
                    k_prev = k
                    k = k_new
                guard += 1
    out

// The first `count` positive solutions of Pell's equation for D, as a flat list [x1,y1, x2,y2, ...], generated from
// the fundamental solution by the recurrence (x_{n+1}, y_{n+1}) = (x1*x_n + D*y1*y_n, x1*y_n + y1*x_n). Returns an
// empty list if D is a perfect square. Values grow exponentially -- keep count small so they stay within 64-bit.
fn pell_solutions(d: int, count: int) -> list
    let out = []
    let base = pell_fundamental(d)
    if len(base) == 2 and count > 0
        let x1 = base[0]
        let y1 = base[1]
        let xn = x1
        let yn = y1
        push(out, xn)
        push(out, yn)
        for i in 1..count
            let xnext = x1 * xn + d * y1 * yn
            let ynext = x1 * yn + y1 * xn
            xn = xnext
            yn = ynext
            push(out, xn)
            push(out, yn)
    out
