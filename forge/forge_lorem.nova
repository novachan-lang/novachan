// forge_lorem -- deterministic Lorem Ipsum placeholder-text generator for UI mockups, layout testing, and
// seeding demo data. Deterministic (cycles the classic word pool) so tests and snapshots are stable. Provides
// word / sentence / paragraph generators. LEAF -- imports NOTHING.

// PRIVATE: the classic Lorem Ipsum word pool.
fn _lorem_pool() -> list
    ["lorem", "ipsum", "dolor", "sit", "amet", "consectetur", "adipiscing", "elit", "sed", "do", "eiusmod", "tempor", "incididunt", "ut", "labore", "et", "dolore", "magna", "aliqua", "enim", "ad", "minim", "veniam", "quis", "nostrud", "exercitation", "ullamco", "laboris", "nisi", "aliquip", "ex", "ea", "commodo", "consequat", "duis", "aute", "irure", "in", "reprehenderit", "voluptate", "velit", "esse", "cillum", "fugiat", "nulla", "pariatur"]

// `n` lorem words joined by spaces (cycling the pool). "" for n<=0.
fn lorem_words(n: int) -> string
    if n <= 0
        return ""
    let pool = _lorem_pool()
    let out = ""
    for i in 0..n
        if i > 0
            out += " "
        out += pool[i % len(pool)]
    out

// PRIVATE: capitalize the first character of a word.
fn _lorem_cap(w: string) -> string
    if len(w) == 0
        return w
    upper(slice(w, 0, 1)) + slice(w, 1, len(w))

// A sentence of `word_count` words: first word capitalized, trailing period.
fn lorem_sentence(word_count: int) -> string
    let n = word_count
    if n <= 0
        n = 8
    let words = lorem_words(n)
    _lorem_cap(words) + "."

// A paragraph of `sentence_count` sentences (each ~8 words), space-separated.
fn lorem_paragraph(sentence_count: int) -> string
    let out_parts = []
    for i in 0..sentence_count
        if i > 0
            push(out_parts, " ")
        push(out_parts, lorem_sentence(8))
    let out = join(out_parts, "")
    out
