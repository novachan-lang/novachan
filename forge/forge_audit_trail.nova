// forge_audit_trail — Immutable audit trail.
// Append-only log of actions with actor, resource, timestamp.

fn at_new() -> dict
    let at = {}
    at["entries"] = []
    at

fn at_log(at: dict, actor: string, action: string, resource: string, timestamp: int) -> dict
    let entry = {}
    entry["actor"] = actor
    entry["action"] = action
    entry["resource"] = resource
    entry["timestamp"] = timestamp
    push(at["entries"], entry)
    at

fn at_count(at: dict) -> int
    len(at["entries"])

fn at_by_actor(at: dict, actor: string) -> list
    let result = []
    let i = 0
    while i < len(at["entries"])
        if at["entries"][i]["actor"] == actor
            push(result, at["entries"][i])
        i = i + 1
    result

fn at_by_resource(at: dict, resource: string) -> list
    let result = []
    let i = 0
    while i < len(at["entries"])
        if at["entries"][i]["resource"] == resource
            push(result, at["entries"][i])
        i = i + 1
    result

fn at_by_action(at: dict, action: string) -> list
    let result = []
    let i = 0
    while i < len(at["entries"])
        if at["entries"][i]["action"] == action
            push(result, at["entries"][i])
        i = i + 1
    result

fn at_since(at: dict, timestamp: int) -> list
    let result = []
    let i = 0
    while i < len(at["entries"])
        if at["entries"][i]["timestamp"] >= timestamp
            push(result, at["entries"][i])
        i = i + 1
    result

fn at_last(at: dict, n: int) -> list
    let result = []
    let total = len(at["entries"])
    let start = total - n
    if start < 0
        start = 0
    let i = start
    while i < total
        push(result, at["entries"][i])
        i = i + 1
    result
