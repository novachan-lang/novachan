// forge_audit_trail — Comprehensive audit trail (append-only event log).
// Tracks actor/action/resource/detail per event plus per-actor and
// per-action counters, with Result-based lookups for individual entries.
//
// STATE SHAPE (flat dict, no nesting):
//   state["count"]              — int, total events logged.
//   state["e_"+idx+"_actor"]    — string, actor for event `idx`.
//   state["e_"+idx+"_action"]   — string, action for event `idx`.
//   state["e_"+idx+"_resource"] — string, resource for event `idx`.
//   state["e_"+idx+"_detail"]   — string, detail for event `idx`.
//   state["actor_"+actor]       — int, event count for `actor`.
//   state["action_"+action]     — int, event count for `action`.
//   state["actors"]             — string, comma-separated unique actors (insertion order).
//   state["actions"]            — string, comma-separated unique actions (insertion order).
//   state["last_actor"]         — string, actor of the most recent event.
//   state["last_action"]        — string, action of the most recent event.

// at_new() -> dict
// Create an empty audit trail.
fn at_new() -> dict
    let at = {}
    at["count"] = 0
    at["actors"] = ""
    at["actions"] = ""
    at

// at_log(state, actor, action, resource, detail) -> dict
// Append one audit event.
fn at_log(state: dict, actor: string, action: string, resource: string, detail: string) -> dict
    let idx = state["count"]
    let base = "e_" + str(idx)
    state[base + "_actor"] = actor
    state[base + "_action"] = action
    state[base + "_resource"] = resource
    state[base + "_detail"] = detail
    state["count"] = idx + 1

    let ak = "actor_" + actor
    if ak not in state
        state[ak] = 0
        if state["actors"] == ""
            state["actors"] = actor
        else
            state["actors"] = state["actors"] + "," + actor
    state[ak] = state[ak] + 1

    let ck = "action_" + action
    if ck not in state
        state[ck] = 0
        if state["actions"] == ""
            state["actions"] = action
        else
            state["actions"] = state["actions"] + "," + action
    state[ck] = state[ck] + 1

    state["last_actor"] = actor
    state["last_action"] = action
    state

// at_count(state) -> int
fn at_count(state: dict) -> int
    state["count"]

// at_count_by_actor(state, actor) -> int
fn at_count_by_actor(state: dict, actor: string) -> int
    let ak = "actor_" + actor
    if ak not in state
        return 0
    state[ak]

// at_count_by_action(state, action) -> int
fn at_count_by_action(state: dict, action: string) -> int
    let ck = "action_" + action
    if ck not in state
        return 0
    state[ck]

// at_entry_at(state, index) -> Result
// ok("actor:action:resource") for the event at `index`, or err if out of range.
fn at_entry_at(state: dict, index: int) -> Result
    if index < 0
        return err("index out of range: " + str(index))
    if index >= state["count"]
        return err("index out of range: " + str(index))
    let base = "e_" + str(index)
    ok(state[base + "_actor"] + ":" + state[base + "_action"] + ":" + state[base + "_resource"])

// at_last_actor(state) -> Result
fn at_last_actor(state: dict) -> Result
    if state["count"] == 0
        return err("no events logged")
    ok(state["last_actor"])

// at_last_action(state) -> Result
fn at_last_action(state: dict) -> Result
    if state["count"] == 0
        return err("no events logged")
    ok(state["last_action"])

// at_actor_list(state) -> string
// Comma-separated unique actors, in first-seen order.
fn at_actor_list(state: dict) -> string
    state["actors"]

// at_action_list(state) -> string
// Comma-separated unique actions, in first-seen order.
fn at_action_list(state: dict) -> string
    state["actions"]
