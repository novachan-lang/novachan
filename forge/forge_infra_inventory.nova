// forge_infra_inventory — Ops infrastructure inventory tracking.
// Register resources by id, type, region; query and remove via Result.

fn inv_new() -> dict
    let s = {}
    s["resources"] = {}
    s["count"] = 0
    s

fn inv_add(state: dict, resource_id: string, resource_type: string, region: string) -> dict
    let is_new = contains(state["resources"], resource_id) != true
    let r = {}
    r["type"] = resource_type
    r["region"] = region
    r["removed"] = 0
    state["resources"][resource_id] = r
    if is_new
        state["count"] = state["count"] + 1
    state

fn inv_get_type(state: dict, resource_id: string) -> Result
    if contains(state["resources"], resource_id) != true
        return err("not found: " + resource_id)
    if state["resources"][resource_id]["removed"] == 1
        return err("not found: " + resource_id)
    ok(state["resources"][resource_id]["type"])

fn inv_get_region(state: dict, resource_id: string) -> Result
    if contains(state["resources"], resource_id) != true
        return err("not found: " + resource_id)
    if state["resources"][resource_id]["removed"] == 1
        return err("not found: " + resource_id)
    ok(state["resources"][resource_id]["region"])

fn inv_by_type(state: dict, resource_type: string) -> int
    let ids = keys(state["resources"])
    let i = 0
    let cnt = 0
    while i < len(ids)
        let r = state["resources"][ids[i]]
        if r["removed"] == 0
            if r["type"] == resource_type
                cnt = cnt + 1
        i = i + 1
    cnt

fn inv_by_region(state: dict, region: string) -> int
    let ids = keys(state["resources"])
    let i = 0
    let cnt = 0
    while i < len(ids)
        let r = state["resources"][ids[i]]
        if r["removed"] == 0
            if r["region"] == region
                cnt = cnt + 1
        i = i + 1
    cnt

fn inv_remove(state: dict, resource_id: string) -> Result
    if contains(state["resources"], resource_id) != true
        return err("not found: " + resource_id)
    if state["resources"][resource_id]["removed"] == 1
        return err("not found: " + resource_id)
    state["resources"][resource_id]["removed"] = 1
    state["count"] = state["count"] - 1
    ok(resource_id)

fn inv_resource_count(state: dict) -> int
    state["count"]

fn inv_type_list(state: dict) -> string
    let ids = keys(state["resources"])
    let seen = {}
    let result = ""
    let i = 0
    while i < len(ids)
        let r = state["resources"][ids[i]]
        if r["removed"] == 0
            if contains(seen, r["type"]) != true
                seen[r["type"]] = 1
                if result == ""
                    result = r["type"]
                else
                    result = result + "," + r["type"]
        i = i + 1
    result

fn inv_has(state: dict, resource_id: string) -> int
    if contains(state["resources"], resource_id) != true
        return 0
    if state["resources"][resource_id]["removed"] == 1
        return 0
    1
