// forge_failover_manager — Automatic primary/secondary failover per service.

fn fm_new() -> dict
    let f = {}
    f["service_count"] = 0
    f["failover_count"] = 0
    f

fn fm_add_primary(f: dict, service: string, endpoint: string) -> dict
    let seen_key = "svc_" + service + "_seen"
    let has = contains(f, seen_key)
    if has != true
        f[seen_key] = 1
        f["service_count"] = f["service_count"] + 1
        f["svc_" + service + "_failed_over"] = 0
        f["svc_" + service + "_healthy"] = 1
    f["svc_" + service + "_primary"] = endpoint
    f

fn fm_add_secondary(f: dict, service: string, endpoint: string) -> dict
    let seen_key = "svc_" + service + "_seen"
    let has = contains(f, seen_key)
    if has != true
        f[seen_key] = 1
        f["service_count"] = f["service_count"] + 1
        f["svc_" + service + "_failed_over"] = 0
        f["svc_" + service + "_healthy"] = 1
    f["svc_" + service + "_secondary"] = endpoint
    f

fn fm_health_check(f: dict, service: string, healthy: int) -> Result
    let seen_key = "svc_" + service + "_seen"
    let has = contains(f, seen_key)
    if has != true
        return err("unknown service")
    f["svc_" + service + "_healthy"] = healthy
    if healthy == 0
        let already = f["svc_" + service + "_failed_over"]
        if already == 0
            let has_secondary = contains(f, "svc_" + service + "_secondary")
            if has_secondary != true
                return err("no secondary available")
            f["svc_" + service + "_failed_over"] = 1
            f["failover_count"] = f["failover_count"] + 1
    ok(1)

fn fm_active_endpoint(f: dict, service: string) -> Result
    let seen_key = "svc_" + service + "_seen"
    let has = contains(f, seen_key)
    if has != true
        return err("unknown service")
    let failed_over = f["svc_" + service + "_failed_over"]
    if failed_over == 1
        return ok(f["svc_" + service + "_secondary"])
    let has_primary = contains(f, "svc_" + service + "_primary")
    if has_primary != true
        return err("no primary configured")
    ok(f["svc_" + service + "_primary"])

fn fm_is_failed_over(f: dict, service: string) -> int
    let seen_key = "svc_" + service + "_seen"
    let has = contains(f, seen_key)
    if has != true
        return 0
    f["svc_" + service + "_failed_over"]

fn fm_failover_count(f: dict) -> int
    f["failover_count"]

fn fm_service_count(f: dict) -> int
    f["service_count"]

fn fm_restore(f: dict, service: string) -> Result
    let seen_key = "svc_" + service + "_seen"
    let has = contains(f, seen_key)
    if has != true
        return err("unknown service")
    let failed_over = f["svc_" + service + "_failed_over"]
    if failed_over == 0
        return err("not failed over")
    f["svc_" + service + "_failed_over"] = 0
    f["svc_" + service + "_healthy"] = 1
    ok(1)
