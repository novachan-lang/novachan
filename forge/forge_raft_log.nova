// forge_raft_log — append-only replicated log for Raft consensus with Result API.

fn rl_new() -> dict
    {"entry_count": 0, "commit_index": -1, "current_term": 0}

fn rl_append(r: dict, term: int, command: string) -> dict
    let idx = r["entry_count"]
    let ik = str(idx)
    r["e_{ik}_term"] = term
    r["e_{ik}_cmd"] = command
    r["entry_count"] += 1
    if term > r["current_term"]
        r["current_term"] = term
    r

fn rl_commit(r: dict, index: int) -> Result
    if index < 0 or index >= r["entry_count"]
        return err("index out of range")
    if index <= r["commit_index"]
        return err("already committed")
    r["commit_index"] = index
    ok(r)

fn rl_get_command(r: dict, index: int) -> Result
    if index < 0 or index >= r["entry_count"]
        return err("index out of range")
    let ik = str(index)
    ok(r["e_{ik}_cmd"])

fn rl_get_term(r: dict, index: int) -> Result
    if index < 0 or index >= r["entry_count"]
        return err("index out of range")
    let ik = str(index)
    ok(r["e_{ik}_term"])

fn rl_is_committed(r: dict, index: int) -> int
    if index >= 0 and index <= r["commit_index"]
        return 1
    0

fn rl_entry_count(r: dict) -> int
    r["entry_count"]

fn rl_commit_index(r: dict) -> int
    r["commit_index"]

fn rl_current_term(r: dict) -> int
    r["current_term"]
