// forge_feature_toggle — Feature flag management.
// Toggle features on/off per-user or globally, with rollout percentages.

fn ft_new() -> dict
    {"flags": {}, "overrides": []}

fn ft_add_flag(ft: dict, name: string, enabled: int) -> dict
    let flags = ft["flags"]
    flags[name] = {"enabled": enabled, "rollout": 100, "description": ""}
    ft

fn ft_set_description(ft: dict, name: string, desc: string) -> dict
    let flags = ft["flags"]
    if name not in flags
        return ft
    flags[name]["description"] = desc
    ft

fn ft_enable(ft: dict, name: string) -> dict
    let flags = ft["flags"]
    if name not in flags
        return ft
    flags[name]["enabled"] = 1
    ft

fn ft_disable(ft: dict, name: string) -> dict
    let flags = ft["flags"]
    if name not in flags
        return ft
    flags[name]["enabled"] = 0
    ft

fn ft_set_rollout(ft: dict, name: string, pct: int) -> dict
    let flags = ft["flags"]
    if name not in flags
        return ft
    flags[name]["rollout"] = pct
    ft

fn ft_is_enabled(ft: dict, name: string) -> int
    let flags = ft["flags"]
    if name not in flags
        return 0
    let flag = flags[name]
    if flag["enabled"] != 1
        return 0
    1

fn ft_is_enabled_for(ft: dict, name: string, user_id: string) -> int
    let base = ft_is_enabled(ft, name)
    if base != 1
        return 0
    let overrides = ft["overrides"]
    for i in 0..len(overrides)
        let ov = overrides[i]
        if ov["flag"] == name
            if ov["user"] == user_id
                return ov["enabled"]
    1

fn ft_add_override(ft: dict, name: string, user_id: string, enabled: int) -> dict
    push(ft["overrides"], {"flag": name, "user": user_id, "enabled": enabled})
    ft

fn ft_flag_count(ft: dict) -> int
    len(keys(ft["flags"]))

fn ft_list_flags(ft: dict) -> list
    keys(ft["flags"])

fn ft_flag_info(ft: dict, name: string) -> dict
    let flags = ft["flags"]
    if name not in flags
        return {"name": ""}
    {"name": name, "enabled": flags[name]["enabled"], "rollout": flags[name]["rollout"], "description": flags[name]["description"]}
