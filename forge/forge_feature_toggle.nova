// forge_feature_toggle — Feature flag management.
// Toggle features on/off per-user or globally, with rollout percentages.

fn ft_new() -> dict
    let ft = {}
    ft["flags"] = {}
    ft["overrides"] = []
    ft

fn ft_add_flag(ft: dict, name: string, enabled: int) -> dict
    let flag = {}
    flag["enabled"] = enabled
    flag["rollout"] = 100
    flag["description"] = ""
    let flags = ft["flags"]
    flags[name] = flag
    ft

fn ft_set_description(ft: dict, name: string, desc: string) -> dict
    let flags = ft["flags"]
    let has = contains(flags, name)
    if has != true
        return ft
    flags[name]["description"] = desc
    ft

fn ft_enable(ft: dict, name: string) -> dict
    let flags = ft["flags"]
    let has = contains(flags, name)
    if has != true
        return ft
    flags[name]["enabled"] = 1
    ft

fn ft_disable(ft: dict, name: string) -> dict
    let flags = ft["flags"]
    let has = contains(flags, name)
    if has != true
        return ft
    flags[name]["enabled"] = 0
    ft

fn ft_set_rollout(ft: dict, name: string, pct: int) -> dict
    let flags = ft["flags"]
    let has = contains(flags, name)
    if has != true
        return ft
    flags[name]["rollout"] = pct
    ft

fn ft_is_enabled(ft: dict, name: string) -> int
    let flags = ft["flags"]
    let has = contains(flags, name)
    if has != true
        return 0
    let flag = flags[name]
    if flag["enabled"] != 1
        return 0
    1

fn ft_is_enabled_for(ft: dict, name: string, user_id: string) -> int
    let base = ft_is_enabled(ft, name)
    if base != 1
        return 0
    let i = 0
    let overrides = ft["overrides"]
    while i < len(overrides)
        let ov = overrides[i]
        if ov["flag"] == name
            if ov["user"] == user_id
                return ov["enabled"]
        i = i + 1
    1

fn ft_add_override(ft: dict, name: string, user_id: string, enabled: int) -> dict
    let ov = {}
    ov["flag"] = name
    ov["user"] = user_id
    ov["enabled"] = enabled
    push(ft["overrides"], ov)
    ft

fn ft_flag_count(ft: dict) -> int
    len(keys(ft["flags"]))

fn ft_list_flags(ft: dict) -> list
    keys(ft["flags"])

fn ft_flag_info(ft: dict, name: string) -> dict
    let flags = ft["flags"]
    let has = contains(flags, name)
    if has != true
        let empty = {}
        empty["name"] = ""
        return empty
    let info = {}
    info["name"] = name
    info["enabled"] = flags[name]["enabled"]
    info["rollout"] = flags[name]["rollout"]
    info["description"] = flags[name]["description"]
    info
