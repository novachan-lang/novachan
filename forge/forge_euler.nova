// forge_euler -- can you trace a graph in ONE stroke, crossing every edge exactly once? That's an Eulerian path
// (start and end anywhere) or Eulerian circuit (return to the start). This is the Seven Bridges of Konigsberg
// problem, and it decides real routing questions: a mail/snowplow/street-sweeper route that covers every road
// without repeats (the Chinese Postman's core), drawing a shape without lifting the pen, DNA fragment assembly,
// and single-pass wiring or pipe inspection. Euler's theorem makes the test cheap: a connected graph has a
// CIRCUIT iff every vertex has even degree, and a PATH iff exactly zero or two vertices have odd degree. This
// checks degrees and connectivity (ignoring isolated vertices). Edges are [u, v] UNDIRECTED, string ids. LEAF.

// PRIVATE: distinct node ids.
fn _eu_nodes(edges: list) -> list
    let seen = {}
    let nodes = []
    for i in 0..len(edges)
        let u = edges[i][0]
        if u in seen == false
            seen[u] = 1
            push(nodes, u)
        let v = edges[i][1]
        if v in seen == false
            seen[v] = 1
            push(nodes, v)
    nodes

// PRIVATE: undirected adjacency.
fn _eu_adj(edges: list, nodes: list) -> dict
    let adj = {}
    for i in 0..len(nodes)
        adj[nodes[i]] = []
    for e in 0..len(edges)
        push(adj[edges[e][0]], edges[e][1])
        push(adj[edges[e][1]], edges[e][0])
    adj

// PRIVATE: are all vertices with at least one edge in a single connected component?
fn _eu_connected(nodes: list, adj: dict) -> bool
    let n = len(nodes)
    let out = true
    if n > 0
        // BFS from the first node that has any edge
        let start = ""
        let si = 0
        while si < n and start == ""
            if len(adj[nodes[si]]) > 0
                start = nodes[si]
            si += 1
        if start != ""
            let visited = {}
            let queue = []
            push(queue, start)
            visited[start] = 1
            let qi = 0
            while qi < len(queue)
                let v = queue[qi]
                qi += 1
                let nb = adj[v]
                for j in 0..len(nb)
                    if nb[j] in visited == false
                        visited[nb[j]] = 1
                        push(queue, nb[j])
            // every vertex with edges must be visited
            for k in 0..n
                if len(adj[nodes[k]]) > 0 and contains(visited, nodes[k]) == false
                    out = false
    out

// The number of vertices with odd degree.
fn euler_odd_count(edges: list) -> int
    let nodes = _eu_nodes(edges)
    let adj = _eu_adj(edges, nodes)
    let odd = 0
    for i in 0..len(nodes)
        if len(adj[nodes[i]]) % 2 == 1
            odd += 1
    odd

// True if the graph has an Eulerian CIRCUIT (connected + every vertex even degree).
fn has_euler_circuit(edges: list) -> bool
    let nodes = _eu_nodes(edges)
    let adj = _eu_adj(edges, nodes)
    let out = false
    if len(edges) > 0 and _eu_connected(nodes, adj)
        let odd = 0
        for i in 0..len(nodes)
            if len(adj[nodes[i]]) % 2 == 1
                odd += 1
        if odd == 0
            out = true
    out

// True if the graph has an Eulerian PATH (connected + zero or two vertices of odd degree).
fn has_euler_path(edges: list) -> bool
    let nodes = _eu_nodes(edges)
    let adj = _eu_adj(edges, nodes)
    let out = false
    if len(edges) > 0 and _eu_connected(nodes, adj)
        let odd = 0
        for i in 0..len(nodes)
            if len(adj[nodes[i]]) % 2 == 1
                odd += 1
        if odd == 0 or odd == 2
            out = true
    out
