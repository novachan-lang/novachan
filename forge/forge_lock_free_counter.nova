// forge_lock_free_counter — named atomic-style counters with Result API.

fn lfc_new() -> dict
    {"counters": {}, "count": 0, "total_ops": 0}

fn lfc_create(c: dict, name: string) -> dict
    let ck = "c_{name}"
    if ck not in c["counters"]
        c["counters"][ck] = 0
        c["count"] += 1
    c

fn lfc_increment(c: dict, name: string) -> Result
    let ck = "c_{name}"
    if ck not in c["counters"]
        return err("counter not found")
    c["counters"][ck] += 1
    c["total_ops"] += 1
    ok(c["counters"][ck])

fn lfc_decrement(c: dict, name: string) -> Result
    let ck = "c_{name}"
    if ck not in c["counters"]
        return err("counter not found")
    c["counters"][ck] -= 1
    c["total_ops"] += 1
    ok(c["counters"][ck])

fn lfc_get(c: dict, name: string) -> Result
    let ck = "c_{name}"
    if ck not in c["counters"]
        return err("counter not found")
    ok(c["counters"][ck])

fn lfc_reset(c: dict, name: string) -> Result
    let ck = "c_{name}"
    if ck not in c["counters"]
        return err("counter not found")
    c["counters"][ck] = 0
    ok(c)

fn lfc_counter_count(c: dict) -> int
    c["count"]

fn lfc_total_ops(c: dict) -> int
    c["total_ops"]
