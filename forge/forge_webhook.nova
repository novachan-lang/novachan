// forge_webhook -- outbound webhook delivery envelopes with HMAC signing (Stripe/GitHub-style). Build the
// signed JSON payload + headers; the caller POSTs via forge_http_client + retries via forge_retry. The
// receiver verifies X-Webhook-Signature == hmac_sha256(secret, body) -- so a webhook can't be forged.
// LEAF -- builtins hmac_sha256 / json_stringify / time_ms / str.

// The JSON body: {event, data, ts}. Sign THIS exact string (byte-for-byte) so the receiver's HMAC matches.
fn webhook_payload(event: string, data) -> string
    json_stringify({"event": event, "data": data, "ts": str(time_ms())})

// The HMAC-SHA256 signature (hex) of a body -- what the receiver recomputes to authenticate.
fn webhook_sign(secret: string, body: string) -> string
    hmac_sha256(secret, body)

// Headers for a signed webhook POST.
fn webhook_headers(event: string, signature: string) -> dict
    {"Content-Type": "application/json", "X-Webhook-Event": event, "X-Webhook-Signature": signature}

// Prepare a full signed delivery: [body, headers]. POST body to the endpoint with these headers.
fn webhook_prepare(secret: string, event: string, data) -> list
    let body = webhook_payload(event, data)
    let sig = webhook_sign(secret, body)
    [body, webhook_headers(event, sig)]

// Receiver side: authenticate an inbound webhook (recompute the HMAC over the raw body, compare).
fn webhook_verify(secret: string, body: string, signature: string) -> bool
    hmac_sha256(secret, body) == signature
