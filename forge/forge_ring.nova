// forge_ring -- a fixed-capacity RING (circular) buffer: a bounded FIFO that overwrites the OLDEST entry when
// full. Behind log tailing (keep the last N lines), streaming/sliding windows, metric sampling, and
// backpressure-free producers that must never grow unbounded. O(1) push. Pre-sized array + head + count (no
// list-shrink needed). LEAF -- imports NOTHING.

fn ring_new(capacity: int) -> dict
    let r = {}
    r["cap"] = capacity
    let buf = []
    let i = 0
    while i < capacity
        push(buf, 0)
        i = i + 1
    r["buf"] = buf
    r["head"] = 0
    r["count"] = 0
    r

// Push a value. If full, overwrite the oldest and advance head. Fluent.
fn ring_push(r: dict, value) -> dict
    let cap = r["cap"]
    let buf = r["buf"]
    let count = r["count"]
    let head = r["head"]
    let tail = (head + count) % cap
    buf[tail] = value
    if count < cap
        r["count"] = count + 1
    else
        r["head"] = (head + 1) % cap
    r

// The current contents oldest-to-newest.
fn ring_to_list(r: dict) -> list
    let cap = r["cap"]
    let buf = r["buf"]
    let head = r["head"]
    let count = r["count"]
    let out = []
    let i = 0
    while i < count
        push(out, buf[(head + i) % cap])
        i = i + 1
    out

fn ring_size(r: dict) -> int
    r["count"]

fn ring_full(r: dict) -> bool
    r["count"] == r["cap"]

// The oldest element without removing it ("" if empty).
fn ring_oldest(r: dict) -> any
    if r["count"] == 0
        return ""
    let buf = r["buf"]
    buf[r["head"]]
