// forge_cursor_paginator — Cursor-based pagination with Result.

fn cp_new(page_size: int) -> dict
    {"items": {}, "count": 0, "page_size": page_size}

fn cp_add(c: dict, key: string, value: string) -> dict
    let cnt = c["count"]
    c["items"]["{cnt}_key"] = key
    c["items"]["{cnt}_value"] = value
    c["count"] += 1
    c

fn cp_page(c: dict, cursor: int) -> dict
    let end = cursor + c["page_size"]
    if end > c["count"]
        end = c["count"]
    let items_in_page = end - cursor
    {"start": cursor, "end": end, "has_next": end < c["count"], "next_cursor": end, "count": items_in_page}

fn cp_item_key(c: dict, idx: int) -> Result
    if idx < 0
        return err("negative index")
    if idx >= c["count"]
        return err("index out of range")
    ok(c["items"]["{idx}_key"])

fn cp_item_value(c: dict, idx: int) -> Result
    if idx < 0
        return err("negative index")
    if idx >= c["count"]
        return err("index out of range")
    ok(c["items"]["{idx}_value"])

fn cp_total_count(c: dict) -> int
    c["count"]

fn cp_total_pages(c: dict) -> int
    if c["page_size"] == 0
        return 0
    let pages = c["count"] / c["page_size"]
    if c["count"] % c["page_size"] > 0
        pages += 1
    pages
