// forge_tracing — Distributed tracing (OpenTelemetry-style spans).
// Trace context, spans with parent/child, attributes, export.

fn trace_new(trace_id: string) -> dict
    let t = {}
    t["trace_id"] = trace_id
    t["spans"] = []
    t["next_span_id"] = 1
    t

fn trace_start_span(t: dict, name: string, parent_id: int) -> dict
    let sid = t["next_span_id"]
    t["next_span_id"] = sid + 1
    let span = {}
    span["span_id"] = sid
    span["name"] = name
    span["parent_id"] = parent_id
    span["status"] = "running"
    span["attributes"] = {}
    span["events"] = []
    push(t["spans"], span)
    t["_last_span_id"] = sid
    t

fn trace_last_span_id(t: dict) -> int
    t["_last_span_id"]

fn trace_end_span(t: dict, span_id: int) -> dict
    let i = 0
    while i < len(t["spans"])
        if t["spans"][i]["span_id"] == span_id
            t["spans"][i]["status"] = "ended"
        i = i + 1
    t

fn trace_set_status(t: dict, span_id: int, status: string) -> dict
    let i = 0
    while i < len(t["spans"])
        if t["spans"][i]["span_id"] == span_id
            t["spans"][i]["status"] = status
        i = i + 1
    t

fn trace_set_attr(t: dict, span_id: int, key: string, value: any) -> dict
    let i = 0
    while i < len(t["spans"])
        if t["spans"][i]["span_id"] == span_id
            t["spans"][i]["attributes"][key] = value
        i = i + 1
    t

fn trace_add_event(t: dict, span_id: int, event_name: string) -> dict
    let i = 0
    while i < len(t["spans"])
        if t["spans"][i]["span_id"] == span_id
            push(t["spans"][i]["events"], event_name)
        i = i + 1
    t

fn trace_get_span(t: dict, span_id: int) -> dict
    let i = 0
    while i < len(t["spans"])
        if t["spans"][i]["span_id"] == span_id
            return t["spans"][i]
        i = i + 1
    let empty = {}
    empty

fn trace_children(t: dict, parent_id: int) -> list
    let result = []
    let i = 0
    while i < len(t["spans"])
        if t["spans"][i]["parent_id"] == parent_id
            push(result, t["spans"][i])
        i = i + 1
    result

fn trace_span_count(t: dict) -> int
    len(t["spans"])

fn trace_root_spans(t: dict) -> list
    trace_children(t, 0)
