// forge_threat_detector — Sentinel: rule-based threat detection and alerting.
//
// A tiny signature-matching engine: register named rules (pattern + severity
// 1-5), then check inbound events (event_type + source) against every rule.
// The first rule whose pattern is a substring of "event_type source" fires an
// alert; ties are broken by registration order (first match wins). This is
// the same substring-signature model used by fail2ban filters and basic IDS
// rule sets (Snort's simplest "content:" match, minus full Boyer-Moore/regex).
//
// STATE SHAPE — single FLAT dict, no nested dicts, no lists-in-dicts:
//   rule_count               : int    — number of registered rules
//   rule_name_<i>             : string — rule i's name          (i = 0..rule_count-1)
//   rule_pattern_<i>          : string — rule i's match pattern
//   rule_severity_<i>         : int    — rule i's severity (1-5)
//   alert_count               : int    — total alerts triggered
//   has_last_alert            : int    — 1 once at least one alert fired
//   last_alert_name           : string — name of most recently triggered rule
//   sev_1_count..sev_5_count  : int    — alerts triggered per severity level
//
// LEAF MODULE — imports NOTHING. Built-ins: contains, str, len.

fn td_new() -> dict
    {"rule_count": 0, "alert_count": 0, "has_last_alert": 0, "last_alert_name": "", "sev_1_count": 0, "sev_2_count": 0, "sev_3_count": 0, "sev_4_count": 0, "sev_5_count": 0}

// Register a detection rule. severity is expected in 1-5 (used to bucket
// alert counts by severity — a severity outside that range is still stored
// and matched, but td_alerts_by_severity for it will read back 0).
fn td_add_rule(state: dict, rule_name: string, pattern: string, severity: int) -> dict
    let idx = state["rule_count"]
    state["rule_name_{idx}"] = rule_name
    state["rule_pattern_{idx}"] = pattern
    state["rule_severity_{idx}"] = severity
    state["rule_count"] += 1
    state

// Check an event against every registered rule (registration order).
// Returns ok("clean") if nothing matched, ok(rule_name) for the first rule
// whose pattern is a substring of "event_type source".
fn td_check(state: dict, event_type: string, source: string) -> Result
    let combined = "{event_type} {source}"
    let n = state["rule_count"]
    let found = 0
    let matched_name = ""
    let matched_sev = 0
    for i in 0..n
        if found == 0
            let pattern = state["rule_pattern_{i}"]
            if pattern in combined
                matched_name = state["rule_name_{i}"]
                matched_sev = state["rule_severity_{i}"]
                found = 1
    if found == 1
        state["alert_count"] += 1
        state["has_last_alert"] = 1
        state["last_alert_name"] = matched_name
        let sevkey = "sev_{matched_sev}_count"
        if sevkey in state
            state[sevkey] += 1
        return ok(matched_name)
    ok("clean")

fn td_alert_count(state: dict) -> int
    state["alert_count"]

fn td_rule_count(state: dict) -> int
    state["rule_count"]

fn td_last_alert(state: dict) -> Result
    if state["has_last_alert"] == 1
        return ok(state["last_alert_name"])
    err("no alerts triggered yet")

fn td_alerts_by_severity(state: dict, severity: int) -> int
    let sevkey = "sev_{severity}_count"
    if sevkey in state
        return state[sevkey]
    0

fn td_has_rule(state: dict, name: string) -> int
    let n = state["rule_count"]
    let found = 0
    for i in 0..n
        if found == 0
            if state["rule_name_{i}"] == name
                found = 1
    found
