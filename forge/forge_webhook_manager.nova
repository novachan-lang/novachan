// forge_webhook_manager — Outbound webhook management.
// Register endpoints, dispatch events, retry tracking, delivery log.

fn whm_new() -> dict
    let w = {}
    w["endpoints"] = {}
    w["deliveries"] = []
    w["next_id"] = 1
    w

fn whm_register(wm: dict, url: string, events: list) -> dict
    let id = wm["next_id"]
    wm["next_id"] = id + 1
    let ep = {}
    ep["id"] = id
    ep["url"] = url
    ep["events"] = events
    ep["active"] = true
    ep["delivery_count"] = 0
    ep["failure_count"] = 0
    wm["endpoints"][str(id)] = ep
    wm

fn whm_last_id(wm: dict) -> int
    wm["next_id"] - 1

fn whm_deactivate(wm: dict, id: int) -> dict
    let sid = str(id)
    let has_ep = contains(wm["endpoints"], sid)
    if has_ep == true
        wm["endpoints"][sid]["active"] = false
    wm

fn whm_dispatch(wm: dict, event_type: string, payload: any) -> dict
    let ids = keys(wm["endpoints"])
    for i in 0..len(ids)
        let ep = wm["endpoints"][ids[i]]
        if ep["active"] == true
            let j = 0
            while j < len(ep["events"])
                if ep["events"][j] == event_type or ep["events"][j] == "*"
                    let delivery = {}
                    delivery["endpoint_id"] = ep["id"]
                    delivery["url"] = ep["url"]
                    delivery["event"] = event_type
                    delivery["payload"] = payload
                    delivery["status"] = "pending"
                    delivery["attempts"] = 1
                    push(wm["deliveries"], delivery)
                    wm["endpoints"][ids[i]]["delivery_count"] = ep["delivery_count"] + 1
                    j = len(ep["events"])
                j += 1
    wm

fn whm_mark_delivered(wm: dict, idx: int) -> dict
    if idx < len(wm["deliveries"])
        wm["deliveries"][idx]["status"] = "delivered"
    wm

fn whm_mark_failed(wm: dict, idx: int) -> dict
    if idx < len(wm["deliveries"])
        wm["deliveries"][idx]["status"] = "failed"
        wm["deliveries"][idx]["attempts"] = wm["deliveries"][idx]["attempts"] + 1
    wm

fn whm_delivery_count(wm: dict) -> int
    len(wm["deliveries"])

fn whm_pending_count(wm: dict) -> int
    let count = 0
    let i = 0
    while i < len(wm["deliveries"])
        if wm["deliveries"][i]["status"] == "pending"
            count += 1
        i += 1
    count

fn whm_list_endpoints(wm: dict) -> list
    let ids = keys(wm["endpoints"])
    let result = [wm["endpoints"][ids[i]] for i in 0..len(ids)]
    result
