// forge_countdown -- time remaining until a target date (deadline countdowns, "3 days left", trial expiry,
// sale timers). Days between two dates + a humanized label. Composes forge_date. Imports forge_date.
import forge_date

// Whole days from the `from` date to the `target` date (negative if target is already past).
fn days_until(from_y: int, from_m: int, from_d: int, target_y: int, target_m: int, target_d: int) -> int
    date_diff_days(from_y, from_m, from_d, target_y, target_m, target_d)

// Has the target date already passed relative to `from`?
fn is_past(from_y: int, from_m: int, from_d: int, target_y: int, target_m: int, target_d: int) -> bool
    days_until(from_y, from_m, from_d, target_y, target_m, target_d) < 0

// A human label: "today" / "tomorrow" / "yesterday" / "in N days" / "N days ago".
fn countdown_label(from_y: int, from_m: int, from_d: int, target_y: int, target_m: int, target_d: int) -> string
    let d = days_until(from_y, from_m, from_d, target_y, target_m, target_d)
    if d == 0
        return "today"
    if d == 1
        return "tomorrow"
    if d == 0 - 1
        return "yesterday"
    if d > 0
        return "in " + str(d) + " days"
    str(0 - d) + " days ago"
