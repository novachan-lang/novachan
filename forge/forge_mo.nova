// forge_mo -- Mo's algorithm: answer many OFFLINE range queries fast by reordering them cleverly.
// Given a fixed array and Q queries "compute some aggregate over a[l..r]" (that has no simple prefix-sum
// form -- e.g. number of DISTINCT values, most frequent element, count of pairs, sum of squares of
// frequencies), the naive cost is O(Q*n). Mo's algorithm sorts the queries into an order that lets you
// move the current window [curL, curR] by ADDING/REMOVING one element at a time, and proves the total
// number of pointer moves is only O((n+Q)*sqrt(n)) -- a huge win. The trick: sort queries by (block of l,
// then r) where block = l / sqrt(n); within a block r moves monotonically, across blocks l moves O(sqrt n)
// per query. Applications: distinct-count queries, mode/frequency queries, offline range statistics in
// databases and competitive programming -- anywhere you have all queries up front and an aggregate that
// updates cheaply on single-element add/remove.
//
// This module implements the canonical use: NUMBER OF DISTINCT VALUES in a[l..r] for a batch of queries.
// It maintains a frequency dict and a running distinct-count as elements enter/leave the window. The
// query-reordering machinery (mo_sort_order) is exposed separately so other aggregates can reuse it.
//
// API:
//   mo_block_size(n) -> int                         sqrt(n) block width (>=1)
//   mo_sort_order(queries, n) -> list               indices of queries in Mo's optimal processing order
//   mo_distinct(arr, queries) -> list               answers[i] = #distinct values in a[l..r] for each query
// queries is a list of [l, r] (0-indexed, inclusive). Returns answers in the ORIGINAL query order.
// LEAF (imports nothing).

fn mo_block_size(n: int) -> int
    let b = 1
    while b * b < n
        b += 1
    if b < 1
        b = 1
    return b

// Return the list of query INDICES sorted into Mo's order: primary key = l/block, secondary = r.
fn mo_sort_order(queries: list, n: int) -> list
    let q = len(queries)
    let block = mo_block_size(n)
    // Build index list
    let order = [i for i in 0..q]
    // Insertion sort by (block of l, then r). q is modest; O(q^2) is fine and avoids closures.
    for a in 1..q
        let key = order[a]
        let kl = queries[key][0]
        let kr = queries[key][1]
        let kb = kl / block
        let j = a - 1
        let placed = false
        while j >= 0 and placed == false
            let idx = order[j]
            let il = queries[idx][0]
            let ir = queries[idx][1]
            let ib = il / block
            // is order[j] GREATER than key? (should move right)
            let greater = false
            if ib > kb
                greater = true
            else
                if ib == kb and ir > kr
                    greater = true
            if greater
                order[j + 1] = order[j]
                j -= 1
            else
                placed = true
        order[j + 1] = key
    return order

// Answer #distinct in each [l, r] query using Mo's algorithm. Returns answers in ORIGINAL order.
fn mo_distinct(arr: list, queries: list) -> list
    let n = len(arr)
    let q = len(queries)
    let answers = [0 for i in 0..q]
    if q == 0
        return answers
    let order = mo_sort_order(queries, n)
    // frequency dict keyed by value (string) and running distinct count
    let freq = {}
    let distinct = 0
    let curL = 0
    let curR = 0 - 1
    for oi in 0..q
        let qi = order[oi]
        let l = queries[qi][0]
        let r = queries[qi][1]
        // expand right
        while curR < r
            curR += 1
            let key = str(arr[curR])
            let f = get(freq, key, 0)
            if f == 0
                distinct += 1
            freq[key] = f + 1
        // shrink right
        while curR > r
            let key = str(arr[curR])
            let f = get(freq, key, 0)
            freq[key] = f - 1
            if f - 1 == 0
                distinct -= 1
            curR -= 1
        // expand left
        while curL > l
            curL -= 1
            let key = str(arr[curL])
            let f = get(freq, key, 0)
            if f == 0
                distinct += 1
            freq[key] = f + 1
        // shrink left
        while curL < l
            let key = str(arr[curL])
            let f = get(freq, key, 0)
            freq[key] = f - 1
            if f - 1 == 0
                distinct -= 1
            curL += 1
        answers[qi] = distinct
    return answers
