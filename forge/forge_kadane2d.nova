// forge_kadane2d -- the maximum-sum SUBMATRIX of a grid: the rectangular sub-block whose entries add up to the
// largest total. It's the 2-D generalisation of Kadane's maximum-subarray (forge_subarray), and the trick is
// elegant: fix a TOP and BOTTOM row, add up each column between them into a single 1-D array, and the best
// submatrix spanning those rows is just the best contiguous run of that array -- a 1-D Kadane. Sweeping every
// top/bottom pair gives the global answer in O(rows^2 * cols), far better than checking all O((rows*cols)^2)
// rectangles. This is a real workhorse for grids of signed values: finding the brightest/darkest region of an
// image, the most profitable rectangular zone in a heatmap or spreadsheet, the densest cluster in a 2-D signal, or
// any "best rectangle" in scored map data. Returns the maximum sum (and, if asked, the corner coordinates of a
// rectangle achieving it). Integer matrix. LEAF -- imports NOTHING.

// The maximum sum over all non-empty rectangular sub-blocks of `matrix`.
fn max_submatrix_sum(matrix: list) -> int
    let r = len(matrix)
    let out = 0
    if r > 0
        let c = len(matrix[0])
        let best = matrix[0][0]
        for top in 0..r
            // running column sums for rows [top..bottom]
            let colsum = [0 for z in 0..c]
            for bottom in top..r
                for cc in 0..c
                    colsum[cc] += matrix[bottom][cc]
                // 1-D Kadane over colsum
                let cur = colsum[0]
                let local = colsum[0]
                for k in 1..c
                    if colsum[k] > cur + colsum[k]
                        cur = colsum[k]
                    else
                        cur += colsum[k]
                    if cur > local
                        local = cur
                if local > best
                    best = local
        out = best
    out

// The corners of a maximum-sum rectangle as [top, left, bottom, right] (inclusive), alongside its sum via
// max_submatrix_sum. Returns the first such rectangle found in top,bottom,left scan order.
fn max_submatrix_rect(matrix: list) -> list
    let r = len(matrix)
    let out = [0, 0, 0, 0]
    if r > 0
        let c = len(matrix[0])
        let best = matrix[0][0]
        let bt = 0
        let bl = 0
        let bb = 0
        let br = 0
        for top in 0..r
            let colsum = [0 for z in 0..c]
            for bottom in top..r
                for cc in 0..c
                    colsum[cc] += matrix[bottom][cc]
                // Kadane with start tracking
                let cur = colsum[0]
                let start = 0
                for k in 1..c
                    if colsum[k] > cur + colsum[k]
                        cur = colsum[k]
                        start = k
                    else
                        cur += colsum[k]
                    if cur > best
                        best = cur
                        bt = top
                        bb = bottom
                        bl = start
                        br = k
        out = [bt, bl, bb, br]
    out
