// forge_merge3 -- a line-based THREE-WAY MERGE, the operation at the heart of version control (git merge), config
// reconciliation, and collaborative editing. Given a common ANCESTOR ("base") and two independently edited versions
// ("ours" and "theirs"), it produces a single merged result: changes made on only one side are taken
// automatically, identical changes made on both sides collapse to one, and only genuinely overlapping, DIFFERENT
// edits to the same region become a CONFLICT (marked with the familiar <<<<<<< / ======= / >>>>>>> guards). The
// trick is to align all three via their common lines: match base against each side with an LCS, keep the lines
// matched in BOTH as stable anchors, and resolve each region between anchors by asking "which side actually
// changed it?". This is the difference between a merge that quietly combines two people's non-overlapping work and
// one that flags every difference. Inputs and output are lists of lines. LEAF -- imports NOTHING.

// PRIVATE: element-wise equality of two line lists.
fn _m3_eq(a: list, b: list) -> bool
    let out = true
    if len(a) != len(b)
        out = false
    else
        for i in 0..len(a)
            if a[i] != b[i]
                out = false
    out

// PRIVATE: the sublist lst[lo..hi).
fn _m3_sub(lst: list, lo: int, hi: int) -> list
    let out = []
    let i = lo
    while i < hi
        push(out, lst[i])
        i += 1
    out

// PRIVATE: append all of `src` to `dst`.
fn _m3_extend(dst: list, src: list)
    let i = 0
    while i < len(src)
        push(dst, src[i])
        i += 1

// PRIVATE: LCS matching of `a` against `b`; returns mp of length len(a) where mp[i] = matched index in b, or -1.
fn _m3_lcs(a: list, b: list) -> list
    let n = len(a)
    let m = len(b)
    let w = m + 1
    let dp = [0 for z in 0..((n + 1) * w)]
    let i = n - 1
    while i >= 0
        let j = m - 1
        while j >= 0
            if a[i] == b[j]
                dp[i * w + j] = dp[(i + 1) * w + (j + 1)] + 1
            else
                let down = dp[(i + 1) * w + j]
                let right = dp[i * w + (j + 1)]
                if down >= right
                    dp[i * w + j] = down
                else
                    dp[i * w + j] = right
            j -= 1
        i -= 1
    let mp = [0 - 1 for q in 0..n]
    let ci = 0
    let cj = 0
    while ci < n and cj < m
        if a[ci] == b[cj]
            mp[ci] = cj
            ci += 1
            cj += 1
        else
            if dp[(ci + 1) * w + cj] >= dp[ci * w + (cj + 1)]
                ci += 1
            else
                cj += 1
    mp

// Three-way merge of `base`, `ours`, `theirs` (each a list of lines). Returns [merged_lines, conflict_count].
// Non-overlapping changes merge cleanly; overlapping different edits become conflict blocks with markers.
fn merge3(base: list, ours: list, theirs: list) -> list
    let om = _m3_lcs(base, ours)
    let tm = _m3_lcs(base, theirs)
    let n = len(base)
    // anchors: base lines matched (unchanged) in BOTH sides
    let anchors = [i for i in 0..n if om[i] != 0 - 1 and tm[i] != 0 - 1]
    let merged = []
    let conflicts = 0
    let pb = 0 - 1
    let po = 0 - 1
    let pt = 0 - 1
    let a = 0
    while a <= len(anchors)
        let bi = n
        let oi = len(ours)
        let ti = len(theirs)
        if a < len(anchors)
            bi = anchors[a]
            oi = om[bi]
            ti = tm[bi]
        let base_slice = _m3_sub(base, pb + 1, bi)
        let ours_slice = _m3_sub(ours, po + 1, oi)
        let theirs_slice = _m3_sub(theirs, pt + 1, ti)
        if _m3_eq(ours_slice, base_slice)
            _m3_extend(merged, theirs_slice)
        else
            if _m3_eq(theirs_slice, base_slice)
                _m3_extend(merged, ours_slice)
            else
                if _m3_eq(ours_slice, theirs_slice)
                    _m3_extend(merged, ours_slice)
                else
                    conflicts += 1
                    push(merged, "<<<<<<< ours")
                    _m3_extend(merged, ours_slice)
                    push(merged, "=======")
                    _m3_extend(merged, theirs_slice)
                    push(merged, ">>>>>>> theirs")
        if a < len(anchors)
            push(merged, base[bi])
        pb = bi
        po = oi
        pt = ti
        a += 1
    [merged, conflicts]
