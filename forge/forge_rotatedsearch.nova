// forge_rotatedsearch -- binary search in a sorted array that has been ROTATED (cut somewhere and the two pieces
// swapped), e.g. [4,5,6,7,0,1,2]. Plain binary search assumes one clean sorted order; a rotated array has two
// sorted runs joined by a single "wrap" point, so at each midpoint you first work out WHICH half is the properly
// sorted one, then decide whether the target lies inside that half's known range -- still O(log n), never O(n).
// This is exactly what you need for circular buffers and ring logs (data that wrapped around), a clock/schedule
// that starts partway through the day, or any sorted dataset whose start offset drifted. Alongside the search:
// finding the ROTATION POINT (the index of the smallest element, i.e. where the wrap happens) and the minimum
// value, both in O(log n). Assumes distinct integer elements. LEAF -- imports NOTHING.

// The index of `target` in a rotated sorted array, or -1 if absent. O(log n).
fn search_rotated(arr: list, target: int) -> int
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi
        let mid = (lo + hi) / 2
        if arr[mid] == target
            return mid
        else if arr[lo] <= arr[mid]
            // left half [lo..mid] is sorted
            if arr[lo] <= target and target < arr[mid]
                hi = mid - 1
            else
                lo = mid + 1
        else
            // right half [mid..hi] is sorted
            if arr[mid] < target and target <= arr[hi]
                lo = mid + 1
            else
                hi = mid - 1
    -1

// The index of the smallest element (the rotation/wrap point). 0 if the array is not rotated. O(log n).
fn find_rotation_point(arr: list) -> int
    let lo = 0
    let hi = len(arr) - 1
    while lo < hi
        let mid = (lo + hi) / 2
        if arr[mid] > arr[hi]
            lo = mid + 1
        else
            hi = mid
    lo

// The minimum value of a rotated sorted array. O(log n).
fn find_min_rotated(arr: list) -> int
    arr[find_rotation_point(arr)] if len(arr) > 0 else 0
