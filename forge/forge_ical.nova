// forge_ical -- iCalendar (.ics) generation (RFC 5545): calendar events for booking systems, invites, and
// "Add to Calendar" links that Google Calendar / Outlook / Apple Calendar all consume. Build a VEVENT
// (start/end/summary/description/location) and wrap events in a VCALENDAR. TEXT values are escaped per spec
// and lines use CRLF. Composes forge_date for the compact UTC timestamp. Imports forge_date.
import forge_date

fn _ical_z2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

fn _ical_z4(n: int) -> string
    let s = str(n)
    while len(s) < 4
        s = "0" + s
    s

// Escape an iCal TEXT value (RFC 5545 §3.3.11): backslash, semicolon, comma, newline.
fn _ical_esc(s: string) -> string
    let bs = chr(92)
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if c == bs
            out += bs + bs
        else
            if c == ";"
                out += bs + ";"
            else
                if c == ","
                    out += bs + ","
                else
                    if c == chr(10)
                        out += bs + "n"
                    else
                        out += c
    out

// Epoch seconds (UTC) -> "YYYYMMDDTHHMMSSZ".
fn _ical_dt(epoch: int) -> string
    let ymd = date_from_epoch_days(epoch / 86400)
    let secs = epoch % 86400
    _ical_z4(ymd[0]) + _ical_z2(ymd[1]) + _ical_z2(ymd[2]) + "T" + _ical_z2(secs / 3600) + _ical_z2((secs % 3600) / 60) + _ical_z2(secs % 60) + "Z"

// Build a VEVENT block. start_epoch/end_epoch are unix seconds (UTC). description/location optional (pass "").
fn ical_event(uid: string, start_epoch: int, end_epoch: int, summary: string, description: string, location: string) -> string
    let crlf = chr(13) + chr(10)
    let out = "BEGIN:VEVENT" + crlf
    out += "UID:" + uid + crlf
    out += "DTSTAMP:" + _ical_dt(time_ms() / 1000) + crlf
    out += "DTSTART:" + _ical_dt(start_epoch) + crlf
    out += "DTEND:" + _ical_dt(end_epoch) + crlf
    out += "SUMMARY:" + _ical_esc(summary) + crlf
    if len(description) > 0
        out += "DESCRIPTION:" + _ical_esc(description) + crlf
    if len(location) > 0
        out += "LOCATION:" + _ical_esc(location) + crlf
    out + "END:VEVENT" + crlf

// Wrap one or more VEVENT blocks (concatenated) in a VCALENDAR -- the full .ics file body.
fn ical_calendar(events: string, prodid: string) -> string
    let crlf = chr(13) + chr(10)
    "BEGIN:VCALENDAR" + crlf + "VERSION:2.0" + crlf + "PRODID:" + prodid + crlf + "CALSCALE:GREGORIAN" + crlf + events + "END:VCALENDAR" + crlf
