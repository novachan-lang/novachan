// forge_schema_validator — Data schema validation (named schemas, typed fields).
// Schemas are registered by name; each field has a declared type
// ("string"/"int"/"bool") and an optional required flag. Field values
// are validated against the declared type via runtime type inspection.
//
// STATE SHAPE (flat dict, no nesting):
//   state["schema_count"]                        — int, number of distinct schemas.
//   state["fc_"+schema]                           — int, field count for `schema`.
//   state["hasfield_"+schema+"_"+field]           — int, 1 if `field` is declared on `schema`.
//   state["type_"+schema+"_"+field]               — string, declared type for `field`.
//   state["req_"+schema+"_"+field]                — int, 1 if `field` is required.
//   state["total_validations"]                    — int, total sv_validate_field calls.
//   state["pass_count"]                            — int, sv_validate_field calls that passed.

// sv_new() -> dict
// Create an empty schema validator.
fn sv_new() -> dict
    let s = {}
    s["schema_count"] = 0
    s["total_validations"] = 0
    s["pass_count"] = 0
    s

// sv_add_field(state, schema_name, field_name, field_type) -> dict
// Declare `field_name` on `schema_name` with type "string"/"int"/"bool".
// Registers the schema on first use. Re-adding a field updates its type
// without changing its required flag or the field count.
fn sv_add_field(state: dict, schema_name: string, field_name: string, field_type: string) -> dict
    let sk = "fc_" + schema_name
    if contains(state, sk) != true
        state["schema_count"] = state["schema_count"] + 1
        state[sk] = 0
    let hf = "hasfield_" + schema_name + "_" + field_name
    if contains(state, hf) != true
        state[sk] = state[sk] + 1
        state["req_" + schema_name + "_" + field_name] = 0
    state[hf] = 1
    state["type_" + schema_name + "_" + field_name] = field_type
    state

// sv_field_count(state, schema_name) -> Result
// ok(number of declared fields), or err if the schema was never registered.
fn sv_field_count(state: dict, schema_name: string) -> Result
    let sk = "fc_" + schema_name
    if contains(state, sk) != true
        return err("schema not found: " + schema_name)
    ok(state[sk])

// sv_has_schema(state, schema_name) -> int
fn sv_has_schema(state: dict, schema_name: string) -> int
    let sk = "fc_" + schema_name
    if contains(state, sk) == true
        return 1
    0

// sv_schema_count(state) -> int
fn sv_schema_count(state: dict) -> int
    state["schema_count"]

// _sv_type_matches(expected, actual) -> bool — internal type-compatibility check.
// Bools may surface as "bool" or, in untyped `any` contexts, as "int"
// (NOVA boxes true/false through the same numeric path there) — accept
// either for an expected "bool" field so genuine mismatches (e.g. a
// string) are still caught.
fn _sv_type_matches(expected: string, actual: string) -> bool
    if expected == actual
        return true
    if expected == "bool"
        if actual == "int"
            return true
    false

// sv_validate_field(state, schema_name, field_name, value) -> Result
// Validate one field value against its declared type. ok(value) on
// success, err on unknown schema/field or a type mismatch. Counts
// toward sv_total_validations / sv_pass_count either way (except
// unknown-schema/field, which is not counted as a validation attempt).
fn sv_validate_field(state: dict, schema_name: string, field_name: string, value: any) -> Result
    let hf = "hasfield_" + schema_name + "_" + field_name
    if contains(state, hf) != true
        return err("field not declared: " + schema_name + "." + field_name)
    state["total_validations"] = state["total_validations"] + 1
    let expected = state["type_" + schema_name + "_" + field_name]
    let actual = type_of(value)
    if _sv_type_matches(expected, actual) != true
        return err("type mismatch for " + field_name + ": expected " + expected + " got " + actual)
    state["pass_count"] = state["pass_count"] + 1
    ok(value)

// sv_is_required(state, schema_name, field_name) -> Result
// ok(1) if required, ok(0) if optional, err if the field is undeclared.
fn sv_is_required(state: dict, schema_name: string, field_name: string) -> Result
    let hf = "hasfield_" + schema_name + "_" + field_name
    if contains(state, hf) != true
        return err("field not declared: " + schema_name + "." + field_name)
    ok(state["req_" + schema_name + "_" + field_name])

// sv_set_required(state, schema_name, field_name) -> Result
// Mark a declared field required. ok(field_name), or err if undeclared.
fn sv_set_required(state: dict, schema_name: string, field_name: string) -> Result
    let hf = "hasfield_" + schema_name + "_" + field_name
    if contains(state, hf) != true
        return err("field not declared: " + schema_name + "." + field_name)
    state["req_" + schema_name + "_" + field_name] = 1
    ok(field_name)

// sv_total_validations(state) -> int
fn sv_total_validations(state: dict) -> int
    state["total_validations"]

// sv_pass_count(state) -> int
fn sv_pass_count(state: dict) -> int
    state["pass_count"]
