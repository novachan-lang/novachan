// forge_schema_validator — Validate data against schemas (field rules).

fn sv_new() -> dict
    let s = {}
    s["rules"] = {}
    s["rule_count"] = 0
    s["validations"] = 0
    s["failures"] = 0
    s

fn sv_require(s: dict, field: string, field_type: string) -> dict
    let k = str(s["rule_count"])
    s["rules"][k + "_field"] = field
    s["rules"][k + "_type"] = field_type
    s["rules"][k + "_required"] = 1
    s["rules"][k + "_min"] = -1
    s["rules"][k + "_max"] = -1
    s["rule_count"] = s["rule_count"] + 1
    s

fn sv_optional(s: dict, field: string, field_type: string) -> dict
    let k = str(s["rule_count"])
    s["rules"][k + "_field"] = field
    s["rules"][k + "_type"] = field_type
    s["rules"][k + "_required"] = 0
    s["rules"][k + "_min"] = -1
    s["rules"][k + "_max"] = -1
    s["rule_count"] = s["rule_count"] + 1
    s

fn sv_range(s: dict, field: string, min_val: int, max_val: int) -> dict
    let k = str(s["rule_count"])
    s["rules"][k + "_field"] = field
    s["rules"][k + "_type"] = "int"
    s["rules"][k + "_required"] = 1
    s["rules"][k + "_min"] = min_val
    s["rules"][k + "_max"] = max_val
    s["rule_count"] = s["rule_count"] + 1
    s

fn sv_check_field(s: dict, data: dict, idx: int) -> string
    let k = str(idx)
    let field = s["rules"][k + "_field"]
    let required = s["rules"][k + "_required"]
    let has = contains(data, field)
    if has != true
        if required == 1
            return "missing:" + field
        return ""
    let min_val = s["rules"][k + "_min"]
    let max_val = s["rules"][k + "_max"]
    if min_val >= 0
        let v = data[field]
        if v < min_val
            return "below_min:" + field
        if max_val >= 0
            if v > max_val
                return "above_max:" + field
    ""

fn sv_validate(s: dict, data: dict) -> dict
    let result = {}
    s["validations"] = s["validations"] + 1
    let errors = 0
    let first_error = ""
    let i = 0
    while i < s["rule_count"]
        let err = sv_check_field(s, data, i)
        if err != ""
            errors = errors + 1
            if first_error == ""
                first_error = err
        i = i + 1
    if errors > 0
        s["failures"] = s["failures"] + 1
    result["valid"] = errors == 0
    result["errors"] = errors
    result["first_error"] = first_error
    result["s"] = s
    result

fn sv_rule_count(s: dict) -> int
    s["rule_count"]

fn sv_failure_rate(s: dict) -> int
    if s["validations"] == 0
        return 0
    s["failures"] * 100 / s["validations"]
