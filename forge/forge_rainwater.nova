// forge_rainwater -- "trapping rain water": given an elevation profile (bar heights), compute how much water would
// pool in the dips after rain. Water sits above any bar up to the lower of the tallest wall to its LEFT and the
// tallest to its RIGHT, minus the bar's own height. The naive way recomputes those two maxima for every position;
// the two-pointer method walks inward from both ends, always advancing the side with the smaller wall (because
// that side's water level is then fixed by that smaller wall), and totals the trapped water in a single O(n) pass
// with O(1) memory. Beyond the famous interview puzzle it models real basin/terrain water retention, container
// fill between barriers, and "how much does this valley hold" over any 1-D height series. Also provided:
// the maximum water a container formed by TWO vertical lines can hold (the related two-pointer area problem).
// Non-negative integer heights. LEAF -- imports NOTHING.

// The total units of water trapped between the bars of `heights` after rain. O(n) two-pointer.
fn trapping_water(heights: list) -> int
    let n = len(heights)
    let water = 0
    if n >= 3
        let left = 0
        let right = n - 1
        let left_max = 0
        let right_max = 0
        while left < right
            if heights[left] < heights[right]
                if heights[left] >= left_max
                    left_max = heights[left]
                else
                    water += left_max - heights[left]
                left += 1
            else
                if heights[right] >= right_max
                    right_max = heights[right]
                else
                    water += right_max - heights[right]
                right -= 1
    water

// The most water a container can hold between two of the vertical lines at heights[i] (area = span * min height).
// The classic "container with most water" two-pointer problem.
fn max_container_area(heights: list) -> int
    let n = len(heights)
    let best = 0
    if n >= 2
        let left = 0
        let right = n - 1
        while left < right
            let h = heights[left]
            if heights[right] < h
                h = heights[right]
            let area = h * (right - left)
            if area > best
                best = area
            if heights[left] < heights[right]
                left += 1
            else
                right -= 1
    best
