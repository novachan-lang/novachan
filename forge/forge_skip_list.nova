// forge_skip_list — Probabilistic sorted list (flat dict, O(n) scan for simplicity).

fn sl_new() -> dict
    let s = {}
    s["keys"] = {}
    s["vals"] = {}
    s["count"] = 0
    s

fn sl_find_pos(s: dict, key: int) -> int
    let i = 0
    while i < s["count"]
        if s["keys"][str(i)] >= key
            return i
        i += 1
    s["count"]

fn sl_insert(s: dict, key: int, value: string) -> dict
    let pos = sl_find_pos(s, key)
    if pos < s["count"]
        if s["keys"][str(pos)] == key
            s["vals"][str(pos)] = value
            return s
    let i = s["count"]
    while i > pos
        let prev = str(i - 1)
        let cur = str(i)
        s["keys"][cur] = s["keys"][prev]
        s["vals"][cur] = s["vals"][prev]
        i -= 1
    s["keys"][str(pos)] = key
    s["vals"][str(pos)] = value
    s["count"] = s["count"] + 1
    s

fn sl_search(s: dict, key: int) -> dict
    let result = {}
    let pos = sl_find_pos(s, key)
    if pos < s["count"]
        if s["keys"][str(pos)] == key
            result["found"] = 1
            result["value"] = s["vals"][str(pos)]
            return result
    result["found"] = 0
    result["value"] = ""
    result

fn sl_remove(s: dict, key: int) -> dict
    let pos = sl_find_pos(s, key)
    if pos >= s["count"]
        return s
    if s["keys"][str(pos)] != key
        return s
    let i = pos
    while i < s["count"] - 1
        let next = str(i + 1)
        let cur = str(i)
        s["keys"][cur] = s["keys"][next]
        s["vals"][cur] = s["vals"][next]
        i += 1
    s["count"] = s["count"] - 1
    s

fn sl_count(s: dict) -> int
    s["count"]

fn sl_min_key(s: dict) -> int
    if s["count"] == 0
        return -1
    s["keys"]["0"]

fn sl_max_key(s: dict) -> int
    if s["count"] == 0
        return -1
    s["keys"][str(s["count"] - 1)]
