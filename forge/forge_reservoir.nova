// forge_reservoir -- reservoir sampling (Algorithm R): draw a uniform random sample of exactly k items from a
// stream/list WITHOUT knowing its length up front and in a single pass. This is how you sample log lines,
// subsample a huge dataset for a quick stat, or keep a bounded random set of recent events -- every item has an
// equal k/n chance of ending up in the sample, using only O(k) memory. Seeded (a deterministic LCG) so tests
// and reproducible pipelines get the SAME sample for the same seed. LEAF -- imports NOTHING.

// PRIVATE: one step of a 31-bit linear congruential generator.
fn _res_lcg(state: int) -> int
    (state * 1103515245 + 12345) & 2147483647

// Sample k items from `items` using `seed`. If the list has <= k items, all of them are returned (order kept).
// Otherwise every item has probability k/n of being included.
fn reservoir_sample(items: list, k: int, seed: int) -> list
    let n = len(items)
    let res = []
    if k <= 0
        return res
    // fill with the first k
    let f = 0
    while f < n and f < k
        push(res, items[f])
        f = f + 1
    if n <= k
        return res
    // replace with decreasing probability
    let state = seed
    let i = k
    while i < n
        state = _res_lcg(state)
        let j = state % (i + 1)
        if j < k
            res[j] = items[i]
        i = i + 1
    res
