// forge_env_resolver — Resolve environment-specific values by profile.

fn er_new(profile: string) -> dict
    {"profile": profile, "values": {}, "resolved": 0}

fn er_set(e: dict, profile: string, key: string, value: string) -> dict
    e["values"][profile + ":" + key] = value
    e

fn er_resolve(e: dict, key: string) -> string
    let pk = e["profile"] + ":" + key
    if pk in e["values"]
        e["resolved"] += 1
        return e["values"][pk]
    let dk = "default:" + key
    if dk in e["values"]
        e["resolved"] += 1
        return e["values"][dk]
    ""

fn er_has(e: dict, key: string) -> int
    let pk = e["profile"] + ":" + key
    if pk in e["values"]
        return 1
    let dk = "default:" + key
    if dk in e["values"]
        return 1
    0

fn er_profile(e: dict) -> string
    e["profile"]

fn er_switch_profile(e: dict, profile: string) -> dict
    e["profile"] = profile
    e

fn er_total_resolves(e: dict) -> int
    e["resolved"]
