// forge_recovery_codes -- 2FA backup / recovery codes: the printable codes a user saves to regain access if
// they lose their authenticator (pairs with forge_totp). Generate N high-entropy codes from CSPRNG bytes over
// an unambiguous alphabet (no 0/O/1/I/L) grouped with a dash ("7K4M-9PQR"). NUL-SAFE: bytes are read via
// bytes_get and mapped to alphabet CHARS -- never concatenated as raw bytes (see the string-NUL-truncation
// gotcha). Consume is single-use. Store code HASHES, show plaintext ONCE. LEAF -- imports NOTHING.

fn _rc_alpha() -> string
    "23456789ABCDEFGHJKMNPQRSTUVWXYZ"

// One code: `groups` groups of `glen` chars, dash-separated (groups=2 glen=4 -> "7K4M-9PQR").
fn _rc_one(groups: int, glen: int) -> string
    let alpha = _rc_alpha()
    let alen = len(alpha)
    let total = groups * glen
    let b = secure_bytes(total)
    let out = ""
    for i in 0..total
        if i > 0 and i % glen == 0
            out += "-"
        out += char_at(alpha, bytes_get(b, i) % alen)
    out

// Generate `n` recovery codes (each groups x glen chars).
fn recovery_codes(n: int, groups: int, glen: int) -> list
    let out = [_rc_one(groups, glen) for i in 0..n]
    out

// PRIVATE: normalize for comparison (strip dashes/spaces, uppercase) -- lenient entry.
fn _rc_norm(s: string) -> string
    let out_parts = []
    for i in 0..len(s)
        let c = char_at(s, i)
        if c != "-" and c != " "
            push(out_parts, c)
    let out = join(out_parts, "")
    upper(out)

// Consume a submitted code (single-use). Returns [found, remaining_codes]: if the code matched, it's removed
// from the returned set so it can't be reused. Case/dash-insensitive.
fn recovery_consume(codes: list, submitted: string) -> list
    let norm = _rc_norm(submitted)
    let remaining = []
    let found = false
    for i in 0..len(codes)
        if _rc_norm(codes[i]) == norm and not found
            found = true
        else
            push(remaining, codes[i])
    [found, remaining]
