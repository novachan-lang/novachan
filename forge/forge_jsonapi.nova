// forge_jsonapi -- JSON:API v1.0 (jsonapi.org) document builder: the other big hypermedia REST convention
// besides HAL (forge_hateoas). JSON:API standardizes resource objects (type + id + attributes), typed
// relationships (resource linkage), compound documents, and a rich error object shape -- it's what Ember Data
// and many public APIs speak. This module builds those documents as NOVA dicts and serializes them; the wire
// content type is "application/vnd.api+json". Composes the json_stringify builtin. LEAF -- imports NOTHING.

// The JSON:API media type -- set this as the response Content-Type.
fn jsonapi_content_type() -> string
    "application/vnd.api+json"

// A resource object: {type, id, attributes}. `type` names the collection ("articles"), `id` is the stable id.
fn jsonapi_resource(type_name: string, id: string, attributes: dict) -> dict
    let r = {}
    r["type"] = type_name
    r["id"] = id
    r["attributes"] = attributes
    r

// Attach a to-one relationship (resource linkage) to a resource object: resource.relationships[name] =
// {data: {type, id}}. Returns the (mutated) resource so calls can be chained.
fn jsonapi_relationship(resource: dict, name: string, related_type: string, related_id: string) -> dict
    let rels = {}
    if contains(resource, "relationships")
        rels = resource["relationships"]
    let ref = {}
    ref["type"] = related_type
    ref["id"] = related_id
    let linkage = {}
    linkage["data"] = ref
    rels[name] = linkage
    resource["relationships"] = rels
    resource

// Wrap resource data (a single resource dict OR a list of them) in a top-level document: {data: ...}.
fn jsonapi_document(data: any) -> dict
    let doc = {}
    doc["data"] = data
    doc

// An error object: {status, title, detail}. status is the HTTP status as a STRING per the spec.
fn jsonapi_error(status_code: int, title: string, detail: string) -> dict
    let e = {}
    e["status"] = str(status_code)
    e["title"] = title
    e["detail"] = detail
    e

// A top-level errors document: {errors: [...]}. Mutually exclusive with a data document per the spec.
fn jsonapi_errors(errors: list) -> dict
    let doc = {}
    doc["errors"] = errors
    doc

// Serialize any JSON:API document dict to its wire JSON string.
fn jsonapi_to_json(doc: dict) -> string
    json_stringify(doc)
