// forge_deployment_strategy — Deployment strategies.
// Blue-green, canary, rolling, traffic splitting.

fn deploy_new(name: string, strategy: string) -> dict
    {"name": name, "strategy": strategy, "versions": {}, "traffic": {}, "active": "", "rollback_target": "", "status": "idle"}

fn deploy_add_version(dep: dict, version: string) -> dict
    let v = {"status": "staged", "instances": 0}
    dep["versions"][version] = v
    dep["traffic"][version] = 0
    dep

fn deploy_set_active(dep: dict, version: string) -> dict
    let old = dep["active"]
    if len(old) > 0
        dep["rollback_target"] = old
    dep["active"] = version
    if version in dep["versions"]
        dep["versions"][version]["status"] = "active"
    dep

fn deploy_set_traffic(dep: dict, version: string, pct: int) -> dict
    dep["traffic"][version] = pct
    dep

fn deploy_get_traffic(dep: dict, version: string) -> int
    if version in dep["traffic"]
        return dep["traffic"][version]
    0

fn deploy_canary_start(dep: dict, new_version: string, canary_pct: int) -> dict
    dep = deploy_add_version(dep, new_version)
    dep["versions"][new_version]["status"] = "canary"
    dep["traffic"][new_version] = canary_pct
    let old = dep["active"]
    if len(old) > 0
        dep["traffic"][old] = 100 - canary_pct
    dep["status"] = "canary"
    dep

fn deploy_canary_promote(dep: dict, version: string) -> dict
    dep = deploy_set_active(dep, version)
    dep["traffic"][version] = 100
    let old = dep["rollback_target"]
    if len(old) > 0
        dep["traffic"][old] = 0
    dep["status"] = "active"
    dep

fn deploy_rollback(dep: dict) -> dict
    let target = dep["rollback_target"]
    if len(target) > 0
        let current = dep["active"]
        dep["traffic"][current] = 0
        dep["traffic"][target] = 100
        dep["active"] = target
        dep["status"] = "rolled_back"
    dep

fn deploy_status(dep: dict) -> string
    dep["status"]

fn deploy_active_version(dep: dict) -> string
    dep["active"]
