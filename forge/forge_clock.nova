// forge_clock -- format a time-of-day (HH:MM:SS, HH:MM, or 12-hour AM/PM) from seconds-since-midnight or epoch
// seconds. Complements forge_date (calendar dates) + forge_duration (elapsed spans). LEAF -- imports NOTHING.

fn _clk_z2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

// Seconds-of-day -> "HH:MM:SS" (24-hour).
fn clock_hms(sec_of_day: int) -> string
    let s = sec_of_day % 86400
    _clk_z2(s / 3600) + ":" + _clk_z2((s % 3600) / 60) + ":" + _clk_z2(s % 60)

// Seconds-of-day -> "HH:MM" (24-hour).
fn clock_hm(sec_of_day: int) -> string
    let s = sec_of_day % 86400
    _clk_z2(s / 3600) + ":" + _clk_z2((s % 3600) / 60)

// Seconds-of-day -> 12-hour "H:MM AM/PM".
fn clock_12h(sec_of_day: int) -> string
    let s = sec_of_day % 86400
    let h24 = s / 3600
    let m = (s % 3600) / 60
    let ap = "AM"
    let h12 = h24
    if h24 == 0
        h12 = 12
    else
        if h24 == 12
            ap = "PM"
        else
            if h24 > 12
                h12 = h24 - 12
                ap = "PM"
    str(h12) + ":" + _clk_z2(m) + " " + ap

// Epoch seconds -> "HH:MM:SS" (UTC time-of-day).
fn clock_from_epoch(epoch: int) -> string
    clock_hms(epoch % 86400)
