// forge_input_sanitizer — Sanitize user input (strip tags, limit length).

fn san_new() -> dict
    {"max_length": 1000, "sanitized": 0, "truncated": 0, "stripped": 0}

fn san_set_max_length(s: dict, max_len: int) -> dict
    s["max_length"] = max_len
    s

fn san_strip_char(input: string, ch: string) -> string
    let result_parts = []
    for i in 0..len(input)
        let c = input[i]
        if c != ch
            push(result_parts, c)
    join(result_parts, "")

fn san_sanitize(s: dict, input: string) -> dict
    let out = input
    let was_stripped = 0
    let lt = "<"
    let gt = ">"
    if len(out) > 0
        let cleaned = san_strip_char(out, lt)
        if len(cleaned) != len(out)
            was_stripped = 1
        out = cleaned
        let cleaned2 = san_strip_char(out, gt)
        if len(cleaned2) != len(out)
            was_stripped = 1
        out = cleaned2
    if was_stripped == 1
        s["stripped"] += 1
    let was_truncated = 0
    if len(out) > s["max_length"]
        out = slice(out, 0, s["max_length"])
        was_truncated = 1
        s["truncated"] += 1
    s["sanitized"] += 1
    {"output": out, "truncated": was_truncated, "stripped": was_stripped, "s": s}

fn san_total_sanitized(s: dict) -> int
    s["sanitized"]

fn san_total_truncated(s: dict) -> int
    s["truncated"]

fn san_total_stripped(s: dict) -> int
    s["stripped"]
