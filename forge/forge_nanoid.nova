// forge_nanoid -- NanoID generation: a compact, URL-safe, collision-resistant random id (the popular JS-
// ecosystem UUID alternative -- 21 chars gives ~126 bits, smaller than a UUID and URL-safe with no dashes).
// Default alphabet A-Za-z0-9_- (64 symbols; 64 divides 256 -> uniform, no modulo bias). NUL-SAFE: CSPRNG bytes
// are read via bytes_get and mapped to alphabet chars (never raw-byte concatenated). LEAF -- imports NOTHING.

fn _nanoid_alpha() -> string
    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-"

// A NanoID of `size` chars over the default 64-symbol URL-safe alphabet.
fn nanoid(size: int) -> string
    let alpha = _nanoid_alpha()
    let b = secure_bytes(size)
    let out = ""
    let i = 0
    while i < size
        out = out + char_at(alpha, bytes_get(b, i) % 64)
        i = i + 1
    out

// The conventional 21-char NanoID.
fn nanoid_default() -> string
    nanoid(21)

// A NanoID over a CUSTOM alphabet (e.g. a no-ambiguous-chars set). Non-power-of-two alphabets have a slight
// modulo bias -- negligible for ids; use nanoid() for the unbiased 64-symbol set.
fn nanoid_custom(alphabet: string, size: int) -> string
    let alen = len(alphabet)
    if alen == 0
        return ""
    let b = secure_bytes(size)
    let out = ""
    let i = 0
    while i < size
        out = out + char_at(alphabet, bytes_get(b, i) % alen)
        i = i + 1
    out
