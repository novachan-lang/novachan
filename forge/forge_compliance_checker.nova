// forge_compliance_checker — Compliance checking (Sentinel). Two
// complementary APIs share one file:
//
//   1. Field-record validation (cc_add_field_rule / cc_validate_record /
//      cc_field_compliance_rate / ...): validate individual data RECORDS
//      against structural rules ("field X must be present / non-empty").
//      This is the original API — kept intact, renamed only where its
//      old names collided with API #2 below.
//
//   2. Named compliance-rule tracking (cc_add_rule / cc_check / ...):
//      register named rules with a severity, then record pass/fail
//      OUTCOMES against them over time (e.g. periodic control checks),
//      and report aggregate compliance rate / critical-failure counts.
//
// The two APIs are independent and share no state fields.

fn cc_new() -> dict
    let c = {}
    c["rules"] = {}
    c["field_rule_count"] = 0
    c["checks"] = 0
    c["violations"] = 0
    c["nrule_count"] = 0
    c["ntotal"] = 0
    c["npassed"] = 0
    c["nfailed"] = 0
    c["ncritical_fail"] = 0
    c

// --- API #1: field-record validation ------------------------------------

// cc_add_field_rule(c, name, rule_type, field) -> dict
// rule_type: "required" (field must be present) or "not_empty" (field
// must be present and non-empty).
fn cc_add_field_rule(c: dict, name: string, rule_type: string, field: string) -> dict
    let k = str(c["field_rule_count"])
    c["rules"][k + "_name"] = name
    c["rules"][k + "_type"] = rule_type
    c["rules"][k + "_field"] = field
    c["field_rule_count"] = c["field_rule_count"] + 1
    c

// cc_validate_record(c, data) -> dict
// Validate `data` against every registered field rule. Returns a dict
// with "compliant"/"violations"/"first_violation"/"c" (the updated
// checker state — reassign it: c = result["c"]).
fn cc_validate_record(c: dict, data: dict) -> dict
    let result = {}
    c["checks"] = c["checks"] + 1
    let violations = 0
    let first_violation = ""
    let i = 0
    while i < c["field_rule_count"]
        let k = str(i)
        let rule_type = c["rules"][k + "_type"]
        let field = c["rules"][k + "_field"]
        let has = contains(data, field)
        if rule_type == "required"
            if has != true
                violations += 1
                if first_violation == ""
                    first_violation = c["rules"][k + "_name"]
        if rule_type == "not_empty"
            if has == true
                if data[field] == ""
                    violations += 1
                    if first_violation == ""
                        first_violation = c["rules"][k + "_name"]
        i += 1
    if violations > 0
        c["violations"] = c["violations"] + 1
    result["compliant"] = violations == 0
    result["violations"] = violations
    result["first_violation"] = first_violation
    result["c"] = c
    result

// cc_field_compliance_rate(c) -> int
fn cc_field_compliance_rate(c: dict) -> int
    if c["checks"] == 0
        return 100
    (c["checks"] - c["violations"]) * 100 / c["checks"]

// cc_field_checks_total(c) -> int
fn cc_field_checks_total(c: dict) -> int
    c["checks"]

// cc_field_rule_count(c) -> int
fn cc_field_rule_count(c: dict) -> int
    c["field_rule_count"]

// --- API #2: named compliance-rule tracking -----------------------------

// cc_add_rule(state, rule_id, description, severity) -> dict
// severity: "critical"/"high"/"medium"/"low". Re-adding an existing
// rule_id updates its description/severity without resetting its
// pass/fail history.
fn cc_add_rule(state: dict, rule_id: string, description: string, severity: string) -> dict
    let dk = "r_desc_" + rule_id
    if dk not in state
        state["nrule_count"] = state["nrule_count"] + 1
    state[dk] = description
    state["r_sev_" + rule_id] = severity
    state

// cc_check(state, rule_id, passed) -> Result
// Record a check outcome (1=passed, 0=failed) against a registered rule.
// ok(state), or err if rule_id was never registered via cc_add_rule.
fn cc_check(state: dict, rule_id: string, passed: int) -> Result
    let dk = "r_desc_" + rule_id
    if dk not in state
        return err("unknown rule: " + rule_id)
    state["ntotal"] = state["ntotal"] + 1
    if passed == 1
        state["npassed"] = state["npassed"] + 1
    else
        state["nfailed"] = state["nfailed"] + 1
        let sev = state["r_sev_" + rule_id]
        if sev == "critical"
            state["ncritical_fail"] = state["ncritical_fail"] + 1
    ok(state)

// cc_passed_count(state) -> int
fn cc_passed_count(state: dict) -> int
    state["npassed"]

// cc_failed_count(state) -> int
fn cc_failed_count(state: dict) -> int
    state["nfailed"]

// cc_total_checks(state) -> int
fn cc_total_checks(state: dict) -> int
    state["ntotal"]

// cc_compliance_rate(state) -> Result
// ok(percentage of checks that passed), or err if no checks recorded yet.
fn cc_compliance_rate(state: dict) -> Result
    if state["ntotal"] == 0
        return err("no checks recorded")
    ok(state["npassed"] * 100 / state["ntotal"])

// cc_critical_failures(state) -> int
fn cc_critical_failures(state: dict) -> int
    state["ncritical_fail"]

// cc_rule_count(state) -> int
fn cc_rule_count(state: dict) -> int
    state["nrule_count"]

// cc_has_rule(state, rule_id) -> int
fn cc_has_rule(state: dict, rule_id: string) -> int
    if ("r_desc_" + rule_id) in state
        return 1
    0
