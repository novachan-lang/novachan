// forge_compliance_checker — Check compliance rules against data.

fn cc_new() -> dict
    let c = {}
    c["rules"] = {}
    c["rule_count"] = 0
    c["checks"] = 0
    c["violations"] = 0
    c

fn cc_add_rule(c: dict, name: string, rule_type: string, field: string) -> dict
    let k = str(c["rule_count"])
    c["rules"][k + "_name"] = name
    c["rules"][k + "_type"] = rule_type
    c["rules"][k + "_field"] = field
    c["rule_count"] = c["rule_count"] + 1
    c

fn cc_check(c: dict, data: dict) -> dict
    let result = {}
    c["checks"] = c["checks"] + 1
    let violations = 0
    let first_violation = ""
    let i = 0
    while i < c["rule_count"]
        let k = str(i)
        let rule_type = c["rules"][k + "_type"]
        let field = c["rules"][k + "_field"]
        let has = contains(data, field)
        if rule_type == "required"
            if has != true
                violations = violations + 1
                if first_violation == ""
                    first_violation = c["rules"][k + "_name"]
        if rule_type == "not_empty"
            if has == true
                if data[field] == ""
                    violations = violations + 1
                    if first_violation == ""
                        first_violation = c["rules"][k + "_name"]
        i = i + 1
    if violations > 0
        c["violations"] = c["violations"] + 1
    result["compliant"] = violations == 0
    result["violations"] = violations
    result["first_violation"] = first_violation
    result["c"] = c
    result

fn cc_compliance_rate(c: dict) -> int
    if c["checks"] == 0
        return 100
    (c["checks"] - c["violations"]) * 100 / c["checks"]

fn cc_total_checks(c: dict) -> int
    c["checks"]

fn cc_rule_count(c: dict) -> int
    c["rule_count"]
