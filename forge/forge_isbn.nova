// forge_isbn -- ISBN-10 / ISBN-13 book identifier validation + conversion. ISBN-13 uses the EAN-13 mod-10
// check; ISBN-10 uses a mod-11 check whose last digit may be 'X' (=10). Accepts hyphens/spaces. Any library,
// bookstore, or publishing app needs this. LEAF -- imports NOTHING.

// PRIVATE: strip hyphens/spaces, uppercase (so an 'x' check digit becomes 'X').
fn _isbn_clean(s: string) -> string
    let out_parts = []
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        if c != "-" and c != " "
            push(out_parts, c)
        i += 1
    let out = join(out_parts, "")
    upper(out)

// ISBN-10: sum(d_i * (10 - i)) % 11 == 0, i=0..9, last digit may be X=10.
fn isbn10_valid(s: string) -> bool
    let d = _isbn_clean(s)
    if len(d) != 10
        return false
    let sum = 0
    for i in 0..10
        let c = char_at(d, i)
        let v = find("0123456789", c)
        if v < 0
            if i == 9 and c == "X"
                v = 10
            else
                return false
        sum += v * (10 - i)
    sum % 11 == 0

// ISBN-13: EAN-13 mod-10, alternating weights 1 and 3.
fn isbn13_valid(s: string) -> bool
    let d = _isbn_clean(s)
    if len(d) != 13
        return false
    let sum = 0
    for i in 0..13
        let v = find("0123456789", char_at(d, i))
        if v < 0
            return false
        if i % 2 == 0
            sum += v
        else
            sum += v * 3
    sum % 10 == 0

// Valid ISBN (10 or 13) by length.
fn isbn_valid(s: string) -> bool
    let d = _isbn_clean(s)
    if len(d) == 10
        return isbn10_valid(d)
    if len(d) == 13
        return isbn13_valid(d)
    false

// Convert a valid ISBN-10 to ISBN-13 (prefix 978 + first 9 digits + a fresh mod-10 check). "" if invalid.
fn isbn10_to_13(s: string) -> string
    let d = _isbn_clean(s)
    if isbn10_valid(d) == false
        return ""
    let body = "978" + slice(d, 0, 9)
    let sum = 0
    for i in 0..12
        let v = find("0123456789", char_at(body, i))
        if i % 2 == 0
            sum += v
        else
            sum += v * 3
    let check = (10 - (sum % 10)) % 10
    body + str(check)
