// ══════════════════════════════════════════════════════════════════════════════
// ⚠ NOT THE LIVE FORGE SESSION MECHANISM -- DO NOT IMPORT FOR REAL HTTP SESSIONS ⚠
// BOTH APIs in this file (the actor-backed session_get/session_set/session_store_new
// below, AND the flat-dict ss_* API further down) are standalone session-management
// scaffolds. NEITHER is wired into forge.nova's request/response pipeline, and
// NEITHER is used by mw_require_auth or the CSRF machinery. The REAL, actually-used
// session mechanism lives in forge.nova:
//     session_set(resp: Response, secret: string, value: string) -> Response   // signs + sets cookie
//     session_get(req: Request, secret: string) -> string                     // verifies + reads cookie
// DANGER: this file's `session_get(s, sid: string) -> any` and
// `session_set(s, sid: string, data)` have the SAME NAMES as forge.nova's real
// session_get(req, secret) / session_set(resp, secret, value) but a COMPLETELY
// DIFFERENT signature and meaning (an in-process actor keyed by a bare session id,
// no cookie, no signing, no HMAC integrity check). Importing this module alongside
// forge.nova risks a silent name collision on a security-relevant code path -- a
// caller could end up on this unsigned, unauthenticated session store instead of
// forge.nova's signed-cookie one with no compile error to warn them. For real HTTP
// session handling, use forge.nova's session_get / session_set directly.
// ══════════════════════════════════════════════════════════════════════════════
// forge_session_store -- a pluggable SESSION backend as a single-owner ACTOR (a Redis/DB store swaps behind
// the same API later). session data is a dict keyed by session id. Actor-backed -> race-free under N>1.
// LEAF -- built-ins channel/spawn/send/receive/contains only.

fn _ss_loop(s)
    let sessions = {}
    let running = 1
    while running == 1
        let env = receive(s["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "set"
            sessions[env["sid"]] = env["data"]
        else if op == "get"
            if contains(sessions, env["sid"])
                send(env["reply"], sessions[env["sid"]])
            else
                send(env["reply"], {})
        else if op == "del"
            sessions[env["sid"]] = {}

// NOT forge.nova's session_get/session_set -- see the file-top warning banner. This is an
// actor-backed store keyed by a bare session id, not a signed cookie.
fn session_store_new() -> any
    let s = {}
    s["req"] = channel()
    spawn _ss_loop(s)
    s

fn session_set(s, sid: string, data)
    let env = {}
    env["op"] = "set"
    env["sid"] = sid
    env["data"] = data
    send(s["req"], env)

fn session_get(s, sid: string) -> any
    let rc = channel()
    let env = {}
    env["op"] = "get"
    env["sid"] = sid
    env["reply"] = rc
    send(s["req"], env)
    receive(rc)

fn session_destroy(s, sid: string)
    let env = {}
    env["op"] = "del"
    env["sid"] = sid
    send(s["req"], env)

fn session_store_stop(s)
    let env = {}
    env["op"] = "stop"
    send(s["req"], env)

// ── ss_* API: a plain flat-dict session STORE with per-session data + TTL bookkeeping ──────────────
// Distinct from the actor-based session_* API above (that one is unused elsewhere in the tree today;
// kept for backward compatibility). This API is synchronous, single-owner-by-convention (the caller
// holds `state` and threads it through calls) -- no channel/spawn, matching forge_header_map's style.
// Keying scheme (flat dict, no nested dicts/lists per NOVA stdlib convention):
//   "sx_<sid>_active"       -> 1 while the session is live, 0 after ss_destroy (tombstone, not deleted)
//   "sx_<sid>_user"         -> the user_id string bound at ss_create
//   "sx_<sid>_last_access"  -> last ss_touch timestamp (int)
//   "sxd_<sid>_<key>"       -> per-session custom data value
//   "su_<user_id>_count"    -> live session count for that user (for ss_user_sessions)
//   "session_count"         -> total live sessions
//   "default_ttl"           -> the TTL new sessions are conceptually created with (informational;
//                              actual expiry enforcement is the caller's job via ss_touch + this TTL)

// ss_new: create a fresh session store. default_ttl is seconds; stored for callers to consult when
// deciding if a session (via its last_access) has expired.
fn ss_new(default_ttl: int) -> dict
    let s = {}
    s["default_ttl"] = default_ttl
    s["session_count"] = 0
    s

// ss_create: bind session_id -> user_id, marking it active. Re-creating an already-active session_id
// rebinds its user_id without double-counting session_count/user counters.
fn ss_create(state: dict, session_id: string, user_id: string) -> dict
    let k_active = "sx_" + session_id + "_active"
    let already_active = 0
    if contains(state, k_active)
        if state[k_active] == 1
            already_active = 1
    state[k_active] = 1
    state["sx_" + session_id + "_user"] = user_id
    state["sx_" + session_id + "_last_access"] = 0
    if already_active == 0
        state["session_count"] = state["session_count"] + 1
        let uk = "su_" + user_id + "_count"
        if contains(state, uk)
            state[uk] = state[uk] + 1
        else
            state[uk] = 1
    state

// ss_is_valid: 1 if session_id exists and is currently active, else 0.
fn ss_is_valid(state: dict, session_id: string) -> int
    let k_active = "sx_" + session_id + "_active"
    if contains(state, k_active) != true
        return 0
    if state[k_active] == 1
        return 1
    0

// ss_get_user: the user_id bound to session_id, or Err if the session is missing/destroyed.
fn ss_get_user(state: dict, session_id: string) -> Result
    if ss_is_valid(state, session_id) != 1
        return err("session not found: " + session_id)
    ok(state["sx_" + session_id + "_user"])

// ss_set_data: store a per-session key/value. Err if the session is missing/destroyed.
fn ss_set_data(state: dict, session_id: string, key: string, value: string) -> Result
    if ss_is_valid(state, session_id) != 1
        return err("session not found: " + session_id)
    state["sxd_" + session_id + "_" + key] = value
    ok(value)

// ss_get_data: read a per-session key. Err if the session is missing/destroyed, or if the key was
// never set for this session.
fn ss_get_data(state: dict, session_id: string, key: string) -> Result
    if ss_is_valid(state, session_id) != 1
        return err("session not found: " + session_id)
    let dk = "sxd_" + session_id + "_" + key
    if contains(state, dk) != true
        return err("session data key not found: " + key)
    ok(state[dk])

// ss_destroy: tombstone the session (NOVA dicts cannot delete keys), decrementing session_count and
// the owning user's live-session count. Err if the session was already missing/destroyed.
fn ss_destroy(state: dict, session_id: string) -> Result
    if ss_is_valid(state, session_id) != 1
        return err("session not found: " + session_id)
    let uid = state["sx_" + session_id + "_user"]
    state["sx_" + session_id + "_active"] = 0
    state["session_count"] = state["session_count"] - 1
    let uk = "su_" + uid + "_count"
    if contains(state, uk)
        if state[uk] > 0
            state[uk] = state[uk] - 1
    ok(session_id)

// ss_touch: update the last-access timestamp (caller-supplied clock value). Err if the session is
// missing/destroyed.
fn ss_touch(state: dict, session_id: string, timestamp: int) -> Result
    if ss_is_valid(state, session_id) != 1
        return err("session not found: " + session_id)
    state["sx_" + session_id + "_last_access"] = timestamp
    ok(timestamp)

// ss_session_count: total number of currently-active sessions.
fn ss_session_count(state: dict) -> int
    state["session_count"]

// ss_user_sessions: number of currently-active sessions bound to user_id (0 if the user has none).
fn ss_user_sessions(state: dict, user_id: string) -> int
    let uk = "su_" + user_id + "_count"
    if contains(state, uk)
        return state[uk]
    0
