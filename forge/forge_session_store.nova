// forge_session_store -- a pluggable SESSION backend as a single-owner ACTOR (a Redis/DB store swaps behind
// the same API later). session data is a dict keyed by session id. Actor-backed -> race-free under N>1.
// LEAF -- built-ins channel/spawn/send/receive/contains only.

fn _ss_loop(s)
    let sessions = {}
    let running = 1
    while running == 1
        let env = receive(s["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "set"
            sessions[env["sid"]] = env["data"]
        else if op == "get"
            if contains(sessions, env["sid"])
                send(env["reply"], sessions[env["sid"]])
            else
                send(env["reply"], {})
        else if op == "del"
            sessions[env["sid"]] = {}

fn session_store_new() -> any
    let s = {}
    s["req"] = channel()
    spawn _ss_loop(s)
    s

fn session_set(s, sid: string, data)
    let env = {}
    env["op"] = "set"
    env["sid"] = sid
    env["data"] = data
    send(s["req"], env)

fn session_get(s, sid: string) -> any
    let rc = channel()
    let env = {}
    env["op"] = "get"
    env["sid"] = sid
    env["reply"] = rc
    send(s["req"], env)
    receive(rc)

fn session_destroy(s, sid: string)
    let env = {}
    env["op"] = "del"
    env["sid"] = sid
    send(s["req"], env)

fn session_store_stop(s)
    let env = {}
    env["op"] = "stop"
    send(s["req"], env)
