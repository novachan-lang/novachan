// forge_random_pick -- cryptographically-random selection from a list: pick one, shuffle (Fisher-Yates), and
// sample N without replacement. For A/B bucketing, raffles/giveaways, randomized ordering, and sampling. Uses
// the CSPRNG (secure_bytes). LEAF -- imports NOTHING.

// PRIVATE: a uniform-ish random int in [0, n) from 4 CSPRNG bytes (slight modulo bias, fine for selection).
fn _rp_rand(n: int) -> int
    let b = secure_bytes(4)
    let v = bytes_get(b, 0) * 16777216 + bytes_get(b, 1) * 65536 + bytes_get(b, 2) * 256 + bytes_get(b, 3)
    v % n

// Pick one random element ("" if empty).
fn pick_one(items: list) -> any
    if len(items) == 0
        return ""
    items[_rp_rand(len(items))]

// A shuffled COPY of the list (Fisher-Yates).
fn shuffle(items: list) -> list
    let out = [items[i] for i in 0..len(items)]
    let j = len(out) - 1
    while j > 0
        let k = _rp_rand(j + 1)
        let tmp = out[j]
        out[j] = out[k]
        out[k] = tmp
        j -= 1
    out

// Sample `n` distinct items without replacement (fewer if n > len).
fn sample(items: list, n: int) -> list
    let sh = shuffle(items)
    let out = [sh[i] for i in 0..min(n, len(sh))]
    out
