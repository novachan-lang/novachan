// forge_hmac_signer — Simple HMAC-like signing with Result.

fn hmac_sign(key: string, message: string) -> int
    let h = 0
    for i in 0..len(key)
        h = h * 53 + ord(key[i])
    for j in 0..len(message)
        h = h * 31 + ord(message[j])
    if h < 0
        h = -h
    h

fn hmac_verify(key: string, message: string, signature: int) -> Result
    let expected = hmac_sign(key, message)
    if expected != signature
        return err("signature mismatch")
    ok(1)

fn hmac_sign_with_timestamp(key: string, message: string, timestamp: int) -> int
    let full = message + ":" + str(timestamp)
    hmac_sign(key, full)

fn hmac_verify_with_timestamp(key: string, message: string, timestamp: int, signature: int, now: int, max_age: int) -> Result
    if now - timestamp > max_age
        return err("signature expired")
    let full = message + ":" + str(timestamp)
    let expected = hmac_sign(key, full)
    if expected != signature
        return err("signature mismatch")
    ok(1)
