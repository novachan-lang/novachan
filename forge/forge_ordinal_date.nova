// forge_ordinal_date -- day-of-year (ordinal date, 1..366) + week-of-year. For "day 184 of 365", progress-of-
// year bars, and simple week numbering. Composes forge_date. Imports forge_date.
import forge_date

// Day of the year (Jan 1 = 1). date_day_of_year(2026,7,3) -> 184.
fn date_day_of_year(y: int, m: int, d: int) -> int
    date_diff_days(y, 1, 1, y, m, d) + 1

// Week of the year (1-based, simple 7-day blocks from Jan 1).
fn date_week_of_year(y: int, m: int, d: int) -> int
    (date_day_of_year(y, m, d) - 1) / 7 + 1

// Days remaining in the year (after this date).
fn date_days_left_in_year(y: int, m: int, d: int) -> int
    let total = 365
    if is_leap(y)
        total = 366
    total - date_day_of_year(y, m, d)
