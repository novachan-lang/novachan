// forge_hammingcode -- the Hamming(7,4) error-CORRECTING code: encode 4 data bits into 7 by adding 3 parity bits,
// and on the way back not only DETECT a single flipped bit but pinpoint WHICH one and fix it. Checksums and CRCs
// (forge_crc32) tell you data got corrupted; Hamming codes let the receiver REPAIR a single-bit error with no
// retransmission, which is why the same idea guards RAM (ECC memory), spacecraft telemetry, QR codes, and flash
// storage. The trick is that the three parity bits sit at power-of-two positions and each covers a different
// subset of bits, so when a bit flips the failing parity checks spell out its position in binary (the "syndrome").
// This module is the classic 7,4 form: it corrects any single-bit error exactly. Data and code are bit lists
// (each element 0 or 1). LEAF -- imports NOTHING.

// Encode 4 data bits [d1,d2,d3,d4] into a 7-bit Hamming codeword [p1,p2,d1,p3,d2,d3,d4] (positions 1..7).
fn ham_encode(data: list) -> list
    let d1 = data[0]
    let d2 = data[1]
    let d3 = data[2]
    let d4 = data[3]
    let p1 = d1 ^ d2 ^ d4
    let p2 = d1 ^ d3 ^ d4
    let p3 = d2 ^ d3 ^ d4
    [p1, p2, d1, p3, d2, d3, d4]

// Decode a 7-bit codeword, correcting any single-bit error. Returns [data4, error_position] where error_position
// is 0 if the codeword was clean, or the 1-based position (1..7) of the bit that was flipped and repaired.
fn ham_decode(code: list) -> list
    let c = [code[i] for i in 0..7]
    // syndrome bits from the three parity groups
    let s1 = c[0] ^ c[2] ^ c[4] ^ c[6]
    let s2 = c[1] ^ c[2] ^ c[5] ^ c[6]
    let s3 = c[3] ^ c[4] ^ c[5] ^ c[6]
    let syndrome = s1 + s2 * 2 + s3 * 4
    if syndrome != 0
        // flip the erroneous bit (positions are 1-based)
        c[syndrome - 1] = c[syndrome - 1] ^ 1
    let data = [c[2], c[4], c[5], c[6]]
    [data, syndrome]

// The 4 recovered data bits from a codeword (single-error-corrected), discarding the error position.
fn ham_data(code: list) -> list
    let r = ham_decode(code)
    r[0]
