// forge_hooks -- S16: model lifecycle callbacks (Rails before_save/after_create, Django signals, JPA
// @PrePersist/@PostPersist). Register hooks per (table, event); run them around a save/delete. Events:
// "before_save"/"after_save"/"before_delete"/"after_delete". A hook is fn(row) -> row: before_* hooks may
// TRANSFORM the row (validation defaults, slug generation, audit stamps); after_* hooks observe (return the
// row unchanged, or fire side effects). run_hooks threads the row through every hook in registration order.
//
// LEAF MODULE -- imports NOTHING. Built-ins: contains, push, len.

fn hooks_new() -> dict
    {}

// Register a hook for (table, event). Many hooks per key, run in order. Fluent.
fn on_hook(hooks: dict, table: string, event: string, hook) -> dict
    let key = table + ":" + event
    if key not in hooks
        hooks[key] = []
    push(hooks[key], hook)
    hooks

// Run every hook for (table, event), threading `row` through each (before_* may transform it). Returns the
// final row (unchanged if no hooks registered).
fn run_hooks(hooks: dict, table: string, event: string, row) -> any
    let key = table + ":" + event
    if key not in hooks
        return row
    let arr = hooks[key]
    let cur = row
    for i in 0..len(arr)
        let h = arr[i]
        cur = h(cur)
    cur
