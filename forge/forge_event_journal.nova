// forge_event_journal — append-only event journal with Result API.

fn ej_new() -> dict
    {"events": {}, "count": 0, "types": {}}

fn ej_append(j: dict, event_type: string, payload: string, timestamp: int) -> dict
    let key = "e_" + str(j["count"])
    j["events"][key] = event_type + "|" + payload + "|" + str(timestamp)
    let tk = "et_" + key
    j["events"][tk] = event_type
    let pk = "ep_" + key
    j["events"][pk] = payload
    let tsk = "ts_" + key
    j["events"][tsk] = timestamp
    let tc = "tc_" + event_type
    if tc in j["types"]
        j["types"][tc] += 1
    else
        j["types"][tc] = 1
    j["count"] += 1
    j

fn ej_get(j: dict, index: int) -> Result
    if index < 0 or index >= j["count"]
        return err("index out of range")
    let pk = "ep_" + "e_" + str(index)
    ok(j["events"][pk])

fn ej_type_at(j: dict, index: int) -> Result
    if index < 0 or index >= j["count"]
        return err("index out of range")
    let tk = "et_" + "e_" + str(index)
    ok(j["events"][tk])

fn ej_count_by_type(j: dict, event_type: string) -> int
    let tc = "tc_" + event_type
    if tc in j["types"]
        return j["types"][tc]
    0

fn ej_count(j: dict) -> int
    j["count"]
