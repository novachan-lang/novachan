// forge_read_repair — Read repair for eventual consistency.
// On read, compare replicas, repair stale ones.

fn rr_new() -> dict
    {"stores": {}, "repairs": 0, "reads": 0}

fn rr_add_store(rr: dict, name: string) -> dict
    rr["stores"][name] = {}
    rr

fn rr_write(rr: dict, store: string, key: string, value: string, version: int) -> dict
    if store not in rr["stores"]
        return rr
    let entry = {"value": value, "version": version}
    rr["stores"][store][key] = entry
    rr

fn rr_read(rr: dict, key: string) -> dict
    rr["reads"] += 1
    let result = {"value": "", "version": 0, "stale_count": 0}
    let best_store = ""
    let store_names = keys(rr["stores"])
    for i in 0..len(store_names)
        let s = store_names[i]
        if key in rr["stores"][s]
            let v = rr["stores"][s][key]["version"]
            if v > result["version"]
                result["version"] = v
                result["value"] = rr["stores"][s][key]["value"]
                best_store = s
    if result["version"] > 0
        for j in 0..len(store_names)
            let s = store_names[j]
            if key in rr["stores"][s]
                if rr["stores"][s][key]["version"] < result["version"]
                    rr["stores"][s][key]["value"] = result["value"]
                    rr["stores"][s][key]["version"] = result["version"]
                    rr["repairs"] += 1
                    result["stale_count"] += 1
            else
                rr["stores"][s][key] = rr["stores"][best_store][key]
                rr["repairs"] += 1
                result["stale_count"] += 1
    result

fn rr_total_repairs(rr: dict) -> int
    rr["repairs"]

fn rr_total_reads(rr: dict) -> int
    rr["reads"]

fn rr_store_count(rr: dict) -> int
    len(keys(rr["stores"]))
