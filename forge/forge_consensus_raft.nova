// forge_consensus_raft — Simplified Raft consensus state machine.
// Leader election, log replication state, term management.

fn raft_new(node_id: string, peers: int) -> dict
    let r = {}
    r["node_id"] = node_id
    r["state"] = "follower"
    r["term"] = 0
    r["voted_for"] = ""
    r["peers"] = peers
    r["votes_received"] = 0
    r["log"] = []
    r["commit_index"] = 0
    r["leader"] = ""
    r

fn raft_start_election(r: dict) -> dict
    r["term"] = r["term"] + 1
    r["state"] = "candidate"
    r["voted_for"] = r["node_id"]
    r["votes_received"] = 1
    r

fn raft_receive_vote(r: dict) -> dict
    r["votes_received"] = r["votes_received"] + 1
    let majority = (r["peers"] / 2) + 1
    if r["votes_received"] >= majority
        r["state"] = "leader"
        r["leader"] = r["node_id"]
    r

fn raft_step_down(r: dict, new_term: int, leader: string) -> dict
    r["term"] = new_term
    r["state"] = "follower"
    r["voted_for"] = ""
    r["votes_received"] = 0
    r["leader"] = leader
    r

fn raft_append_entry(r: dict, data: string) -> dict
    if r["state"] != "leader"
        return r
    let entry = {}
    entry["term"] = r["term"]
    entry["data"] = data
    entry["index"] = len(r["log"]) + 1
    push(r["log"], entry)
    r

fn raft_commit(r: dict, index: int) -> dict
    r["commit_index"] = index
    r

fn raft_state(r: dict) -> string
    r["state"]

fn raft_term(r: dict) -> int
    r["term"]

fn raft_leader(r: dict) -> string
    r["leader"]

fn raft_log_length(r: dict) -> int
    len(r["log"])

fn raft_commit_index(r: dict) -> int
    r["commit_index"]

fn raft_is_leader(r: dict) -> int
    if r["state"] == "leader"
        return 1
    0
