// forge_api_key_manager — API key management with scopes.

fn akm_new() -> dict
    let a = {}
    a["keys"] = {}
    a["scopes"] = {}
    a["active"] = {}
    a["usage"] = {}
    a["total_keys"] = 0
    a

fn akm_create(a: dict, key: string, scope: string) -> dict
    a["keys"][key] = 1
    a["scopes"][key] = scope
    a["active"][key] = 1
    a["usage"][key] = 0
    a["total_keys"] = a["total_keys"] + 1
    a

fn akm_validate(a: dict, key: string, required_scope: string) -> dict
    let result = {}
    let has = contains(a["keys"], key)
    if has != true
        result["valid"] = 0
        result["reason"] = "not_found"
        result["a"] = a
        return result
    if a["active"][key] != 1
        result["valid"] = 0
        result["reason"] = "revoked"
        result["a"] = a
        return result
    let scope = a["scopes"][key]
    if scope != required_scope
        if scope != "admin"
            result["valid"] = 0
            result["reason"] = "insufficient_scope"
            result["a"] = a
            return result
    a["usage"][key] = a["usage"][key] + 1
    result["valid"] = 1
    result["reason"] = ""
    result["a"] = a
    result

fn akm_revoke(a: dict, key: string) -> dict
    let has = contains(a["active"], key)
    if has == true
        a["active"][key] = 0
    a

fn akm_usage(a: dict, key: string) -> int
    let has = contains(a["usage"], key)
    if has != true
        return 0
    a["usage"][key]

fn akm_scope(a: dict, key: string) -> string
    let has = contains(a["scopes"], key)
    if has != true
        return ""
    a["scopes"][key]

fn akm_active_count(a: dict) -> int
    let ks = keys(a["active"])
    let count = 0
    for i in 0..len(ks)
        if a["active"][ks[i]] == 1
            count += 1
    count
