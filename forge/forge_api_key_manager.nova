// forge_api_key_manager -- API key management with scopes: create keys, validate against required scope
// (admin overrides any scope check), revoke, track usage. Flat-dict state. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. akm_new built the state dict as five individual assignments. Dict literal.
//   2. `contains(...); if has != true` at FIVE sites -- `not in` / `in`.
//   3. akm_validate had a NESTED if to check "scope != required AND scope != admin" -- one compound
//      condition. And it built the result dict as three individual assignments on each of four paths.
//      Dict literals.
//   4. akm_active_count used an index loop + manual counter -- a comprehension.

fn akm_new() -> dict
    {"keys": {}, "scopes": {}, "active": {}, "usage": {}, "total_keys": 0}

fn akm_create(a: dict, key: string, scope: string) -> dict
    a["keys"][key] = 1
    a["scopes"][key] = scope
    a["active"][key] = 1
    a["usage"][key] = 0
    a["total_keys"] += 1
    a

fn akm_validate(a: dict, key: string, required_scope: string) -> dict
    if key not in a["keys"]
        return {"valid": 0, "reason": "not_found", "a": a}
    if a["active"][key] != 1
        return {"valid": 0, "reason": "revoked", "a": a}
    if str(a["scopes"][key]) != required_scope and str(a["scopes"][key]) != "admin"
        return {"valid": 0, "reason": "insufficient_scope", "a": a}
    a["usage"][key] += 1
    {"valid": 1, "reason": "", "a": a}

fn akm_revoke(a: dict, key: string) -> dict
    if key in a["active"]
        a["active"][key] = 0
    a

fn akm_usage(a: dict, key: string) -> int
    if key not in a["usage"]
        return 0
    a["usage"][key]

fn akm_scope(a: dict, key: string) -> string
    if key not in a["scopes"]
        return ""
    a["scopes"][key]

fn akm_active_count(a: dict) -> int
    len([k for k in keys(a["active"]) if a["active"][k] == 1])
