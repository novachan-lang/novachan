// forge_https — serve a routed Forge APP over HTTPS (TLS 1.3). The thin bridge between forge's HTTP router
// (parse_method/parse_path/parse_body + dispatch) and forge_tls_server's TLS handshake + record layer.
// forge_serve_tls_app(app, port) is to HTTPS what forge.serve_app(app, port) is to HTTP: it runs the exact
// same parse pipeline and the same dispatch() (method + :param routing, middleware, 404/405), but the
// request and response travel inside a TLS 1.3 record layer with OS-CSPRNG ephemeral keys. The handler the
// TLS server invokes is `fn(rawreq) dispatch(app, method, path, body)` -- mirroring serve_app's
// `serve_arena(port, fn(m,p,b) dispatch(a,m,p,b))`, except the raw decrypted request string is parsed here.
import forge
import forge_tls_server

fn forge_serve_tls_app(a, port) -> int
    forge_serve_tls(port, fn(rawreq) dispatch(a, parse_method(rawreq), parse_path(rawreq), parse_body(rawreq)))

fn forge_serve_tls_app_n(a, port, n) -> int
    forge_serve_tls_n(port, fn(rawreq) dispatch(a, parse_method(rawreq), parse_path(rawreq), parse_body(rawreq)), n)

fn _https_dispatch(a, rawreq) -> string
    dispatch(a, parse_method(rawreq), parse_path(rawreq), parse_body(rawreq))

fn _https_ws_check(a, handle: int, rawreq: string) -> int
    wss_try_upgrade(a, handle, rawreq)

fn forge_serve_wss_app(a, port: int, cert_path: string, key_path: string, n: int) -> int
    let ap = a
    let handler = fn(rawreq) _https_dispatch(ap, rawreq)
    let ws_check = fn(handle, rawreq) _https_ws_check(ap, handle, rawreq)
    forge_serve_wss_file(port, cert_path, key_path, handler, ws_check, n)
