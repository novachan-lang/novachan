// forge_morton -- Morton codes (Z-order curve): map a 2D coordinate (x, y) to a SINGLE integer by interleaving
// the bits of x and y, and back. The magic is locality: points that are close in 2D get codes that are (mostly)
// close in 1D, so you can store 2D data in a plain sorted array or B-tree and still have neighbours land near
// each other. This is how spatial databases and file formats index maps and images, how quadtree cells get their
// keys, how GPU/texture memory is laid out (Z-order tiling) for cache efficiency, and a cheap way to sort points
// so nearby ones process together. encode interleaves x (even bits) and y (odd bits); decode pulls them apart.
// Coordinates are non-negative integers up to 16 bits (0..65535); the code fits in 32 bits. LEAF -- imports
// NOTHING.

// PRIVATE: spread a 16-bit value so its bits occupy the even positions of a 32-bit result.
fn _mt_spread(v: int) -> int
    let x = v & 65535
    x = (x | (x << 8)) & 16711935
    x = (x | (x << 4)) & 252645135
    x = (x | (x << 2)) & 858993459
    x = (x | (x << 1)) & 1431655765
    x

// PRIVATE: gather the even-position bits of a value back into a contiguous 16-bit value (inverse of _mt_spread).
fn _mt_compact(v: int) -> int
    let x = v & 1431655765
    x = (x | (x / 2)) & 858993459
    x = (x | (x / 4)) & 252645135
    x = (x | (x / 16)) & 16711935
    x = (x | (x / 256)) & 65535
    x

// Interleave (x, y) into a single Morton / Z-order code.
fn morton_encode(x: int, y: int) -> int
    _mt_spread(x) | (_mt_spread(y) << 1)

// Recover [x, y] from a Morton code.
fn morton_decode(code: int) -> list
    [_mt_compact(code), _mt_compact(code / 2)]

// Just the x coordinate encoded in a Morton code.
fn morton_x(code: int) -> int
    _mt_compact(code)

// Just the y coordinate encoded in a Morton code.
fn morton_y(code: int) -> int
    _mt_compact(code / 2)
