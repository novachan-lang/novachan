// forge_lichao -- Li Chao tree: online lower/upper envelope of linear functions ("convex hull trick").
// You maintain a growing set of lines y = m*x + b and repeatedly ask "over all lines added so far, what is
// the MINIMUM (or maximum) y at this query point x?". The naive answer is O(lines) per query; the Li Chao
// tree answers each add AND each query in O(log R) where R is the size of the x-query domain. It is the
// go-to accelerator for a huge class of DYNAMIC PROGRAMMING recurrences of the form
//     dp[i] = min over j<i of ( dp[j] + cost(j, i) )
// where cost splits into a line in i whose slope/intercept depend on j (convex/concave optimization):
// e.g. "divide an array into segments minimizing total cost", batched scheduling, the classic
// CHT problems (Kinetic/APIO/USACO), and computational-geometry lower-envelope queries.
// Unlike a monotonic-stack CHT (which requires lines added in slope order and queries in x order),
// the Li Chao tree accepts lines and queries in ANY order -- fully online.
//
// HOW IT WORKS: the tree is built over the integer x-domain [lo, hi]. Each node owns the "best" line for
// the midpoint of its range. Inserting a line compares it to the node's stored line at the midpoint; the
// winner stays, the loser is pushed down to the half-range where it could still win (it can only overtake
// on one side because two lines cross at most once). A query walks root->leaf taking the min of every
// stored line along the path. This implementation is for MINIMUM envelope; negate slopes+intercepts for max.
//
// We store the tree as a flat array of nodes sized 4*(hi-lo+1); each node holds [m, b, has_line].
//
// API:
//   lichao_new(lo, hi) -> tree                x-domain [lo, hi] (inclusive integers)
//   lichao_add(tree, m, b)                     add line y = m*x + b (mutates tree)
//   lichao_query_min(tree, x) -> int           minimum y over all added lines at x
// For a MAXIMUM envelope, add lines as (-m, -b) and negate the query result.
// LEAF (imports nothing). Uses a big INF sentinel; all values must stay within i64.
// (For very large slopes/domains be mindful of m*x overflow -- keep |m|*|x| < ~9e18.)

fn _lc_inf() -> int
    return 4000000000000000000

// Floor division a/2 that rounds toward negative infinity (NOVA int division truncates toward zero,
// which for a negative sum would make mid == r and break the recursion invariant l <= mid < r).
fn _lc_mid(l: int, r: int) -> int
    let s = l + r
    if s >= 0
        return s / 2
    // negative sum: floor division. If s is odd-negative, s/2 truncates toward zero (too big); subtract 1.
    let q = s / 2
    if q * 2 != s
        q -= 1
    return q

// Create a Li Chao tree over integer x in [lo, hi].
// Returns [lo, hi, m_arr, b_arr, has_arr] where the arrays are the flat node storage (size 4*range).
fn lichao_new(lo: int, hi: int) -> list
    let range = hi - lo + 1
    let size = 4 * range + 4
    let m_arr = [0 for i in 0..size]
    let b_arr = [0 for i in 0..size]
    let has_arr = [0 for i in 0..size]
    return [lo, hi, m_arr, b_arr, has_arr]

// Evaluate line (m, b) at x.
fn _lc_eval(m: int, b: int, x: int) -> int
    return m * x + b

// Add line y = m*x + b to the tree (min envelope).
fn lichao_add(tree: list, m: int, b: int)
    let lo = tree[0]
    let hi = tree[1]
    _lc_insert(tree, 1, lo, hi, m, b)

// Recursive insert into node `idx` covering [l, r].
fn _lc_insert(tree: list, idx: int, l: int, r: int, m_in: int, b_in: int)
    let m_arr = tree[2]
    let b_arr = tree[3]
    let has_arr = tree[4]
    let cur_m = m_in
    let cur_b = b_in
    if has_arr[idx] == 0
        // empty node: take the line
        m_arr[idx] = cur_m
        b_arr[idx] = cur_b
        has_arr[idx] = 1
        return
    let mid = _lc_mid(l, r)
    // Compare new line vs stored line at left endpoint, midpoint
    let node_m = m_arr[idx]
    let node_b = b_arr[idx]
    // Determine which line is better (lower) at the midpoint
    let new_at_mid = _lc_eval(cur_m, cur_b, mid)
    let node_at_mid = _lc_eval(node_m, node_b, mid)
    // If new line is better at mid, swap so node holds the better line at mid
    if new_at_mid < node_at_mid
        // swap
        m_arr[idx] = cur_m
        b_arr[idx] = cur_b
        let tmp_m = node_m
        let tmp_b = node_b
        cur_m = tmp_m
        cur_b = tmp_b
        node_m = m_arr[idx]
        node_b = b_arr[idx]
    // Now node holds the line better at mid; the losing line (cur_m, cur_b) may still win on one side.
    if l == r
        return
    // Compare at left endpoint to decide which half the losing line goes to
    let new_at_l = _lc_eval(cur_m, cur_b, l)
    let node_at_l = _lc_eval(m_arr[idx], b_arr[idx], l)
    if new_at_l < node_at_l
        // losing line is better on the left half
        _lc_insert(tree, 2 * idx, l, mid, cur_m, cur_b)
    else
        // losing line is better on the right half
        _lc_insert(tree, 2 * idx + 1, mid + 1, r, cur_m, cur_b)

// Query minimum y over all lines at x.
fn lichao_query_min(tree: list, x: int) -> int
    let lo = tree[0]
    let hi = tree[1]
    return _lc_query(tree, 1, lo, hi, x)

fn _lc_query(tree: list, idx: int, l: int, r: int, x: int) -> int
    let m_arr = tree[2]
    let b_arr = tree[3]
    let has_arr = tree[4]
    let best = _lc_inf()
    if has_arr[idx] == 1
        best = _lc_eval(m_arr[idx], b_arr[idx], x)
    if l == r
        return best
    let mid = _lc_mid(l, r)
    if x <= mid
        let child = _lc_query(tree, 2 * idx, l, mid, x)
        if child < best
            best = child
    else
        let child = _lc_query(tree, 2 * idx + 1, mid + 1, r, x)
        if child < best
            best = child
    return best
