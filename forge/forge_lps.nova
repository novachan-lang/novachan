// forge_lps -- the Longest Palindromic SUBSEQUENCE: the longest run of characters that reads the same forwards and
// backwards when you're allowed to DELETE characters (but not reorder them). This is different from a palindromic
// SUBSTRING (forge_manacher), which must be contiguous -- here the palindrome's letters can be scattered through
// the string, e.g. the LPS of "character" is "carac" (length 5). It's a textbook dynamic program: dp[i][j] is the
// answer for the slice s[i..j], and it grows by matching the two ends (if s[i]==s[j], keep both and recurse
// inward) or dropping one end, filling an n x n table in O(n^2). Two useful consequences fall straight out: the
// MINIMUM number of characters you must INSERT to turn a string into a palindrome is n minus its LPS length, and
// the LPS is the longest common subsequence of the string with its own reverse. Used in DNA/RNA secondary-structure
// analysis, approximate/palindromic matching, and edit-style similarity. LEAF -- imports NOTHING.

// The length of the longest palindromic subsequence of s. O(n^2) dynamic program.
fn longest_palindromic_subseq(s: string) -> int
    let n = len(s)
    let out = 0
    if n > 0
        // dp[i*n + j] = LPS length within s[i..j]
        let dp = [0 for z in 0..(n * n)]
        let i = n - 1
        while i >= 0
            dp[i * n + i] = 1
            let j = i + 1
            while j < n
                if char_at(s, i) == char_at(s, j)
                    dp[i * n + j] = dp[(i + 1) * n + (j - 1)] + 2
                else
                    let a = dp[(i + 1) * n + j]
                    let b = dp[i * n + (j - 1)]
                    dp[i * n + j] = a if a >= b else b
                j += 1
            i -= 1
        out = dp[0 * n + (n - 1)]
    out

// The minimum number of characters to INSERT anywhere in s to make it a palindrome (= len(s) - LPS length).
fn min_insertions_palindrome(s: string) -> int
    len(s) - longest_palindromic_subseq(s)
