// forge_deque -- a double-ended queue (deque) with TRUE O(1) push/pop/peek at BOTH ends. A plain NOVA list
// gives O(1) only at the back (push/pop); adding to or removing from the FRONT is O(n) (every element shifts).
// This is the structure you want for a work queue, a BFS frontier, a sliding-window buffer, an undo/redo ring,
// or an LRU recency list -- anywhere you add and remove from either end. Java's ArrayDeque and Python's
// collections.deque fill the same role; this matches their O(1) guarantee.
//
// Representation: [head, tail, slots] -- `head` is the logical index of the front element, `tail` is one past
// the back, and `slots` is a dict mapping str(index) -> element. count = tail - head. push_front decrements
// head, push_back increments tail, pops delete the vacated key (so a long-lived deque never leaks keys). The
// cursors are plain integers that grow/shrink monotonically -- no ring wraparound, no O(n) rebuild on growth
// (the backing dict grows naturally). Every op is O(1). LEAF -- imports NOTHING.

// A new empty deque.
fn deque_new() -> list
    [0, 0, {}]

// Build a deque from a list, front = items[0] ... back = items[last].
fn deque_from_list(items: list) -> list
    let dq = deque_new()
    for i in 0..len(items)
        deque_push_back(dq, items[i])
    dq

// Number of elements.
fn deque_len(dq: list) -> int
    dq[1] - dq[0]

// True when the deque holds no elements.
fn deque_is_empty(dq: list) -> bool
    dq[1] == dq[0]

// Append x to the BACK. O(1).
fn deque_push_back(dq: list, x)
    let slots = dq[2]
    slots[str(dq[1])] = x
    dq[1] = dq[1] + 1

// Prepend x to the FRONT. O(1).
fn deque_push_front(dq: list, x)
    dq[0] = dq[0] - 1
    let slots = dq[2]
    slots[str(dq[0])] = x

// Remove and return the FRONT element, or null if empty. O(1).
// NOTE: single-exit with `let v = null` (not an early `return null`) is DELIBERATE -- a function that mixes
// `return null` with `return <any-value>` mis-tags the value branch as a raw pointer (compiler return-type
// unification quirk with null). Initializing v=null and reassigning keeps the value soundly boxed.
fn deque_pop_front(dq: list)
    let v = null
    if dq[1] != dq[0]
        let slots = dq[2]
        let k = str(dq[0])
        v = slots[k]
        del(slots, k)
        dq[0] = dq[0] + 1
    v

// Remove and return the BACK element, or null if empty. O(1).
fn deque_pop_back(dq: list)
    let v = null
    if dq[1] != dq[0]
        dq[1] = dq[1] - 1
        let slots = dq[2]
        let k = str(dq[1])
        v = slots[k]
        del(slots, k)
    v

// Return (without removing) the FRONT element, or null if empty. O(1).
fn deque_peek_front(dq: list)
    let v = null
    if dq[1] != dq[0]
        let slots = dq[2]
        v = slots[str(dq[0])]
    v

// Return (without removing) the BACK element, or null if empty. O(1).
fn deque_peek_back(dq: list)
    let v = null
    if dq[1] != dq[0]
        let slots = dq[2]
        v = slots[str(dq[1] - 1)]
    v

// Snapshot the deque as a plain list, front-to-back order. O(n). Does not modify the deque.
fn deque_to_list(dq: list) -> list
    let out = []
    let slots = dq[2]
    let i = dq[0]
    while i < dq[1]
        push(out, slots[str(i)])
        i += 1
    out

// Remove all elements, resetting the deque to empty. O(1).
fn deque_clear(dq: list)
    dq[0] = 0
    dq[1] = 0
    dq[2] = {}
