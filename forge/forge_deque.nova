// forge_deque -- thin wrapper over std/collections/deque (canonical implementation).
import std/collections/deque

fn deque_new() -> list
    return dq_new()

fn deque_from_list(items: list) -> list
    let dq = deque_new()
    for i in 0..len(items)
        deque_push_back(dq, items[i])
    dq

// Number of elements.

fn deque_len(dq: list) -> int
    return dq_len(dq)

fn deque_is_empty(dq: list) -> bool
    return dq_is_empty(dq)

fn deque_push_back(dq: list, x)
    return dq_push_back(dq, x)

fn deque_push_front(dq: list, x)
    return dq_push_front(dq, x)

fn deque_pop_front(dq: list)
    return dq_pop_front(dq)

fn deque_pop_back(dq: list)
    return dq_pop_back(dq)

fn deque_peek_front(dq: list)
    return dq_peek_front(dq)

fn deque_peek_back(dq: list)
    return dq_peek_back(dq)

fn deque_to_list(dq: list) -> list
    return dq_to_list(dq)

fn deque_clear(dq: list)
    dq[0] = 0
    dq[1] = 0
    dq[2] = {}

