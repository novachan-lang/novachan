// forge_deque -- thin wrapper over std/collections/deque (canonical implementation).
import std/collections/deque

// REPRESENTATION: a deque handle is a DICT ({"dq_items": [...]}), not a list -- see
// std/collections/deque.nova, which wraps the backing list in a dict for reference semantics.
// These wrappers used to annotate the handle `list`, and that is not a cosmetic slip: a
// `list`-typed parameter makes the compiler lower `d["dq_items"]` as a LIST index rather than a
// dict get, so dq_len returned 0 for a 3-element deque. Same class as the std/core/getin bug
// (a polymorphic handle specialised to the wrong container kind), and it was invisible because
// forge_deque_test prints FAIL and exits 0.
fn deque_new() -> dict
    return dq_new()

fn deque_from_list(items: list) -> dict
    let dq = deque_new()
    for i in 0..len(items)
        deque_push_back(dq, items[i])
    dq

// Number of elements.

fn deque_len(dq: dict) -> int
    return dq_len(dq)

fn deque_is_empty(dq: dict) -> bool
    return dq_is_empty(dq)

fn deque_push_back(dq: dict, x)
    return dq_push_back(dq, x)

fn deque_push_front(dq: dict, x)
    return dq_push_front(dq, x)

// The element accessors return `any` EXPLICITLY. Unannotated, their return type is inferred,
// and it came back `int` -- so str() took the integer path and printed a string's POINTER
// (fifo1: got=140695274946605 want=a). A deque holds heterogeneous values by design, so `any`
// is both the honest annotation and the one that routes str() through any_to_str.
fn deque_pop_front(dq: dict) -> any
    return dq_pop_front(dq)

fn deque_pop_back(dq: dict) -> any
    return dq_pop_back(dq)

fn deque_peek_front(dq: dict) -> any
    return dq_peek_front(dq)

fn deque_peek_back(dq: dict) -> any
    return dq_peek_back(dq)

fn deque_to_list(dq: dict) -> list
    return dq_to_list(dq)

// STALE-REPRESENTATION BUG, fixed. This wrote dq[0]/dq[1]/dq[2] -- the OLD deque layout, a
// [head, tail, items] triple. std/collections/deque.nova was later rewritten to wrap a single
// backing list in a dict, and this wrapper was never migrated (which is also why every
// annotation here said `list`: correct for the old form, wrong for the new one).
//
// The effect was not a crash: it merely ADDED keys 0/1/2 to the dict and left dq_items
// untouched, so the deque was never cleared. The following pop_front then returned the OLD
// front element, which is why the test read `reuse: got=1 want=reused` -- that 1 was the
// string "1" still sitting at the front, not an integer.
fn deque_clear(dq: dict)
    dq["dq_items"] = []

