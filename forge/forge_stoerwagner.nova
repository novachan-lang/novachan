// forge_stoerwagner -- the GLOBAL minimum cut of a weighted undirected graph via the Stoer-Wagner algorithm: the
// cheapest set of edges whose removal splits the graph into two non-empty parts, minimized over ALL ways to split
// it. Max-flow/min-cut (forge_maxflow) answers this for a FIXED source and sink; Stoer-Wagner finds the single
// weakest point over every possible partition, with no source or sink to pick. That's what you want for network
// reliability ("how hard is it to disconnect this network at all?"), graph clustering and image segmentation
// (cut the weakest link between two groups), and community detection. It runs in O(V^3) by repeated "minimum cut
// phases": grow a set by always adding the most tightly connected vertex (a maximum adjacency search), record the
// last vertex's connection as a candidate cut, then merge the last two vertices and repeat -- the smallest
// candidate over all phases is the global minimum cut. Weights are non-negative integers; the graph is a symmetric
// adjacency matrix (0 = no edge). LEAF -- imports NOTHING.

// PRIVATE: large sentinel.
fn _sw_inf() -> int
    1000000000

// The weight of the global minimum cut of the graph given as a symmetric n x n weight matrix.
fn min_cut(graph: list) -> int
    let n = len(graph)
    let INF = _sw_inf()
    let out = 0
    if n >= 2
        // flat working weight matrix (merging modifies it)
        let w = []
        for a in 0..n
            for b in 0..n
                push(w, graph[a][b])
        let exist = [1 for e in 0..n]
        let best = INF
        for phase in 0..(n - 1)
            // maximum adjacency search
            let in_a = []
            let wsum = []
            for z in 0..n
                push(in_a, 0)
                push(wsum, 0)
            let prev = -1
            let steps = n - phase
            for it in 0..steps
                // pick the existing, not-yet-added vertex with the largest connection weight
                let sel = -1
                for j in 0..n
                    if exist[j] == 1 and in_a[j] == 0
                        if sel == -1 or wsum[j] > wsum[sel]
                            sel = j
                if it == steps - 1
                    // cut of the phase = connection of the last vertex
                    if wsum[sel] < best
                        best = wsum[sel]
                    // merge sel into prev
                    for k in 0..n
                        w[prev * n + k] += w[sel * n + k]
                        w[k * n + prev] += w[k * n + sel]
                    exist[sel] = 0
                else
                    in_a[sel] = 1
                    for jj in 0..n
                        if exist[jj] == 1 and in_a[jj] == 0
                            wsum[jj] += w[sel * n + jj]
                    prev = sel
        out = best
    out
