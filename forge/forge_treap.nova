// forge_treap -- thin wrapper over std/collections/treap (canonical implementation).
import std/collections/treap

fn _treap_sz(t: dict, node: int) -> int
    let out = 0
    if node != -1
        out = t["sz"][node]
    out

// PRIVATE: recompute a node's cached subtree size from its children.

fn _treap_merge(t: dict, a: int, b: int) -> int
    let out = a
    if a == -1
        out = b
    else
        if b == -1
            out = a
        else
            let prio = t["prio"]
            let lc = t["lc"]
            let rc = t["rc"]
            if prio[a] > prio[b]
                rc[a] = _treap_merge(t, rc[a], b)
                _treap_upd(t, a)
                out = a
            else
                lc[b] = _treap_merge(t, a, lc[b])
                _treap_upd(t, b)
                out = b
    out

// PRIVATE: split treap `node` into [ keys < k , keys >= k ].

fn _treap_split(t: dict, node: int, k: int) -> list
    let out = [-1, -1]
    if node != -1
        let key = t["key"]
        let lc = t["lc"]
        let rc = t["rc"]
        if key[node] < k
            let sub = _treap_split(t, rc[node], k)
            rc[node] = sub[0]
            _treap_upd(t, node)
            out = [node, sub[1]]
        else
            let sub = _treap_split(t, lc[node], k)
            lc[node] = sub[1]
            _treap_upd(t, node)
            out = [sub[0], node]
    out

// True if k is in the set.

fn treap_new() -> dict
    return tr_new()

fn treap_contains(t: dict, k: int) -> bool
    return tr_contains(t, k)

fn treap_insert(t: dict, k: int)
    return tr_insert(t, k)

fn treap_erase(t: dict, k: int)
    let p1 = _treap_split(t, t["root"], k)
    let p2 = _treap_split(t, p1[1], k + 1)
    t["root"] = _treap_merge(t, p1[0], p2[1])

// The number of stored keys.

fn treap_size(t: dict) -> int
    return tr_size(t)

fn treap_rank(t: dict, k: int) -> int
    let key = t["key"]
    let lc = t["lc"]
    let rc = t["rc"]
    let cnt = 0
    let node = t["root"]
    while node != -1
        if key[node] < k
            cnt += 1 + _treap_sz(t, lc[node])
            node = rc[node]
        else
            node = lc[node]
    cnt

// The k-th smallest key (0-indexed), or -1 if out of range.

fn treap_select(t: dict, i: int) -> int
    let key = t["key"]
    let lc = t["lc"]
    let rc = t["rc"]
    let node = t["root"]
    let idx = i
    let out = -1
    let done = false
    while node != -1 and not done
        let ls = _treap_sz(t, lc[node])
        if idx < ls
            node = lc[node]
        else
            if idx == ls
                out = key[node]
                done = true
            else
                idx -= ls - 1
                node = rc[node]
    out

