// forge_treap -- a treap: a balanced binary search tree that stays balanced through RANDOMNESS instead of complex
// rotations. Each key also gets a random "priority", and the tree is kept as a heap on those priorities while
// remaining a BST on the keys -- and since the priorities are random, the tree's height stays O(log n) with high
// probability, all with strikingly little code. It's an ORDERED SET with fast everything: insert, erase, and
// membership in O(log n), plus ORDER STATISTICS -- rank ("how many keys are below x") and select ("the k-th
// smallest") -- because every node caches its subtree size. Unlike forge_orderset (a sorted array, O(n) to insert
// in the middle) a treap mutates in true logarithmic time, so it's the right choice for a large set that is
// constantly inserted into and deleted from while you still ask ranking/percentile questions: live leaderboards,
// order books, sliding-window statistics, and dynamic rank queries. Priorities are derived deterministically from
// the key (reproducible). Integer keys, unique (a set). LEAF -- imports NOTHING.

// PRIVATE: a deterministic, well-scrambled priority for a key (xorshift, kept positive).
fn _treap_prio(k: int) -> int
    let x = (k & 2147483647) + 1
    x = (x ^ (x << 13)) & 2147483647
    x = x ^ (x >> 7)
    x = (x ^ (x << 5)) & 2147483647
    x

// A new empty treap.
fn treap_new() -> dict
    let t = {}
    t["root"] = 0 - 1
    t["key"] = []
    t["prio"] = []
    t["lc"] = []
    t["rc"] = []
    t["sz"] = []
    t

// PRIVATE: subtree size (0 for the null node).
fn _treap_sz(t: dict, node: int) -> int
    let out = 0
    if node != 0 - 1
        out = t["sz"][node]
    out

// PRIVATE: recompute a node's cached subtree size from its children.
fn _treap_upd(t: dict, node: int)
    t["sz"][node] = 1 + _treap_sz(t, t["lc"][node]) + _treap_sz(t, t["rc"][node])

// PRIVATE: merge two treaps where every key in `a` is less than every key in `b`; returns the new root.
fn _treap_merge(t: dict, a: int, b: int) -> int
    let out = a
    if a == 0 - 1
        out = b
    else
        if b == 0 - 1
            out = a
        else
            let prio = t["prio"]
            let lc = t["lc"]
            let rc = t["rc"]
            if prio[a] > prio[b]
                rc[a] = _treap_merge(t, rc[a], b)
                _treap_upd(t, a)
                out = a
            else
                lc[b] = _treap_merge(t, a, lc[b])
                _treap_upd(t, b)
                out = b
    out

// PRIVATE: split treap `node` into [ keys < k , keys >= k ].
fn _treap_split(t: dict, node: int, k: int) -> list
    let out = [0 - 1, 0 - 1]
    if node != 0 - 1
        let key = t["key"]
        let lc = t["lc"]
        let rc = t["rc"]
        if key[node] < k
            let sub = _treap_split(t, rc[node], k)
            rc[node] = sub[0]
            _treap_upd(t, node)
            out = [node, sub[1]]
        else
            let sub = _treap_split(t, lc[node], k)
            lc[node] = sub[1]
            _treap_upd(t, node)
            out = [sub[0], node]
    out

// True if k is in the set.
fn treap_contains(t: dict, k: int) -> bool
    let key = t["key"]
    let lc = t["lc"]
    let rc = t["rc"]
    let node = t["root"]
    let found = false
    while node != 0 - 1 and found == false
        if key[node] == k
            found = true
        else
            if k < key[node]
                node = lc[node]
            else
                node = rc[node]
    found

// Insert k (no effect if already present).
fn treap_insert(t: dict, k: int)
    if treap_contains(t, k) == false
        let node = len(t["key"])
        push(t["key"], k)
        push(t["prio"], _treap_prio(k))
        push(t["lc"], 0 - 1)
        push(t["rc"], 0 - 1)
        push(t["sz"], 1)
        let parts = _treap_split(t, t["root"], k)
        t["root"] = _treap_merge(t, _treap_merge(t, parts[0], node), parts[1])

// Remove k if present.
fn treap_erase(t: dict, k: int)
    let p1 = _treap_split(t, t["root"], k)
    let p2 = _treap_split(t, p1[1], k + 1)
    t["root"] = _treap_merge(t, p1[0], p2[1])

// The number of stored keys.
fn treap_size(t: dict) -> int
    _treap_sz(t, t["root"])

// The number of keys strictly less than k (its rank).
fn treap_rank(t: dict, k: int) -> int
    let key = t["key"]
    let lc = t["lc"]
    let rc = t["rc"]
    let cnt = 0
    let node = t["root"]
    while node != 0 - 1
        if key[node] < k
            cnt += 1 + _treap_sz(t, lc[node])
            node = rc[node]
        else
            node = lc[node]
    cnt

// The k-th smallest key (0-indexed), or -1 if out of range.
fn treap_select(t: dict, i: int) -> int
    let key = t["key"]
    let lc = t["lc"]
    let rc = t["rc"]
    let node = t["root"]
    let idx = i
    let out = 0 - 1
    let done = false
    while node != 0 - 1 and done == false
        let ls = _treap_sz(t, lc[node])
        if idx < ls
            node = lc[node]
        else
            if idx == ls
                out = key[node]
                done = true
            else
                idx -= ls - 1
                node = rc[node]
    out
