// forge_treap -- thin wrapper over std/collections/treap (canonical implementation).
import std/collections/treap

// PRIVATE: subtree size, computed on demand — std's node representation
// ({"k","p","l","r"}, node|null) has no cached "sz" field, unlike the
// array-based layout ({"key"[]/"lc"[]/"rc"[]/"sz"[]/"prio"[], int root})
// this wrapper used to (incorrectly) assume. Recomputing per call is O(n)
// worst case, which is fine at the sizes this wrapper is used at.
fn _treap_node_size(nd: dict) -> int
    let out = 0
    if nd != null
        out = 1 + _treap_node_size(nd["l"]) + _treap_node_size(nd["r"])
    out

// True if k is in the set.

fn treap_new() -> dict
    return tr_new()

fn treap_contains(t: dict, k: int) -> bool
    return tr_contains(t, k) == 1

fn treap_insert(t: dict, k: int)
    return tr_insert(t, k)

fn treap_erase(t: dict, k: int)
    return tr_delete(t, k)

// The number of stored keys.

fn treap_size(t: dict) -> int
    return tr_size(t)

fn treap_rank(t: dict, k: int) -> int
    let cnt = 0
    let node = t["root"]
    while node != null
        if node["k"] < k
            cnt += 1 + _treap_node_size(node["l"])
            node = node["r"]
        else
            node = node["l"]
    cnt

// The k-th smallest key (0-indexed), or -1 if out of range.

fn treap_select(t: dict, i: int) -> int
    let node = t["root"]
    let idx = i
    let out = -1
    let done = false
    while node != null and not done
        let ls = _treap_node_size(node["l"])
        if idx < ls
            node = node["l"]
        else
            if idx == ls
                out = node["k"]
                done = true
            else
                idx -= ls + 1
                node = node["r"]
    out
