// forge_domain_validator — domain name validation with Result API.

fn dv_new() -> dict
    let d = {}
    d["validations"] = 0
    d["passes"] = 0
    d["failures"] = 0
    d["max_label_len"] = 63
    d["max_total_len"] = 253
    d

fn dv_validate(d: dict, domain: string) -> Result
    d["validations"] = d["validations"] + 1
    if len(domain) == 0
        d["failures"] = d["failures"] + 1
        return err("empty domain")
    if len(domain) > d["max_total_len"]
        d["failures"] = d["failures"] + 1
        return err("domain too long")
    let has_dot = 0
    for i in 0..len(domain)
        let ch = slice(domain, i, i + 1)
        if ch == "."
            has_dot = 1
    if has_dot == 0
        d["failures"] = d["failures"] + 1
        return err("no dots in domain")
    if slice(domain, 0, 1) == "."
        d["failures"] = d["failures"] + 1
        return err("domain starts with dot")
    if slice(domain, 0, 1) == "-"
        d["failures"] = d["failures"] + 1
        return err("domain starts with hyphen")
    d["passes"] = d["passes"] + 1
    ok("valid")

fn dv_total_validations(d: dict) -> int
    d["validations"]

fn dv_pass_count(d: dict) -> int
    d["passes"]

fn dv_fail_count(d: dict) -> int
    d["failures"]
