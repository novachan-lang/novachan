// forge_enumerate -- generate combinatorial collections: all k-element COMBINATIONS of a set, its full POWER SET
// (every subset), and the CARTESIAN PRODUCT of several lists. Counting how many there are is one thing
// (forge_combinatorics); actually LISTING them is what you need to drive exhaustive search and test generation --
// try every pair of servers, every subset of feature flags, every combination of {browser} x {os} x {locale} in a
// test matrix, enumerate coalitions for a voting/knapsack search, or expand a parameter grid. combinations picks k
// items ignoring order (no repeats), power_set yields all 2^n subsets, and cartesian_product forms every tuple
// with one element drawn from each input list. Each result is a fresh list (safe to keep and mutate). Elements may
// be numbers or strings. LEAF -- imports NOTHING.

// PRIVATE: a shallow copy of a list (results must not alias the working buffer).
fn _en_copy(lst: list) -> list
    let out = [lst[i] for i in 0..len(lst)]
    out

// PRIVATE: backtracking combination builder.
fn _en_comb(items: list, k: int, start: int, current: list, result: list)
    if len(current) == k
        push(result, _en_copy(current))
    else
        let i = start
        while i < len(items)
            push(current, items[i])
            _en_comb(items, k, i + 1, current, result)
            pop(current)
            i += 1

// All k-element combinations of `items` (order-independent, no repeats), in lexicographic index order. k=0 gives
// one empty combination; k>len gives none.
fn combinations(items: list, k: int) -> list
    let result = []
    let current = []
    _en_comb(items, k, 0, current, result)
    result

// The power set of `items`: all 2^n subsets, from empty to full, in binary-mask order.
fn power_set(items: list) -> list
    let n = len(items)
    let total = 1 << n
    let result = []
    for mask in 0..total
        let subset = []
        let i = 0
        while i < n
            if ((mask >> i) & 1) == 1
                push(subset, items[i])
            i += 1
        push(result, subset)
    result

// The Cartesian product of a list of lists: every tuple formed by choosing one element from each input list.
fn cartesian_product(lists: list) -> list
    let result = [[]]
    for li in 0..len(lists)
        let lst = lists[li]
        let newresult = []
        let ri = 0
        while ri < len(result)
            let combo = result[ri]
            let xi = 0
            while xi < len(lst)
                let tuple = _en_copy(combo)
                push(tuple, lst[xi])
                push(newresult, tuple)
                xi += 1
            ri += 1
        result = newresult
    result

// The number of combinations/subsets/tuples the above would produce, without materializing them.
fn combination_count(n: int, k: int) -> int
    let out = 0
    if k >= 0 and k <= n
        // n! / (k! (n-k)!), computed iteratively to avoid overflow
        let r = k
        if n - k < r
            r = n - k
        let num = 1
        for i in 0..r
            num = num * (n - i) / (i + 1)
        out = num
    out
