// forge_coupon -- promo / discount code validation + application (checkout coupons: percent-off or fixed-
// amount-off, with an expiry and a minimum-order gate). Amounts in cents. A coupon is a dict (load from the DB
// in production). Composes the same integer-cents rounding as forge_percent. LEAF -- imports NOTHING.

fn coupon_percent(code: string, pct: int, expires_epoch: int, min_order_cents: int) -> dict
    let c = {}
    c["code"] = code
    c["kind"] = "percent"
    c["value"] = pct
    c["expires"] = expires_epoch
    c["min_order"] = min_order_cents
    c

fn coupon_fixed(code: string, off_cents: int, expires_epoch: int, min_order_cents: int) -> dict
    let c = {}
    c["code"] = code
    c["kind"] = "fixed"
    c["value"] = off_cents
    c["expires"] = expires_epoch
    c["min_order"] = min_order_cents
    c

// Usable for this order at `now`? (order meets the minimum AND not expired; expires=0 means never).
fn coupon_valid(coupon: dict, order_cents: int, now_epoch: int) -> bool
    if order_cents < coupon["min_order"]
        return false
    let exp = coupon["expires"]
    if exp != 0 and now_epoch > exp
        return false
    true

// The discount in cents (0 if the coupon isn't valid). Percent is rounded; fixed is capped at the order total.
fn coupon_discount(coupon: dict, order_cents: int, now_epoch: int) -> int
    if coupon_valid(coupon, order_cents, now_epoch) == false
        return 0
    if coupon["kind"] == "percent"
        return (order_cents * coupon["value"] + 50) / 100
    let off = coupon["value"]
    if off > order_cents
        return order_cents
    off

// The final order total after applying the coupon.
fn coupon_apply(coupon: dict, order_cents: int, now_epoch: int) -> int
    order_cents - coupon_discount(coupon, order_cents, now_epoch)
