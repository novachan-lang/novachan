// forge_stomp -- a STOMP 1.2 (https://stomp.github.io/stomp-specification-1.2.html) messaging client,
// mirroring the socket-driver shape of forge_mqtt/forge_amqp: a pure codec layer (frame encode/decode,
// byte-exact) plus a thin TCP transport (open/read-frame/close) built on tcp_connect/tcp_send_bytes/
// tcp_recv_bytes/tcp_close.
//
// STOMP is a TEXT-framed protocol but bodies are binary-safe:
//   COMMAND LF
//   header-name:header-value LF     (0 or more)
//   LF                               <- blank line ends the header section
//   body-bytes
//   NUL (0x00)                       <- frame terminator
//
// Client commands built here: CONNECT/STOMP, SEND, SUBSCRIBE, UNSUBSCRIBE, ACK, NACK, DISCONNECT.
// Server frames parsed here (all via the one generic `stomp_parse_frame`): CONNECTED, MESSAGE, RECEIPT,
// ERROR -- the caller dispatches on `frame["command"]` and reads `frame["headers"]["<name>"]` /
// `frame["body"]`.
//
// WHY std/net/stomp_build.nova + stomp_frame.nova are NOT reused here: those modules are STRING-based
// (body decoded as a NOVA string that stops at the first NUL, headers copied verbatim with no escape/
// unescape) -- correct for the simplest "ASCII command frame, no body" case but UNSOUND for this task's
// requirements: (a) STOMP 1.2 header VALUE escaping (\r \n : \\) is not implemented there at all, so a
// header value containing a colon or newline would silently corrupt the frame on the wire; (b) a body
// with an embedded NUL byte (binary payload under content-length) cannot survive a NOVA `string` (NUL-
// truncating C-string, see reference_nova_string_nul_truncation) -- it requires `bytes`. Rather than
// bolt binary-safety and escaping onto a module whose public contract (string body, no escaping) other
// callers may already depend on, this module implements its own byte-safe, escape-aware codec. This
// module DOES reuse std/net/stomp_heartbeat for heart-beat header parse/format (that piece is pure
// int<->string and has no string/bytes soundness gap).
import std/net/stomp_heartbeat

// ── wire constants ──────────────────────────────────────────────────────────────────────────────────

fn _stm_lf() -> int
    10

fn _stm_cr() -> int
    13

fn _stm_nul() -> int
    0

fn _stm_colon() -> int
    58

fn _stm_backslash() -> int
    92

// Hard cap on a single frame's body size the streaming reader will buffer for (64 MiB). Guards against
// a malicious/buggy peer advertising a huge content-length and forcing unbounded memory growth (DoS) --
// mirrors the overflow guard in forge_amqp's bytes_concat wrapper.
fn _stm_max_body() -> int
    67108864

// ── header value escaping (STOMP 1.2 spec, "Header" section) ───────────────────────────────────────
// Escaping applies to EVERY frame's header entries EXCEPT the CONNECT and CONNECTED frames (kept
// unescaped for STOMP 1.0/1.1 backward compatibility). The 4 reserved octets and their wire sequences:
//   \r (13) -> "\r"    \n (10) -> "\n"    :  (58) -> "\c"    \  (92) -> "\\"
// stomp_encode_frame decides `escape` per-command and applies this to BOTH header key and value, so
// every high-level frame builder (including caller-supplied extra headers) is injection-safe: a raw
// LF/CR in a header can never split into a second header line or a second frame.

// The 4 reserved octets as a lookup table. This replaces an if-ladder over string constants: the
// table IS the spec's escape list, so adding/auditing a mapping is a one-line data change rather
// than another `else if` branch.
fn _stm_escape_map() -> dict
    return {"\\": "\\\\", "\n": "\\n", "\r": "\\r", ":": "\\c"}

// The reverse table, keyed by the character FOLLOWING the backslash.
fn _stm_unescape_map() -> dict
    return {"r": "\r", "n": "\n", "c": ":", "\\": "\\"}

// RAISED: this built its result with `out = out + piece` per character, which is QUADRATIC in NOVA
// (every append reallocates and copies everything accumulated so far). A header value is attacker-
// influenced and unbounded in length, so that was a real DoS amplifier, not just a slow path.
// Now: map each character through the escape table and `join` ONCE -- O(n).
fn stomp_escape_header(s: string, escape: int) -> string
    if escape == 0
        return s
    let esc = _stm_escape_map()
    let chars = [slice(s, i, i + 1) for i in 0..len(s)]
    join([get(esc, c, c) for c in chars], "")

// stomp_unescape_header: reverse of stomp_escape_header. An unrecognized escape sequence (backslash
// followed by anything other than r/n/c/\\, or a trailing backslash at end-of-string) is passed through
// LITERALLY rather than treated as a fatal error -- defensive against a malformed/adversarial peer;
// never crashes, never silently drops bytes.
// RAISED the same way as stomp_escape_header (quadratic `out = out + piece` -> push + one `join`)
// and the 4-branch if-ladder -> the _stm_unescape_map table. The `while` is KEPT: the cursor advances
// by 1 or 2 depending on the byte it just read, which is a data-dependent step, not a range.
fn stomp_unescape_header(s: string, escape: int) -> string
    if escape == 0
        return s
    let unesc = _stm_unescape_map()
    let n = len(s)
    let parts = []
    let i = 0
    while i < n
        let ch = slice(s, i, i + 1)
        if ch == "\\" and i + 1 < n
            let nx = slice(s, i + 1, i + 2)
            if nx in unesc
                push(parts, unesc[nx])
                i += 2
            else
                push(parts, ch)
                i += 1
        else
            push(parts, ch)
            i += 1
    join(parts, "")

// _stm_strip_crlf: used ONLY on the non-escaping (CONNECT/CONNECTED) path. Those two frame types never
// escape header values (spec-mandated, for 1.0/1.1 compatibility), which would otherwise let a raw LF/CR
// in e.g. a `login` or `host` value inject a bogus header line or split a second frame onto the wire.
// Since a legitimate host/login/passcode/heart-beat value never legitimately contains a control
// character, we defensively DROP any CR/LF byte from the value rather than reject the whole frame --
// closes the injection vector while staying wire-compatible with 1.0/1.1 brokers for the common case.
// RAISED: it is a filter, so it is written as one -- a filtering comprehension plus a single `join`,
// instead of the quadratic per-character `out = out + ch`.
fn _stm_strip_crlf(s: string) -> string
    let chars = [slice(s, i, i + 1) for i in 0..len(s)]
    join([c for c in chars if c != "\n" and c != "\r"], "")

// ── generic frame encode / decode (byte-exact, content-length aware) ───────────────────────────────

// stomp_encode_frame: build one complete STOMP frame as `bytes`.
//   command: e.g. "SEND", "CONNECT", "SUBSCRIBE" ...
//   headers: list of [key, value] string pairs, emitted in order, one "key:value" LF line each.
//   body:    frame body as `bytes` (binary-safe; pass bytes(0) for no body).
// Header keys/values are escaped per STOMP 1.2 (see stomp_escape_header) for every command except
// CONNECT/STOMP/CONNECTED, which instead get CR/LF stripped (see _stm_strip_crlf) -- either way, no
// header value can inject a stray header line or a second frame.
fn stomp_encode_frame(command: string, headers: list, body) -> any
    let escape = 1
    if command == "CONNECT" or command == "STOMP" or command == "CONNECTED"
        escape = 0

    let out = str_to_bytes(command)
    out = bytes_append(out, _stm_lf())

    // Iterating the pairs directly; the byte accumulation itself is left alone on purpose -- this is
    // the wire encoder, and its emission order IS the frame layout.
    for pair in headers
        let ek = pair[0]
        let ev = pair[1]
        if escape == 1
            ek = stomp_escape_header(ek, 1)
            ev = stomp_escape_header(ev, 1)
        else
            ek = _stm_strip_crlf(ek)
            ev = _stm_strip_crlf(ev)
        out = bytes_concat(out, str_to_bytes(ek))
        out = bytes_append(out, _stm_colon())
        out = bytes_concat(out, str_to_bytes(ev))
        out = bytes_append(out, _stm_lf())

    out = bytes_append(out, _stm_lf())
    out = bytes_concat(out, body)
    out = bytes_append(out, _stm_nul())
    out

// _stm_read_line_bytes: read from `pos` up to (and consuming) the next LF; returns [line_string, next_pos].
// If no LF is found before the end of the buffer, the remainder is returned as the line and next_pos==n
// (defensive: malformed/truncated input never crashes, it just yields a short final line).
fn _stm_read_line_bytes(b, pos: int) -> list
    let n = bytes_len(b)
    let cur = pos
    let found = -1
    // KEPT: a byte scan that SHORT-CIRCUITS on the first LF. Wire framing -- untouched.
    while cur < n and found == -1
        if bytes_get(b, cur) == _stm_lf()
            found = cur
        else
            cur += 1
    if found == -1
        return [bytes_to_str(bytes_slice(b, pos, n)), n]
    [bytes_to_str(bytes_slice(b, pos, found)), found + 1]

// _stm_split_header_line: split "key:value" on the FIRST colon only (STOMP 1.2 allows a raw, unescaped
// colon nowhere in a well-formed header line except as the key/value separator -- any colon inside an
// escaped value arrives on the wire as the two-char sequence "\c", never a bare ':'). Returns ["", ""]
// if the line has no colon at all (malformed).
// RAISED: the hand-rolled first-colon scan (which walked the WHOLE line even after finding it) is
// the exact contract of the `str_index_of` builtin -- first index, or -1 when absent. Verified on
// all four edges before delegating: found-at-0, found-in-middle, absent, empty string.
fn _stm_split_header_line(line: string) -> list
    let colon = str_index_of(line, ":")
    if colon == -1
        return ["", ""]
    [slice(line, 0, colon), slice(line, colon + 1, len(line))]

// _stm_read_raw_headers: read header lines starting at `start_pos` until a blank line (or end of
// buffer). Returns [pairs, next_pos] where pairs is a list of [key,value] string pairs IN WIRE FORM
// (not yet unescaped) and next_pos is the offset of the first body byte (right after the blank line's
// LF), or bytes_len(b) if the buffer ran out before a blank line was seen.
fn _stm_read_raw_headers(b, start_pos: int) -> list
    let n = bytes_len(b)
    let pairs = []
    let pos = start_pos
    let reading = 1
    // KEPT as a `while`: the cursor advances by whatever the next line consumed, and the loop stops
    // on the blank line. Wire framing -- untouched.
    while reading == 1 and pos < n
        let hres = _stm_read_line_bytes(b, pos)
        let hline = hres[0]
        pos = hres[1]
        if len(hline) == 0
            reading = 0
        else
            let kv = _stm_split_header_line(hline)
            if len(kv[0]) > 0
                push(pairs, kv)
    [pairs, pos]

// stomp_parse_frame: parse one complete STOMP frame from `bytes` into
//   {"command": string, "headers": dict<string,string>, "body": bytes}
// On empty/malformed input (no command line at all), returns command="" headers={} body=bytes(0).
// Header decoding follows STOMP 1.2 exactly:
//   * escaping is reversed for every command EXCEPT CONNECT/STOMP/CONNECTED (kept unescaped for 1.0/1.1
//     backward compatibility, per spec) -- this MUST mirror stomp_encode_frame's `escape` decision
//     exactly, or encode(x) then parse(...) != x for those three frame types;
//   * on a REPEATED header key, the FIRST occurrence wins (spec: "only the first header entry SHOULD
//     be used") -- diverges intentionally from std/net/stomp_frame's last-wins behavior.
// Body extraction is content-length aware: if a "content-length" header is present, exactly that many
// bytes are taken as the body (embedded NUL bytes included -- true binary safety); otherwise the body
// runs up to (but excluding) the first NUL byte, per the STOMP 1.2 fallback framing rule.
fn stomp_parse_frame(frame_bytes) -> dict
    let result = {}
    result["command"] = ""
    result["headers"] = {}
    result["body"] = bytes(0)

    let n = bytes_len(frame_bytes)
    if n == 0
        return result

    let cmd_res = _stm_read_line_bytes(frame_bytes, 0)
    let command = cmd_res[0]
    let pos = cmd_res[1]
    if len(command) == 0
        return result

    let escape = 1
    if command == "CONNECT" or command == "STOMP" or command == "CONNECTED"
        escape = 0

    let rh = _stm_read_raw_headers(frame_bytes, pos)
    let pairs = rh[0]
    let body_start = rh[1]

    let headers = {}
    for pair in pairs
        let k = stomp_unescape_header(pair[0], escape)
        let v = stomp_unescape_header(pair[1], escape)
        if k not in headers
            headers[k] = v

    let body = bytes(0)
    if "content-length" in headers
        let clen = parse_int(headers["content-length"])
        if clen < 0
            clen = 0
        body = bytes_slice(frame_bytes, body_start, body_start + clen)
    else
        let cur = body_start
        let nul_pos = -1
        while cur < n and nul_pos == -1
            if bytes_get(frame_bytes, cur) == _stm_nul()
                nul_pos = cur
            else
                cur += 1
        if nul_pos == -1
            nul_pos = n
        body = bytes_slice(frame_bytes, body_start, nul_pos)

    result["command"] = command
    result["headers"] = headers
    result["body"] = body
    result

// ── client-command frame builders ───────────────────────────────────────────────────────────────────

// stomp_connect_frame: build a CONNECT (or, if `command`=="STOMP", a STOMP) frame. `login`/`passcode`
// are omitted from the frame entirely when empty (no empty-header noise on the wire).
fn stomp_connect_frame(command: string, host: string, login: string, passcode: string, heartbeat_cx: int, heartbeat_cy: int) -> any
    // Not a comprehension: two of the five entries are CONDITIONAL, and the wire order matters.
    let headers = [["accept-version", "1.2"], ["host", host]]
    if len(login) > 0
        push(headers, ["login", login])
    if len(passcode) > 0
        push(headers, ["passcode", passcode])
    push(headers, ["heart-beat", stomp_heartbeat_format(heartbeat_cx, heartbeat_cy)])
    stomp_encode_frame(command, headers, bytes(0))

// stomp_send_frame: build a SEND frame. content-length is ALWAYS emitted (its value = bytes_len(body),
// including 0 for an empty body) -- deterministic and required for a binary-safe body; `extra_headers`
// (e.g. content-type, receipt, transaction, or any custom header) are inserted between `destination`
// and the auto-computed `content-length`.
fn stomp_send_frame(destination: string, body, extra_headers: list) -> any
    // The copy loop was exactly a splice, so it is written as one -- spread keeps the wire order
    // (destination, caller's extras, content-length) literally visible in the source.
    let headers = [["destination", destination], ...extra_headers, ["content-length", str(bytes_len(body))]]
    stomp_encode_frame("SEND", headers, body)

// stomp_subscribe_frame: `ack` is one of "auto" (default if ""), "client", "client-individual"; header
// omitted (broker defaults to "auto") when `ack` is "".
fn stomp_subscribe_frame(id: string, destination: string, ack: string) -> any
    let headers = [["id", id], ["destination", destination]]
    if len(ack) > 0
        push(headers, ["ack", ack])
    stomp_encode_frame("SUBSCRIBE", headers, bytes(0))

fn stomp_unsubscribe_frame(id: string) -> any
    stomp_encode_frame("UNSUBSCRIBE", [["id", id]], bytes(0))

// ACK and NACK are byte-for-byte the same frame shape with a different command word -- they were two
// identical bodies. One builder, parameterised by the command; the two public names stay.
fn _stm_id_txn_frame(command: string, id: string, transaction: string) -> any
    let headers = [["id", id]]
    if len(transaction) > 0
        push(headers, ["transaction", transaction])
    stomp_encode_frame(command, headers, bytes(0))

fn stomp_ack_frame(id: string, transaction: string) -> any
    _stm_id_txn_frame("ACK", id, transaction)

fn stomp_nack_frame(id: string, transaction: string) -> any
    _stm_id_txn_frame("NACK", id, transaction)

fn stomp_disconnect_frame(receipt: string) -> any
    let headers = []
    if len(receipt) > 0
        push(headers, ["receipt", receipt])
    stomp_encode_frame("DISCONNECT", headers, bytes(0))

// ── TCP transport ────────────────────────────────────────────────────────────────────────────────────

// _stm_recv_at_least: fill buf from sock until it holds >= need bytes, or the peer closes (short buf
// returned in that case -- mirrors forge_mqtt's _mq_recv_at_least).
fn _stm_recv_at_least(sock: int, buf, need: int) -> any
    while bytes_len(buf) < need
        let chunk = tcp_recv_bytes(sock)
        if bytes_len(chunk) == 0
            return buf
        buf = bytes_concat(buf, chunk)
    buf

// _stm_peek_content_length: given a buffer that holds AT LEAST the full header section (up through
// `hdr_end`, the first byte of the body), return the parsed content-length header value, or -1 if that
// header is absent. Used by stomp_read_frame to size the body fetch BEFORE the body has fully arrived.
// KEPT as a loop: this is a FIND, and it short-circuits. `hdr_end` is unused (the header section is
// re-scanned from offset 0) -- preserved in the signature rather than changed during a raise.
fn _stm_peek_content_length(buf, hdr_end: int) -> int
    let cmd_res = _stm_read_line_bytes(buf, 0)
    let rh = _stm_read_raw_headers(buf, cmd_res[1])
    let found = -1
    for pair in rh[0]
        if pair[0] == "content-length"
            found = parse_int(pair[1])
            // Exactly the original's `found == -1` continue-condition: a header value that parses
            // to -1 is indistinguishable from "not found" here, so the scan goes on. Preserved.
            if found != -1
                break
    found

// stomp_read_frame: read exactly one STOMP frame off `sock`, buffering with carried-over `buf`.
// Returns [frame_dict, leftover_buf] (frame_dict as produced by stomp_parse_frame). On EOF / a short
// read / an oversize content-length (see _stm_max_body), frame_dict["command"]=="" and leftover_buf is
// whatever was accumulated so far.
//
// Framing algorithm:
//   1. Skip any number of leading bare LF bytes -- the STOMP heart-beat keepalive is a single LF sent
//      OUTSIDE of any frame (spec §7), never part of a frame itself.
//   2. Scan for the first "LF LF" byte pair -- the boundary between the header section and the body
//      (this is unambiguous: escaped header values never contain a raw LF, only the two-char sequence
//      "\n", so two consecutive raw LF bytes can only be a header-line end immediately followed by the
//      blank line).
//   3. Peek content-length from the now-complete header section; if present, read exactly that many
//      more bytes plus the trailing NUL. If absent, scan forward for the terminating NUL.
fn stomp_read_frame(sock: int, buf) -> any
    let skip_done = 0
    while skip_done == 0
        buf = _stm_recv_at_least(sock, buf, 1)
        if bytes_len(buf) < 1
            return [stomp_parse_frame(bytes(0)), buf]
        if bytes_get(buf, 0) == _stm_lf()
            buf = bytes_slice(buf, 1, bytes_len(buf))
        else
            skip_done = 1

    let hdr_end = -1
    let scan_from = 0
    while hdr_end == -1
        buf = _stm_recv_at_least(sock, buf, scan_from + 2)
        if bytes_len(buf) < scan_from + 2
            return [stomp_parse_frame(bytes(0)), buf]
        let n = bytes_len(buf)
        let i = scan_from
        while i < n - 1 and hdr_end == -1
            if bytes_get(buf, i) == _stm_lf() and bytes_get(buf, i + 1) == _stm_lf()
                hdr_end = i + 2
            i += 1
        if hdr_end == -1
            scan_from = n - 1

    let clen = _stm_peek_content_length(buf, hdr_end)
    let frame_bytes = bytes(0)
    if clen >= 0 and clen <= _stm_max_body()
        let total = hdr_end + clen + 1
        buf = _stm_recv_at_least(sock, buf, total)
        if bytes_len(buf) < total
            return [stomp_parse_frame(bytes(0)), buf]
        frame_bytes = bytes_slice(buf, 0, total)
        buf = bytes_slice(buf, total, bytes_len(buf))
    else if clen > _stm_max_body()
        return [stomp_parse_frame(bytes(0)), bytes(0)]
    else
        let scan_pos = hdr_end
        let nul_found = -1
        while nul_found == -1
            buf = _stm_recv_at_least(sock, buf, scan_pos + 1)
            if bytes_len(buf) <= scan_pos
                return [stomp_parse_frame(bytes(0)), buf]
            if bytes_get(buf, scan_pos) == _stm_nul()
                nul_found = scan_pos
            else
                scan_pos += 1
        frame_bytes = bytes_slice(buf, 0, nul_found + 1)
        buf = bytes_slice(buf, nul_found + 1, bytes_len(buf))

    [stomp_parse_frame(frame_bytes), buf]

// stomp_open: TCP-connect to host:port, send CONNECT, and wait for the CONNECTED reply.
// Returns ok([sock, leftover_buf, connected_headers]) or err(message).
fn stomp_open(host: string, port: int, vhost: string, login: string, passcode: string) -> any
    let sock = tcp_connect(host, port)
    if sock < 0
        return err("stomp: cannot connect to {host}:{port}")
    tcp_send_bytes(sock, stomp_connect_frame("CONNECT", vhost, login, passcode, 0, 0))
    let rd = stomp_read_frame(sock, bytes(0))
    let frame = rd[0]
    let leftover = rd[1]
    if frame["command"] == "ERROR"
        tcp_close(sock)
        let detail = bytes_to_str(frame["body"])
        return err("stomp: broker sent ERROR: {detail}")
    if frame["command"] != "CONNECTED"
        tcp_close(sock)
        return err("stomp: no CONNECTED frame received")
    ok([sock, leftover, frame["headers"]])

// stomp_close: send DISCONNECT then close the socket.
fn stomp_close(sock: int, receipt_id: string)
    tcp_send_bytes(sock, stomp_disconnect_frame(receipt_id))
    tcp_close(sock)
