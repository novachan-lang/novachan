// forge_write_ahead_log — WAL for crash recovery with Result API.

fn wal_new() -> dict
    let w = {}
    w["entries"] = {}
    w["count"] = 0
    w["committed"] = 0
    w["checkpointed"] = 0
    w

fn wal_append(w: dict, operation: string, key: string, value: string) -> dict
    let ek = "wal_" + str(w["count"])
    w["entries"][ek + "_op"] = operation
    w["entries"][ek + "_key"] = key
    w["entries"][ek + "_val"] = value
    w["entries"][ek + "_committed"] = 0
    w["count"] = w["count"] + 1
    w

fn wal_commit(w: dict, idx: int) -> Result
    if idx < 0 or idx >= w["count"]
        return err("index out of range")
    let ek = "wal_" + str(idx)
    w["entries"][ek + "_committed"] = 1
    w["committed"] = w["committed"] + 1
    ok(w)

fn wal_get(w: dict, idx: int) -> Result
    if idx < 0 or idx >= w["count"]
        return err("index out of range")
    let ek = "wal_" + str(idx)
    ok(w["entries"][ek + "_op"] + ":" + w["entries"][ek + "_key"] + "=" + w["entries"][ek + "_val"])

fn wal_is_committed(w: dict, idx: int) -> int
    if idx < 0 or idx >= w["count"]
        return 0
    let ek = "wal_" + str(idx)
    w["entries"][ek + "_committed"]

fn wal_checkpoint(w: dict) -> dict
    w["checkpointed"] = w["committed"]
    w

fn wal_count(w: dict) -> int
    w["count"]

fn wal_committed_count(w: dict) -> int
    w["committed"]

fn wal_uncommitted_count(w: dict) -> int
    w["count"] - w["committed"]
