// forge_write_ahead_log — Write-ahead log for crash recovery.
// Append entries, checkpoint, replay from position.

fn wal_new() -> dict
    let wal = {}
    wal["entries"] = []
    wal["checkpoint"] = 0
    wal["sequence"] = 0
    wal

fn wal_append(wal: dict, operation: string, data: string) -> dict
    wal["sequence"] = wal["sequence"] + 1
    let entry = {}
    entry["seq"] = wal["sequence"]
    entry["op"] = operation
    entry["data"] = data
    push(wal["entries"], entry)
    wal

fn wal_checkpoint(wal: dict) -> dict
    wal["checkpoint"] = wal["sequence"]
    wal

fn wal_replay_from(wal: dict, from_seq: int) -> list
    let result = []
    let i = 0
    while i < len(wal["entries"])
        if wal["entries"][i]["seq"] > from_seq
            push(result, wal["entries"][i])
        i = i + 1
    result

fn wal_replay_since_checkpoint(wal: dict) -> list
    wal_replay_from(wal, wal["checkpoint"])

fn wal_entry_count(wal: dict) -> int
    len(wal["entries"])

fn wal_current_seq(wal: dict) -> int
    wal["sequence"]

fn wal_checkpoint_seq(wal: dict) -> int
    wal["checkpoint"]

fn wal_truncate_before(wal: dict, before_seq: int) -> dict
    let new_entries = []
    let i = 0
    while i < len(wal["entries"])
        if wal["entries"][i]["seq"] >= before_seq
            push(new_entries, wal["entries"][i])
        i = i + 1
    wal["entries"] = new_entries
    wal
