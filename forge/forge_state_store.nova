// forge_state_store — Persistent state management.
// Key-value store with namespaces, transactions, snapshots.

fn ss_new() -> dict
    {"store": {}, "tx_log": [], "version": 0}

fn ss_set(store: dict, key: string, value: any) -> dict
    store["store"][key] = value
    store["version"] += 1
    push(store["tx_log"], {"op": "set", "key": key, "version": store["version"]})
    store

fn ss_get(store: dict, key: string) -> any
    if key in store["store"]
        return store["store"][key]
    ""

fn ss_has(store: dict, key: string) -> bool
    key in store["store"]

fn ss_keys(store: dict) -> list
    keys(store["store"])

fn ss_size(store: dict) -> int
    len(keys(store["store"]))

fn ss_version(store: dict) -> int
    store["version"]

fn ss_snapshot(store: dict) -> dict
    let ks = keys(store["store"])
    {k: store["store"][k] for k in ks}

fn ss_tx_count(store: dict) -> int
    len(store["tx_log"])

fn ss_changes_since(store: dict, since: int) -> list
    let log = store["tx_log"]
    [entry for entry in log if entry["version"] > since]

fn ss_get_or(store: dict, key: string, fallback: any) -> any
    if key in store["store"]
        return store["store"][key]
    fallback
