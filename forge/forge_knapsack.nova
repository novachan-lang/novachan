// forge_knapsack -- the classic "make the best choice under a budget" dynamic-programming solvers: coin change
// and the 0/1 knapsack. COIN CHANGE answers "fewest coins to make this amount" and "how many distinct ways to
// make it" -- real for cash/change machines, but also any "reach a target from allowed step sizes" problem
// (tiling, scoring combinations, currency/credit denominations). The 0/1 KNAPSACK picks a subset of items, each
// taken at most once, to maximize total value without exceeding a weight/cost capacity -- cargo loading, budget
// allocation, ad/feature selection, portfolio picks under a cap. Both run in O(n*capacity) with a rolling
// integer DP array (fast, exact, no floating point). Weights/amounts/values are integers. LEAF -- imports
// NOTHING.

// Fewest coins that sum exactly to `amount` using unlimited copies of each coin, or -1 if impossible.
fn coin_change_min(coins: list, amount: int) -> int
    let inf = amount + 1
    let dp = []
    let i = 0
    while i <= amount
        push(dp, inf)
        i = i + 1
    dp[0] = 0
    let a = 1
    while a <= amount
        let c = 0
        while c < len(coins)
            let coin = coins[c]
            if coin <= a and dp[a - coin] + 1 < dp[a]
                dp[a] = dp[a - coin] + 1
            c = c + 1
        a = a + 1
    let out = 0 - 1
    if dp[amount] <= amount
        out = dp[amount]
    out

// The number of distinct combinations of coins (order-independent) that sum to `amount`.
fn coin_change_ways(coins: list, amount: int) -> int
    let dp = []
    let i = 0
    while i <= amount
        push(dp, 0)
        i = i + 1
    dp[0] = 1
    let c = 0
    while c < len(coins)
        let coin = coins[c]
        let a = coin
        while a <= amount
            dp[a] = dp[a] + dp[a - coin]
            a = a + 1
        c = c + 1
    dp[amount]

// 0/1 knapsack: the maximum total value of a subset of items (each used at most once) whose weights sum to at
// most `capacity`. `weights` and `values` are parallel lists.
fn knapsack_01(weights: list, values: list, capacity: int) -> int
    let dp = []
    let i = 0
    while i <= capacity
        push(dp, 0)
        i = i + 1
    let n = len(weights)
    let item = 0
    while item < n
        let wt = weights[item]
        let val = values[item]
        // iterate capacity DOWNWARD so each item is used at most once
        let w = capacity
        while w >= wt
            if dp[w - wt] + val > dp[w]
                dp[w] = dp[w - wt] + val
            w = w - 1
        item = item + 1
    dp[capacity]

// Unbounded knapsack: like knapsack_01 but each item may be used any number of times (upward iteration).
fn knapsack_unbounded(weights: list, values: list, capacity: int) -> int
    let dp = []
    let i = 0
    while i <= capacity
        push(dp, 0)
        i = i + 1
    let n = len(weights)
    let item = 0
    while item < n
        let wt = weights[item]
        let val = values[item]
        let w = wt
        while w <= capacity
            if dp[w - wt] + val > dp[w]
                dp[w] = dp[w - wt] + val
            w = w + 1
        item = item + 1
    dp[capacity]
