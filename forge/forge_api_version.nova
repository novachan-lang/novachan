// forge_api_version -- API versioning manager: register versioned handlers, set a default, deprecate
// old versions, resolve a requested version to its handler. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Three problems:
//
//   1. av_new built the state dict as four individual assignments. Dict literal.
//   2. `contains(...) != true` / `== true` at FIVE sites -- `not in` / `in`.
//   3. Error messages used `"unknown version: " + version` -- interpolation. `av_is_deprecated`
//      used if/return/return for a boolean int -- ternary.

fn av_new() -> dict
    {"versions": {}, "ver_count": 0, "default": "", "deprecated": {}}

fn av_add_version(a: dict, version: string, handler: string) -> dict
    a["versions"][version] = handler
    a["ver_count"] += 1
    if a["default"] == ""
        a["default"] = version
    a

fn av_set_default(a: dict, version: string) -> Result
    if version not in a["versions"]
        return err("unknown version: {version}")
    a["default"] = version
    ok(a)

fn av_deprecate(a: dict, version: string) -> Result
    if version not in a["versions"]
        return err("unknown version: {version}")
    a["deprecated"][version] = 1
    ok(a)

fn av_resolve(a: dict, version: string) -> Result
    if version == ""
        if str(a["default"]) == ""
            return err("no default version")
        return ok(a["versions"][a["default"]])
    if version not in a["versions"]
        return err("unknown version: {version}")
    ok(a["versions"][version])

fn av_is_deprecated(a: dict, version: string) -> int
    1 if version in a["deprecated"] else 0

fn av_version_count(a: dict) -> int
    a["ver_count"]

fn av_default_version(a: dict) -> string
    a["default"]
