// forge_api_version — API versioning manager with Result.

fn av_new() -> dict
    let a = {}
    a["versions"] = {}
    a["ver_count"] = 0
    a["default"] = ""
    a["deprecated"] = {}
    a

fn av_add_version(a: dict, version: string, handler: string) -> dict
    a["versions"][version] = handler
    a["ver_count"] = a["ver_count"] + 1
    if a["default"] == ""
        a["default"] = version
    a

fn av_set_default(a: dict, version: string) -> Result
    let has = contains(a["versions"], version)
    if has != true
        return err("unknown version: " + version)
    a["default"] = version
    ok(a)

fn av_deprecate(a: dict, version: string) -> Result
    let has = contains(a["versions"], version)
    if has != true
        return err("unknown version: " + version)
    a["deprecated"][version] = 1
    ok(a)

fn av_resolve(a: dict, version: string) -> Result
    if version == ""
        if a["default"] == ""
            return err("no default version")
        return ok(a["versions"][a["default"]])
    let has = contains(a["versions"], version)
    if has != true
        return err("unknown version: " + version)
    ok(a["versions"][version])

fn av_is_deprecated(a: dict, version: string) -> int
    let has = contains(a["deprecated"], version)
    if has == true
        return 1
    0

fn av_version_count(a: dict) -> int
    a["ver_count"]

fn av_default_version(a: dict) -> string
    a["default"]
