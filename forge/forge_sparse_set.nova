// forge_sparse_set — Sparse set for fast int membership with iteration.

fn ss_new(max_val: int) -> dict
    let s = {}
    s["max_val"] = max_val
    s["dense"] = {}
    s["sparse"] = {}
    s["count"] = 0
    s

fn ss_add(s: dict, val: int) -> dict
    if val < 0
        return s
    if val >= s["max_val"]
        return s
    let k = str(val)
    let has = contains(s["sparse"], k)
    if has == true
        let idx = s["sparse"][k]
        if idx >= 0
            if idx < s["count"]
                return s
    s["sparse"][k] = s["count"]
    s["dense"][str(s["count"])] = val
    s["count"] = s["count"] + 1
    s

fn ss_contains(s: dict, val: int) -> int
    let k = str(val)
    let has = contains(s["sparse"], k)
    if has != true
        return 0
    let idx = s["sparse"][k]
    if idx < 0
        return 0
    if idx >= s["count"]
        return 0
    if s["dense"][str(idx)] == val
        return 1
    0

fn ss_remove(s: dict, val: int) -> dict
    if ss_contains(s, val) == 0
        return s
    let idx = s["sparse"][str(val)]
    let last_idx = s["count"] - 1
    let last_val = s["dense"][str(last_idx)]
    s["dense"][str(idx)] = last_val
    s["sparse"][str(last_val)] = idx
    s["sparse"][str(val)] = -1
    s["count"] = s["count"] - 1
    s

fn ss_count(s: dict) -> int
    s["count"]

fn ss_get(s: dict, idx: int) -> int
    s["dense"][str(idx)]

fn ss_clear(s: dict) -> dict
    s["count"] = 0
    s
