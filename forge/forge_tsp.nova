// forge_tsp -- the Traveling Salesman Problem solved EXACTLY by the Held-Karp dynamic program. Given the pairwise
// distances between cities, it finds the shortest route that visits every city -- the core of vehicle routing,
// delivery/pickup planning, PCB-drilling and machine tool paths, and DNA fragment ordering. Brute force tries all
// n! orderings (12 cities already = 479 million); Held-Karp is O(2^n * n^2) by remembering, for each SUBSET of
// cities and each endpoint, the cheapest way to have visited exactly that subset ending there -- collapsing the
// factorial into an exponential you can actually run for ~15-18 cities. It gives the true optimum (not a
// heuristic), returns both the shortest CYCLE (return to start) and shortest PATH (open route), and can
// reconstruct the actual visiting order. Distances are a non-negative integer matrix, city 0 is the start. LEAF.

// PRIVATE: sentinel for unreachable.
fn _tsp_inf() -> int
    1000000000

// PRIVATE: fill the Held-Karp dp table; returns [dp_flat, parent_flat] over (2^n) x n.
fn _tsp_solve(dist: list) -> list
    let n = len(dist)
    let INF = _tsp_inf()
    let total = 1 << n
    let dp = []
    let parent = []
    let z = 0
    while z < total * n
        push(dp, INF)
        push(parent, 0 - 1)
        z = z + 1
    dp[(1 * n) + 0] = 0
    let mask = 0
    while mask < total
        let i = 0
        while i < n
            let cur = dp[mask * n + i]
            if cur < INF and ((mask >> i) & 1) == 1
                let j = 0
                while j < n
                    if ((mask >> j) & 1) == 0
                        let nmask = mask | (1 << j)
                        let nd = cur + dist[i][j]
                        if nd < dp[nmask * n + j]
                            dp[nmask * n + j] = nd
                            parent[nmask * n + j] = i
                    j = j + 1
            i = i + 1
        mask = mask + 1
    [dp, parent]

// The length of the shortest tour that starts at city 0, visits every city once, and returns to 0.
fn tsp_shortest_cycle(dist: list) -> int
    let n = len(dist)
    let out = 0
    if n > 1
        let sol = _tsp_solve(dist)
        let dp = sol[0]
        let full = (1 << n) - 1
        let INF = _tsp_inf()
        let best = INF
        let i = 1
        while i < n
            let c = dp[full * n + i] + dist[i][0]
            if c < best
                best = c
            i = i + 1
        out = best
    out

// The length of the shortest OPEN route from city 0 visiting every city once (no return to start).
fn tsp_shortest_path(dist: list) -> int
    let n = len(dist)
    let out = 0
    if n > 1
        let sol = _tsp_solve(dist)
        let dp = sol[0]
        let full = (1 << n) - 1
        let INF = _tsp_inf()
        let best = INF
        let i = 0
        while i < n
            if dp[full * n + i] < best
                best = dp[full * n + i]
            i = i + 1
        out = best
    out

// The visiting order of an optimal cycle, as a list of city indices starting at 0 (the implicit return to 0 is not
// repeated). For n<=1 returns [0] (or [] for n=0).
fn tsp_tour(dist: list) -> list
    let n = len(dist)
    let order = []
    if n == 1
        push(order, 0)
    else
        if n > 1
            let sol = _tsp_solve(dist)
            let dp = sol[0]
            let parent = sol[1]
            let full = (1 << n) - 1
            let INF = _tsp_inf()
            let best = INF
            let best_i = 0
            let i = 1
            while i < n
                let c = dp[full * n + i] + dist[i][0]
                if c < best
                    best = c
                    best_i = i
                i = i + 1
            // walk parents back
            let rev = []
            let mask = full
            let cur = best_i
            while cur != 0 - 1
                push(rev, cur)
                let pi = parent[mask * n + cur]
                mask = mask ^ (1 << cur)
                cur = pi
            // reverse
            let k = len(rev) - 1
            while k >= 0
                push(order, rev[k])
                k = k - 1
    order
