// forge_wordsearch -- can a WORD be traced through a grid of letters by stepping between horizontally or vertically
// adjacent cells, never reusing a cell? This is the classic "word search" / Boggle-style puzzle, and it's a clean
// showcase of DEPTH-FIRST SEARCH WITH BACKTRACKING: from every cell whose letter matches the word's first, walk to
// a neighbour matching the next letter, mark cells as used so a path can't cross itself, and un-mark them when a
// branch dead-ends so other paths can reuse them. The moment a full match is found the search short-circuits.
// Beyond the game it's the same shape as constrained path search on a grid, matching a template of cells, and
// snake/route validation. The grid is a list of equal-length strings (one per row); matching is case-sensitive and
// steps are 4-directional (no diagonals). LEAF -- imports NOTHING.

// PRIVATE: DFS from (r,c) trying to match word[idx..]; `used` is a flat R*C mark array. Returns 1 on success.
fn _ws_dfs(grid: list, rows: int, cols: int, r: int, c: int, word: string, idx: int, used: list) -> int
    let out = 0
    if idx == len(word)
        out = 1
    else
        if r >= 0 and r < rows and c >= 0 and c < cols
            if used[r * cols + c] == 0 and char_at(grid[r], c) == char_at(word, idx)
                used[r * cols + c] = 1
                if _ws_dfs(grid, rows, cols, r - 1, c, word, idx + 1, used) == 1
                    out = 1
                if out == 0 and _ws_dfs(grid, rows, cols, r + 1, c, word, idx + 1, used) == 1
                    out = 1
                if out == 0 and _ws_dfs(grid, rows, cols, r, c - 1, word, idx + 1, used) == 1
                    out = 1
                if out == 0 and _ws_dfs(grid, rows, cols, r, c + 1, word, idx + 1, used) == 1
                    out = 1
                used[r * cols + c] = 0
    out

// True if `word` can be found in `grid` (a list of equal-length row strings) by a 4-directional non-repeating path.
fn word_search(grid: list, word: string) -> bool
    let rows = len(grid)
    let found = false
    if rows > 0 and len(word) > 0
        let cols = len(grid[0])
        let used = []
        let z = 0
        while z < rows * cols
            push(used, 0)
            z = z + 1
        let r = 0
        while r < rows and found == false
            let c = 0
            while c < cols and found == false
                if _ws_dfs(grid, rows, cols, r, c, word, 0, used) == 1
                    found = true
                c = c + 1
            r = r + 1
    found
