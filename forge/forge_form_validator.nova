// forge_form_validator — form field validation with rules and Result API.

fn fv_new() -> dict
    {"rule_count": 0, "validations": 0, "passes": 0, "failures": 0}

fn fv_required(f: dict, field: string) -> dict
    let idx = f["rule_count"]
    f["r_" + str(idx) + "_field"] = field
    f["r_" + str(idx) + "_type"] = "required"
    f["r_" + str(idx) + "_param"] = 0
    f["rule_count"] += 1
    f

fn fv_min_length(f: dict, field: string, min_len: int) -> dict
    let idx = f["rule_count"]
    f["r_" + str(idx) + "_field"] = field
    f["r_" + str(idx) + "_type"] = "min_length"
    f["r_" + str(idx) + "_param"] = min_len
    f["rule_count"] += 1
    f

fn fv_max_length(f: dict, field: string, max_len: int) -> dict
    let idx = f["rule_count"]
    f["r_" + str(idx) + "_field"] = field
    f["r_" + str(idx) + "_type"] = "max_length"
    f["r_" + str(idx) + "_param"] = max_len
    f["rule_count"] += 1
    f

fn fv_validate(f: dict, data: dict) -> Result
    f["validations"] += 1
    for i in 0..f["rule_count"]
        let field = f["r_" + str(i) + "_field"]
        let rule_type = f["r_" + str(i) + "_type"]
        let param = f["r_" + str(i) + "_param"]
        if rule_type == "required"
            if field not in data
                f["failures"] += 1
                return err("missing required field: " + field)
            if data[field] == ""
                f["failures"] += 1
                return err("empty required field: " + field)
        if rule_type == "min_length"
            if field in data
                if len(data[field]) < param
                    f["failures"] += 1
                    return err(field + " too short")
        if rule_type == "max_length"
            if field in data
                if len(data[field]) > param
                    f["failures"] += 1
                    return err(field + " too long")
    f["passes"] += 1
    ok("valid")

fn fv_rule_count(f: dict) -> int
    f["rule_count"]

fn fv_validation_count(f: dict) -> int
    f["validations"]

fn fv_pass_count(f: dict) -> int
    f["passes"]

fn fv_fail_count(f: dict) -> int
    f["failures"]
