// forge_response_builder -- explicit, imperative HTTP RESPONSE construction as a flat-dict state
// (rb_new -> rb_set_header/rb_set_body/... -> rb_build). Distinct from forge.nova's Response record
// (used by the router/handler pipeline); this is the lower-level builder for code that assembles raw
// HTTP bytes directly (proxies, test harnesses, hand-rolled servers). Headers are stored flat under
// "h_<name>" keys (no nested dicts/lists, matching forge_header_map's convention) so state stays a
// single flat dict. LEAF -- imports NOTHING.

// _rb_status_text: the standard reason phrase for a status code, or "Unknown" for an unlisted code.
fn _rb_status_text(code: int) -> string
    if code == 200
        return "OK"
    if code == 201
        return "Created"
    if code == 202
        return "Accepted"
    if code == 204
        return "No Content"
    if code == 301
        return "Moved Permanently"
    if code == 302
        return "Found"
    if code == 303
        return "See Other"
    if code == 304
        return "Not Modified"
    if code == 307
        return "Temporary Redirect"
    if code == 308
        return "Permanent Redirect"
    if code == 400
        return "Bad Request"
    if code == 401
        return "Unauthorized"
    if code == 403
        return "Forbidden"
    if code == 404
        return "Not Found"
    if code == 405
        return "Method Not Allowed"
    if code == 409
        return "Conflict"
    if code == 422
        return "Unprocessable Entity"
    if code == 429
        return "Too Many Requests"
    if code == 500
        return "Internal Server Error"
    if code == 502
        return "Bad Gateway"
    if code == 503
        return "Service Unavailable"
    "Unknown"

// rb_new: a fresh response builder state with the given status code, empty body, no headers.
fn rb_new(status_code: int) -> dict
    let s = {}
    s["status"] = status_code
    s["body"] = ""
    s["header_count"] = 0
    s

// rb_set_header: set (or overwrite) a response header. Setting an existing header name does not
// increase header_count.
fn rb_set_header(state: dict, name: string, value: string) -> dict
    let nk = "h_" + name
    if contains(state, nk) != true
        state["header_count"] = state["header_count"] + 1
    state[nk] = value
    state

// rb_set_body: replace the response body.
fn rb_set_body(state: dict, body: string) -> dict
    state["body"] = body
    state

// rb_set_content_type: convenience for rb_set_header(state, "Content-Type", ct).
fn rb_set_content_type(state: dict, ct: string) -> dict
    rb_set_header(state, "Content-Type", ct)

// rb_json: set the body to a (caller-supplied, already-serialized) JSON string and the Content-Type
// header to "application/json".
fn rb_json(state: dict, json_str: string) -> dict
    rb_set_body(state, json_str)
    rb_set_content_type(state, "application/json")
    state

// rb_redirect: a fresh response with the given redirect status code and a Location header.
fn rb_redirect(url: string, code: int) -> dict
    let s = rb_new(code)
    rb_set_header(s, "Location", url)
    s

// rb_status: the response's status code.
fn rb_status(state: dict) -> int
    state["status"]

// rb_get_header: the value of a previously-set header, or Err if it was never set.
fn rb_get_header(state: dict, name: string) -> Result
    let nk = "h_" + name
    if contains(state, nk) != true
        return err("header not found: " + name)
    ok(state[nk])

// rb_body: the current response body.
fn rb_body(state: dict) -> string
    state["body"]

// rb_header_count: the number of distinct headers set.
fn rb_header_count(state: dict) -> int
    state["header_count"]

// rb_build: render the full HTTP/1.1 response text: status line, headers (each "Name: value"), a
// blank line, then the body. Line endings are CRLF per RFC 7230.
fn rb_build(state: dict) -> string
    let crlf = chr(13) + chr(10)
    let status = state["status"]
    let text = _rb_status_text(status)
    let out = "HTTP/1.1 " + str(status) + " " + text + crlf
    for k in keys(state)
        if starts_with(k, "h_")
            let name = slice(k, 2, len(k))
            out = out + name + ": " + str(state[k]) + crlf
    out = out + crlf + state["body"]
    out
