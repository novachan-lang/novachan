// forge_request_dedup — Deduplicate concurrent identical requests.

fn rd_new() -> dict
    let r = {}
    r["inflight"] = {}
    r["total"] = 0
    r["deduped"] = 0
    r["completed"] = 0
    r

fn rd_start(r: dict, key: string) -> dict
    let result = {}
    let has = contains(r["inflight"], key)
    r["total"] = r["total"] + 1
    if has == true
        r["inflight"][key] = r["inflight"][key] + 1
        r["deduped"] = r["deduped"] + 1
        result["is_first"] = 0
    else
        r["inflight"][key] = 1
        result["is_first"] = 1
    result["r"] = r
    result

fn rd_complete(r: dict, key: string) -> dict
    let has = contains(r["inflight"], key)
    if has == true
        let new_inflight = {}
        let ks = keys(r["inflight"])
        for i in 0..len(ks)
            if ks[i] != key
                new_inflight[ks[i]] = r["inflight"][ks[i]]
        r["inflight"] = new_inflight
        r["completed"] = r["completed"] + 1
    r

fn rd_waiters(r: dict, key: string) -> int
    let has = contains(r["inflight"], key)
    if has != true
        return 0
    r["inflight"][key]

fn rd_total_requests(r: dict) -> int
    r["total"]

fn rd_total_deduped(r: dict) -> int
    r["deduped"]

fn rd_dedup_rate(r: dict) -> int
    if r["total"] == 0
        return 0
    r["deduped"] * 100 / r["total"]

fn rd_inflight_count(r: dict) -> int
    len(keys(r["inflight"]))
