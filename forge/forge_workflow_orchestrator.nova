// forge_workflow_orchestrator — multi-workflow, multi-instance step execution engine.
//
// One engine (we_new) tracks many DEFINED workflows (named step sequences) and many
// RUNNING INSTANCES of those workflows (each instance advances independently through
// its workflow's steps). This is deliberately a different shape than forge_workflow.nova
// (a single ad-hoc workflow object with conditional branching): here the workflow
// definition is registered once and reused across any number of concurrent instances,
// which is the pattern an orchestrator (e.g. a saga/pipeline runner) needs.
//
// NOTE: forge_workflow_engine.nova already exists (single-workflow object, wf_* API,
// shipped LIB batch 32). This module intentionally uses a distinct file name and a
// distinct we_* prefix so it does not collide with or overwrite that shipped module.

fn we_new() -> dict
    {"workflows": {}, "workflow_count": 0, "instances": {}, "instance_count": 0}

fn we_define(state: dict, workflow_name: string) -> dict
    if (workflow_name + "_steps") not in state["workflows"]
        state["workflows"][workflow_name + "_steps"] = 0
        state["workflow_count"] += 1
    state

fn we_add_step(state: dict, workflow_name: string, step_name: string) -> Result
    if (workflow_name + "_steps") not in state["workflows"]
        return err("unknown workflow: " + workflow_name)
    let n = state["workflows"][workflow_name + "_steps"]
    state["workflows"][workflow_name + "_step_" + str(n)] = step_name
    state["workflows"][workflow_name + "_steps"] = n + 1
    ok(state)

fn we_start(state: dict, workflow_name: string, instance_id: string) -> Result
    if (workflow_name + "_steps") not in state["workflows"]
        return err("unknown workflow: " + workflow_name)
    let step_n = state["workflows"][workflow_name + "_steps"]
    if step_n == 0
        return err("workflow has no steps: " + workflow_name)
    if (instance_id + "_workflow") in state["instances"]
        return err("instance already exists: " + instance_id)
    state["instances"][instance_id + "_workflow"] = workflow_name
    state["instances"][instance_id + "_step"] = 0
    state["instances"][instance_id + "_done"] = 0
    state["instance_count"] += 1
    ok(state)

fn we_advance(state: dict, instance_id: string) -> Result
    if (instance_id + "_workflow") not in state["instances"]
        return err("unknown instance: " + instance_id)
    if state["instances"][instance_id + "_done"] == 1
        return err("instance already complete: " + instance_id)
    let wf_name = state["instances"][instance_id + "_workflow"]
    let total = state["workflows"][wf_name + "_steps"]
    let cur = state["instances"][instance_id + "_step"]
    let next_step = cur + 1
    state["instances"][instance_id + "_step"] = next_step
    if next_step >= total
        state["instances"][instance_id + "_done"] = 1
    ok(state)

fn we_current_step(state: dict, instance_id: string) -> Result
    if (instance_id + "_workflow") not in state["instances"]
        return err("unknown instance: " + instance_id)
    if state["instances"][instance_id + "_done"] == 1
        return err("instance complete: " + instance_id)
    let wf_name = state["instances"][instance_id + "_workflow"]
    let idx = state["instances"][instance_id + "_step"]
    ok(state["workflows"][wf_name + "_step_" + str(idx)])

fn we_is_complete(state: dict, instance_id: string) -> Result
    if (instance_id + "_workflow") not in state["instances"]
        return err("unknown instance: " + instance_id)
    ok(state["instances"][instance_id + "_done"])

fn we_instance_count(state: dict) -> int
    state["instance_count"]

fn we_workflow_count(state: dict) -> int
    state["workflow_count"]

fn we_step_count(state: dict, workflow_name: string) -> Result
    if (workflow_name + "_steps") not in state["workflows"]
        return err("unknown workflow: " + workflow_name)
    ok(state["workflows"][workflow_name + "_steps"])
