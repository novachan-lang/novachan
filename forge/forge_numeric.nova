// forge_numeric -- small integer numeric helpers: clamp to a range, map a value between ranges, and min/max.
// For UI layout, gauges, normalization, progress bars, and bounds enforcement. LEAF -- imports NOTHING.

fn clamp(v: int, lo: int, hi: int) -> int
    if v < lo
        return lo
    if v > hi
        return hi
    v

fn num_min(a: int, b: int) -> int
    if a < b
        return a
    b

fn num_max(a: int, b: int) -> int
    if a > b
        return a
    b

// Map `v` from [in_lo,in_hi] onto [out_lo,out_hi] (rounded). map_range(5, 0,10, 0,100) -> 50.
fn map_range(v: int, in_lo: int, in_hi: int, out_lo: int, out_hi: int) -> int
    if in_hi == in_lo
        return out_lo
    let span = in_hi - in_lo
    out_lo + ((v - in_lo) * (out_hi - out_lo) + span / 2) / span

// Percent (0..100) of `v` within [lo,hi] (clamped). For progress bars.
fn percent_in_range(v: int, lo: int, hi: int) -> int
    clamp(map_range(v, lo, hi, 0, 100), 0, 100)
