// forge_grundy -- combinatorial game theory for IMPARTIAL games via the Sprague-Grundy theorem: the beautiful
// result that EVERY impartial game (both players have the same moves; last player to move wins) behaves exactly
// like a single Nim pile of some size, its "Grundy number", and that a game built from several independent
// sub-games is won or lost by simply XOR-ing their Grundy numbers together. That reduces a whole zoo of two-player
// games -- Nim itself, subtraction/take-away games, Kayles, coin-turning, and many puzzle end-games -- to arithmetic:
// a position is LOSING for the player about to move exactly when its Grundy value (or the XOR of its parts) is 0,
// and any nonzero value is a win with a computable best move. The engine is the "mex" (minimum excludant): a
// position's Grundy number is the smallest non-negative integer NOT among the Grundy numbers of the positions you
// can move to. nim_value handles standard Nim (XOR of pile sizes), grundy_subtraction tabulates the Grundy numbers
// of a take-away game where you may remove any amount in a given move set, and grundy_xor combines independent
// games. Non-negative integers throughout. LEAF -- imports NOTHING.

// The minimum excludant of a list of non-negative integers: the smallest non-negative integer that does NOT appear.
// mex([]) = 0, mex([0,1,2]) = 3, mex([1,2,3]) = 0. This is the heart of every Grundy-number computation.
fn mex(vals: list) -> int
    let present = {}
    for i in 0..len(vals)
        if vals[i] >= 0
            present[str(vals[i])] = 1
    let m = 0
    while get(present, str(m), 0) == 1
        m += 1
    m

// The Grundy value of a Nim position: the XOR ("nim-sum") of all pile sizes. Standard Nim (remove any positive
// number of stones from one pile) is a win for the player to move exactly when this is nonzero.
fn nim_value(piles: list) -> int
    let x = 0
    let i = 0
    while i < len(piles)
        x = x ^ piles[i]
        i += 1
    x

// True if the Nim position is a WIN for the player about to move (its nim-sum is nonzero).
fn nim_is_winning(piles: list) -> bool
    nim_value(piles) != 0

// Grundy numbers for a subtraction (take-away) game on a single pile: from a pile of size i you may remove any
// amount listed in `moves`. Returns the list g of length n+1 where g[i] is the Grundy number of a pile of size i
// (g[i] == 0 means a pile of size i is a losing position for the mover). g[i] = mex of the Grundy numbers of every
// reachable smaller pile.
fn grundy_subtraction(n: int, moves: list) -> list
    let g = []
    let i = 0
    while i <= n
        let reach = []
        for m in 0..len(moves)
            let mv = moves[m]
            if mv <= i and mv > 0
                push(reach, g[i - mv])
        push(g, mex(reach))
        i += 1
    g

// Combine independent games by the Sprague-Grundy theorem: the Grundy value of a sum of games is the XOR of their
// individual Grundy values. The combined position is losing for the mover exactly when this is 0.
fn grundy_xor(values: list) -> int
    let x = 0
    for i in 0..len(values)
        x = x ^ values[i]
    x
