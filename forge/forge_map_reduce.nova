// forge_map_reduce — MapReduce framework (simulated, single-node).

fn mr_new() -> dict
    {"inputs": {}, "mapped": {}, "input_count": 0, "mapped_count": 0, "reduced": {}, "phase": "input"}

fn mr_add_input(m: dict, key: string, value: int) -> dict
    let k = str(m["input_count"])
    m["inputs"]["{k}_key"] = key
    m["inputs"]["{k}_value"] = value
    m["input_count"] += 1
    m

fn mr_map_identity(m: dict) -> dict
    for i in 0..m["input_count"]
        let k = str(i)
        let mk = str(m["mapped_count"])
        m["mapped"]["{mk}_key"] = m["inputs"]["{k}_key"]
        m["mapped"]["{mk}_value"] = m["inputs"]["{k}_value"]
        m["mapped_count"] += 1
    m["phase"] = "mapped"
    m

fn mr_reduce_sum(m: dict) -> dict
    for i in 0..m["mapped_count"]
        let k = str(i)
        let key = m["mapped"]["{k}_key"]
        let val = m["mapped"]["{k}_value"]
        if key in m["reduced"]
            m["reduced"][key] += val
        else
            m["reduced"][key] = val
    m["phase"] = "reduced"
    m

fn mr_result(m: dict, key: string) -> int
    if key not in m["reduced"]
        return 0
    m["reduced"][key]

fn mr_phase(m: dict) -> string
    m["phase"]

fn mr_input_count(m: dict) -> int
    m["input_count"]

fn mr_result_count(m: dict) -> int
    len(keys(m["reduced"]))
