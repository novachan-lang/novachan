// forge_hilbert -- the Hilbert space-filling curve: a way to number the cells of a 2D grid along one continuous
// path so that CONSECUTIVE numbers are always physically adjacent (no jumps). Like forge_morton it flattens 2D
// to 1D for spatial indexing, but with STRICTLY better locality -- Morton's Z-order occasionally leaps across the
// grid, while the Hilbert curve never does, which makes it the preferred ordering for spatial databases and
// R-trees, cache-friendly image and matrix traversal, dithering and halftoning patterns, IP-address / geographic
// heatmaps, and turning 2D data into a 1D sequence where neighbours stay neighbours. hilbert_xy2d maps a cell to
// its distance along the curve; hilbert_d2xy maps a distance back to a cell. `order` is the grid side length and
// must be a power of two (2, 4, 8, 16, ...). Pure integer bit math. LEAF -- imports NOTHING.

// The distance d along the Hilbert curve for cell (x, y) in an `order` x `order` grid.
fn hilbert_xy2d(order: int, x0: int, y0: int) -> int
    let x = x0
    let y = y0
    let d = 0
    let s = order / 2
    while s > 0
        let rx = 0
        if (x & s) > 0
            rx = 1
        let ry = 0
        if (y & s) > 0
            ry = 1
        d += s * s * ((3 * rx) ^ ry)
        // rotate the quadrant
        if ry == 0
            if rx == 1
                x = order - 1 - x
                y = order - 1 - y
            let t = x
            x = y
            y = t
        s = s / 2
    d

// The cell [x, y] at distance d along the Hilbert curve in an `order` x `order` grid.
fn hilbert_d2xy(order: int, d: int) -> list
    let x = 0
    let y = 0
    let t = d
    let s = 1
    while s < order
        let rx = 1 & (t / 2)
        let ry = 1 & (t ^ rx)
        // rotate
        if ry == 0
            if rx == 1
                x = s - 1 - x
                y = s - 1 - y
            let tmp = x
            x = y
            y = tmp
        x += s * rx
        y += s * ry
        t = t / 4
        s = s * 2
    [x, y]
