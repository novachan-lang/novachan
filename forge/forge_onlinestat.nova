// forge_onlinestat -- running statistics computed ONE value at a time, without storing the data. Feed it a
// stream of numbers and read back count, mean, variance, standard deviation, min, and max at any moment -- in
// O(1) memory, single pass. forge_stats computes these over a full list you already have; forge_onlinestat is
// for the stream you DON'T want to keep: live metrics/telemetry, sensor feeds, request latencies, a rolling
// dashboard, or anomaly detection (the z-score of a new sample tells you how many standard deviations it sits
// from the running mean). It uses Welford's algorithm, which is numerically stable -- it does NOT suffer the
// catastrophic cancellation of the naive "sum of squares minus square of sum" formula. LEAF -- imports NOTHING.

// A new accumulator: [count, mean, M2, min, max]. mean/M2/min/max are floats.
fn ostat_new() -> list
    [0, 0.0, 0.0, 0.0, 0.0]

// Observe one value (Welford update). O(1).
fn ostat_add(s: list, x)
    let xf = x * 1.0
    s[0] += 1
    let c = s[0]
    let mean = s[1] * 1.0
    let delta = xf - mean
    let newmean = mean + delta / (c * 1.0)
    s[1] = newmean
    let delta2 = xf - newmean
    s[2] = (s[2] * 1.0) + delta * delta2
    if c == 1
        s[3] = xf
        s[4] = xf
    else
        let mn = s[3] * 1.0
        if xf < mn
            s[3] = xf
        let mx = s[4] * 1.0
        if xf > mx
            s[4] = xf

// Number of observations.
fn ostat_count(s: list) -> int
    s[0]

// Running arithmetic mean (0.0 if empty).
fn ostat_mean(s: list) -> float
    let m = s[1] * 1.0
    m

// POPULATION variance (divide by n). 0.0 if empty.
fn ostat_variance(s: list) -> float
    let c = s[0]
    let v = (s[2] * 1.0) / (c * 1.0) if c > 0 else 0.0
    v

// SAMPLE variance (divide by n-1, unbiased estimator). 0.0 if fewer than 2 observations.
fn ostat_sample_variance(s: list) -> float
    let c = s[0]
    let v = (s[2] * 1.0) / ((c - 1) * 1.0) if c > 1 else 0.0
    v

// POPULATION standard deviation.
fn ostat_stddev(s: list) -> float
    let v = ostat_variance(s)
    let sd = sqrt(v) if v > 0.0 else 0.0
    sd

// SAMPLE standard deviation.
fn ostat_sample_stddev(s: list) -> float
    let v = ostat_sample_variance(s)
    let sd = sqrt(v) if v > 0.0 else 0.0
    sd

// Smallest value seen (0.0 if empty).
fn ostat_min(s: list) -> float
    let m = s[3] * 1.0
    m

// Largest value seen (0.0 if empty).
fn ostat_max(s: list) -> float
    let m = s[4] * 1.0
    m

// The z-score of value x against the running distribution: (x - mean) / stddev = how many standard deviations
// from the mean. 0.0 if stddev is 0. Above ~3 (or below ~-3) flags an outlier.
fn ostat_zscore(s: list, x) -> float
    let sd = ostat_stddev(s)
    let z = ((x * 1.0) - ostat_mean(s)) / sd if sd > 0.0 else 0.0
    z
