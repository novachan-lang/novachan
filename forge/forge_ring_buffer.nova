// forge_ring_buffer — Fixed-size circular buffer.
// Push overwrites oldest, peek at head/tail.

fn rb_new(capacity: int) -> dict
    let rb = {}
    rb["items"] = []
    rb["capacity"] = capacity
    rb["total_written"] = 0
    rb

fn rb_push(rb: dict, value: string) -> dict
    rb["total_written"] = rb["total_written"] + 1
    if len(rb["items"]) < rb["capacity"]
        push(rb["items"], value)
        return rb
    let new_items = []
    let i = 1
    while i < len(rb["items"])
        push(new_items, rb["items"][i])
        i = i + 1
    push(new_items, value)
    rb["items"] = new_items
    rb

fn rb_peek_newest(rb: dict) -> string
    if len(rb["items"]) == 0
        return ""
    rb["items"][len(rb["items"]) - 1]

fn rb_peek_oldest(rb: dict) -> string
    if len(rb["items"]) == 0
        return ""
    rb["items"][0]

fn rb_size(rb: dict) -> int
    len(rb["items"])

fn rb_capacity(rb: dict) -> int
    rb["capacity"]

fn rb_is_full(rb: dict) -> int
    if len(rb["items"]) >= rb["capacity"]
        return 1
    0

fn rb_to_list(rb: dict) -> list
    rb["items"]

fn rb_total_written(rb: dict) -> int
    rb["total_written"]
