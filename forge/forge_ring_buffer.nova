// forge_ring_buffer — fixed-size circular buffer with Result API.

fn rb_new(capacity: int) -> dict
    let r = {}
    r["data"] = {}
    r["capacity"] = capacity
    r["head"] = 0
    r["size"] = 0
    r["total_written"] = 0
    r

fn rb_write(r: dict, value: string) -> dict
    let idx = (r["head"] + r["size"]) % r["capacity"]
    let key = "rb_" + str(idx)
    r["data"][key] = value
    if r["size"] < r["capacity"]
        r["size"] = r["size"] + 1
    else
        r["head"] = (r["head"] + 1) % r["capacity"]
    r["total_written"] = r["total_written"] + 1
    r

fn rb_read(r: dict, idx: int) -> Result
    if idx < 0 or idx >= r["size"]
        return err("index out of range")
    let actual = (r["head"] + idx) % r["capacity"]
    let key = "rb_" + str(actual)
    ok(r["data"][key])

fn rb_latest(r: dict) -> Result
    if r["size"] == 0
        return err("buffer empty")
    rb_read(r, r["size"] - 1)

fn rb_oldest(r: dict) -> Result
    if r["size"] == 0
        return err("buffer empty")
    rb_read(r, 0)

fn rb_size(r: dict) -> int
    r["size"]

fn rb_capacity(r: dict) -> int
    r["capacity"]

fn rb_is_full(r: dict) -> int
    if r["size"] >= r["capacity"]
        return 1
    0
