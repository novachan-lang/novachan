// forge_lyndon -- Lyndon words and the two O(n) string tools built on them: Duval's Chen-Fox-Lindon FACTORIZATION
// and the SMALLEST CYCLIC ROTATION of a string. A Lyndon word is one strictly smaller than all of its own rotations
// (like "aab" or "abc"); the deep fact is that EVERY string factors uniquely into a non-increasing sequence of
// Lyndon words, and Duval's algorithm finds that factorization in a single linear left-to-right pass. That
// factorization and its cousin, the least rotation, are the practical core of: canonicalizing a cyclic sequence so
// two rotations of the same necklace compare equal (circular DNA, bracelet/necklace enumeration, cyclic-string
// hashing and dedup), generating de Bruijn sequences, and suffix-structure and BWT constructions. smallest_rotation
// returns the lexicographically least rotation (the canonical form of a cycle) in linear time instead of the naive
// O(n^2) of comparing all rotations, and is_lyndon tests the defining property. Character comparison is by byte
// value (ord), so it works on any byte string. LEAF -- imports NOTHING.

// The Lyndon (Chen-Fox-Lindon) factorization of s: the unique list of Lyndon words, in non-increasing order, whose
// concatenation is s. Computed by Duval's algorithm in one linear pass.
fn lyndon_factorization(s: string) -> list
    let n = len(s)
    let facts = []
    let i = 0
    while i < n
        let j = i + 1
        let k = i
        while j < n and ord(char_at(s, k)) <= ord(char_at(s, j))
            if ord(char_at(s, k)) < ord(char_at(s, j))
                k = i
            else
                k = k + 1
            j = j + 1
        while i <= k
            push(facts, slice(s, i, i + (j - k)))
            i = i + (j - k)
    facts

// True if s is a Lyndon word: nonempty and strictly smaller than every one of its proper rotations (equivalently,
// its Lyndon factorization is the single word s).
fn is_lyndon(s: string) -> bool
    let out = false
    if len(s) > 0
        let f = lyndon_factorization(s)
        if len(f) == 1
            out = true
    out

// The lexicographically smallest cyclic rotation of s (its canonical necklace form), found in linear time by
// running Duval's process over the doubled string. Two strings are rotations of each other iff they share this
// canonical form.
fn smallest_rotation(s: string) -> string
    let m = len(s)
    let out = ""
    if m > 0
        let ss = s + s
        let n = len(ss)
        let i = 0
        let ans = 0
        while i < m
            ans = i
            let j = i + 1
            let k = i
            while j < n and ord(char_at(ss, k)) <= ord(char_at(ss, j))
                if ord(char_at(ss, k)) < ord(char_at(ss, j))
                    k = i
                else
                    k = k + 1
                j = j + 1
            while i <= k
                i = i + (j - k)
        out = slice(s, ans, m) + slice(s, 0, ans)
    out

// The starting index (0-based) in s of its smallest cyclic rotation.
fn smallest_rotation_index(s: string) -> int
    let m = len(s)
    let ans = 0
    if m > 0
        let ss = s + s
        let n = len(ss)
        let i = 0
        while i < m
            ans = i
            let j = i + 1
            let k = i
            while j < n and ord(char_at(ss, k)) <= ord(char_at(ss, j))
                if ord(char_at(ss, k)) < ord(char_at(ss, j))
                    k = i
                else
                    k = k + 1
                j = j + 1
            while i <= k
                i = i + (j - k)
    ans
