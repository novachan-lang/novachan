// forge_rollout_strategy — Configurable rollout strategies (linear/exponential/custom).

fn rs_new(strategy: string, total_targets: int) -> dict
    let r = {}
    r["strategy"] = strategy
    r["total"] = total_targets
    r["current_pct"] = 0
    r["step"] = 0
    r["paused"] = 0
    r["completed"] = 0
    r

fn rs_advance(r: dict) -> dict
    if r["paused"] == 1
        return r
    if r["completed"] == 1
        return r
    r["step"] = r["step"] + 1
    if r["strategy"] == "linear"
        r["current_pct"] = r["current_pct"] + 10
    else
        if r["strategy"] == "exponential"
            if r["current_pct"] == 0
                r["current_pct"] = 1
            else
                r["current_pct"] = r["current_pct"] * 2
        else
            r["current_pct"] = r["current_pct"] + 25
    if r["current_pct"] >= 100
        r["current_pct"] = 100
        r["completed"] = 1
    r

fn rs_pause(r: dict) -> dict
    r["paused"] = 1
    r

fn rs_resume(r: dict) -> dict
    r["paused"] = 0
    r

fn rs_rollback(r: dict) -> dict
    r["current_pct"] = 0
    r["step"] = 0
    r["completed"] = 0
    r["paused"] = 0
    r

fn rs_current_pct(r: dict) -> int
    r["current_pct"]

fn rs_targets_affected(r: dict) -> int
    r["total"] * r["current_pct"] / 100

fn rs_is_complete(r: dict) -> int
    r["completed"]

fn rs_step_count(r: dict) -> int
    r["step"]

fn rs_strategy(r: dict) -> string
    r["strategy"]
