// forge_network_partition — Simulate network partitions for testing.

fn np_new() -> dict
    {"nodes": {}, "partitions": {}, "node_count": 0, "partition_count": 0}

fn np_add_node(n: dict, name: string, group: int) -> dict
    n["nodes"][name] = group
    n["node_count"] += 1
    n

fn np_partition(n: dict, group_a: int, group_b: int) -> dict
    let k = str(n["partition_count"])
    n["partitions"]["{k}_a"] = group_a
    n["partitions"]["{k}_b"] = group_b
    n["partitions"]["{k}_active"] = 1
    n["partition_count"] += 1
    n

fn np_heal(n: dict, idx: int) -> dict
    if idx < n["partition_count"]
        let k = str(idx)
        n["partitions"]["{k}_active"] = 0
    n

fn np_can_reach(n: dict, from_node: string, to_node: string) -> int
    let g1 = n["nodes"][from_node]
    let g2 = n["nodes"][to_node]
    if g1 == g2
        return 1
    for i in 0..n["partition_count"]
        let k = str(i)
        if n["partitions"]["{k}_active"] == 1
            let a = n["partitions"]["{k}_a"]
            let b = n["partitions"]["{k}_b"]
            if g1 == a
                if g2 == b
                    return 0
            if g1 == b
                if g2 == a
                    return 0
    1

fn np_active_partitions(n: dict) -> int
    let count = 0
    for i in 0..n["partition_count"]
        let k = str(i)
        if n["partitions"]["{k}_active"] == 1
            count += 1
    count

fn np_node_count(n: dict) -> int
    n["node_count"]
