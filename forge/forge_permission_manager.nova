// forge_permission_manager — role-based permission checking with Result API.

fn pm_new() -> dict
    {"roles": {}, "user_roles": {}, "role_count": 0, "check_count": 0, "grant_count": 0}

fn pm_add_role(p: dict, role: string) -> dict
    let rk = "r_" + role
    if rk not in p["roles"]
        p["roles"][rk] = ""
        p["role_count"] += 1
    p

fn pm_grant_permission(p: dict, role: string, permission: string) -> Result
    let rk = "r_" + role
    if rk not in p["roles"]
        return err("role not found: {role}")
    let pk = "p_" + role + "_" + permission
    p["roles"][pk] = "granted"
    p["grant_count"] += 1
    ok(p)

fn pm_assign_role(p: dict, user: string, role: string) -> Result
    let rk = "r_" + role
    if rk not in p["roles"]
        return err("role not found: {role}")
    let uk = "u_" + user
    p["user_roles"][uk] = role
    ok(p)

fn pm_check(p: dict, user: string, permission: string) -> int
    p["check_count"] += 1
    let uk = "u_" + user
    if uk not in p["user_roles"]
        return 0
    let role = p["user_roles"][uk]
    let pk = "p_" + role + "_" + permission
    1 if pk in p["roles"] else 0

fn pm_user_role(p: dict, user: string) -> Result
    let uk = "u_" + user
    if uk not in p["user_roles"]
        return err("no role assigned")
    ok(p["user_roles"][uk])

fn pm_role_count(p: dict) -> int
    p["role_count"]

fn pm_check_count(p: dict) -> int
    p["check_count"]
