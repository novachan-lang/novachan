// forge_etag -- HTTP ETag + conditional requests (RFC 7232). An ETag is a content fingerprint returned with a
// response; the client echoes it as If-None-Match and the server replies 304 Not Modified (empty body) when
// the content is unchanged -- saving bandwidth and a re-render. etag_for fingerprints a body; etag_matches
// honors a comma list and "*"; weak validators (W/"...") compare by opaque value. Uses a 32-bit FNV-1a
// fingerprint (no crypto dependency -> a LEAF); swap a strong hash in for collision-critical caches.
//
// LEAF -- imports NOTHING. Built-ins: ord, char_at, len, chr, trim, split, slice, starts_with.

fn _etag_hash(body: string) -> string
    let h = 2166136261
    let n = len(body)
    for i in 0..n
        h = (h * 16777619 + ord(char_at(body, i))) % 4294967296
    let alpha = "0123456789abcdef"
    let out = ""
    let v = h
    for j in 0..8
        out = char_at(alpha, v % 16) + out
        v = v / 16
    out

// A strong ETag for a response body: a quoted fingerprint, e.g. "1a2b3c4d".
fn etag_for(body: string) -> string
    let q = chr(34)
    q + _etag_hash(body) + q

// PRIVATE: drop a weak-validator prefix W/ so weak comparison matches by opaque value.
fn _etag_strip(tag: string) -> string
    if starts_with(tag, "W/")
        return slice(tag, 2, len(tag))
    tag

// Does the client's If-None-Match header match this etag? "*" matches any current representation; otherwise
// the header is a comma list of (possibly weak) etags -- true if any equals ours (weak comparison).
fn etag_matches(if_none_match: string, etag: string) -> bool
    let h = trim(if_none_match)
    if h == "*"
        return true
    let want = _etag_strip(etag)
    let parts = split(h, ",")
    for i in 0..len(parts)
        if _etag_strip(trim(parts[i])) == want
            return true
    false

// Should the handler short-circuit to 304 Not Modified? True when a non-empty If-None-Match matches the etag.
fn etag_not_modified(if_none_match: string, etag: string) -> bool
    if len(if_none_match) == 0
        return false
    etag_matches(if_none_match, etag)
