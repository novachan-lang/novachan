// forge_crc16 -- CRC-16 checksums (the 16-bit companion to forge_checksum's CRC-32). CRC-16 guards short
// framed messages in embedded and industrial protocols: Modbus, XMODEM, USB tokens, GSM, and countless
// device wire formats. This module implements the non-reflected polynomial-0x1021 family: CRC-16/CCITT-FALSE
// (init 0xFFFF) and CRC-16/XMODEM (init 0x0000), both verified against the standard "123456789" check value.
// Operates on a byte list (each element 0..255). LEAF -- imports NOTHING.

// PRIVATE: MSB-first CRC-16 with polynomial 0x1021 and a given initial register value.
fn _crc16(data: list, init: int) -> int
    let crc = init
    let n = len(data)
    for i in 0..n
        crc = crc ^ ((data[i] & 255) * 256)
        crc = crc & 65535
        let bit = 0
        while bit < 8
            if (crc & 32768) != 0
                crc = ((crc * 2) ^ 4129) & 65535
            else
                crc = (crc * 2) & 65535
            bit += 1
    crc & 65535

// CRC-16/CCITT-FALSE (poly 0x1021, init 0xFFFF). Standard check("123456789") = 0x29B1.
fn crc16_ccitt(data: list) -> int
    _crc16(data, 65535)

// CRC-16/XMODEM (poly 0x1021, init 0x0000). Standard check("123456789") = 0x31C3.
fn crc16_xmodem(data: list) -> int
    _crc16(data, 0)

// Lowercase 4-hex-digit rendering of a CRC-16 value (zero-padded), e.g. 0x29b1 -> "29b1".
fn crc16_hex(crc: int) -> string
    let digs = "0123456789abcdef"
    char_at(digs, (crc / 4096) & 15) + char_at(digs, (crc / 256) & 15) + char_at(digs, (crc / 16) & 15) + char_at(digs, crc & 15)
