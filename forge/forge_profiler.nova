// forge_profiler — sampling profiler library for NOVA programs.
// Tracks function call durations, call counts, and identifies hotspots.
// Pure in-process profiling via manual instrumentation (enter/exit markers).

fn prof_new()
    let p = {}
    p["fn_count"] = 0
    p["fn_names"] = ""
    p["total_samples"] = 0
    p["active_fn"] = ""
    p["active_start"] = 0
    return p

fn prof_register(p, fn_name: string)
    let key = "fn_" + fn_name + "_calls"
    if key not in p
        p[key] = 0
        p["fn_" + fn_name + "_total_time"] = 0
        p["fn_" + fn_name + "_min_time"] = 999999999
        p["fn_" + fn_name + "_max_time"] = 0
        p["fn_count"] = int(p["fn_count"]) + 1
        if p["fn_names"] == ""
            p["fn_names"] = fn_name
        else
            p["fn_names"] = p["fn_names"] + "," + fn_name
    return p

fn prof_enter(p, fn_name: string, timestamp: int)
    let key = "fn_" + fn_name + "_calls"
    if key not in p
        p = prof_register(p, fn_name)
    p["active_fn"] = fn_name
    p["active_start"] = timestamp
    return p

fn prof_exit(p, fn_name: string, timestamp: int) -> Result
    let key = "fn_" + fn_name + "_calls"
    if key not in p
        return err("unknown function: " + fn_name)
    let start = int(p["active_start"])
    let duration = timestamp - start
    if duration < 0
        duration = 0
    p[key] = int(p[key]) + 1
    let total_key = "fn_" + fn_name + "_total_time"
    p[total_key] = int(p[total_key]) + duration
    let min_key = "fn_" + fn_name + "_min_time"
    if duration < int(p[min_key])
        p[min_key] = duration
    let max_key = "fn_" + fn_name + "_max_time"
    if duration > int(p[max_key])
        p[max_key] = duration
    p["total_samples"] = int(p["total_samples"]) + 1
    p["active_fn"] = ""
    p["active_start"] = 0
    return ok(p)

fn prof_calls(p, fn_name: string) -> Result
    let key = "fn_" + fn_name + "_calls"
    if key not in p
        return err("unknown function: " + fn_name)
    return ok(int(p[key]))

fn prof_total_time(p, fn_name: string) -> Result
    let key = "fn_" + fn_name + "_total_time"
    if key not in p
        return err("unknown function: " + fn_name)
    return ok(int(p[key]))

fn prof_avg_time(p, fn_name: string) -> Result
    let calls_key = "fn_" + fn_name + "_calls"
    if calls_key not in p
        return err("unknown function: " + fn_name)
    let calls = int(p[calls_key])
    if calls == 0
        return err("no calls recorded")
    let total = int(p["fn_" + fn_name + "_total_time"])
    return ok(total / calls)

fn prof_min_time(p, fn_name: string) -> Result
    let key = "fn_" + fn_name + "_min_time"
    if key not in p
        return err("unknown function: " + fn_name)
    let val = int(p[key])
    if val == 999999999
        return err("no calls recorded")
    return ok(val)

fn prof_max_time(p, fn_name: string) -> Result
    let key = "fn_" + fn_name + "_max_time"
    if key not in p
        return err("unknown function: " + fn_name)
    let val = int(p[key])
    if val == 0 and int(p["fn_" + fn_name + "_calls"]) == 0
        return err("no calls recorded")
    return ok(val)

fn prof_hotspot(p) -> Result
    let names = p["fn_names"]
    if names == ""
        return err("no functions profiled")
    let parts = split(str(names), ",")
    let best_name = ""
    let best_time = 0
    for part in parts
        let tkey = "fn_" + part + "_total_time"
        if tkey in p
            let t = int(p[tkey])
            if t > best_time
                best_time = t
                best_name = part
    if best_name == ""
        return err("no calls recorded")
    return ok(best_name)

fn prof_fn_count(p)
    return int(p["fn_count"])

fn prof_total_samples(p)
    return int(p["total_samples"])

fn prof_fn_list(p)
    return str(p["fn_names"])

fn prof_report(p, fn_name: string) -> Result
    let key = "fn_" + fn_name + "_calls"
    if key not in p
        return err("unknown function: " + fn_name)
    let calls = int(p[key])
    let total = int(p["fn_" + fn_name + "_total_time"])
    let avg = 0
    if calls > 0
        avg = total / calls
    let result = fn_name + ": calls=" + str(calls) + " total=" + str(total) + " avg=" + str(avg)
    return ok(result)

fn prof_report_all(p)
    let names = p["fn_names"]
    if names == ""
        return ""
    let parts = split(str(names), ",")
    let result = ""
    for part in parts
        let r = prof_report(p, part)
        if is_ok(r)
            if result == ""
                result = unwrap(r)
            else
                result += "\n" + unwrap(r)
    return result

fn prof_pct(p, fn_name: string) -> Result
    let key = "fn_" + fn_name + "_total_time"
    if key not in p
        return err("unknown function: " + fn_name)
    let fn_total = int(p[key])
    let names = p["fn_names"]
    let parts = split(str(names), ",")
    let grand_total = 0
    for part in parts
        let tkey = "fn_" + part + "_total_time"
        if tkey in p
            grand_total += int(p[tkey])
    if grand_total == 0
        return err("no time recorded")
    return ok((fn_total * 100) / grand_total)
