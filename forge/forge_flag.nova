// forge_flag -- country-code -> flag emoji (e.g. "US" -> the US flag), via Unicode REGIONAL INDICATOR symbols.
// For country pickers, locale badges, and internationalized UIs. Each ASCII letter A-Z maps to a regional
// indicator code point (U+1F1E6 + offset); two combine into a flag glyph. Emits 4-byte UTF-8 (astral plane)
// via /,% (no bit-shifts). LEAF -- imports NOTHING.

// PRIVATE: the 4-byte UTF-8 for the regional indicator of an uppercase ASCII letter (code `lu`).
fn _flag_ri(lu: int) -> string
    let cp = 127462 + (lu - 65)
    chr(240 + (cp / 262144)) + chr(128 + ((cp / 4096) % 64)) + chr(128 + ((cp / 64) % 64)) + chr(128 + (cp % 64))

// The flag emoji for a 2-letter country code ("US", "gb"). "" unless exactly two ASCII letters.
fn flag_emoji(country_code: string) -> string
    let c = upper(trim(country_code))
    if len(c) != 2
        return ""
    let a = ord(char_at(c, 0))
    let b = ord(char_at(c, 1))
    if a < 65 or a > 90 or b < 65 or b > 90
        return ""
    _flag_ri(a) + _flag_ri(b)
