// forge_accumulator — numeric accumulator with statistics, Result API.

fn acc_new() -> dict
    let a = {}
    a["sum"] = 0
    a["count"] = 0
    a["min_val"] = 999999999
    a["max_val"] = -999999999
    a

fn acc_add(a: dict, value: int) -> dict
    a["sum"] = a["sum"] + value
    a["count"] = a["count"] + 1
    if value < a["min_val"]
        a["min_val"] = value
    if value > a["max_val"]
        a["max_val"] = value
    a

fn acc_sum(a: dict) -> int
    a["sum"]

fn acc_count(a: dict) -> int
    a["count"]

fn acc_mean(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    ok(a["sum"] / a["count"])

fn acc_min(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    ok(a["min_val"])

fn acc_max(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    ok(a["max_val"])

fn acc_range(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    ok(a["max_val"] - a["min_val"])
