// forge_shamir -- Shamir's Secret Sharing: split a secret into n "shares" so that any k of them reconstruct it
// exactly, while any k-1 of them reveal NOTHING at all about it (not "hard to compute" -- information-theoretically
// nothing). This is the standard way to protect a master key, a crypto wallet seed, a root CA key, or a nuclear
// launch code: hand out shares to n custodians, require any k to cooperate, and tolerate up to n-k lost or
// compromised shares. The trick is pure algebra over a prime field: hide the secret as the constant term of a
// random degree-(k-1) polynomial, and give each custodian one point on that curve. Because exactly k points
// determine a degree-(k-1) polynomial, any k shares recover the whole curve (and thus its value at 0, the secret)
// by Lagrange interpolation, while k-1 points leave the constant term equally likely to be ANY field element. All
// arithmetic is modulo a prime you choose larger than the secret and larger than n; keep the prime under ~3 billion
// so intermediate products stay in signed 64-bit. The random coefficients are seeded for reproducibility here (a
// real deployment must use a cryptographic RNG). Pairs with forge_modarith / forge_primes. LEAF -- imports NOTHING.

// PRIVATE: modular exponentiation base^exp mod m.
fn _sh_modexp(base: int, exp: int, m: int) -> int
    let result = 1
    let b = ((base % m) + m) % m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = (result * b) % m
        b = (b * b) % m
        e = e / 2
    result

// PRIVATE: modular inverse of a modulo the PRIME p, via Fermat's little theorem (a^(p-2) mod p).
fn _sh_modinv(a: int, p: int) -> int
    _sh_modexp(a, p - 2, p)

// Split `secret` into `n` shares with threshold `k` over the prime field mod `prime`. Returns a flat list
// [x1,y1, x2,y2, ..., xn,yn] where each (xi, yi) is one share (xi runs 1..n). The random polynomial coefficients
// above the constant term are derived from `seed`. Any k of the returned shares reconstruct the secret.
fn shamir_split(secret: int, n: int, k: int, prime: int, seed: int) -> list
    // coefficients: a0 = secret, a1..a_{k-1} pseudo-random in [0, prime)
    let coeffs = []
    push(coeffs, ((secret % prime) + prime) % prime)
    let s = seed
    let c = 1
    while c < k
        s = (s * 1103515245 + 12345) % 2147483648
        push(coeffs, s % prime)
        c = c + 1
    let out = []
    let x = 1
    while x <= n
        // evaluate the polynomial at x mod prime by Horner's method
        let y = 0
        let d = k - 1
        while d >= 0
            y = (y * x + coeffs[d]) % prime
            d = d - 1
        push(out, x)
        push(out, y)
        x = x + 1
    out

// Reconstruct the secret from k (or more) shares given as parallel lists xs and ys, by Lagrange interpolation
// evaluated at x = 0, all modulo `prime`. The x values must be distinct and nonzero.
fn shamir_reconstruct(xs: list, ys: list, prime: int) -> int
    let secret = 0
    let m = len(xs)
    let i = 0
    while i < m
        // Lagrange basis L_i(0) = product over j != i of (-x_j) / (x_i - x_j)
        let num = 1
        let den = 1
        let j = 0
        while j < m
            if j != i
                num = (num * ((prime - (xs[j] % prime)) % prime)) % prime
                let diff = (((xs[i] - xs[j]) % prime) + prime) % prime
                den = (den * diff) % prime
            j = j + 1
        let term = ((ys[i] % prime) + prime) % prime
        term = (term * num) % prime
        term = (term * _sh_modinv(den, prime)) % prime
        secret = (secret + term) % prime
        i = i + 1
    secret
