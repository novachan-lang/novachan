// forge_qp -- Quoted-Printable encoding (MIME, RFC 2045), the transfer encoding email uses for text that is
// "mostly ASCII" with a few special bytes. Where base64 (forge_base64) blows every 3 bytes up to 4 and makes the
// text unreadable, quoted-printable leaves ordinary printable ASCII UNTOUCHED and only escapes the bytes that
// can't survive a mail transport -- writing each as "=" followed by two hex digits (so "café" becomes "caf=E9").
// That keeps the payload human-readable and compact for Latin text with occasional accents, which is exactly why
// email headers/bodies and .eml files use it. Decoding reverses it and also drops "soft line breaks" (a lone "="
// at end of line, used to wrap long lines without inserting real newlines). Byte-oriented (no NUL). LEAF.

// PRIVATE: byte 0..255 -> two uppercase hex characters.
fn _qp_hex(n: int) -> string
    let digits = "0123456789ABCDEF"
    char_at(digits, n / 16) + char_at(digits, n % 16)

// PRIVATE: a hex character -> 0..15, or -1 if not a hex digit (accepts upper and lower case).
fn _qp_hexval(ch: string) -> int
    let o = ord(ch)
    let out = 0 - 1
    if o >= 48 and o <= 57
        out = o - 48
    if o >= 65 and o <= 70
        out = o - 65 + 10
    if o >= 97 and o <= 102
        out = o - 97 + 10
    out

// Encode a string to quoted-printable: printable ASCII (and space/tab) pass through, "=" and any other byte become
// "=XX" with uppercase hex.
fn qp_encode(s: string) -> string
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        let o = ord(c)
        if c == "="
            out += "=3D"
        else
            if o == 32 or o == 9
                out += c
            else
                if o >= 33 and o <= 126
                    out += c
                else
                    out += "=" + _qp_hex(o)
    out

// Decode quoted-printable back to the original string. Handles "=XX" hex escapes and drops soft line breaks
// ("=\n" and "=\r\n"). A malformed "=" not followed by valid hex is kept literally.
fn qp_decode(s: string) -> string
    let out_parts = []
    let n = len(s)
    let i = 0
    while i < n
        let c = char_at(s, i)
        if c == "="
            if i + 1 < n and ord(char_at(s, i + 1)) == 10
                i += 2
            else
                if i + 1 < n and ord(char_at(s, i + 1)) == 13
                    if i + 2 < n and ord(char_at(s, i + 2)) == 10
                        i += 3
                    else
                        i += 2
                else
                    let h1 = 0 - 1
                    let h2 = 0 - 1
                    if i + 2 < n
                        h1 = _qp_hexval(char_at(s, i + 1))
                        h2 = _qp_hexval(char_at(s, i + 2))
                    if h1 >= 0 and h2 >= 0
                        push(out_parts, chr(h1 * 16 + h2))
                        i += 3
                    else
                        push(out_parts, c)
                        i += 1
        else
            push(out_parts, c)
            i += 1
    let out = join(out_parts, "")
    out
