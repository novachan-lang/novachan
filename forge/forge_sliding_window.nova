// forge_sliding_window — time-based sliding window counter with Result API.

fn sw_new(window_size: int) -> dict
    let s = {}
    s["window"] = window_size
    s["buckets"] = {}
    s["total"] = 0
    s["count"] = 0
    s

fn sw_record(s: dict, timestamp: int, value: int) -> dict
    let key = "t_" + str(timestamp)
    if contains(s["buckets"], key) == true
        s["buckets"][key] = s["buckets"][key] + value
    else
        s["buckets"][key] = value
    s["total"] = s["total"] + value
    s["count"] = s["count"] + 1
    s

fn sw_query(s: dict, from_ts: int, to_ts: int) -> int
    let sum = 0
    let t = from_ts
    while t <= to_ts
        let key = "t_" + str(t)
        if contains(s["buckets"], key) == true
            sum += s["buckets"][key]
        t += 1
    sum

fn sw_count(s: dict) -> int
    s["count"]

fn sw_total(s: dict) -> int
    s["total"]

fn sw_window_size(s: dict) -> int
    s["window"]
