// forge_i18n -- S18: internationalization / localization (Django gettext, Spring MessageSource, Rails I18n).
// Register messages per locale; translate a key with a fallback chain (locale -> "en" -> default) and
// {param} interpolation; resolve the locale from an Accept-Language header. Closes FORGE_FEATURE_AUDIT §L
// (i18n missing).
//
// Message strings carry {name} placeholders. Like templates, a message written as a NOVA STRING LITERAL
// can't contain a literal { (interpolation trap) -- so load messages from config/files at runtime, or build
// them via chr() in code. The interpolation scanner works on the runtime string regardless.
//
// LEAF MODULE -- imports NOTHING. Built-ins: contains, len, split, trim, slice, find, lower, chr, str.

fn i18n_new() -> dict
    {}

// Register a message for (locale, key). Fluent.
fn i18n_add(store: dict, locale: string, key: string, message: string) -> dict
    if contains(store, locale) == false
        store[locale] = {}
    let bundle = store[locale]
    bundle[key] = message
    store

// Translate: the message for (locale, key), else the "en" fallback, else `default`.
fn i18n_t(store: dict, locale: string, key: string, default: string) -> string
    if contains(store, locale)
        let b = store[locale]
        if contains(b, key)
            return b[key]
    if contains(store, "en")
        let be = store["en"]
        if contains(be, key)
            return be[key]
    default

// PRIVATE: replace {param} placeholders in `msg` with params[param] (a missing param is left as {param}).
fn _i18n_interp(msg: string, params: dict) -> string
    let out = ""
    let i = 0
    let n = len(msg)
    let lb = chr(123)
    let rb = chr(125)
    while i < n
        if msg[i] == lb
            let rest = slice(msg, i, n)
            let end = find(rest, rb)
            if end < 0
                out = out + slice(msg, i, n)
                i = n
            else
                let key = trim(slice(msg, i + 1, i + end))
                if contains(params, key)
                    out = out + str(params[key])
                else
                    out = out + slice(msg, i, i + end + 1)
                i = i + end + 1
        else
            out = out + msg[i]
            i = i + 1
    out

// Translate + interpolate {param} placeholders. i18n_ti(store, "fr", "greeting", "Hi {name}", {name:"ada"}).
fn i18n_ti(store: dict, locale: string, key: string, default: string, params: dict) -> string
    _i18n_interp(i18n_t(store, locale, key, default), params)

// Resolve the best `supported` locale for an Accept-Language header (primary subtag match, entry order),
// else supported[0]. Empty header / no match -> supported[0].
fn i18n_locale(accept_lang: string, supported: list) -> string
    if len(supported) == 0
        return "en"
    if len(accept_lang) == 0
        return supported[0]
    let parts = split(accept_lang, ",")
    let first = trim(parts[0])
    let semi = find(first, ";")
    if semi >= 0
        first = trim(slice(first, 0, semi))
    let dash = find(first, "-")
    let prim = first
    if dash >= 0
        prim = slice(first, 0, dash)
    let i = 0
    while i < len(supported)
        if lower(supported[i]) == lower(prim)
            return supported[i]
        i = i + 1
    supported[0]
