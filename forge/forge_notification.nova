// forge_notification — Multi-channel notification system.
// Channels: email, sms, push, webhook. Template rendering.

fn notif_service() -> dict
    let s = {}
    s["channels"] = {}
    s["templates"] = {}
    s["sent"] = []
    s

fn notif_register_channel(svc: dict, name: string, channel_type: string) -> dict
    let ch = {}
    ch["type"] = channel_type
    ch["enabled"] = true
    ch["sent_count"] = 0
    svc["channels"][name] = ch
    svc

fn notif_disable_channel(svc: dict, name: string) -> dict
    if contains(svc["channels"], name)
        svc["channels"][name]["enabled"] = false
    svc

fn notif_enable_channel(svc: dict, name: string) -> dict
    if contains(svc["channels"], name)
        svc["channels"][name]["enabled"] = true
    svc

fn notif_add_template(svc: dict, name: string, subject: string, body: string) -> dict
    let t = {}
    t["subject"] = subject
    t["body"] = body
    svc["templates"][name] = t
    svc

fn notif_render(svc: dict, template_name: string, vars: dict) -> dict
    let result = {}
    if contains(svc["templates"], template_name) != true
        result["subject"] = ""
        result["body"] = ""
        return result
    let tmpl = svc["templates"][template_name]
    let subj = tmpl["subject"]
    let body = tmpl["body"]
    let vkeys = keys(vars)
    for i in 0..len(vkeys)
        let placeholder = "<<" + vkeys[i] + ">>"
        subj = str_replace(subj, placeholder, str(vars[vkeys[i]]))
        body = str_replace(body, placeholder, str(vars[vkeys[i]]))
    result["subject"] = subj
    result["body"] = body
    result

fn notif_send(svc: dict, channel: string, recipient: string, subject: string, body: string) -> dict
    if contains(svc["channels"], channel) != true
        return svc
    let ch = svc["channels"][channel]
    if ch["enabled"] != true
        return svc
    let record = {}
    record["channel"] = channel
    record["recipient"] = recipient
    record["subject"] = subject
    record["body"] = body
    record["status"] = "sent"
    push(svc["sent"], record)
    svc["channels"][channel]["sent_count"] = svc["channels"][channel]["sent_count"] + 1
    svc

fn notif_send_template(svc: dict, channel: string, recipient: string, template_name: string, vars: dict) -> dict
    let rendered = notif_render(svc, template_name, vars)
    notif_send(svc, channel, recipient, rendered["subject"], rendered["body"])

fn notif_history(svc: dict) -> list
    svc["sent"]

fn notif_count(svc: dict, channel: string) -> int
    if contains(svc["channels"], channel)
        return svc["channels"][channel]["sent_count"]
    0

fn notif_list_channels(svc: dict) -> list
    keys(svc["channels"])
