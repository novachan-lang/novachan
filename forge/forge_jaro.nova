// forge_jaro -- Jaro & Jaro-Winkler string similarity (0..1), the gold standard for fuzzy NAME/record matching,
// deduplication, and entity resolution (better than edit distance for short strings + typos + transpositions;
// Winkler boosts common-prefix matches, ideal for names). Completes the fuzzy toolkit: forge_levenshtein
// (edit distance) + forge_phonetic (sounds-alike) + this (spelling similarity). LEAF -- imports NOTHING.

fn jaro(s1: string, s2: string) -> float
    let l1 = len(s1)
    let l2 = len(s2)
    if l1 == 0 and l2 == 0
        return 1.0
    if l1 == 0 or l2 == 0
        return 0.0
    let mx = l1
    if l2 > mx
        mx = l2
    let window = mx / 2 - 1
    if window < 0
        window = 0
    let s1m = []
    let s2m = []
    let i = 0
    while i < l1
        push(s1m, false)
        i = i + 1
    i = 0
    while i < l2
        push(s2m, false)
        i = i + 1
    let m = 0
    i = 0
    while i < l1
        let lo = i - window
        if lo < 0
            lo = 0
        let hi = i + window + 1
        if hi > l2
            hi = l2
        let j = lo
        let matched = false
        while j < hi and matched == false
            if s2m[j] == false and char_at(s1, i) == char_at(s2, j)
                s1m[i] = true
                s2m[j] = true
                m = m + 1
                matched = true
            j = j + 1
        i = i + 1
    if m == 0
        return 0.0
    let t = 0
    let k = 0
    i = 0
    while i < l1
        if s1m[i]
            while s2m[k] == false
                k = k + 1
            if char_at(s1, i) != char_at(s2, k)
                t = t + 1
            k = k + 1
        i = i + 1
    let mf = m * 1.0
    let tf = (t / 2) * 1.0
    (mf / l1 + mf / l2 + (mf - tf) / mf) / 3.0

// Jaro-Winkler: Jaro boosted by the common prefix (up to 4 chars, scaling factor 0.1). Higher for strings
// that agree from the start -- the standard for person-name matching.
fn jaro_winkler(s1: string, s2: string) -> float
    let j = jaro(s1, s2)
    let maxp = 4
    if len(s1) < maxp
        maxp = len(s1)
    if len(s2) < maxp
        maxp = len(s2)
    let p = 0
    while p < maxp and char_at(s1, p) == char_at(s2, p)
        p = p + 1
    j + p * 0.1 * (1.0 - j)
