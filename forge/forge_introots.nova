// forge_introots -- EXACT integer roots and perfect-power detection, with no floating point (so no rounding error
// near boundaries, where float sqrt famously returns 3.9999999 for 16). iroot(x, n) is the floor of the n-th root
// of x -- the largest r with r^n <= x -- found by binary search using an overflow-safe capped power, so it stays
// correct for full 64-bit inputs. On top of that: is_perfect_square / is_perfect_cube, and is_perfect_power, which
// decides whether x can be written as a^b with a >= 2 and b >= 2 and returns that base and (maximal) exponent.
// These are bread-and-butter number theory: perfect-power tests are a required first step in the AKS primality
// test and in factoring, exact roots avoid the classic off-by-one bugs of casting float sqrt back to int, and
// floor-root shows up in Pollard's rho, tiling/packing, and hashing. Non-negative integers. LEAF -- imports NOTHING.

// PRIVATE: base^exp, but stop and return cap+1 as soon as it would exceed cap (prevents 64-bit overflow).
fn _ir_pow_capped(base: int, exp: int, cap: int) -> int
    let result = 1
    let i = 0
    let overflow = false
    while i < exp and not overflow
        if base != 0 and result > cap / base
            overflow = true
        else
            result = result * base
        i += 1
    cap + 1 if overflow else result

// The floor of the n-th root of x (largest r with r^n <= x). iroot(27,3)=3, iroot(100,2)=10, iroot(26,3)=2.
fn iroot(x: int, n: int) -> int
    if n < 1
        return 0
    if x <= 1
        return x
    let lo = 1
    let hi = x
    let best = 1
    while lo <= hi
        let mid = (lo + hi) / 2
        let p = _ir_pow_capped(mid, n, x)
        if p <= x
            best = mid
            lo = mid + 1
        else
            hi = mid - 1
    best

// True if x is a perfect square (some integer r with r*r == x).
fn is_perfect_square(x: int) -> bool
    if x < 0
        return false
    let r = iroot(x, 2)
    r * r == x

// True if x is a perfect cube.
fn is_perfect_cube(x: int) -> bool
    if x < 0
        return false
    let r = iroot(x, 3)
    _ir_pow_capped(r, 3, x) == x

// Whether x is a perfect power a^b (a >= 2, b >= 2), as [found, base, exponent] using the MAXIMAL exponent (so the
// base is as small as possible). is_perfect_power(64) = [1, 2, 6]; a non-power gives [0, 0, 0].
fn is_perfect_power(x: int) -> list
    if x < 4
        return [0, 0, 0]
    // largest exponent to try: 2^b <= x
    let maxb = 1
    while (1 << (maxb + 1)) <= x
        maxb += 1
    let b = maxb
    while b >= 2
        let r = iroot(x, b)
        if r >= 2 and _ir_pow_capped(r, b, x) == x
            return [1, r, b]
        b -= 1
    [0, 0, 0]
