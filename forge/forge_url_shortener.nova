// forge_url_shortener — URL shortening service with Result API.

fn us_new() -> dict
    let u = {}
    u["urls"] = {}
    u["reverse"] = {}
    u["counter"] = 0
    u["total_lookups"] = 0
    u["total_hits"] = 0
    u

fn us_shorten(u: dict, url: string) -> dict
    let rk = "r_" + url
    if contains(u["reverse"], rk) == true
        return u
    u["counter"] = u["counter"] + 1
    let code = _us_encode(u["counter"])
    let key = "s_" + code
    u["urls"][key] = url
    u["reverse"][rk] = code
    u

fn us_resolve(u: dict, code: string) -> Result
    u["total_lookups"] = u["total_lookups"] + 1
    let key = "s_" + code
    if contains(u["urls"], key) != true
        return err("code not found")
    u["total_hits"] = u["total_hits"] + 1
    ok(u["urls"][key])

fn us_get_code(u: dict, url: string) -> Result
    let rk = "r_" + url
    if contains(u["reverse"], rk) != true
        return err("url not shortened")
    ok(u["reverse"][rk])

fn us_count(u: dict) -> int
    u["counter"]

fn us_hit_rate(u: dict) -> int
    if u["total_lookups"] == 0
        return 0
    u["total_hits"] * 100 / u["total_lookups"]

fn _us_encode(n: int) -> string
    let chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    let result = ""
    let v = n
    while v > 0
        let idx = v % 36
        result = slice(chars, idx, idx + 1) + result
        v = v / 36
    if result == ""
        return "a"
    result
