// forge_factoradic -- the factorial number system and its killer application: giving every PERMUTATION a unique
// integer INDEX and back. perm_rank turns a permutation into its position in lexicographic order; perm_unrank
// turns an index straight into the k-th permutation WITHOUT generating the k-1 before it. That's a perfect,
// gap-free numbering of the n! arrangements, which lets you pick a uniformly random permutation from a random
// index, store/transmit a shuffle as one small number, resume an exhaustive search from where it left off, or
// stripe permutations across workers by index range. Under the hood a number is written in "factoradic" -- digit d
// at place i ranges 0..i and carries weight i! -- which is exactly the Lehmer code of a permutation. Unlike
// forge_permute (which streams permutations in order), this is O(1) random access to the arrangement at any index.
// Works on permutations of [0..n-1]; map through your own array for other elements. LEAF -- imports NOTHING.

// PRIVATE: n! (n >= 0).
fn _fc_fact(n: int) -> int
    let f = 1
    let i = 2
    while i <= n
        f = f * i
        i += 1
    f

// The number of permutations of n items (n!).
fn num_permutations(n: int) -> int
    _fc_fact(n)

// Convert a non-negative number to its factoradic digits, most-significant first, in `length` places (place j from
// the left has weight (length-1-j)!). to_factoradic(5,3) = [2,1,0].
fn to_factoradic(num: int, length: int) -> list
    let digits = []
    let n = num
    let place = length - 1
    while place >= 0
        let f = _fc_fact(place)
        push(digits, n / f)
        n = n % f
        place -= 1
    digits

// Convert factoradic digits (most-significant first) back to a number.
fn from_factoradic(digits: list) -> int
    let length = len(digits)
    let out = 0
    for j in 0..length
        out += digits[j] * _fc_fact(length - 1 - j)
    out

// The k-th permutation (0-indexed, lexicographic) of [0, 1, ..., n-1], directly from the index k.
fn perm_unrank(n: int, k: int) -> list
    let elems = [e for e in 0..n]
    let result = []
    let rem = k
    let i = n - 1
    while i >= 0
        let f = _fc_fact(i)
        let idx = rem / f
        rem = rem % f
        push(result, elems[idx])
        // remove elems[idx] by shifting left then popping
        let s = idx
        while s < len(elems) - 1
            elems[s] = elems[s + 1]
            s += 1
        pop(elems)
        i -= 1
    result

// The lexicographic rank (0-indexed) of a permutation of [0..n-1] among all n! permutations.
fn perm_rank(perm: list) -> int
    let n = len(perm)
    let rank = 0
    for i in 0..n
        let smaller = 0
        let j = i + 1
        while j < n
            if perm[j] < perm[i]
                smaller += 1
            j += 1
        rank += smaller * _fc_fact(n - 1 - i)
    rank
