// forge_rs -- Reed-Solomon error-correcting CODES: the redundancy that lets QR codes survive being scratched,
// CDs/DVDs survive scuffs, RAID-6 survive two dead disks, and deep-space probes get data home across noise. This
// module builds the ENCODING and error-DETECTION half over the GF(2^8) byte field (forge_gf256): given a message of
// k bytes and a chosen number of parity bytes nsym, rs_encode appends nsym check bytes so the whole codeword is,
// as a polynomial over the field, an exact multiple of a fixed "generator" polynomial whose roots are 3^0..3^(nsym-1).
// That single algebraic fact is what makes the code work: a clean codeword EVALUATES TO ZERO at every one of those
// roots (its "syndromes" are all zero), and the moment any byte is corrupted at least one syndrome becomes nonzero,
// so rs_has_errors detects up to nsym corrupted symbols with certainty. (Full error CORRECTION -- locating and
// repairing the bad bytes via Berlekamp-Massey / Chien / Forney -- is a deeper follow-on; this is the encode +
// detect foundation everything else is built on.) The encoding is SYSTEMATIC: the original message bytes appear
// unchanged as the first k symbols, followed by the nsym parity symbols. All symbols are bytes 0..255. Imports
// forge_gf256 (a leaf) -- forge-only, compiler untouched.

import forge_gf256 as gf

// PRIVATE: multiply a polynomial (list of coefficients, index 0 = highest degree) by a scalar in the field.
fn _rs_poly_scale(p: list, x: int) -> list
    let out = []
    let i = 0
    while i < len(p)
        push(out, gf.gf_mul(p[i], x))
        i = i + 1
    out

// PRIVATE: multiply two polynomials over GF(2^8) (convolution with field multiply/add).
fn _rs_poly_mul(p: list, q: list) -> list
    let out = []
    let n = len(p) + len(q) - 1
    let z = 0
    while z < n
        push(out, 0)
        z = z + 1
    let j = 0
    while j < len(q)
        let i = 0
        while i < len(p)
            out[i + j] = out[i + j] ^ gf.gf_mul(p[i], q[j])
            i = i + 1
        j = j + 1
    out

// PRIVATE: evaluate a polynomial at x by Horner's method (index 0 = highest degree).
fn _rs_poly_eval(p: list, x: int) -> int
    let y = p[0]
    let i = 1
    while i < len(p)
        y = gf.gf_mul(y, x) ^ p[i]
        i = i + 1
    y

// The Reed-Solomon generator polynomial for nsym parity symbols: the product of (x - 3^i) for i in 0..nsym-1,
// returned as coefficients with index 0 = highest degree. Length nsym+1.
fn rs_generator_poly(nsym: int) -> list
    let g = [1]
    let i = 0
    while i < nsym
        let factor = [1, gf.gf_pow(3, i)]
        g = _rs_poly_mul(g, factor)
        i = i + 1
    g

// Systematically encode a message (a list of byte values) with nsym parity symbols. Returns a codeword of length
// len(msg)+nsym: the original message bytes unchanged, followed by nsym computed parity bytes.
fn rs_encode(msg: list, nsym: int) -> list
    let gen = rs_generator_poly(nsym)
    let glen = len(gen)
    // msg followed by nsym zeros
    let out = []
    let i = 0
    while i < len(msg)
        push(out, msg[i])
        i = i + 1
    let z = 0
    while z < glen - 1
        push(out, 0)
        z = z + 1
    // synthetic division: the tail becomes the remainder
    let k = 0
    while k < len(msg)
        let coef = out[k]
        if coef != 0
            let j = 1
            while j < glen
                out[k + j] = out[k + j] ^ gf.gf_mul(gen[j], coef)
                j = j + 1
        k = k + 1
    // restore the original message into the systematic prefix (the scratch overwrote it)
    let r = 0
    while r < len(msg)
        out[r] = msg[r]
        r = r + 1
    out

// The nsym syndromes of a codeword: syndrome i = codeword evaluated at 3^i. For an uncorrupted codeword EVERY
// syndrome is 0; any nonzero syndrome proves the data was corrupted.
fn rs_syndromes(codeword: list, nsym: int) -> list
    let out = []
    let i = 0
    while i < nsym
        push(out, _rs_poly_eval(codeword, gf.gf_pow(3, i)))
        i = i + 1
    out

// True if the codeword shows any corruption (some syndrome is nonzero). Detects up to nsym corrupted symbols.
fn rs_has_errors(codeword: list, nsym: int) -> bool
    let synd = rs_syndromes(codeword, nsym)
    let bad = false
    let i = 0
    while i < len(synd)
        if synd[i] != 0
            bad = true
        i = i + 1
    bad
