// forge_saga_coordinator — distributed saga pattern with compensations and Result API.

fn saga_new(name: string) -> dict
    {"name": name, "steps": {}, "step_count": 0, "executed": 0, "compensated": 0, "status": "pending"}

fn saga_add_step(s: dict, step_name: string, compensation: string) -> dict
    let idx = s["step_count"]
    s["steps"]["s_" + str(idx) + "_name"] = step_name
    s["steps"]["s_" + str(idx) + "_comp"] = compensation
    s["steps"]["s_" + str(idx) + "_done"] = 0
    s["step_count"] = idx + 1
    s

fn saga_execute_step(s: dict, step_index: int) -> Result
    if step_index < 0 or step_index >= s["step_count"]
        return err("step index out of range")
    let sk = "s_" + str(step_index) + "_done"
    if s["steps"][sk] == 1
        return err("step already executed")
    s["steps"][sk] = 1
    s["executed"] += 1
    s["status"] = "in_progress"
    if s["executed"] == s["step_count"]
        s["status"] = "completed"
    ok(s)

fn saga_compensate(s: dict, step_index: int) -> Result
    if step_index < 0 or step_index >= s["step_count"]
        return err("step index out of range")
    let dk = "s_" + str(step_index) + "_done"
    if s["steps"][dk] != 1
        return err("step not executed, cannot compensate")
    s["steps"][dk] = 0
    s["compensated"] += 1
    s["executed"] -= 1
    s["status"] = "compensating"
    ok(s)

fn saga_step_name(s: dict, step_index: int) -> Result
    if step_index < 0 or step_index >= s["step_count"]
        return err("step index out of range")
    ok(s["steps"]["s_" + str(step_index) + "_name"])

fn saga_compensation(s: dict, step_index: int) -> Result
    if step_index < 0 or step_index >= s["step_count"]
        return err("step index out of range")
    ok(s["steps"]["s_" + str(step_index) + "_comp"])

fn saga_status(s: dict) -> string
    s["status"]

fn saga_step_count(s: dict) -> int
    s["step_count"]

fn saga_executed_count(s: dict) -> int
    s["executed"]

fn saga_compensated_count(s: dict) -> int
    s["compensated"]
