// forge_workflow — Workflow / state machine engine.
// Define states + transitions + guards. Execute step-by-step.
// Pure data — no I/O. Composes with Forge process model.

fn wf_new(name: string, initial_state: string) -> dict
    {"name": name, "initial": initial_state, "current": initial_state, "states": {}, "transitions": [], "history": [], "data": {}}

fn wf_add_state(wf: dict, name: string, kind: string) -> dict
    wf["states"][name] = {"kind": kind}
    wf

fn wf_add_transition(wf: dict, from_state: string, to_state: string, event: string) -> dict
    push(wf["transitions"], {"from": from_state, "to": to_state, "event": event, "guard": ""})
    wf

fn wf_add_guarded_transition(wf: dict, from_state: string, to_state: string, event: string, guard: string) -> dict
    push(wf["transitions"], {"from": from_state, "to": to_state, "event": event, "guard": guard})
    wf

fn wf_send(wf: dict, event: string) -> dict
    let current = wf["current"]
    for i in 0..len(wf["transitions"])
        let t = wf["transitions"][i]
        if t["from"] == current and t["event"] == event
            if len(t["guard"]) > 0
                if not _wf_check_guard(wf, t["guard"])
                    continue
            push(wf["history"], {"from": current, "to": t["to"], "event": event})
            wf["current"] = t["to"]
            return wf
    wf

fn wf_can_send(wf: dict, event: string) -> bool
    let current = wf["current"]
    for i in 0..len(wf["transitions"])
        let t = wf["transitions"][i]
        if t["from"] == current and t["event"] == event
            return true
    false

fn wf_available_events(wf: dict) -> list
    let current = wf["current"]
    let events = []
    for i in 0..len(wf["transitions"])
        let t = wf["transitions"][i]
        if t["from"] == current
            push(events, t["event"])
    events

fn wf_state(wf: dict) -> string
    wf["current"]

fn wf_is_final(wf: dict) -> bool
    if wf["current"] in wf["states"]
        return wf["states"][wf["current"]]["kind"] == "final"
    false

fn wf_set_data(wf: dict, key: string, value: any) -> dict
    wf["data"][key] = value
    wf

fn wf_get_data(wf: dict, key: string) -> any
    if key in wf["data"]
        return wf["data"][key]
    null

fn wf_history(wf: dict) -> list
    wf["history"]

fn wf_reset(wf: dict) -> dict
    wf["current"] = wf["initial"]
    wf["history"] = []
    wf

fn _wf_check_guard(wf: dict, guard: string) -> bool
    if guard in wf["data"]
        let v = wf["data"][guard]
        if type_of(v) == "int"
            return v != 0
        return true
    false
