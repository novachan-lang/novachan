// forge_consistent_hash — consistent hashing ring with Result API.

fn ch_new(replicas: int) -> dict
    let c = {}
    c["replicas"] = replicas
    c["nodes"] = {}
    c["node_count"] = 0
    c["ring_size"] = 0
    c

fn ch_add_node(c: dict, node: string) -> dict
    let i = 0
    while i < c["replicas"]
        let vnode = node + "_" + str(i)
        let hv = hash(vnode)
        if hv < 0
            hv = 0 - hv
        let key = "r_" + str(hv % 10000)
        c["nodes"][key] = node
        c["ring_size"] = c["ring_size"] + 1
        i += 1
    c["node_count"] = c["node_count"] + 1
    c

fn ch_get_node(c: dict, key: string) -> Result
    if c["ring_size"] == 0
        return err("no nodes in ring")
    let hv = hash(key)
    if hv < 0
        hv = 0 - hv
    let probe = hv % 10000
    for attempts in 0..10000
        let rk = "r_" + str(probe)
        if contains(c["nodes"], rk) == true
            return ok(c["nodes"][rk])
        probe = (probe + 1) % 10000
    ok(c["nodes"]["r_0"])

fn ch_node_count(c: dict) -> int
    c["node_count"]

fn ch_ring_size(c: dict) -> int
    c["ring_size"]
