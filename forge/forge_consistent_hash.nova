// forge_consistent_hash — Consistent hashing for partitioning.
// Map keys to nodes with minimal remapping on node add/remove.

fn ch_new(replicas: int) -> dict
    let ch = {}
    ch["nodes"] = []
    ch["replicas"] = replicas
    ch["ring"] = []
    ch

fn ch_add_node(ch: dict, node: string) -> dict
    push(ch["nodes"], node)
    let i = 0
    while i < ch["replicas"]
        let point = {}
        point["hash"] = _ch_hash(node, i)
        point["node"] = node
        push(ch["ring"], point)
        i = i + 1
    ch = _ch_sort_ring(ch)
    ch

fn _ch_hash(node: string, replica: int) -> int
    let h = len(node) * 31 + replica * 17
    h = h * 2654435761
    if h < 0
        h = 0 - h
    h % 10000

fn _ch_sort_ring(ch: dict) -> dict
    let ring = ch["ring"]
    let n = len(ring)
    let i = 0
    while i < n - 1
        let j = 0
        while j < n - 1 - i
            if ring[j]["hash"] > ring[j + 1]["hash"]
                let tmp = ring[j]
                ring[j] = ring[j + 1]
                ring[j + 1] = tmp
            j = j + 1
        i = i + 1
    ch["ring"] = ring
    ch

fn ch_get_node(ch: dict, key: string) -> string
    if len(ch["ring"]) == 0
        return ""
    let h = _ch_hash(key, 0)
    let i = 0
    while i < len(ch["ring"])
        if ch["ring"][i]["hash"] >= h
            return ch["ring"][i]["node"]
        i = i + 1
    ch["ring"][0]["node"]

fn ch_node_count(ch: dict) -> int
    len(ch["nodes"])

fn ch_ring_size(ch: dict) -> int
    len(ch["ring"])
