// forge_ab_test — A/B testing framework with Result API.

fn ab_new() -> dict
    let t = {}
    t["experiments"] = {}
    t["exp_count"] = 0
    t["total_impressions"] = 0
    t["total_conversions"] = 0
    t

fn ab_create(t: dict, name: string, variant_a: string, variant_b: string) -> Result
    let key = "exp_" + name
    let has = contains(t["experiments"], key)
    if has == true
        return err("experiment already exists: " + name)
    t["experiments"][key] = variant_a + "|" + variant_b
    t["experiments"][key + "_a_imp"] = 0
    t["experiments"][key + "_b_imp"] = 0
    t["experiments"][key + "_a_conv"] = 0
    t["experiments"][key + "_b_conv"] = 0
    t["exp_count"] = t["exp_count"] + 1
    ok(t)

fn ab_assign(t: dict, name: string, user_hash: int) -> Result
    let key = "exp_" + name
    let has = contains(t["experiments"], key)
    if has != true
        return err("unknown experiment: " + name)
    let bucket = user_hash % 2
    t["total_impressions"] = t["total_impressions"] + 1
    if bucket == 0
        t["experiments"][key + "_a_imp"] = t["experiments"][key + "_a_imp"] + 1
        return ok("a")
    t["experiments"][key + "_b_imp"] = t["experiments"][key + "_b_imp"] + 1
    ok("b")

fn ab_convert(t: dict, name: string, variant: string) -> Result
    let key = "exp_" + name
    let has = contains(t["experiments"], key)
    if has != true
        return err("unknown experiment: " + name)
    t["total_conversions"] = t["total_conversions"] + 1
    if variant == "a"
        t["experiments"][key + "_a_conv"] = t["experiments"][key + "_a_conv"] + 1
        return ok(t)
    if variant == "b"
        t["experiments"][key + "_b_conv"] = t["experiments"][key + "_b_conv"] + 1
        return ok(t)
    err("invalid variant: " + variant)

fn ab_conversion_rate(t: dict, name: string, variant: string) -> Result
    let key = "exp_" + name
    let has = contains(t["experiments"], key)
    if has != true
        return err("unknown experiment")
    if variant == "a"
        let imp = t["experiments"][key + "_a_imp"]
        if imp == 0
            return ok(0)
        return ok(t["experiments"][key + "_a_conv"] * 100 / imp)
    if variant == "b"
        let imp = t["experiments"][key + "_b_imp"]
        if imp == 0
            return ok(0)
        return ok(t["experiments"][key + "_b_conv"] * 100 / imp)
    err("invalid variant")

fn ab_winner(t: dict, name: string) -> Result
    let key = "exp_" + name
    let has = contains(t["experiments"], key)
    if has != true
        return err("unknown experiment")
    let a_imp = t["experiments"][key + "_a_imp"]
    let b_imp = t["experiments"][key + "_b_imp"]
    if a_imp == 0 and b_imp == 0
        return err("no data yet")
    let a_rate = 0
    if a_imp > 0
        a_rate = t["experiments"][key + "_a_conv"] * 1000 / a_imp
    let b_rate = 0
    if b_imp > 0
        b_rate = t["experiments"][key + "_b_conv"] * 1000 / b_imp
    if a_rate > b_rate
        return ok("a")
    if b_rate > a_rate
        return ok("b")
    ok("tie")

fn ab_experiment_count(t: dict) -> int
    t["exp_count"]

fn ab_total_impressions(t: dict) -> int
    t["total_impressions"]
