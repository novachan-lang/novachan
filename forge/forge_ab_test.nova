// forge_ab_test — A/B testing framework.
// Experiments, variants, user assignment, result tracking.

fn ab_new() -> dict
    let a = {}
    a["experiments"] = {}
    a["assignments"] = {}
    a

fn ab_create(ab: dict, name: string, variants: list) -> dict
    let exp = {}
    exp["variants"] = variants
    exp["active"] = true
    exp["results"] = {}
    let i = 0
    while i < len(variants)
        let rd = {}
        rd["impressions"] = 0
        rd["conversions"] = 0
        exp["results"][variants[i]] = rd
        i = i + 1
    ab["experiments"][name] = exp
    ab

fn ab_assign(ab: dict, experiment: string, user_id: string, variant: string) -> dict
    let key = experiment + ":" + user_id
    ab["assignments"][key] = variant
    ab

fn ab_get_variant(ab: dict, experiment: string, user_id: string) -> string
    let key = experiment + ":" + user_id
    let has_key = contains(ab["assignments"], key)
    if has_key == true
        return ab["assignments"][key]
    ""

fn ab_record_impression(ab: dict, experiment: string, variant: string) -> dict
    let has_exp = contains(ab["experiments"], experiment)
    if has_exp == true
        let has_var = contains(ab["experiments"][experiment]["results"], variant)
        if has_var == true
            ab["experiments"][experiment]["results"][variant]["impressions"] = ab["experiments"][experiment]["results"][variant]["impressions"] + 1
    ab

fn ab_record_conversion(ab: dict, experiment: string, variant: string) -> dict
    let has_exp = contains(ab["experiments"], experiment)
    if has_exp == true
        let has_var = contains(ab["experiments"][experiment]["results"], variant)
        if has_var == true
            ab["experiments"][experiment]["results"][variant]["conversions"] = ab["experiments"][experiment]["results"][variant]["conversions"] + 1
    ab

fn ab_conversion_rate(ab: dict, experiment: string, variant: string) -> int
    let has_exp = contains(ab["experiments"], experiment)
    if has_exp != true
        return 0
    let has_var = contains(ab["experiments"][experiment]["results"], variant)
    if has_var != true
        return 0
    let r = ab["experiments"][experiment]["results"][variant]
    if r["impressions"] == 0
        return 0
    (r["conversions"] * 100) / r["impressions"]

fn ab_deactivate(ab: dict, experiment: string) -> dict
    let has_exp = contains(ab["experiments"], experiment)
    if has_exp == true
        ab["experiments"][experiment]["active"] = false
    ab

fn ab_is_active(ab: dict, experiment: string) -> bool
    let has_exp = contains(ab["experiments"], experiment)
    if has_exp != true
        return false
    let val = ab["experiments"][experiment]["active"]
    if val == true
        return true
    false

fn ab_list_experiments(ab: dict) -> list
    keys(ab["experiments"])

fn ab_winner(ab: dict, experiment: string) -> string
    let has_exp = contains(ab["experiments"], experiment)
    if has_exp != true
        return ""
    let variants = ab["experiments"][experiment]["variants"]
    let best = ""
    let best_rate = 0
    let i = 0
    while i < len(variants)
        let rate = ab_conversion_rate(ab, experiment, variants[i])
        if rate > best_rate
            best_rate = rate
            best = variants[i]
        i = i + 1
    best
