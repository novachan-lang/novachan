// forge_jacobi -- the Jacobi symbol (a/n), the generalization of the Legendre symbol (forge_modsolve's
// `legendre`, which requires a PRIME modulus) to any ODD POSITIVE n. Computed in O(log n) by quadratic
// reciprocity WITHOUT factoring n -- the same speed as a gcd. It equals the product of the Legendre
// symbols over n's prime factors, so it is +1/-1/0 and multiplicative in both arguments. Note: unlike
// Legendre, (a/n)=+1 does NOT prove a is a quadratic residue mod composite n (it only rules out -1) --
// but (a/n)=-1 DOES prove a is a non-residue. Core of the Solovay-Strassen primality test, quadratic
// reciprocity computations, and Cipolla/Tonelli residue checks over composite moduli. LEAF (no imports).

// Jacobi symbol (a / n) for ODD n > 0. Returns +1, -1, or 0 (0 iff gcd(a,n) > 1). n even/<=0 -> 0 (undefined).
fn jacobi(a: int, n: int) -> int
    if n <= 0
        return 0
    if n % 2 == 0
        return 0
    let x = ((a % n) + n) % n
    let m = n
    let result = 1
    while x != 0
        while x % 2 == 0
            x = x / 2
            let r8 = m % 8
            if r8 == 3 or r8 == 5
                result = -result
        let t = x
        x = m
        m = t
        if x % 4 == 3 and m % 4 == 3
            result = -result
        x = x % m
    if m == 1
        return result
    return 0
