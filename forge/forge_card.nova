// forge_card -- credit-card validation (Luhn checksum) + brand detection + PCI-safe masking.
// LEAF module -- imports NOTHING.

fn _card_clean(number: string) -> string
    let digits = "0123456789"
    let out_parts = []
    for i in 0..len(number)
        let c = char_at(number, i)
        if find(digits, c) >= 0
            push(out_parts, c)
    join(out_parts, "")

fn luhn_valid(number: string) -> bool
    let s = _card_clean(number)
    let n = len(s)
    if n == 0
        return false
    let sum = 0
    for i in 0..n
        let d = find("0123456789", char_at(s, i))
        if (n - 1 - i) % 2 == 1
            d = d * 2
            if d > 9
                d -= 9
        sum += d
    sum % 10 == 0

fn card_brand(number: string) -> string
    let s = _card_clean(number)
    let n = len(s)
    if starts_with(s, "4") and (n == 13 or n == 16)
        return "visa"
    if n == 16 and starts_with(s, "5")
        let second = char_at(s, 1)
        if second in ["1", "2", "3", "4", "5"]
            return "mastercard"
    if n == 15 and (starts_with(s, "34") or starts_with(s, "37"))
        return "amex"
    if n == 16 and starts_with(s, "6011")
        return "discover"
    "unknown"

fn card_mask(number: string) -> string
    let s = _card_clean(number)
    let n = len(s)
    if n <= 4
        return s
    let stars = n - 4
    repeat("*", stars) + slice(s, stars, n)
