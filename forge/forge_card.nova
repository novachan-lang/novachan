// forge_card -- credit-card validation (Luhn checksum) + brand detection
// (visa/mastercard/amex/discover) + PCI-safe masking (show only last 4).
// Cleans spaces/dashes first. NEVER log the full number (mask it).
//
// "Verified by reasoning": luhn_valid("4111111111111111") = true (known-valid Visa test number);
// card_brand("4111111111111111") = "visa"; card_mask("4111111111111111") -> "************1111".
//
// LEAF module -- imports NOTHING.
// Built-ins used: len, char_at, find, starts_with, slice, str.

// ── private helper ────────────────────────────────────────────────────────────────────────────────

// _card_clean: strip spaces and dashes, returning only the digit characters.
// A char is a digit iff find("0123456789", c) >= 0.
fn _card_clean(number: string) -> string
    let digits = "0123456789"
    let out = ""
    let n = len(number)
    let i = 0
    while i < n
        let c = char_at(number, i)
        if find(digits, c) >= 0
            out = out + c
        i = i + 1
    out

// ── public API ────────────────────────────────────────────────────────────────────────────────────

// luhn_valid: Luhn mod-10 checksum.
// From the RIGHTMOST digit going left, double every second digit (index from right: 1,3,5,...).
// If a doubled value > 9 subtract 9. Sum all digits; valid iff sum % 10 == 0.
// Implementation: digit at left-index i is doubled iff (n-1-i) is ODD.
fn luhn_valid(number: string) -> bool
    let s = _card_clean(number)
    let n = len(s)
    if n == 0
        return false
    let sum = 0
    let i = 0
    while i < n
        let d = find("0123456789", char_at(s, i))
        if (n - 1 - i) % 2 == 1
            d = d * 2
            if d > 9
                d = d - 9
        sum = sum + d
        i = i + 1
    sum % 10 == 0

// card_brand: detect card brand by prefix and cleaned length.
// visa       -- starts with "4", length 13 or 16
// mastercard -- starts with "51".."55", length 16
// amex       -- starts with "34" or "37", length 15
// discover   -- starts with "6011", length 16
// else       -- "unknown"
fn card_brand(number: string) -> string
    let s = _card_clean(number)
    let n = len(s)
    if starts_with(s, "4")
        if n == 13 or n == 16
            return "visa"
    if n == 16 and starts_with(s, "5")
        let second = char_at(s, 1)
        if second == "1" or second == "2" or second == "3" or second == "4" or second == "5"
            return "mastercard"
    if n == 15
        if starts_with(s, "34") or starts_with(s, "37")
            return "amex"
    if n == 16 and starts_with(s, "6011")
        return "discover"
    "unknown"

// card_mask: PCI-safe masking -- replace all but the last 4 digits with '*'.
// e.g. "4111111111111111" -> "************1111".
// If the cleaned number has 4 or fewer digits, return it as-is (nothing to mask).
fn card_mask(number: string) -> string
    let s = _card_clean(number)
    let n = len(s)
    if n <= 4
        return s
    let mask = ""
    let stars = n - 4
    let i = 0
    while i < stars
        mask = mask + "*"
        i = i + 1
    let last4 = slice(s, stars, n)
    mask + last4
