// forge_lease_manager — Distributed lease management.
// Acquire/renew/release leases with TTL for distributed coordination.

fn lm_new() -> dict
    {"leases": {}}

fn lm_acquire(lm: dict, resource: string, owner: string, ttl: int, now: int) -> int
    if resource in lm["leases"]
        let lease = lm["leases"][resource]
        let expires = lease["acquired_at"] + lease["ttl"]
        if expires > now
            if lease["owner"] != owner
                return 0
    lm["leases"][resource] = {"owner": owner, "ttl": ttl, "acquired_at": now}
    1

fn lm_release(lm: dict, resource: string, owner: string) -> int
    if resource not in lm["leases"]
        return 0
    if lm["leases"][resource]["owner"] != owner
        return 0
    lm["leases"][resource] = {"owner": "", "ttl": 0, "acquired_at": 0}
    1

fn lm_renew(lm: dict, resource: string, owner: string, ttl: int, now: int) -> int
    if resource not in lm["leases"]
        return 0
    if lm["leases"][resource]["owner"] != owner
        return 0
    lm["leases"][resource]["ttl"] = ttl
    lm["leases"][resource]["acquired_at"] = now
    1

fn lm_owner(lm: dict, resource: string) -> string
    if resource not in lm["leases"]
        return ""
    lm["leases"][resource]["owner"]

fn lm_is_held(lm: dict, resource: string, now: int) -> int
    if resource not in lm["leases"]
        return 0
    let lease = lm["leases"][resource]
    if lease["owner"] == ""
        return 0
    let expires = lease["acquired_at"] + lease["ttl"]
    if now >= expires
        return 0
    1

fn lm_lease_count(lm: dict) -> int
    len(keys(lm["leases"]))

fn lm_ttl_remaining(lm: dict, resource: string, now: int) -> int
    if resource not in lm["leases"]
        return 0
    let lease = lm["leases"][resource]
    let expires = lease["acquired_at"] + lease["ttl"]
    if now >= expires
        return 0
    expires - now
