// forge_maxrect -- two classic "largest rectangle" problems solved in linear/near-linear time with a monotonic
// stack. largest_rectangle_histogram finds the biggest axis-aligned rectangle that fits UNDER a histogram's bars
// (think the tallest-and-widest block you can carve out of a skyline); the O(n) trick keeps a stack of bars of
// increasing height and, whenever a shorter bar appears, "closes off" the taller ones -- each bar's rectangle
// extends left and right until it hits something shorter, and that span is known exactly the moment it's popped.
// maximal_rectangle builds on it to find the largest solid block of 1s in a binary grid: treat each row as the
// ground, accumulate how many 1s stack up in each column, and run the histogram solver per row. These power the
// largest empty/whitespace region on a page or UI, the biggest free rectangle in a packing or floor plan, maximal
// all-foreground/all-background areas in image analysis, and skyline/water problems. Integer heights, 0/1 grids.
// LEAF -- imports NOTHING.

// The area of the largest rectangle that fits under a histogram of bar `heights` (all >= 0). O(n) monotonic stack.
fn largest_rectangle_histogram(heights: list) -> int
    let n = len(heights)
    let stack = []
    let best = 0
    let i = 0
    while i <= n
        let cur = heights[i] if i < n else 0
        let go = true
        while go
            if len(stack) > 0 and heights[stack[len(stack) - 1]] > cur
                let top = pop(stack)
                let height = heights[top]
                let width = (i - stack[len(stack) - 1] - 1) if len(stack) > 0 else i
                let area = height * width
                if area > best
                    best = area
            else
                go = false
        push(stack, i)
        i += 1
    best

// The area of the largest rectangle of all 1s in a binary `matrix` (rows of 0/1). Runs the histogram solver on the
// per-column run-heights accumulated row by row.
fn maximal_rectangle(matrix: list) -> int
    let r = len(matrix)
    let best = 0
    if r > 0
        let c = len(matrix[0])
        let heights = [0 for z in 0..c]
        for row in 0..r
            for cc in 0..c
                if matrix[row][cc] == 1
                    heights[cc] += 1
                else
                    heights[cc] = 0
            let area = largest_rectangle_histogram(heights)
            if area > best
                best = area
    best
