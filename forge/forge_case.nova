// forge_case -- thin wrapper over std/text/case (canonical implementation).
import std/text/case

fn _case_words(s: string) -> list
    let upper_set = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lowerd = "abcdefghijklmnopqrstuvwxyz0123456789"
    let lowers = "abcdefghijklmnopqrstuvwxyz"
    let words = []
    let cur = []
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        if c == "_" or c == "-" or c == " " or c == "."
            if len(cur) > 0
                push(words, lower(join(cur, "")))
                cur = []
        else
            if i > 0 and find(upper_set, c) >= 0
                let prev_lowerd = find(lowerd, char_at(s, i - 1)) >= 0
                let prev_up = find(upper_set, char_at(s, i - 1)) >= 0
                let next_lower = i + 1 < n and find(lowers, char_at(s, i + 1)) >= 0
                if prev_lowerd or (prev_up and next_lower)
                    if len(cur) > 0
                        push(words, lower(join(cur, "")))
                        cur = []
            // c is "" only past last codepoint; must not become a list element
            if c != ""
                push(cur, c)
    if len(cur) > 0
        push(words, lower(join(cur, "")))
    words

// PRIVATE: uppercase the first character. Byte-sliced, matching the ASCII identifiers this module targets.

fn _cap(w: string) -> string
    if len(w) == 0
        return w
    upper(slice(w, 0, 1)) + slice(w, 1, len(w))

fn to_snake(s: string) -> string
    return to_snake(s)

fn to_kebab(s: string) -> string
    return to_kebab(s)

fn to_constant(s: string) -> string
    upper(join(_case_words(s), "_"))

fn to_camel(s: string) -> string
    return to_camel(s)

fn to_pascal(s: string) -> string
    return to_pascal(s)

fn to_title(s: string) -> string
    join([_cap(w) for w in _case_words(s)], " ")

