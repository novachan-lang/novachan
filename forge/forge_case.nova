// forge_case -- identifier case conversion (snake_case / camelCase / PascalCase / kebab-case / CONSTANT_CASE /
// Title Case). The glue for mapping API JSON keys <-> struct fields, code generators, and DB column <->
// attribute naming (what Jackson PropertyNamingStrategy / Rails underscore+camelize do). Splits ANY input
// (snake, kebab, camel, spaced, acronym runs) into words, then rejoins per target. LEAF -- imports NOTHING.

// PRIVATE: split an identifier into lowercase words. Boundaries: the separators _ - space . ; a lower/digit ->
// upper transition (camelCase); and an upper-run -> word transition (acronym end, "XMLHttp" -> xml + http).
fn _case_words(s: string) -> list
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lowerd = "abcdefghijklmnopqrstuvwxyz0123456789"
    let lowers = "abcdefghijklmnopqrstuvwxyz"
    let words = []
    let cur = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        if c == "_" or c == "-" or c == " " or c == "."
            if len(cur) > 0
                push(words, lower(cur))
                cur = ""
        else
            if i > 0 and find(upper, c) >= 0
                let prev_lowerd = find(lowerd, char_at(s, i - 1)) >= 0
                let prev_up = find(upper, char_at(s, i - 1)) >= 0
                let next_lower = i + 1 < n and find(lowers, char_at(s, i + 1)) >= 0
                if prev_lowerd or (prev_up and next_lower)
                    if len(cur) > 0
                        push(words, lower(cur))
                        cur = ""
            cur = cur + c
        i = i + 1
    if len(cur) > 0
        push(words, lower(cur))
    words

fn _join(words: list, sep: string) -> string
    let out = ""
    let i = 0
    while i < len(words)
        if i > 0
            out = out + sep
        out = out + words[i]
        i = i + 1
    out

fn _cap(w: string) -> string
    if len(w) == 0
        return w
    upper(slice(w, 0, 1)) + slice(w, 1, len(w))

fn to_snake(s: string) -> string
    _join(_case_words(s), "_")

fn to_kebab(s: string) -> string
    _join(_case_words(s), "-")

fn to_constant(s: string) -> string
    upper(_join(_case_words(s), "_"))

fn to_camel(s: string) -> string
    let ws = _case_words(s)
    let out = ""
    let i = 0
    while i < len(ws)
        if i == 0
            out = out + ws[i]
        else
            out = out + _cap(ws[i])
        i = i + 1
    out

fn to_pascal(s: string) -> string
    let ws = _case_words(s)
    let out = ""
    let i = 0
    while i < len(ws)
        out = out + _cap(ws[i])
        i = i + 1
    out

fn to_title(s: string) -> string
    let ws = _case_words(s)
    let out = ""
    let i = 0
    while i < len(ws)
        if i > 0
            out = out + " "
        out = out + _cap(ws[i])
        i = i + 1
    out
