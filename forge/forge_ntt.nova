// forge_ntt -- the Number Theoretic Transform: an integer-only FFT that multiplies two polynomials (or convolves
// two sequences) in O(n log n) instead of the schoolbook O(n*n). The FFT does this with complex numbers and
// floating point; the NTT does the SAME divide-and-conquer using modular arithmetic under a carefully chosen prime
// -- so it is EXACT (no rounding error) and needs no floats, which suits NOVA perfectly. It's the engine behind
// fast big-integer multiplication (multiply thousand-digit numbers quickly), signal/sequence convolution, fast
// polynomial arithmetic, and some string-matching tricks. The prime here is 998244353 = 119*2^23 + 1 with
// primitive root 3, which supports transform sizes up to 2^23. ntt_multiply takes two integer coefficient lists
// (constant term first) and returns their product's coefficients, exact as long as each output coefficient stays
// below the prime (~10^9). LEAF -- imports NOTHING.

// PRIVATE: the working prime and its primitive root.
fn _ntt_mod() -> int
    998244353

fn _ntt_root() -> int
    3

// PRIVATE: modular exponentiation base^exp mod m (native ints; products stay < 10^18).
fn _ntt_pow(base: int, exp: int, m: int) -> int
    let result = 1
    let b = base % m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = result * b % m
        b = b * b % m
        e /= 2
    result

// PRIVATE: in-place NTT (invert=0 forward, invert=1 inverse) on a list whose length is a power of two.
fn _ntt_transform(a: list, invert: int)
    let n = len(a)
    let p = _ntt_mod()
    let g = _ntt_root()
    // bit-reversal permutation
    let j = 0
    for i in 1..n
        let bit = n >> 1
        while (j & bit) != 0
            j = j ^ bit
            bit = bit >> 1
        j = j | bit
        if i < j
            let t = a[i]
            a[i] = a[j]
            a[j] = t
    // butterflies
    let length = 2
    while length <= n
        let exp = (p - 1) / length
        let w = 0
        if invert == 1
            w = _ntt_pow(g, p - 1 - exp, p)
        else
            w = _ntt_pow(g, exp, p)
        let half = length / 2
        let base = 0
        while base < n
            let wn = 1
            for k in 0..half
                let u = a[base + k]
                let v = a[base + k + half] * wn % p
                a[base + k] = (u + v) % p
                a[base + k + half] = (u - v + p) % p
                wn = wn * w % p
            base += length
        length = length << 1
    // scale by 1/n on the inverse transform
    if invert == 1
        let ninv = _ntt_pow(n, p - 2, p)
        for x in 0..n
            a[x] = a[x] * ninv % p

// Multiply two polynomials given as coefficient lists (constant term first). Returns the product coefficients.
// Exact as long as each result coefficient is below the prime (~10^9).
fn ntt_multiply(a: list, b: list) -> list
    let p = _ntt_mod()
    let rsize = 0 if (len(a) == 0 or len(b) == 0) else (len(a) + len(b) - 1)
    let out = []
    if rsize > 0
        // pad to a power of two >= rsize
        let n = 1
        while n < rsize
            n = n << 1
        let fa = []
        let fb = []
        for i in 0..n
            let av = 0
            if i < len(a)
                av = a[i] % p
            let bv = 0
            if i < len(b)
                bv = b[i] % p
            push(fa, av)
            push(fb, bv)
        _ntt_transform(fa, 0)
        _ntt_transform(fb, 0)
        for k in 0..n
            fa[k] = fa[k] * fb[k] % p
        _ntt_transform(fa, 1)
        out = [fa[r] for r in 0..rsize]
    out
