// forge_suffixautomaton -- suffix automaton (SAM): the minimal DFA recognizing all substrings of a string.
// The suffix automaton is one of the deepest and most useful string data structures. Built in O(n) time
// and O(n) space (at most 2n-1 states, 3n-4 transitions), it is a compact automaton that accepts EXACTLY
// the set of substrings of the source string. From it you get, essentially for free:
//   - is P a substring of S?  -> walk P through the transitions (O(len P))
//   - the NUMBER of DISTINCT substrings of S -> sum over states of (len[state] - len[link[state]])
//   - the number of OCCURRENCES of each substring, longest common substring of two strings, k-th smallest
//     substring, matching statistics -- all classic SAM applications used in bioinformatics (genome
//     substring indexing), plagiarism/diff detection, and competitive programming.
// It is more powerful than a suffix array for online/streaming construction (you extend character by
// character) and for automaton-style substring membership; forge already has a suffix ARRAY, so this SAM
// is a genuinely distinct structure.
//
// CONSTRUCTION (Blumer/online): maintain `last` = state for the whole current string. To append char c:
// create a new state `cur` with len = len[last]+1; walk suffix links from `last` adding a c-transition to
// `cur` until a state `p` already has a c-transition to some `q`. If len[q] == len[p]+1, link[cur]=q.
// Otherwise CLONE q into `clone` (same transitions/link, len = len[p]+1), redirect the p-chain's c-edges
// from q to clone, and set link[q]=link[cur]=clone. This clone step is the subtle heart of the SAM.
//
// Transitions are stored per state as a dict from single-char string -> state id (NOVA dicts default to
// string keys, so char keys work directly). States are parallel arrays: len[], link[], trans[].
//
// API:
//   sam_build(s) -> sam                      build the automaton for string s
//   sam_contains(sam, p) -> bool             is p a substring of s?
//   sam_num_distinct_substrings(sam) -> int  count of distinct non-empty substrings of s
//   sam_num_states(sam) -> int               number of states (<= 2*len(s)-1)
//   sam_longest_common_substring(s, t) -> str  longest common substring of s and t (via SAM of s)
// LEAF (imports nothing).

// Build a suffix automaton for string s.
// Returns [len_arr, link_arr, trans_arr, last, source] where trans_arr[i] is a dict char->state.
fn sam_build(s: str) -> list
    let len_arr = []
    let link_arr = []
    let trans_arr = []
    // Initial state 0 (the empty string / root)
    push(len_arr, 0)
    push(link_arr, 0 - 1)
    push(trans_arr, {})
    let last = 0
    let n = len(s)
    let i = 0
    while i < n
        let c = slice(s, i, i + 1)
        last = _sam_extend(len_arr, link_arr, trans_arr, last, c)
        i = i + 1
    return [len_arr, link_arr, trans_arr, last, s]

// Extend the automaton by one character c. Mutates the arrays. Returns the new `last`.
fn _sam_extend(len_arr: list, link_arr: list, trans_arr: list, last: int, c: str) -> int
    // create cur
    let cur = len(len_arr)
    push(len_arr, len_arr[last] + 1)
    push(link_arr, 0 - 1)
    push(trans_arr, {})
    let p = last
    // walk suffix links adding c-edges to cur while p has no c-edge
    let done = false
    while p != 0 - 1 and done == false
        let tp = trans_arr[p]
        if contains(tp, c)
            done = true
        else
            tp[c] = cur
            p = link_arr[p]
    if p == 0 - 1
        // reached root, cur's link is root
        link_arr[cur] = 0
    else
        let tp = trans_arr[p]
        let q = get(tp, c, 0)
        if len_arr[p] + 1 == len_arr[q]
            // q is exactly the extension, link cur to q
            link_arr[cur] = q
        else
            // clone q
            let clone = len(len_arr)
            push(len_arr, len_arr[p] + 1)
            push(link_arr, link_arr[q])
            // copy q's transitions into clone
            let qt = trans_arr[q]
            let cloned = {}
            let ks = keys(qt)
            let ki = 0
            while ki < len(ks)
                let key = ks[ki]
                cloned[key] = get(qt, key, 0)
                ki = ki + 1
            push(trans_arr, cloned)
            // redirect p-chain c-edges from q to clone
            let pp = p
            let redir = false
            while pp != 0 - 1 and redir == false
                let tpp = trans_arr[pp]
                if contains(tpp, c) and get(tpp, c, 0) == q
                    tpp[c] = clone
                    pp = link_arr[pp]
                else
                    redir = true
            link_arr[q] = clone
            link_arr[cur] = clone
    return cur

// Is p a substring of s? Walk p through the transitions from the root.
fn sam_contains(sam: list, p: str) -> bool
    let trans_arr = sam[2]
    let state = 0
    let n = len(p)
    let i = 0
    while i < n
        let c = slice(p, i, i + 1)
        let ts = trans_arr[state]
        if contains(ts, c) == false
            return false
        state = get(ts, c, 0)
        i = i + 1
    return true

// Number of distinct non-empty substrings = sum over all states != root of (len[state] - len[link[state]]).
fn sam_num_distinct_substrings(sam: list) -> int
    let len_arr = sam[0]
    let link_arr = sam[1]
    let total = 0
    let i = 1
    while i < len(len_arr)
        total = total + len_arr[i] - len_arr[link_arr[i]]
        i = i + 1
    return total

// Number of states in the automaton.
fn sam_num_states(sam: list) -> int
    let len_arr = sam[0]
    return len(len_arr)

// Longest common substring of s and t, computed by building the SAM of s and running t through it,
// tracking the length of the current match; the maximum match length seen is the LCS length. Returns
// the substring itself (one occurrence).
fn sam_longest_common_substring(s: str, t: str) -> str
    let sam = sam_build(s)
    let len_arr = sam[0]
    let link_arr = sam[1]
    let trans_arr = sam[2]
    let state = 0
    let l = 0
    let best_len = 0
    let best_end = 0
    let n = len(t)
    let i = 0
    while i < n
        let c = slice(t, i, i + 1)
        let ts = trans_arr[state]
        if contains(ts, c)
            state = get(ts, c, 0)
            l = l + 1
        else
            // follow suffix links until we find a c-transition or hit root
            let found = false
            while state != 0 - 1 and found == false
                let tsx = trans_arr[state]
                if contains(tsx, c)
                    found = true
                else
                    state = link_arr[state]
            if state == 0 - 1
                state = 0
                l = 0
            else
                l = len_arr[state] + 1
                let tsx = trans_arr[state]
                state = get(tsx, c, 0)
        if l > best_len
            best_len = l
            best_end = i
        i = i + 1
    if best_len == 0
        return ""
    return slice(t, best_end - best_len + 1, best_end + 1)
