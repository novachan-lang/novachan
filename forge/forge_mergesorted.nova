// forge_mergesorted -- combine already-SORTED sequences efficiently. merge_sorted interleaves two sorted lists into
// one sorted list in O(m+n) with a two-pointer walk -- always advancing whichever list has the smaller front
// element -- which is the merge step at the heart of merge sort and the standard way to union two ordered result
// sets without re-sorting. merge_k_sorted extends this to any number of sorted lists (combining leaderboards,
// merging sorted shards of a database, k-way external sort). median_of_two_x2 finds the median of two sorted lists
// combined, reported as TWICE the value so it stays an exact integer even when the true median falls between two
// numbers. Merging pre-sorted data is a constant real-world need -- log/time-series streams already in order,
// paginated sorted API pages, sorted index intersections/unions -- and is far cheaper than concatenating and
// re-sorting. Integer elements. LEAF -- imports NOTHING.

// Merge two ascending-sorted lists into one ascending-sorted list. O(m+n).
fn merge_sorted(a: list, b: list) -> list
    let out = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        if a[i] <= b[j]
            push(out, a[i])
            i += 1
        else
            push(out, b[j])
            j += 1
    for k in i..len(a)
        push(out, a[k])
    for k in j..len(b)
        push(out, b[k])
    out

// Merge a list of ascending-sorted lists into one ascending-sorted list (successive two-way merges).
fn merge_k_sorted(lists: list) -> list
    let out = []
    for i in 0..len(lists)
        out = merge_sorted(out, lists[i])
    out

// TWICE the median of the combined elements of two sorted lists (kept an exact integer). For an odd total it is
// 2*median; for an even total it is the sum of the two middle values. 0 if both are empty.
fn median_of_two_x2(a: list, b: list) -> int
    let m = merge_sorted(a, b)
    let n = len(m)
    let out = 0
    if n > 0
        if n % 2 == 1
            out = 2 * m[n / 2]
        else
            out = m[n / 2 - 1] + m[n / 2]
    out
