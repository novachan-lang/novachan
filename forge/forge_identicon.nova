// forge_identicon -- generate a deterministic 5x5 SYMMETRIC identicon pattern from a string (GitHub-style
// default avatars). Returns [color_hex, grid] where grid is 5 rows of 5 cells (0/1), left-right mirror
// symmetric. Render the grid as SVG rects or CSS cells. Same input -> same pattern (no storage). LEAF.

fn _idn_hash(s: string) -> int
    let h = 2166136261
    for i in 0..len(s)
        h = (h * 16777619 + ord(char_at(s, i))) % 2147483647
    h

// [color_hex, grid5x5] for a seed. Columns 0<->4 and 1<->3 are mirrored for symmetry.
fn identicon(seed: string) -> list
    let h = _idn_hash(seed)
    let palette = ["#e6194b", "#3cb44b", "#4363d8", "#f58231", "#911eb4", "#008080", "#e67e22", "#16a085"]
    let color = palette[h % len(palette)]
    let grid = []
    let v = h
    for r in 0..5
        let row = []
        let c0 = v % 2
        v = v / 2
        let c1 = v % 2
        v = v / 2
        let c2 = v % 2
        v = v / 2
        push(row, c0)
        push(row, c1)
        push(row, c2)
        push(row, c1)
        push(row, c0)
        push(grid, row)
    [color, grid]
