// forge_secret_scanner — Sentinel: secret / credential detection in text.
//
// Register named patterns as (prefix, min_len) pairs — e.g. ("aws_key",
// "AKIA", 20) mirrors AWS's own access-key-ID shape (a fixed 4-char prefix
// followed by base32 characters, 20 chars total), the same prefix-sniff
// approach git-secrets and truffleHog's regex rules use before a stricter
// checksum/entropy pass. ss_scan finds each pattern's prefix as a substring
// of the text, then measures the contiguous alphanumeric run starting at
// that prefix; a match fires when that run is at least min_len characters —
// long enough to plausibly be the credential, not just the bare prefix
// appearing as ordinary text.
//
// STATE SHAPE — single FLAT dict, no nested dicts, no lists-in-dicts:
//   pattern_count             : int    — number of registered patterns
//   pattern_name_<i>           : string — pattern i's name        (i = 0..pattern_count-1)
//   pattern_prefix_<i>          : string — pattern i's prefix literal
//   pattern_minlen_<i>           : int    — pattern i's minimum token length
//   total_scans                    : int    — total ss_scan calls
//   total_findings                   : int    — total secrets found across all scans
//   last_findings                      : string — comma-separated pattern names matched by the LAST scan
//
// LEAF MODULE — imports NOTHING. Built-ins: contains, find, str, len.

fn ss_new() -> dict
    {"pattern_count": 0, "total_scans": 0, "total_findings": 0, "last_findings": ""}

fn ss_add_pattern(state: dict, name: string, prefix: string, min_len: int)
    let idx = state["pattern_count"]
    let base = str(idx)
    state["pattern_name_" + base] = name
    state["pattern_prefix_" + base] = prefix
    state["pattern_minlen_" + base] = min_len
    state["pattern_count"] = idx + 1

// True if c (a single-character string) is a "token character" — letters,
// digits, underscore or hyphen. Real credential formats commonly use '_'/'-'
// inside the secret itself (Stripe "sk_live_...", Slack "xoxb-...-..."), so
// those are token characters, not delimiters — only whitespace/punctuation
// like '=', ' ', '"' end a token.
fn _ss_is_alnum(c: string) -> bool
    find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", c) >= 0 or find("abcdefghijklmnopqrstuvwxyz", c) >= 0 or find("0123456789", c) >= 0 or c == "_" or c == "-"

// Length of the contiguous token-character run in text starting at index start.
fn _ss_token_len(text: string, start: int) -> int
    let n = len(text)
    let i = start
    while i < n and _ss_is_alnum(text[i])
        i += 1
    i - start

// Scan text against every registered pattern. Returns the number of patterns
// that matched (their prefix appears in text with a long-enough following
// alphanumeric run). Updates ss_findings()/ss_total_scans()/ss_total_findings().
fn ss_scan(state: dict, text: string) -> int
    let n = state["pattern_count"]
    let found_count = 0
    let findings = ""
    for i in 0..n
        let base = str(i)
        let prefix = state["pattern_prefix_" + base]
        let minlen = state["pattern_minlen_" + base]
        let idx = find(text, prefix)
        if idx >= 0
            let tlen = _ss_token_len(text, idx)
            if tlen >= minlen
                let name = state["pattern_name_" + base]
                found_count += 1
                findings = name if findings == "" else findings + "," + name
    state["total_scans"] += 1
    state["total_findings"] += found_count
    state["last_findings"] = findings
    found_count

fn ss_findings(state: dict) -> string
    state["last_findings"]

fn ss_pattern_count(state: dict) -> int
    state["pattern_count"]

fn ss_total_scans(state: dict) -> int
    state["total_scans"]

fn ss_total_findings(state: dict) -> int
    state["total_findings"]

fn ss_has_pattern(state: dict, name: string) -> int
    let n = state["pattern_count"]
    for i in 0..n
        if state["pattern_name_" + str(i)] == name
            return 1
    0
