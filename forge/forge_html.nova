// forge_html -- type-free, injection-safe server-side HTML rendering for Forge. "HTML as function":
// compose a page with el()/div()/p()/ul()/..., and interpolate user data with esc(). Two safety
// guarantees with ZERO developer effort:
//   1. ATTRIBUTE VALUES ARE ALWAYS ESCAPED (the sneakiest XSS vector -- "><script> in an attr -- is closed).
//   2. raw() is the ONLY way to emit unescaped markup, so trusting input is always explicit and reviewable.
// No template language, no template-injection, no build step -- it's just NOVA functions returning strings.
// Usage:
//   import forge
//   import forge_html as h     // (or: import forge_html ; forge_html.div(...))
//   let body = h.div({"class": "card"}, h.h1({}, h.esc(user.name)) + h.p({}, h.esc(user.bio)))
//   return forge.html(200, h.page("Profile", "", body))

// Escape a string for safe HTML interpolation: & < > " ' -> entities. '&' MUST be replaced first so the
// '&' it introduces in the other entities is not re-escaped.
fn esc(s: string) -> string
    let r = replace(s, "&", "&amp;")
    r = replace(r, "<", "&lt;")
    r = replace(r, ">", "&gt;")
    r = replace(r, chr(34), "&quot;")
    r = replace(r, "'", "&#39;")
    r

// An escaped text node -- reads clearly in a child position (alias of esc).
fn text(s: string) -> string
    esc(s)

// Insert trusted, already-safe HTML verbatim: the explicit opt-out from escaping.
fn raw(s: string) -> string
    s

// Build an attribute string from a dict: ' k="escaped-value"'. Values are ALWAYS escaped. An empty-string
// value renders a bare boolean attribute: {"disabled": ""} -> ' disabled'.
fn _attrs(at) -> string
    let out = ""
    for k in keys(at)
        let v = at[k]
        if v == ""
            out = out + " " + k
        else
            out = out + " " + k + "=" + chr(34) + esc(v) + chr(34)
    out

// A normal element: <tag attrs>inner</tag>. `inner` is raw HTML -- compose it from other builders, or
// from esc()/text() for user data.
fn el(tag: string, at, inner: string) -> string
    "<" + tag + _attrs(at) + ">" + inner + "</" + tag + ">"

// A void element (no closing tag): <tag attrs>. For img/input/meta/link/br/hr.
fn void_el(tag: string, at) -> string
    "<" + tag + _attrs(at) + ">"

// Concatenate a list of child HTML fragments into one string -- the loop/collection helper:
//   h.ul({}, h.join_children(map(items, fn(it) h.li({}, h.esc(it)))))
fn join_children(items) -> string
    let out = ""
    let i = 0
    while i < len(items)
        out = out + items[i]
        i = i + 1
    out

// ── Common element builders: (attrs-dict, inner-HTML) -> string ───────────────
fn div(at, inner: string) -> string
    el("div", at, inner)
fn span(at, inner: string) -> string
    el("span", at, inner)
fn p(at, inner: string) -> string
    el("p", at, inner)
fn h1(at, inner: string) -> string
    el("h1", at, inner)
fn h2(at, inner: string) -> string
    el("h2", at, inner)
fn h3(at, inner: string) -> string
    el("h3", at, inner)
fn ul(at, inner: string) -> string
    el("ul", at, inner)
fn ol(at, inner: string) -> string
    el("ol", at, inner)
fn li(at, inner: string) -> string
    el("li", at, inner)
fn section(at, inner: string) -> string
    el("section", at, inner)
fn nav(at, inner: string) -> string
    el("nav", at, inner)
fn header(at, inner: string) -> string
    el("header", at, inner)
fn footer(at, inner: string) -> string
    el("footer", at, inner)
fn button(at, inner: string) -> string
    el("button", at, inner)
fn label(at, inner: string) -> string
    el("label", at, inner)
fn form(at, inner: string) -> string
    el("form", at, inner)
fn table(at, inner: string) -> string
    el("table", at, inner)
fn tr(at, inner: string) -> string
    el("tr", at, inner)
fn td(at, inner: string) -> string
    el("td", at, inner)
fn th(at, inner: string) -> string
    el("th", at, inner)
fn strong(at, inner: string) -> string
    el("strong", at, inner)
fn em(at, inner: string) -> string
    el("em", at, inner)
fn pre(at, inner: string) -> string
    el("pre", at, inner)
fn code(at, inner: string) -> string
    el("code", at, inner)

// Ergonomic anchor: link(href, inner-HTML). href is auto-escaped (it is an attribute value).
fn link(href: string, inner: string) -> string
    el("a", {"href": href}, inner)

// Void-element conveniences.
fn br() -> string
    "<br>"
fn hr() -> string
    "<hr>"
fn img(src: string, alt: string) -> string
    void_el("img", {"src": src, "alt": alt})
fn input_tag(at) -> string
    void_el("input", at)
fn meta(at) -> string
    void_el("meta", at)

// A complete HTML5 document. `title` is escaped; `head` is raw extra head markup (stylesheets, meta);
// `body` is the raw page body (built from the builders above).
fn page(title: string, head: string, body: string) -> string
    "<!doctype html><html><head><meta charset=" + chr(34) + "utf-8" + chr(34) + ">" + "<title>" + esc(title) + "</title>" + head + "</head><body>" + body + "</body></html>"
