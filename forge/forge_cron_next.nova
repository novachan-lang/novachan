// forge_cron_next -- compute the NEXT time a cron expression fires from a given instant (job schedulers,
// reminders, recurring tasks, "next run at" displays). Iterates minute-by-minute from start+1 checking
// forge_cron's cron_matches, bounded to avoid an infinite loop on an unsatisfiable expression. Composes
// forge_cron + forge_date. Imports both.
import forge_cron
import forge_date

// PRIVATE: [minute, hour, dom, month, dow] for an epoch-MINUTE (unix_seconds/60).
fn _cn_fields(epoch_minute: int) -> list
    let total_seconds = epoch_minute * 60
    let sec_of_day = total_seconds % 86400
    let ymd = date_from_epoch_days(total_seconds / 86400)
    [(sec_of_day % 3600) / 60, sec_of_day / 3600, ymd[2], ymd[1], date_weekday(ymd[0], ymd[1], ymd[2])]

// Next epoch-MINUTE (after `start_minute`) at which `expr` fires; -1 if none within `max_minutes`.
fn cron_next(expr: string, start_minute: int, max_minutes: int) -> int
    let m = start_minute + 1
    let bound = start_minute + max_minutes
    while m <= bound
        let f = _cn_fields(m)
        if cron_matches(expr, f[0], f[1], f[2], f[3], f[4])
            return m
        m += 1
    0 - 1

// Minutes until the next fire from `now_seconds`; -1 if none within `max_minutes`.
fn cron_minutes_until(expr: string, now_seconds: int, max_minutes: int) -> int
    let start = now_seconds / 60
    let nxt = cron_next(expr, start, max_minutes)
    if nxt < 0
        return 0 - 1
    nxt - start
