// forge_health_aggregator — Multi-service health aggregation.
// Aggregate health from multiple services, compute overall status.

fn ha_new() -> dict
    let ha = {}
    ha["services"] = {}
    ha["checks"] = []
    ha

fn ha_register(ha: dict, name: string, critical: int) -> dict
    let svc = {}
    svc["name"] = name
    svc["status"] = "unknown"
    svc["critical"] = critical
    svc["last_check"] = 0
    svc["consecutive_fails"] = 0
    ha["services"][name] = svc
    ha

fn ha_report_up(ha: dict, name: string, timestamp: int) -> dict
    let has = contains(ha["services"], name)
    if has != true
        return ha
    ha["services"][name]["status"] = "up"
    ha["services"][name]["last_check"] = timestamp
    ha["services"][name]["consecutive_fails"] = 0
    let check = {}
    check["service"] = name
    check["status"] = "up"
    check["at"] = timestamp
    push(ha["checks"], check)
    ha

fn ha_report_down(ha: dict, name: string, timestamp: int) -> dict
    let has = contains(ha["services"], name)
    if has != true
        return ha
    ha["services"][name]["status"] = "down"
    ha["services"][name]["last_check"] = timestamp
    ha["services"][name]["consecutive_fails"] = ha["services"][name]["consecutive_fails"] + 1
    let check = {}
    check["service"] = name
    check["status"] = "down"
    check["at"] = timestamp
    push(ha["checks"], check)
    ha

fn ha_overall_status(ha: dict) -> string
    let all = keys(ha["services"])
    let any_critical_down = 0
    let any_down = 0
    let i = 0
    while i < len(all)
        let svc = ha["services"][all[i]]
        if svc["status"] == "down"
            any_down = 1
            if svc["critical"] == 1
                any_critical_down = 1
        i = i + 1
    if any_critical_down == 1
        return "critical"
    if any_down == 1
        return "degraded"
    "healthy"

fn ha_service_count(ha: dict) -> int
    len(keys(ha["services"]))

fn ha_up_count(ha: dict) -> int
    let count = 0
    let all = keys(ha["services"])
    let i = 0
    while i < len(all)
        if ha["services"][all[i]]["status"] == "up"
            count = count + 1
        i = i + 1
    count

fn ha_down_services(ha: dict) -> list
    let result = []
    let all = keys(ha["services"])
    let i = 0
    while i < len(all)
        if ha["services"][all[i]]["status"] == "down"
            push(result, all[i])
        i = i + 1
    result
