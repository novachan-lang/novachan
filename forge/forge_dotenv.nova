// forge_dotenv -- parse a .env file into a config dict (the 12-factor / dotenv / python-dotenv format). Each
// line is KEY=value; supports # comment lines, blank lines, an optional `export ` prefix, single/double-quoted
// values (quotes stripped; \n \t \ \" unescaped inside double quotes), and an inline trailing comment on an
// unquoted value. Feeds forge_config for local development configuration. LEAF -- imports NOTHING.

fn _dotenv_unescape(s: string) -> string
    let bs = chr(92)
    let out_parts = []
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        if c == bs and i + 1 < len(s)
            let nx = char_at(s, i + 1)
            if nx == "n"
                push(out_parts, chr(10))
            else
                if nx == "t"
                    push(out_parts, chr(9))
                else
                    push(out_parts, nx)
            i += 2
        else
            push(out_parts, c)
            i += 1
    let out = join(out_parts, "")
    out

// PRIVATE: interpret the raw value after '=': strip matching quotes (unescaping inside double quotes) or, for
// an unquoted value, drop an inline " #" comment.
fn _dotenv_value(raw: string) -> string
    if len(raw) == 0
        return ""
    let q = chr(34)
    let sq = chr(39)
    let first = char_at(raw, 0)
    if first == q or first == sq
        let close = find(slice(raw, 1, len(raw)), first)
        if close < 0
            return slice(raw, 1, len(raw))
        let inner = slice(raw, 1, 1 + close)
        if first == q
            return _dotenv_unescape(inner)
        return inner
    let hash = find(raw, " #")
    if hash >= 0
        return trim(slice(raw, 0, hash))
    raw

// Parse .env text into a dict of KEY -> value.
fn dotenv_parse(text: string) -> dict
    let out = {}
    let lines = split(text, chr(10))
    for i in 0..len(lines)
        let line = trim(lines[i])
        if len(line) > 0 and starts_with(line, "#") == false
            if starts_with(line, "export ")
                line = trim(slice(line, 7, len(line)))
            let eq = find(line, "=")
            if eq > 0
                out[trim(slice(line, 0, eq))] = _dotenv_value(trim(slice(line, eq + 1, len(line))))
    out

// Look up a key with a default fallback.
fn dotenv_get(env: dict, key: string, default: string) -> string
    if key in env
        return env[key]
    default
