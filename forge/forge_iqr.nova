// forge_iqr -- robust outlier detection with the interquartile range (Tukey's method, the math behind a box
// plot's whiskers). Split the data at its 25th and 75th percentiles (Q1, Q3); the middle 50% spans IQR = Q3-Q1;
// anything more than 1.5*IQR below Q1 or above Q3 is flagged an outlier. Unlike a z-score (forge_onlinestat),
// this is ROBUST: it's based on rank/position, so a few extreme values don't distort the thresholds the way
// they inflate the mean and standard deviation -- the right tool for skewed data, data cleaning, and honest
// anomaly detection. Quartiles use linear interpolation (numpy's default). Values are numbers; results are
// floats. LEAF -- imports NOTHING.

// PRIVATE: insertion-sort a coerced-to-float copy of a scalar list, ascending.
fn _iqr_sorted(values: list) -> list
    let out = []
    let i = 0
    while i < len(values)
        push(out, values[i] * 1.0)
        i = i + 1
    let a = 1
    while a < len(out)
        let cur = out[a] * 1.0
        let b = a - 1
        while b >= 0 and (out[b] * 1.0) > cur
            out[b + 1] = out[b]
            b = b - 1
        out[b + 1] = cur
        a = a + 1
    out

// PRIVATE: the p-quantile (0..1) of an already-sorted float list, via linear interpolation.
fn _iqr_q(sorted: list, p: float) -> float
    let n = len(sorted)
    let out = 0.0
    if n == 1
        out = sorted[0] * 1.0
    if n > 1
        let pos = (p * 1.0) * ((n - 1) * 1.0)
        let lo = int(pos)
        let frac = pos - (lo * 1.0)
        let base = sorted[lo] * 1.0
        if lo + 1 < n
            let nxt = sorted[lo + 1] * 1.0
            out = base + frac * (nxt - base)
        else
            out = base
    out

// The three quartiles [Q1, median, Q3].
fn iqr_quartiles(values: list) -> list
    let sorted = _iqr_sorted(values)
    let q1 = _iqr_q(sorted, 0.25)
    let q2 = _iqr_q(sorted, 0.5)
    let q3 = _iqr_q(sorted, 0.75)
    [q1, q2, q3]

// The interquartile range Q3 - Q1.
fn iqr_range(values: list) -> float
    let sorted = _iqr_sorted(values)
    let q1 = _iqr_q(sorted, 0.25)
    let q3 = _iqr_q(sorted, 0.75)
    let r = q3 - q1
    r

// The Tukey fences [lower, upper] = [Q1 - k*IQR, Q3 + k*IQR]. k is usually 1.5 (outliers) or 3.0 (far out).
fn iqr_bounds(values: list, k: float) -> list
    let sorted = _iqr_sorted(values)
    let q1 = _iqr_q(sorted, 0.25)
    let q3 = _iqr_q(sorted, 0.75)
    let r = q3 - q1
    let lower = q1 - (k * 1.0) * r
    let upper = q3 + (k * 1.0) * r
    [lower, upper]

// True if x falls outside the k*IQR fences.
fn iqr_is_outlier(values: list, x, k: float) -> bool
    let b = iqr_bounds(values, k)
    let lo = b[0] * 1.0
    let hi = b[1] * 1.0
    let xf = x * 1.0
    xf < lo or xf > hi

// The values that fall outside the k*IQR fences, in input order.
fn iqr_outliers(values: list, k: float) -> list
    let b = iqr_bounds(values, k)
    let lo = b[0] * 1.0
    let hi = b[1] * 1.0
    let out = []
    let i = 0
    while i < len(values)
        let v = values[i] * 1.0
        if v < lo or v > hi
            push(out, values[i])
        i = i + 1
    out
