// forge_wordbreak -- segment a run-together string into a sequence of known WORDS. Given a dictionary, it decides
// whether a string can be split entirely into dictionary words and, if so, recovers one such split. This is how
// you break a hashtag or camel-less identifier ("thisisahashtag" -> this is a hashtag), split a squashed domain or
// URL slug, tokenize languages written without spaces (Chinese/Japanese/Thai) or old all-caps text, and it's a
// building block of spelling correction and OCR cleanup. Naively trying every split point is exponential; the
// dynamic program is O(n^2 * lookup): dp[i] = "the first i characters can be fully segmented", true when some
// earlier dp[j] is true AND the piece s[j..i) is a word. Back-pointers then reconstruct an actual segmentation.
// The dictionary is a list of words (deduped into a set internally); matching is case-sensitive. LEAF.

// PRIVATE: build a set (dict word -> 1) from a word list.
fn _wb_set(words: list) -> dict
    let set = {}
    for i in 0..len(words)
        set[words[i]] = 1
    set

// True if `s` can be segmented entirely into words from the dictionary.
fn can_break(s: string, words: list) -> bool
    let set = _wb_set(words)
    let n = len(s)
    let dp = [0 for z in 0..(n + 1)]
    dp[0] = 1
    for i in 1..(n + 1)
        for j in 0..i
            if dp[j] == 1 and slice(s, j, i) in set
                dp[i] = 1
    dp[n] == 1

// One valid segmentation of `s` into dictionary words (as a list), or an empty list if none exists (also empty for
// the empty string, which trivially segments into nothing).
fn word_break(s: string, words: list) -> list
    let set = _wb_set(words)
    let n = len(s)
    // dp + back pointer: prev[i] = start index j of the word ending at i (in an optimal reachable split)
    let dp = [0 for z in 0..(n + 1)]
    let prev = [-1 for z in 0..(n + 1)]
    dp[0] = 1
    for i in 1..(n + 1)
        for j in 0..i
            if dp[j] == 1 and dp[i] == 0 and slice(s, j, i) in set
                dp[i] = 1
                prev[i] = j
    let out = []
    if dp[n] == 1
        // walk back pointers, collecting words, then reverse
        let rev = []
        let cur = n
        while cur > 0
            let start = prev[cur]
            push(rev, slice(s, start, cur))
            cur = start
        let k = len(rev) - 1
        while k >= 0
            push(out, rev[k])
            k -= 1
    out
