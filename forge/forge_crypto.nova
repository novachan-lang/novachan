// forge_crypto -- pure-NOVA cryptographic primitives: SHA-256, HMAC-SHA-256, PBKDF2-HMAC-SHA-256. The
// foundation for Postgres SCRAM-SHA-256 auth and (later) TLS. KAT-gated against NIST/RFC test vectors.
// Operates on byte LISTS (ints 0..255), like the shipped WS SHA-1; sha256_str/sha256_hex are string
// conveniences. 32-bit math via `& 4294967295`; NOT via `x ^ 4294967295`.

fn _c32(x: int) -> int
    x & 4294967295

fn _rotr32(x: int, n: int) -> int
    ((x >> n) | (x << (32 - n))) & 4294967295

// SHA-256 (FIPS 180-4) over a byte list -> a 32-byte digest as a byte list.
fn sha256_bytes(msg: list) -> list
    let k = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
    let ml = len(msg)
    let m = []
    let i = 0
    while i < ml
        push(m, msg[i] & 255)
        i = i + 1
    push(m, 128)
    while (len(m) % 64) != 56
        push(m, 0)
    let bitlen = ml * 8
    let j = 7
    while j >= 0
        push(m, (bitlen >> (j * 8)) & 255)
        j = j - 1
    let h0 = 0x6a09e667
    let h1 = 0xbb67ae85
    let h2 = 0x3c6ef372
    let h3 = 0xa54ff53a
    let h4 = 0x510e527f
    let h5 = 0x9b05688c
    let h6 = 0x1f83d9ab
    let h7 = 0x5be0cd19
    let nchunks = len(m) / 64
    let c = 0
    while c < nchunks
        let base = c * 64
        let w = []
        let t = 0
        while t < 16
            let o = base + t * 4
            push(w, ((m[o] << 24) | (m[o + 1] << 16) | (m[o + 2] << 8) | m[o + 3]) & 4294967295)
            t = t + 1
        while t < 64
            let x15 = w[t - 15]
            let s0 = (_rotr32(x15, 7) ^ _rotr32(x15, 18) ^ (x15 >> 3)) & 4294967295
            let x2 = w[t - 2]
            let s1 = (_rotr32(x2, 17) ^ _rotr32(x2, 19) ^ (x2 >> 10)) & 4294967295
            push(w, (w[t - 16] + s0 + w[t - 7] + s1) & 4294967295)
            t = t + 1
        let a = h0
        let b = h1
        let cc = h2
        let d = h3
        let e = h4
        let f = h5
        let g = h6
        let hh = h7
        let r = 0
        while r < 64
            let big1 = (_rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25)) & 4294967295
            let ch = ((e & f) ^ ((e ^ 4294967295) & g)) & 4294967295
            let t1 = (hh + big1 + ch + k[r] + w[r]) & 4294967295
            let big0 = (_rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22)) & 4294967295
            let maj = ((a & b) ^ (a & cc) ^ (b & cc)) & 4294967295
            let t2 = (big0 + maj) & 4294967295
            hh = g
            g = f
            f = e
            e = (d + t1) & 4294967295
            d = cc
            cc = b
            b = a
            a = (t1 + t2) & 4294967295
            r = r + 1
        h0 = (h0 + a) & 4294967295
        h1 = (h1 + b) & 4294967295
        h2 = (h2 + cc) & 4294967295
        h3 = (h3 + d) & 4294967295
        h4 = (h4 + e) & 4294967295
        h5 = (h5 + f) & 4294967295
        h6 = (h6 + g) & 4294967295
        h7 = (h7 + hh) & 4294967295
        c = c + 1
    let out = []
    let hs = [h0, h1, h2, h3, h4, h5, h6, h7]
    let q = 0
    while q < 8
        let hv = hs[q]
        push(out, (hv >> 24) & 255)
        push(out, (hv >> 16) & 255)
        push(out, (hv >> 8) & 255)
        push(out, hv & 255)
        q = q + 1
    out

// A string's UTF-8 bytes as a byte list (via str_to_bytes -> the real bytes, not codepoint guesses).
fn str_to_blist(s: string) -> list
    let nb = str_to_bytes(s)
    let n = bytes_len(nb)
    let out = []
    let i = 0
    while i < n
        push(out, bytes_get(nb, i))
        i = i + 1
    out

fn sha256_str(s: string) -> list
    sha256_bytes(str_to_blist(s))

// Lowercase hex of a byte list.
fn hex_of(blist: list) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(blist)
        let b = blist[i]
        out = out + char_at(digs, (b >> 4) & 15) + char_at(digs, b & 15)
        i = i + 1
    out

fn sha256_hex(s: string) -> string
    hex_of(sha256_str(s))

// HMAC-SHA-256 (RFC 2104) over byte lists -> a 32-byte MAC as a byte list. Block size B = 64. A key
// longer than B is hashed first; then padded to B. inner = H((K0 ^ ipad) || msg); MAC = H((K0 ^ opad) ||
// inner). The handed-in lists are NOT mutated (K0/pads are fresh lists).
fn hmac_sha256_bytes(key: list, msg: list) -> list
    let k0 = key
    if len(k0) > 64
        k0 = sha256_bytes(k0)
    let inner_in = []
    let outer_in = []
    let i = 0
    while i < 64
        let kb = 0
        if i < len(k0)
            kb = k0[i]
        push(inner_in, kb ^ 0x36)
        push(outer_in, kb ^ 0x5c)
        i = i + 1
    let j = 0
    while j < len(msg)
        push(inner_in, msg[j])
        j = j + 1
    let inner = sha256_bytes(inner_in)
    let z = 0
    while z < len(inner)
        push(outer_in, inner[z])
        z = z + 1
    sha256_bytes(outer_in)

// PBKDF2-HMAC-SHA-256 (RFC 8018) -> a dklen-byte derived key as a byte list. Each output block i is
// T_i = U1 ^ U2 ^ ... ^ Uc, with U1 = HMAC(pw, salt || INT32_BE(i)) and Uk = HMAC(pw, U(k-1)). The
// engine behind SCRAM-SHA-256's SaltedPassword (and password hashing in general).
fn pbkdf2_sha256(password: list, salt: list, iterations: int, dklen: int) -> list
    let out = []
    let block = 1
    while len(out) < dklen
        let si = []
        let a = 0
        while a < len(salt)
            push(si, salt[a])
            a = a + 1
        push(si, (block >> 24) & 255)
        push(si, (block >> 16) & 255)
        push(si, (block >> 8) & 255)
        push(si, block & 255)
        let u = hmac_sha256_bytes(password, si)
        let tacc = []
        let z = 0
        while z < len(u)
            push(tacc, u[z])
            z = z + 1
        let it = 1
        while it < iterations
            u = hmac_sha256_bytes(password, u)
            let x = 0
            while x < len(tacc)
                tacc[x] = tacc[x] ^ u[x]
                x = x + 1
            it = it + 1
        let y = 0
        while y < len(tacc)
            push(out, tacc[y])
            y = y + 1
        block = block + 1
    let res = []
    let w = 0
    while w < dklen
        push(res, out[w])
        w = w + 1
    res

// ── Base64 (standard alphabet, RFC 4648) on byte lists -- raw bytes in/out (no string mangling) ──────
fn _b64char(v: int) -> string
    char_at("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", v)

fn b64_encode_blist(data: list) -> string
    let out = ""
    let n = len(data)
    let i = 0
    while i + 3 <= n
        let trip = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2]
        out = out + _b64char((trip >> 18) & 63) + _b64char((trip >> 12) & 63) + _b64char((trip >> 6) & 63) + _b64char(trip & 63)
        i = i + 3
    let rem = n - i
    if rem == 1
        let t1 = data[i] << 16
        out = out + _b64char((t1 >> 18) & 63) + _b64char((t1 >> 12) & 63) + "=="
    else
        if rem == 2
            let t2 = (data[i] << 16) | (data[i + 1] << 8)
            out = out + _b64char((t2 >> 18) & 63) + _b64char((t2 >> 12) & 63) + _b64char((t2 >> 6) & 63) + "="
    out

fn _b64val(c: int) -> int
    if c >= 65 and c <= 90
        return c - 65
    if c >= 97 and c <= 122
        return c - 71
    if c >= 48 and c <= 57
        return c + 4
    if c == 43
        return 62
    if c == 47
        return 63
    0 - 1

fn b64_decode_blist(s: string) -> list
    let out = []
    let acc = 0
    let nbits = 0
    let i = 0
    let go = 1
    while i < len(s) and go == 1
        let c = ord(char_at(s, i))
        if c == 61
            go = 0
        else
            let v = _b64val(c)
            if v >= 0
                acc = (acc << 6) | v
                nbits = nbits + 6
                if nbits >= 8
                    nbits = nbits - 8
                    push(out, (acc >> nbits) & 255)
        i = i + 1
    out

// ── MD5 (RFC 1321) -- LITTLE-endian. Legacy, but Postgres MD5 auth needs it. NOT for security. ───────
fn _rotl32(x: int, n: int) -> int
    ((x << n) | (x >> (32 - n))) & 4294967295

fn md5_bytes(msg: list) -> list
    let k = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]
    let s = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
    let ml = len(msg)
    let m = []
    let i = 0
    while i < ml
        push(m, msg[i] & 255)
        i = i + 1
    push(m, 128)
    while (len(m) % 64) != 56
        push(m, 0)
    let bitlen = ml * 8
    let j = 0
    while j < 8
        push(m, (bitlen >> (j * 8)) & 255)
        j = j + 1
    let a0 = 0x67452301
    let b0 = 0xefcdab89
    let c0 = 0x98badcfe
    let d0 = 0x10325476
    let nchunks = len(m) / 64
    let c = 0
    while c < nchunks
        let base = c * 64
        let w = []
        let t = 0
        while t < 16
            let o = base + t * 4
            push(w, (m[o] | (m[o + 1] << 8) | (m[o + 2] << 16) | (m[o + 3] << 24)) & 4294967295)
            t = t + 1
        let a = a0
        let b = b0
        let cc = c0
        let d = d0
        let r = 0
        while r < 64
            let f = 0
            let g = 0
            if r < 16
                f = (b & cc) | ((b ^ 4294967295) & d)
                g = r
            else
                if r < 32
                    f = (d & b) | ((d ^ 4294967295) & cc)
                    g = (5 * r + 1) % 16
                else
                    if r < 48
                        f = b ^ cc ^ d
                        g = (3 * r + 5) % 16
                    else
                        f = cc ^ (b | (d ^ 4294967295))
                        g = (7 * r) % 16
            f = (f + a + k[r] + w[g]) & 4294967295
            a = d
            d = cc
            cc = b
            b = (b + _rotl32(f, s[r])) & 4294967295
            r = r + 1
        a0 = (a0 + a) & 4294967295
        b0 = (b0 + b) & 4294967295
        c0 = (c0 + cc) & 4294967295
        d0 = (d0 + d) & 4294967295
        c = c + 1
    let out = []
    let hs = [a0, b0, c0, d0]
    let q = 0
    while q < 4
        let hv = hs[q]
        push(out, hv & 255)
        push(out, (hv >> 8) & 255)
        push(out, (hv >> 16) & 255)
        push(out, (hv >> 24) & 255)
        q = q + 1
    out

fn md5_str(s: string) -> list
    md5_bytes(str_to_blist(s))

fn md5_hex(s: string) -> string
    hex_of(md5_str(s))

// ── AES (FIPS-197) block cipher -- AES-128 + AES-256, on 16-byte blocks (byte lists) ─────────────────
// Reusable authenticated-encryption groundwork (encrypt secrets/sessions) + TLS. State is column-major.
fn _aes_sbox() -> list
    [0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76, 0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0, 0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15, 0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75, 0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84, 0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf, 0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8, 0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2, 0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73, 0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb, 0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79, 0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08, 0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a, 0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e, 0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf, 0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16]

fn _aes_xtime(x: int) -> int
    let r = x << 1
    if (x & 128) != 0
        r = r ^ 283
    r & 255

// Expand the key into (nr+1)*16 round-key bytes.
fn _aes_key_expansion(key, nk: int, nr: int) -> list
    let sbox = _aes_sbox()
    let rcon = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]
    let w = []
    let i = 0
    while i < nk * 4
        push(w, key[i])
        i = i + 1
    let wordcount = 4 * (nr + 1)
    let wi = nk
    while wi < wordcount
        let t0 = w[(wi - 1) * 4 + 0]
        let t1 = w[(wi - 1) * 4 + 1]
        let t2 = w[(wi - 1) * 4 + 2]
        let t3 = w[(wi - 1) * 4 + 3]
        if (wi % nk) == 0
            let tmp = t0
            t0 = sbox[t1] ^ rcon[wi / nk - 1]
            t1 = sbox[t2]
            t2 = sbox[t3]
            t3 = sbox[tmp]
        else
            if nk > 6 and (wi % nk) == 4
                t0 = sbox[t0]
                t1 = sbox[t1]
                t2 = sbox[t2]
                t3 = sbox[t3]
        push(w, w[(wi - nk) * 4 + 0] ^ t0)
        push(w, w[(wi - nk) * 4 + 1] ^ t1)
        push(w, w[(wi - nk) * 4 + 2] ^ t2)
        push(w, w[(wi - nk) * 4 + 3] ^ t3)
        wi = wi + 1
    w

fn _aes_add_round_key(s, rk, round: int) -> list
    let o = []
    let i = 0
    while i < 16
        push(o, s[i] ^ rk[round * 16 + i])
        i = i + 1
    o

fn _aes_sub_bytes(s, sbox) -> list
    let o = []
    let i = 0
    while i < 16
        push(o, sbox[s[i]])
        i = i + 1
    o

fn _aes_shift_rows(s) -> list
    let o = []
    let c = 0
    while c < 4
        let r = 0
        while r < 4
            push(o, s[(((c + r) % 4) * 4) + r])
            r = r + 1
        c = c + 1
    o

fn _aes_mix_columns(s) -> list
    let o = []
    let c = 0
    while c < 4
        let a0 = s[c * 4 + 0]
        let a1 = s[c * 4 + 1]
        let a2 = s[c * 4 + 2]
        let a3 = s[c * 4 + 3]
        push(o, (_aes_xtime(a0) ^ (_aes_xtime(a1) ^ a1) ^ a2 ^ a3) & 255)
        push(o, (a0 ^ _aes_xtime(a1) ^ (_aes_xtime(a2) ^ a2) ^ a3) & 255)
        push(o, (a0 ^ a1 ^ _aes_xtime(a2) ^ (_aes_xtime(a3) ^ a3)) & 255)
        push(o, ((_aes_xtime(a0) ^ a0) ^ a1 ^ a2 ^ _aes_xtime(a3)) & 255)
        c = c + 1
    o

// Encrypt one 16-byte block under a 16-byte (AES-128) or 32-byte (AES-256) key.
fn aes_encrypt_block(block, key) -> list
    let nk = len(key) / 4
    let nr = nk + 6
    let rk = _aes_key_expansion(key, nk, nr)
    let sbox = _aes_sbox()
    let s = []
    let i = 0
    while i < 16
        push(s, block[i])
        i = i + 1
    s = _aes_add_round_key(s, rk, 0)
    let round = 1
    while round < nr
        s = _aes_sub_bytes(s, sbox)
        s = _aes_shift_rows(s)
        s = _aes_mix_columns(s)
        s = _aes_add_round_key(s, rk, round)
        round = round + 1
    s = _aes_sub_bytes(s, sbox)
    s = _aes_shift_rows(s)
    s = _aes_add_round_key(s, rk, nr)
    s

// hex string -> byte list (inverse of hex_of). Handles lower/upper hex.
fn _hexval(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return o - 48
    if o >= 97 and o <= 102
        return o - 87
    if o >= 65 and o <= 70
        return o - 55
    0

fn hex_to_blist(h: string) -> list
    let out = []
    let i = 0
    while i + 1 < len(h)
        push(out, _hexval(char_at(h, i)) * 16 + _hexval(char_at(h, i + 1)))
        i = i + 2
    out

// ── AES-CTR (NIST SP 800-38A) -- self-inverse stream mode, forward cipher only ──────────────────────
// Increment a 16-byte big-endian counter block in place.
fn _aes_incr(counter)
    let i = 15
    let carry = 1
    while i >= 0 and carry == 1
        let v = counter[i] + carry
        counter[i] = v & 255
        if v > 255
            carry = 1
        else
            carry = 0
        i = i - 1

// AES-CTR over a byte list. iv = the 16-byte initial counter block. Encrypt and decrypt are identical.
fn aes_ctr(key, iv, data) -> list
    let counter = []
    let c = 0
    while c < 16
        push(counter, iv[c])
        c = c + 1
    let out = []
    let i = 0
    while i < len(data)
        let ks = aes_encrypt_block(counter, key)
        let j = 0
        while j < 16 and (i + j) < len(data)
            push(out, data[i + j] ^ ks[j])
            j = j + 1
        _aes_incr(counter)
        i = i + 16
    out
