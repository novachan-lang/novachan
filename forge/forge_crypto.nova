// forge_crypto -- pure-NOVA cryptographic primitives: SHA-256, HMAC-SHA-256, PBKDF2-HMAC-SHA-256. The
// foundation for Postgres SCRAM-SHA-256 auth and (later) TLS. KAT-gated against NIST/RFC test vectors.
// Operates on byte LISTS (ints 0..255), like the shipped WS SHA-1; sha256_str/sha256_hex are string
// conveniences. 32-bit math via `& 4294967295`; NOT via `x ^ 4294967295`.

fn _c32(x: int) -> int
    x & 4294967295

fn _rotr32(x: int, n: int) -> int
    ((x >> n) | (x << (32 - n))) & 4294967295

// SHA-256 (FIPS 180-4) over a byte list -> a 32-byte digest as a byte list.
fn sha256_bytes(msg: list) -> list
    let k = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
    let ml = len(msg)
    let m = []
    let i = 0
    while i < ml
        push(m, msg[i] & 255)
        i = i + 1
    push(m, 128)
    while (len(m) % 64) != 56
        push(m, 0)
    let bitlen = ml * 8
    let j = 7
    while j >= 0
        push(m, (bitlen >> (j * 8)) & 255)
        j = j - 1
    let h0 = 0x6a09e667
    let h1 = 0xbb67ae85
    let h2 = 0x3c6ef372
    let h3 = 0xa54ff53a
    let h4 = 0x510e527f
    let h5 = 0x9b05688c
    let h6 = 0x1f83d9ab
    let h7 = 0x5be0cd19
    let nchunks = len(m) / 64
    let c = 0
    while c < nchunks
        let base = c * 64
        let w = []
        let t = 0
        while t < 16
            let o = base + t * 4
            push(w, ((m[o] << 24) | (m[o + 1] << 16) | (m[o + 2] << 8) | m[o + 3]) & 4294967295)
            t = t + 1
        while t < 64
            let x15 = w[t - 15]
            let s0 = (_rotr32(x15, 7) ^ _rotr32(x15, 18) ^ (x15 >> 3)) & 4294967295
            let x2 = w[t - 2]
            let s1 = (_rotr32(x2, 17) ^ _rotr32(x2, 19) ^ (x2 >> 10)) & 4294967295
            push(w, (w[t - 16] + s0 + w[t - 7] + s1) & 4294967295)
            t = t + 1
        let a = h0
        let b = h1
        let cc = h2
        let d = h3
        let e = h4
        let f = h5
        let g = h6
        let hh = h7
        let r = 0
        while r < 64
            let big1 = (_rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25)) & 4294967295
            let ch = ((e & f) ^ ((e ^ 4294967295) & g)) & 4294967295
            let t1 = (hh + big1 + ch + k[r] + w[r]) & 4294967295
            let big0 = (_rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22)) & 4294967295
            let maj = ((a & b) ^ (a & cc) ^ (b & cc)) & 4294967295
            let t2 = (big0 + maj) & 4294967295
            hh = g
            g = f
            f = e
            e = (d + t1) & 4294967295
            d = cc
            cc = b
            b = a
            a = (t1 + t2) & 4294967295
            r = r + 1
        h0 = (h0 + a) & 4294967295
        h1 = (h1 + b) & 4294967295
        h2 = (h2 + cc) & 4294967295
        h3 = (h3 + d) & 4294967295
        h4 = (h4 + e) & 4294967295
        h5 = (h5 + f) & 4294967295
        h6 = (h6 + g) & 4294967295
        h7 = (h7 + hh) & 4294967295
        c = c + 1
    let out = []
    let hs = [h0, h1, h2, h3, h4, h5, h6, h7]
    let q = 0
    while q < 8
        let hv = hs[q]
        push(out, (hv >> 24) & 255)
        push(out, (hv >> 16) & 255)
        push(out, (hv >> 8) & 255)
        push(out, hv & 255)
        q = q + 1
    out

// A string's UTF-8 bytes as a byte list (via str_to_bytes -> the real bytes, not codepoint guesses).
fn str_to_blist(s: string) -> list
    let nb = str_to_bytes(s)
    let n = bytes_len(nb)
    let out = []
    let i = 0
    while i < n
        push(out, bytes_get(nb, i))
        i = i + 1
    out

fn sha256_str(s: string) -> list
    sha256_bytes(str_to_blist(s))

// Lowercase hex of a byte list.
fn hex_of(blist: list) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(blist)
        let b = blist[i]
        out = out + char_at(digs, (b >> 4) & 15) + char_at(digs, b & 15)
        i = i + 1
    out

fn sha256_hex(s: string) -> string
    hex_of(sha256_str(s))

// HMAC-SHA-256 (RFC 2104) over byte lists -> a 32-byte MAC as a byte list. Block size B = 64. A key
// longer than B is hashed first; then padded to B. inner = H((K0 ^ ipad) || msg); MAC = H((K0 ^ opad) ||
// inner). The handed-in lists are NOT mutated (K0/pads are fresh lists).
fn hmac_sha256_bytes(key: list, msg: list) -> list
    let k0 = key
    if len(k0) > 64
        k0 = sha256_bytes(k0)
    let inner_in = []
    let outer_in = []
    let i = 0
    while i < 64
        let kb = 0
        if i < len(k0)
            kb = k0[i]
        push(inner_in, kb ^ 0x36)
        push(outer_in, kb ^ 0x5c)
        i = i + 1
    let j = 0
    while j < len(msg)
        push(inner_in, msg[j])
        j = j + 1
    let inner = sha256_bytes(inner_in)
    let z = 0
    while z < len(inner)
        push(outer_in, inner[z])
        z = z + 1
    sha256_bytes(outer_in)

// PBKDF2-HMAC-SHA-256 (RFC 8018) -> a dklen-byte derived key as a byte list. Each output block i is
// T_i = U1 ^ U2 ^ ... ^ Uc, with U1 = HMAC(pw, salt || INT32_BE(i)) and Uk = HMAC(pw, U(k-1)). The
// engine behind SCRAM-SHA-256's SaltedPassword (and password hashing in general).
fn pbkdf2_sha256(password: list, salt: list, iterations: int, dklen: int) -> list
    let out = []
    let block = 1
    while len(out) < dklen
        let si = []
        let a = 0
        while a < len(salt)
            push(si, salt[a])
            a = a + 1
        push(si, (block >> 24) & 255)
        push(si, (block >> 16) & 255)
        push(si, (block >> 8) & 255)
        push(si, block & 255)
        let u = hmac_sha256_bytes(password, si)
        let tacc = []
        let z = 0
        while z < len(u)
            push(tacc, u[z])
            z = z + 1
        let it = 1
        while it < iterations
            u = hmac_sha256_bytes(password, u)
            let x = 0
            while x < len(tacc)
                tacc[x] = tacc[x] ^ u[x]
                x = x + 1
            it = it + 1
        let y = 0
        while y < len(tacc)
            push(out, tacc[y])
            y = y + 1
        block = block + 1
    let res = []
    let w = 0
    while w < dklen
        push(res, out[w])
        w = w + 1
    res

// ── Base64 (standard alphabet, RFC 4648) on byte lists -- raw bytes in/out (no string mangling) ──────
fn _b64char(v: int) -> string
    char_at("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", v)

fn b64_encode_blist(data: list) -> string
    let out = ""
    let n = len(data)
    let i = 0
    while i + 3 <= n
        let trip = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2]
        out = out + _b64char((trip >> 18) & 63) + _b64char((trip >> 12) & 63) + _b64char((trip >> 6) & 63) + _b64char(trip & 63)
        i = i + 3
    let rem = n - i
    if rem == 1
        let t1 = data[i] << 16
        out = out + _b64char((t1 >> 18) & 63) + _b64char((t1 >> 12) & 63) + "=="
    else
        if rem == 2
            let t2 = (data[i] << 16) | (data[i + 1] << 8)
            out = out + _b64char((t2 >> 18) & 63) + _b64char((t2 >> 12) & 63) + _b64char((t2 >> 6) & 63) + "="
    out

fn _b64val(c: int) -> int
    if c >= 65 and c <= 90
        return c - 65
    if c >= 97 and c <= 122
        return c - 71
    if c >= 48 and c <= 57
        return c + 4
    if c == 43
        return 62
    if c == 47
        return 63
    0 - 1

fn b64_decode_blist(s: string) -> list
    let out = []
    let acc = 0
    let nbits = 0
    let i = 0
    let go = 1
    while i < len(s) and go == 1
        let c = ord(char_at(s, i))
        if c == 61
            go = 0
        else
            let v = _b64val(c)
            if v >= 0
                acc = (acc << 6) | v
                nbits = nbits + 6
                if nbits >= 8
                    nbits = nbits - 8
                    push(out, (acc >> nbits) & 255)
        i = i + 1
    out

// ── MD5 (RFC 1321) -- LITTLE-endian. Legacy, but Postgres MD5 auth needs it. NOT for security. ───────
fn _rotl32(x: int, n: int) -> int
    ((x << n) | (x >> (32 - n))) & 4294967295

fn md5_bytes(msg: list) -> list
    let k = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]
    let s = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
    let ml = len(msg)
    let m = []
    let i = 0
    while i < ml
        push(m, msg[i] & 255)
        i = i + 1
    push(m, 128)
    while (len(m) % 64) != 56
        push(m, 0)
    let bitlen = ml * 8
    let j = 0
    while j < 8
        push(m, (bitlen >> (j * 8)) & 255)
        j = j + 1
    let a0 = 0x67452301
    let b0 = 0xefcdab89
    let c0 = 0x98badcfe
    let d0 = 0x10325476
    let nchunks = len(m) / 64
    let c = 0
    while c < nchunks
        let base = c * 64
        let w = []
        let t = 0
        while t < 16
            let o = base + t * 4
            push(w, (m[o] | (m[o + 1] << 8) | (m[o + 2] << 16) | (m[o + 3] << 24)) & 4294967295)
            t = t + 1
        let a = a0
        let b = b0
        let cc = c0
        let d = d0
        let r = 0
        while r < 64
            let f = 0
            let g = 0
            if r < 16
                f = (b & cc) | ((b ^ 4294967295) & d)
                g = r
            else
                if r < 32
                    f = (d & b) | ((d ^ 4294967295) & cc)
                    g = (5 * r + 1) % 16
                else
                    if r < 48
                        f = b ^ cc ^ d
                        g = (3 * r + 5) % 16
                    else
                        f = cc ^ (b | (d ^ 4294967295))
                        g = (7 * r) % 16
            f = (f + a + k[r] + w[g]) & 4294967295
            a = d
            d = cc
            cc = b
            b = (b + _rotl32(f, s[r])) & 4294967295
            r = r + 1
        a0 = (a0 + a) & 4294967295
        b0 = (b0 + b) & 4294967295
        c0 = (c0 + cc) & 4294967295
        d0 = (d0 + d) & 4294967295
        c = c + 1
    let out = []
    let hs = [a0, b0, c0, d0]
    let q = 0
    while q < 4
        let hv = hs[q]
        push(out, hv & 255)
        push(out, (hv >> 8) & 255)
        push(out, (hv >> 16) & 255)
        push(out, (hv >> 24) & 255)
        q = q + 1
    out

fn md5_str(s: string) -> list
    md5_bytes(str_to_blist(s))

fn md5_hex(s: string) -> string
    hex_of(md5_str(s))

// ── AES (FIPS-197) block cipher -- AES-128 + AES-256, on 16-byte blocks (byte lists) ─────────────────
// Reusable authenticated-encryption groundwork (encrypt secrets/sessions) + TLS. State is column-major.
fn _aes_sbox() -> list
    [0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76, 0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0, 0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15, 0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75, 0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84, 0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf, 0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8, 0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2, 0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73, 0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb, 0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79, 0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08, 0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a, 0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e, 0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf, 0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16]

fn _aes_xtime(x: int) -> int
    let r = x << 1
    if (x & 128) != 0
        r = r ^ 283
    r & 255

// Expand the key into (nr+1)*16 round-key bytes.
fn _aes_key_expansion(key, nk: int, nr: int) -> list
    let sbox = _aes_sbox()
    let rcon = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]
    let w = []
    let i = 0
    while i < nk * 4
        push(w, key[i])
        i = i + 1
    let wordcount = 4 * (nr + 1)
    let wi = nk
    while wi < wordcount
        let t0 = w[(wi - 1) * 4 + 0]
        let t1 = w[(wi - 1) * 4 + 1]
        let t2 = w[(wi - 1) * 4 + 2]
        let t3 = w[(wi - 1) * 4 + 3]
        if (wi % nk) == 0
            let tmp = t0
            t0 = sbox[t1] ^ rcon[wi / nk - 1]
            t1 = sbox[t2]
            t2 = sbox[t3]
            t3 = sbox[tmp]
        else
            if nk > 6 and (wi % nk) == 4
                t0 = sbox[t0]
                t1 = sbox[t1]
                t2 = sbox[t2]
                t3 = sbox[t3]
        push(w, w[(wi - nk) * 4 + 0] ^ t0)
        push(w, w[(wi - nk) * 4 + 1] ^ t1)
        push(w, w[(wi - nk) * 4 + 2] ^ t2)
        push(w, w[(wi - nk) * 4 + 3] ^ t3)
        wi = wi + 1
    w

fn _aes_add_round_key(s, rk, round: int) -> list
    let o = []
    let i = 0
    while i < 16
        push(o, s[i] ^ rk[round * 16 + i])
        i = i + 1
    o

fn _aes_sub_bytes(s, sbox) -> list
    let o = []
    let i = 0
    while i < 16
        push(o, sbox[s[i]])
        i = i + 1
    o

fn _aes_shift_rows(s) -> list
    let o = []
    let c = 0
    while c < 4
        let r = 0
        while r < 4
            push(o, s[(((c + r) % 4) * 4) + r])
            r = r + 1
        c = c + 1
    o

fn _aes_mix_columns(s) -> list
    let o = []
    let c = 0
    while c < 4
        let a0 = s[c * 4 + 0]
        let a1 = s[c * 4 + 1]
        let a2 = s[c * 4 + 2]
        let a3 = s[c * 4 + 3]
        push(o, (_aes_xtime(a0) ^ (_aes_xtime(a1) ^ a1) ^ a2 ^ a3) & 255)
        push(o, (a0 ^ _aes_xtime(a1) ^ (_aes_xtime(a2) ^ a2) ^ a3) & 255)
        push(o, (a0 ^ a1 ^ _aes_xtime(a2) ^ (_aes_xtime(a3) ^ a3)) & 255)
        push(o, ((_aes_xtime(a0) ^ a0) ^ a1 ^ a2 ^ _aes_xtime(a3)) & 255)
        c = c + 1
    o

// Encrypt one 16-byte block under a 16-byte (AES-128) or 32-byte (AES-256) key.
fn aes_encrypt_block(block, key) -> list
    let nk = len(key) / 4
    let nr = nk + 6
    let rk = _aes_key_expansion(key, nk, nr)
    let sbox = _aes_sbox()
    let s = []
    let i = 0
    while i < 16
        push(s, block[i])
        i = i + 1
    s = _aes_add_round_key(s, rk, 0)
    let round = 1
    while round < nr
        s = _aes_sub_bytes(s, sbox)
        s = _aes_shift_rows(s)
        s = _aes_mix_columns(s)
        s = _aes_add_round_key(s, rk, round)
        round = round + 1
    s = _aes_sub_bytes(s, sbox)
    s = _aes_shift_rows(s)
    s = _aes_add_round_key(s, rk, nr)
    s

// hex string -> byte list (inverse of hex_of). Handles lower/upper hex.
fn _hexval(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return o - 48
    if o >= 97 and o <= 102
        return o - 87
    if o >= 65 and o <= 70
        return o - 55
    0

fn hex_to_blist(h: string) -> list
    let out = []
    let i = 0
    while i + 1 < len(h)
        push(out, _hexval(char_at(h, i)) * 16 + _hexval(char_at(h, i + 1)))
        i = i + 2
    out

// ── AES-CTR (NIST SP 800-38A) -- self-inverse stream mode, forward cipher only ──────────────────────
// Increment a 16-byte big-endian counter block in place.
fn _aes_incr(counter)
    let i = 15
    let carry = 1
    while i >= 0 and carry == 1
        let v = counter[i] + carry
        counter[i] = v & 255
        if v > 255
            carry = 1
        else
            carry = 0
        i = i - 1

// AES-CTR over a byte list. iv = the 16-byte initial counter block. Encrypt and decrypt are identical.
fn aes_ctr(key, iv, data) -> list
    let counter = []
    let c = 0
    while c < 16
        push(counter, iv[c])
        c = c + 1
    let out = []
    let i = 0
    while i < len(data)
        let ks = aes_encrypt_block(counter, key)
        let j = 0
        while j < 16 and (i + j) < len(data)
            push(out, data[i + j] ^ ks[j])
            j = j + 1
        _aes_incr(counter)
        i = i + 16
    out

// ── AES-GCM (NIST SP 800-38D) -- authenticated encryption ───────────────────────────────────────────
// Right-shift one 16-byte value (128-bit, bit0 = MSB of byte0) by 1, in place; return the bit shifted out.
fn _gf_rshift1(v) -> int
    let lsb = v[15] & 1
    let carry = 0
    let b = 0
    while b < 16
        let cout = v[b] & 1
        v[b] = ((v[b] >> 1) | (carry << 7)) & 255
        carry = cout
        b = b + 1
    lsb

// GF(2^128) multiply (GHASH convention): Z = X * Y, R = 0xe1||0^120.
fn _ghash_mul(x, y) -> list
    let z = []
    let v = []
    let i = 0
    while i < 16
        push(z, 0)
        push(v, y[i])
        i = i + 1
    let bit = 0
    while bit < 128
        let xb = (x[bit / 8] >> (7 - (bit % 8))) & 1
        if xb == 1
            let q = 0
            while q < 16
                z[q] = z[q] ^ v[q]
                q = q + 1
        let lsb = _gf_rshift1(v)
        if lsb == 1
            v[0] = v[0] ^ 0xe1
        bit = bit + 1
    z

// Absorb `data` (16-byte blocks, zero-padded) into the running GHASH y under subkey h.
fn _ghash_absorb(y, h, data) -> list
    let i = 0
    while i < len(data)
        let q = 0
        while q < 16
            let bv = 0
            if (i + q) < len(data)
                bv = data[i + q]
            y[q] = y[q] ^ bv
            q = q + 1
        y = _ghash_mul(y, h)
        i = i + 16
    y

fn _ghash(h, aad, ct) -> list
    let y = []
    let i = 0
    while i < 16
        push(y, 0)
        i = i + 1
    y = _ghash_absorb(y, h, aad)
    y = _ghash_absorb(y, h, ct)
    let aad_bits = len(aad) * 8
    let ct_bits = len(ct) * 8
    let lenblk = []
    let k = 7
    while k >= 0
        push(lenblk, (aad_bits >> (k * 8)) & 255)
        k = k - 1
    let k2 = 7
    while k2 >= 0
        push(lenblk, (ct_bits >> (k2 * 8)) & 255)
        k2 = k2 - 1
    let q = 0
    while q < 16
        y[q] = y[q] ^ lenblk[q]
        q = q + 1
    _ghash_mul(y, h)

// GCM counter: increment ONLY the low 32 bits (bytes 12..15) -- distinct from _aes_incr (full 128-bit).
fn _inc32(ctr)
    let i = 15
    let carry = 1
    while i >= 12 and carry == 1
        let v = ctr[i] + carry
        ctr[i] = v & 255
        if v > 255
            carry = 1
        else
            carry = 0
        i = i - 1

fn _gcm_ctr(key, j0, data) -> list
    let ctr = []
    let i = 0
    while i < 16
        push(ctr, j0[i])
        i = i + 1
    _inc32(ctr)
    let out = []
    let p = 0
    while p < len(data)
        let ks = aes_encrypt_block(ctr, key)
        let j = 0
        while j < 16 and (p + j) < len(data)
            push(out, data[p + j] ^ ks[j])
            j = j + 1
        _inc32(ctr)
        p = p + 16
    out

fn _gcm_j0(iv12) -> list
    let j0 = []
    let k = 0
    while k < 12
        push(j0, iv12[k])
        k = k + 1
    push(j0, 0)
    push(j0, 0)
    push(j0, 0)
    push(j0, 1)
    j0

fn _gcm_tag(key, h, j0, aad, ct) -> list
    let s = _ghash(h, aad, ct)
    let ej0 = aes_encrypt_block(j0, key)
    let tag = []
    let t = 0
    while t < 16
        push(tag, s[t] ^ ej0[t])
        t = t + 1
    tag

// Encrypt with a 12-byte IV -> [ciphertext, tag(16)].
fn aes_gcm_encrypt(key, iv12, plaintext, aad) -> any
    let zero16 = []
    let i = 0
    while i < 16
        push(zero16, 0)
        i = i + 1
    let h = aes_encrypt_block(zero16, key)
    let j0 = _gcm_j0(iv12)
    let ciphertext = _gcm_ctr(key, j0, plaintext)
    let out = []
    push(out, ciphertext)
    push(out, _gcm_tag(key, h, j0, aad, ciphertext))
    out

// Decrypt + verify -> [ok(bool), plaintext]. Constant-time-ish tag compare (no early exit).
fn aes_gcm_decrypt(key, iv12, ciphertext, aad, tag) -> any
    let zero16 = []
    let i = 0
    while i < 16
        push(zero16, 0)
        i = i + 1
    let h = aes_encrypt_block(zero16, key)
    let j0 = _gcm_j0(iv12)
    let want = _gcm_tag(key, h, j0, aad, ciphertext)
    let diff = 0
    let t = 0
    while t < 16
        diff = diff | (want[t] ^ tag[t])
        t = t + 1
    let res = []
    if diff != 0
        push(res, false)
        push(res, [])
        return res
    push(res, true)
    push(res, _gcm_ctr(key, j0, ciphertext))
    res

// ── HKDF-SHA256 (RFC 5869) -- extract-and-expand key derivation ──────────────────────────────────────
fn hkdf_extract(salt, ikm) -> list
    hmac_sha256_bytes(salt, ikm)

fn hkdf_expand(prk, info, length: int) -> list
    let out = []
    let t = []
    let i = 1
    while len(out) < length
        let inp = []
        let a = 0
        while a < len(t)
            push(inp, t[a])
            a = a + 1
        let b = 0
        while b < len(info)
            push(inp, info[b])
            b = b + 1
        push(inp, i & 255)
        t = hmac_sha256_bytes(prk, inp)
        let c = 0
        while c < len(t)
            push(out, t[c])
            c = c + 1
        i = i + 1
    let res = []
    let q = 0
    while q < length
        push(res, out[q])
        q = q + 1
    res

fn hkdf(salt, ikm, info, length: int) -> list
    hkdf_expand(hkdf_extract(salt, ikm), info, length)

// ── ChaCha20 stream cipher (RFC 8439) -- little-endian 32-bit words ──────────────────────────────────
fn _chacha_qr(s, a: int, b: int, c: int, d: int)
    s[a] = (s[a] + s[b]) & 4294967295
    s[d] = _rotl32(s[d] ^ s[a], 16)
    s[c] = (s[c] + s[d]) & 4294967295
    s[b] = _rotl32(s[b] ^ s[c], 12)
    s[a] = (s[a] + s[b]) & 4294967295
    s[d] = _rotl32(s[d] ^ s[a], 8)
    s[c] = (s[c] + s[d]) & 4294967295
    s[b] = _rotl32(s[b] ^ s[c], 7)

fn _le32(b, o: int) -> int
    (b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24)) & 4294967295

// 64-byte keystream block for (key32, nonce12, counter).
fn _chacha_block(key, nonce, counter: int) -> list
    let st = []
    push(st, 0x61707865)
    push(st, 0x3320646e)
    push(st, 0x79622d32)
    push(st, 0x6b206574)
    let i = 0
    while i < 8
        push(st, _le32(key, i * 4))
        i = i + 1
    push(st, counter & 4294967295)
    let j = 0
    while j < 3
        push(st, _le32(nonce, j * 4))
        j = j + 1
    let w = []
    let k = 0
    while k < 16
        push(w, st[k])
        k = k + 1
    let r = 0
    while r < 10
        _chacha_qr(w, 0, 4, 8, 12)
        _chacha_qr(w, 1, 5, 9, 13)
        _chacha_qr(w, 2, 6, 10, 14)
        _chacha_qr(w, 3, 7, 11, 15)
        _chacha_qr(w, 0, 5, 10, 15)
        _chacha_qr(w, 1, 6, 11, 12)
        _chacha_qr(w, 2, 7, 8, 13)
        _chacha_qr(w, 3, 4, 9, 14)
        r = r + 1
    let out = []
    let m = 0
    while m < 16
        let v = (w[m] + st[m]) & 4294967295
        push(out, v & 255)
        push(out, (v >> 8) & 255)
        push(out, (v >> 16) & 255)
        push(out, (v >> 24) & 255)
        m = m + 1
    out

// ChaCha20 encrypt/decrypt (self-inverse) of a byte list, starting at the given block counter.
fn chacha20(key, nonce, counter: int, data) -> list
    let out = []
    let ctr = counter
    let i = 0
    while i < len(data)
        let ks = _chacha_block(key, nonce, ctr)
        let j = 0
        while j < 64 and (i + j) < len(data)
            push(out, data[i + j] ^ ks[j])
            j = j + 1
        ctr = (ctr + 1) & 4294967295
        i = i + 64
    out

// ── Poly1305 MAC (RFC 8439) -- a tiny base-2^16 limb bigint with mod (2^130 - 5) ─────────────────────
// Numbers are little-endian lists of 16-bit limbs. Helpers prefixed _p_.
fn _p_norm(x) -> list
    let out = []
    let carry = 0
    let i = 0
    while i < len(x)
        let v = x[i] + carry
        push(out, v & 65535)
        carry = v >> 16
        i = i + 1
    while carry > 0
        push(out, carry & 65535)
        carry = carry >> 16
    out

fn _p_add(a, b) -> list
    let n = len(a)
    if len(b) > n
        n = len(b)
    let out = []
    let carry = 0
    let i = 0
    while i < n
        let av = 0
        if i < len(a)
            av = a[i]
        let bv = 0
        if i < len(b)
            bv = b[i]
        let v = av + bv + carry
        push(out, v & 65535)
        carry = v >> 16
        i = i + 1
    while carry > 0
        push(out, carry & 65535)
        carry = carry >> 16
    out

fn _p_mul(a, b) -> list
    let out = []
    let z = 0
    while z < len(a) + len(b) + 2
        push(out, 0)
        z = z + 1
    let ia = 0
    while ia < len(a)
        let carry = 0
        let ib = 0
        while ib < len(b)
            let v = out[ia + ib] + a[ia] * b[ib] + carry
            out[ia + ib] = v & 65535
            carry = v >> 16
            ib = ib + 1
        let k = ia + len(b)
        while carry > 0
            let v2 = out[k] + carry
            out[k] = v2 & 65535
            carry = v2 >> 16
            k = k + 1
        ia = ia + 1
    out

fn _p_mul_small(a, d: int) -> list
    let out = []
    let carry = 0
    let i = 0
    while i < len(a)
        let v = a[i] * d + carry
        push(out, v & 65535)
        carry = v >> 16
        i = i + 1
    while carry > 0
        push(out, carry & 65535)
        carry = carry >> 16
    out

fn _p_cmp(a, b) -> int
    let n = len(a)
    if len(b) > n
        n = len(b)
    let i = n - 1
    while i >= 0
        let av = 0
        if i < len(a)
            av = a[i]
        let bv = 0
        if i < len(b)
            bv = b[i]
        if av > bv
            return 1
        if av < bv
            return 0 - 1
        i = i - 1
    0

fn _p_sub(a, b) -> list
    let out = []
    let borrow = 0
    let i = 0
    while i < len(a)
        let av = a[i]
        let bv = 0
        if i < len(b)
            bv = b[i]
        let v = av - bv - borrow
        if v < 0
            v = v + 65536
            borrow = 1
        else
            borrow = 0
        push(out, v & 65535)
        i = i + 1
    out

fn _p_is_nonzero(x) -> int
    let i = 0
    while i < len(x)
        if x[i] != 0
            return 1
        i = i + 1
    0

// x >> 130  =  drop 8 limbs (128 bits) then shift right 2 bits
fn _p_shr130(x) -> list
    let t = []
    let i = 8
    while i < len(x)
        push(t, x[i])
        i = i + 1
    if len(t) == 0
        push(t, 0)
    let out = []
    let j = 0
    while j < len(t)
        let nxt = 0
        if j + 1 < len(t)
            nxt = t[j + 1]
        push(out, ((t[j] >> 2) | ((nxt & 3) << 14)) & 65535)
        j = j + 1
    out

// x mod 2^130  =  limbs 0..7 plus the low 2 bits of limb 8
fn _p_low130(x) -> list
    let out = []
    let i = 0
    while i < 8
        let v = 0
        if i < len(x)
            v = x[i]
        push(out, v)
        i = i + 1
    let l8 = 0
    if 8 < len(x)
        l8 = x[8] & 3
    push(out, l8)
    out

// p = 2^130 - 5 = [0xfffb, 0xffff x7, 3]
fn _p_const_p() -> list
    let p = []
    push(p, 65531)
    let i = 0
    while i < 7
        push(p, 65535)
        i = i + 1
    push(p, 3)
    p

fn _p_mod(x) -> list
    let v = _p_norm(x)
    let high = _p_shr130(v)
    while _p_is_nonzero(high) == 1
        let low = _p_low130(v)
        v = _p_norm(_p_add(low, _p_mul_small(high, 5)))
        high = _p_shr130(v)
    if _p_cmp(v, _p_const_p()) >= 0
        v = _p_sub(v, _p_const_p())
    v

fn _p_from_bytes(b, n: int) -> list
    let out = []
    let i = 0
    while i < n
        let lo = b[i]
        let hi = 0
        if i + 1 < n
            hi = b[i + 1]
        push(out, (lo | (hi << 8)) & 65535)
        i = i + 2
    if len(out) == 0
        push(out, 0)
    out

fn _p_to_bytes16(x) -> list
    let out = []
    let i = 0
    while i < 16
        let limb = 0
        let li = i / 2
        if li < len(x)
            limb = x[li]
        if (i & 1) == 0
            push(out, limb & 255)
        else
            push(out, (limb >> 8) & 255)
        i = i + 1
    out

// poly1305_mac(key32, msg) -> 16-byte tag
fn poly1305_mac(key, msg) -> list
    let rbytes = []
    let i = 0
    while i < 16
        push(rbytes, key[i])
        i = i + 1
    rbytes[3] = rbytes[3] & 15
    rbytes[7] = rbytes[7] & 15
    rbytes[11] = rbytes[11] & 15
    rbytes[15] = rbytes[15] & 15
    rbytes[4] = rbytes[4] & 252
    rbytes[8] = rbytes[8] & 252
    rbytes[12] = rbytes[12] & 252
    let r = _p_from_bytes(rbytes, 16)
    let acc = [0]
    let off = 0
    while off < len(msg)
        let blk = []
        let n = 0
        while n < 16 and (off + n) < len(msg)
            push(blk, msg[off + n])
            n = n + 1
        push(blk, 1)
        let num = _p_from_bytes(blk, len(blk))
        acc = _p_mod(_p_mul(_p_add(acc, num), r))
        off = off + 16
    let sbytes = []
    let j = 16
    while j < 32
        push(sbytes, key[j])
        j = j + 1
    let s = _p_from_bytes(sbytes, 16)
    _p_to_bytes16(_p_add(acc, s))

// ── ChaCha20-Poly1305 AEAD (RFC 8439 Sec 2.8) ───────────────────────────────────────────────────────
fn _pad16_len(n: int) -> int
    let r = n & 15
    if r == 0
        return 0
    16 - r

fn _le64(n: int) -> list
    let out = []
    let v = n
    let i = 0
    while i < 8
        push(out, v & 255)
        v = v >> 8
        i = i + 1
    out

// One-time Poly1305 key = first 32 bytes of ChaCha20 keystream block 0.
fn _chacha20_poly_key(key, nonce) -> list
    let blk = _chacha_block(key, nonce, 0)
    let out = []
    let i = 0
    while i < 32
        push(out, blk[i])
        i = i + 1
    out

// mac input = aad || pad16(aad) || ct || pad16(ct) || le64(len aad) || le64(len ct)
fn _aead_mac_data(aad, ct) -> list
    let md = []
    let i = 0
    while i < len(aad)
        push(md, aad[i])
        i = i + 1
    let pa = _pad16_len(len(aad))
    let j = 0
    while j < pa
        push(md, 0)
        j = j + 1
    let k = 0
    while k < len(ct)
        push(md, ct[k])
        k = k + 1
    let pc = _pad16_len(len(ct))
    let m = 0
    while m < pc
        push(md, 0)
        m = m + 1
    let la = _le64(len(aad))
    let q = 0
    while q < 8
        push(md, la[q])
        q = q + 1
    let lc = _le64(len(ct))
    let q2 = 0
    while q2 < 8
        push(md, lc[q2])
        q2 = q2 + 1
    md

// -> [ciphertext, tag16]
fn chacha20_poly1305_encrypt(key, nonce, plaintext, aad) -> list
    let polykey = _chacha20_poly_key(key, nonce)
    let ct = chacha20(key, nonce, 1, plaintext)
    let tag = poly1305_mac(polykey, _aead_mac_data(aad, ct))
    let res = []
    push(res, ct)
    push(res, tag)
    res

// -> [ok(bool), plaintext]; verifies the tag (no early-exit compare) before decrypting
fn chacha20_poly1305_decrypt(key, nonce, ciphertext, aad, tag) -> list
    let polykey = _chacha20_poly_key(key, nonce)
    let want = poly1305_mac(polykey, _aead_mac_data(aad, ciphertext))
    let diff = 0
    if len(want) != len(tag)
        diff = 1
    let d = 0
    while d < 16
        let tv = 0
        if d < len(tag)
            tv = tag[d]
        diff = diff | (want[d] ^ tv)
        d = d + 1
    let res = []
    if diff != 0
        push(res, false)
        push(res, [])
        return res
    push(res, true)
    push(res, chacha20(key, nonce, 1, ciphertext))
    res

// ── SHA-512 / SHA-384 (FIPS 180-4) -- 64-bit words on i64 (>> is arithmetic, so use _shr64) ──────────
fn _shr64(x: int, n: int) -> int
    (x >> n) & ((1 << (64 - n)) - 1)

fn _rotr64(x: int, n: int) -> int
    _shr64(x, n) | (x << (64 - n))

fn _sha512_k() -> list
    let k = []
    push(k, 0x428a2f98d728ae22)
    push(k, 0x7137449123ef65cd)
    push(k, 0xb5c0fbcfec4d3b2f)
    push(k, 0xe9b5dba58189dbbc)
    push(k, 0x3956c25bf348b538)
    push(k, 0x59f111f1b605d019)
    push(k, 0x923f82a4af194f9b)
    push(k, 0xab1c5ed5da6d8118)
    push(k, 0xd807aa98a3030242)
    push(k, 0x12835b0145706fbe)
    push(k, 0x243185be4ee4b28c)
    push(k, 0x550c7dc3d5ffb4e2)
    push(k, 0x72be5d74f27b896f)
    push(k, 0x80deb1fe3b1696b1)
    push(k, 0x9bdc06a725c71235)
    push(k, 0xc19bf174cf692694)
    push(k, 0xe49b69c19ef14ad2)
    push(k, 0xefbe4786384f25e3)
    push(k, 0x0fc19dc68b8cd5b5)
    push(k, 0x240ca1cc77ac9c65)
    push(k, 0x2de92c6f592b0275)
    push(k, 0x4a7484aa6ea6e483)
    push(k, 0x5cb0a9dcbd41fbd4)
    push(k, 0x76f988da831153b5)
    push(k, 0x983e5152ee66dfab)
    push(k, 0xa831c66d2db43210)
    push(k, 0xb00327c898fb213f)
    push(k, 0xbf597fc7beef0ee4)
    push(k, 0xc6e00bf33da88fc2)
    push(k, 0xd5a79147930aa725)
    push(k, 0x06ca6351e003826f)
    push(k, 0x142929670a0e6e70)
    push(k, 0x27b70a8546d22ffc)
    push(k, 0x2e1b21385c26c926)
    push(k, 0x4d2c6dfc5ac42aed)
    push(k, 0x53380d139d95b3df)
    push(k, 0x650a73548baf63de)
    push(k, 0x766a0abb3c77b2a8)
    push(k, 0x81c2c92e47edaee6)
    push(k, 0x92722c851482353b)
    push(k, 0xa2bfe8a14cf10364)
    push(k, 0xa81a664bbc423001)
    push(k, 0xc24b8b70d0f89791)
    push(k, 0xc76c51a30654be30)
    push(k, 0xd192e819d6ef5218)
    push(k, 0xd69906245565a910)
    push(k, 0xf40e35855771202a)
    push(k, 0x106aa07032bbd1b8)
    push(k, 0x19a4c116b8d2d0c8)
    push(k, 0x1e376c085141ab53)
    push(k, 0x2748774cdf8eeb99)
    push(k, 0x34b0bcb5e19b48a8)
    push(k, 0x391c0cb3c5c95a63)
    push(k, 0x4ed8aa4ae3418acb)
    push(k, 0x5b9cca4f7763e373)
    push(k, 0x682e6ff3d6b2b8a3)
    push(k, 0x748f82ee5defb2fc)
    push(k, 0x78a5636f43172f60)
    push(k, 0x84c87814a1f0ab72)
    push(k, 0x8cc702081a6439ec)
    push(k, 0x90befffa23631e28)
    push(k, 0xa4506cebde82bde9)
    push(k, 0xbef9a3f7b2c67915)
    push(k, 0xc67178f2e372532b)
    push(k, 0xca273eceea26619c)
    push(k, 0xd186b8c721c0c207)
    push(k, 0xeada7dd6cde0eb1e)
    push(k, 0xf57d4f7fee6ed178)
    push(k, 0x06f067aa72176fba)
    push(k, 0x0a637dc5a2c898a6)
    push(k, 0x113f9804bef90dae)
    push(k, 0x1b710b35131c471b)
    push(k, 0x28db77f523047d84)
    push(k, 0x32caab7b40c72493)
    push(k, 0x3c9ebe0a15c9bebc)
    push(k, 0x431d67c49c100d4c)
    push(k, 0x4cc5d4becb3e42b6)
    push(k, 0x597f299cfc657e2a)
    push(k, 0x5fcb6fab3ad6faec)
    push(k, 0x6c44198c4a475817)
    k

// Process msg through the SHA-512 compression with the given 8-word IV h; returns the final 8 words.
fn _sha512_compress(msg, h) -> list
    let k = _sha512_k()
    let ml = len(msg)
    let bitlen = ml * 8
    let padded = []
    let i = 0
    while i < ml
        push(padded, msg[i])
        i = i + 1
    push(padded, 0x80)
    while (len(padded) & 127) != 112
        push(padded, 0)
    let z = 0
    while z < 8
        push(padded, 0)
        z = z + 1
    let b = 7
    while b >= 0
        push(padded, (bitlen >> (b * 8)) & 255)
        b = b - 1
    let off = 0
    while off < len(padded)
        let w = []
        let t = 0
        while t < 16
            let word = 0
            let bi = 0
            while bi < 8
                word = (word << 8) | padded[off + t * 8 + bi]
                bi = bi + 1
            push(w, word)
            t = t + 1
        let t2 = 16
        while t2 < 80
            let x15 = w[t2 - 15]
            let x2 = w[t2 - 2]
            let s0 = _rotr64(x15, 1) ^ _rotr64(x15, 8) ^ _shr64(x15, 7)
            let s1 = _rotr64(x2, 19) ^ _rotr64(x2, 61) ^ _shr64(x2, 6)
            push(w, w[t2 - 16] + s0 + w[t2 - 7] + s1)
            t2 = t2 + 1
        let a = h[0]
        let bb = h[1]
        let c = h[2]
        let d = h[3]
        let e = h[4]
        let f = h[5]
        let g = h[6]
        let hh = h[7]
        let r = 0
        while r < 80
            let big1 = _rotr64(e, 14) ^ _rotr64(e, 18) ^ _rotr64(e, 41)
            let ch = (e & f) ^ ((~e) & g)
            let temp1 = hh + big1 + ch + k[r] + w[r]
            let big0 = _rotr64(a, 28) ^ _rotr64(a, 34) ^ _rotr64(a, 39)
            let maj = (a & bb) ^ (a & c) ^ (bb & c)
            let temp2 = big0 + maj
            hh = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = bb
            bb = a
            a = temp1 + temp2
            r = r + 1
        h[0] = h[0] + a
        h[1] = h[1] + bb
        h[2] = h[2] + c
        h[3] = h[3] + d
        h[4] = h[4] + e
        h[5] = h[5] + f
        h[6] = h[6] + g
        h[7] = h[7] + hh
        off = off + 128
    h

fn _sha512_serialize(h, words: int) -> list
    let out = []
    let oi = 0
    while oi < words
        let bj = 7
        while bj >= 0
            push(out, (h[oi] >> (bj * 8)) & 255)
            bj = bj - 1
        oi = oi + 1
    out

fn sha512_bytes(msg) -> list
    let h = []
    push(h, 0x6a09e667f3bcc908)
    push(h, 0xbb67ae8584caa73b)
    push(h, 0x3c6ef372fe94f82b)
    push(h, 0xa54ff53a5f1d36f1)
    push(h, 0x510e527fade682d1)
    push(h, 0x9b05688c2b3e6c1f)
    push(h, 0x1f83d9abfb41bd6b)
    push(h, 0x5be0cd19137e2179)
    _sha512_serialize(_sha512_compress(msg, h), 8)

fn sha512_hex(s) -> string
    hex_of(sha512_bytes(str_to_blist(s)))

fn sha384_bytes(msg) -> list
    let h = []
    push(h, 0xcbbb9d5dc1059ed8)
    push(h, 0x629a292a367cd507)
    push(h, 0x9159015a3070dd17)
    push(h, 0x152fecd8f70e5939)
    push(h, 0x67332667ffc00b31)
    push(h, 0x8eb44a8768581511)
    push(h, 0xdb0c2e0d64f98fa7)
    push(h, 0x47b5481dbefa4fa4)
    _sha512_serialize(_sha512_compress(msg, h), 6)

fn sha384_hex(s) -> string
    hex_of(sha384_bytes(str_to_blist(s)))

// ── X25519 (RFC 7748) -- field arithmetic mod p=2^255-19 on base-2^16 limbs (reusing the _p_* helpers) ─
// Field elements are 16-limb little-endian lists. Loosely reduced (< 2^256) between ops; freeze at encode.
fn _f_const_p() -> list
    let p = []
    push(p, 65517)
    let i = 0
    while i < 14
        push(p, 65535)
        i = i + 1
    push(p, 32767)
    p

fn _f_small(n: int) -> list
    let f = []
    push(f, n & 65535)
    push(f, (n >> 16) & 65535)
    let i = 0
    while i < 14
        push(f, 0)
        i = i + 1
    f

fn _f_copy(a) -> list
    let c = []
    let i = 0
    while i < len(a)
        push(c, a[i])
        i = i + 1
    c

// Reduce any-length limb list mod p to a <2^256 (16-limb) value via 2^256 == 38.
fn _f_reduce(x) -> list
    let v = _p_norm(x)
    while len(v) > 16
        let low = []
        let i = 0
        while i < 16
            push(low, v[i])
            i = i + 1
        let high = []
        let j = 16
        while j < len(v)
            push(high, v[j])
            j = j + 1
        v = _p_norm(_p_add(low, _p_mul_small(high, 38)))
    while len(v) < 16
        push(v, 0)
    v

// Canonical reduce to [0, p).
fn _f_freeze(a) -> list
    let v = _f_reduce(a)
    let i = 0
    while i < 3
        if _p_cmp(v, _f_const_p()) >= 0
            v = _p_sub(v, _f_const_p())
        i = i + 1
    v

fn _f_add(a, b) -> list
    _f_reduce(_p_add(a, b))

fn _f_sub(a, b) -> list
    let fourp = _p_mul_small(_f_const_p(), 4)
    _f_reduce(_p_add(a, _p_sub(fourp, b)))

fn _f_mul(a, b) -> list
    _f_reduce(_p_mul(a, b))

fn _f_sqr(a) -> list
    _f_reduce(_p_mul(a, a))

fn _f_mul121665(a) -> list
    _f_reduce(_p_mul_small(a, 121665))

// a^(p-2) mod p, via square-and-multiply over the bits of p-2 = 2^255-21.
fn _f_invert(a) -> list
    let pm2 = _p_sub(_f_const_p(), _f_small(2))
    let result = _f_small(1)
    let i = 254
    while i >= 0
        result = _f_reduce(_p_mul(result, result))
        let bit = (pm2[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = _f_reduce(_p_mul(result, a))
        i = i - 1
    _f_freeze(result)

// 32 little-endian bytes -> field element (clear bit 255).
fn _f_decode(b) -> list
    let bb = []
    let i = 0
    while i < 32
        push(bb, b[i])
        i = i + 1
    bb[31] = bb[31] & 127
    let f = []
    let j = 0
    while j < 16
        push(f, bb[2 * j] | (bb[2 * j + 1] << 8))
        j = j + 1
    f

// field element -> 32 little-endian bytes (frozen).
fn _f_encode(a) -> list
    let v = _f_freeze(a)
    let out = []
    let i = 0
    while i < 16
        push(out, v[i] & 255)
        push(out, (v[i] >> 8) & 255)
        i = i + 1
    out

fn _x25519_clamp(scalar) -> list
    let s = []
    let i = 0
    while i < 32
        push(s, scalar[i])
        i = i + 1
    s[0] = s[0] & 248
    s[31] = s[31] & 127
    s[31] = s[31] | 64
    s

// X25519: scalar (32 bytes) * u (32 bytes) -> shared secret (32 bytes). Montgomery ladder, x-only.
fn x25519(scalar, u_bytes) -> list
    let k = _x25519_clamp(scalar)
    let x1 = _f_decode(u_bytes)
    let x2 = _f_small(1)
    let z2 = _f_small(0)
    let x3 = _f_copy(x1)
    let z3 = _f_small(1)
    let swap = 0
    let t = 254
    while t >= 0
        let kt = (k[t / 8] >> (t & 7)) & 1
        swap = swap ^ kt
        if swap == 1
            let tmp = x2
            x2 = x3
            x3 = tmp
            let tmp2 = z2
            z2 = z3
            z3 = tmp2
        swap = kt
        let aa1 = _f_add(x2, z2)
        let aa = _f_sqr(aa1)
        let bb1 = _f_sub(x2, z2)
        let bb = _f_sqr(bb1)
        let e = _f_sub(aa, bb)
        let cc = _f_add(x3, z3)
        let dd = _f_sub(x3, z3)
        let da = _f_mul(dd, aa1)
        let cb = _f_mul(cc, bb1)
        let x3s = _f_add(da, cb)
        let x3n = _f_sqr(x3s)
        let z3s = _f_sub(da, cb)
        let z3n = _f_mul(x1, _f_sqr(z3s))
        let x2n = _f_mul(aa, bb)
        let z2n = _f_mul(e, _f_add(aa, _f_mul121665(e)))
        x3 = x3n
        z3 = z3n
        x2 = x2n
        z2 = z2n
        t = t - 1
    if swap == 1
        let tmp = x2
        x2 = x3
        x3 = tmp
        let tmp2 = z2
        z2 = z3
        z3 = tmp2
    _f_encode(_f_mul(x2, _f_invert(z2)))

// ── Ed25519 (RFC 8032) -- reuses _f_* field arithmetic + sha512_bytes ────────────────────────────────
// generic field exponentiation a^e mod p, e = limb list scanned MSB-first over nbits bits.
fn _f_pow(a, e, nbits: int) -> list
    let result = _f_small(1)
    let i = nbits - 1
    while i >= 0
        result = _f_reduce(_p_mul(result, result))
        let bit = (e[i / 16] >> (i & 15)) & 1
        if bit == 1
            result = _f_reduce(_p_mul(result, a))
        i = i - 1
    result

fn _f_is_zero(a) -> int
    let v = _f_freeze(a)
    if _p_is_nonzero(v) == 1
        return 0
    1

// (p-1)/4 = 2^253 - 5  (exponent for sqrt(-1) = 2^((p-1)/4))
fn _ed_pm1_4() -> list
    let e = []
    push(e, 65531)
    let i = 0
    while i < 14
        push(e, 65535)
        i = i + 1
    push(e, 8191)
    e

// (p-5)/8 = 2^252 - 3  (exponent for the curve25519 sqrt)
fn _ed_pm5_8() -> list
    let e = []
    push(e, 65533)
    let i = 0
    while i < 14
        push(e, 65535)
        i = i + 1
    push(e, 4095)
    e

// group order L = 2^252 + 27742317777372353535851937790883648493
fn _ed_const_L() -> list
    let l = []
    push(l, 54253)
    push(l, 23797)
    push(l, 25370)
    push(l, 22546)
    push(l, 40150)
    push(l, 41719)
    push(l, 63966)
    push(l, 5342)
    push(l, 0)
    push(l, 0)
    push(l, 0)
    push(l, 0)
    push(l, 0)
    push(l, 0)
    push(l, 0)
    push(l, 4096)
    l

fn _shl1(a) -> list
    let out = []
    let carry = 0
    let i = 0
    while i < len(a)
        let v = (a[i] << 1) | carry
        push(out, v & 65535)
        carry = (v >> 16) & 1
        i = i + 1
    if carry == 1
        push(out, 1)
    out

// reduce a limb list mod L by binary long division (result < L, 16 limbs)
fn _ed_mod_L(x) -> list
    let lcon = _ed_const_L()
    let xn = _p_norm(x)
    let nbits = len(xn) * 16
    let rem = []
    push(rem, 0)
    let i = nbits - 1
    while i >= 0
        rem = _shl1(rem)
        let bit = (xn[i / 16] >> (i & 15)) & 1
        if bit == 1
            rem[0] = rem[0] | 1
        if _p_cmp(rem, lcon) >= 0
            rem = _p_sub(rem, lcon)
        i = i - 1
    while len(rem) < 16
        push(rem, 0)
    rem

fn _ed_identity() -> list
    let p = []
    push(p, _f_small(0))
    push(p, _f_small(1))
    push(p, _f_small(1))
    push(p, _f_small(0))
    p

// twisted-Edwards add (a=-1, add-2008-hwcd-3); complete, so also used for doubling. d2 = 2*d.
fn _ed_add(p1, p2, d2) -> list
    let aa = _f_mul(_f_sub(p1[1], p1[0]), _f_sub(p2[1], p2[0]))
    let bb = _f_mul(_f_add(p1[1], p1[0]), _f_add(p2[1], p2[0]))
    let cc = _f_mul(_f_mul(p1[3], d2), p2[3])
    let dd = _f_mul(_f_mul(p1[2], _f_small(2)), p2[2])
    let e = _f_sub(bb, aa)
    let f = _f_sub(dd, cc)
    let g = _f_add(dd, cc)
    let h = _f_add(bb, aa)
    let r = []
    push(r, _f_mul(e, f))
    push(r, _f_mul(g, h))
    push(r, _f_mul(f, g))
    push(r, _f_mul(e, h))
    r

fn _ed_scalarmult(sbytes, point, d2) -> list
    let q = _ed_identity()
    let i = 255
    while i >= 0
        q = _ed_add(q, q, d2)
        let bit = (sbytes[i / 8] >> (i & 7)) & 1
        if bit == 1
            q = _ed_add(q, point, d2)
        i = i - 1
    q

// recover x from y given the sign bit (RFC 8032 decompression)
fn _ed_recover_x(y, sign: int, d, sqrtm1) -> list
    let y2 = _f_sqr(y)
    let u = _f_sub(y2, _f_small(1))
    let v = _f_add(_f_mul(d, y2), _f_small(1))
    let v2 = _f_sqr(v)
    let v3 = _f_mul(v2, v)
    let v6 = _f_sqr(v3)
    let v7 = _f_mul(v6, v)
    let uv7 = _f_mul(u, v7)
    let pw = _f_pow(uv7, _ed_pm5_8(), 252)
    let x = _f_mul(_f_mul(u, v3), pw)
    let vx2 = _f_mul(v, _f_sqr(x))
    if _f_is_zero(_f_sub(vx2, u)) == 0
        if _f_is_zero(_f_add(vx2, u)) == 1
            x = _f_mul(x, sqrtm1)
        else
            x = _f_small(0)
    let xf = _f_freeze(x)
    if (xf[0] & 1) != sign
        xf = _f_freeze(_f_sub(_f_small(0), xf))
    xf

fn _ed_encode(point) -> list
    let zinv = _f_invert(point[2])
    let x = _f_mul(point[0], zinv)
    let y = _f_mul(point[1], zinv)
    let out = _f_encode(y)
    let xf = _f_freeze(x)
    out[31] = out[31] | ((xf[0] & 1) << 7)
    out

fn _ed_decode(b, d, sqrtm1) -> list
    let sign = (b[31] >> 7) & 1
    let yb = []
    let i = 0
    while i < 32
        push(yb, b[i])
        i = i + 1
    yb[31] = yb[31] & 127
    let y = _f_decode(yb)
    let x = _ed_recover_x(y, sign, d, sqrtm1)
    let p = []
    push(p, x)
    push(p, y)
    push(p, _f_small(1))
    push(p, _f_mul(x, y))
    p

// returns [d, d2, sqrtm1, basepoint]
fn _ed_setup() -> list
    let sqrtm1 = _f_pow(_f_small(2), _ed_pm1_4(), 253)
    let d = _f_mul(_f_sub(_f_small(0), _f_small(121665)), _f_invert(_f_small(121666)))
    let d2 = _f_add(d, d)
    let by = _f_mul(_f_small(4), _f_invert(_f_small(5)))
    let bx = _ed_recover_x(by, 0, d, sqrtm1)
    let b = []
    push(b, bx)
    push(b, by)
    push(b, _f_small(1))
    push(b, _f_mul(bx, by))
    let s = []
    push(s, d)
    push(s, d2)
    push(s, sqrtm1)
    push(s, b)
    s

fn _concat(a, b) -> list
    let o = []
    let i = 0
    while i < len(a)
        push(o, a[i])
        i = i + 1
    let j = 0
    while j < len(b)
        push(o, b[j])
        j = j + 1
    o

fn _bytes_to_limbs(b, n: int) -> list
    let f = []
    let j = 0
    while j < n
        push(f, b[j] | (b[j + 1] << 8))
        j = j + 2
    f

fn _limbs_to_bytes32(v) -> list
    let out = []
    let i = 0
    while i < 16
        let limb = 0
        if i < len(v)
            limb = v[i]
        push(out, limb & 255)
        push(out, (limb >> 8) & 255)
        i = i + 1
    out

fn _ed_clamp_scalar(h) -> list
    let ab = []
    let i = 0
    while i < 32
        push(ab, h[i])
        i = i + 1
    ab[0] = ab[0] & 248
    ab[31] = ab[31] & 127
    ab[31] = ab[31] | 64
    ab

fn ed25519_publickey(sk) -> list
    let setup = _ed_setup()
    let ab = _ed_clamp_scalar(sha512_bytes(sk))
    _ed_encode(_ed_scalarmult(ab, setup[3], setup[1]))

fn ed25519_sign(sk, msg) -> list
    let setup = _ed_setup()
    let d2 = setup[1]
    let bp = setup[3]
    let h = sha512_bytes(sk)
    let ab = _ed_clamp_scalar(h)
    let a = _bytes_to_limbs(ab, 32)
    let prefix = []
    let j = 32
    while j < 64
        push(prefix, h[j])
        j = j + 1
    let aenc = _ed_encode(_ed_scalarmult(ab, bp, d2))
    let r = _ed_mod_L(_bytes_to_limbs(sha512_bytes(_concat(prefix, msg)), 64))
    let renc = _ed_encode(_ed_scalarmult(_limbs_to_bytes32(r), bp, d2))
    let k = _ed_mod_L(_bytes_to_limbs(sha512_bytes(_concat(_concat(renc, aenc), msg)), 64))
    let s = _ed_mod_L(_p_add(_p_mul(k, a), r))
    _concat(renc, _limbs_to_bytes32(s))

fn ed25519_verify(pubkey, msg, sig) -> int
    let setup = _ed_setup()
    let d = setup[0]
    let d2 = setup[1]
    let sqrtm1 = setup[2]
    let bp = setup[3]
    let renc = []
    let i = 0
    while i < 32
        push(renc, sig[i])
        i = i + 1
    let sb = []
    let j = 32
    while j < 64
        push(sb, sig[j])
        j = j + 1
    let k = _ed_mod_L(_bytes_to_limbs(sha512_bytes(_concat(_concat(renc, pubkey), msg)), 64))
    let lhs = _ed_scalarmult(sb, bp, d2)
    let apt = _ed_decode(pubkey, d, sqrtm1)
    let ka = _ed_scalarmult(_limbs_to_bytes32(k), apt, d2)
    let rpt = _ed_decode(renc, d, sqrtm1)
    let rhs = _ed_add(rpt, ka, d2)
    if hex_of(_ed_encode(lhs)) == hex_of(_ed_encode(rhs))
        return 1
    0
