// forge_cache_manager — Multi-tier cache management (l1/l2/l3).

fn cm_new() -> dict
    {"hits": 0, "misses": 0, "cnt_l1": 0, "cnt_l2": 0, "cnt_l3": 0}

fn cm_set(c: dict, key: string, value: string, tier: string) -> dict
    let pk = "p_{tier}_{key}"
    let vk = "v_{tier}_{key}"
    if not (pk in c and c[pk] == 1)
        let ck = "cnt_{tier}"
        if ck not in c
            c[ck] = 0
        c[ck] += 1
    c[pk] = 1
    c[vk] = value
    c

fn _cm_tier_get(c: dict, tier: string, key: string) -> Result
    let pk = "p_{tier}_{key}"
    if pk not in c
        return err("miss")
    if c[pk] != 1
        return err("miss")
    ok(c["v_{tier}_{key}"])

fn cm_get(c: dict, key: string) -> Result
    let r1 = _cm_tier_get(c, "l1", key)
    if is_ok(r1)
        c["hits"] += 1
        return r1
    let r2 = _cm_tier_get(c, "l2", key)
    if is_ok(r2)
        c["hits"] += 1
        return r2
    let r3 = _cm_tier_get(c, "l3", key)
    if is_ok(r3)
        c["hits"] += 1
        return r3
    c["misses"] += 1
    err("cache miss: {key}")

fn cm_invalidate(c: dict, key: string) -> Result
    let found = 0
    let t1 = "p_l1_{key}"
    if t1 in c and c[t1] == 1
        c[t1] = 0
        c["cnt_l1"] -= 1
        found = 1
    let t2 = "p_l2_{key}"
    if t2 in c and c[t2] == 1
        c[t2] = 0
        c["cnt_l2"] -= 1
        found = 1
    let t3 = "p_l3_{key}"
    if t3 in c and c[t3] == 1
        c[t3] = 0
        c["cnt_l3"] -= 1
        found = 1
    if found == 0
        return err("key not found: {key}")
    ok(key)

fn cm_tier_count(c: dict, tier: string) -> int
    let ck = "cnt_{tier}"
    if ck not in c
        return 0
    c[ck]

fn cm_total_count(c: dict) -> int
    cm_tier_count(c, "l1") + cm_tier_count(c, "l2") + cm_tier_count(c, "l3")

fn cm_hit_count(c: dict) -> int
    c["hits"]

fn cm_miss_count(c: dict) -> int
    c["misses"]

fn cm_hit_rate(c: dict) -> Result
    let total = c["hits"] + c["misses"]
    if total == 0
        return err("no gets recorded")
    ok(c["hits"] * 100 / total)

fn cm_has(c: dict, key: string) -> int
    if is_ok(_cm_tier_get(c, "l1", key))
        return 1
    if is_ok(_cm_tier_get(c, "l2", key))
        return 1
    if is_ok(_cm_tier_get(c, "l3", key))
        return 1
    0
