// forge_cache_manager — Multi-tier cache management (l1/l2/l3).
// cm_get searches l1 -> l2 -> l3 in order; cm_set writes to a specific
// tier; cm_invalidate removes a key from every tier. Hit/miss counters
// are global across all tiers.
//
// STATE SHAPE (flat dict, no nesting):
//   state["p_"+tier+"_"+key] — int, 1 if `key` is currently present in `tier`, else absent/0.
//   state["v_"+tier+"_"+key] — string, value stored for `key` in `tier`.
//   state["cnt_"+tier]       — int, number of live keys in `tier`.
//   state["hits"]            — int, total successful cm_get calls.
//   state["misses"]          — int, total failed cm_get calls.

// cm_new() -> dict
// Create an empty cache manager.
fn cm_new() -> dict
    let c = {}
    c["hits"] = 0
    c["misses"] = 0
    c["cnt_l1"] = 0
    c["cnt_l2"] = 0
    c["cnt_l3"] = 0
    c

// cm_set(state, key, value, tier) -> dict
// Store `value` for `key` in `tier` ("l1"/"l2"/"l3"). Overwrites in place
// if the key is already live in that tier.
fn cm_set(c: dict, key: string, value: string, tier: string) -> dict
    let pk = "p_" + tier + "_" + key
    let vk = "v_" + tier + "_" + key
    let already = 0
    if pk in c == true
        if c[pk] == 1
            already = 1
    if already == 0
        let ck = "cnt_" + tier
        if ck in c != true
            c[ck] = 0
        c[ck] = c[ck] + 1
    c[pk] = 1
    c[vk] = value
    c

// _cm_tier_get(state, tier, key) -> Result — internal, no counters touched.
fn _cm_tier_get(c: dict, tier: string, key: string) -> Result
    let pk = "p_" + tier + "_" + key
    if pk in c != true
        return err("miss")
    if c[pk] != 1
        return err("miss")
    ok(c["v_" + tier + "_" + key])

// cm_get(state, key) -> Result
// Search l1 -> l2 -> l3 in order; ok(value) on the first hit, or
// err if absent from every tier. Updates the global hit/miss counters.
fn cm_get(c: dict, key: string) -> Result
    let r1 = _cm_tier_get(c, "l1", key)
    if is_ok(r1) == true
        c["hits"] = c["hits"] + 1
        return r1
    let r2 = _cm_tier_get(c, "l2", key)
    if is_ok(r2) == true
        c["hits"] = c["hits"] + 1
        return r2
    let r3 = _cm_tier_get(c, "l3", key)
    if is_ok(r3) == true
        c["hits"] = c["hits"] + 1
        return r3
    c["misses"] = c["misses"] + 1
    err("cache miss: " + key)

// cm_invalidate(state, key) -> Result
// Remove `key` from every tier it is present in. ok(key), or err if
// absent from all three tiers.
fn cm_invalidate(c: dict, key: string) -> Result
    let found = 0
    let t1 = "p_l1_" + key
    if t1 in c == true
        if c[t1] == 1
            c[t1] = 0
            c["cnt_l1"] = c["cnt_l1"] - 1
            found = 1
    let t2 = "p_l2_" + key
    if t2 in c == true
        if c[t2] == 1
            c[t2] = 0
            c["cnt_l2"] = c["cnt_l2"] - 1
            found = 1
    let t3 = "p_l3_" + key
    if t3 in c == true
        if c[t3] == 1
            c[t3] = 0
            c["cnt_l3"] = c["cnt_l3"] - 1
            found = 1
    if found == 0
        return err("key not found: " + key)
    ok(key)

// cm_tier_count(state, tier) -> int
fn cm_tier_count(c: dict, tier: string) -> int
    let ck = "cnt_" + tier
    if ck in c != true
        return 0
    c[ck]

// cm_total_count(state) -> int
fn cm_total_count(c: dict) -> int
    cm_tier_count(c, "l1") + cm_tier_count(c, "l2") + cm_tier_count(c, "l3")

// cm_hit_count(state) -> int
fn cm_hit_count(c: dict) -> int
    c["hits"]

// cm_miss_count(state) -> int
fn cm_miss_count(c: dict) -> int
    c["misses"]

// cm_hit_rate(state) -> Result
// ok(hit percentage 0-100), or err if no gets have been recorded yet.
fn cm_hit_rate(c: dict) -> Result
    let total = c["hits"] + c["misses"]
    if total == 0
        return err("no gets recorded")
    ok(c["hits"] * 100 / total)

// cm_has(state, key) -> int
// 1 if `key` is currently live in any tier, else 0.
fn cm_has(c: dict, key: string) -> int
    let r1 = _cm_tier_get(c, "l1", key)
    if is_ok(r1) == true
        return 1
    let r2 = _cm_tier_get(c, "l2", key)
    if is_ok(r2) == true
        return 1
    let r3 = _cm_tier_get(c, "l3", key)
    if is_ok(r3) == true
        return 1
    0
