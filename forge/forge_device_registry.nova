// forge_device_registry — IoT device management: register devices, track type,
// firmware version, and online/offline status.
//
// STATE SHAPE (flat dict, no nesting — every field is a top-level string/int key):
//   state["count"]              — int, total registered devices
//   state["online_count"]       — int, devices currently marked "online"
//   state["type_"+device_id]    — string, device type (presence = registered)
//   state["fw_"+device_id]      — string, firmware version
//   state["status_"+device_id]  — string, "online" or "offline" (set at registration)
//
// Presence of "type_"+device_id is the sole membership marker — there is no
// unregister operation, so a permanent key is safe (no dict-delete needed).
//
// LEAF MODULE — imports NOTHING; only NOVA builtins: contains/ok/err/is_ok/is_err.

// dr_new() -> dict
// Create an empty device registry.
fn dr_new() -> dict
    {"count": 0, "online_count": 0}

// dr_register(state, device_id, device_type, firmware) -> dict
// Register a device. Re-registering an existing device_id updates its type and
// firmware WITHOUT double-counting or resetting its current status. A newly
// registered device starts "offline".
fn dr_register(state: dict, device_id: string, device_type: string, firmware: string) -> dict
    if ("type_" + device_id) not in state
        state["count"] += 1
        state["status_" + device_id] = "offline"
    state["type_" + device_id] = device_type
    state["fw_" + device_id] = firmware
    state

// dr_get_type(state, device_id) -> Result
// Return ok(device_type) or err("device not found").
fn dr_get_type(state: dict, device_id: string) -> Result
    if ("type_" + device_id) not in state
        return err("device not found")
    ok(state["type_" + device_id])

// dr_get_firmware(state, device_id) -> Result
// Return ok(firmware_version) or err("device not found").
fn dr_get_firmware(state: dict, device_id: string) -> Result
    if ("type_" + device_id) not in state
        return err("device not found")
    ok(state["fw_" + device_id])

// dr_update_firmware(state, device_id, new_fw) -> Result
// Update firmware version. Returns ok(state) on success, err if device unknown.
fn dr_update_firmware(state: dict, device_id: string, new_fw: string) -> Result
    if ("type_" + device_id) not in state
        return err("device not found")
    state["fw_" + device_id] = new_fw
    ok(state)

// dr_set_status(state, device_id, status) -> Result
// Set device status (e.g. "online"/"offline"). Maintains online_count by
// comparing against the previous status before overwriting it.
fn dr_set_status(state: dict, device_id: string, status: string) -> Result
    if ("type_" + device_id) not in state
        return err("device not found")
    let old_status = state["status_" + device_id]
    if old_status == "online"
        if status != "online"
            state["online_count"] -= 1
    else
        if status == "online"
            state["online_count"] += 1
    state["status_" + device_id] = status
    ok(state)

// dr_get_status(state, device_id) -> Result
// Return ok(status) or err("device not found").
fn dr_get_status(state: dict, device_id: string) -> Result
    if ("type_" + device_id) not in state
        return err("device not found")
    ok(state["status_" + device_id])

// dr_device_count(state) -> int
// Total number of registered devices.
fn dr_device_count(state: dict) -> int
    state["count"]

// dr_online_count(state) -> int
// Number of devices currently marked "online".
fn dr_online_count(state: dict) -> int
    state["online_count"]

// dr_has_device(state, device_id) -> int
// Return 1 if device_id is registered, 0 otherwise.
fn dr_has_device(state: dict, device_id: string) -> int
    if ("type_" + device_id) in state
        return 1
    0
