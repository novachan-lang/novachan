// forge_event_replay — Event sourcing replay and projection.
// Store events, replay from offset, build projections.

fn er_new() -> dict
    let er = {}
    er["events"] = []
    er["projections"] = {}
    er["snapshots"] = {}
    er

fn er_append(er: dict, stream: string, event_type: string, data: dict) -> dict
    let ev = {}
    ev["stream"] = stream
    ev["type"] = event_type
    ev["data"] = data
    ev["seq"] = len(er["events"]) + 1
    push(er["events"], ev)
    er

fn er_event_count(er: dict) -> int
    len(er["events"])

fn er_events_for(er: dict, stream: string) -> list
    let result = []
    let i = 0
    while i < len(er["events"])
        if er["events"][i]["stream"] == stream
            push(result, er["events"][i])
        i = i + 1
    result

fn er_events_since(er: dict, seq: int) -> list
    let result = []
    let i = 0
    while i < len(er["events"])
        if er["events"][i]["seq"] > seq
            push(result, er["events"][i])
        i = i + 1
    result

fn er_events_by_type(er: dict, event_type: string) -> list
    let result = []
    let i = 0
    while i < len(er["events"])
        if er["events"][i]["type"] == event_type
            push(result, er["events"][i])
        i = i + 1
    result

fn er_last_seq(er: dict) -> int
    let n = len(er["events"])
    if n == 0
        return 0
    er["events"][n - 1]["seq"]

fn er_save_snapshot(er: dict, name: string, state: dict) -> dict
    let snap = {}
    snap["state"] = state
    snap["at_seq"] = er_last_seq(er)
    er["snapshots"][name] = snap
    er

fn er_load_snapshot(er: dict, name: string) -> dict
    let has = contains(er["snapshots"], name)
    if has != true
        let empty = {}
        empty["at_seq"] = 0
        return empty
    er["snapshots"][name]

fn er_set_projection(er: dict, name: string, value: any) -> dict
    er["projections"][name] = value
    er

fn er_get_projection(er: dict, name: string) -> any
    let has = contains(er["projections"], name)
    if has != true
        return 0
    er["projections"][name]

fn er_stream_names(er: dict) -> list
    let seen = {}
    let names = []
    let i = 0
    while i < len(er["events"])
        let s = er["events"][i]["stream"]
        let has = contains(seen, s)
        if has != true
            push(names, s)
            seen[s] = 1
        i = i + 1
    names
