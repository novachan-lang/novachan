// forge_event_replay — Event sourcing replay and projection.
// Store events, replay from offset, build projections.

fn er_new() -> dict
    {"events": [], "projections": {}, "snapshots": {}}

fn er_append(er: dict, stream: string, event_type: string, data: dict) -> dict
    push(er["events"], {"stream": stream, "type": event_type, "data": data, "seq": len(er["events"]) + 1})
    er

fn er_event_count(er: dict) -> int
    len(er["events"])

fn er_events_for(er: dict, stream: string) -> list
    [er["events"][i] for i in 0..len(er["events"]) if er["events"][i]["stream"] == stream]

fn er_events_since(er: dict, seq: int) -> list
    [er["events"][i] for i in 0..len(er["events"]) if er["events"][i]["seq"] > seq]

fn er_events_by_type(er: dict, event_type: string) -> list
    [er["events"][i] for i in 0..len(er["events"]) if er["events"][i]["type"] == event_type]

fn er_last_seq(er: dict) -> int
    let n = len(er["events"])
    if n == 0
        return 0
    er["events"][n - 1]["seq"]

fn er_save_snapshot(er: dict, name: string, state: dict) -> dict
    er["snapshots"][name] = {"state": state, "at_seq": er_last_seq(er)}
    er

fn er_load_snapshot(er: dict, name: string) -> dict
    if name not in er["snapshots"]
        return {"at_seq": 0}
    er["snapshots"][name]

fn er_set_projection(er: dict, name: string, value: any) -> dict
    er["projections"][name] = value
    er

fn er_get_projection(er: dict, name: string) -> any
    if name not in er["projections"]
        return 0
    er["projections"][name]

fn er_stream_names(er: dict) -> list
    let seen = {}
    let names = []
    for i in 0..len(er["events"])
        let s = er["events"][i]["stream"]
        if s not in seen
            push(names, s)
            seen[s] = 1
    names
