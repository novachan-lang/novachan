// forge_edge — Edge/IoT device framework.
// Device registry, telemetry, command dispatch, fleet management.

fn edge_fleet() -> dict
    let f = {}
    f["devices"] = {}
    f["commands"] = []
    f["telemetry"] = []
    f

fn edge_register(fleet: dict, id: string, device_type: string) -> dict
    let d = {}
    d["type"] = device_type
    d["status"] = "online"
    d["firmware"] = "1.0.0"
    d["tags"] = []
    d["last_seen"] = 0
    fleet["devices"][id] = d
    fleet

fn edge_set_status(fleet: dict, id: string, status: string) -> dict
    let has_dev = contains(fleet["devices"], id)
    if has_dev == true
        fleet["devices"][id]["status"] = status
    fleet

fn edge_tag(fleet: dict, id: string, tag: string) -> dict
    let has_dev = contains(fleet["devices"], id)
    if has_dev == true
        push(fleet["devices"][id]["tags"], tag)
    fleet

fn edge_heartbeat(fleet: dict, id: string, ts: int) -> dict
    let has_dev = contains(fleet["devices"], id)
    if has_dev == true
        fleet["devices"][id]["last_seen"] = ts
        fleet["devices"][id]["status"] = "online"
    fleet

fn edge_send_command(fleet: dict, device_id: string, cmd: string, payload: any) -> dict
    let c = {}
    c["device"] = device_id
    c["command"] = cmd
    c["payload"] = payload
    c["status"] = "pending"
    push(fleet["commands"], c)
    fleet

fn edge_report_telemetry(fleet: dict, device_id: string, metric: string, value: any) -> dict
    let t = {}
    t["device"] = device_id
    t["metric"] = metric
    t["value"] = value
    push(fleet["telemetry"], t)
    fleet

fn edge_get_telemetry(fleet: dict, device_id: string) -> list
    let result = []
    let i = 0
    while i < len(fleet["telemetry"])
        if fleet["telemetry"][i]["device"] == device_id
            push(result, fleet["telemetry"][i])
        i += 1
    result

fn edge_online_devices(fleet: dict) -> list
    let result = []
    let ids = keys(fleet["devices"])
    for i in 0..len(ids)
        let d = fleet["devices"][ids[i]]
        if d["status"] == "online"
            push(result, ids[i])
    result

fn edge_offline_devices(fleet: dict) -> list
    let result = []
    let ids = keys(fleet["devices"])
    for i in 0..len(ids)
        let d = fleet["devices"][ids[i]]
        if d["status"] != "online"
            push(result, ids[i])
    result

fn edge_set_firmware(fleet: dict, id: string, version: string) -> dict
    let has_dev = contains(fleet["devices"], id)
    if has_dev == true
        fleet["devices"][id]["firmware"] = version
    fleet

fn edge_device_count(fleet: dict) -> int
    len(keys(fleet["devices"]))
