// forge_audit_logger — Tamper-evident audit log.

fn al_new() -> dict
    let a = {}
    a["entries"] = {}
    a["entry_count"] = 0
    a["hash_chain"] = 0
    a

fn al_log(a: dict, actor: string, action: string, resource: string, timestamp: int) -> dict
    let k = str(a["entry_count"])
    a["entries"][k + "_actor"] = actor
    a["entries"][k + "_action"] = action
    a["entries"][k + "_resource"] = resource
    a["entries"][k + "_timestamp"] = timestamp
    let h = a["hash_chain"] * 31 + timestamp + len(actor) * 7 + len(action) * 13
    if h < 0
        h = 0 - h
    a["hash_chain"] = h
    a["entries"][k + "_hash"] = h
    a["entry_count"] = a["entry_count"] + 1
    a

fn al_entry_actor(a: dict, idx: int) -> string
    a["entries"][str(idx) + "_actor"]

fn al_entry_action(a: dict, idx: int) -> string
    a["entries"][str(idx) + "_action"]

fn al_entry_resource(a: dict, idx: int) -> string
    a["entries"][str(idx) + "_resource"]

fn al_entry_count(a: dict) -> int
    a["entry_count"]

fn al_verify_chain(a: dict) -> int
    let h = 0
    let i = 0
    while i < a["entry_count"]
        let k = str(i)
        let ts = a["entries"][k + "_timestamp"]
        let actor = a["entries"][k + "_actor"]
        let action = a["entries"][k + "_action"]
        h = h * 31 + ts + len(actor) * 7 + len(action) * 13
        if h < 0
            h = 0 - h
        if h != a["entries"][k + "_hash"]
            return 0
        i = i + 1
    1

fn al_current_hash(a: dict) -> int
    a["hash_chain"]
