// forge_sudoku -- thin wrapper over std/game/sudoku (canonical implementation).
import std/game/sudoku

fn _su_can(flat: list, row: int, col: int, v: int) -> bool
    let ok = true
    for i in 0..9
        if flat[row * 9 + i] == v
            ok = false
        if flat[i * 9 + col] == v
            ok = false
    let br = (row / 3) * 3
    let bc = (col / 3) * 3
    for r in 0..3
        for c in 0..3
            if flat[(br + r) * 9 + (bc + c)] == v
                ok = false
    ok

// PRIVATE: recursive backtracking solve on the flat-81 board; returns 1 if solved.

fn sudoku_valid(board: list) -> bool
    let flat = []
    for r in 0..9
        for c in 0..9
            push(flat, board[r][c])
    let ok = true
    for idx in 0..81
        let v = flat[idx]
        if v != 0
            let row = idx / 9
            let col = idx % 9
            flat[idx] = 0
            if not _su_can(flat, row, col, v)
                ok = false
            flat[idx] = v
    ok

// Solve `board` (9x9, 0 = blank). Returns the completed 9x9 grid, or an empty list if unsolvable.

fn sudoku_solve(board: list) -> list
    return sudoku_solve(board)

fn sudoku_is_complete(board: list) -> bool
    let full = true
    for r in 0..9
        for c in 0..9
            if board[r][c] == 0
                full = false
    let out = false
    if full and sudoku_valid(board)
        out = true
    out

