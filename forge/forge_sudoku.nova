// forge_sudoku -- validate and SOLVE 9x9 Sudoku puzzles. Sudoku is the friendly face of a hard problem (exact
// cover / constraint satisfaction), and the solver here is the same BACKTRACKING engine as N-Queens: find the next
// empty cell, try each digit 1-9 that doesn't already appear in its row, column, or 3x3 box, recurse, and undo the
// moment a choice leads to a dead end. Because every placement is checked against three constraints and impossible
// branches are abandoned immediately, it races through the search space that a brute-force 9^81 enumeration could
// never touch. sudoku_valid checks whether a (possibly partial) board breaks any rule; sudoku_solve fills it in
// completely, returning the solved grid or an empty list if the puzzle has no solution. Beyond the pastime this is
// a compact, self-contained demonstration of constraint propagation and search that transfers directly to
// scheduling, timetabling, and packing problems. The board is a 9x9 grid of ints with 0 for blanks. LEAF.

// PRIVATE: can digit v go at (row, col) of the flat-81 board without breaking a row/column/box constraint?
fn _su_can(flat: list, row: int, col: int, v: int) -> bool
    let ok = true
    for i in 0..9
        if flat[row * 9 + i] == v
            ok = false
        if flat[i * 9 + col] == v
            ok = false
    let br = (row / 3) * 3
    let bc = (col / 3) * 3
    for r in 0..3
        let c = 0
        while c < 3
            if flat[(br + r) * 9 + (bc + c)] == v
                ok = false
            c += 1
    ok

// PRIVATE: recursive backtracking solve on the flat-81 board; returns 1 if solved.
fn _su_solve(flat: list) -> int
    // find the first empty cell
    let idx = 0 - 1
    let i = 0
    while i < 81 and idx < 0
        if flat[i] == 0
            idx = i
        i += 1
    let out = 1
    if idx >= 0
        out = 0
        let row = idx / 9
        let col = idx % 9
        let v = 1
        while v <= 9 and out == 0
            if _su_can(flat, row, col, v)
                flat[idx] = v
                if _su_solve(flat) == 1
                    out = 1
                else
                    flat[idx] = 0
            v += 1
    out

// True if `board` (9x9, 0 = blank) currently breaks no Sudoku rule (duplicates among filled cells only).
fn sudoku_valid(board: list) -> bool
    let flat = []
    for r in 0..9
        let c = 0
        while c < 9
            push(flat, board[r][c])
            c += 1
    let ok = true
    for idx in 0..81
        let v = flat[idx]
        if v != 0
            let row = idx / 9
            let col = idx % 9
            flat[idx] = 0
            if _su_can(flat, row, col, v) == false
                ok = false
            flat[idx] = v
    ok

// Solve `board` (9x9, 0 = blank). Returns the completed 9x9 grid, or an empty list if unsolvable.
fn sudoku_solve(board: list) -> list
    let flat = []
    for r in 0..9
        let c = 0
        while c < 9
            push(flat, board[r][c])
            c += 1
    let out = []
    if _su_solve(flat) == 1
        let a = 0
        while a < 9
            let row = [flat[a * 9 + b] for b in 0..9]
            push(out, row)
            a += 1
    out

// True if a 9x9 board is completely filled (no zeros) and valid.
fn sudoku_is_complete(board: list) -> bool
    let full = true
    for r in 0..9
        let c = 0
        while c < 9
            if board[r][c] == 0
                full = false
            c += 1
    let out = false
    if full and sudoku_valid(board)
        out = true
    out
