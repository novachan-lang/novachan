// forge_dns_resolver — DNS resolution cache/helper.
// Local DNS cache with TTL, round-robin, health tracking.

fn dns_new() -> dict
    let d = {}
    d["records"] = {}
    d["queries"] = 0
    d["hits"] = 0
    d["misses"] = 0
    d

fn dns_add_record(d: dict, hostname: string, ip: string, ttl: int, added_at: int) -> dict
    let has = contains(d["records"], hostname)
    let entries = []
    if has == true
        entries = d["records"][hostname]
    let rec = {}
    rec["ip"] = ip
    rec["ttl"] = ttl
    rec["added_at"] = added_at
    rec["healthy"] = 1
    push(entries, rec)
    d["records"][hostname] = entries
    d

fn dns_resolve(d: dict, hostname: string, now: int) -> dict
    d["queries"] = d["queries"] + 1
    let has = contains(d["records"], hostname)
    if has != true
        d["misses"] = d["misses"] + 1
        let r = {}
        r["dns"] = d
        r["ip"] = ""
        r["found"] = 0
        return r
    let entries = d["records"][hostname]
    for i in 0..len(entries)
        let e = entries[i]
        let age = now - e["added_at"]
        if age <= e["ttl"]
            if e["healthy"] == 1
                d["hits"] = d["hits"] + 1
                let r = {}
                r["dns"] = d
                r["ip"] = e["ip"]
                r["found"] = 1
                return r
    d["misses"] = d["misses"] + 1
    let r = {}
    r["dns"] = d
    r["ip"] = ""
    r["found"] = 0
    r

fn dns_resolve_all(d: dict, hostname: string, now: int) -> list
    let has = contains(d["records"], hostname)
    if has != true
        return []
    let entries = d["records"][hostname]
    let result = []
    for i in 0..len(entries)
        let e = entries[i]
        let age = now - e["added_at"]
        if age <= e["ttl"]
            if e["healthy"] == 1
                push(result, e["ip"])
    result

fn dns_set_health(d: dict, hostname: string, ip: string, healthy: int) -> dict
    let has = contains(d["records"], hostname)
    if has != true
        return d
    let entries = d["records"][hostname]
    for i in 0..len(entries)
        if entries[i]["ip"] == ip
            entries[i]["healthy"] = healthy
    d

fn dns_stats(d: dict) -> dict
    let s = {}
    s["queries"] = d["queries"]
    s["hits"] = d["hits"]
    s["misses"] = d["misses"]
    s

fn dns_host_count(d: dict) -> int
    len(keys(d["records"]))
