// forge_schema_registry — Schema registry for data contracts.
// Register schemas with versions, check compatibility, lookup.

fn sr_new() -> dict
    {"schemas": {}}

fn sr_register(sr: dict, subject: string, version: int, schema_def: string) -> dict
    if subject not in sr["schemas"]
        sr["schemas"][subject] = []
    push(sr["schemas"][subject], {"version": version, "schema": schema_def, "deprecated": 0})
    sr

fn sr_get_latest(sr: dict, subject: string) -> dict
    if subject not in sr["schemas"] or len(sr["schemas"][subject]) == 0
        return {"version": 0, "schema": ""}
    let versions = sr["schemas"][subject]
    versions[len(versions) - 1]

fn sr_get_version(sr: dict, subject: string, version: int) -> string
    if subject not in sr["schemas"]
        return ""
    let versions = sr["schemas"][subject]
    for i in 0..len(versions)
        if versions[i]["version"] == version
            return versions[i]["schema"]
    ""

fn sr_deprecate(sr: dict, subject: string, version: int) -> dict
    if subject not in sr["schemas"]
        return sr
    let versions = sr["schemas"][subject]
    for i in 0..len(versions)
        if versions[i]["version"] == version
            sr["schemas"][subject][i]["deprecated"] = 1
            return sr
    sr

fn sr_subject_count(sr: dict) -> int
    len(keys(sr["schemas"]))

fn sr_version_count(sr: dict, subject: string) -> int
    if subject not in sr["schemas"]
        return 0
    len(sr["schemas"][subject])

fn sr_subjects(sr: dict) -> list
    keys(sr["schemas"])
