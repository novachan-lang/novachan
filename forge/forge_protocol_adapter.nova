fn pa_new()
    {"adapter_count": 0, "transform_count": 0, "message_count": 0, "error_count": 0}

fn pa_register(state, adapter_name, source_proto, target_proto)
    let idx = state["adapter_count"]
    let ik = str(idx)
    state["a_{ik}_name"] = adapter_name
    state["a_{ik}_src"] = source_proto
    state["a_{ik}_tgt"] = target_proto
    state["a_{ik}_msgs"] = 0
    state["a_{ik}_errs"] = 0
    state["a_{adapter_name}_idx"] = idx
    state["adapter_count"] += 1
    return state

fn _pa_find(state, adapter_name)
    let ikey = "a_{adapter_name}_idx"
    if ikey not in state
        return -1
    return state[ikey]

fn pa_transform(state, adapter_name, message)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter: {adapter_name}")
    let ik = str(idx)
    let tgt = state["a_{ik}_tgt"]
    let result = "[" + tgt + "]" + message
    let mk = "a_{ik}_msgs"
    state[mk] += 1
    state["message_count"] += 1
    state["transform_count"] += 1
    state["last_result"] = result
    return ok(state)

fn pa_last_result(state)
    if "last_result" not in state
        return err("no transforms yet")
    return ok(state["last_result"])

fn pa_record_error(state, adapter_name, error_msg)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    let ik = str(idx)
    let ek = "a_{ik}_errs"
    state[ek] += 1
    state["error_count"] += 1
    return ok(state)

fn pa_adapter_count(state)
    return state["adapter_count"]

fn pa_message_count(state)
    return state["message_count"]

fn pa_error_count(state)
    return state["error_count"]

fn pa_transform_count(state)
    return state["transform_count"]

fn pa_adapter_messages(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    let ik = str(idx)
    return ok(state["a_{ik}_msgs"])

fn pa_adapter_errors(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    let ik = str(idx)
    return ok(state["a_{ik}_errs"])

fn pa_source_proto(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    let ik = str(idx)
    return ok(state["a_{ik}_src"])

fn pa_target_proto(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    let ik = str(idx)
    return ok(state["a_{ik}_tgt"])
