fn pa_new()
    let state = {}
    state["adapter_count"] = 0
    state["transform_count"] = 0
    state["message_count"] = 0
    state["error_count"] = 0
    return state

fn pa_register(state, adapter_name, source_proto, target_proto)
    let idx = state["adapter_count"]
    state["a_" + str(idx) + "_name"] = adapter_name
    state["a_" + str(idx) + "_src"] = source_proto
    state["a_" + str(idx) + "_tgt"] = target_proto
    state["a_" + str(idx) + "_msgs"] = 0
    state["a_" + str(idx) + "_errs"] = 0
    state["a_" + adapter_name + "_idx"] = idx
    state["adapter_count"] = idx + 1
    return state

fn _pa_find(state, adapter_name)
    let ikey = "a_" + adapter_name + "_idx"
    if contains(state, ikey) != true
        return -1
    return state[ikey]

fn pa_transform(state, adapter_name, message)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter: " + adapter_name)
    let src = state["a_" + str(idx) + "_src"]
    let tgt = state["a_" + str(idx) + "_tgt"]
    let result = "[" + tgt + "]" + message
    state["a_" + str(idx) + "_msgs"] = state["a_" + str(idx) + "_msgs"] + 1
    state["message_count"] = state["message_count"] + 1
    state["transform_count"] = state["transform_count"] + 1
    state["last_result"] = result
    return ok(state)

fn pa_last_result(state)
    if contains(state, "last_result") != true
        return err("no transforms yet")
    return ok(state["last_result"])

fn pa_record_error(state, adapter_name, error_msg)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    state["a_" + str(idx) + "_errs"] = state["a_" + str(idx) + "_errs"] + 1
    state["error_count"] = state["error_count"] + 1
    return ok(state)

fn pa_adapter_count(state)
    return state["adapter_count"]

fn pa_message_count(state)
    return state["message_count"]

fn pa_error_count(state)
    return state["error_count"]

fn pa_transform_count(state)
    return state["transform_count"]

fn pa_adapter_messages(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    return ok(state["a_" + str(idx) + "_msgs"])

fn pa_adapter_errors(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    return ok(state["a_" + str(idx) + "_errs"])

fn pa_source_proto(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    return ok(state["a_" + str(idx) + "_src"])

fn pa_target_proto(state, adapter_name)
    let idx = _pa_find(state, adapter_name)
    if idx < 0
        return err("unknown adapter")
    return ok(state["a_" + str(idx) + "_tgt"])
