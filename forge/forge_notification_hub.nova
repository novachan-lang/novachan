// forge_notification_hub — Multi-channel notification dispatch with Result.

fn nh_new() -> dict
    {"channels": {}, "chan_count": 0, "sent": {}, "sent_count": 0, "failed": 0}

fn nh_add_channel(n: dict, name: string, channel_type: string) -> dict
    n["channels"][name] = channel_type
    n["chan_count"] += 1
    n

fn nh_send(n: dict, channel: string, recipient: string, message: string) -> Result
    if channel not in n["channels"]
        return err("unknown channel: {channel}")
    let k = str(n["sent_count"])
    n["sent"]["{k}_channel"] = channel
    n["sent"]["{k}_recipient"] = recipient
    n["sent"]["{k}_message"] = message
    n["sent_count"] += 1
    ok(n)

fn nh_broadcast(n: dict, message: string, recipient: string) -> dict
    let ks = keys(n["channels"])
    for i in 0..len(ks)
        let r = nh_send(n, ks[i], recipient, message)
        if is_ok(r)
            n = unwrap(r)
    n

fn nh_sent_count(n: dict) -> int
    n["sent_count"]

fn nh_channel_count(n: dict) -> int
    n["chan_count"]

fn nh_last_channel(n: dict) -> Result
    if n["sent_count"] == 0
        return err("no messages sent")
    let k = str(n["sent_count"] - 1)
    ok(n["sent"]["{k}_channel"])

fn nh_last_recipient(n: dict) -> Result
    if n["sent_count"] == 0
        return err("no messages sent")
    let k = str(n["sent_count"] - 1)
    ok(n["sent"]["{k}_recipient"])
