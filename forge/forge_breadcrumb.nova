// forge_breadcrumb -- build navigation breadcrumbs from a URL path ("/shop/nike-air" -> Home > Shop > Nike Air
// with cumulative URLs). For page navigation UIs and feeding the JSON-LD BreadcrumbList (forge_jsonld). Each
// item is [label, url]; a "Home" -> "/" crumb is prepended. LEAF -- imports NOTHING.

fn _bc_label(seg: string) -> string
    let out_parts = []
    let cap = true
    for i in 0..len(seg)
        let c = char_at(seg, i)
        if c == "-" or c == "_"
            push(out_parts, " ")
            cap = true
        else
            if cap
                push(out_parts, upper(c))
                cap = false
            else
                push(out_parts, c)
    let out = join(out_parts, "")
    out

// Breadcrumb items [label, url] for a path. Segments become title-cased labels with cumulative URLs; "Home"
// is prepended.
fn breadcrumbs(path: string) -> list
    let out = []
    let home = []
    push(home, "Home")
    push(home, "/")
    push(out, home)
    let p = path
    while len(p) > 0 and char_at(p, 0) == "/"
        p = slice(p, 1, len(p))
    while len(p) > 0 and char_at(p, len(p) - 1) == "/"
        p = slice(p, 0, len(p) - 1)
    if len(p) == 0
        return out
    let segs = split(p, "/")
    let acc = ""
    for i in 0..len(segs)
        acc += "/" + segs[i]
        let item = []
        push(item, _bc_label(segs[i]))
        push(item, acc)
        push(out, item)
    out
