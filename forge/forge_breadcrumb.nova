// forge_breadcrumb -- build navigation breadcrumbs from a URL path. LEAF -- imports NOTHING.

fn _bc_label(seg: string) -> string
    let out_parts = []
    let cap = true
    for i in 0..len(seg)
        let c = char_at(seg, i)
        if c == "-" or c == "_"
            push(out_parts, " ")
            cap = true
        else if cap
            push(out_parts, upper(c))
            cap = false
        else
            push(out_parts, c)
    join(out_parts, "")

fn breadcrumbs(path: string) -> list
    let out = [["Home", "/"]]
    let p = path
    while len(p) > 0 and char_at(p, 0) == "/"
        p = slice(p, 1, len(p))
    while len(p) > 0 and char_at(p, len(p) - 1) == "/"
        p = slice(p, 0, len(p) - 1)
    if len(p) == 0
        return out
    let segs = split(p, "/")
    let acc = ""
    for seg in segs
        acc += "/{seg}"
        push(out, [_bc_label(seg), acc])
    out
