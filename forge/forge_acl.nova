// forge_acl -- an ordered access-control list: allow/deny rules matched against a "permission:resource" action
// string with GLOB wildcards, FIRST-MATCH-WINS (the model AWS IAM, firewalls, and .htaccess use). Complements
// forge_rbac (coarse roles) with fine-grained resource patterns. Default-deny when no rule matches. Composes
// forge_wildcard. Imports forge_wildcard.
import forge_wildcard

fn acl_new() -> dict
    let a = {}
    a["rules"] = []
    a

// Append an ALLOW rule (glob like "read:posts/*"). Order matters -- put specific denies BEFORE broad allows.
fn acl_allow(a: dict, pattern: string) -> dict
    push(a["rules"], ["allow", pattern])
    a

// Append a DENY rule. Fluent.
fn acl_deny(a: dict, pattern: string) -> dict
    push(a["rules"], ["deny", pattern])
    a

// Evaluate `action` against the rules in order; the FIRST matching rule decides. No match -> denied (default-deny).
fn acl_check(a: dict, action: string) -> bool
    let rules = a["rules"]
    for i in 0..len(rules)
        let rule = rules[i]
        if wildcard_match(rule[1], action)
            return rule[0] == "allow"
    false
