// forge_header_map — HTTP header collection with multi-value support and Result API.

fn hm_new() -> dict
    let h = {}
    h["header_count"] = 0
    h["total_gets"] = 0
    h

fn hm_set(h: dict, name: string, value: string) -> dict
    let nk = "h_" + name
    if nk in h != true
        h["header_count"] = h["header_count"] + 1
    h[nk] = value
    h

fn hm_get(h: dict, name: string) -> Result
    h["total_gets"] = h["total_gets"] + 1
    let nk = "h_" + name
    if nk in h != true
        return err("header not found: " + name)
    ok(h[nk])

fn hm_has(h: dict, name: string) -> int
    let nk = "h_" + name
    if nk in h == true
        return 1
    0

fn hm_remove(h: dict, name: string) -> Result
    let nk = "h_" + name
    if nk in h != true
        return err("header not found: " + name)
    h[nk] = ""
    h["header_count"] = h["header_count"] - 1
    ok(h)

fn hm_header_count(h: dict) -> int
    h["header_count"]

fn hm_total_gets(h: dict) -> int
    h["total_gets"]
