// forge_feature_experiment — A/B experiment tracking with variant assignment.

fn exp_new(name: string, variant_count: int) -> dict
    let e = {"name": name, "variant_count": variant_count, "assignments": {}, "conversions": {}, "total_assigned": 0, "active": 1}
    for i in 0..variant_count
        e["conversions"][str(i)] = 0
    e

fn exp_assign(e: dict, user_id: string, variant: int) -> dict
    if e["active"] == 0
        return e
    if variant < 0
        return e
    if variant >= e["variant_count"]
        return e
    e["assignments"][user_id] = variant
    e["total_assigned"] += 1
    e

fn exp_get_variant(e: dict, user_id: string) -> int
    if user_id not in e["assignments"]
        return -1
    e["assignments"][user_id]

fn exp_convert(e: dict, user_id: string) -> dict
    if user_id not in e["assignments"]
        return e
    let v = e["assignments"][user_id]
    e["conversions"][str(v)] += 1
    e

fn exp_conversion_count(e: dict, variant: int) -> int
    if variant < 0
        return 0
    if variant >= e["variant_count"]
        return 0
    e["conversions"][str(variant)]

fn exp_total_assigned(e: dict) -> int
    e["total_assigned"]

fn exp_stop(e: dict) -> dict
    e["active"] = 0
    e

fn exp_is_active(e: dict) -> int
    e["active"]

fn exp_name(e: dict) -> string
    e["name"]
