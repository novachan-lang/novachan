// forge_anti_entropy -- anti-entropy protocol for data repair: compare data between replicas, detect
// divergence, and repair by copying the source's version of a key to the target. The shape a Merkle-tree
// or hash-ring anti-entropy pass has -- scan two replicas, return the keys that differ, then repair them
// one at a time. State is a flat dict of replicas, each a dict of keys to {value, version} entries.
// LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. ae_new built the state dict as three individual assignments to `{}`. Dict literal.
//   2. ae_set_key built the entry dict as two individual assignments. Dict literal.
//   3. EVERY replica-existence check was `let has = contains(ae["replicas"], x); if has != true` --
//      a boolean bound to a variable, compared against `true` with `!=`, and never used again.
//      `not in` is that.
//   4. ae_compare iterated `for i in 0..len(a_keys); let k = a_keys[i]` -- an index loop over a list
//      that is only used to get the element. `for k in keys(...)` directly, or a comprehension where
//      the body is a single push-if-condition.
//   5. `ae["repairs"] = ae["repairs"] + 1` at two sites -- compound assignment.

fn ae_new() -> dict
    {"replicas": {}, "repairs": 0, "scans": 0}

fn ae_add_replica(ae: dict, name: string) -> dict
    ae["replicas"][name] = {}
    ae

fn ae_set_key(ae: dict, replica: string, key: string, value: string, version: int) -> dict
    if replica not in ae["replicas"]
        return ae
    ae["replicas"][replica][key] = {"value": value, "version": version}
    ae

fn ae_compare(ae: dict, replica_a: string, replica_b: string) -> list
    if replica_a not in ae["replicas"]
        return []
    if replica_b not in ae["replicas"]
        return []
    ae["scans"] += 1
    let a_data = ae["replicas"][replica_a]
    let b_data = ae["replicas"][replica_b]
    let a_diffs = [k for k in keys(a_data) if k not in b_data or a_data[k]["version"] != b_data[k]["version"]]
    let b_only = [k for k in keys(b_data) if k not in a_data]
    [...a_diffs, ...b_only]

fn ae_repair(ae: dict, source: string, target: string, key: string) -> dict
    if source not in ae["replicas"]
        return ae
    if target not in ae["replicas"]
        return ae
    if key not in ae["replicas"][source]
        return ae
    ae["replicas"][target][key] = ae["replicas"][source][key]
    ae["repairs"] += 1
    ae

fn ae_total_repairs(ae: dict) -> int
    ae["repairs"]

fn ae_total_scans(ae: dict) -> int
    ae["scans"]

fn ae_replica_count(ae: dict) -> int
    len(keys(ae["replicas"]))

fn ae_key_count(ae: dict, replica: string) -> int
    if replica not in ae["replicas"]
        return 0
    len(keys(ae["replicas"][replica]))
