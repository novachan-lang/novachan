// forge_anti_entropy — Anti-entropy protocol for data repair.
// Compare data between replicas, detect and repair divergence.

fn ae_new() -> dict
    let ae = {}
    ae["replicas"] = {}
    ae["repairs"] = 0
    ae["scans"] = 0
    ae

fn ae_add_replica(ae: dict, name: string) -> dict
    ae["replicas"][name] = {}
    ae

fn ae_set_key(ae: dict, replica: string, key: string, value: string, version: int) -> dict
    let has = contains(ae["replicas"], replica)
    if has != true
        return ae
    let entry = {}
    entry["value"] = value
    entry["version"] = version
    ae["replicas"][replica][key] = entry
    ae

fn ae_compare(ae: dict, replica_a: string, replica_b: string) -> list
    let diffs = []
    let has_a = contains(ae["replicas"], replica_a)
    let has_b = contains(ae["replicas"], replica_b)
    if has_a != true
        return diffs
    if has_b != true
        return diffs
    ae["scans"] = ae["scans"] + 1
    let a_keys = keys(ae["replicas"][replica_a])
    for i in 0..len(a_keys)
        let k = a_keys[i]
        let has_k = contains(ae["replicas"][replica_b], k)
        if has_k != true
            push(diffs, k)
        else
            if ae["replicas"][replica_a][k]["version"] != ae["replicas"][replica_b][k]["version"]
                push(diffs, k)
    let b_keys = keys(ae["replicas"][replica_b])
    for j in 0..len(b_keys)
        let k = b_keys[j]
        let has_k = contains(ae["replicas"][replica_a], k)
        if has_k != true
            push(diffs, k)
    diffs

fn ae_repair(ae: dict, source: string, target: string, key: string) -> dict
    let has_s = contains(ae["replicas"], source)
    let has_t = contains(ae["replicas"], target)
    if has_s != true
        return ae
    if has_t != true
        return ae
    let has_k = contains(ae["replicas"][source], key)
    if has_k != true
        return ae
    ae["replicas"][target][key] = ae["replicas"][source][key]
    ae["repairs"] = ae["repairs"] + 1
    ae

fn ae_total_repairs(ae: dict) -> int
    ae["repairs"]

fn ae_total_scans(ae: dict) -> int
    ae["scans"]

fn ae_replica_count(ae: dict) -> int
    len(keys(ae["replicas"]))

fn ae_key_count(ae: dict, replica: string) -> int
    let has = contains(ae["replicas"], replica)
    if has != true
        return 0
    len(keys(ae["replicas"][replica]))
