// forge_paxos_basic — Basic single-decree Paxos consensus.
// Proposer/acceptor/learner roles for a single agreed value.

fn paxos_new(node_count: int) -> dict
    {"node_count": node_count, "majority": node_count / 2 + 1, "proposal_num": 0, "highest_promised": 0, "accepted_num": 0, "accepted_val": "", "decided": 0, "decided_val": "", "promises": 0, "accepts": 0}

fn paxos_prepare(p: dict, proposal_num: int) -> dict
    let result = {}
    if proposal_num > p["highest_promised"]
        p["highest_promised"] = proposal_num
        p["proposal_num"] = proposal_num
        p["promises"] = 0
        result = {"ok": 1, "accepted_num": p["accepted_num"], "accepted_val": p["accepted_val"]}
    else
        result = {"ok": 0, "accepted_num": 0, "accepted_val": ""}
    result["p"] = p
    result

fn paxos_promise(p: dict) -> dict
    p["promises"] += 1
    p

fn paxos_has_quorum_promise(p: dict) -> int
    1 if p["promises"] >= p["majority"] else 0

fn paxos_accept(p: dict, proposal_num: int, value: string) -> dict
    let result = {}
    if proposal_num >= p["highest_promised"]
        p["accepted_num"] = proposal_num
        p["accepted_val"] = value
        p["highest_promised"] = proposal_num
        result = {"ok": 1}
    else
        result = {"ok": 0}
    result["p"] = p
    result

fn paxos_accepted(p: dict) -> dict
    p["accepts"] += 1
    if p["accepts"] >= p["majority"]
        p["decided"] = 1
        p["decided_val"] = p["accepted_val"]
    p

fn paxos_is_decided(p: dict) -> int
    p["decided"]

fn paxos_decided_value(p: dict) -> string
    p["decided_val"]

fn paxos_promise_count(p: dict) -> int
    p["promises"]

fn paxos_accept_count(p: dict) -> int
    p["accepts"]
