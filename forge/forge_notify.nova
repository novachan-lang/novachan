// forge_notify -- multi-channel notifications (Laravel Notifications / Rails ActionMailer+Notifications).
// Register channel senders (email/sms/push/slack); send a notification through one channel or broadcast to
// all. A sender is fn(recipient, subject, body) -> any (a Result). Decouples "notify the user" from HOW.
// LEAF -- imports NOTHING (err/contains/keys builtins).

fn notify_new() -> dict
    let n = {}
    n["channels"] = {}
    n

// Register a channel sender (e.g. "email" -> a fn using forge SMTP; "sms" -> a fn using an SMS API). Fluent.
fn notify_channel(notif: dict, name: string, sender) -> dict
    let ch = notif["channels"]
    ch[name] = sender
    notif

// Send via ONE channel. err(...) if the channel isn't registered.
fn notify_send(notif: dict, channel: string, recipient: string, subject: string, body: string) -> any
    let ch = notif["channels"]
    if channel in ch == false
        return err("no channel: " + channel)
    let s = ch[channel]
    s(recipient, subject, body)

// Send via ALL registered channels (fan-out). Returns how many channels were used.
fn notify_broadcast(notif: dict, recipient: string, subject: string, body: string) -> int
    let ch = notif["channels"]
    let sent = 0
    for k in keys(ch)
        let s = ch[k]
        s(recipient, subject, body)
        sent += 1
    sent
