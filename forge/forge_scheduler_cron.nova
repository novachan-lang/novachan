fn sc_new()
    {"job_count": 0, "job_names": "", "total_runs": 0}

fn sc_add_job(s, job_name, interval_seconds)
    let idx = int(s["job_count"])
    s["job_" + str(idx) + "_name"] = job_name
    s["job_" + str(idx) + "_interval"] = interval_seconds
    s["job_" + str(idx) + "_last_run"] = 0
    s["job_" + str(idx) + "_run_count"] = 0
    s["job_" + str(idx) + "_enabled"] = 1
    s["job_count"] = idx + 1
    s["job_names"] = job_name if s["job_names"] == "" else str(s["job_names"]) + "," + job_name
    return s

fn _sc_find_job(s, job_name)
    let cnt = int(s["job_count"])
    for i in 0..cnt
        if str(s["job_" + str(i) + "_name"]) == job_name
            return i
    return -1

fn sc_tick(s, current_time) -> Result
    let cnt = int(s["job_count"])
    let ran = ""
    for i in 0..cnt
        if int(s["job_" + str(i) + "_enabled"]) == 1
            let last = int(s["job_" + str(i) + "_last_run"])
            let interval = int(s["job_" + str(i) + "_interval"])
            if current_time - last >= interval
                s["job_" + str(i) + "_last_run"] = current_time
                s["job_" + str(i) + "_run_count"] = int(s["job_" + str(i) + "_run_count"]) + 1
                s["total_runs"] = int(s["total_runs"]) + 1
                let jname = str(s["job_" + str(i) + "_name"])
                ran = jname if ran == "" else ran + "," + jname
    if ran == ""
        return ok(s)
    s["last_ran"] = ran
    return ok(s)

fn sc_disable(s, job_name) -> Result
    let ji = _sc_find_job(s, job_name)
    if ji < 0
        return err("job not found: {job_name}")
    s["job_" + str(ji) + "_enabled"] = 0
    return ok(s)

fn sc_enable(s, job_name) -> Result
    let ji = _sc_find_job(s, job_name)
    if ji < 0
        return err("job not found: {job_name}")
    s["job_" + str(ji) + "_enabled"] = 1
    return ok(s)

fn sc_run_count(s, job_name) -> Result
    let ji = _sc_find_job(s, job_name)
    if ji < 0
        return err("job not found: {job_name}")
    return ok(int(s["job_" + str(ji) + "_run_count"]))

fn sc_last_run(s, job_name) -> Result
    let ji = _sc_find_job(s, job_name)
    if ji < 0
        return err("job not found: {job_name}")
    return ok(int(s["job_" + str(ji) + "_last_run"]))

fn sc_job_count(s)
    return int(s["job_count"])

fn sc_total_runs(s)
    return int(s["total_runs"])

fn sc_job_list(s)
    return str(s["job_names"])

fn sc_is_enabled(s, job_name) -> Result
    let ji = _sc_find_job(s, job_name)
    if ji < 0
        return err("job not found: {job_name}")
    return ok(int(s["job_" + str(ji) + "_enabled"]))
