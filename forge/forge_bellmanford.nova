// forge_bellmanford -- the Bellman-Ford single-source shortest-path algorithm. Dijkstra (forge_dijkstra) is faster
// but breaks when edges can be NEGATIVE; Bellman-Ford handles negative weights and, crucially, DETECTS a negative
// cycle (a loop you could ride forever getting cheaper) instead of silently returning nonsense. It works by brute
// relaxation: a shortest path visits at most V-1 edges, so relaxing EVERY edge V-1 times is guaranteed to settle
// all distances; if a V-th pass still improves something, a negative cycle is reachable. This is the algorithm
// behind currency-arbitrage detection (a negative cycle in log-exchange-rates = free money), distance-vector
// routing (RIP), and any shortest-path problem with costs that can be gains. The graph is given as an edge list of
// [from, to, weight] triples over nodes 0..n-1. Returns the distance from the source to every node (bf_inf() =
// unreachable). LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. bellman_ford used `while pass < n-1`. for-in range.
//   2. bellman_ford / bf_has_negative_cycle used `for e in 0..len(edges)` + `let edge = edges[e]`. for-in.
//   3. bf_has_negative_cycle used a `let out = false; ... out = true; out` flag. Early return.
//   4. bf_reachable used a 4-line flag pattern. One-expression return.

fn bf_inf() -> int
    1000000000

fn bellman_ford(n: int, edges: list, source: int) -> list
    let INF = bf_inf()
    let dist = [INF for i in 0..n]
    dist[source] = 0
    for pass in 0..n - 1
        for edge in edges
            let u = edge[0]
            let v = edge[1]
            let w = edge[2]
            if dist[u] < INF and dist[u] + w < dist[v]
                dist[v] = dist[u] + w
    dist

fn bf_has_negative_cycle(n: int, edges: list, source: int) -> bool
    let dist = bellman_ford(n, edges, source)
    let INF = bf_inf()
    for edge in edges
        if dist[edge[0]] < INF and dist[edge[0]] + edge[2] < dist[edge[1]]
            return true
    false

fn bf_reachable(dist: list, v: int) -> bool
    dist[v] < bf_inf()
