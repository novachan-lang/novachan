// forge_bellmanford -- self-contained edge-list Bellman-Ford (see NOTE below).
//
// NOTE: std/graph/bellmanford is NOT imported here even though the algorithm is the
// same. std's public API (bf_shortest/bf_distance/bf_has_negative_cycle) takes an
// ADJACENCY-DICT graph (adj: dict node->edges, nodes: list of node names) while this
// module's public API takes an EDGE LIST ([u, v, w] triples) with integer node ids --
// the representations are incompatible, not just differently named. Both modules also
// define a function called `bf_has_negative_cycle` with the same arity; NOVA does not
// mangle symbols per module, so importing std here would collide at link time
// ("invalid redefinition of function"). Keeping this module self-contained avoids the
// collision without forcing either representation onto the other's callers.

fn bf_inf() -> int
    1000000000

fn bellman_ford(n: int, edges: list, source: int) -> list
    let INF = bf_inf()
    let dist = [INF for i in 0..n]
    dist[source] = 0
    for pass in 0..n - 1
        for edge in edges
            let u = edge[0]
            let v = edge[1]
            let w = edge[2]
            if dist[u] < INF and dist[u] + w < dist[v]
                dist[v] = dist[u] + w
    dist

fn bf_has_negative_cycle(n: int, edges: list, source: int) -> bool
    let INF = bf_inf()
    let dist = [INF for i in 0..n]
    dist[source] = 0
    for pass in 0..n - 1
        for edge in edges
            let u = edge[0]
            let v = edge[1]
            let w = edge[2]
            if dist[u] < INF and dist[u] + w < dist[v]
                dist[v] = dist[u] + w
    // One more relaxation pass: if any distance can still improve after |V|-1
    // passes already guaranteed convergence, a negative-weight cycle is reachable.
    let has_cycle = false
    for edge in edges
        let u = edge[0]
        let v = edge[1]
        let w = edge[2]
        if dist[u] < INF and dist[u] + w < dist[v]
            has_cycle = true
    has_cycle

fn bf_reachable(dist: list, v: int) -> bool
    dist[v] < bf_inf()

