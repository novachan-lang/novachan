// forge_bellmanford -- thin wrapper over std/graph/bellmanford (canonical implementation).
import std/graph/bellmanford

fn bf_inf() -> int
    1000000000

fn bellman_ford(n: int, edges: list, source: int) -> list
    let INF = bf_inf()
    let dist = [INF for i in 0..n]
    dist[source] = 0
    for pass in 0..n - 1
        for edge in edges
            let u = edge[0]
            let v = edge[1]
            let w = edge[2]
            if dist[u] < INF and dist[u] + w < dist[v]
                dist[v] = dist[u] + w
    dist

fn bf_has_negative_cycle(n: int, edges: list, source: int) -> bool
    return bf_has_negative_cycle(n, edges, source)

fn bf_reachable(dist: list, v: int) -> bool
    dist[v] < bf_inf()

