// forge_http_status -- HTTP status code -> standard reason phrase + category helpers (response building, API
// clients, logging, retry logic). status_reason(404) -> "Not Found"; status_category(503) -> "server_error";
// is_success / is_client_error / is_server_error / is_retryable. LEAF -- imports NOTHING.

fn _status_phrases() -> dict
    {
        "200": "OK", "201": "Created", "202": "Accepted", "204": "No Content", "206": "Partial Content",
        "301": "Moved Permanently", "302": "Found", "303": "See Other", "304": "Not Modified",
        "307": "Temporary Redirect", "308": "Permanent Redirect",
        "400": "Bad Request", "401": "Unauthorized", "403": "Forbidden", "404": "Not Found",
        "405": "Method Not Allowed", "409": "Conflict", "410": "Gone", "422": "Unprocessable Entity",
        "429": "Too Many Requests",
        "500": "Internal Server Error", "501": "Not Implemented", "502": "Bad Gateway",
        "503": "Service Unavailable", "504": "Gateway Timeout"
    }

// The standard reason phrase for a status code, or "" if unknown.
fn status_reason(code: int) -> string
    let m = _status_phrases()
    let k = str(code)
    m[k] if k in m else ""

// Category: "informational"/"success"/"redirect"/"client_error"/"server_error"/"unknown".
fn status_category(code: int) -> string
    if code >= 100 and code < 200
        return "informational"
    if code >= 200 and code < 300
        return "success"
    if code >= 300 and code < 400
        return "redirect"
    if code >= 400 and code < 500
        return "client_error"
    if code >= 500 and code < 600
        return "server_error"
    "unknown"

fn is_success(code: int) -> bool
    code >= 200 and code < 300

fn is_redirect(code: int) -> bool
    code >= 300 and code < 400

fn is_client_error(code: int) -> bool
    code >= 400 and code < 500

fn is_server_error(code: int) -> bool
    code >= 500 and code < 600

// Is this status worth retrying? 408 (timeout), 429 (rate limited), and 5xx (except 501).
fn is_retryable(code: int) -> bool
    if code == 408 or code == 429
        return true
    if code >= 500 and code < 600 and code != 501
        return true
    false
