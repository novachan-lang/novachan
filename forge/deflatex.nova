// deflatex -- RFC 1951 DEFLATE compression (the engine behind gzip/zip), pure NOVA.
// Fixed-Huffman blocks + LZ77 (hash-chain matcher, 32KB window). Output is valid
// DEFLATE (a real gunzip can inflate it). Bit order: plain values LSB-first, Huffman
// codes MSB-first. State is a 3-list: bw=[out,acc,nbits], br=[data,pos,bitpos].

// str_to_byte_list / byte_list_to_str convert between a string and a LIST of
// int byte values (deflatex's native representation). They were formerly named
// str_to_bytes / bytes_to_str, which SILENTLY SHADOWED the language builtins of
// those names (which return/consume a `bytes` VALUE, not a list) for every
// module that imported deflatex — a latent footgun. Renamed to non-colliding,
// self-documenting names so `import deflatex` no longer changes the meaning of
// the str_to_bytes / bytes_to_str builtins in the importing program.
fn str_to_byte_list(s)
    return [ord(s[i]) for i in 0..len(s)]

// A comprehension joined ONCE. The old form was reduce(b, fn(acc,x) acc + chr(x), "") -- a fold
// whose accumulator is a STRING, so every byte reallocated and recopied the whole output. That is
// quadratic in the decompressed size, on the function that turns inflate()'s result into text.
fn byte_list_to_str(b)
    join([chr(x) for x in b], "")

// ── Bit writer / reader as STRUCTS ───────────────────────────────────────────────────────────────
// These were 3-element LISTS with the layout documented only in a comment: bw=[out,acc,nbits] and
// br=[data,pos,bitpos]. Every access was a magic index -- bw[1] for the accumulator, br[2] for the
// bit offset -- so a typo in a subscript was a silent bit-order bug in a DEFLATE stream, which is
// the hardest possible class of bug to notice. Named fields make that typo a compile error.
// Both are module-internal (verified: nothing outside deflatex calls bw_*/br_*; the same-named
// functions in forge_bitio, std/concurrency/barrier and std/os/bufreader are unrelated modules).
type BitWriter
    out: list
    acc: int
    nbits: int

type BitReader
    data: list
    pos: int
    bitpos: int

fn bw_new() -> BitWriter
    BitWriter([], 0, 0)

// Append ONE bit, flushing a full byte. bw_bits and bw_code each open-coded this five-line
// accumulate-and-flush, differing only in which direction they walked the source bits; a fix to one
// would not have reached the other.
fn _bw_bit(bw: BitWriter, bit: int)
    bw.acc = bw.acc | (bit << bw.nbits)
    bw.nbits += 1
    if bw.nbits == 8
        push(bw.out, bw.acc)
        bw.acc = 0
        bw.nbits = 0

// Plain values are LSB-first.
fn bw_bits(bw: BitWriter, value: int, n: int)
    for i in 0..n
        _bw_bit(bw, (value >> i) & 1)

// Huffman codes are MSB-first -- the same bit push, walked the other way.
fn bw_code(bw: BitWriter, code: int, n: int)
    for i in reversed(0..n)
        _bw_bit(bw, (code >> i) & 1)

fn bw_finish(bw: BitWriter) -> list
    if bw.nbits > 0
        push(bw.out, bw.acc)
        bw.acc = 0
        bw.nbits = 0
    bw.out

fn br_new(data: list) -> BitReader
    BitReader(data, 0, 0)

// Past the end reads as 0, unchanged -- inflate relies on it for a truncated final byte.
fn br_bit(br: BitReader) -> int
    if br.pos >= len(br.data)
        return 0
    let bit = (br.data[br.pos] >> br.bitpos) & 1
    br.bitpos += 1
    if br.bitpos == 8
        br.bitpos = 0
        br.pos += 1
    bit

fn br_bits(br: BitReader, n: int) -> int
    let v = 0
    for i in 0..n
        v = v | (br_bit(br) << i)
    v

// RFC1951 3.2.6 fixed-Huffman literal/length code. The four ranges are DATA -- each row is
// [upper_bound, code_base, offset_base, width] -- so the mapping can be read as the table the RFC
// prints, instead of as four branches whose arithmetic has to be checked one at a time.
fn _fixed_lit_code_table() -> list
    [[143, 48, 0, 8], [255, 400, 144, 9], [279, 0, 256, 7], [287, 192, 280, 8]]

fn _enc_sym(bw: BitWriter, sym: int)
    for row in _fixed_lit_code_table()
        if sym <= row[0]
            bw_code(bw, row[1] + (sym - row[2]), row[3])
            return
fn _dec_sym(br)
    let code = 0
    let i = 0
    while i < 7
        code = (code << 1) | br_bit(br)
        i += 1
    if code <= 23
        return 256 + code
    code = (code << 1) | br_bit(br)
    if code >= 48 and code <= 191
        return code - 48
    if code >= 192 and code <= 199
        return 280 + (code - 192)
    code = (code << 1) | br_bit(br)
    return 144 + (code - 400)

// RFC1951 3.2.5 length and distance codes. Each entry is [base, extra_bits] -- ONE table per axis
// instead of two parallel arrays that had to stay index-aligned by hand. A base without its matching
// extra-bit count is meaningless, so they belong in the same row.
fn _len_table() -> list
    [[3,0],[4,0],[5,0],[6,0],[7,0],[8,0],[9,0],[10,0],[11,1],[13,1],[15,1],[17,1],[19,2],[23,2],[27,2],[31,2],[35,3],[43,3],[51,3],[59,3],[67,4],[83,4],[99,4],[115,4],[131,5],[163,5],[195,5],[227,5],[258,0]]

fn _dist_table() -> list
    [[1,0],[2,0],[3,0],[4,0],[5,1],[7,1],[9,2],[13,2],[17,3],[25,3],[33,4],[49,4],[65,5],[97,5],[129,6],[193,6],[257,7],[385,7],[513,8],[769,8],[1025,9],[1537,9],[2049,10],[3073,10],[4097,11],[6145,11],[8193,12],[12289,12],[16385,13],[24577,13]]

// The two axes are read column-wise in a few places; these keep those call sites unchanged.
fn _len_base() -> list
    [r[0] for r in _len_table()]
fn _len_extra() -> list
    [r[1] for r in _len_table()]
fn _dist_base() -> list
    [r[0] for r in _dist_table()]
fn _dist_extra() -> list
    [r[1] for r in _dist_table()]

// The largest code index whose base is <= value -- the greedy bucket search that deflate() ran
// inline twice, once over lengths and once over distances, with the loop bound (28 / 29) written as
// a literal at each site. Stated once, with the bound derived from the table.
fn _bucket(table: list, value: int) -> int
    let last = len(table) - 1
    let i = 0
    while i < last and table[i + 1][0] <= value
        i += 1
    i

fn _hkey(bytes, q)
    return str(bytes[q] * 65536 + bytes[q + 1] * 256 + bytes[q + 2])
// `return 0` dropped: nothing read it, and a meaningless return value invites a caller to test it.
fn _insert(table: dict, bytes: list, q: int)
    if _hkey(bytes, q) not in table
        table[_hkey(bytes, q)] = []
    push(table[_hkey(bytes, q)], q)

fn deflate(bytes)
    let LB = _len_base()
    let LE = _len_extra()
    let DB = _dist_base()
    let DE = _dist_extra()
    let bw = bw_new()
    bw_bits(bw, 1, 1)
    bw_bits(bw, 1, 2)
    let table = {}
    let n = len(bytes)
    let p = 0
    while p < n
        let matchlen = 0
        let matchdist = 0
        if p + 2 < n
            let ks = _hkey(bytes, p)
            if ks in table
                let chain = table[ks]
                let ci = len(chain) - 1
                let cnt = 0
                while ci >= 0 and cnt < 64
                    let cand = chain[ci]
                    let dist = p - cand
                    if dist >= 1 and dist <= 32768
                        let ml = 0
                        while ml < 258 and p + ml < n and bytes[cand + ml] == bytes[p + ml]
                            ml += 1
                        if ml > matchlen
                            matchlen = ml
                            matchdist = dist
                    ci -= 1
                    cnt += 1
        if matchlen >= 3
            // Bucket search stated once (see _bucket) instead of open-coded here with the loop
            // bound written as the literal 28 / 29.
            let li = _bucket(_len_table(), matchlen)
            _enc_sym(bw, 257 + li)
            if LE[li] > 0
                bw_bits(bw, matchlen - LB[li], LE[li])
            let di = _bucket(_dist_table(), matchdist)
            bw_code(bw, di, 5)
            if DE[di] > 0
                bw_bits(bw, matchdist - DB[di], DE[di])
            let q = p
            while q < p + matchlen and q + 2 < n
                _insert(table, bytes, q)
                q += 1
            p += matchlen
        else
            _enc_sym(bw, bytes[p])
            if p + 2 < n
                _insert(table, bytes, p)
            p += 1
    _enc_sym(bw, 256)
    return bw_finish(bw)

// ── General RFC1951 inflate (stored + fixed + DYNAMIC Huffman, multi-block) ──────

fn _fixed_lit_lengths()
    return [8 if i < 144 else 9 if i < 256 else 7 if i < 280 else 8 for i in 0..288]

fn _fixed_dist_lengths()
    return [5 for i in 0..30]

// Build a canonical-Huffman decoder from per-symbol code lengths.
// Returns [counts, syms, maxlen]: counts[len] = number of codes of that length,
// syms = symbols sorted by (length, symbol), maxlen = longest code length.
fn huff_build(lengths)
    let maxlen = 0
    let i = 0
    while i < len(lengths)
        if lengths[i] > maxlen
            maxlen = lengths[i]
        i += 1
    let counts = []
    let c = 0
    while c <= maxlen
        push(counts, 0)
        c += 1
    i = 0
    while i < len(lengths)
        if lengths[i] > 0
            counts[lengths[i]] = counts[lengths[i]] + 1
        i += 1
    let offsets = []
    let o = 0
    while o <= maxlen + 1
        push(offsets, 0)
        o += 1
    let ln = 1
    while ln <= maxlen
        offsets[ln + 1] = offsets[ln] + counts[ln]
        ln += 1
    let nsyms = offsets[maxlen + 1]
    let syms = []
    let s = 0
    while s < nsyms
        push(syms, 0)
        s += 1
    let nexti = []
    let q = 0
    while q <= maxlen + 1
        push(nexti, offsets[q])
        q += 1
    for sym in 0..len(lengths)
        let l2 = lengths[sym]
        if l2 > 0
            syms[nexti[l2]] = sym
            nexti[l2] = nexti[l2] + 1
    return [counts, syms, maxlen]

// Decode one symbol via the canonical algorithm (puff.c style; Huffman bits MSB-first).
fn huff_decode(br, desc)
    let counts = desc[0]
    let syms = desc[1]
    let maxlen = desc[2]
    let code = 0
    let first = 0
    let index = 0
    let ln = 1
    while ln <= maxlen
        code = code | br_bit(br)
        let count = counts[ln]
        if code - first < count
            return syms[index + (code - first)]
        index += count
        first += count
        first = first << 1
        code = code << 1
        ln += 1
    return -1

// Advance to the next byte boundary (RFC1951 stored blocks start byte-aligned).
fn br_align(br: BitReader)
    if br.bitpos > 0
        br.bitpos = 0
        br.pos += 1

// Read a dynamic block's code-length tables (RFC1951 3.2.7). Returns [litdesc, distdesc].
fn _read_dynamic(br)
    let HLIT = br_bits(br, 5) + 257
    let HDIST = br_bits(br, 5) + 1
    let HCLEN = br_bits(br, 4) + 4
    let order = [16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15]
    let cl = [0 for z in 0..19]
    let i = 0
    while i < HCLEN
        cl[order[i]] = br_bits(br, 3)
        i += 1
    let cldesc = huff_build(cl)
    let total = HLIT + HDIST
    let lengths = []
    while len(lengths) < total
        let s = huff_decode(br, cldesc)
        if s < 16
            push(lengths, s)
        else if s == 16
            let rep = br_bits(br, 2) + 3
            let prev = lengths[len(lengths) - 1]
            for r in 0..rep
                push(lengths, prev)
        else if s == 17
            let rep2 = br_bits(br, 3) + 3
            for r2 in 0..rep2
                push(lengths, 0)
        else
            let rep3 = br_bits(br, 7) + 11
            for r3 in 0..rep3
                push(lengths, 0)
    let lit = []
    let dist = []
    let j = 0
    while j < total
        if j < HLIT
            push(lit, lengths[j])
        else
            push(dist, lengths[j])
        j += 1
    return [huff_build(lit), huff_build(dist)]

fn _fixed_descs()
    return [huff_build(_fixed_lit_lengths()), huff_build(_fixed_dist_lengths())]

fn inflate(data)
    let LB = _len_base()
    let LE = _len_extra()
    let DB = _dist_base()
    let DE = _dist_extra()
    let br = br_new(data)
    let out = []
    let final = 0
    while final == 0
        final = br_bit(br)
        let btype = br_bits(br, 2)
        if btype == 0
            // stored block: skip to byte boundary, read LEN (2 LE) + NLEN (2, ignored), copy LEN bytes
            br_align(br)
            let blen = br.data[br.pos] | (br.data[br.pos + 1] << 8)
            br.pos += 4
            for k in 0..blen
                push(out, br.data[br.pos])
                br.pos += 1
        else
            let descs = []
            if btype == 1
                descs = _fixed_descs()
            else
                descs = _read_dynamic(br)
            let litdesc = descs[0]
            let distdesc = descs[1]
            // `go` was a flag standing in for `break`: once the end-of-block symbol (256) arrived
            // the guard failed on the next check and the loop ended having done nothing else.
            let go = 1
            while go == 1
                let sym = huff_decode(br, litdesc)
                if sym == 256
                    break
                else if sym < 256
                    push(out, sym)
                else
                    let li = sym - 257
                    let length = LB[li] + br_bits(br, LE[li])
                    let dsym = huff_decode(br, distdesc)
                    let dist = DB[dsym] + br_bits(br, DE[dsym])
                    let start = len(out) - dist
                    for m in 0..length
                        push(out, out[start + m])
    return out

// gzip wrapper (RFC 1952): header + DEFLATE body + CRC32 + ISIZE
fn _crc32(bytes)
    let crc = 4294967295
    for b in bytes
        crc = crc ^ b
        for j in 0..8
            if (crc & 1) == 1
                crc = (crc >> 1) ^ 3988292384
            else
                crc = crc >> 1
    return crc ^ 4294967295
fn _le32(v)
    return [v & 255, (v >> 8) & 255, (v >> 16) & 255, (v >> 24) & 255]
fn gzip_compress(bytes)
    let body = deflate(bytes)
    return [31, 139, 8, 0, 0, 0, 0, 0, 0, 255, ...body, ..._le32(_crc32(bytes)), ..._le32(len(bytes))]
fn gzip_decompress(gz)
    // RFC1952 header: [0]=31 [1]=139 [2]=CM [3]=FLG [4..7]=MTIME [8]=XFL [9]=OS,
    // then optional FEXTRA/FNAME/FCOMMENT/FHCRC fields selected by FLG, then the
    // DEFLATE body, then an 8-byte trailer (CRC32 + ISIZE). Parse FLG so we can read
    // REAL .gz files (command-line gzip sets FNAME), not just minimal headers.
    let flg = gz[3]
    let p = 10
    if (flg & 4) != 0
        let xlen = gz[p] | (gz[p + 1] << 8)
        p += 2 + xlen
    if (flg & 8) != 0
        while gz[p] != 0
            p += 1
        p += 1
    if (flg & 16) != 0
        while gz[p] != 0
            p += 1
        p += 1
    if (flg & 2) != 0
        p += 2
    let n = len(gz) - 8
    let body = [gz[i] for i in p..n]
    return inflate(body)

// Public CRC32 over a byte LIST (the gzip/zip CRC). The `crc32` builtin is string-based;
// this exposes the byte-correct internal _crc32 for importers (e.g. zipx).
fn gzip_crc32(bytes)
    return _crc32(bytes)

// deflatex is now a pure LIBRARY (no main) so other modules can `import deflatex` and call
// inflate / deflate / gzip_compress / gzip_decompress / gzip_crc32 / str_to_byte_list /
// byte_list_to_str. The self-test that used to live in main() moved to deflatex_test.nova.
fn _deflatex_lib_marker()
    return 0
