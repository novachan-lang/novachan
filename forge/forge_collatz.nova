// forge_collatz -- thin wrapper over std/math/collatz (canonical implementation).
import std/math/collatz

fn collatz_steps(n: int) -> int
    return col_steps(n)

fn collatz_sequence(n: int) -> list
    let seq = []
    let v = n
    push(seq, v)
    while v != 1
        if v % 2 == 0
            v = v / 2
        else
            v = 3 * v + 1
        push(seq, v)
    seq

// The highest value reached on the way from n to 1 (the peak "hailstone" altitude). collatz_max(27)=9232.

fn collatz_max(n: int) -> int
    return col_max(n)

