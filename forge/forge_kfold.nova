// forge_kfold -- honestly split your data for machine-learning evaluation. You must never judge a model on the
// same data it trained on (it just memorizes); you hold some out. train_test_split does a single random holdout
// (e.g. 80% train / 20% test). k-FOLD cross-validation does better: it partitions the data into k equal folds,
// then trains k times, each time testing on a different fold and training on the other k-1 -- so EVERY row gets
// used for testing exactly once, and you average the k scores (pair with forge_evalmetrics) for a far more
// stable estimate than a single lucky/unlucky split. This module just produces the index sets (which rows are
// train, which are test); you index your own data and labels with them. Splits are reproducible via a seed.
// LEAF -- imports NOTHING.

// PRIVATE: [start, end) index range of fold f when n items are split into k contiguous folds (the first n%k
// folds get one extra item so sizes differ by at most 1).
fn _kf_bounds(n: int, k: int, f: int) -> list
    let base = n / k
    let rem = n % k
    let extra = rem if f > rem else f
    let start = f * base + extra
    let size = base + 1 if f < rem else base
    [start, start + size]

// Split n items into fold `f` of `k`: returns [train_indices, test_indices] where test is fold f's block and
// train is everything else. Contiguous (deterministic); shuffle your data first if order is meaningful.
fn kfold_split(n: int, k: int, f: int) -> list
    let b = _kf_bounds(n, k, f)
    let start = b[0]
    let end = b[1]
    let test = [i for i in 0..n if i >= start and i < end]
    let train = [i for i in 0..n if i < start or i >= end]
    [train, test]

// The test-index block for fold f (just the held-out indices).
fn kfold_test_indices(n: int, k: int, f: int) -> list
    let s = kfold_split(n, k, f)
    s[1]

// A shuffled list of 0..n-1, reproducible for a given seed (Fisher-Yates with a 31-bit LCG).
fn shuffle_indices(n: int, seed: int) -> list
    let idx = [i for i in 0..n]
    let state = seed
    let j = n - 1
    while j > 0
        state = (state * 1103515245 + 12345) & 2147483647
        let r = state % (j + 1)
        let tmp = idx[j]
        idx[j] = idx[r]
        idx[r] = tmp
        j -= 1
    idx

// A single random holdout split: returns [train_indices, test_indices] with about test_fraction of the n items
// held out for testing. Reproducible for a given seed.
fn train_test_split(n: int, test_fraction: float, seed: int) -> list
    let idx = shuffle_indices(n, seed)
    let n_test = int((test_fraction * 1.0) * (n * 1.0))
    let test = [idx[k] for k in 0..n if k < n_test]
    let train = [idx[k] for k in 0..n if k >= n_test]
    [train, test]
