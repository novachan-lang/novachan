fn mv_new()
    let state = {}
    state["model_count"] = 0
    state["version_count"] = 0
    state["promoted_count"] = 0
    return state

fn mv_register(state, model_name)
    state["m_" + model_name + "_versions"] = 0
    state["m_" + model_name + "_active"] = ""
    state["m_" + model_name + "_latest"] = ""
    state["model_count"] = state["model_count"] + 1
    return state

fn mv_add_version(state, model_name, version_tag, accuracy)
    let vkey = "m_" + model_name + "_versions"
    if contains(state, vkey) != true
        return err("unknown model: " + model_name)
    let idx = state[vkey]
    state["m_" + model_name + "_v" + str(idx) + "_tag"] = version_tag
    state["m_" + model_name + "_v" + str(idx) + "_acc"] = accuracy
    state["m_" + model_name + "_v" + str(idx) + "_status"] = "staged"
    state[vkey] = idx + 1
    state["m_" + model_name + "_latest"] = version_tag
    state["version_count"] = state["version_count"] + 1
    return ok(state)

fn mv_promote(state, model_name, version_tag)
    let vkey = "m_" + model_name + "_versions"
    if contains(state, vkey) != true
        return err("unknown model")
    let n = state[vkey]
    let i = 0
    while i < n
        let tkey = "m_" + model_name + "_v" + str(i) + "_tag"
        if state[tkey] == version_tag
            state["m_" + model_name + "_v" + str(i) + "_status"] = "active"
            state["m_" + model_name + "_active"] = version_tag
            state["promoted_count"] = state["promoted_count"] + 1
            return ok(state)
        i = i + 1
    return err("version not found: " + version_tag)

fn mv_active(state, model_name)
    let akey = "m_" + model_name + "_active"
    if contains(state, akey) != true
        return err("unknown model")
    if state[akey] == ""
        return err("no active version")
    return ok(state[akey])

fn mv_latest(state, model_name)
    let lkey = "m_" + model_name + "_latest"
    if contains(state, lkey) != true
        return err("unknown model")
    if state[lkey] == ""
        return err("no versions")
    return ok(state[lkey])

fn mv_version_count(state, model_name)
    let vkey = "m_" + model_name + "_versions"
    if contains(state, vkey) != true
        return err("unknown model")
    return ok(state[vkey])

fn mv_accuracy(state, model_name, version_tag)
    let vkey = "m_" + model_name + "_versions"
    if contains(state, vkey) != true
        return err("unknown model")
    let n = state[vkey]
    let i = 0
    while i < n
        let tkey = "m_" + model_name + "_v" + str(i) + "_tag"
        if state[tkey] == version_tag
            return ok(state["m_" + model_name + "_v" + str(i) + "_acc"])
        i = i + 1
    return err("version not found")

fn mv_model_count(state)
    return state["model_count"]

fn mv_total_versions(state)
    return state["version_count"]

fn mv_promoted_count(state)
    return state["promoted_count"]

fn mv_status(state, model_name, version_tag)
    let vkey = "m_" + model_name + "_versions"
    if contains(state, vkey) != true
        return err("unknown model")
    let n = state[vkey]
    let i = 0
    while i < n
        let tkey = "m_" + model_name + "_v" + str(i) + "_tag"
        if state[tkey] == version_tag
            return ok(state["m_" + model_name + "_v" + str(i) + "_status"])
        i = i + 1
    return err("version not found")
