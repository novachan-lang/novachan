// forge_hostname -- validate a hostname / domain name (RFC 1123): each dot-separated label is 1-63 chars of
// [A-Za-z0-9-], not starting or ending with a hyphen; total <= 253 chars. For URL/email-domain validation, TLS
// SNI checks, and allow-lists. A trailing dot (FQDN) is tolerated. LEAF -- imports NOTHING.

fn _hn_label_valid(label: string) -> bool
    let n = len(label)
    if n == 0 or n > 63
        return false
    if char_at(label, 0) == "-" or char_at(label, n - 1) == "-"
        return false
    let ok = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-"
    let i = 0
    while i < n
        if find(ok, char_at(label, i)) < 0
            return false
        i = i + 1
    true

fn hostname_valid(host: string) -> bool
    let h = host
    if len(h) > 0 and char_at(h, len(h) - 1) == "."
        h = slice(h, 0, len(h) - 1)
    if len(h) == 0 or len(h) > 253
        return false
    let labels = split(h, ".")
    let i = 0
    while i < len(labels)
        if _hn_label_valid(labels[i]) == false
            return false
        i = i + 1
    true

// The TLD (last label, lowercased); "" if invalid.
fn hostname_tld(host: string) -> string
    if hostname_valid(host) == false
        return ""
    let h = host
    if char_at(h, len(h) - 1) == "."
        h = slice(h, 0, len(h) - 1)
    let labels = split(h, ".")
    lower(labels[len(labels) - 1])
