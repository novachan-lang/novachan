// forge_webhook_validator — Validate webhook payloads with Result.

fn wv_new() -> dict
    {"secrets": {}, "validated": 0, "rejected": 0}

fn wv_register(w: dict, source: string, secret: string) -> dict
    w["secrets"][source] = secret
    w

fn wv_validate(w: dict, source: string, payload: string, signature: int) -> Result
    if source not in w["secrets"]
        w["rejected"] += 1
        return err("unknown source: " + source)
    let secret = w["secrets"][source]
    let expected = 0
    for i in 0..len(payload)
        expected = expected * 31 + ord(payload[i])
    for i in 0..len(secret)
        expected = expected * 17 + ord(secret[i])
    if expected < 0
        expected = -expected
    if expected != signature
        w["rejected"] += 1
        return err("invalid signature")
    w["validated"] += 1
    ok(w)

fn wv_compute_signature(w: dict, source: string, payload: string) -> Result
    if source not in w["secrets"]
        return err("unknown source")
    let secret = w["secrets"][source]
    let h = 0
    for i in 0..len(payload)
        h = h * 31 + ord(payload[i])
    for i in 0..len(secret)
        h = h * 17 + ord(secret[i])
    if h < 0
        h = -h
    ok(h)

fn wv_validated_count(w: dict) -> int
    w["validated"]

fn wv_rejected_count(w: dict) -> int
    w["rejected"]
