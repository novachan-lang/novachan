// forge_tip -- tip/gratuity + bill-split math in integer CENTS (restaurant, delivery, and bill-split apps).
// Compute a tip at a percentage, the grand total, and a per-person split with the leftover cents surfaced (so
// nothing is silently lost to rounding). Same integer-cents discipline as forge_percent. LEAF -- imports NOTHING.

// Tip amount for a bill at `pct` percent (rounded to the nearest cent).
fn tip_amount(bill_cents: int, pct: int) -> int
    (bill_cents * pct + 50) / 100

// Grand total = bill + tip.
fn tip_total(bill_cents: int, pct: int) -> int
    bill_cents + tip_amount(bill_cents, pct)

// Split a total among `people` -> [per_person_cents, remainder_cents]. The remainder is the extra cents that
// don't divide evenly (assign to one payer so the sum is exact). [0,0] if people <= 0.
fn split_bill(total_cents: int, people: int) -> list
    if people <= 0
        return [0, 0]
    [total_cents / people, total_cents % people]

// Convenience: total (bill+tip) split among `people` -> [per_person, remainder].
fn tip_split(bill_cents: int, pct: int, people: int) -> list
    split_bill(tip_total(bill_cents, pct), people)
