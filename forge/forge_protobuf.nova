// forge_protobuf -- thin wrapper over std/encoding/protobuf (canonical implementation).
import std/encoding/protobuf

fn pb_encode_varint(out: list, v: int) -> list
    return pb_wire_varint(out, v)

fn pb_decode_varint(buf: list, off: int) -> list
    return pb_read_varint(buf, off)

fn pb_zigzag_encode(n: int) -> int
    if n >= 0
        return n * 2
    -n * 2 - 1

// Zigzag decode: inverse of pb_zigzag_encode.
// Formula: z even -> z/2 ; z odd -> 0-((z+1)/2)
// Vector: decode(3)->-2  (3 odd -> 0-((3+1)/2) = 0-2 = -2)

fn pb_zigzag_decode(z: int) -> int
    if z % 2 == 0
        return z / 2
    -((z + 1) / 2)

// Compute the wire key: (field_number << 3) | wire_type.
// Wire types: 0=varint, 1=64-bit, 2=length-delimited, 5=32-bit.
// Vectors: pb_tag(1,0)->8, pb_tag(2,2)->18

fn pb_tag(field_number: int, wire_type: int) -> int
    return pb_make_tag(field_number, wire_type)

fn pb_encode_field_varint(out: list, field_number: int, v: int) -> list
    let tag = pb_tag(field_number, 0)
    let o1 = pb_encode_varint(out, tag)
    pb_encode_varint(o1, v)

// Encode a length-delimited field (wire type 2): tag, then len(data) as varint, then raw bytes.
// Used for bytes, strings, and embedded sub-messages.
// Appends to `out`; returns `out`.

fn pb_encode_field_bytes(out: list, field_number: int, data: list) -> list
    let tag = pb_tag(field_number, 2)
    let o1 = pb_encode_varint(out, tag)
    let o2 = pb_encode_varint(o1, len(data))
    for i in 0..len(data)
        push(o2, data[i])
    o2

