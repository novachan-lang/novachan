// forge_bytesize -- parse a human byte-size string ("1.5GB", "500MB", "1024") into a byte count (the inverse of
// forge_humanize's humanize_bytes). For config values: max upload size, memory/cache limits, quotas. Base-1024
// (KB=1024, MB=1024^2, ...). One decimal place of precision. LEAF -- imports NOTHING.

fn parse_bytesize(s: string) -> int
    let t = trim(s)
    let num_parts = []
    let i = 0
    while i < len(t) and find("0123456789.", char_at(t, i)) >= 0
        push(num_parts, char_at(t, i))
        i += 1
    let num = join(num_parts, "")
    let unit = upper(trim(slice(t, i, len(t))))
    let whole = num
    let tenths = 0
    let dot = find(num, ".")
    if dot >= 0
        whole = slice(num, 0, dot)
        let frac = slice(num, dot + 1, len(num))
        if len(frac) > 0
            tenths = find("0123456789", char_at(frac, 0))
    if len(whole) == 0
        whole = "0"
    let value_tenths = parse_int(whole) * 10 + tenths
    let mult = 1
    if unit == "K" or unit == "KB"
        mult = 1024
    if unit == "M" or unit == "MB"
        mult = 1048576
    if unit == "G" or unit == "GB"
        mult = 1073741824
    if unit == "T" or unit == "TB"
        mult = 1099511627776
    value_tenths * mult / 10
