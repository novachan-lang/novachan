// forge_user_preference — per-user preference storage with defaults and Result API.

fn up_new() -> dict
    let u = {}
    u["user_count"] = 0
    u["total_reads"] = 0
    u["total_writes"] = 0
    u

fn up_set(u: dict, user: string, key: string, value: string) -> dict
    let pk = "pref_" + user + "_" + key
    if "usr_" + user in u != true
        u["usr_" + user] = 1
        u["user_count"] = u["user_count"] + 1
    u[pk] = value
    u["total_writes"] = u["total_writes"] + 1
    u

fn up_get(u: dict, user: string, key: string) -> Result
    u["total_reads"] = u["total_reads"] + 1
    let pk = "pref_" + user + "_" + key
    if pk in u != true
        return err("no preference: " + key)
    ok(u[pk])

fn up_get_or_default(u: dict, user: string, key: string, default_val: string) -> string
    u["total_reads"] = u["total_reads"] + 1
    let pk = "pref_" + user + "_" + key
    if pk in u == true
        return u[pk]
    default_val

fn up_has(u: dict, user: string, key: string) -> int
    let pk = "pref_" + user + "_" + key
    if pk in u == true
        return 1
    0

fn up_user_count(u: dict) -> int
    u["user_count"]

fn up_total_reads(u: dict) -> int
    u["total_reads"]

fn up_total_writes(u: dict) -> int
    u["total_writes"]
