// forge_subarraysum -- count and locate contiguous subarrays whose elements add up to a TARGET sum, in a single
// O(n) pass. The key idea is PREFIX SUMS plus a hash map: a subarray (i..j] sums to k exactly when
// prefix[j] - prefix[i] == k, so as you sweep left to right you just ask "have I seen a prefix equal to
// (current prefix - k) before, and how many times?" -- turning a quadratic all-pairs search into a linear one.
// Crucially this works with NEGATIVE numbers too, where the classic sliding-window trick (which assumes sums only
// grow) breaks down. Use it for "how many windows of transactions net exactly zero / this amount", detecting a
// run that hits a target (score, calories, budget), balancing/zero-sum segment detection, and time-series pattern
// counting. Provides the count of such subarrays, a yes/no existence check, and the location of one. Integer
// arrays. LEAF -- imports NOTHING.

// The number of contiguous subarrays of `arr` whose elements sum to exactly `k`. Handles negatives. O(n).
fn subarray_sum_count(arr: list, k: int) -> int
    let seen = {}
    seen["0"] = 1
    let prefix = 0
    let count = 0
    for i in 0..len(arr)
        prefix += arr[i]
        let need = str(prefix - k)
        count += get(seen, need, 0)
        let key = str(prefix)
        seen[key] = get(seen, key, 0) + 1
    count

// True if some contiguous subarray sums to exactly k.
fn subarray_sum_exists(arr: list, k: int) -> bool
    let seen = {}
    seen["0"] = 1
    let prefix = 0
    let out = false
    let i = 0
    while i < len(arr) and out == false
        prefix += arr[i]
        if contains(seen, str(prefix - k))
            out = true
        seen[str(prefix)] = 1
        i += 1
    out

// The [start, end] indices (inclusive) of the FIRST subarray (earliest ending) that sums to k, or [-1, -1] if none.
fn subarray_sum_indices(arr: list, k: int) -> list
    let first = {}
    first["0"] = 0 - 1
    let prefix = 0
    let out = [0 - 1, 0 - 1]
    let done = false
    let i = 0
    while i < len(arr) and done == false
        prefix += arr[i]
        let need = str(prefix - k)
        if need in first
            out = [first[need] + 1, i]
            done = true
        else
            let key = str(prefix)
            if key in first == false
                first[key] = i
        i += 1
    out
