// forge_ops_rollout -- rolling deployment planner: partitions a concrete ORDERED list of instances
// into fixed-size batches (waves), each separated by a pause. Answers "which instances go out in
// step N", for real batch-by-batch rollouts (update host[0..4], pause, update host[5..9], pause, ...).
//
// Distinct from forge_rollout_strategy's rs_ API, which drives a PERCENTAGE (linear/exponential/
// custom step size on 0-100) and never knows which concrete instances are in a given wave -- that
// module answers "how far along are we", this one answers "who ships next". LEAF -- imports NOTHING.

// Build a rollout plan: `instances` in deploy order, `batch_size` instances per step (clamped to
// >= 1), `pause_ms` recorded for callers to sleep between steps (this module does no I/O/sleeping
// itself). step_count = ceil(len(instances) / batch_size).
fn or_plan(instances: list, batch_size: int, pause_ms: int) -> dict
    let bs = 1 if batch_size < 1 else batch_size
    let total = len(instances)
    let steps = 0
    if total > 0
        steps = total / bs
        if total % bs != 0
            steps += 1
    {"instances": instances, "batch_size": bs, "pause_ms": pause_ms, "step_count": steps, "total": total}

// The batch of instances for `step_idx` (0-based). Out-of-range step_idx -> empty list.
fn or_step(plan: dict, step_idx: int) -> list
    if step_idx < 0 or step_idx >= plan["step_count"]
        return []
    let bs = plan["batch_size"]
    let instances = plan["instances"]
    let total = plan["total"]
    let start = step_idx * bs
    let end = start + bs
    if end > total
        end = total
    [instances[i] for i in start..end]

// Percentage (0-100) of instances completed so far. An empty plan is always 100% complete.
fn or_progress(plan: dict, completed: int) -> int
    let total = plan["total"]
    if total == 0
        return 100
    let c = completed
    if c > total
        c = total
    if c < 0
        c = 0
    c * 100 / total

fn or_step_count(plan: dict) -> int
    plan["step_count"]
