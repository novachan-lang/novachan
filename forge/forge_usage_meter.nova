// forge_usage_meter — Usage metering for billing.
// Track resource consumption per tenant, generate billing summaries.

fn um_new() -> dict
    {"meters": {}, "events": []}

fn um_define_meter(um: dict, name: string, unit: string, price_per_unit: int) -> dict
    um["meters"][name] = {"unit": unit, "price_per_unit": price_per_unit}
    um

fn um_record(um: dict, tenant: string, meter: string, quantity: int, timestamp: int) -> dict
    push(um["events"], {"tenant": tenant, "meter": meter, "quantity": quantity, "timestamp": timestamp})
    um

fn um_usage(um: dict, tenant: string, meter: string) -> int
    let total = 0
    for ev in um["events"]
        if ev["tenant"] == tenant and ev["meter"] == meter
            total += ev["quantity"]
    total

fn um_cost(um: dict, tenant: string, meter: string) -> int
    let qty = um_usage(um, tenant, meter)
    if meter not in um["meters"]
        return 0
    qty * um["meters"][meter]["price_per_unit"]

fn um_total_cost(um: dict, tenant: string) -> int
    let total = 0
    for m in keys(um["meters"])
        total += um_cost(um, tenant, m)
    total

fn um_tenant_summary(um: dict, tenant: string) -> dict
    let summary = {}
    for m in keys(um["meters"])
        let qty = um_usage(um, tenant, m)
        if qty > 0
            summary[m] = {"quantity": qty, "cost": um_cost(um, tenant, m)}
    summary

fn um_event_count(um: dict) -> int
    len(um["events"])

fn um_meter_count(um: dict) -> int
    len(keys(um["meters"]))
