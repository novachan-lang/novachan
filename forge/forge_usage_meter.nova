// forge_usage_meter — Usage metering for billing.
// Track resource consumption per tenant, generate billing summaries.

fn um_new() -> dict
    let um = {}
    um["meters"] = {}
    um["events"] = []
    um

fn um_define_meter(um: dict, name: string, unit: string, price_per_unit: int) -> dict
    let m = {}
    m["unit"] = unit
    m["price_per_unit"] = price_per_unit
    um["meters"][name] = m
    um

fn um_record(um: dict, tenant: string, meter: string, quantity: int, timestamp: int) -> dict
    let ev = {}
    ev["tenant"] = tenant
    ev["meter"] = meter
    ev["quantity"] = quantity
    ev["timestamp"] = timestamp
    push(um["events"], ev)
    um

fn um_usage(um: dict, tenant: string, meter: string) -> int
    let total = 0
    let i = 0
    while i < len(um["events"])
        let ev = um["events"][i]
        if ev["tenant"] == tenant
            if ev["meter"] == meter
                total = total + ev["quantity"]
        i = i + 1
    total

fn um_cost(um: dict, tenant: string, meter: string) -> int
    let qty = um_usage(um, tenant, meter)
    let has = contains(um["meters"], meter)
    if has != true
        return 0
    qty * um["meters"][meter]["price_per_unit"]

fn um_total_cost(um: dict, tenant: string) -> int
    let total = 0
    let all_meters = keys(um["meters"])
    let i = 0
    while i < len(all_meters)
        total = total + um_cost(um, tenant, all_meters[i])
        i = i + 1
    total

fn um_tenant_summary(um: dict, tenant: string) -> dict
    let summary = {}
    let all_meters = keys(um["meters"])
    let i = 0
    while i < len(all_meters)
        let m = all_meters[i]
        let qty = um_usage(um, tenant, m)
        if qty > 0
            let entry = {}
            entry["quantity"] = qty
            entry["cost"] = um_cost(um, tenant, m)
            summary[m] = entry
        i = i + 1
    summary

fn um_event_count(um: dict) -> int
    len(um["events"])

fn um_meter_count(um: dict) -> int
    len(keys(um["meters"]))
