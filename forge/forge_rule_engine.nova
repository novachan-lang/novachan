// forge_rule_engine — Evaluate business rules with Result.

fn re_new() -> dict
    {"rules": {}, "rule_count": 0, "evals": 0, "passes": 0}

fn re_add_rule(r: dict, name: string, field: string, op: string, value: string) -> dict
    let k = str(r["rule_count"])
    r["rules"][k + "_name"] = name
    r["rules"][k + "_field"] = field
    r["rules"][k + "_op"] = op
    r["rules"][k + "_value"] = value
    r["rule_count"] += 1
    r

fn re_eval_rule(r: dict, idx: int, data: dict) -> Result
    if idx >= r["rule_count"]
        return err("rule index out of range")
    let k = str(idx)
    let field = r["rules"][k + "_field"]
    if field not in data
        return err("missing field: {field}")
    let op = r["rules"][k + "_op"]
    let expected = r["rules"][k + "_value"]
    let actual = data[field]
    if op == "eq"
        return ok(1 if actual == expected else 0)
    else if op == "neq"
        return ok(1 if actual != expected else 0)
    else if op == "gt"
        return ok(1 if actual > expected else 0)
    err("unknown operator: {op}")

fn re_evaluate_all(r: dict, data: dict) -> dict
    r["evals"] += 1
    let passed = 0
    let failed = 0
    let first_fail = ""
    for i in 0..r["rule_count"]
        let result = re_eval_rule(r, i, data)
        if is_ok(result) and unwrap(result) == 1
            passed += 1
        else
            failed += 1
            if first_fail == ""
                first_fail = r["rules"][str(i) + "_name"]
    if failed == 0
        r["passes"] += 1
    {"passed": passed, "failed": failed, "first_fail": first_fail, "all_pass": failed == 0, "r": r}

fn re_rule_count(r: dict) -> int
    r["rule_count"]

fn re_pass_rate(r: dict) -> int
    if r["evals"] == 0
        return 0
    r["passes"] * 100 / r["evals"]
