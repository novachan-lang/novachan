// forge_rule_engine — Evaluate business rules with Result.

fn re_new() -> dict
    let r = {}
    r["rules"] = {}
    r["rule_count"] = 0
    r["evals"] = 0
    r["passes"] = 0
    r

fn re_add_rule(r: dict, name: string, field: string, op: string, value: string) -> dict
    let k = str(r["rule_count"])
    r["rules"][k + "_name"] = name
    r["rules"][k + "_field"] = field
    r["rules"][k + "_op"] = op
    r["rules"][k + "_value"] = value
    r["rule_count"] = r["rule_count"] + 1
    r

fn re_eval_rule(r: dict, idx: int, data: dict) -> Result
    if idx >= r["rule_count"]
        return err("rule index out of range")
    let k = str(idx)
    let field = r["rules"][k + "_field"]
    let has = contains(data, field)
    if has != true
        return err("missing field: " + field)
    let op = r["rules"][k + "_op"]
    let expected = r["rules"][k + "_value"]
    let actual = data[field]
    if op == "eq"
        if actual == expected
            return ok(1)
        return ok(0)
    if op == "neq"
        if actual != expected
            return ok(1)
        return ok(0)
    if op == "gt"
        if actual > expected
            return ok(1)
        return ok(0)
    err("unknown operator: " + op)

fn re_evaluate_all(r: dict, data: dict) -> dict
    r["evals"] = r["evals"] + 1
    let passed = 0
    let failed = 0
    let first_fail = ""
    let i = 0
    while i < r["rule_count"]
        let result = re_eval_rule(r, i, data)
        if is_ok(result)
            let v = unwrap(result)
            if v == 1
                passed = passed + 1
            else
                failed = failed + 1
                if first_fail == ""
                    first_fail = r["rules"][str(i) + "_name"]
        else
            failed = failed + 1
            if first_fail == ""
                first_fail = r["rules"][str(i) + "_name"]
        i = i + 1
    if failed == 0
        r["passes"] = r["passes"] + 1
    let out = {}
    out["passed"] = passed
    out["failed"] = failed
    out["first_fail"] = first_fail
    out["all_pass"] = failed == 0
    out["r"] = r
    out

fn re_rule_count(r: dict) -> int
    r["rule_count"]

fn re_pass_rate(r: dict) -> int
    if r["evals"] == 0
        return 0
    r["passes"] * 100 / r["evals"]
