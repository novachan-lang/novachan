// forge_modsolve -- the two hard "solve for x" problems in modular arithmetic that the basic building blocks
// (ext_gcd, mod_inverse in forge_modarith) do NOT handle: modular SQUARE ROOTS and modular LOGARITHMS. A modular
// inverse answers "what do I multiply by to divide"; these answer "what squares to this?" and "what power gives
// this?" -- the two questions at the heart of number-theoretic cryptography. mod_sqrt (the Tonelli-Shanks
// algorithm) finds x with x*x congruent to n modulo a prime p, which is how you decompress an elliptic-curve point
// from its x-coordinate, test/for quadratic residues, and solve x^2 = a in a finite field. discrete_log (the
// baby-step giant-step meet-in-the-middle) finds x with g^x congruent to h modulo p in about sqrt(p) work instead
// of p -- the generic attack behind Diffie-Hellman/ElGamal security analysis and Pohlig-Hellman. legendre tells
// you up front whether a square root even exists. Integers only; keep the prime p up to about 3 billion so that
// products (which reach p*p) still fit in signed 64-bit. Pairs with forge_modarith and forge_primes. LEAF.

// PRIVATE: modular exponentiation, base^exp mod m, by square-and-multiply. exp >= 0, m > 0.
fn _ms_powmod(base: int, exp: int, m: int) -> int
    let result = 1
    let b = ((base % m) + m) % m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = (result * b) % m
        b = (b * b) % m
        e = e / 2
    result

// PRIVATE: modular inverse of a mod m via the extended Euclidean algorithm; -1 if a and m are not coprime.
fn _ms_inv(a: int, m: int) -> int
    let old_r = ((a % m) + m) % m
    let r = m
    let old_s = 1
    let s = 0
    while r != 0
        let q = old_r / r
        let tr = old_r - q * r
        old_r = r
        r = tr
        let ts = old_s - q * s
        old_s = s
        s = ts
    let out = 0 - 1
    if old_r == 1
        out = ((old_s % m) + m) % m
    out

// The Legendre symbol of a with respect to an odd prime p: 0 if p divides a, 1 if a is a non-zero quadratic
// residue (a square) mod p, and -1 if a is a non-residue (no square root exists).
fn legendre(a: int, p: int) -> int
    let aa = ((a % p) + p) % p
    let out = 0
    if aa != 0
        let ls = _ms_powmod(aa, (p - 1) / 2, p)
        if ls == 1
            out = 1
        else
            out = 0 - 1
    out

// True if a is a quadratic residue mod the odd prime p (a square root exists).
fn is_quadratic_residue(a: int, p: int) -> bool
    legendre(a, p) == 1

// A modular square root of n mod the odd prime p: the smaller x in [0, p) with x*x congruent to n (mod p), or -1
// if n is a non-residue (no root exists). Uses the direct formula when p is 3 mod 4 and the general Tonelli-Shanks
// algorithm otherwise. The other root is always p - x.
fn mod_sqrt(n: int, p: int) -> int
    let nn = ((n % p) + p) % p
    let out = 0 - 1
    if nn == 0
        out = 0
    else
        if legendre(nn, p) != 1
            out = 0 - 1
        else
            if p % 4 == 3
                out = _ms_powmod(nn, (p + 1) / 4, p)
            else
                // factor p-1 = q * 2^s with q odd
                let q = p - 1
                let ss = 0
                while q % 2 == 0
                    q = q / 2
                    ss = ss + 1
                // find any quadratic non-residue z
                let z = 2
                while legendre(z, p) != 0 - 1
                    z = z + 1
                let m = ss
                let c = _ms_powmod(z, q, p)
                let t = _ms_powmod(nn, q, p)
                let r = _ms_powmod(nn, (q + 1) / 2, p)
                let done = false
                while done == false
                    if t == 1
                        out = r
                        done = true
                    else
                        // least i in (0, m) with t^(2^i) == 1
                        let i = 0
                        let temp = t
                        while temp != 1
                            temp = (temp * temp) % p
                            i = i + 1
                        // b = c^(2^(m-i-1))
                        let b = c
                        let j = 0
                        while j < m - i - 1
                            b = (b * b) % p
                            j = j + 1
                        m = i
                        c = (b * b) % p
                        t = (t * c) % p
                        r = (r * b) % p
        // normalize to the smaller of the two roots
        if out > 0
            let other = p - out
            if other < out
                out = other
    out

// The discrete logarithm of h to base g modulo the prime p: the smallest x >= 0 with g^x congruent to h (mod p),
// or -1 if no such x exists (h is not a power of g). Uses baby-step giant-step in about sqrt(p) time and memory.
fn discrete_log(g: int, h: int, p: int) -> int
    let gg = ((g % p) + p) % p
    let hh = ((h % p) + p) % p
    // m = ceil(sqrt(p))
    let m = 1
    while m * m < p
        m = m + 1
    // baby steps: remember the SMALLEST j in [0, m) reaching each value g^j
    let table = {}
    let cur = 1
    let j = 0
    while j < m
        let key = str(cur)
        if get(table, key, 0 - 1) < 0
            table[key] = j
        cur = (cur * gg) % p
        j = j + 1
    // giant steps: multiply h by g^(-m) each stride, looking for a baby step
    let gm = _ms_powmod(gg, m, p)
    let factor = _ms_inv(gm, p)
    let gamma = hh
    let out = 0 - 1
    let i = 0
    while i <= m and out < 0
        let jj = get(table, str(gamma), 0 - 1)
        if jj >= 0
            out = i * m + jj
        gamma = (gamma * factor) % p
        i = i + 1
    out
