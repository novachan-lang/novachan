// forge_saga_orchestrator — distributed saga pattern with Result API.

fn saga_new() -> dict
    let s = {}
    s["steps"] = {}
    s["step_count"] = 0
    s["current"] = 0
    s["status"] = "pending"
    s["compensated"] = 0
    s

fn saga_add_step(s: dict, name: string) -> dict
    let key = "step_" + str(s["step_count"])
    s["steps"][key + "_name"] = name
    s["steps"][key + "_status"] = "pending"
    s["step_count"] = s["step_count"] + 1
    s

fn saga_execute_step(s: dict) -> Result
    if s["current"] >= s["step_count"]
        return err("all steps completed")
    if s["status"] == "failed"
        return err("saga already failed")
    let key = "step_" + str(s["current"])
    s["steps"][key + "_status"] = "completed"
    s["current"] = s["current"] + 1
    if s["current"] == s["step_count"]
        s["status"] = "completed"
    else
        s["status"] = "running"
    ok(s)

fn saga_fail_step(s: dict, reason: string) -> dict
    let key = "step_" + str(s["current"])
    s["steps"][key + "_status"] = "failed"
    s["status"] = "failed"
    s

fn saga_compensate(s: dict) -> dict
    let i = s["current"] - 1
    while i >= 0
        let key = "step_" + str(i)
        if s["steps"][key + "_status"] == "completed"
            s["steps"][key + "_status"] = "compensated"
            s["compensated"] = s["compensated"] + 1
        i = i - 1
    s["status"] = "compensated"
    s

fn saga_status(s: dict) -> string
    s["status"]

fn saga_step_count(s: dict) -> int
    s["step_count"]

fn saga_step_name(s: dict, idx: int) -> Result
    if idx < 0 or idx >= s["step_count"]
        return err("index out of range")
    let key = "step_" + str(idx)
    ok(s["steps"][key + "_name"])

fn saga_compensated_count(s: dict) -> int
    s["compensated"]

fn saga_progress(s: dict) -> int
    if s["step_count"] == 0
        return 0
    s["current"] * 100 / s["step_count"]
