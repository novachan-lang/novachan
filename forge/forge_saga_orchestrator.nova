// forge_saga_orchestrator — Saga orchestrator for distributed transactions.
// Define steps with compensations, execute forward, compensate on failure.

fn so_new(name: string) -> dict
    let so = {}
    so["name"] = name
    so["steps"] = []
    so["current_step"] = 0
    so["status"] = "pending"
    so["completed_steps"] = 0
    so["compensated_steps"] = 0
    so

fn so_add_step(so: dict, step_name: string, compensation: string) -> dict
    let s = {}
    s["name"] = step_name
    s["compensation"] = compensation
    s["status"] = "pending"
    push(so["steps"], s)
    so

fn so_execute_next(so: dict) -> dict
    let idx = so["current_step"]
    if idx >= len(so["steps"])
        so["status"] = "completed"
        return so
    so["steps"][idx]["status"] = "done"
    so["current_step"] = idx + 1
    so["completed_steps"] = so["completed_steps"] + 1
    if so["current_step"] >= len(so["steps"])
        so["status"] = "completed"
    else
        so["status"] = "running"
    so

fn so_fail_current(so: dict) -> dict
    let idx = so["current_step"]
    if idx >= len(so["steps"])
        return so
    so["steps"][idx]["status"] = "failed"
    so["status"] = "compensating"
    so

fn so_compensate(so: dict) -> dict
    let i = so["completed_steps"] - 1
    while i >= 0
        so["steps"][i]["status"] = "compensated"
        so["compensated_steps"] = so["compensated_steps"] + 1
        i = i - 1
    so["status"] = "compensated"
    so

fn so_current_step_name(so: dict) -> string
    let idx = so["current_step"]
    if idx >= len(so["steps"])
        return ""
    so["steps"][idx]["name"]

fn so_status(so: dict) -> string
    so["status"]

fn so_step_count(so: dict) -> int
    len(so["steps"])

fn so_completed_count(so: dict) -> int
    so["completed_steps"]

fn so_compensated_count(so: dict) -> int
    so["compensated_steps"]

fn so_step_status(so: dict, step_name: string) -> string
    let i = 0
    while i < len(so["steps"])
        if so["steps"][i]["name"] == step_name
            return so["steps"][i]["status"]
        i = i + 1
    ""
