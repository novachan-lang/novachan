// forge_anomaly_detector -- z-score-style anomaly detection: feed values and ask whether a new value is
// anomalous relative to the population's variance. Like forge_anomaly_scorer but uses the SQUARE of the
// z-score (deviation^2 vs threshold^2 * variance) to avoid a square-root, so it works entirely in int
// arithmetic. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Four problems:
//
//   1. ad_new built the state dict as six individual assignments to an empty dict. That is one dict
//      literal -- the fields and their defaults are the contract, and scattering them across six lines
//      hides the shape.
//   2. ad_record used `a["sum"] = a["sum"] + value` at three sites -- compound assignment.
//   3. ad_is_anomaly computed `abs(value - mean)` as `let diff = value - mean; if diff < 0: diff =
//      0 - diff`. `abs` is that.
//   4. ad_is_anomaly used `is_err(var_r)` + `unwrap(var_r)` -- the two-step pattern that `?` replaces.

fn ad_new(threshold: int) -> dict
    {"threshold": threshold, "values": {}, "count": 0, "sum": 0, "sum_sq": 0, "anomalies": 0}

fn ad_record(a: dict, value: int) -> dict
    let idx = a["count"]
    a["values"]["v_{idx}"] = value
    a["sum"] += value
    a["sum_sq"] += value * value
    a["count"] += 1
    a

fn ad_mean(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    ok(a["sum"] / a["count"])

fn ad_variance(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    let mean = a["sum"] / a["count"]
    let mean_sq = a["sum_sq"] / a["count"]
    ok(mean_sq - mean * mean)

fn ad_is_anomaly(a: dict, value: int) -> Result
    if a["count"] < 2
        return err("need at least 2 samples")
    let mean = a["sum"] / a["count"]
    let diff = abs(value - mean)
    let variance = ad_variance(a)?
    if variance == 0
        if diff > 0
            return ok(1)
        return ok(0)
    let deviation_sq = diff * diff
    let threshold_sq = a["threshold"] * a["threshold"] * variance
    if deviation_sq > threshold_sq
        a["anomalies"] += 1
        return ok(1)
    ok(0)

fn ad_anomaly_count(a: dict) -> int
    a["anomalies"]

fn ad_sample_count(a: dict) -> int
    a["count"]
