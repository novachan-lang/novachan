// forge_anomaly_detector — simple anomaly detection (z-score style) with Result API.

fn ad_new(threshold: int) -> dict
    let a = {}
    a["threshold"] = threshold
    a["values"] = {}
    a["count"] = 0
    a["sum"] = 0
    a["sum_sq"] = 0
    a["anomalies"] = 0
    a

fn ad_record(a: dict, value: int) -> dict
    let key = "v_" + str(a["count"])
    a["values"][key] = value
    a["sum"] = a["sum"] + value
    a["sum_sq"] = a["sum_sq"] + value * value
    a["count"] = a["count"] + 1
    a

fn ad_mean(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    ok(a["sum"] / a["count"])

fn ad_variance(a: dict) -> Result
    if a["count"] == 0
        return err("no data")
    let mean = a["sum"] / a["count"]
    let mean_sq = a["sum_sq"] / a["count"]
    ok(mean_sq - mean * mean)

fn ad_is_anomaly(a: dict, value: int) -> Result
    if a["count"] < 2
        return err("need at least 2 samples")
    let mean = a["sum"] / a["count"]
    let diff = value - mean
    if diff < 0
        diff = 0 - diff
    let var_r = ad_variance(a)
    if is_err(var_r)
        return err("cannot compute variance")
    let variance = unwrap(var_r)
    if variance == 0
        if diff > 0
            return ok(1)
        return ok(0)
    let deviation_sq = diff * diff
    let threshold_sq = a["threshold"] * a["threshold"] * variance
    if deviation_sq > threshold_sq
        a["anomalies"] = a["anomalies"] + 1
        return ok(1)
    ok(0)

fn ad_anomaly_count(a: dict) -> int
    a["anomalies"]

fn ad_sample_count(a: dict) -> int
    a["count"]
