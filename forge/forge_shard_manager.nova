// forge_shard_manager — Partition data across nodes by shard ID.

fn sm_new(shard_count: int) -> dict
    let sm = {}
    sm["shard_count"] = shard_count
    sm["assignments"] = {}
    sm["moves"] = 0
    let i = 0
    while i < shard_count
        sm["assignments"][str(i)] = ""
        i = i + 1
    sm

fn sm_assign(sm: dict, shard_id: int, node: string) -> dict
    if shard_id < 0
        return sm
    if shard_id >= sm["shard_count"]
        return sm
    let k = str(shard_id)
    let old = sm["assignments"][k]
    sm["assignments"][k] = node
    if len(old) > 0
        sm["moves"] = sm["moves"] + 1
    sm

fn sm_lookup(sm: dict, shard_id: int) -> string
    if shard_id < 0
        return ""
    if shard_id >= sm["shard_count"]
        return ""
    sm["assignments"][str(shard_id)]

fn sm_key_to_shard(sm: dict, key: string) -> int
    let h = 0
    let i = 0
    while i < len(key)
        let c = ord(key[i])
        h = (h * 31 + c) % 1000000007
        i = i + 1
    let s = h % sm["shard_count"]
    s

fn sm_node_for_key(sm: dict, key: string) -> string
    let sid = sm_key_to_shard(sm, key)
    sm_lookup(sm, sid)

fn sm_total_moves(sm: dict) -> int
    sm["moves"]

fn sm_unassigned_count(sm: dict) -> int
    let count = 0
    let i = 0
    while i < sm["shard_count"]
        let node = sm["assignments"][str(i)]
        if len(node) == 0
            count = count + 1
        i = i + 1
    count

fn sm_shard_count(sm: dict) -> int
    sm["shard_count"]
