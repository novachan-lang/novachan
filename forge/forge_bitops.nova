// forge_bitops -- classic low-level bit-manipulation primitives (the "Hacker's Delight" toolkit).
// Operates on NON-NEGATIVE integers; width must be 1..63. LEAF -- imports NOTHING.

fn bit_length(n: int) -> int
    let count = 0
    let v = n
    while v > 0
        count += 1
        v = v / 2
    count

fn is_power_of_two(n: int) -> bool
    n > 0 and (n & (n - 1)) == 0

fn next_power_of_two(n: int) -> int
    let p = 1
    while p < n
        p = p * 2
    p

fn prev_power_of_two(n: int) -> int
    if n < 1
        return 0
    let p = 1
    while p * 2 <= n
        p = p * 2
    p

fn count_trailing_zeros(n: int) -> int
    if n <= 0
        return -1
    let v = n
    let c = 0
    while (v & 1) == 0
        c += 1
        v = v / 2
    c

fn count_leading_zeros(n: int, width: int) -> int
    width - bit_length(n)

fn reverse_bits(n: int, width: int) -> int
    let out = 0
    for i in 0..width
        if ((n >> i) & 1) == 1
            out = out | (1 << (width - 1 - i))
    out

fn rotate_left(n: int, k: int, width: int) -> int
    let mask = (1 << width) - 1
    let s = k % width
    let base = n & mask
    ((base << s) | (base >> (width - s))) & mask if s != 0 else base

fn rotate_right(n: int, k: int, width: int) -> int
    let mask = (1 << width) - 1
    let s = k % width
    let base = n & mask
    ((base >> s) | (base << (width - s))) & mask if s != 0 else base

fn parity(n: int) -> int
    let v = n
    let bits = 0
    while v > 0
        bits += (v & 1)
        v = v / 2
    bits % 2
