// forge_bitops -- the classic low-level bit-manipulation primitives (the "Hacker's Delight" toolkit). These are
// the small integer tricks that power hash tables (round a capacity up to a power of two), memory allocators
// (align sizes, find a free slot with trailing-zero count), compression and codecs (reverse/rotate bit fields),
// bitsets, and hardware/protocol code. Each is O(bits) and allocation-free. Everything here operates on
// NON-NEGATIVE integers and, where a bit WIDTH matters (reverse/rotate/leading-zeros), on the low `width` bits
// (width must be 1..63 -- NOVA's 1<<64 is unreliable). forge_binary handles int<->binary-STRING and popcount;
// forge_bitset is a multi-word bit array. This module is the scalar bit-math. LEAF -- imports NOTHING.

// The number of bits needed to represent n (the position of its highest set bit, +1). bit_length(0)=0,
// bit_length(1)=1, bit_length(255)=8, bit_length(256)=9. Equivalent to floor(log2(n))+1 for n>0.
fn bit_length(n: int) -> int
    let count = 0
    let v = n
    while v > 0
        count += 1
        v = v / 2
    count

// True if n is an exact power of two (1, 2, 4, 8, ...). Zero and negatives are false.
fn is_power_of_two(n: int) -> bool
    let ok = false
    if n > 0 and (n & (n - 1)) == 0
        ok = true
    ok

// The smallest power of two >= n (rounds a value UP to a power of two). next_power_of_two(0)=1,
// next_power_of_two(1)=1, next_power_of_two(5)=8, next_power_of_two(8)=8. Used to size hash tables/buffers.
fn next_power_of_two(n: int) -> int
    let p = 1
    while p < n
        p = p * 2
    p

// The largest power of two <= n (rounds DOWN). prev_power_of_two(5)=4, prev_power_of_two(8)=8; 0 for n<1.
fn prev_power_of_two(n: int) -> int
    let out = 0
    if n >= 1
        let p = 1
        while p * 2 <= n
            p = p * 2
        out = p
    out

// The number of trailing zero bits of n (the index of its lowest set bit) -- e.g. how many times n is divisible
// by two. count_trailing_zeros(8)=3, (12)=2, (1)=0. Returns -1 for n<=0 (undefined).
fn count_trailing_zeros(n: int) -> int
    let out = 0 - 1
    if n > 0
        let v = n
        let c = 0
        while (v & 1) == 0
            c += 1
            v = v / 2
        out = c
    out

// The number of leading zero bits of n within a field of `width` bits. count_leading_zeros(1,8)=7,
// (255,8)=0, (0,8)=8, (16,8)=3. Requires 0 <= n < 2^width and 1 <= width <= 63.
fn count_leading_zeros(n: int, width: int) -> int
    width - bit_length(n)

// Reverse the low `width` bits of n (bit i <-> bit width-1-i). reverse_bits(1,8)=128, reverse_bits(11,4)=13
// (1011 -> 1101). Used in FFT bit-reversal permutations and some codecs.
fn reverse_bits(n: int, width: int) -> int
    let out = 0
    for i in 0..width
        if ((n >> i) & 1) == 1
            out = out | (1 << (width - 1 - i))
    out

// Rotate the low `width` bits of n LEFT by k positions (bits that fall off the top wrap to the bottom).
// rotate_left(1,1,4)=2, rotate_left(8,1,4)=1.
fn rotate_left(n: int, k: int, width: int) -> int
    let mask = (1 << width) - 1
    let s = k % width
    let base = n & mask
    let out = base
    if s != 0
        out = ((base << s) | (base >> (width - s))) & mask
    out

// Rotate the low `width` bits of n RIGHT by k positions. rotate_right(1,1,4)=8, rotate_right(8,1,4)=4.
fn rotate_right(n: int, k: int, width: int) -> int
    let mask = (1 << width) - 1
    let s = k % width
    let base = n & mask
    let out = base
    if s != 0
        out = ((base >> s) | (base << (width - s))) & mask
    out

// The parity of n: 1 if it has an ODD number of set bits, 0 if even. parity(0)=0, parity(1)=1, parity(3)=0,
// parity(7)=1. Used for simple error-detection (a parity bit).
fn parity(n: int) -> int
    let v = n
    let bits = 0
    while v > 0
        bits += (v & 1)
        v = v / 2
    bits % 2
