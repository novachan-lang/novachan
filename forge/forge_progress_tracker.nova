// forge_progress_tracker — track progress of named tasks with Result API.

fn pt_new() -> dict
    let p = {}
    p["tasks"] = {}
    p["task_count"] = 0
    p["completed_count"] = 0
    p

fn pt_add(p: dict, name: string, total: int) -> dict
    let tk = "t_" + name
    p["tasks"][tk + "_total"] = total
    p["tasks"][tk + "_done"] = 0
    p["task_count"] = p["task_count"] + 1
    p

fn pt_advance(p: dict, name: string, amount: int) -> Result
    let tk = "t_" + name
    if contains(p["tasks"], tk + "_total") != true
        return err("task not found: " + name)
    let done = p["tasks"][tk + "_done"] + amount
    let total = p["tasks"][tk + "_total"]
    if done > total
        done = total
    p["tasks"][tk + "_done"] = done
    if done == total
        p["completed_count"] = p["completed_count"] + 1
    ok(p)

fn pt_progress(p: dict, name: string) -> Result
    let tk = "t_" + name
    if contains(p["tasks"], tk + "_total") != true
        return err("task not found: " + name)
    let done = p["tasks"][tk + "_done"]
    let total = p["tasks"][tk + "_total"]
    let pct = (done * 100) / total
    ok(pct)

fn pt_is_complete(p: dict, name: string) -> int
    let tk = "t_" + name
    if contains(p["tasks"], tk + "_total") != true
        return 0
    if p["tasks"][tk + "_done"] == p["tasks"][tk + "_total"]
        return 1
    0

fn pt_done_count(p: dict, name: string) -> Result
    let tk = "t_" + name
    if contains(p["tasks"], tk + "_done") != true
        return err("task not found: " + name)
    ok(p["tasks"][tk + "_done"])

fn pt_task_count(p: dict) -> int
    p["task_count"]

fn pt_completed_count(p: dict) -> int
    p["completed_count"]
