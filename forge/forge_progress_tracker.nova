// forge_progress_tracker — track progress of named tasks with Result API.

fn pt_new() -> dict
    {"tasks": {}, "task_count": 0, "completed_count": 0}

fn pt_add(p: dict, name: string, total: int) -> dict
    let tk = "t_{name}"
    p["tasks"]["{tk}_total"] = total
    p["tasks"]["{tk}_done"] = 0
    p["task_count"] += 1
    p

fn pt_advance(p: dict, name: string, amount: int) -> Result
    let tk = "t_{name}"
    let total_key = "{tk}_total"
    if total_key not in p["tasks"]
        return err("task not found: {name}")
    let done_key = "{tk}_done"
    let done = p["tasks"][done_key] + amount
    let total = p["tasks"][total_key]
    if done > total
        done = total
    p["tasks"][done_key] = done
    if done == total
        p["completed_count"] += 1
    ok(p)

fn pt_progress(p: dict, name: string) -> Result
    let tk = "t_{name}"
    let total_key = "{tk}_total"
    if total_key not in p["tasks"]
        return err("task not found: {name}")
    let done = p["tasks"]["{tk}_done"]
    let total = p["tasks"][total_key]
    let pct = (done * 100) / total
    ok(pct)

fn pt_is_complete(p: dict, name: string) -> int
    let tk = "t_{name}"
    let total_key = "{tk}_total"
    if total_key not in p["tasks"]
        return 0
    1 if p["tasks"]["{tk}_done"] == p["tasks"][total_key] else 0

fn pt_done_count(p: dict, name: string) -> Result
    let tk = "t_{name}"
    let done_key = "{tk}_done"
    if done_key not in p["tasks"]
        return err("task not found: {name}")
    ok(p["tasks"][done_key])

fn pt_task_count(p: dict) -> int
    p["task_count"]

fn pt_completed_count(p: dict) -> int
    p["completed_count"]
