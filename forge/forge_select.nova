// forge_select -- order statistics: find the k-th smallest (or largest) element, or the median, WITHOUT fully
// sorting. Quickselect partitions around a pivot like quicksort but recurses into only ONE side, so it finds the
// value at a given rank in O(n) average time instead of O(n log n) for a full sort. Use it for the median of a
// dataset, a specific percentile, "the 3rd cheapest", top-k thresholds, and robust statistics where you only
// need one order statistic rather than the whole sorted order. It works on a copy, so your input is left
// untouched. Elements are integers; k is 0-indexed (k=0 is the smallest). LEAF -- imports NOTHING.

// PRIVATE: a copy of the list.
fn _sel_copy(arr: list) -> list
    let a = []
    let i = 0
    while i < len(arr)
        push(a, arr[i])
        i = i + 1
    a

// The k-th smallest element (0-indexed: k=0 -> minimum, k=len-1 -> maximum) via iterative quickselect. Returns 0
// if k is out of range.
fn kth_smallest(arr: list, k: int) -> int
    let n = len(arr)
    let out = 0
    if k >= 0 and k < n
        let a = _sel_copy(arr)
        let lo = 0
        let hi = n - 1
        let done = false
        while done == false
            if lo >= hi
                out = a[lo]
                done = true
            else
                // Lomuto partition around a[hi]
                let pivot = a[hi]
                let i = lo
                let j = lo
                while j < hi
                    if a[j] < pivot
                        let t = a[i]
                        a[i] = a[j]
                        a[j] = t
                        i = i + 1
                    j = j + 1
                let t2 = a[i]
                a[i] = a[hi]
                a[hi] = t2
                // now a[i] is in its final sorted position
                if i == k
                    out = a[i]
                    done = true
                else
                    if i < k
                        lo = i + 1
                    else
                        hi = i - 1
    out

// The k-th largest element (0-indexed: k=0 -> maximum).
fn kth_largest(arr: list, k: int) -> int
    kth_smallest(arr, len(arr) - 1 - k)

// The median. For an even count it's the average of the two middle values (hence a float).
fn median(arr: list) -> float
    let n = len(arr)
    let out = 0.0
    if n > 0
        if n % 2 == 1
            out = kth_smallest(arr, n / 2) * 1.0
        else
            let a1 = kth_smallest(arr, n / 2 - 1)
            let a2 = kth_smallest(arr, n / 2)
            out = (a1 * 1.0 + a2 * 1.0) / 2.0
    out
