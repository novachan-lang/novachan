// forge_dbscan -- density-based clustering that finds clusters of ANY shape and flags outliers, without being
// told how many clusters to expect. Where forge_kmeans needs you to pick k up front and assumes round, similar
// -sized blobs, DBSCAN discovers the clusters from the data's density: a cluster is a region where points are
// packed closely (each core point has at least `min_pts` neighbors within radius `eps`), clusters grow to
// include everything density-reachable, and points in no dense region are labelled NOISE (-1) -- genuine outlier
// detection for free. Use it for anomaly detection, spatial/geo grouping (irregular regions), or any clustering
// where the shape and count are unknown. Points are feature vectors; the result is a per-point cluster id (0,1,
// 2,... ; -1 = noise). Ranks by SQUARED distance (no sqrt edge). Imports forge_knn.

import forge_knn

// PRIVATE: indices of all points within radius (squared eps) of point i, including i itself.
fn _dbscan_region(points: list, i: int, eps_sq: float) -> list
    let out = []
    let j = 0
    while j < len(points)
        if (knn_distance_sq(points[i], points[j]) * 1.0) <= eps_sq
            push(out, j)
        j = j + 1
    out

// Cluster `points` by density. `eps` = neighborhood radius, `min_pts` = minimum neighbors (including self) for
// a core point. Returns a per-point cluster id list (0..; -1 = noise / outlier).
fn dbscan(points: list, eps: float, min_pts: int) -> list
    let n = len(points)
    let e = eps * 1.0
    let eps_sq = e * e
    let assign = []
    let visited = []
    let i = 0
    while i < n
        push(assign, 0 - 1)
        push(visited, 0)
        i = i + 1
    let cluster = 0
    let p = 0
    while p < n
        if visited[p] == 0
            visited[p] = 1
            let neighbors = _dbscan_region(points, p, eps_sq)
            if len(neighbors) >= min_pts
                // core point -> grow a new cluster from it
                assign[p] = cluster
                let queue = []
                let q = 0
                while q < len(neighbors)
                    push(queue, neighbors[q])
                    q = q + 1
                let qi = 0
                while qi < len(queue)
                    let pt = queue[qi]
                    if visited[pt] == 0
                        visited[pt] = 1
                        let pn = _dbscan_region(points, pt, eps_sq)
                        if len(pn) >= min_pts
                            let r = 0
                            while r < len(pn)
                                push(queue, pn[r])
                                r = r + 1
                    if assign[pt] == 0 - 1
                        assign[pt] = cluster
                    qi = qi + 1
                cluster = cluster + 1
        p = p + 1
    assign

// Number of clusters found (excludes noise).
fn dbscan_num_clusters(assignments: list) -> int
    let mx = 0 - 1
    let i = 0
    while i < len(assignments)
        if assignments[i] > mx
            mx = assignments[i]
        i = i + 1
    mx + 1

// Number of points labelled noise (-1).
fn dbscan_noise_count(assignments: list) -> int
    let c = 0
    let i = 0
    while i < len(assignments)
        if assignments[i] == 0 - 1
            c = c + 1
        i = i + 1
    c
