// forge_cqrs -- Command/Query bus (CQRS; Axon / MediatR / NestJS CQRS). Register a handler per named command
// or query; dispatch routes the message to its handler. Decouples callers from handlers ("CreateOrder" ->
// its handler) and gives ONE dispatch point to wrap with cross-cutting concerns (logging/tx/validation via
// forge_aspects). A handler is fn(payload) -> any (a command handler returns a Result; a query handler
// returns data). LEAF -- imports NOTHING (err/contains builtins).

fn cqrs_new() -> dict
    let b = {}
    b["handlers"] = {}
    b

// Register the single handler for `name` (a command or query name). Fluent.
fn cqrs_register(bus: dict, name: string, handler) -> dict
    let hs = bus["handlers"]
    hs[name] = handler
    bus

fn cqrs_has(bus: dict, name: string) -> bool
    contains(bus["handlers"], name)

// Dispatch `payload` to the handler for `name`; err("no handler...") if unregistered.
fn cqrs_dispatch(bus: dict, name: string, payload) -> any
    let hs = bus["handlers"]
    if contains(hs, name) == false
        return err("no handler for " + name)
    let h = hs[name]
    h(payload)
