// forge_idempotency_key — Idempotency keys for at-most-once request processing.

fn ik_new(max_keys: int) -> dict
    let ik = {}
    ik["keys"] = {}
    ik["timestamps"] = {}
    ik["max_keys"] = max_keys
    ik["hits"] = 0
    ik["misses"] = 0
    ik["counter"] = 0
    ik

fn ik_check(ik: dict, key: string) -> dict
    let result = {}
    let has = contains(ik["keys"], key)
    if has == true
        ik["hits"] = ik["hits"] + 1
        result["duplicate"] = 1
        result["response"] = ik["keys"][key]
    else
        ik["misses"] = ik["misses"] + 1
        result["duplicate"] = 0
        result["response"] = ""
    result["ik"] = ik
    result

fn ik_store(ik: dict, key: string, response: string) -> dict
    let has = contains(ik["keys"], key)
    if has == true
        return ik
    ik["counter"] = ik["counter"] + 1
    let cur_size = len(keys(ik["keys"]))
    if cur_size >= ik["max_keys"]
        let ts_keys = keys(ik["timestamps"])
        let oldest_key = ""
        let oldest_ts = ik["counter"] + 1
        for i in 0..len(ts_keys)
            let tk = ts_keys[i]
            if ik["timestamps"][tk] < oldest_ts
                oldest_ts = ik["timestamps"][tk]
                oldest_key = tk
        if len(oldest_key) > 0
            let new_keys = {}
            let new_ts = {}
            let all_k = keys(ik["keys"])
            for j in 0..len(all_k)
                if all_k[j] != oldest_key
                    new_keys[all_k[j]] = ik["keys"][all_k[j]]
                    new_ts[all_k[j]] = ik["timestamps"][all_k[j]]
            ik["keys"] = new_keys
            ik["timestamps"] = new_ts
    ik["keys"][key] = response
    ik["timestamps"][key] = ik["counter"]
    ik

fn ik_size(ik: dict) -> int
    len(keys(ik["keys"]))

fn ik_hit_rate(ik: dict) -> int
    let total = ik["hits"] + ik["misses"]
    if total == 0
        return 0
    ik["hits"] * 100 / total

fn ik_total_checks(ik: dict) -> int
    ik["hits"] + ik["misses"]
