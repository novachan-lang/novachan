// forge_content_disposition -- build the Content-Disposition header (RFC 6266) for file downloads and
// multipart parts. attachment("report.pdf") forces a browser "Save As"; a non-ASCII name additionally emits an
// RFC 5987 filename* (UTF-8, percent-encoded) so "résumé.pdf" downloads with the right name across browsers,
// plus a sanitized ASCII fallback. Prevents header-injection (control chars/quotes stripped). LEAF.

fn _cd_pct(s: string) -> string
    let unreserved = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
    let hexd = "0123456789ABCDEF"
    let out = ""
    for i in 0..len(s)
        let c = char_at(s, i)
        if find(unreserved, c) >= 0
            out += c
        else
            let b = ord(c)
            let hi = char_at(hexd, b / 16)
            let lo = char_at(hexd, b % 16)
            out += "%{hi}{lo}"
    out

// True if `s` is printable ASCII with no quote (safe for the simple quoted filename form).
fn _cd_is_ascii(s: string) -> bool
    for i in 0..len(s)
        let b = ord(char_at(s, i))
        if b < 32 or b > 126
            return false
        if char_at(s, i) == chr(34)
            return false
    true

// PRIVATE: strip to printable ASCII (no quotes/control) for the fallback filename; "download" if empty.
fn _cd_ascii_fallback(s: string) -> string
    let out_parts = []
    for i in 0..len(s)
        let c = char_at(s, i)
        let b = ord(c)
        if b >= 32 and b <= 126 and c != chr(34)
            push(out_parts, c)
    let out = join(out_parts, "")
    if len(out) == 0
        return "download"
    out

// Build a Content-Disposition value. `disposition` = "attachment" (Save As) or "inline" (render). ASCII names
// use the simple quoted form; non-ASCII names get an ASCII fallback + an RFC 5987 filename* (UTF-8).
fn content_disposition(disposition: string, filename: string) -> string
    let q = chr(34)
    if _cd_is_ascii(filename)
        return "{disposition}; filename={q}{filename}{q}"
    let fb = _cd_ascii_fallback(filename)
    let pct = _cd_pct(filename)
    "{disposition}; filename={q}{fb}{q}; filename*=UTF-8''{pct}"

// Force a download ("Save As").
fn attachment(filename: string) -> string
    content_disposition("attachment", filename)

// Render in the browser if possible.
fn inline_disposition(filename: string) -> string
    content_disposition("inline", filename)
