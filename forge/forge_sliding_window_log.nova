// forge_sliding_window_log — Sliding-window rate limiter using timestamp log.

fn swl_new(window_size: int, max_requests: int) -> dict
    {"window_size": window_size, "max_requests": max_requests, "log": {}, "log_count": 0, "allowed": 0, "denied": 0}

fn swl_request(s: dict, timestamp: int) -> dict
    let result = {}
    let cutoff = timestamp - s["window_size"]
    let new_log = {}
    let new_count = 0
    for i in 0..s["log_count"]
        let k = str(i)
        if k in s["log"]
            if s["log"][k] > cutoff
                new_log[str(new_count)] = s["log"][k]
                new_count += 1
    s["log"] = new_log
    s["log_count"] = new_count
    if new_count < s["max_requests"]
        s["log"][str(new_count)] = timestamp
        s["log_count"] = new_count + 1
        s["allowed"] += 1
        result["allowed"] = 1
    else
        s["denied"] += 1
        result["allowed"] = 0
    result["s"] = s
    result

fn swl_current_count(s: dict) -> int
    s["log_count"]

fn swl_total_allowed(s: dict) -> int
    s["allowed"]

fn swl_total_denied(s: dict) -> int
    s["denied"]

fn swl_window_size(s: dict) -> int
    s["window_size"]

fn swl_max_requests(s: dict) -> int
    s["max_requests"]
