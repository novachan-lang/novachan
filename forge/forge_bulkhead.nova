// forge_bulkhead — bulkhead isolation pattern with Result API.

fn bh_new(max_concurrent: int) -> dict
    {"max_concurrent": max_concurrent, "active": 0, "total_accepted": 0, "total_rejected": 0, "peak": 0}

fn bh_acquire(b: dict) -> Result
    if b["active"] >= b["max_concurrent"]
        b["total_rejected"] += 1
        return err("bulkhead full")
    b["active"] += 1
    if b["active"] > b["peak"]
        b["peak"] = b["active"]
    b["total_accepted"] += 1
    ok(b)

fn bh_release(b: dict) -> Result
    if b["active"] <= 0
        return err("no active requests")
    b["active"] -= 1
    ok(b)

fn bh_active(b: dict) -> int
    b["active"]

fn bh_available(b: dict) -> int
    b["max_concurrent"] - b["active"]

fn bh_peak(b: dict) -> int
    b["peak"]

fn bh_rejection_rate(b: dict) -> int
    let total = b["total_accepted"] + b["total_rejected"]
    if total == 0
        return 0
    b["total_rejected"] * 100 / total

fn bh_total_accepted(b: dict) -> int
    b["total_accepted"]

fn bh_total_rejected(b: dict) -> int
    b["total_rejected"]
