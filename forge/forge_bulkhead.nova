// forge_bulkhead -- the BULKHEAD resilience pattern (Resilience4j Bulkhead, Hystrix thread-pool isolation).
// Cap the number of CONCURRENT calls to a slow dependency so it cannot exhaust every worker and sink the
// whole app -- like a ship's watertight compartments, one flooded section doesn't drown the vessel. A simple
// counting semaphore: try to acquire a permit when a call starts, release when it ends; over the limit ->
// reject fast (shed load) rather than queue unboundedly. Single-process by design (the counter is plain
// state) -- for cross-task limiting, own the bulkhead inside ONE actor and gate calls through its channel.
// LEAF -- imports NOTHING.

fn bulkhead_new(max_concurrent: int) -> dict
    let b = {}
    b["max"] = max_concurrent
    b["active"] = 0
    b

// Try to enter. true = a permit was taken (you MUST release it later, even on error); false = at capacity.
fn bulkhead_try(b: dict) -> bool
    if b["active"] >= b["max"]
        return false
    b["active"] = b["active"] + 1
    true

// Return a permit when the call finishes (success AND error paths). Clamped at 0 (never goes negative).
fn bulkhead_release(b: dict) -> dict
    if b["active"] > 0
        b["active"] = b["active"] - 1
    b

fn bulkhead_active(b: dict) -> int
    b["active"]

// Free permits remaining (for a health gauge / an X-Concurrency-Available header).
fn bulkhead_available(b: dict) -> int
    let rem = b["max"] - b["active"]
    if rem < 0
        return 0
    rem
