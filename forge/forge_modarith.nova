// forge_modarith -- modular arithmetic building blocks: the extended Euclidean algorithm, the modular inverse,
// and the Chinese Remainder Theorem. These are the workhorses of cryptography (RSA key setup inverts an exponent
// mod phi(n); Diffie-Hellman and elliptic-curve math live in a modulus), rolling/hash functions, calendar and
// cycle math, and any "solve for x under these divisibility constraints" problem. ext_gcd returns not just
// gcd(a,b) but the coefficients (x,y) with a*x + b*y = gcd -- which directly gives the modular inverse (the
// number you multiply by to "divide" in modular arithmetic). crt stitches several remainder-mod-modulus
// congruences into one. Integers; keep moduli moderate (products must fit in i64). Pairs with forge_primes.
// LEAF -- imports NOTHING.

// Extended Euclidean algorithm: returns [g, x, y] where g = gcd(a,b) and a*x + b*y = g.
fn ext_gcd(a: int, b: int) -> list
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    while r != 0
        let q = old_r / r
        let tr = old_r - q * r
        old_r = r
        r = tr
        let ts = old_s - q * s
        old_s = s
        s = ts
        let tt = old_t - q * t
        old_t = t
        t = tt
    [old_r, old_s, old_t]

// The greatest common divisor of a and b (non-negative).
fn gcd(a: int, b: int) -> int
    let e = ext_gcd(a, b)
    let g = e[0]
    if g < 0
        g = -g
    g

// The modular inverse of a mod m: the value inv in [0,m) with (a*inv) mod m == 1, or -1 if a and m share a
// factor (no inverse exists).
fn mod_inverse(a: int, m: int) -> int
    let am = ((a % m) + m) % m
    let e = ext_gcd(am, m)
    let g = e[0]
    ((e[1] % m) + m) % m if g == 1 else -1

// Chinese Remainder Theorem: the unique x in [0, product-of-moduli) with x ≡ remainders[i] (mod moduli[i]) for
// all i, assuming the moduli are pairwise coprime. Returns -1 if the moduli are not coprime.
fn crt(remainders: list, moduli: list) -> int
    if len(remainders) == 0 or len(moduli) != len(remainders)
        return -1
    let r = ((remainders[0] % moduli[0]) + moduli[0]) % moduli[0]
    let m = moduli[0]
    for i in 1..len(remainders)
        let r2 = remainders[i]
        let m2 = moduli[i]
        let e = ext_gcd(m, m2)
        let g = e[0]
        if g != 1
            return -1
        let lcm = m * m2
        let diff = (((r2 - r) % m2) + m2) % m2
        let k = (diff * (((e[1] % m2) + m2) % m2)) % m2
        r = (((r + m * k) % lcm) + lcm) % lcm
        m = lcm
    r
