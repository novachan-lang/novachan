// forge_diophantine -- solve the linear Diophantine equation a*x + b*y = c over the INTEGERS: not "what real x,y
// work" but "what whole-number x,y work", and ALL of them. This is the math behind coin/postage problems (can I
// make c cents from coins of value a and b, and how?), tiling and scheduling counts, converting between two
// periodic cycles, and the constructive core of the Chinese Remainder Theorem and modular inverses. A solution in
// integers exists if and only if gcd(a,b) divides c; when it does, there are infinitely many, forming an
// arithmetic progression. diophantine returns a base solution (x0,y0) PLUS the step vector (dx,dy) so the caller
// can generate every solution as (x0 + k*dx, y0 + k*dy) for any integer k -- and helpers pick the smallest
// non-negative x or count solutions within a range. Built on the extended Euclidean algorithm; integers only,
// keep a,b,c moderate so products stay in signed 64-bit. Pairs with forge_modarith. LEAF -- imports NOTHING.

// PRIVATE: extended Euclid returning [g, x, y] with a*x + b*y = g (g may be signed here).
fn _dio_extgcd(a: int, b: int) -> list
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    while r != 0
        let q = old_r / r
        let tr = old_r - q * r
        old_r = r
        r = tr
        let ts = old_s - q * s
        old_s = s
        s = ts
        let tt = old_t - q * t
        old_t = t
        t = tt
    [old_r, old_s, old_t]

// Solve a*x + b*y = c over the integers. Returns [x0, y0, dx, dy] such that every integer solution is
// (x0 + k*dx, y0 + k*dy) for k in ..,-1,0,1,.. ; returns an EMPTY list if no integer solution exists. Special
// cases: if a and b are both 0, returns [0,0,0,0] when c is also 0 (every pair works) else empty.
fn diophantine(a: int, b: int, c: int) -> list
    let out = []
    if a == 0 and b == 0
        if c == 0
            out = [0, 0, 0, 0]
    else
        let bez = _dio_extgcd(a, b)
        let g = bez[0]
        let x0 = bez[1]
        let y0 = bez[2]
        if g < 0
            g = 0 - g
            x0 = 0 - x0
            y0 = 0 - y0
        if c % g == 0
            let factor = c / g
            let sx = x0 * factor
            let sy = y0 * factor
            let dx = b / g
            let dy = 0 - (a / g)
            out = [sx, sy, dx, dy]
    out

// The smallest x >= 0 that solves a*x + b*y = c (with the matching y), returned as [x, y], or an empty list if
// there is no solution at all. Requires b != 0 (so x can be stepped). Useful for "fewest of coin a" style answers.
fn diophantine_min_x(a: int, b: int, c: int) -> list
    let out = []
    let base = diophantine(a, b, c)
    if len(base) == 4
        let x0 = base[0]
        let y0 = base[1]
        let dx = base[2]
        let dy = base[3]
        if dx == 0
            // x is fixed; it is a solution only if that fixed x is >= 0
            if x0 >= 0
                out = [x0, y0]
        else
            let ax = dx
            if ax < 0
                ax = 0 - ax
            out = _dio_normalize_min(x0, y0, dx, dy, ax)
    out

// PRIVATE: given base (x0,y0), step dx (nonzero), dy, and ax=|dx|, return [x,y] with the smallest x >= 0.
fn _dio_normalize_min(x0: int, y0: int, dx: int, dy: int, ax: int) -> list
    // find k so that x0 + k*dx is the smallest value >= 0
    // solve for k: we want x0 + k*dx >= 0 and minimal. Iterate k in unit steps of sign(dx) toward 0-crossing.
    let x = x0
    let y = y0
    // bring x down while staying >= 0
    while x - ax >= 0
        if dx > 0
            x = x - dx
            y = y - dy
        else
            x = x + dx
            y = y + dy
    // bring x up while it is negative
    while x < 0
        if dx > 0
            x = x + dx
            y = y + dy
        else
            x = x - dx
            y = y - dy
    [x, y]

// True if a*x + b*y == c for the given integers (a direct verification helper).
fn dio_check(a: int, b: int, c: int, x: int, y: int) -> bool
    a * x + b * y == c
