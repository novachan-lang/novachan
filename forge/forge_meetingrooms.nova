// forge_meetingrooms -- how many resources do a set of time intervals need AT ONCE? min_meeting_rooms is the
// classic "minimum number of meeting rooms" question: given meetings with start/end times, find the greatest number
// that are ever in progress simultaneously -- that peak overlap is exactly how many rooms (or servers, machines,
// nurses, lanes) you must provision. The elegant trick is a two-pointer SWEEP: sort all the start times and all the
// end times separately, then walk a clock forward; each start that happens before the next end needs a new room,
// each end frees one, and the high-water mark is the answer -- O(n log n), no per-minute simulation. can_attend_all
// is the special case of asking whether ONE room suffices (no two meetings overlap at all). This is the core of
// scheduling and capacity planning: room/resource allocation, connection-pool sizing, rate-of-concurrency limits,
// and detecting double-bookings. Intervals are [start, end] with end exclusive (a meeting ending at t frees the
// room for one starting at t). LEAF -- imports NOTHING.

// PRIVATE: insertion-sort a copy of an int list ascending.
fn _mr_sorted(xs: list) -> list
    let out = [xs[i] for i in 0..len(xs)]
    let a = 1
    while a < len(out)
        let key = out[a]
        let b = a - 1
        while b >= 0 and out[b] > key
            out[b + 1] = out[b]
            b -= 1
        out[b + 1] = key
        a += 1
    out

// The minimum number of rooms needed so that no two overlapping intervals share one = the maximum number of
// intervals overlapping at any instant. min_meeting_rooms([[0,30],[5,10],[15,20]]) = 2.
fn min_meeting_rooms(intervals: list) -> int
    let n = len(intervals)
    let out = 0
    if n > 0
        let starts = []
        let ends = []
        let i = 0
        while i < n
            push(starts, intervals[i][0])
            push(ends, intervals[i][1])
            i += 1
        let ss = _mr_sorted(starts)
        let ee = _mr_sorted(ends)
        let rooms = 0
        let best = 0
        let si = 0
        let ei = 0
        while si < n
            if ss[si] < ee[ei]
                rooms += 1
                if rooms > best
                    best = rooms
                si += 1
            else
                rooms -= 1
                ei += 1
        out = best
    out

// True if a single room suffices -- i.e. no two intervals overlap (end-exclusive).
fn can_attend_all(intervals: list) -> bool
    let out = false
    if min_meeting_rooms(intervals) <= 1
        out = true
    out
