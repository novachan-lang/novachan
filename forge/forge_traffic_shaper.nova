// forge_traffic_shaper — Token bucket traffic shaping.

fn tsh_new(rate: int, burst: int) -> dict
    let t = {}
    t["rate"] = rate
    t["burst"] = burst
    t["tokens"] = burst
    t["last_refill"] = 0
    t["total_allowed"] = 0
    t["total_shaped"] = 0
    t

fn tsh_refill(t: dict, now: int) -> dict
    let elapsed = now - t["last_refill"]
    if elapsed <= 0
        return t
    let new_tokens = elapsed * t["rate"]
    t["tokens"] = t["tokens"] + new_tokens
    if t["tokens"] > t["burst"]
        t["tokens"] = t["burst"]
    t["last_refill"] = now
    t

fn tsh_consume(t: dict, amount: int, now: int) -> dict
    t = tsh_refill(t, now)
    let result = {}
    if t["tokens"] >= amount
        t["tokens"] = t["tokens"] - amount
        t["total_allowed"] = t["total_allowed"] + 1
        result["allowed"] = 1
    else
        t["total_shaped"] = t["total_shaped"] + 1
        result["allowed"] = 0
    result["tokens_left"] = t["tokens"]
    result["t"] = t
    result

fn tsh_tokens_available(t: dict) -> int
    t["tokens"]

fn tsh_total_allowed(t: dict) -> int
    t["total_allowed"]

fn tsh_total_shaped(t: dict) -> int
    t["total_shaped"]

fn tsh_shape_rate(t: dict) -> int
    let total = t["total_allowed"] + t["total_shaped"]
    if total == 0
        return 0
    t["total_shaped"] * 100 / total
