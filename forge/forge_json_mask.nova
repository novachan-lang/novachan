// forge_json_mask -- recursively redact sensitive fields ANYWHERE in a nested dict/list (deep PII masking for
// logging + audit of nested request/response payloads). Any key in the sensitive set has its value replaced by
// "***" at any depth. Non-destructive: returns a masked COPY, leaving the real object intact. Complements
// forge_mask (flat, single-level). LEAF -- imports NOTHING.

fn _jm_mask(node: any, sensitive: dict) -> any
    let t = type_of(node)
    if t == "dict"
        let out = {}
        let ks = keys(node)
        let i = 0
        while i < len(ks)
            let k = ks[i]
            if contains(sensitive, k)
                out[k] = "***"
            else
                out[k] = _jm_mask(node[k], sensitive)
            i = i + 1
        return out
    if t == "list"
        let out = []
        let i = 0
        while i < len(node)
            push(out, _jm_mask(node[i], sensitive))
            i = i + 1
        return out
    node

// A deep COPY of `data` with every value under a key in `sensitive_keys` replaced by "***", at any depth.
fn json_mask(data: any, sensitive_keys: list) -> any
    let sset = {}
    let i = 0
    while i < len(sensitive_keys)
        sset[sensitive_keys[i]] = 1
        i = i + 1
    _jm_mask(data, sset)
