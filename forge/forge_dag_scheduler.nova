// forge_dag_scheduler — Schedule tasks respecting DAG dependencies.

fn ds_new() -> dict
    let d = {}
    d["tasks"] = {}
    d["deps"] = {}
    d["task_count"] = 0
    d["dep_count"] = 0
    d["completed"] = {}
    d["total_completed"] = 0
    d

fn ds_add_task(d: dict, name: string) -> dict
    let has = contains(d["tasks"], name)
    if has == true
        return d
    d["tasks"][name] = 1
    d["completed"][name] = 0
    d["task_count"] = d["task_count"] + 1
    d

fn ds_add_dep(d: dict, task: string, depends_on: string) -> dict
    let k = str(d["dep_count"])
    d["deps"][k + "_task"] = task
    d["deps"][k + "_dep"] = depends_on
    d["dep_count"] = d["dep_count"] + 1
    d

fn ds_is_ready(d: dict, task: string) -> int
    let i = 0
    while i < d["dep_count"]
        let k = str(i)
        if d["deps"][k + "_task"] == task
            let dep = d["deps"][k + "_dep"]
            if d["completed"][dep] != 1
                return 0
        i += 1
    1

fn ds_complete(d: dict, task: string) -> dict
    d["completed"][task] = 1
    d["total_completed"] = d["total_completed"] + 1
    d

fn ds_next_ready(d: dict) -> string
    let ks = keys(d["tasks"])
    for i in 0..len(ks)
        let t = ks[i]
        if d["completed"][t] == 0
            if ds_is_ready(d, t) == 1
                return t
    ""

fn ds_all_done(d: dict) -> int
    if d["total_completed"] == d["task_count"]
        return 1
    0

fn ds_progress(d: dict) -> int
    if d["task_count"] == 0
        return 100
    d["total_completed"] * 100 / d["task_count"]
