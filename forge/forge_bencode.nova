// forge_bencode -- Bencode, the compact serialization format BitTorrent uses for .torrent files and peer/tracker
// messages. It encodes four things -- integers, byte strings, lists, and dictionaries -- into an unambiguous,
// human-inspectable ASCII form: i42e is the integer 42, 4:spam is the string "spam", l...e wraps a list, and
// d...e a dictionary (whose keys MUST be emitted in sorted order, which makes the encoding CANONICAL -- the same
// data always produces byte-identical output, so you can hash it for integrity/deduplication). Bencode is a nice
// alternative to JSON when you want a tiny, dependency-free, deterministic format: config blobs, cache keys,
// message framing. Encoding walks a NOVA value (int/string/list/dict) recursively; decoding is a small recursive
// parser. This validates that NOVA values round-trip through a self-describing wire format. LEAF -- imports NOTHING.

// PRIVATE: is string a lexicographically before b?
fn _be_less(a: string, b: string) -> bool
    let n = len(a)
    if len(b) < n
        n = len(b)
    let out = false
    let decided = false
    let i = 0
    while i < n and decided == false
        let ca = ord(char_at(a, i))
        let cb = ord(char_at(b, i))
        if ca < cb
            out = true
            decided = true
        else
            if ca > cb
                decided = true
        i = i + 1
    if decided == false and len(a) < len(b)
        out = true
    out

// Encode a NOVA value (int, string, list, or dict) into a bencode string. Dict keys are emitted sorted (canonical).
fn bencode_encode(v) -> string
    let t = type_of(v)
    let out = ""
    if t == "int"
        out = "i" + str(v) + "e"
    else
        if t == "string"
            out = str(len(v)) + ":" + v
        else
            if t == "list"
                out = "l"
                let i = 0
                while i < len(v)
                    out = out + bencode_encode(v[i])
                    i = i + 1
                out = out + "e"
            else
                if t == "dict"
                    // sort keys for canonical output
                    let ks = keys(v)
                    let a = 1
                    while a < len(ks)
                        let keyv = ks[a]
                        let b = a - 1
                        while b >= 0 and _be_less(keyv, ks[b])
                            ks[b + 1] = ks[b]
                            b = b - 1
                        ks[b + 1] = keyv
                        a = a + 1
                    out = "d"
                    let j = 0
                    while j < len(ks)
                        out = out + bencode_encode(ks[j]) + bencode_encode(v[ks[j]])
                        j = j + 1
                    out = out + "e"
    out

// PRIVATE: parse a decimal integer string (leading '-' allowed).
fn _be_toint(s: string) -> int
    let neg = false
    let start = 0
    if len(s) > 0 and char_at(s, 0) == "-"
        neg = true
        start = 1
    let v = 0
    let i = start
    while i < len(s)
        v = v * 10 + (ord(char_at(s, i)) - 48)
        i = i + 1
    if neg
        v = 0 - v
    v

// PRIVATE: recursive parse at position p[0]; returns the decoded value (int/string/list/dict).
fn _be_parse(s: string, p: list)
    let c = char_at(s, p[0])
    if c == "i"
        p[0] = p[0] + 1
        let numstr = ""
        while char_at(s, p[0]) != "e"
            numstr = numstr + char_at(s, p[0])
            p[0] = p[0] + 1
        p[0] = p[0] + 1
        return _be_toint(numstr)
    if c == "l"
        p[0] = p[0] + 1
        let lst = []
        while char_at(s, p[0]) != "e"
            push(lst, _be_parse(s, p))
        p[0] = p[0] + 1
        return lst
    if c == "d"
        p[0] = p[0] + 1
        let dct = {}
        while char_at(s, p[0]) != "e"
            let k = _be_parse(s, p)
            let val = _be_parse(s, p)
            dct[k] = val
        p[0] = p[0] + 1
        return dct
    // byte string: <len>:<bytes>
    let numstr = ""
    while char_at(s, p[0]) != ":"
        numstr = numstr + char_at(s, p[0])
        p[0] = p[0] + 1
    p[0] = p[0] + 1
    let length = _be_toint(numstr)
    let sv = slice(s, p[0], p[0] + length)
    p[0] = p[0] + length
    sv

// Decode a bencode string into a NOVA value (int / string / list / dict).
fn bencode_decode(s: string)
    let p = [0]
    _be_parse(s, p)
