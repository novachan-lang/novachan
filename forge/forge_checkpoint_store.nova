// forge_checkpoint_store — Save/restore processing checkpoints.

fn cps_new() -> dict
    let c = {}
    c["checkpoints"] = {}
    c["data"] = {}
    c["count"] = 0
    c["restores"] = 0
    c

fn cps_save(c: dict, job_id: string, offset: int, state: string) -> dict
    c["checkpoints"][job_id + "_offset"] = offset
    c["checkpoints"][job_id + "_state"] = state
    let has = contains(c["data"], job_id)
    if has != true
        c["count"] = c["count"] + 1
        c["data"][job_id] = 1
    c

fn cps_restore(c: dict, job_id: string) -> dict
    let r = {}
    let has = contains(c["data"], job_id)
    if has != true
        r["found"] = 0
        r["offset"] = 0
        r["state"] = ""
        r["c"] = c
        return r
    c["restores"] = c["restores"] + 1
    r["found"] = 1
    r["offset"] = c["checkpoints"][job_id + "_offset"]
    r["state"] = c["checkpoints"][job_id + "_state"]
    r["c"] = c
    r

fn cps_delete(c: dict, job_id: string) -> dict
    c["data"][job_id] = 0
    c

fn cps_count(c: dict) -> int
    c["count"]

fn cps_total_restores(c: dict) -> int
    c["restores"]

fn cps_has(c: dict, job_id: string) -> int
    let has = contains(c["data"], job_id)
    if has == true
        if c["data"][job_id] == 1
            return 1
    0
