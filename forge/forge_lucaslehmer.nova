// forge_lucaslehmer -- Lucas-Lehmer primality test for Mersenne numbers M_p = 2^p - 1.
// This is THE definitive algorithm for finding the world's largest known primes. Every record since
// 1952 (from M_521 to M_136279841 in 2024, the 52nd known Mersenne prime) was found using this test.
// It is used by GIMPS (Great Internet Mersenne Prime Search), which runs on millions of volunteer CPUs.
// The algorithm: define the sequence s_0 = 4, s_{k+1} = s_k^2 - 2 (mod M_p).
//   M_p = 2^p - 1 is prime if and only if s_{p-2} == 0 (mod M_p).
// This is DETERMINISTIC and COMPLETE for Mersenne numbers (no probabilistic error, unlike Miller-Rabin).
// The modular reduction uses the identity: a mod (2^p - 1) = (a >> p) + (a & (2^p - 1)),
// which is cheap via bit operations (the standard GIMPS trick for large p).
//
// Practical range: p must be prime itself (M_p composite if p composite). Within i64 (p <= 61)
// the intermediate s_k^2 can be huge; we use 128-bit multiplication via the Russian-peasant mulmod
// from forge_factor to stay overflow-safe.
//
// API:
//   lucas_lehmer(p) -> bool    true iff 2^p - 1 is a Mersenne prime (p must be prime; p=2 special case)
//   mersenne_primes_up_to(max_p) -> list  all Mersenne prime exponents p in [2, max_p]
// LEAF (imports nothing).

// Overflow-safe addmod: (a + b) mod m, with a,b in [0,m).
fn _ll_addmod(a: int, b: int, m: int) -> int
    if a >= m - b
        return a - (m - b)
    return a + b

// Overflow-safe mulmod: (a * b) mod m via Russian-peasant double-and-add.
fn _ll_mulmod(a: int, b: int, m: int) -> int
    let r = 0
    let x = ((a % m) + m) % m
    let y = ((b % m) + m) % m
    while y > 0
        if y % 2 == 1
            r = _ll_addmod(r, x, m)
        x = _ll_addmod(x, x, m)
        y = y / 2
    return r

// Compute 2^p - 1 mod i64_max (capped). For p <= 62 this fits.
fn _ll_mersenne(p: int) -> int
    let m = 1
    for i in 0..p
        m *= 2
    return m - 1

// Test: is p prime? (small trial division, p up to ~62 in our range)
fn _ll_is_prime_small(p: int) -> bool
    if p < 2
        return false
    if p == 2
        return true
    if p % 2 == 0
        return false
    let d = 3
    while d * d <= p
        if p % d == 0
            return false
        d += 2
    return true

// Lucas-Lehmer test: returns true iff 2^p - 1 is a Mersenne prime.
// p must be a prime (if p is composite, M_p is guaranteed composite; this is not checked).
// Special case: p=2 -> M_2=3 is prime.
fn lucas_lehmer(p: int) -> bool
    if p == 2
        return true
    if p <= 1
        return false
    let m = _ll_mersenne(p)
    // s_0 = 4; iterate p-2 times: s = s*s - 2 (mod m)
    let s = 4
    for i in 0..(p - 2)
        // s = (s * s - 2) mod m; use mulmod for overflow safety
        let sq = _ll_mulmod(s, s, m)
        s = sq - 2
        if s < 0
            s += m
        s = s % m
    return s == 0

// Return all Mersenne prime exponents p in [2, max_p] (p must be prime for M_p to be prime).
fn mersenne_primes_up_to(max_p: int) -> list
    let result = []
    let p = 2
    while p <= max_p
        if _ll_is_prime_small(p)
            if lucas_lehmer(p)
                push(result, p)
        p += 1
    return result
