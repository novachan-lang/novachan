// forge_rate_window — Sliding window rate counter with Result.

fn rw_new(window_size: int) -> dict
    let r = {}
    r["window"] = window_size
    r["events"] = {}
    r["count"] = 0
    r["total"] = 0
    r["head"] = 0
    r

// _rw_evict_stale: drop events at the FRONT of the window (oldest-first) whose timestamp is
// <= cutoff, using the exact same in-window test as rw_count_in_window (`ts > cutoff` == in
// window, so `ts <= cutoff` == stale) so eviction can never disagree with counting. Advances
// r["head"] past every evicted index so rw_count_in_window / rw_oldest_in_window never rescan
// dead entries -- this bounds BOTH the backing dict's size AND every later scan's cost by
// "events currently within the window", instead of "events ever recorded" (the unbounded-growth
// leak this fixes). Assumes rw_record is called with non-decreasing timestamps, the normal
// real-time recording pattern for a sliding-window rate counter.
fn _rw_evict_stale(r: dict, cutoff: int)
    while r["head"] < r["count"]
        let k = str(r["head"])
        if r["events"][k] > cutoff
            return
        r["events"].del(k)
        r["head"] = r["head"] + 1

fn rw_record(r: dict, timestamp: int) -> dict
    let k = str(r["count"])
    r["events"][k] = timestamp
    r["count"] = r["count"] + 1
    r["total"] = r["total"] + 1
    _rw_evict_stale(r, timestamp - r["window"])
    r

fn rw_count_in_window(r: dict, now: int) -> int
    let cutoff = now - r["window"]
    let c = 0
    let i = r["head"]
    while i < r["count"]
        let ts = r["events"][str(i)]
        if ts > cutoff
            c += 1
        i += 1
    c

fn rw_rate_per_second(r: dict, now: int) -> Result
    if r["window"] == 0
        return err("window size is zero")
    let c = rw_count_in_window(r, now)
    ok(c * 1000 / r["window"])

fn rw_total(r: dict) -> int
    r["total"]

fn rw_oldest_in_window(r: dict, now: int) -> Result
    let cutoff = now - r["window"]
    let oldest = now
    let found = 0
    let i = r["head"]
    while i < r["count"]
        let ts = r["events"][str(i)]
        if ts > cutoff
            if ts < oldest
                oldest = ts
            found = 1
        i += 1
    if found == 0
        return err("no events in window")
    ok(oldest)

fn rw_is_over_limit(r: dict, now: int, limit: int) -> int
    let c = rw_count_in_window(r, now)
    if c > limit
        return 1
    0
