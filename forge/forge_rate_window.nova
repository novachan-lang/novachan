// forge_rate_window — Sliding window rate counter with Result.

fn rw_new(window_size: int) -> dict
    let r = {}
    r["window"] = window_size
    r["events"] = {}
    r["count"] = 0
    r["total"] = 0
    r

fn rw_record(r: dict, timestamp: int) -> dict
    let k = str(r["count"])
    r["events"][k] = timestamp
    r["count"] = r["count"] + 1
    r["total"] = r["total"] + 1
    r

fn rw_count_in_window(r: dict, now: int) -> int
    let cutoff = now - r["window"]
    let c = 0
    let i = 0
    while i < r["count"]
        let ts = r["events"][str(i)]
        if ts > cutoff
            c = c + 1
        i = i + 1
    c

fn rw_rate_per_second(r: dict, now: int) -> Result
    if r["window"] == 0
        return err("window size is zero")
    let c = rw_count_in_window(r, now)
    ok(c * 1000 / r["window"])

fn rw_total(r: dict) -> int
    r["total"]

fn rw_oldest_in_window(r: dict, now: int) -> Result
    let cutoff = now - r["window"]
    let oldest = now
    let found = 0
    let i = 0
    while i < r["count"]
        let ts = r["events"][str(i)]
        if ts > cutoff
            if ts < oldest
                oldest = ts
            found = 1
        i = i + 1
    if found == 0
        return err("no events in window")
    ok(oldest)

fn rw_is_over_limit(r: dict, now: int, limit: int) -> int
    let c = rw_count_in_window(r, now)
    if c > limit
        return 1
    0
