// forge_notification_queue — typed notification queue with priority and Result API.

fn nq_new() -> dict
    let n = {}
    n["count"] = 0
    n["read_count"] = 0
    n["total_sent"] = 0
    n

fn nq_send(n: dict, recipient: string, message: string, priority: int) -> dict
    let idx = n["count"]
    n["n_" + str(idx) + "_to"] = recipient
    n["n_" + str(idx) + "_msg"] = message
    n["n_" + str(idx) + "_pri"] = priority
    n["n_" + str(idx) + "_read"] = 0
    n["count"] = idx + 1
    n["total_sent"] = n["total_sent"] + 1
    n

fn nq_read(n: dict, index: int) -> Result
    if index < 0 or index >= n["count"]
        return err("notification index out of range")
    if n["n_" + str(index) + "_read"] == 0
        n["n_" + str(index) + "_read"] = 1
        n["read_count"] = n["read_count"] + 1
    ok(n["n_" + str(index) + "_msg"])

fn nq_recipient(n: dict, index: int) -> Result
    if index < 0 or index >= n["count"]
        return err("notification index out of range")
    ok(n["n_" + str(index) + "_to"])

fn nq_priority(n: dict, index: int) -> Result
    if index < 0 or index >= n["count"]
        return err("notification index out of range")
    ok(n["n_" + str(index) + "_pri"])

fn nq_highest_priority(n: dict) -> Result
    if n["count"] == 0
        return err("queue empty")
    let best_idx = 0
    let best_pri = n["n_0_pri"]
    let i = 1
    while i < n["count"]
        let pri = n["n_" + str(i) + "_pri"]
        if pri > best_pri
            best_pri = pri
            best_idx = i
        i += 1
    ok(best_idx)

fn nq_total(n: dict) -> int
    n["count"]

fn nq_unread_count(n: dict) -> int
    n["count"] - n["read_count"]

fn nq_total_sent(n: dict) -> int
    n["total_sent"]
