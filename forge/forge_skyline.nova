// forge_skyline -- the classic "skyline problem": given a set of rectangular buildings (each a left edge, right
// edge, and height) viewed from far away, compute the OUTLINE of their combined silhouette as a list of key
// points where the height changes. It's the union/upper-envelope of overlapping rectangles, solved with a SWEEP:
// turn each building into a start and an end event, sweep left to right processing all events at each x together,
// keep a running tally of which heights are currently "active", and whenever the tallest active height changes,
// that x and the new height are a corner of the skyline. This exact upper-envelope computation powers rendering
// city silhouettes and layered charts, computing the union outline of intervals/rectangles, collision broad-phase,
// and "maximum coverage over time" from many overlapping [start,end,value] spans. Buildings are [left, right,
// height] with integer coordinates; output is [x, height] key points, ending with a drop to 0. LEAF.

// PRIVATE: parse a non-negative decimal string to int.
fn _sk_toint(s: string) -> int
    let v = 0
    for i in 0..len(s)
        v = v * 10 + (ord(char_at(s, i)) - 48)
    v

// The skyline of `buildings` (each [left, right, height]) as a list of [x, height] key points.
fn skyline(buildings: list) -> list
    // events: [x, height, is_start]
    let events = []
    for b in 0..len(buildings)
        let bl = buildings[b]
        push(events, [bl[0], bl[2], 1])
        push(events, [bl[1], bl[2], 0])
    let ne = len(events)
    // sort event indices by x (index array -> safe)
    let idx = [z for z in 0..ne]
    for a in 1..ne
        let key = idx[a]
        let kx = events[key][0]
        let p = a - 1
        while p >= 0 and events[idx[p]][0] > kx
            idx[p + 1] = idx[p]
            p -= 1
        idx[p + 1] = key
    // sweep, grouping events that share an x
    let active = {}
    active["0"] = 1
    let prev_max = 0
    let result = []
    let i = 0
    while i < ne
        let x = events[idx[i]][0]
        while i < ne and events[idx[i]][0] == x
            let e = events[idx[i]]
            let hkey = str(e[1])
            if e[2] == 1
                active[hkey] = get(active, hkey, 0) + 1
            else
                active[hkey] = get(active, hkey, 0) - 1
            i += 1
        // tallest currently-active height
        let cur_max = 0
        let ks = keys(active)
        for j in 0..len(ks)
            if active[ks[j]] > 0
                let hv = _sk_toint(ks[j])
                if hv > cur_max
                    cur_max = hv
        if cur_max != prev_max
            push(result, [x, cur_max])
            prev_max = cur_max
    result
