// forge_bignum -- arbitrary-precision (bignum) arithmetic on NON-NEGATIVE integers, represented as decimal
// strings. NOVA's native int is 64-bit and silently WRAPS past ~9.2e18; this module lets you compute with numbers
// of ANY size -- 100!, 2^1000, RSA-scale moduli, exact factorials/binomials/running totals that must never
// overflow. Numbers are plain base-10 digit strings ("0", "42", "1267650600228229401496703205376"), so they are
// trivial to read, print, store, and compare, at the cost of speed vs a limb-based representation (fine for exact
// results up to thousands of digits). Provides add, subtract (a>=b), multiply, compare, factorial and fast
// exponentiation -- the schoolbook algorithms, digit by digit. Division/modulo are intentionally omitted (a larger
// algorithm; add later if needed). Inputs must be non-negative decimal strings. LEAF -- imports NOTHING.

// PRIVATE: strip leading zeros; canonicalize empty/all-zero to "0".
fn _big_norm(s: string) -> string
    let out = "0"
    if len(s) > 0
        let i = 0
        while i < len(s) - 1 and char_at(s, i) == "0"
            i = i + 1
        let t = slice(s, i, len(s))
        if len(t) > 0
            out = t
    out

// Compare two bignums: -1 if a<b, 0 if equal, 1 if a>b.
fn big_cmp(a0: string, b0: string) -> int
    let a = _big_norm(a0)
    let b = _big_norm(b0)
    let out = 0
    if len(a) < len(b)
        out = 0 - 1
    else
        if len(a) > len(b)
            out = 1
        else
            let k = 0
            let decided = false
            while k < len(a) and decided == false
                let ca = ord(char_at(a, k))
                let cb = ord(char_at(b, k))
                if ca < cb
                    out = 0 - 1
                    decided = true
                else
                    if ca > cb
                        out = 1
                        decided = true
                k = k + 1
    out

// Add two non-negative bignums.
fn big_add(a0: string, b0: string) -> string
    let a = _big_norm(a0)
    let b = _big_norm(b0)
    let i = len(a) - 1
    let j = len(b) - 1
    let carry = 0
    let out = ""
    while i >= 0 or j >= 0 or carry > 0
        let da = 0
        if i >= 0
            da = ord(char_at(a, i)) - 48
            i = i - 1
        let db = 0
        if j >= 0
            db = ord(char_at(b, j)) - 48
            j = j - 1
        let s = da + db + carry
        carry = s / 10
        out = chr(48 + (s % 10)) + out
    _big_norm(out)

// Subtract b from a, assuming a >= b (result is non-negative). Use big_cmp first if unsure.
fn big_sub(a0: string, b0: string) -> string
    let a = _big_norm(a0)
    let b = _big_norm(b0)
    let i = len(a) - 1
    let j = len(b) - 1
    let borrow = 0
    let out = ""
    while i >= 0
        let da = ord(char_at(a, i)) - 48
        let db = 0
        if j >= 0
            db = ord(char_at(b, j)) - 48
        let d = da - db - borrow
        if d < 0
            d = d + 10
            borrow = 1
        else
            borrow = 0
        out = chr(48 + d) + out
        i = i - 1
        j = j - 1
    _big_norm(out)

// Multiply two non-negative bignums (schoolbook O(n*m)).
fn big_mul(a0: string, b0: string) -> string
    let a = _big_norm(a0)
    let b = _big_norm(b0)
    let out = "0"
    if a != "0" and b != "0"
        let na = len(a)
        let nb = len(b)
        // little-endian result digits
        let res = []
        let z = 0
        while z < na + nb
            push(res, 0)
            z = z + 1
        let i = na - 1
        while i >= 0
            let da = ord(char_at(a, i)) - 48
            let carry = 0
            let j = nb - 1
            while j >= 0
                let db = ord(char_at(b, j)) - 48
                let pos = (na - 1 - i) + (nb - 1 - j)
                let cur = res[pos] + da * db + carry
                res[pos] = cur % 10
                carry = cur / 10
                j = j - 1
            let pos2 = (na - 1 - i) + nb
            while carry > 0
                let cur2 = res[pos2] + carry
                res[pos2] = cur2 % 10
                carry = cur2 / 10
                pos2 = pos2 + 1
            i = i - 1
        // build big-endian string
        let s = ""
        let k = len(res) - 1
        while k >= 0
            s = s + chr(48 + res[k])
            k = k - 1
        out = _big_norm(s)
    out

// n! as a bignum (n >= 0). big_factorial(0) = big_factorial(1) = "1".
fn big_factorial(n: int) -> string
    let out = "1"
    let k = 2
    while k <= n
        out = big_mul(out, str(k))
        k = k + 1
    out

// base raised to a non-negative integer exponent, via fast (square-and-multiply) exponentiation.
fn big_pow(base: string, exp: int) -> string
    let out = "1"
    let b = _big_norm(base)
    let e = exp
    while e > 0
        if e % 2 == 1
            out = big_mul(out, b)
        b = big_mul(b, b)
        e = e / 2
    out

// Divide a by b (b != "0"), returning [quotient, remainder] via schoolbook long division. Both non-negative.
fn big_divmod(a0: string, b0: string) -> list
    let a = _big_norm(a0)
    let b = _big_norm(b0)
    let quotient = ""
    let remainder = "0"
    let i = 0
    while i < len(a)
        // bring down the next digit: remainder = remainder*10 + a[i]
        remainder = _big_norm(remainder + char_at(a, i))
        // largest digit d in 0..9 with d*b <= remainder
        let d = 0
        while d < 9 and big_cmp(big_mul(b, str(d + 1)), remainder) <= 0
            d = d + 1
        quotient = quotient + chr(48 + d)
        remainder = big_sub(remainder, big_mul(b, str(d)))
        i = i + 1
    [_big_norm(quotient), _big_norm(remainder)]

// Integer quotient of a / b (floor, non-negative).
fn big_div(a0: string, b0: string) -> string
    let qr = big_divmod(a0, b0)
    qr[0]

// Remainder of a mod b (non-negative).
fn big_mod(a0: string, b0: string) -> string
    let qr = big_divmod(a0, b0)
    qr[1]

// Modular exponentiation: (base ^ exp) mod m, via square-and-multiply with reduction each step. This is THE
// primitive behind RSA/Diffie-Hellman and Miller-Rabin primality. `exp` is a native (64-bit) integer.
fn big_powmod(base: string, exp: int, m: string) -> string
    let out = "1"
    let b = big_mod(_big_norm(base), m)
    let e = exp
    while e > 0
        if e % 2 == 1
            out = big_mod(big_mul(out, b), m)
        b = big_mod(big_mul(b, b), m)
        e = e / 2
    out
