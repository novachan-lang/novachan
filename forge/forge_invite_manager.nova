// forge_invite_manager — Invitation system with Result.

fn inv_new(max_uses: int) -> dict
    {"invites": {}, "max_uses": max_uses, "count": 0, "redeemed": 0}

fn inv_create(i: dict, code: string, creator: string, expires_at: int) -> dict
    i["invites"][code + "_creator"] = creator
    i["invites"][code + "_expires"] = expires_at
    i["invites"][code + "_uses"] = 0
    i["invites"][code + "_active"] = 1
    i["count"] += 1
    i

fn inv_redeem(i: dict, code: string, now: int) -> Result
    if (code + "_active") not in i["invites"]
        return err("unknown invite: " + code)
    if i["invites"][code + "_active"] != 1
        return err("invite revoked: " + code)
    if now > i["invites"][code + "_expires"]
        return err("invite expired: " + code)
    if i["invites"][code + "_uses"] >= i["max_uses"]
        return err("max uses reached")
    i["invites"][code + "_uses"] += 1
    i["redeemed"] += 1
    ok(i)

fn inv_revoke(i: dict, code: string) -> Result
    if (code + "_active") not in i["invites"]
        return err("unknown invite")
    i["invites"][code + "_active"] = 0
    ok(i)

fn inv_uses(i: dict, code: string) -> int
    i["invites"][code + "_uses"]

fn inv_total_created(i: dict) -> int
    i["count"]

fn inv_total_redeemed(i: dict) -> int
    i["redeemed"]
