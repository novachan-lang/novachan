// forge_ksum -- find elements that ADD UP to a target. "Which two transactions sum to this amount?", "is there
// a pair of items totalling the budget?", "find every triple of readings that cancels to zero" -- these are
// two-sum and three-sum, and they appear constantly in reconciliation, matching, subset checks, and puzzle
// solving. two_sum uses a hash set for O(n) lookup (return the first index pair, all value pairs, or just a
// yes/no); three_sum sorts once and sweeps two pointers inward for O(n^2), returning the DISTINCT triples that
// hit the target (no duplicates). Values are integers. LEAF -- imports NOTHING.

// The indices [i, j] of the first pair that sums to target (i < j), or [-1, -1] if none. O(n).
fn two_sum(arr: list, target: int) -> list
    let seen = {}
    let out = [-1, -1]
    for i in 0..len(arr)
        let need = target - arr[i]
        let key = str(need)
        if key in seen
            out = [seen[key], i]
            break
        seen[str(arr[i])] = i
    out

// True if any two elements sum to target.
fn has_pair_sum(arr: list, target: int) -> bool
    let r = two_sum(arr, target)
    r[0] >= 0

// All distinct VALUE pairs [a, b] (a <= b) that sum to target, each pair once. O(n).
fn two_sum_all(arr: list, target: int) -> list
    let seen = {}
    let emitted = {}
    let out = []
    for i in 0..len(arr)
        let v = arr[i]
        let need = target - v
        if str(need) in seen
            let lo = need if need < v else v
            let hi = v if need < v else need
            let ek = "{lo}:{hi}"
            if ek not in emitted
                emitted[ek] = 1
                push(out, [lo, hi])
        seen[str(v)] = i
    out

// PRIVATE: ascending-sorted copy (scalar insertion sort).
fn _ks_sorted(arr: list) -> list
    let out = [arr[i] for i in 0..len(arr)]
    for a in 1..len(out)
        let cur = out[a]
        let b = a - 1
        while b >= 0 and out[b] > cur
            out[b + 1] = out[b]
            b -= 1
        out[b + 1] = cur
    out

// All DISTINCT value triples [a, b, c] (sorted) that sum to target. Classic sort + two-pointer, O(n^2).
fn three_sum(arr: list, target: int) -> list
    let a = _ks_sorted(arr)
    let n = len(a)
    let result = []
    for i in 0..(n - 2)
        if i > 0 and a[i] == a[i - 1]
            continue
        let lo = i + 1
        let hi = n - 1
        while lo < hi
            let s = a[i] + a[lo] + a[hi]
            if s == target
                push(result, [a[i], a[lo], a[hi]])
                lo += 1
                hi -= 1
                while lo < hi and a[lo] == a[lo - 1]
                    lo += 1
                while lo < hi and a[hi] == a[hi + 1]
                    hi -= 1
            else if s < target
                lo += 1
            else
                hi -= 1
    result
