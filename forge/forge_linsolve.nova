// forge_linsolve -- solve a system of linear equations A x = b by Gaussian elimination with partial pivoting.
// "n equations, n unknowns" is one of the most common numerical problems: fitting a curve or a plane through
// data, balancing chemical equations, solving circuit node voltages (Kirchhoff), force/stress in a truss,
// computing weights for interpolation or a least-squares normal equation, and transform math in graphics. Give
// it the coefficient matrix A (a list of rows) and the right-hand-side vector b; it returns the solution vector
// x, or null if the system is singular (no unique solution). Partial pivoting (swapping in the largest available
// pivot) keeps it numerically stable. Values are numbers; the result is floats. LEAF -- imports NOTHING.

// PRIVATE: absolute value of a float.
fn _ls_abs(x: float) -> float
    -x if x < 0.0 else x

// Solve A x = b for x. A is an n-by-n list of rows, b is a length-n vector. Returns the solution vector, or
// null if A is singular.
fn solve(A: list, b: list)
    let n = len(A)
    let out = null
    if n > 0 and len(b) == n
        // build an augmented float matrix [A | b]
        let m = []
        for i in 0..n
            let row = [A[i][j] * 1.0 for j in 0..n]
            push(row, b[i] * 1.0)
            push(m, row)
        // forward elimination with partial pivoting
        let singular = false
        let col = 0
        while col < n and not singular
            // find the row (col..n-1) with the largest absolute value in this column
            let piv = col
            let maxv = _ls_abs(m[col][col] * 1.0)
            for r in (col + 1)..n
                let v = _ls_abs(m[r][col] * 1.0)
                if v > maxv
                    maxv = v
                    piv = r
            if maxv < 0.000000001
                singular = true
            else
                // swap rows col and piv by swapping their contents (scalar swaps)
                if piv != col
                    for cc in col..(n + 1)
                        let t = m[col][cc] * 1.0
                        m[col][cc] = m[piv][cc] * 1.0
                        m[piv][cc] = t
                // eliminate entries below the pivot
                for rr in (col + 1)..n
                    let factor = (m[rr][col] * 1.0) / (m[col][col] * 1.0)
                    for cc2 in col..(n + 1)
                        m[rr][cc2] = (m[rr][cc2] * 1.0) - factor * (m[col][cc2] * 1.0)
            col += 1
        if not singular
            // back substitution
            let x = [0.0 for k in 0..n]
            let row2 = n - 1
            while row2 >= 0
                let sum = m[row2][n] * 1.0
                for c in (row2 + 1)..n
                    sum -= (m[row2][c] * 1.0) * (x[c] * 1.0)
                x[row2] = sum / (m[row2][row2] * 1.0)
                row2 -= 1
            out = x
    out
