// forge_sparkline -- render a tiny inline chart (sparkline) from a numeric series using the Unicode block
// elements (U+2581 lower one-eighth block .. U+2588 full block: the eight-level ramp). For dashboards,
// log lines, CLI metrics, and inline trend indicators -- a whole time-series in one column of text. The
// data is auto-scaled to its own min..max over 8 levels, so a flat series renders as a flat baseline and
// a rising series climbs to the full block. LEAF -- imports NOTHING.
//
// NOTE: each block glyph is a 3-byte UTF-8 sequence (all in the BMP), so an N-point sparkline is exactly
// 3*N bytes. The eight glyphs are cp = 9601 + level for level 0..7 (9601 = 0x2581, 9608 = 0x2588 = full).

// PRIVATE: emit the block glyph for an intensity level 0..7 as a 3-byte UTF-8 string.
// cp = 9601 + level; UTF-8 for a BMP codepoint in 0x0800..0xFFFF is 1110xxxx 10xxxxxx 10xxxxxx.
fn _spark_block(level: int) -> string
    let lv = level
    if lv < 0
        lv = 0
    if lv > 7
        lv = 7
    let cp = 9601 + lv
    chr(224 + (cp / 4096)) + chr(128 + ((cp / 64) % 64)) + chr(128 + (cp % 64))

// Render a list of ints as a sparkline string, scaled to the data's own min..max across the 8 block levels.
// An empty list yields "". A constant series yields an all-baseline (lowest block) line.
fn sparkline(values: list) -> string
    if len(values) == 0
        return ""
    let mn = values[0]
    let mx = values[0]
    let i = 1
    while i < len(values)
        if values[i] < mn
            mn = values[i]
        if values[i] > mx
            mx = values[i]
        i = i + 1
    let span = mx - mn
    let out = ""
    let j = 0
    while j < len(values)
        let level = 0
        if span > 0
            level = (values[j] - mn) * 7 / span
        out = out + _spark_block(level)
        j = j + 1
    out

// Convenience: the number of data points a sparkline string encodes (3 UTF-8 bytes per block glyph).
fn sparkline_points(spark: string) -> int
    len(spark) / 3
