// forge_ratio -- aspect-ratio + fit-to-box helpers (image/video sizing, responsive thumbnails, layout). Scale
// dimensions to fit within a box preserving aspect ratio, and simplify WxH to its lowest-terms ratio. Integer
// math (no float rounding drift). Composes forge_math (gcd). Imports forge_math.
import forge_math

// Scale [w,h] to fit INSIDE [box_w, box_h] preserving aspect ratio -> [w2, h2].
fn fit_within(w: int, h: int, box_w: int, box_h: int) -> list
    if w <= 0 or h <= 0
        return [0, 0]
    let scaled_h = box_w * h / w
    if scaled_h <= box_h
        return [box_w, scaled_h]
    [box_h * w / h, box_h]

// Simplify WxH to its aspect ratio in lowest terms -> [rw, rh]. ratio_simplify(1920, 1080) -> [16, 9].
fn ratio_simplify(w: int, h: int) -> list
    let g = gcd(w, h)
    if g == 0
        return [w, h]
    [w / g, h / g]

// Aspect ratio as a string "16:9".
fn ratio_string(w: int, h: int) -> string
    let r = ratio_simplify(w, h)
    str(r[0]) + ":" + str(r[1])
