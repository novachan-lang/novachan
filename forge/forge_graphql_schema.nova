// forge_graphql_schema — GraphQL schema definition (type-first).
// Object types, fields, queries, mutations, introspection.

fn gql_schema() -> dict
    {"types": {}, "queries": [], "mutations": []}

fn gql_add_type(schema: dict, name: string, fields: list) -> dict
    schema["types"][name] = {"name": name, "fields": fields}
    schema

fn gql_add_query(schema: dict, name: string, return_type: string) -> dict
    push(schema["queries"], {"name": name, "return_type": return_type, "args": []})
    schema

fn gql_add_mutation(schema: dict, name: string, return_type: string) -> dict
    push(schema["mutations"], {"name": name, "return_type": return_type, "args": []})
    schema

fn gql_add_query_arg(schema: dict, query_name: string, arg_name: string, arg_type: string) -> dict
    for i in 0..len(schema["queries"])
        if schema["queries"][i]["name"] == query_name
            push(schema["queries"][i]["args"], {"name": arg_name, "type": arg_type})
    schema

fn gql_type_names(schema: dict) -> list
    keys(schema["types"])

fn gql_query_count(schema: dict) -> int
    len(schema["queries"])

fn gql_mutation_count(schema: dict) -> int
    len(schema["mutations"])

fn gql_get_type(schema: dict, name: string) -> dict
    if name in schema["types"]
        return schema["types"][name]
    {}

fn gql_field_count(schema: dict, type_name: string) -> int
    let t = gql_get_type(schema, type_name)
    if "fields" in t
        return len(t["fields"])
    0

fn gql_introspect_types(schema: dict) -> list
    let names = keys(schema["types"])
    [{"name": names[i], "field_count": gql_field_count(schema, names[i])} for i in 0..len(names)]
