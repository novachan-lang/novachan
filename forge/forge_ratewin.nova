// forge_ratewin -- FIXED-WINDOW rate limiting (the algorithm behind X-RateLimit-* quota headers). Distinct
// from Forge's token-bucket limiter: here each key gets `limit` requests per fixed `window_ms` slice, the
// counter snaps to 0 at each window boundary. Simple, memory-cheap, and exactly what public API quotas
// ("1000 req/hour") use. State is a dict of key -> [window_start, count], mutated in place.
//
// LEAF -- imports NOTHING. Built-ins: contains, str (none needed for keys -- keys are the caller's strings).

fn ratewin_new(limit: int, window_ms: int) -> dict
    {"limit": limit, "window_ms": window_ms, "buckets": {}}

// PRIVATE: the current count for `key` within the window containing now_ms (0 if the stored bucket is from an
// older window -- i.e. the counter has rolled over).
fn _ratewin_cur(rw: dict, key: string, start: int) -> int
    let buckets = rw["buckets"]
    if key in buckets
        let b = buckets[key]
        if b[0] == start
            return b[1]
    0

// Try to consume one unit for `key`. Returns true if allowed (and records the hit), false if the window's
// quota is already exhausted. Mutates rw in place.
fn ratewin_allow(rw: dict, key: string, now_ms: int) -> bool
    let win = rw["window_ms"]
    let start = (now_ms / win) * win
    let cur = _ratewin_cur(rw, key, start)
    let buckets = rw["buckets"]
    if cur >= rw["limit"]
        buckets[key] = [start, cur]
        return false
    buckets[key] = [start, cur + 1]
    true

// Requests still allowed for `key` in the current window (for an X-RateLimit-Remaining header). Never negative.
fn ratewin_remaining(rw: dict, key: string, now_ms: int) -> int
    let win = rw["window_ms"]
    let start = (now_ms / win) * win
    let rem = rw["limit"] - _ratewin_cur(rw, key, start)
    if rem < 0
        return 0
    rem

// The wall-clock ms at which the current window resets (for X-RateLimit-Reset / Retry-After).
fn ratewin_reset_at(rw: dict, now_ms: int) -> int
    let win = rw["window_ms"]
    ((now_ms / win) * win) + win
