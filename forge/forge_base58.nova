// forge_base58 -- thin wrapper over std/encoding/base58 (canonical implementation).
import std/encoding/base58

fn _b58_alpha() -> string
    "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

// Encode a non-negative int to Base58 (0 -> "1", Bitcoin's leading-zero symbol -- which is why
// radix_encode takes the zero rendering as a parameter rather than assuming "0").

fn base58_encode(n: int) -> string
    return base58_encode(n)

fn base58_decode(s: string) -> int
    return base58_decode(s)

fn base58_decode_checked(s: string) -> Result
    radix_decode_exact(s, _b58_alpha())

