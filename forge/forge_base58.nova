// forge_base58 -- Base58 encoding (Bitcoin / IPFS / Flickr): the human-friendly encoding that DROPS the
// ambiguous characters 0 O I l, used for crypto addresses, content IDs, and short shareable tokens that people
// might read aloud or transcribe. Encodes a non-negative integer to Base58 and back.
//
// The radix conversion itself now lives ONCE in forge_radix, shared with base36 and base62. This module is
// its alphabet plus three thin entry points.
import forge_radix

fn _b58_alpha() -> string
    "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

// Encode a non-negative int to Base58 (0 -> "1", Bitcoin's leading-zero symbol -- which is why
// radix_encode takes the zero rendering as a parameter rather than assuming "0").
fn base58_encode(n: int) -> string
    radix_encode(n, _b58_alpha(), "1")

// Decode a Base58 string back to an int (0 if any char is outside the alphabet).
// Contract UNCHANGED, ambiguity included -- use base58_decode_checked to tell "decodes to zero" from
// "not valid Base58", which matters when validating an address or a content id.
fn base58_decode(s: string) -> int
    unwrap_or(radix_decode_exact(s, _b58_alpha()), 0)

// Decode KEEPING the reason: ok(n), or err naming the offending character and its index.
fn base58_decode_checked(s: string) -> Result
    radix_decode_exact(s, _b58_alpha())
