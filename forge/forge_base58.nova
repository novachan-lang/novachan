// forge_base58 -- Base58 encoding (Bitcoin / IPFS / Flickr): the human-friendly encoding that DROPS the
// ambiguous characters 0 O I l, used for crypto addresses, content IDs, and short shareable tokens that people
// might read aloud or transcribe. Encodes a non-negative integer to Base58 and back. Completes the base-
// encoding family (base32/base58/base62/base64). LEAF -- imports NOTHING.

fn _b58_alpha() -> string
    "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

// Encode a non-negative int to Base58 (0 -> "1", Bitcoin's leading-zero symbol).
fn base58_encode(n: int) -> string
    if n <= 0
        return "1"
    let alpha = _b58_alpha()
    let v = n
    let out = ""
    while v > 0
        out = char_at(alpha, v % 58) + out
        v = v / 58
    out

// Decode a Base58 string back to an int (0 if any char is outside the alphabet).
fn base58_decode(s: string) -> int
    let alpha = _b58_alpha()
    let v = 0
    for i in 0..len(s)
        let d = find(alpha, char_at(s, i))
        if d < 0
            return 0
        v = v * 58 + d
    v
