// forge_charclass -- ASCII character CLASSIFICATION: the tiny predicates every lexer, parser, validator, and
// sanitizer is built from. Is this character a digit? A letter? Alphanumeric? Whitespace? Upper or lower case?
// Punctuation? Answering these one character at a time is how you tokenize source code and config, validate that
// an identifier or username is well-formed, split on word boundaries, strip or detect control characters, and
// implement your own trim/case logic. This is the C <ctype.h> / the character half of a regex character class,
// exposed as clean named tests plus the two case-conversion helpers (to_upper_char / to_lower_char) that only
// touch letters and leave everything else alone. Each takes a single-character string; non-letters are simply
// reported false by the case/letter tests. Scoped to 7-bit ASCII. LEAF -- imports NOTHING.

// True if c is a decimal digit 0-9.
fn is_digit(c: string) -> bool
    let o = ord(c)
    let out = false
    if o >= 48 and o <= 57
        out = true
    out

// True if c is an ASCII letter a-z or A-Z.
fn is_alpha(c: string) -> bool
    let o = ord(c)
    let out = false
    if (o >= 65 and o <= 90) or (o >= 97 and o <= 122)
        out = true
    out

// True if c is a letter or a digit.
fn is_alnum(c: string) -> bool
    let out = false
    if is_alpha(c) or is_digit(c)
        out = true
    out

// True if c is an uppercase letter A-Z.
fn is_upper(c: string) -> bool
    let o = ord(c)
    let out = false
    if o >= 65 and o <= 90
        out = true
    out

// True if c is a lowercase letter a-z.
fn is_lower(c: string) -> bool
    let o = ord(c)
    let out = false
    if o >= 97 and o <= 122
        out = true
    out

// True if c is ASCII whitespace (space, tab, newline, carriage return, form feed, vertical tab).
fn is_whitespace(c: string) -> bool
    let o = ord(c)
    let out = false
    if o == 32 or (o >= 9 and o <= 13)
        out = true
    out

// True if c is a visible ASCII punctuation character (printable, not a letter/digit/space).
fn is_punct(c: string) -> bool
    let o = ord(c)
    let out = false
    if o >= 33 and o <= 126 and is_alnum(c) == false
        out = true
    out

// c uppercased if it is a lowercase letter, otherwise unchanged.
fn to_upper_char(c: string) -> string
    let o = ord(c)
    let out = c
    if o >= 97 and o <= 122
        out = chr(o - 32)
    out

// c lowercased if it is an uppercase letter, otherwise unchanged.
fn to_lower_char(c: string) -> string
    let o = ord(c)
    let out = c
    if o >= 65 and o <= 90
        out = chr(o + 32)
    out
