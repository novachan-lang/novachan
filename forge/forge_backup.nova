// forge_backup — Backup/restore management.
// Schedule, track, verify backup integrity.

fn bk_new() -> dict
    let bk = {}
    bk["backups"] = []
    bk["policies"] = {}
    bk["next_id"] = 1
    bk

fn bk_add_policy(bk: dict, name: string, retention_days: int, max_backups: int) -> dict
    let p = {}
    p["retention_days"] = retention_days
    p["max_backups"] = max_backups
    bk["policies"][name] = p
    bk

fn bk_create(bk: dict, policy: string, source: string, timestamp: int) -> dict
    let id = bk["next_id"]
    bk["next_id"] = id + 1
    let backup = {}
    backup["id"] = id
    backup["policy"] = policy
    backup["source"] = source
    backup["timestamp"] = timestamp
    backup["status"] = "completed"
    backup["size_bytes"] = 0
    backup["verified"] = 0
    push(bk["backups"], backup)
    let r = {}
    r["bk"] = bk
    r["backup_id"] = id
    r

fn bk_verify(bk: dict, backup_id: int) -> dict
    let i = 0
    while i < len(bk["backups"])
        if bk["backups"][i]["id"] == backup_id
            bk["backups"][i]["verified"] = 1
        i = i + 1
    bk

fn bk_set_size(bk: dict, backup_id: int, size: int) -> dict
    let i = 0
    while i < len(bk["backups"])
        if bk["backups"][i]["id"] == backup_id
            bk["backups"][i]["size_bytes"] = size
        i = i + 1
    bk

fn bk_count(bk: dict) -> int
    len(bk["backups"])

fn bk_latest(bk: dict) -> dict
    let n = len(bk["backups"])
    if n == 0
        let empty = {}
        empty["id"] = -1
        return empty
    bk["backups"][n - 1]

fn bk_for_policy(bk: dict, policy: string) -> list
    let result = []
    let i = 0
    while i < len(bk["backups"])
        if bk["backups"][i]["policy"] == policy
            push(result, bk["backups"][i])
        i = i + 1
    result

fn bk_expired(bk: dict, policy: string, now: int) -> list
    let has = contains(bk["policies"], policy)
    if has != true
        return []
    let retention = bk["policies"][policy]["retention_days"] * 86400
    let result = []
    let i = 0
    while i < len(bk["backups"])
        if bk["backups"][i]["policy"] == policy
            let age = now - bk["backups"][i]["timestamp"]
            if age > retention
                push(result, bk["backups"][i])
        i = i + 1
    result

fn bk_total_size(bk: dict) -> int
    let total = 0
    let i = 0
    while i < len(bk["backups"])
        total = total + bk["backups"][i]["size_bytes"]
        i = i + 1
    total
