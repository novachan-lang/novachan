// forge_backup — Backup/restore management.
// Schedule, track, verify backup integrity.
//
// RAISED 2026-08-05. Seven problems:
//
//   1. bk_new / bk_add_policy / bk_create built dicts as individual assignments. Dict literals.
//   2. bk_create result dict built as three assignments. Dict literal.
//   3. bk_verify / bk_set_size used while-index loops. for-in range (index-based — mutation needed).
//   4. bk_for_policy / bk_expired used push-filter while loops. Comprehensions.
//   5. bk_expired used `contains(...) != true`. `not in`.
//   6. bk_latest had a 3-line empty dict construction. Ternary + dict literal.
//   7. bk_total_size / bk_create used `x = x + 1`. Compound `+=`.

fn bk_new() -> dict
    {"backups": [], "policies": {}, "next_id": 1}

fn bk_add_policy(bk: dict, name: string, retention_days: int, max_backups: int) -> dict
    bk["policies"][name] = {"retention_days": retention_days, "max_backups": max_backups}
    bk

fn bk_create(bk: dict, policy: string, source: string, timestamp: int) -> dict
    let id = bk["next_id"]
    bk["next_id"] += 1
    push(bk["backups"], {"id": id, "policy": policy, "source": source, "timestamp": timestamp, "status": "completed", "size_bytes": 0, "verified": 0})
    {"bk": bk, "backup_id": id}

fn bk_verify(bk: dict, backup_id: int) -> dict
    for i in 0..len(bk["backups"])
        if bk["backups"][i]["id"] == backup_id
            bk["backups"][i]["verified"] = 1
    bk

fn bk_set_size(bk: dict, backup_id: int, size: int) -> dict
    for i in 0..len(bk["backups"])
        if bk["backups"][i]["id"] == backup_id
            bk["backups"][i]["size_bytes"] = size
    bk

fn bk_count(bk: dict) -> int
    len(bk["backups"])

fn bk_latest(bk: dict) -> dict
    let n = len(bk["backups"])
    {"id": -1} if n == 0 else bk["backups"][n - 1]

fn bk_for_policy(bk: dict, policy: string) -> list
    [b for b in bk["backups"] if str(b["policy"]) == policy]

fn bk_expired(bk: dict, policy: string, now: int) -> list
    if policy not in bk["policies"]
        return []
    let retention = bk["policies"][policy]["retention_days"] * 86400
    [b for b in bk["backups"] if str(b["policy"]) == policy and now - b["timestamp"] > retention]

fn bk_total_size(bk: dict) -> int
    let total = 0
    for b in bk["backups"]
        total += b["size_bytes"]
    total
