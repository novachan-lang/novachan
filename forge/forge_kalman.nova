// forge_kalman -- discrete Kalman filter for optimal state estimation under Gaussian noise.
// The Kalman filter is the backbone of GPS navigation, rocket/spacecraft guidance (Apollo, Falcon 9),
// robot SLAM (simultaneous localization and mapping), sensor fusion (IMU+GPS+lidar), financial time-
// series smoothing, radar/sonar tracking, and any application where you observe a noisy signal and want
// the best estimate of the true state. Given a linear dynamical system x_{k+1} = F x_k + w (process
// noise) and measurement z_k = H x_k + v (measurement noise), the filter alternates two steps:
//   PREDICT: propagate state x and covariance P forward via dynamics F and process noise Q.
//   UPDATE:  correct x and P using a new observation z, sensor model H, and measurement noise R.
// This implementation is SCALAR (1-D state, 1-D measurement) for simplicity and NOVA soundness:
// all Kalman equations reduce to plain float arithmetic, no matrix inversion needed (just division).
// For n-D state you would use forge_linsolve for the gain; 1-D covers a large practical class.
//
// API:
//   kalman_init(x0, p0) -> state        initial state [x, P]
//   kalman_predict(state, F, Q) -> state propagate: x=F*x, P=F*F*P+Q
//   kalman_update(state, z, H, R) -> state  correct with observation z
//   kalman_smooth(measurements, F, H, Q, R, x0, p0) -> estimates  full forward-pass filter
// LEAF (imports nothing).

// Create a Kalman filter state: [x_estimate, P_covariance]
fn kalman_init(x0: float, p0: float) -> list
    return [x0, p0]

// Prediction step: propagate state and covariance through dynamics.
// F = state transition (scalar: next_x = F * x),
// Q = process noise variance (how much the hidden state jumps per step).
fn kalman_predict(state: list, F: float, Q: float) -> list
    let x = state[0] * 1.0
    let P = state[1] * 1.0
    let x_pred = F * x
    let P_pred = F * F * P + Q
    return [x_pred, P_pred]

// Update step: incorporate a new scalar measurement z.
// H = observation matrix scalar (z = H * x + noise),
// R = measurement noise variance.
// Returns updated state [x_new, P_new].
fn kalman_update(state: list, z: float, H: float, R: float) -> list
    let x = state[0] * 1.0
    let P = state[1] * 1.0
    // Innovation (residual): y = z - H*x
    let y = z - H * x
    // Innovation covariance: S = H*P*H + R
    let S = H * H * P + R
    // Kalman gain: K = P*H / S
    let K = P * H / S
    // Updated state estimate: x = x + K*y
    let x_new = x + K * y
    // Updated covariance: P = (1 - K*H) * P  (Joseph form simplification for scalar)
    let P_new = (1.0 - K * H) * P
    return [x_new, P_new]

// Full forward filter pass: given a list of scalar measurements, return list of filtered estimates.
// x0 = initial state estimate, p0 = initial state uncertainty,
// F = dynamics scalar, H = observation scalar, Q = process noise var, R = measurement noise var.
fn kalman_smooth(measurements: list, F: float, H: float, Q: float, R: float, x0: float, p0: float) -> list
    let estimates = []
    let state = kalman_init(x0, p0)
    let i = 0
    let n = len(measurements)
    while i < n
        state = kalman_predict(state, F, Q)
        let z = measurements[i] * 1.0
        state = kalman_update(state, z, H, R)
        push(estimates, state[0])
        i += 1
    return estimates

// Kalman gain at steady state for a static system (F=1, H=1).
// At steady state P_inf satisfies: P_inf = P_inf * P_inf / (P_inf + R) + Q
// Solving: P_inf^2 - Q*P_inf - Q*R = 0 (rearranged from Riccati equation)
// => P_inf = (Q + sqrt(Q^2 + 4*Q*R)) / 2
fn _kf_sqrt(x: float) -> float
    if x <= 0.0
        return 0.0
    let g = x
    for i in 0..60
        g = (g + x / g) * 0.5
    return g

fn kalman_steady_state_gain(Q: float, R: float) -> float
    let disc = Q * Q + 4.0 * Q * R
    let P_inf = (Q + _kf_sqrt(disc)) * 0.5
    return P_inf / (P_inf + R)
