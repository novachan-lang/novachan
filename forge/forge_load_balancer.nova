// forge_load_balancer — round-robin load balancer with Result API.

fn lb_new() -> dict
    {"backends": {}, "count": 0, "next_idx": 0, "total_routed": 0}

fn lb_add(b: dict, name: string, address: string) -> dict
    let cnt = b["count"]
    let key = "be_{cnt}"
    b["backends"]["{key}_name"] = name
    b["backends"]["{key}_addr"] = address
    b["backends"]["{key}_healthy"] = 1
    b["backends"]["{key}_load"] = 0
    b["count"] += 1
    b

fn lb_remove(b: dict, name: string) -> Result
    for i in 0..b["count"]
        let key = "be_{i}"
        if b["backends"]["{key}_name"] == name
            b["backends"]["{key}_healthy"] = 0
            return ok(b)
    err("backend not found: {name}")

fn lb_next(b: dict) -> Result
    if b["count"] == 0
        return err("no backends")
    for tries in 0..b["count"]
        let idx = b["next_idx"] % b["count"]
        b["next_idx"] += 1
        let key = "be_{idx}"
        if b["backends"]["{key}_healthy"] == 1
            b["backends"]["{key}_load"] += 1
            b["total_routed"] += 1
            return ok(b["backends"]["{key}_addr"])
    err("no healthy backends")

fn lb_backend_count(b: dict) -> int
    b["count"]

fn lb_total_routed(b: dict) -> int
    b["total_routed"]

fn lb_set_healthy(b: dict, name: string, healthy: int) -> Result
    for i in 0..b["count"]
        let key = "be_{i}"
        if b["backends"]["{key}_name"] == name
            b["backends"]["{key}_healthy"] = healthy
            return ok(b)
    err("backend not found: {name}")
