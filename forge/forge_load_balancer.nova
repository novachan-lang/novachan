// forge_load_balancer — Load balancer with multiple strategies.
// Round-robin, weighted, least-connections, health-aware.

fn lb_new(strategy: string) -> dict
    let lb = {}
    lb["strategy"] = strategy
    lb["backends"] = []
    lb["rr_index"] = 0
    lb["total_routed"] = 0
    lb

fn lb_add_backend(lb: dict, host: string, port: int, weight: int) -> dict
    let b = {}
    b["host"] = host
    b["port"] = port
    b["weight"] = weight
    b["healthy"] = true
    b["connections"] = 0
    b["total_served"] = 0
    push(lb["backends"], b)
    lb

fn lb_set_health(lb: dict, idx: int, healthy: bool) -> dict
    if idx < len(lb["backends"])
        lb["backends"][idx]["healthy"] = healthy
    lb

fn lb_next(lb: dict) -> dict
    let strategy = lb["strategy"]
    let n = len(lb["backends"])
    if n == 0
        let empty = {}
        empty["host"] = ""
        empty["port"] = 0
        return empty
    if strategy == "round-robin"
        let start = lb["rr_index"]
        let checked = 0
        while checked < n
            let idx = (start + checked) % n
            let b = lb["backends"][idx]
            if b["healthy"] == true
                lb["rr_index"] = (idx + 1) % n
                lb["backends"][idx]["connections"] = b["connections"] + 1
                lb["backends"][idx]["total_served"] = b["total_served"] + 1
                lb["total_routed"] = lb["total_routed"] + 1
                let result = {}
                result["host"] = b["host"]
                result["port"] = b["port"]
                return result
            checked = checked + 1
    if strategy == "least-conn"
        let best = -1
        let best_conns = 999999
        let i = 0
        while i < n
            let b = lb["backends"][i]
            if b["healthy"] == true
                if b["connections"] < best_conns
                    best_conns = b["connections"]
                    best = i
            i = i + 1
        if best >= 0
            lb["backends"][best]["connections"] = lb["backends"][best]["connections"] + 1
            lb["backends"][best]["total_served"] = lb["backends"][best]["total_served"] + 1
            lb["total_routed"] = lb["total_routed"] + 1
            let result = {}
            result["host"] = lb["backends"][best]["host"]
            result["port"] = lb["backends"][best]["port"]
            return result
    let empty = {}
    empty["host"] = ""
    empty["port"] = 0
    empty

fn lb_release(lb: dict, idx: int) -> dict
    if idx < len(lb["backends"])
        if lb["backends"][idx]["connections"] > 0
            lb["backends"][idx]["connections"] = lb["backends"][idx]["connections"] - 1
    lb

fn lb_backend_count(lb: dict) -> int
    len(lb["backends"])

fn lb_healthy_count(lb: dict) -> int
    let count = 0
    let i = 0
    while i < len(lb["backends"])
        if lb["backends"][i]["healthy"] == true
            count = count + 1
        i = i + 1
    count

fn lb_total_routed(lb: dict) -> int
    lb["total_routed"]
