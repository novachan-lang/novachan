// forge_state_snapshot — Periodic state snapshots with diff detection.

fn ss_new() -> dict
    let s = {}
    s["current"] = {}
    s["snapshots"] = {}
    s["snap_count"] = 0
    s

fn ss_set(s: dict, key: string, value: string) -> dict
    s["current"][key] = value
    s

fn ss_get(s: dict, key: string) -> string
    let has = contains(s["current"], key)
    if has != true
        return ""
    s["current"][key]

fn ss_take_snapshot(s: dict, label: string) -> dict
    let idx = s["snap_count"]
    let k = str(idx)
    let ks = keys(s["current"])
    let i = 0
    while i < len(ks)
        s["snapshots"][k + "_" + ks[i]] = s["current"][ks[i]]
        i = i + 1
    s["snapshots"][k + "_label"] = label
    s["snapshots"][k + "_key_count"] = len(ks)
    s["snap_count"] = idx + 1
    s

fn ss_snapshot_count(s: dict) -> int
    s["snap_count"]

fn ss_snapshot_label(s: dict, index: int) -> string
    if index < 0
        return ""
    if index >= s["snap_count"]
        return ""
    s["snapshots"][str(index) + "_label"]

fn ss_snapshot_value(s: dict, index: int, key: string) -> string
    if index < 0
        return ""
    if index >= s["snap_count"]
        return ""
    let sk = str(index) + "_" + key
    let has = contains(s["snapshots"], sk)
    if has != true
        return ""
    s["snapshots"][sk]

fn ss_current_size(s: dict) -> int
    len(keys(s["current"]))
