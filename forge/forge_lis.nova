// forge_lis -- the Longest Increasing Subsequence: the longest chain you can pick from a sequence (keeping order,
// but not necessarily adjacent) that strictly increases. It measures how much of a series already trends upward
// and finds that best-improving run: the longest streak of records/improvements, the maximum set of tasks or
// boxes that nest, patience-sorting solitaire, and a building block for diffs and scheduling. lis_length uses
// the O(n log n) patience-sorting method (binary search into a "tails" array); lis reconstructs one actual
// longest subsequence. Values are integers, compared strictly (< ), so equal values don't extend a run. Fully
// reliable integer logic. LEAF -- imports NOTHING.

// The length of the longest strictly-increasing subsequence. O(n log n).
fn lis_length(arr: list) -> int
    let tails = []
    for i in 0..len(arr)
        let x = arr[i]
        // binary search: first index in tails whose value is >= x
        let lo = 0
        let hi = len(tails)
        while lo < hi
            let mid = (lo + hi) / 2
            if tails[mid] < x
                lo = mid + 1
            else
                hi = mid
        if lo == len(tails)
            push(tails, x)
        else
            tails[lo] = x
    len(tails)

// One actual longest strictly-increasing subsequence (there may be several of equal length). O(n^2), with
// predecessor backtracking. Empty for empty input.
fn lis(arr: list) -> list
    let n = len(arr)
    let out = []
    if n > 0
        let dp = [1 for i in 0..n]
        let prev = [-1 for i in 0..n]
        let besti = 0
        let bestlen = 1
        for a in 1..n
            for b in 0..a
                if arr[b] < arr[a] and dp[b] + 1 > dp[a]
                    dp[a] = dp[b] + 1
                    prev[a] = b
            if dp[a] > bestlen
                bestlen = dp[a]
                besti = a
        // backtrace through predecessors
        let rev = []
        let k = besti
        while k >= 0
            push(rev, arr[k])
            k = prev[k]
        out = reverse(rev)
    out
