// forge_dataloader -- the N+1 query killer (Facebook GraphQL DataLoader, Spring @BatchMapping). Naively,
// rendering 100 orders each fetching its user = 100 queries. A DataLoader COLLECTS the requested keys, then
// loads them in ONE batch (`WHERE id IN (...)`) and caches by key, so repeated/duplicate keys cost nothing.
// The batch_fn is `fn(keys: list) -> dict` (key -> value); the loader dedups keys and memoizes results for the
// request's lifetime. Build one per request (its cache must not outlive the request). LEAF -- imports NOTHING.

// batch_fn: given a list of distinct keys, returns a dict mapping each key (as a string) to its loaded value.
fn dataloader_new(batch_fn) -> dict
    let dl = {}
    dl["batch"] = batch_fn
    dl["cache"] = {}
    dl["queue"] = []
    dl

// Queue a key to be loaded on the next dispatch (no-op if already cached or already queued). Fluent.
fn dl_load(dl: dict, key: string) -> dict
    let cache = dl["cache"]
    if key in cache
        return dl
    let queue = dl["queue"]
    if key not in queue
        push(queue, key)
    dl

// Run the batch load for every queued key in ONE call, merge results into the cache, and clear the queue.
// Returns how many keys were loaded (0 if the queue was empty).
fn dl_dispatch(dl: dict) -> int
    let queue = dl["queue"]
    if len(queue) == 0
        return 0
    let batch = dl["batch"]
    let loaded = batch(queue)
    let cache = dl["cache"]
    let ks = keys(loaded)
    for i in 0..len(ks)
        cache[ks[i]] = loaded[ks[i]]
    let n = len(queue)
    dl["queue"] = []
    n

// The cached value for a key ("" if it wasn't loaded). Call after dl_dispatch.
fn dl_get(dl: dict, key: string) -> any
    let cache = dl["cache"]
    if key in cache
        return cache[key]
    ""

// Convenience: load a whole list of keys in one batch and return a key->value dict (queue + dispatch + gather).
// The one call every request handler wants: pass the 100 user_ids, get back one query's worth of users.
fn dl_load_all(dl: dict, wanted: list) -> dict
    for i in 0..len(wanted)
        dl_load(dl, wanted[i])
    dl_dispatch(dl)
    let out = {}
    for j in 0..len(wanted)
        out[wanted[j]] = dl_get(dl, wanted[j])
    out
