// forge_tls — TLS 1.3 (RFC 8446) key schedule for cipher suite TLS_AES_128_GCM_SHA256.
// Built on forge_crypto's HKDF / HMAC-SHA256 / SHA-256. Hash length = 32, key len = 16, iv len = 12.
import forge_crypto
import forge_x509
import forge_rsa
import forge_p256

fn _tls_zeros(n: int) -> list
    [0 for i in 0..n]

// HKDF-Expand-Label(Secret, Label, Context, Length) per RFC 8446 7.1.
// HkdfLabel = uint16(Length) || opaque("tls13 "+Label)<1-byte len> || opaque(Context)<1-byte len>.
fn tls13_hkdf_expand_label(secret, label_str, context, length: int) -> list
    let full = str_to_blist("tls13 {label_str}")
    let info = [(length >> 8) & 255, length & 255, len(full), ...full, len(context), ...context]
    hkdf_expand(secret, info, length)

// Derive-Secret(Secret, Label, Messages) = HKDF-Expand-Label(Secret, Label, Transcript-Hash(Messages), 32).
// `th` is the already-computed transcript hash (SHA-256 of the messages).
fn tls13_derive_secret(secret, label_str, th) -> list
    tls13_hkdf_expand_label(secret, label_str, th, 32)

fn tls13_early_secret() -> list
    hkdf_extract(_tls_zeros(32), _tls_zeros(32))

// handshake_secret = HKDF-Extract( Derive-Secret(early, "derived", H("")), ECDHE )
fn tls13_handshake_secret(ecdhe) -> list
    let derived = tls13_derive_secret(tls13_early_secret(), "derived", sha256_bytes(_tls_zeros(0)))
    hkdf_extract(derived, ecdhe)

// master_secret = HKDF-Extract( Derive-Secret(handshake, "derived", H("")), 0 )
fn tls13_master_secret(hs_secret) -> list
    let derived = tls13_derive_secret(hs_secret, "derived", sha256_bytes(_tls_zeros(0)))
    hkdf_extract(derived, _tls_zeros(32))

// traffic key / iv from a *_traffic_secret
fn tls13_traffic_key(secret) -> list
    tls13_hkdf_expand_label(secret, "key", _tls_zeros(0), 16)

fn tls13_traffic_iv(secret) -> list
    tls13_hkdf_expand_label(secret, "iv", _tls_zeros(0), 12)

fn tls13_finished_key(secret) -> list
    tls13_hkdf_expand_label(secret, "finished", _tls_zeros(0), 32)

// verify_data = HMAC(finished_key, Transcript-Hash(handshake context))
fn tls13_finished_verify(secret, th) -> list
    hmac_sha256_bytes(tls13_finished_key(secret), th)

// per-record AEAD nonce = write_iv XOR (seq as 8-byte big-endian, left-padded to iv length)
fn tls13_record_nonce(iv, seq: int) -> list
    let out = [...iv]
    // XOR the 8-byte big-endian seq into the low 8 bytes
    for b in 0..8
        let pos = len(iv) - 1 - b
        out[pos] = out[pos] ^ ((seq >> (b * 8)) & 255)
    out

// ── TLS 1.3 record layer (RFC 8446 §5.2), AES-128-GCM ────────────────────────────────────────────────
// Seal: TLSInnerPlaintext = content || content_type || zeros(pad); AEAD over it with AAD = record header
// (opaque_type 0x17 || 0x0303 || uint16 ciphertext+tag length). Returns the full on-the-wire record bytes.
fn tls13_record_seal(key, iv, seq: int, content, content_type: int, pad: int) -> list
    let padding = _tls_zeros(pad)
    let inner = [...content, content_type, ...padding]
    let total = len(inner) + 16
    let aad = [23, 3, 3, (total >> 8) & 255, total & 255]
    let nonce = tls13_record_nonce(iv, seq)
    let r = aes_gcm_encrypt(key, nonce, inner, aad)
    [...aad, ...r[0], ...r[1]]

// Open: parse the wire record, AEAD-decrypt (AAD = the 5-byte header), strip trailing zeros + the
// content_type byte. Returns [ok(bool), content, content_type].
fn tls13_record_open(key, iv, seq: int, wire) -> list
    let aad = [wire[i] for i in 0..5]
    let bodylen = (wire[3] << 8) | wire[4]
    let ctlen = bodylen - 16
    let ct = [wire[5 + i] for i in 0..ctlen]
    let tag = [wire[5 + ctlen + j] for j in 0..16]
    let nonce = tls13_record_nonce(iv, seq)
    let dec = aes_gcm_decrypt(key, nonce, ct, aad, tag)
    if not dec[0]
        return [false, [], 0]
    let inner = dec[1]
    // Trailing-zero strip: a data-dependent backwards scan that must stop at the first non-zero, so it
    // stays a `while` (a for-range cannot express the early stop).
    let p = len(inner) - 1
    while p >= 0 and inner[p] == 0
        p -= 1
    [true, [inner[k] for k in 0..p], inner[p]]

// ── TLS 1.3 handshake messages (RFC 8446 §4) ─────────────────────────────────────────────────────────
fn _tls_u16(n: int) -> list
    [(n >> 8) & 255, n & 255]

// (the old private `_tls_cat` is gone: it was byte-for-byte forge_x509's `x_cat`, and every call site
//  is now a spread literal, so nothing referenced it.)

// 2-byte length-prefixed
fn _tls_lp16(data) -> list
    [..._tls_u16(len(data)), ...data]

// 1-byte length-prefixed
fn _tls_lp8(data) -> list
    [len(data), ...data]

// handshake header: msg_type(1) || uint24 length -> [type, length, body_start, next]
fn tls13_hs_header(b, off: int) -> list
    let length = (b[off + 1] << 16) | (b[off + 2] << 8) | b[off + 3]
    [b[off], length, off + 4, off + 4 + length]

// Parse a ServerHello handshake message -> [cipher_suite, keyshare_group, keyshare_pubkey, selected_version]
fn tls13_parse_server_hello(sh) -> list
    let p = 4                       // skip handshake header (type + uint24 len)
    p += 2                       // legacy_version
    p += 32                      // random
    let sidlen = sh[p]
    p += 1 + sidlen              // legacy_session_id
    let cipher_suite = (sh[p] << 8) | sh[p + 1]
    p += 2
    p += 1                       // legacy_compression_method
    let extlen = (sh[p] << 8) | sh[p + 1]
    p += 2
    let extend = p + extlen
    let group = 0
    let keyshare = []
    let version = 0
    // Extension walk: the step is the parsed extension length, so this is a wire state machine and
    // stays a `while` by design.
    while p < extend
        let etype = (sh[p] << 8) | sh[p + 1]
        let elen = (sh[p + 2] << 8) | sh[p + 3]
        let edata = p + 4
        if etype == 51
            group = (sh[edata] << 8) | sh[edata + 1]
            let kelen = (sh[edata + 2] << 8) | sh[edata + 3]
            keyshare = der_slice(sh, edata + 4, edata + 4 + kelen)
        if etype == 43
            version = (sh[edata] << 8) | sh[edata + 1]
        p = edata + elen
    [cipher_suite, group, keyshare, version]

// Build a minimal TLS 1.3 ClientHello handshake message offering TLS_AES_128_GCM_SHA256 + X25519.
// random = 32 bytes, pub = the client's 32-byte X25519 public key.
fn tls13_make_client_hello(random, pub) -> list
    // signature_algorithms: ecdsa_secp256r1_sha256, ed25519, rsa_pss_rsae_sha256, rsa_pkcs1_sha256
    let sa = [..._tls_u16(1027), ..._tls_u16(2055), ..._tls_u16(2052), ..._tls_u16(1025)]
    // key_share entry: group(0x001d x25519) || key_exchange lp16(pub)
    let entry = [..._tls_u16(29), ..._tls_lp16(pub)]
    let exts = [
        ..._tls_u16(43), ..._tls_lp16(_tls_lp8(_tls_u16(772))),      // supported_versions -> 0x0304
        ..._tls_u16(10), ..._tls_lp16(_tls_lp16(_tls_u16(29))),      // supported_groups -> x25519
        ..._tls_u16(13), ..._tls_lp16(_tls_lp16(sa)),                // signature_algorithms
        ..._tls_u16(51), ..._tls_lp16(_tls_lp16(entry))              // key_share
    ]
    let body = [
        ..._tls_u16(771),                   // legacy_version 0x0303
        ...random,                          // 32-byte random
        ..._tls_lp8([]),                    // legacy_session_id (empty)
        ..._tls_lp16(_tls_u16(4865)),       // cipher_suites: 1 suite 0x1301
        ..._tls_lp8([0]),                   // legacy_compression_methods: null
        ..._tls_lp16(exts)
    ]
    // handshake header: type 0x01 || uint24 length
    [1, (len(body) >> 16) & 255, (len(body) >> 8) & 255, len(body) & 255, ...body]

// ── TLS 1.3 Finished verification (RFC 8446 §4.4.4) ──────────────────────────────────────────────────
// Transcript-Hash over a buffer of concatenated handshake messages.
fn tls13_transcript_hash(buf) -> list
    sha256_bytes(buf)

// The client's Finished verify_data (to send) = HMAC(finished_key(c_hs_traffic), transcript_hash).
fn tls13_client_finished(secret, th) -> list
    tls13_finished_verify(secret, th)

// Verify a received server Finished verify_data against the running transcript (constant-time-ish compare).
fn tls13_verify_server_finished(secret, th, recv) -> int
    let expected = tls13_finished_verify(secret, th)
    if len(expected) != len(recv)
        return 0
    // Deliberately NOT short-circuiting: every byte is OR-folded so the compare stays constant-time.
    let diff = reduce([expected[i] ^ recv[i] for i in 0..len(expected)], (acc, v) => acc | v, 0)
    if diff != 0
        return 0
    1

// ── TLS 1.3 Certificate / CertificateVerify (RFC 8446 §4.4.2/§4.4.3) ──────────────────────────────────
// Extract the leaf certificate DER from a Certificate message BODY (after the handshake header).
fn tls13_cert_leaf_der(cert_body) -> list
    let ctxlen = cert_body[0]
    let p = 1 + ctxlen + 3              // skip certificate_request_context, then certificate_list len (uint24)
    let clen = (cert_body[p] << 16) | (cert_body[p + 1] << 8) | cert_body[p + 2]
    der_slice(cert_body, p + 3, p + 3 + clen)

// The content signed by CertificateVerify: 0x20*64 || context_string || 0x00 || transcript_hash.
fn tls13_certverify_content(label_str, th) -> list
    let spaces = [32 for i in 0..64]
    [...spaces, ...str_to_blist(label_str), 0, ...th]

// Parse a CertificateVerify message BODY -> [signature_scheme, signature_bytes].
fn tls13_certverify_parse(cv_body) -> list
    let siglen = (cv_body[2] << 8) | cv_body[3]
    [(cv_body[0] << 8) | cv_body[1], der_slice(cv_body, 4, 4 + siglen)]

// Parse an RSAPublicKey DER (SEQUENCE { n INTEGER, e INTEGER }) -> the bare modulus n (no leading 0x00).
fn tls13_rsa_pubkey_n(spki_key) -> list
    let seq = der_tlv(spki_key, 0)
    let ntlv = der_tlv(spki_key, seq[2])
    let start = ntlv[2] + 1 if spki_key[ntlv[2]] == 0 else ntlv[2]
    der_slice(spki_key, start, ntlv[3])

// Extract a DER INTEGER value as a fixed 32-byte big-endian field (strip leading zeros, left-pad).
fn _tls_der_int32(b, vstart: int, vend: int) -> list
    // Leading-zero strip stops at the first non-zero byte -> short-circuiting scan, stays a `while`.
    let s = vstart
    while s < vend and b[s] == 0
        s += 1
    let pad = [0 for i in 0..(32 - (vend - s))]
    [...pad, ...der_slice(b, s, vend)]

// Parse an ECDSA DER signature (SEQUENCE { r INTEGER, s INTEGER }) -> [r32, s32].
fn _tls_parse_ecdsa_sig(sig) -> list
    let seq = der_tlv(sig, 0)
    let rtlv = der_tlv(sig, seq[2])
    let stlv = der_tlv(sig, rtlv[3])
    [_tls_der_int32(sig, rtlv[2], rtlv[3]), _tls_der_int32(sig, stlv[2], stlv[3])]

// ecdsa_secp256r1_sha256 over an uncompressed-point SPKI key (0x04 || Qx32 || Qy32).
fn _tls_verify_ecdsa_p256(spki_key, content, sig) -> int
    let qx = der_slice(spki_key, 1, 33)
    let qy = der_slice(spki_key, 33, 65)
    let rs = _tls_parse_ecdsa_sig(sig)
    ecdsa_p256_verify(qx, qy, sha256_bytes(content), rs[0], rs[1])

// Verify a TLS 1.3 signature (CertificateVerify) given the SignatureScheme, the leaf SPKI key bytes,
// the signed content, and the signature. Dispatches to the right algorithm. Returns 1/0.
fn tls13_verify_cert_signature(sig_scheme: int, spki_key, content, sig) -> int
    match sig_scheme
        2052 => rsa_pss_sha256_verify(tls13_rsa_pubkey_n(spki_key), sha256_bytes(content), sig)     // 0x0804 rsa_pss_rsae_sha256
        1027 => _tls_verify_ecdsa_p256(spki_key, content, sig)                                      // 0x0403 ecdsa_secp256r1_sha256
        2055 => ed25519_verify(spki_key, content, sig)                                              // 0x0807 ed25519 (signs content directly)
        1025 => rsa_pkcs1_sha256_verify(tls13_rsa_pubkey_n(spki_key), sha256_bytes(content), sig)   // 0x0401 rsa_pkcs1_sha256
        _ => 0
