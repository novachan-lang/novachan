// forge_uitext -- small text-formatting helpers for building human-facing UI copy: join a list into a natural
// "a, b and c" phrase, pluralize a noun by a count ("1 file" / "2 files"), and abbreviate big numbers compactly
// ("1.5K", "2M"). These are the little strings every dashboard, notification, and template assembles by hand
// and gets subtly wrong. pluralize_count composes forge_inflect's pluralize; the rest are LEAF.

import forge_inflect

// Join items into a natural-language list with `conj` ("and"/"or") before the last: [] -> "", [a] -> "a",
// [a,b] -> "a and b", [a,b,c] -> "a, b and c".
fn humanize_list(items: list, conj: string) -> string
    let n = len(items)
    if n == 0
        return ""
    if n == 1
        return items[0]
    if n == 2
        return items[0] + " " + conj + " " + items[1]
    let out_parts = []
    for i in 0..(n - 1)
        if i > 0
            push(out_parts, ", ")
        push(out_parts, items[i])
    let out = join(out_parts, "")
    out + " " + conj + " " + items[n - 1]

// "<count> <noun>" with the noun pluralized when count != 1: (1,"file")->"1 file", (3,"file")->"3 files",
// (0,"item")->"0 items".
fn pluralize_count(count: int, noun: string) -> string
    if count == 1
        return "1 " + noun
    str(count) + " " + pluralize(noun)

// PRIVATE: abbreviate at a given divisor + suffix with one decimal place (dropping a trailing .0).
fn _uit_abbr(n: int, div: int, suffix: string) -> string
    let whole = n / div
    let frac = (n % div) / (div / 10)
    if frac == 0
        return str(whole) + suffix
    str(whole) + "." + str(frac) + suffix

// Compact number abbreviation: 999 -> "999", 1500 -> "1.5K", 2000000 -> "2M", 1234567 -> "1.2M",
// 3200000000 -> "3.2B". Negative numbers keep their sign.
fn abbreviate_number(n: int) -> string
    if n < 0
        return "-" + abbreviate_number(0 - n)
    if n < 1000
        return str(n)
    if n < 1000000
        return _uit_abbr(n, 1000, "K")
    if n < 1000000000
        return _uit_abbr(n, 1000000, "M")
    if n < 1000000000000
        return _uit_abbr(n, 1000000000, "B")
    _uit_abbr(n, 1000000000000, "T")
