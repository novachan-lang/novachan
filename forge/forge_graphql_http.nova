// forge_graphql_http — the integration layer that turns forge_graphql (the engine) into a live Forge
// HTTP endpoint. One call, graphql_route(app, "/graphql", resolvers, 0), and your app speaks
// GraphQL-over-HTTP: POST a JSON body {"query": "...", "variables": {...}}, get back {"data": ...} or
// {"errors": [...]}. This is the Forge equivalent of Absinthe.Plug / graphene's GraphQLView — but the
// schema is just your resolver map + NOVA structs, and the DoS depth/complexity guard is on by default.
//
// Use with the dict-request serve path (forge.serve_app_n / forge.app + forge.post): the handler reads
// the body via forge.body_json (json_decode of req["body"]).
//
// NOT a leaf: imports forge (router + json) and forge_graphql (engine). Safe — nothing imports THIS
// module, and forge does not import forge_graphql, so forge_graphql is reached only through here (no
// diamond).
import forge
import forge_graphql

// Default DoS caps (§11 GraphQL requirement). Override by calling graphql_route_limited.
fn _gql_default_depth() -> int
    10

fn _gql_default_complexity() -> int
    500

// The core handler: parse the GraphQL request envelope from the body, execute with limits, return JSON.
// Body shape: {"query": "<graphql>", "variables": {...}} (variables optional). A missing/blank query
// executes to an empty {data:{}} (harmless). Always replies 200 with a GraphQL-shaped body — GraphQL
// signals field/validation problems inside "errors", not via HTTP status (spec-conformant).
fn _gql_handle(req, resolvers, root, max_depth: int, max_complexity: int) -> string
    let body = forge.body_json(req)
    let query = ""
    if "query" in body
        query = body["query"]
    let vars = {}
    if "variables" in body
        vars = body["variables"]
    let result = gql_execute_limited_vars(query, resolvers, root, vars, max_depth, max_complexity)
    forge.json_of(200, result)

// Register POST <path> as a GraphQL endpoint with the default DoS caps.
//   let app = forge.app()
//   forge_graphql_http.graphql_route(app, "/graphql", my_resolvers, 0)
//   forge.serve_app_n(app, 8080, 128)
fn graphql_route(app, path: string, resolvers, root)
    forge.post(app, path, fn(req) _gql_handle(req, resolvers, root, _gql_default_depth(), _gql_default_complexity()))
    app

// Same, but with explicit depth/complexity caps (tune per your schema's shape).
fn graphql_route_limited(app, path: string, resolvers, root, max_depth: int, max_complexity: int)
    forge.post(app, path, fn(req) _gql_handle(req, resolvers, root, max_depth, max_complexity))
    app
