// forge_work_stealing — Work-stealing task scheduler simulation.
// Multiple worker queues, steal from busy workers when idle.

fn ws_new(num_workers: int) -> dict
    let ws = {}
    ws["workers"] = {}
    ws["total_submitted"] = 0
    ws["total_stolen"] = 0
    ws["total_completed"] = 0
    for i in 0..num_workers
        let w = {}
        w["tasks"] = []
        w["completed"] = 0
        w["stolen_from"] = 0
        ws["workers"][str(i)] = w
    ws

fn ws_submit(ws: dict, worker_id: int, task_name: string) -> dict
    let wkey = str(worker_id)
    let has = contains(ws["workers"], wkey)
    if has != true
        return ws
    push(ws["workers"][wkey]["tasks"], task_name)
    ws["total_submitted"] = ws["total_submitted"] + 1
    ws

fn ws_execute(ws: dict, worker_id: int) -> string
    let wkey = str(worker_id)
    let has = contains(ws["workers"], wkey)
    if has != true
        return ""
    let tasks = ws["workers"][wkey]["tasks"]
    if len(tasks) == 0
        return ""
    let task = tasks[0]
    let new_tasks = []
    for i in 1..len(tasks)
        push(new_tasks, tasks[i])
    ws["workers"][wkey]["tasks"] = new_tasks
    ws["workers"][wkey]["completed"] = ws["workers"][wkey]["completed"] + 1
    ws["total_completed"] = ws["total_completed"] + 1
    task

fn ws_steal(ws: dict, thief_id: int) -> string
    let thief_key = str(thief_id)
    let best_key = ""
    let best_len = 0
    let wkeys = keys(ws["workers"])
    for i in 0..len(wkeys)
        if wkeys[i] != thief_key
            let tlen = len(ws["workers"][wkeys[i]]["tasks"])
            if tlen > best_len
                best_len = tlen
                best_key = wkeys[i]
    if best_key == ""
        return ""
    let tasks = ws["workers"][best_key]["tasks"]
    let last = tasks[len(tasks) - 1]
    let new_tasks = [tasks[j] for j in 0..(len(tasks) - 1)]
    ws["workers"][best_key]["tasks"] = new_tasks
    ws["workers"][best_key]["stolen_from"] = ws["workers"][best_key]["stolen_from"] + 1
    ws["total_stolen"] = ws["total_stolen"] + 1
    push(ws["workers"][thief_key]["tasks"], last)
    last

fn ws_queue_size(ws: dict, worker_id: int) -> int
    let wkey = str(worker_id)
    let has = contains(ws["workers"], wkey)
    if has != true
        return 0
    len(ws["workers"][wkey]["tasks"])

fn ws_worker_count(ws: dict) -> int
    len(keys(ws["workers"]))

fn ws_total_submitted(ws: dict) -> int
    ws["total_submitted"]

fn ws_total_completed(ws: dict) -> int
    ws["total_completed"]

fn ws_total_stolen(ws: dict) -> int
    ws["total_stolen"]
