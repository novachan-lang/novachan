// ══════════════════════════════════════════════════════════════════════════════
// forge_retry — Exponential-backoff retry policy helpers for Forge resilience.
//
// PURPOSE
// -------
// Pure, deterministic helpers for computing retry delays using the standard
// AWS-style exponential backoff schedule:
//
//   attempt 0 → base_ms
//   attempt 1 → base_ms * 2
//   attempt 2 → base_ms * 4
//   attempt k → base_ms * 2^k   (capped at max_ms)
//
// WHY CAP?
//   Without a cap, delays grow without bound: 100ms, 200ms, 400ms, ..., hours.
//   A hard cap (max_ms) keeps the worst-case recovery latency bounded and
//   predictable. Callers can still budget total wait time with retry_total_ms.
//
// WHY JITTER — AND WHY IS IT CALLER-SUPPLIED?
//   "Thundering herd": when a service recovers after an outage, ALL clients
//   whose retry timers fire at the same instant re-storm the service with
//   synchronised requests. The service, not yet at full capacity, tips over again.
//   Adding random noise (jitter) to each client's delay spreads the retries
//   across the window, keeping per-second load within the service's recovered
//   capacity.
//
//   Jitter is INTENTIONALLY caller-supplied (rand_permille, 0..1000). This
//   module stays pure and deterministic — every function given the same inputs
//   returns the same output, with no hidden state or random number generation.
//   Wire the jitter at the call site:
//
//     let r = some_rng_0_to_1000()
//     let wait = retry_apply_jitter(retry_delay(attempt, 100, 2000), r)
//
//   "Full jitter" (AWS recommendation): rand_permille uniformly in [0, 1000]
//   means the actual wait is uniform in [0, delay], which produces the best
//   load-spreading properties across a fleet.
//
// HOW THIS PAIRS WITH forge_circuit (WHEN available):
//   The circuit breaker decides IF you retry (it opens on too many failures and
//   stops all retries fast). This module decides WHEN you retry (the delay
//   schedule for the retries the circuit breaker permits through). Compose them:
//   check circuit before sending → on failure, check retry_should → compute
//   retry_delay → apply jitter → sleep → loop.
//
// VERIFIED BY REASONING (base=100, max=2000):
//   retry_delay(0,100,2000)  = 100   (attempt 0 → base)
//   retry_delay(1,100,2000)  = 200
//   retry_delay(2,100,2000)  = 400
//   retry_delay(3,100,2000)  = 800
//   retry_delay(4,100,2000)  = 1600
//   retry_delay(5,100,2000)  = 2000  (cap)
//   retry_delay(10,100,2000) = 2000  (overflow-safe early exit)
//   retry_should(2,3) = true   (2 < 3, still have a retry left)
//   retry_should(3,3) = false  (3 is not < 3, exhausted)
//   retry_apply_jitter(800,500) = 400  (800 * 500 / 1000)
//   retry_schedule(4,100,2000) = [100, 200, 400, 800]
//   retry_total_ms(4,100,2000) = 1500
//
// LEAF MODULE — imports NOTHING. Pure functions only. No actors, no channels,
// no clock. Built-ins used: push, len.
// ══════════════════════════════════════════════════════════════════════════════

// _retry_range(n) -> list
// Private helper: returns a list [0, 1, 2, ..., n-1]. Used as the iteration
// domain for retry_schedule's comprehension. Returns [] when n <= 0.
fn _retry_range(n: int) -> list
    let out = [i for i in 0..n]
    out

// retry_delay(attempt, base_ms, max_ms) -> int
// Compute the retry delay for a given attempt number (0-based).
// Returns base_ms * 2^attempt, capped at max_ms.
//
// The doubling is done iteratively (not with bit-shifts — NOVA 1<<n is unsound
// for n>=64, and iterative multiply is readable and overflow-safe via early exit).
// Guard: as soon as d >= max_ms during the doubling loop, stop and return max_ms.
// This prevents the product from wrapping on very large attempt values.
//
// attempt <= 0 → returns min(base_ms, max_ms).
fn retry_delay(attempt: int, base_ms: int, max_ms: int) -> int
    if attempt <= 0
        if base_ms >= max_ms
            return max_ms
        return base_ms
    let d = base_ms
    for i in 0..attempt
        d = d * 2
        if d >= max_ms
            return max_ms
    if d >= max_ms
        return max_ms
    d

// retry_should(attempt, max_attempts) -> bool
// True if the caller should perform another retry.
// attempt is 0-based (the attempt about to be performed, or the attempt that
// just failed). max_attempts is the total number of tries allowed.
// Returns attempt < max_attempts.
//
// Example: max_attempts=3 allows attempts 0, 1, 2 (three total).
//   retry_should(0,3) = true   (have not started yet)
//   retry_should(2,3) = true   (attempt 2 may still run)
//   retry_should(3,3) = false  (exhausted)
fn retry_should(attempt: int, max_attempts: int) -> bool
    attempt < max_attempts

// retry_apply_jitter(delay_ms, rand_permille) -> int
// Apply full-jitter to a delay: scale delay_ms by rand_permille/1000.
// rand_permille must be in [0, 1000]; values outside this range are clamped.
//   0    → returns 0 (no wait)
//   1000 → returns delay_ms (full wait)
//   500  → returns delay_ms/2 (half wait)
//
// The caller supplies rand_permille from their own RNG so this function stays
// pure (same inputs → same output, deterministic, testable).
// Integer arithmetic only; result truncates toward zero (safe: never overshoots).
fn retry_apply_jitter(delay_ms: int, rand_permille: int) -> int
    let rp = rand_permille
    if rp < 0
        rp = 0
    if rp > 1000
        rp = 1000
    (delay_ms * rp) / 1000

// retry_schedule(max_attempts, base_ms, max_ms) -> list
// Return the complete list of retry delays for attempts 0 .. max_attempts-1.
// This is the high-level view: the full backoff schedule in one call.
// Useful for logging the plan, computing total budget, or passing to a
// supervisor that drives retries with a pre-computed schedule.
//
// Example: retry_schedule(4, 100, 2000) = [100, 200, 400, 800]
fn retry_schedule(max_attempts: int, base_ms: int, max_ms: int) -> list
    let attempts = _retry_range(max_attempts)
    [retry_delay(a, base_ms, max_ms) for a in attempts]

// retry_total_ms(max_attempts, base_ms, max_ms) -> int
// Total worst-case delay across all retries in the schedule (no jitter).
// Use this for timeout budgeting: if the total retry wall-time must fit inside
// a deadline, compare against retry_total_ms before starting the loop.
//
// Example: retry_total_ms(4, 100, 2000) = 100+200+400+800 = 1500
fn retry_total_ms(max_attempts: int, base_ms: int, max_ms: int) -> int
    let sched = retry_schedule(max_attempts, base_ms, max_ms)
    let total = 0
    for i in 0..len(sched)
        total += sched[i]
    total
