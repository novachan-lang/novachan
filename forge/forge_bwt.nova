// forge_bwt -- Burrows-Wheeler Transform (the reversible permutation at the heart of bzip2). LEAF.

fn _bwt_less(doubled: string, i: int, j: int, n: int) -> bool
    for k in 0..n
        let ci = ord(char_at(doubled, i + k))
        let cj = ord(char_at(doubled, j + k))
        if ci < cj
            return true
        else if ci > cj
            return false
    false

fn bwt_transform(s: string) -> list
    let n = len(s)
    if n == 0
        return ["", 0]
    let doubled = s + s
    let idx = [t for t in 0..n]
    for a in 1..n
        let key = idx[a]
        let b = a - 1
        while b >= 0 and _bwt_less(doubled, key, idx[b], n)
            idx[b + 1] = idx[b]
            b -= 1
        idx[b + 1] = key
    let col_parts = []
    let primary = 0
    for r in 0..n
        let rot = idx[r]
        push(col_parts, char_at(doubled, rot + n - 1))
        if rot == 0
            primary = r
    [join(col_parts, ""), primary]

fn bwt_inverse(last_col: string, primary: int) -> string
    let n = len(last_col)
    if n == 0
        return ""
    let counts = {}
    for i in 0..n
        let ch = char_at(last_col, i)
        counts[ch] = get(counts, ch, 0) + 1
    let cstart = {}
    let total = 0
    for bch in 0..256
        let ch = chr(bch)
        if ch in counts
            cstart[ch] = total
            total += counts[ch]
    let occ = {}
    let lf = []
    for p in 0..n
        let ch = char_at(last_col, p)
        let rk = get(occ, ch, 0)
        push(lf, get(cstart, ch, 0) + rk)
        occ[ch] = rk + 1
    let result = ["" for z in 0..n]
    let cur = primary
    let k = n - 1
    while k >= 0
        result[k] = char_at(last_col, cur)
        cur = lf[cur]
        k -= 1
    join(result, "")
