// forge_bwt -- the Burrows-Wheeler Transform, the reversible permutation at the heart of bzip2. It does NOT
// compress on its own; it REORDERS a string so that characters sharing the same following context end up next to
// each other, producing long runs of repeated characters that RLE (forge_runlength) and entropy coders then
// squeeze hard. The magic is that this shuffle is perfectly INVERTIBLE from just the transformed string plus one
// integer (the "primary index") -- via the LF-mapping, which pairs each character in the last column with its twin
// in the sorted first column. Forward: sort all rotations of the string, take the last column. Inverse: walk the
// LF-mapping to rebuild the original. Used in bzip2, the FM-index (compressed full-text search / bioinformatics
// read alignment), and as a preprocessing stage that makes other compressors far more effective. Works on ordinary
// text/byte strings (no NUL). LEAF -- imports NOTHING.

// PRIVATE: is rotation starting at i lexicographically less than the one at j (both length n, over `doubled`=s+s)?
// Ordered by byte value so it matches the inverse's 0..255 scan.
fn _bwt_less(doubled: string, i: int, j: int, n: int) -> bool
    let out = false
    let decided = false
    let k = 0
    while k < n and decided == false
        let ci = ord(char_at(doubled, i + k))
        let cj = ord(char_at(doubled, j + k))
        if ci < cj
            out = true
            decided = true
        else
            if ci > cj
                decided = true
        k += 1
    out

// Transform s into [last_column, primary_index]. Pass both to bwt_inverse to recover s.
fn bwt_transform(s: string) -> list
    let n = len(s)
    let out = ["", 0]
    if n > 0
        let doubled = s + s
        // sort rotation start indices (insertion sort over an int array -- scalar moves, safe)
        let idx = [t for t in 0..n]
        for a in 1..n
            let key = idx[a]
            let b = a - 1
            while b >= 0 and _bwt_less(doubled, key, idx[b], n)
                idx[b + 1] = idx[b]
                b -= 1
            idx[b + 1] = key
        // last column + primary index
        let col_parts = []
        let primary = 0
        for r in 0..n
            let rot = idx[r]
            push(col_parts, char_at(doubled, rot + n - 1))
            if rot == 0
                primary = r
        let col = join(col_parts, "")
        out = [col, primary]
    out

// Invert the transform: given the last column L and the primary index, rebuild the original string via the
// LF-mapping. O(n) after an O(n) counting pass.
fn bwt_inverse(last_col: string, primary: int) -> string
    let n = len(last_col)
    let out = ""
    if n > 0
        // count occurrences of each character
        let counts = {}
        let i = 0
        while i < n
            let ch = char_at(last_col, i)
            counts[ch] = get(counts, ch, 0) + 1
            i += 1
        // C[ch] = number of characters in L that sort strictly before ch (start of ch's block in the first column)
        let cstart = {}
        let total = 0
        for bch in 0..256
            let ch = chr(bch)
            if ch in counts
                cstart[ch] = total
                total += counts[ch]
        // LF mapping: LF[i] = C[L[i]] + (occurrences of L[i] before position i)
        let occ = {}
        let lf = []
        for p in 0..n
            let ch = char_at(last_col, p)
            let rk = get(occ, ch, 0)
            push(lf, get(cstart, ch, 0) + rk)
            occ[ch] = rk + 1
        // walk LF backwards from the primary index, filling the result right-to-left
        let result = ["" for z in 0..n]
        let cur = primary
        let k = n - 1
        while k >= 0
            result[k] = char_at(last_col, cur)
            cur = lf[cur]
            k -= 1
        // join
        for m in 0..n
            out += result[m]
    out
