// forge_bwt -- Burrows-Wheeler Transform.
//
// This module used to be a thin re-export of std/compress/bwt, but that is
// impossible: std/compress/bwt.nova defines its public API under the EXACT
// same names forge needs to expose (bwt_transform, bwt_inverse). NOVA does
// not scope/mangle symbols per module -- importing std/compress/bwt while
// also declaring bwt_transform/bwt_inverse here emits two `define`s of the
// same global symbol and fails to link. (The previous stub avoided the link
// error by never importing successfully in the first place -- its bodies
// called themselves, i.e. infinite recursion, which the link failure was
// silently masking.)
//
// So this module carries its OWN full implementation -- ported directly from
// std/compress/bwt.nova's proven-correct algorithm, with forge-local helper
// names (prefixed `_fbwt_` instead of std's `_bwt_`) so it never collides
// with std/compress/bwt even if some other module in the same build imports
// that too. There is no `import std/...` line: it would be dead code (this
// module no longer calls into it) and reintroduce the exact collision above.
//
// Algorithm (see std/compress/bwt.nova for the full derivation/hand-trace):
//   FORWARD: sort the n cyclic rotations of s by start index; the transform
//   is the last column of the sorted rotation matrix; primaryIndex is the
//   row whose rotation is the original string (offset 0).
//   INVERSE: build the LF-mapping from the last column and walk it n times
//   from primaryIndex, then reverse.
//
// PUBLIC API:
//   bwt_transform(s: string) -> list   -- returns [transformedString, primaryIndex]
//   bwt_inverse(last_col: string, primary: int) -> string

fn _fbwt_pmod(xv, mv) -> int
    xv - (xv / mv) * mv

fn _fbwt_rcmp(sv, nv, ra, rb) -> int
    let ci = 0
    let cres = 0
    let cdone = 0
    while ci < nv and cdone == 0
        let cpa = _fbwt_pmod(ra + ci, nv)
        let cpb = _fbwt_pmod(rb + ci, nv)
        let cca = sv[cpa]
        let ccb = sv[cpb]
        if cca < ccb
            cres = 1
            cdone = 1
        else
            if cca > ccb
                cdone = 1
            else
                ci += 1
    cres

fn _fbwt_sortidx(sv, nv, src) -> list
    let ssorted = []
    for ssi in 0..nv
        let sskey = src[ssi]
        let sspos = len(ssorted)
        let ssj = 0
        let ssdone = 0
        while ssj < len(ssorted) and ssdone == 0
            let ssexist = ssorted[ssj]
            if _fbwt_rcmp(sv, nv, sskey, ssexist) == 1
                sspos = ssj
                ssdone = 1
            else
                ssj += 1
        let ssnew = []
        let ssk = 0
        while ssk < sspos
            push(ssnew, ssorted[ssk])
            ssk += 1
        push(ssnew, sskey)
        let ssk2 = sspos
        while ssk2 < len(ssorted)
            push(ssnew, ssorted[ssk2])
            ssk2 += 1
        ssorted = ssnew
    ssorted

fn bwt_transform(s: string) -> list
    let tn = len(s)
    if tn == 0
        let ter = ["", 0]
        return ter
    let tsrc = [tk for tk in 0..tn]
    let tidxs = _fbwt_sortidx(s, tn, tsrc)
    let ttransformed_parts = []
    let tprimary = 0
    for ti in 0..tn
        let trot = tidxs[ti]
        let tlp = _fbwt_pmod(trot + tn - 1, tn)
        push(ttransformed_parts, s[tlp])
        if trot == 0
            tprimary = ti
    let ttransformed = join(ttransformed_parts, "")
    let tres = [ttransformed, tprimary]
    tres

fn bwt_inverse(last_col: string, primary: int) -> string
    let ivn = len(last_col)
    if ivn == 0
        return ""
    let ivL = [last_col[ivi] for ivi in 0..ivn]
    let ivfreq = {}
    for ivi2 in 0..ivn
        let ivc2 = ivL[ivi2]
        if ivc2 in ivfreq
            ivfreq[ivc2] = ivfreq[ivc2] + 1
        else
            ivfreq[ivc2] = 1
    let ivkeys = keys(ivfreq)
    ivkeys = sort(ivkeys)
    let ivfstart = {}
    let ivcumul = 0
    for ivki in 0..len(ivkeys)
        let ivck = ivkeys[ivki]
        ivfstart[ivck] = ivcumul
        ivcumul += ivfreq[ivck]
    let ivseen = {}
    let ivLF = []
    for ivi3 in 0..ivn
        let ivc3 = ivL[ivi3]
        let ivrank = 0
        if ivc3 in ivseen
            ivrank = ivseen[ivc3]
        ivseen[ivc3] = ivrank + 1
        push(ivLF, ivfstart[ivc3] + ivrank)
    let ivchars = []
    let ivrow = primary
    for ivstep in 0..ivn
        push(ivchars, ivL[ivrow])
        ivrow = ivLF[ivrow]
    let ivout_parts = []
    let ivri = ivn - 1
    while ivri >= 0
        push(ivout_parts, ivchars[ivri])
        ivri -= 1
    let ivout = join(ivout_parts, "")
    ivout
