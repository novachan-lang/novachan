// forge_diff_engine — Compute diffs between dicts with Result.

fn diff_new() -> dict
    let d = {}
    d["changes"] = {}
    d["change_count"] = 0
    d

fn diff_compute(old_data: dict, new_data: dict) -> dict
    let d = diff_new()
    let old_keys = keys(old_data)
    let new_keys = keys(new_data)
    let i = 0
    while i < len(old_keys)
        let k = old_keys[i]
        let has = contains(new_data, k)
        if has != true
            let ck = str(d["change_count"])
            d["changes"][ck + "_key"] = k
            d["changes"][ck + "_type"] = "removed"
            d["changes"][ck + "_old"] = old_data[k]
            d["changes"][ck + "_new"] = ""
            d["change_count"] = d["change_count"] + 1
        else
            if old_data[k] != new_data[k]
                let ck = str(d["change_count"])
                d["changes"][ck + "_key"] = k
                d["changes"][ck + "_type"] = "modified"
                d["changes"][ck + "_old"] = old_data[k]
                d["changes"][ck + "_new"] = new_data[k]
                d["change_count"] = d["change_count"] + 1
        i += 1
    i = 0
    while i < len(new_keys)
        let k = new_keys[i]
        let has = contains(old_data, k)
        if has != true
            let ck = str(d["change_count"])
            d["changes"][ck + "_key"] = k
            d["changes"][ck + "_type"] = "added"
            d["changes"][ck + "_old"] = ""
            d["changes"][ck + "_new"] = new_data[k]
            d["change_count"] = d["change_count"] + 1
        i += 1
    d

fn diff_change_count(d: dict) -> int
    d["change_count"]

fn diff_change_key(d: dict, idx: int) -> Result
    if idx >= d["change_count"]
        return err("index out of range")
    ok(d["changes"][str(idx) + "_key"])

fn diff_change_type(d: dict, idx: int) -> Result
    if idx >= d["change_count"]
        return err("index out of range")
    ok(d["changes"][str(idx) + "_type"])

fn diff_has_changes(d: dict) -> int
    if d["change_count"] > 0
        return 1
    0
