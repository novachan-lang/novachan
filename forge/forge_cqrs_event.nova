// forge_cqrs_event — CQRS event sourcing framework.
// Event store + aggregate + projections. Pure data structures.

fn es_store_new() -> dict
    let s = {}
    s["events"] = []
    s["snapshots"] = {}
    s["version"] = 0
    s

fn es_append(store: dict, aggregate_id: string, event_type: string, data: dict) -> dict
    let version = store["version"] + 1
    store["version"] = version
    let evt = {}
    evt["id"] = version
    evt["aggregate_id"] = aggregate_id
    evt["type"] = event_type
    evt["data"] = data
    evt["version"] = version
    push(store["events"], evt)
    store

fn es_events_for(store: dict, aggregate_id: string) -> list
    let result = []
    let i = 0
    while i < len(store["events"])
        let e = store["events"][i]
        if e["aggregate_id"] == aggregate_id
            push(result, e)
        i = i + 1
    result

fn es_events_by_type(store: dict, event_type: string) -> list
    let result = []
    let i = 0
    while i < len(store["events"])
        let e = store["events"][i]
        if e["type"] == event_type
            push(result, e)
        i = i + 1
    result

fn es_snapshot(store: dict, aggregate_id: string, state: dict, at_version: int) -> dict
    let snap = {}
    snap["state"] = state
    snap["version"] = at_version
    store["snapshots"][aggregate_id] = snap
    store

fn es_get_snapshot(store: dict, aggregate_id: string) -> dict
    if contains(store["snapshots"], aggregate_id)
        return store["snapshots"][aggregate_id]
    let empty = {}
    empty["state"] = {}
    empty["version"] = 0
    empty

fn es_events_since(store: dict, aggregate_id: string, since_version: int) -> list
    let result = []
    let i = 0
    while i < len(store["events"])
        let e = store["events"][i]
        if e["aggregate_id"] == aggregate_id and e["version"] > since_version
            push(result, e)
        i = i + 1
    result

fn es_count(store: dict) -> int
    len(store["events"])

fn es_latest_version(store: dict) -> int
    store["version"]

fn es_project(store: dict, aggregate_id: string, initial: dict) -> dict
    let events = es_events_for(store, aggregate_id)
    let state = initial
    let i = 0
    while i < len(events)
        let e = events[i]
        let data = e["data"]
        let dk = keys(data)
        let j = 0
        while j < len(dk)
            state[dk[j]] = data[dk[j]]
            j = j + 1
        i = i + 1
    state
