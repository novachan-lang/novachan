// forge_email_validate -- practical email-address validation (RFC 5321-lite): a local part + "@" + a valid
// domain (checked via forge_hostname, requiring a dot/TLD). Not a full RFC parser (those accept pathological
// forms), but the validation signup/contact forms actually want. Complements forge_email_normalize (dedup).
// Composes forge_hostname. Imports forge_hostname.
import forge_hostname

fn _email_local_valid(local: string) -> bool
    let n = len(local)
    if n == 0 or n > 64
        return false
    if char_at(local, 0) == "." or char_at(local, n - 1) == "."
        return false
    let ok = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.!#$%&'*+-/=?^_`~"
    for i in 0..n
        let c = char_at(local, i)
        if find(ok, c) < 0
            return false
        if c == "." and i + 1 < n and char_at(local, i + 1) == "."
            return false
    true

// Valid email? Exactly one "@", a valid local part, and a valid domain with a dot.
fn email_valid(email: string) -> bool
    let at = find(email, "@")
    if at <= 0
        return false
    let domain = slice(email, at + 1, len(email))
    if find(domain, "@") >= 0
        return false
    if not _email_local_valid(slice(email, 0, at))
        return false
    if not hostname_valid(domain)
        return false
    find(domain, ".") >= 0

// The domain part of an email ("" if no "@").
fn email_domain(email: string) -> string
    let at = find(email, "@")
    if at < 0
        return ""
    slice(email, at + 1, len(email))
