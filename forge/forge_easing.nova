// forge_easing -- thin wrapper over std/math/easing (canonical implementation).
import std/math/easing

fn ease_linear(t: float) -> float
    return ease_linear(t)

fn ease_in_quad(t: float) -> float
    return ease_in_quad(t)

fn ease_out_quad(t: float) -> float
    return ease_out_quad(t)

fn ease_in_out_quad(t: float) -> float
    return ease_in_out_quad(t)

fn ease_in_cubic(t: float) -> float
    return ease_in_cubic(t)

fn ease_out_cubic(t: float) -> float
    return ease_out_cubic(t)

fn ease_in_out_cubic(t: float) -> float
    return ease_in_out_cubic(t)

fn lerp(a: float, b: float, t: float) -> float
    a + (b - a) * t

