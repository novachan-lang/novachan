// forge_easing -- easing (tweening) functions: map a normalized time t in [0,1] to an eased progress in [0,1],
// the curves that make UI transitions and game animations feel natural instead of robotic (Reactor animation,
// CSS-transition-equivalent motion, value interpolation over time). All map 0->0 and 1->1; they differ in the
// SHAPE between. Provides the quad and cubic families in in/out/in-out variants plus linear. Pair with lerp to
// animate any numeric property: value = a + (b - a) * ease(t). LEAF -- imports NOTHING.

// No easing -- constant speed.
fn ease_linear(t: float) -> float
    t

// Quadratic ease-in (slow start): t^2.
fn ease_in_quad(t: float) -> float
    t * t

// Quadratic ease-out (slow end): 1 - (1-t)^2.
fn ease_out_quad(t: float) -> float
    let u = 1.0 - t
    1.0 - u * u

// Quadratic ease-in-out (slow start and end).
fn ease_in_out_quad(t: float) -> float
    if t < 0.5
        return 2.0 * t * t
    let u = 0.0 - 2.0 * t + 2.0
    1.0 - (u * u) / 2.0

// Cubic ease-in: t^3.
fn ease_in_cubic(t: float) -> float
    t * t * t

// Cubic ease-out: 1 - (1-t)^3.
fn ease_out_cubic(t: float) -> float
    let u = 1.0 - t
    1.0 - u * u * u

// Cubic ease-in-out.
fn ease_in_out_cubic(t: float) -> float
    if t < 0.5
        return 4.0 * t * t * t
    let u = 0.0 - 2.0 * t + 2.0
    1.0 - (u * u * u) / 2.0

// Linear interpolation helper: a + (b - a) * t. Combine with an ease function on t to animate any value.
fn lerp(a: float, b: float, t: float) -> float
    a + (b - a) * t
