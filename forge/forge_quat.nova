// forge_quat -- quaternion math for 3D rotation: the representation every serious 3D/game engine (the NOVA
// Reactor plan) uses instead of Euler angles because quaternions compose cleanly and never gimbal-lock. A
// quaternion is a 4-element list [w, x, y, z] (w = scalar/real part, xyz = vector part). This module gives the
// Hamilton product, conjugate, norm/normalize, an axis-angle constructor, and rotation of a 3D vector by a
// unit quaternion (the sandwich product q v q*). Completes the vec3 / matrix / complex numeric family. LEAF
// -- imports NOTHING (uses sin/cos/sqrt builtins).

// The identity rotation [1,0,0,0] (rotating by it changes nothing).
fn quat_identity() -> list
    [1.0, 0.0, 0.0, 0.0]

// Hamilton product q1 * q2 (NOT commutative -- rotation order matters, applied right-to-left).
fn quat_mul(q1: list, q2: list) -> list
    let w1 = q1[0] * 1.0
    let x1 = q1[1] * 1.0
    let y1 = q1[2] * 1.0
    let z1 = q1[3] * 1.0
    let w2 = q2[0] * 1.0
    let x2 = q2[1] * 1.0
    let y2 = q2[2] * 1.0
    let z2 = q2[3] * 1.0
    let w = w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2
    let x = w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2
    let y = w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2
    let z = w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2
    [w, x, y, z]

// Conjugate [w, -x, -y, -z] -- for a unit quaternion this is its inverse (the opposite rotation).
fn quat_conj(q: list) -> list
    [q[0] * 1.0, 0.0 - q[1], 0.0 - q[2], 0.0 - q[3]]

// Norm |q| = sqrt(w^2 + x^2 + y^2 + z^2). NOTE: the sum-of-squares is bound to explicit float locals before
// sqrt -- a bare `sqrt(q[0]*q[0] + ... 4 terms)` return hits a NOVA float-return codegen edge (uninitialized
// return slot -> a denormal independent of the input). The explicit-locals form (as in quat_mul) is sound.
fn quat_norm(q: list) -> float
    let a = q[0] * 1.0
    let b = q[1] * 1.0
    let c = q[2] * 1.0
    let d = q[3] * 1.0
    let s = a * a + b * b + c * c + d * d
    sqrt(s)

// Unit quaternion in the same direction (a zero quaternion is returned unchanged).
fn quat_normalize(q: list) -> list
    let n = quat_norm(q)
    if n == 0.0
        return [q[0] * 1.0, q[1] * 1.0, q[2] * 1.0, q[3] * 1.0]
    [q[0] / n, q[1] / n, q[2] / n, q[3] / n]

// Build a rotation quaternion from a unit axis [ax,ay,az] and an angle in radians (right-hand rule).
fn quat_from_axis_angle(axis: list, angle: float) -> list
    let half = angle / 2.0
    let s = sin(half)
    [cos(half), axis[0] * s, axis[1] * s, axis[2] * s]

// Rotate a 3D vector v = [x,y,z] by a unit quaternion q via the sandwich product q * (0,v) * q*.
fn quat_rotate_vec(q: list, v: list) -> list
    let p = [0.0, v[0] * 1.0, v[1] * 1.0, v[2] * 1.0]
    let r = quat_mul(quat_mul(q, p), quat_conj(q))
    [r[1], r[2], r[3]]
