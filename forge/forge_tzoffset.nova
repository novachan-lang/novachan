// forge_tzoffset -- timezone-offset parsing + application: convert between UTC and a user's wall clock given a
// FIXED offset ("+05:30" / "-0800" / "Z"), and format an offset back. For displaying times in a user's zone
// and parsing offset-bearing ISO-8601 timestamps. (IANA/DST rules are out of scope -- ISO-8601 carries a fixed
// offset, which is exactly this.) LEAF -- imports NOTHING.

fn _tz_z2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

// Parse an offset ("+05:30", "-0800", "Z", "+00") -> MINUTES east of UTC. Z/empty -> 0.
fn tz_offset_minutes(offset: string) -> int
    let s = trim(offset)
    if len(s) == 0 or s == "Z" or s == "z"
        return 0
    let sign = 1
    let body = s
    if starts_with(s, "+")
        body = slice(s, 1, len(s))
    else if starts_with(s, "-")
        sign = -1
        body = slice(s, 1, len(s))
    let clean_parts = []
    for i in 0..len(body)
        let c = char_at(body, i)
        if c != ":"
            push(clean_parts, c)
    let clean = join(clean_parts, "")
    let hh = 0
    let mm = 0
    if len(clean) >= 2
        hh = parse_int(slice(clean, 0, 2))
    if len(clean) >= 4
        mm = parse_int(slice(clean, 2, 4))
    sign * (hh * 60 + mm)

// UTC epoch-seconds -> local epoch-seconds (for wall-clock display in a zone).
fn tz_to_local(utc_seconds: int, offset_minutes: int) -> int
    utc_seconds + offset_minutes * 60

// Local epoch-seconds -> UTC.
fn tz_to_utc(local_seconds: int, offset_minutes: int) -> int
    local_seconds - offset_minutes * 60

// Format minutes-east-of-UTC back to "+HH:MM" / "-HH:MM".
fn tz_format(offset_minutes: int) -> string
    let m = offset_minutes
    let sign = "+"
    if m < 0
        sign = "-"
        m = -m
    let hh = _tz_z2(m / 60)
    let mm = _tz_z2(m % 60)
    "{sign}{hh}:{mm}"
