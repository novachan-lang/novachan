// forge_tenant_isolator — Multi-tenant isolation with per-tenant quotas.

fn ti_new() -> dict
    let t = {}
    t["tenants"] = {}
    t["usage"] = {}
    t["count"] = 0
    t

fn ti_add_tenant(t: dict, tenant_id: string, max_requests: int) -> dict
    t["tenants"][tenant_id + "_max"] = max_requests
    t["tenants"][tenant_id + "_active"] = 1
    t["usage"][tenant_id] = 0
    t["count"] = t["count"] + 1
    t

fn ti_request(t: dict, tenant_id: string) -> dict
    let result = {}
    let has = contains(t["tenants"], tenant_id + "_active")
    if has != true
        result["allowed"] = 0
        result["reason"] = "unknown_tenant"
        result["t"] = t
        return result
    if t["tenants"][tenant_id + "_active"] != 1
        result["allowed"] = 0
        result["reason"] = "suspended"
        result["t"] = t
        return result
    let used = t["usage"][tenant_id]
    let max_r = t["tenants"][tenant_id + "_max"]
    if used >= max_r
        result["allowed"] = 0
        result["reason"] = "quota_exceeded"
        result["t"] = t
        return result
    t["usage"][tenant_id] = used + 1
    result["allowed"] = 1
    result["reason"] = ""
    result["t"] = t
    result

fn ti_suspend(t: dict, tenant_id: string) -> dict
    let has = contains(t["tenants"], tenant_id + "_active")
    if has == true
        t["tenants"][tenant_id + "_active"] = 0
    t

fn ti_activate(t: dict, tenant_id: string) -> dict
    let has = contains(t["tenants"], tenant_id + "_active")
    if has == true
        t["tenants"][tenant_id + "_active"] = 1
    t

fn ti_usage(t: dict, tenant_id: string) -> int
    let has = contains(t["usage"], tenant_id)
    if has != true
        return 0
    t["usage"][tenant_id]

fn ti_reset_usage(t: dict, tenant_id: string) -> dict
    let has = contains(t["usage"], tenant_id)
    if has == true
        t["usage"][tenant_id] = 0
    t

fn ti_tenant_count(t: dict) -> int
    t["count"]
