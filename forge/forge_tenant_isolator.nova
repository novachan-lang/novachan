// forge_tenant_isolator — Multi-tenant isolation with per-tenant quotas.

fn ti_new() -> dict
    {"tenants": {}, "usage": {}, "count": 0}

fn ti_add_tenant(t: dict, tenant_id: string, max_requests: int) -> dict
    t["tenants"]["{tenant_id}_max"] = max_requests
    t["tenants"]["{tenant_id}_active"] = 1
    t["usage"][tenant_id] = 0
    t["count"] += 1
    t

fn ti_request(t: dict, tenant_id: string) -> dict
    let active_key = "{tenant_id}_active"
    if active_key not in t["tenants"]
        return {"allowed": 0, "reason": "unknown_tenant", "t": t}
    if t["tenants"][active_key] != 1
        return {"allowed": 0, "reason": "suspended", "t": t}
    let used = t["usage"][tenant_id]
    let max_r = t["tenants"]["{tenant_id}_max"]
    if used >= max_r
        return {"allowed": 0, "reason": "quota_exceeded", "t": t}
    t["usage"][tenant_id] = used + 1
    {"allowed": 1, "reason": "", "t": t}

fn ti_suspend(t: dict, tenant_id: string) -> dict
    let key = "{tenant_id}_active"
    if key in t["tenants"]
        t["tenants"][key] = 0
    t

fn ti_activate(t: dict, tenant_id: string) -> dict
    let key = "{tenant_id}_active"
    if key in t["tenants"]
        t["tenants"][key] = 1
    t

fn ti_usage(t: dict, tenant_id: string) -> int
    if tenant_id not in t["usage"]
        return 0
    t["usage"][tenant_id]

fn ti_reset_usage(t: dict, tenant_id: string) -> dict
    if tenant_id in t["usage"]
        t["usage"][tenant_id] = 0
    t

fn ti_tenant_count(t: dict) -> int
    t["count"]
