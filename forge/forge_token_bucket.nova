// forge_token_bucket — Token bucket rate limiter.
// Configurable capacity, refill rate, consume/check.

fn tb_new(capacity: int, refill_rate: int) -> dict
    let tb = {}
    tb["capacity"] = capacity
    tb["tokens"] = capacity
    tb["refill_rate"] = refill_rate
    tb["last_refill"] = 0
    tb["total_consumed"] = 0
    tb["total_rejected"] = 0
    tb

fn tb_refill(tb: dict, now: int) -> dict
    let elapsed = now - tb["last_refill"]
    if elapsed <= 0
        return tb
    let new_tokens = elapsed * tb["refill_rate"]
    tb["tokens"] = tb["tokens"] + new_tokens
    if tb["tokens"] > tb["capacity"]
        tb["tokens"] = tb["capacity"]
    tb["last_refill"] = now
    tb

fn tb_consume(tb: dict, count: int, now: int) -> dict
    tb = tb_refill(tb, now)
    let r = {}
    if tb["tokens"] >= count
        tb["tokens"] = tb["tokens"] - count
        tb["total_consumed"] = tb["total_consumed"] + count
        r["allowed"] = 1
        r["remaining"] = tb["tokens"]
    else
        tb["total_rejected"] = tb["total_rejected"] + 1
        r["allowed"] = 0
        r["remaining"] = tb["tokens"]
    r["tb"] = tb
    r

fn tb_try_consume(tb: dict, now: int) -> dict
    tb_consume(tb, 1, now)

fn tb_available(tb: dict) -> int
    tb["tokens"]

fn tb_stats(tb: dict) -> dict
    let s = {}
    s["capacity"] = tb["capacity"]
    s["tokens"] = tb["tokens"]
    s["refill_rate"] = tb["refill_rate"]
    s["total_consumed"] = tb["total_consumed"]
    s["total_rejected"] = tb["total_rejected"]
    s
