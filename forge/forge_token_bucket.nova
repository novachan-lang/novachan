// forge_token_bucket — token bucket rate limiter with Result API.

fn tb_new(capacity: int, refill_rate: int) -> dict
    let b = {}
    b["capacity"] = capacity
    b["tokens"] = capacity
    b["refill_rate"] = refill_rate
    b["last_refill"] = 0
    b["total_allowed"] = 0
    b["total_denied"] = 0
    b

fn tb_refill(b: dict, now: int) -> dict
    let elapsed = now - b["last_refill"]
    if elapsed > 0
        let new_tokens = elapsed * b["refill_rate"]
        b["tokens"] = b["tokens"] + new_tokens
        if b["tokens"] > b["capacity"]
            b["tokens"] = b["capacity"]
        b["last_refill"] = now
    b

fn tb_consume(b: dict, count: int, now: int) -> Result
    b = tb_refill(b, now)
    if count > b["tokens"]
        b["total_denied"] = b["total_denied"] + 1
        return err("insufficient tokens")
    b["tokens"] = b["tokens"] - count
    b["total_allowed"] = b["total_allowed"] + 1
    ok(b)

fn tb_tokens(b: dict) -> int
    b["tokens"]

fn tb_capacity(b: dict) -> int
    b["capacity"]

fn tb_allow_rate(b: dict) -> int
    let total = b["total_allowed"] + b["total_denied"]
    if total == 0
        return 100
    b["total_allowed"] * 100 / total

fn tb_total_allowed(b: dict) -> int
    b["total_allowed"]

fn tb_total_denied(b: dict) -> int
    b["total_denied"]
