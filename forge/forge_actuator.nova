// forge_actuator -- S19: Spring Actuator-style introspection endpoints (routes / build-info / redacted env).
// Complements forge_obs (/metrics, /healthz, /readyz) with the "what's wired" introspection ops teams rely
// on for debugging (mappings, env, info). Reads the app dict (app["routes"] = [[method,path,handler]...])
// directly, so it's a LEAF -- imports NOTHING. Serve the results as JSON at /actuator/* routes.

// The registered routes as [{"method","path"}...] (Actuator /mappings).
fn actuator_routes(app) -> list
    let out = []
    let routes = app["routes"]
    for i in 0..len(routes)
        let r = routes[i]
        let e = {}
        e["method"] = r[0]
        e["path"] = r[1]
        push(out, e)
    out

// Build/app info (Actuator /info).
fn actuator_info(name: string, version: string, profile: string) -> dict
    let d = {}
    d["name"] = name
    d["version"] = version
    d["profile"] = profile
    d

// A key that names a secret (redact it in /env output).
fn _is_secret(k: string) -> bool
    find(k, "secret") >= 0 or find(k, "password") >= 0 or find(k, "token") >= 0 or find(k, "key") >= 0

// Redacted config (Actuator /env) -- secret-looking keys are masked so the endpoint never leaks credentials.
fn actuator_env(cfg: dict) -> dict
    let out = {}
    for k in keys(cfg)
        if _is_secret(lower(k))
            out[k] = "***"
        else
            out[k] = cfg[k]
    out
