// forge_qs -- URL query-string BUILD + PARSE with percent-encoding (WHATWG URL / Rack::Utils /
// Spring UriComponentsBuilder). qs_encode/qs_decode do component-level percent-coding; qs_build/qs_parse
// turn a dict into "k1=v1&k2=v2" and back. Space encodes as %20 on write; "+" decodes to space on read
// (form convention). LEAF -- imports NOTHING.
//
// TOTAL BY CONTRACT: every input maps to a defined output -- a stray "%", a pair with no "=", an
// empty string and a bare "?" are all *specified* results, not failures. That is why nothing here
// returns a Result: there is no failure to report, and adding one would change the public contract
// rather than raise the implementation.

// RFC 3986 unreserved set -- these bytes pass through qs_encode untouched. Module-level so the
// tables are materialised once instead of once per character scanned.
let _QS_UNRESERVED = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
let _QS_HEX_UP = "0123456789ABCDEF"
let _QS_HEX_LOW = "0123456789abcdef"

// Two uppercase hex digits for a byte 0..255. e.g. _hex2(32) -> "20", _hex2(255) -> "FF".
fn _hex2(b: int) -> string
    "{char_at(_QS_HEX_UP, b / 16)}{char_at(_QS_HEX_UP, b % 16)}"

// A single hex char '0'-'9','A'-'F','a'-'f' -> 0..15, or -1 if not a hex digit.
// The -1 is a DATA signal consumed one line later, not an error escaping to a caller -- see the
// TOTAL BY CONTRACT note above.
fn _unhex(c: string) -> int
    find(_QS_HEX_LOW, lower(c))

// One character percent-encoded: itself when unreserved, else "%HH".
fn _qs_enc_char(ch: string) -> string
    ch if find(_QS_UNRESERVED, ch) >= 0 else "%" + _hex2(ord(ch))

// Percent-encode a string for a query component. Unreserved (A-Z a-z 0-9 - _ . ~) pass through;
// every other byte becomes %HH (uppercase). A space becomes %20, not "+".
fn qs_encode(s: string) -> string
    [_qs_enc_char(char_at(s, i)) for i in 0..len(s)].join("")

// The byte encoded by a "%HH" escape starting at index i, or -1 when there is no complete,
// well-formed two-hex-digit escape there (which is what makes a stray "%" fall through as literal).
fn _qs_esc_at(s: string, i: int, n: int) -> int
    if i + 2 >= n
        return -1
    let hi = _unhex(char_at(s, i + 1))
    let lo = _unhex(char_at(s, i + 2))
    if hi < 0 or lo < 0
        return -1
    hi * 16 + lo

// Inverse of qs_encode. %HH -> the byte; "+" -> a space. A stray "%" not followed by two hex
// digits is emitted literally.
// STAYS a while loop: the step is data-dependent (3 bytes over a valid escape, 1 otherwise), so it
// is not a counted loop. What did change is the accumulator -- pieces are pushed and join()ed ONCE
// instead of the O(n^2) `out = out + piece`.
fn qs_decode(s: string) -> string
    let parts = []
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        if ch == "+"
            push(parts, " ")
            i += 1
        else
            let b = _qs_esc_at(s, i, n) if ch == "%" else -1
            if b >= 0
                push(parts, chr(b))
                i += 3
            else
                push(parts, ch)
                i += 1
    parts.join("")

// Build "k1=v1&k2=v2" from a dict, percent-encoding BOTH keys and values. Order = keys() order.
// Empty dict -> "" (join of an empty list).
fn qs_build(params: dict) -> string
    ["{qs_encode(k)}={qs_encode(str(params[k]))}" for k in keys(params)].join("&")

// The raw (still-encoded) key of one "k=v" pair. A pair with no "=" is entirely the key.
fn _qs_key_of(pair: string) -> string
    let eq = find(pair, "=")
    pair if eq < 0 else slice(pair, 0, eq)

// The raw (still-encoded) value of one "k=v" pair. A pair with no "=" has the empty value.
fn _qs_val_of(pair: string) -> string
    let eq = find(pair, "=")
    "" if eq < 0 else slice(pair, eq + 1, len(pair))

// Parse "k1=v1&k2=v2" (optional leading "?") into a dict, qs_decode-ing keys and values. A pair with
// no "=" maps the key to "". Later duplicate keys overwrite earlier ones (the comprehension inserts
// in split order, so the last write wins, exactly as the old loop did). Empty string -> empty dict:
// split("", "&") yields [""], which the `len(p) > 0` filter drops.
fn qs_parse(query: string) -> dict
    let q = query
    if len(q) > 0 and char_at(q, 0) == "?"
        q = slice(q, 1, len(q))
    {qs_decode(_qs_key_of(p)): qs_decode(_qs_val_of(p)) for p in split(q, "&") if len(p) > 0}
