// forge_qs -- URL query-string BUILD + PARSE with percent-encoding (WHATWG URL / Rack::Utils /
// Spring UriComponentsBuilder). qs_encode/qs_decode do component-level percent-coding; qs_build/qs_parse
// turn a dict into "k1=v1&k2=v2" and back. Space encodes as %20 on write; "+" decodes to space on read
// (form convention). LEAF -- imports NOTHING.

// Two uppercase hex digits for a byte 0..255. e.g. _hex2(32) -> "20", _hex2(255) -> "FF".
fn _hex2(b: int) -> string
    let hexdigits = "0123456789ABCDEF"
    char_at(hexdigits, b / 16) + char_at(hexdigits, b % 16)

// A single hex char '0'-'9','A'-'F','a'-'f' -> 0..15, or -1 if not a hex digit.
fn _unhex(c: string) -> int
    find("0123456789abcdef", lower(c))

// Percent-encode a string for a query component. Unreserved (A-Z a-z 0-9 - _ . ~) pass through;
// every other byte becomes %HH (uppercase). A space becomes %20, not "+".
fn qs_encode(s: string) -> string
    let unreserved = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        if find(unreserved, ch) >= 0
            out = out + ch
        else
            let b = ord(ch)
            out = out + "%" + _hex2(b)
        i = i + 1
    out

// Inverse of qs_encode. %HH -> the byte; "+" -> a space. A stray "%" not followed by two hex
// digits is emitted literally.
fn qs_decode(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        if ch == "+"
            out = out + " "
            i = i + 1
        else
            if ch == "%" and i + 2 < n
                let hi = _unhex(char_at(s, i + 1))
                let lo = _unhex(char_at(s, i + 2))
                if hi >= 0 and lo >= 0
                    out = out + chr(hi * 16 + lo)
                    i = i + 3
                else
                    out = out + ch
                    i = i + 1
            else
                out = out + ch
                i = i + 1
    out

// Build "k1=v1&k2=v2" from a dict, percent-encoding BOTH keys and values. Order = keys() order.
// Empty dict -> "".
fn qs_build(params: dict) -> string
    let out = ""
    let first = 1
    for k in keys(params)
        let piece = qs_encode(k) + "=" + qs_encode(str(params[k]))
        if first == 1
            out = piece
            first = 0
        else
            out = out + "&" + piece
    out

// Parse "k1=v1&k2=v2" (optional leading "?") into a dict, qs_decode-ing keys and values. A pair with
// no "=" maps the key to "". Later duplicate keys overwrite earlier ones. Empty string -> empty dict.
fn qs_parse(query: string) -> dict
    let out = {}
    let q = query
    if len(q) > 0 and char_at(q, 0) == "?"
        q = slice(q, 1, len(q))
    if len(q) == 0
        return out
    for pair in split(q, "&")
        if len(pair) > 0
            let eq = find(pair, "=")
            if eq < 0
                out[qs_decode(pair)] = ""
            else
                let k = slice(pair, 0, eq)
                let v = slice(pair, eq + 1, len(pair))
                out[qs_decode(k)] = qs_decode(v)
    out
