// forge_event_bus_typed — Typed event bus with topic filtering.
// Publish typed events, subscribe by type, replay.

fn eb_new() -> dict
    let eb = {}
    eb["events"] = []
    eb["subscriptions"] = []
    eb["published"] = 0
    eb

fn eb_subscribe(eb: dict, subscriber: string, event_type: string) -> dict
    let sub = {}
    sub["subscriber"] = subscriber
    sub["event_type"] = event_type
    sub["received"] = 0
    push(eb["subscriptions"], sub)
    eb

fn eb_publish(eb: dict, event_type: string, payload: string, timestamp: int) -> dict
    let ev = {}
    ev["type"] = event_type
    ev["payload"] = payload
    ev["timestamp"] = timestamp
    push(eb["events"], ev)
    eb["published"] = eb["published"] + 1
    let i = 0
    while i < len(eb["subscriptions"])
        if eb["subscriptions"][i]["event_type"] == event_type
            eb["subscriptions"][i]["received"] = eb["subscriptions"][i]["received"] + 1
        i += 1
    eb

fn eb_events_of_type(eb: dict, event_type: string) -> list
    let result = []
    let i = 0
    while i < len(eb["events"])
        if eb["events"][i]["type"] == event_type
            push(result, eb["events"][i])
        i += 1
    result

fn eb_subscriber_count(eb: dict, event_type: string) -> int
    let count = 0
    let i = 0
    while i < len(eb["subscriptions"])
        if eb["subscriptions"][i]["event_type"] == event_type
            count += 1
        i += 1
    count

fn eb_received_count(eb: dict, subscriber: string) -> int
    let i = 0
    while i < len(eb["subscriptions"])
        if eb["subscriptions"][i]["subscriber"] == subscriber
            return eb["subscriptions"][i]["received"]
        i += 1
    0

fn eb_total_published(eb: dict) -> int
    eb["published"]

fn eb_event_count(eb: dict) -> int
    len(eb["events"])

fn eb_since(eb: dict, timestamp: int) -> list
    let result = []
    let i = 0
    while i < len(eb["events"])
        if eb["events"][i]["timestamp"] >= timestamp
            push(result, eb["events"][i])
        i += 1
    result
