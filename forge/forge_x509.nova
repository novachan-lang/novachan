// forge_x509 — a minimal DER/ASN.1 reader + writer for X.509 certificates and SubjectPublicKeyInfo.
// Pure byte-list operations; no crypto dependency (the certificate signature is verified by the caller
// using forge_crypto). DER tags: SEQUENCE 0x30, INTEGER 0x02, OID 0x06, BIT STRING 0x03, OCTET STRING
// 0x04, UTCTime 0x17, [0] EXPLICIT 0xa0.

// Parse one TLV at offset `off` -> [tag, length, value_start, next_offset].
fn der_tlv(b, off: int) -> list
    let tag = b[off]
    let lb = b[off + 1]
    let length = 0
    let vstart = 0
    if lb < 128
        length = lb
        vstart = off + 2
    else
        let nbytes = lb & 127
        let acc = 0
        let i = 0
        while i < nbytes
            acc = (acc << 8) | b[off + 2 + i]
            i = i + 1
        length = acc
        vstart = off + 2 + nbytes
    let r = []
    push(r, tag)
    push(r, length)
    push(r, vstart)
    push(r, vstart + length)
    r

fn der_slice(b, start: int, end: int) -> list
    let out = []
    let i = start
    while i < end
        push(out, b[i])
        i = i + 1
    out

fn x_cat(a, b) -> list
    let o = []
    let i = 0
    while i < len(a)
        push(o, a[i])
        i = i + 1
    let j = 0
    while j < len(b)
        push(o, b[j])
        j = j + 1
    o

// DER length encoding (short form < 128, else 0x80|n followed by big-endian length bytes).
fn der_enc_len(n: int) -> list
    let out = []
    if n < 128
        push(out, n)
    else
        let tmp = []
        let v = n
        while v > 0
            push(tmp, v & 255)
            v = v >> 8
        push(out, 128 | len(tmp))
        let i = len(tmp) - 1
        while i >= 0
            push(out, tmp[i])
            i = i - 1
    out

// Encode one TLV: tag || length || value.
fn der_enc(tag: int, value) -> list
    let out = []
    push(out, tag)
    let lb = der_enc_len(len(value))
    let i = 0
    while i < len(lb)
        push(out, lb[i])
        i = i + 1
    let j = 0
    while j < len(value)
        push(out, value[j])
        j = j + 1
    out

// Parse a SubjectPublicKeyInfo -> [algorithm_oid_bytes, public_key_bytes].
fn x509_spki_key(der) -> list
    let spki = der_tlv(der, 0)
    let alg = der_tlv(der, spki[2])
    let algoid = der_tlv(der, alg[2])
    let oid = der_slice(der, algoid[2], algoid[3])
    let keybits = der_tlv(der, alg[3])
    // BIT STRING value begins with the unused-bits count (0x00 for keys)
    let key = der_slice(der, keybits[2] + 1, keybits[3])
    let r = []
    push(r, oid)
    push(r, key)
    r

// Parse a Certificate -> [tbs_raw, signature, spki_key, spki_alg_oid, serial, notBefore, notAfter].
// tbs_raw is the exact DER of tbsCertificate (the bytes covered by the certificate signature).
fn x509_parse_cert(der) -> list
    let outer = der_tlv(der, 0)
    let tbs = der_tlv(der, outer[2])
    let tbs_raw = der_slice(der, outer[2], tbs[3])
    let sigalg = der_tlv(der, tbs[3])
    let sigval = der_tlv(der, sigalg[3])
    let sig = der_slice(der, sigval[2] + 1, sigval[3])
    // walk tbsCertificate children
    let p = tbs[2]
    let first = der_tlv(der, p)
    if first[0] == 160
        p = first[3]
    let serial = der_tlv(der, p)
    let siginner = der_tlv(der, serial[3])
    let issuer = der_tlv(der, siginner[3])
    let validity = der_tlv(der, issuer[3])
    let subject = der_tlv(der, validity[3])
    let spki = der_tlv(der, subject[3])
    let alg = der_tlv(der, spki[2])
    let algoid = der_tlv(der, alg[2])
    let spki_oid = der_slice(der, algoid[2], algoid[3])
    let keybits = der_tlv(der, alg[3])
    let spki_key = der_slice(der, keybits[2] + 1, keybits[3])
    let nb = der_tlv(der, validity[2])
    let na = der_tlv(der, nb[3])
    let r = []
    push(r, tbs_raw)
    push(r, sig)
    push(r, spki_key)
    push(r, spki_oid)
    push(r, der_slice(der, serial[2], serial[3]))
    push(r, der_slice(der, nb[2], nb[3]))
    push(r, der_slice(der, na[2], na[3]))
    r

// The certificate's outer signatureAlgorithm OID bytes (how the cert was signed by its issuer).
fn x509_sig_alg_oid(der) -> list
    let outer = der_tlv(der, 0)
    let tbs = der_tlv(der, outer[2])
    let sigalg = der_tlv(der, tbs[3])
    let oid = der_tlv(der, sigalg[2])
    der_slice(der, oid[2], oid[3])

// Raw issuer Distinguished Name element (whole SEQUENCE, tag..end) for byte-equality name chaining.
fn x509_issuer_raw(der) -> list
    let outer = der_tlv(der, 0)
    let tbs = der_tlv(der, outer[2])
    let p = tbs[2]
    let first = der_tlv(der, p)
    if first[0] == 160
        p = first[3]
    let serial = der_tlv(der, p)
    let siginner = der_tlv(der, serial[3])
    let issuer = der_tlv(der, siginner[3])
    der_slice(der, siginner[3], issuer[3])

// Raw subject Distinguished Name element (whole SEQUENCE, tag..end).
fn x509_subject_raw(der) -> list
    let outer = der_tlv(der, 0)
    let tbs = der_tlv(der, outer[2])
    let p = tbs[2]
    let first = der_tlv(der, p)
    if first[0] == 160
        p = first[3]
    let serial = der_tlv(der, p)
    let siginner = der_tlv(der, serial[3])
    let issuer = der_tlv(der, siginner[3])
    let validity = der_tlv(der, issuer[3])
    let subject = der_tlv(der, validity[3])
    der_slice(der, validity[3], subject[3])
