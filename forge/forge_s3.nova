// forge_s3 -- build SIGNED Amazon S3 requests (GET/PUT/DELETE an object) with no SDK, by assembling the S3
// canonical request and signing it with the KAT-verified AWS SigV4 (forge_awssigv4). Returns a request dict
// (url + method + Authorization + x-amz-* headers) ready to hand to the HTTP client. This makes S3 the cloud
// blob backend behind forge_storage. Virtual-hosted-style (bucket.s3.region.amazonaws.com). Imports forge_awssigv4.
import forge_awssigv4

// The virtual-hosted-style S3 host for a bucket + region.
fn s3_host(bucket: string, region: string) -> string
    bucket + ".s3." + region + ".amazonaws.com"

// Build a fully-signed S3 request. amz_date = "YYYYMMDDTHHMMSSZ", date_stamp = "YYYYMMDD" (same instant).
// `key` is the object key WITHOUT a leading slash (simple keys; URL-encode path segments for keys with spaces
// or reserved chars before calling). Returns a dict: method/url/host/authorization/x-amz-date/x-amz-content-sha256.
fn s3_request(access_key: string, secret: string, region: string, bucket: string, key: string, method: string, body: string, amz_date: string, date_stamp: string) -> dict
    let host = s3_host(bucket, region)
    let uri = "/" + key
    let payload_hash = sigv4_payload_hash(body)
    let nl = chr(10)
    let canonical_headers = "host:" + host + nl + "x-amz-content-sha256:" + payload_hash + nl + "x-amz-date:" + amz_date + nl
    let signed_headers = "host;x-amz-content-sha256;x-amz-date"
    let creq = sigv4_canonical_request(method, uri, "", canonical_headers, signed_headers, payload_hash)
    let scope = sigv4_scope(date_stamp, region, "s3")
    let sts = sigv4_string_to_sign(amz_date, scope, creq)
    let sig = sigv4_signature(secret, date_stamp, region, "s3", sts)
    let out = {}
    out["method"] = method
    out["url"] = "https://" + host + uri
    out["host"] = host
    out["authorization"] = sigv4_auth_header(access_key, scope, signed_headers, sig)
    out["x-amz-date"] = amz_date
    out["x-amz-content-sha256"] = payload_hash
    out

fn s3_get(access_key: string, secret: string, region: string, bucket: string, key: string, amz_date: string, date_stamp: string) -> dict
    s3_request(access_key, secret, region, bucket, key, "GET", "", amz_date, date_stamp)

fn s3_put(access_key: string, secret: string, region: string, bucket: string, key: string, body: string, amz_date: string, date_stamp: string) -> dict
    s3_request(access_key, secret, region, bucket, key, "PUT", body, amz_date, date_stamp)

fn s3_delete(access_key: string, secret: string, region: string, bucket: string, key: string, amz_date: string, date_stamp: string) -> dict
    s3_request(access_key, secret, region, bucket, key, "DELETE", "", amz_date, date_stamp)
