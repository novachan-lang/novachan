// forge_circuit_state — circuit breaker state machine with Result API.

fn cs_new(failure_threshold: int, recovery_timeout: int) -> dict
    let c = {}
    c["state"] = "closed"
    c["failures"] = 0
    c["successes"] = 0
    c["threshold"] = failure_threshold
    c["recovery"] = recovery_timeout
    c["opened_at"] = 0
    c["total_trips"] = 0
    c["total_calls"] = 0
    c

fn cs_call(c: dict, now: int) -> Result
    c["total_calls"] = c["total_calls"] + 1
    if c["state"] == "open"
        if now - c["opened_at"] >= c["recovery"]
            c["state"] = "half_open"
            return ok("half_open")
        return err("circuit open")
    ok(c["state"])

fn cs_record_success(c: dict) -> dict
    c["successes"] = c["successes"] + 1
    if c["state"] == "half_open"
        c["state"] = "closed"
        c["failures"] = 0
    c

fn cs_record_failure(c: dict, now: int) -> dict
    c["failures"] = c["failures"] + 1
    if c["failures"] >= c["threshold"]
        c["state"] = "open"
        c["opened_at"] = now
        c["total_trips"] = c["total_trips"] + 1
    c

fn cs_state(c: dict) -> string
    c["state"]

fn cs_failure_count(c: dict) -> int
    c["failures"]

fn cs_total_trips(c: dict) -> int
    c["total_trips"]

fn cs_total_calls(c: dict) -> int
    c["total_calls"]
