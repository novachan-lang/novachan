// forge_combnums -- the combinatorial counting numbers BEYOND the factorials, permutations, combinations and
// Catalan numbers of forge_combinatorics: Bell numbers, Stirling numbers of both kinds, derangements, and the
// integer partition function. Each answers a "how many ways" question that shows up constantly in probability,
// algorithm analysis, and enumeration. bell(n) counts the ways to partition a set of n labelled items into groups
// (the number of equivalence relations on n things). stirling2(n,k) refines that to exactly k non-empty groups --
// the surjection/"distribute distinct balls into identical boxes" count. stirling1(n,k) counts the permutations of
// n items having exactly k cycles (the coefficients that convert between falling-factorial and ordinary powers).
// derangement(n) counts permutations with NO fixed point (the hat-check problem; probability ~1/e). partitions(n)
// counts the ways to write n as an unordered sum of positive integers (coin-change with every denomination). All
// are exact integer DP recurrences; results grow fast, so keep n moderate (they must fit in signed 64-bit --
// partitions(n) is safe well past n=400, bell(n) past n=25). LEAF -- imports NOTHING.

// The Bell number B(n): the number of ways to partition a set of n elements into non-empty subsets. Built from the
// Bell triangle (each row starts with the previous row's last value, then adds the value above).
fn bell(n: int) -> int
    let out = 1
    if n > 0
        let prev = [1]
        let i = 1
        while i <= n
            let cur = []
            push(cur, prev[len(prev) - 1])
            let j = 1
            while j <= i
                push(cur, cur[j - 1] + prev[j - 1])
                j += 1
            prev = cur
            i += 1
        out = prev[0]
    out

// The Stirling number of the SECOND kind S(n,k): the number of ways to partition n labelled elements into exactly
// k non-empty unlabelled subsets. Recurrence S(n,k) = k*S(n-1,k) + S(n-1,k-1), with S(0,0)=1.
fn stirling2(n: int, k: int) -> int
    let out = 0
    if n >= 0 and k >= 0 and k <= n
        let prev = []
        let z = 0
        while z <= k
            push(prev, 0)
            z += 1
        prev[0] = 1
        let i = 1
        while i <= n
            let cur = []
            let z2 = 0
            while z2 <= k
                push(cur, 0)
                z2 += 1
            let j = 1
            while j <= k
                cur[j] = j * prev[j] + prev[j - 1]
                j += 1
            prev = cur
            i += 1
        out = prev[k]
    out

// The unsigned Stirling number of the FIRST kind c(n,k): the number of permutations of n elements having exactly k
// disjoint cycles. Recurrence c(n,k) = (n-1)*c(n-1,k) + c(n-1,k-1), with c(0,0)=1.
fn stirling1(n: int, k: int) -> int
    let out = 0
    if n >= 0 and k >= 0 and k <= n
        let prev = []
        let z = 0
        while z <= k
            push(prev, 0)
            z += 1
        prev[0] = 1
        let i = 1
        while i <= n
            let cur = []
            let z2 = 0
            while z2 <= k
                push(cur, 0)
                z2 += 1
            let j = 1
            while j <= k
                cur[j] = (i - 1) * prev[j] + prev[j - 1]
                j += 1
            prev = cur
            i += 1
        out = prev[k]
    out

// The number of derangements !n (subfactorial): permutations of n elements with no element left in its own place.
// Recurrence D(n) = (n-1)*(D(n-1)+D(n-2)), with D(0)=1, D(1)=0.
fn derangement(n: int) -> int
    let out = 1
    if n == 1
        out = 0
    else
        if n >= 2
            let a = 1
            let b = 0
            let i = 2
            while i <= n
                let d = (i - 1) * (a + b)
                a = b
                b = d
                i += 1
            out = b
    out

// The integer partition function p(n): the number of ways to write n as an unordered sum of positive integers
// (order does not matter, so 3 = 2+1 = 1+1+1 gives p(3)=3). Computed by the classic coin-change DP that lets every
// integer 1..n be used any number of times.
fn partitions(n: int) -> int
    let out = 0
    if n == 0
        out = 1
    else
        if n > 0
            let dp = []
            let z = 0
            while z <= n
                push(dp, 0)
                z += 1
            dp[0] = 1
            let k = 1
            while k <= n
                let j = k
                while j <= n
                    dp[j] = dp[j] + dp[j - k]
                    j += 1
                k += 1
            out = dp[n]
    out
