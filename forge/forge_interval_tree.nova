// forge_interval_tree — Simple interval store with overlap queries.

fn it_new() -> dict
    {"intervals": {}, "count": 0}

fn it_insert(t: dict, start_val: int, end_val: int, label: string) -> dict
    let k = str(t["count"])
    t["intervals"][k + "_start"] = start_val
    t["intervals"][k + "_end"] = end_val
    t["intervals"][k + "_label"] = label
    t["count"] += 1
    t

fn it_overlaps(t: dict, start_val: int, end_val: int) -> int
    let count = 0
    for i in 0..t["count"]
        let k = str(i)
        let s = t["intervals"][k + "_start"]
        let e = t["intervals"][k + "_end"]
        if s < end_val and e > start_val
            count += 1
    count

fn it_contains_point(t: dict, point: int) -> int
    let count = 0
    for i in 0..t["count"]
        let k = str(i)
        let s = t["intervals"][k + "_start"]
        let e = t["intervals"][k + "_end"]
        if point >= s and point < e
            count += 1
    count

fn it_first_overlap_label(t: dict, start_val: int, end_val: int) -> string
    for i in 0..t["count"]
        let k = str(i)
        let s = t["intervals"][k + "_start"]
        let e = t["intervals"][k + "_end"]
        if s < end_val and e > start_val
            return t["intervals"][k + "_label"]
    ""

fn it_count(t: dict) -> int
    t["count"]

fn it_label(t: dict, idx: int) -> string
    t["intervals"][str(idx) + "_label"]
