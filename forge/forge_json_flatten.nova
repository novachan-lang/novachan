// forge_json_flatten -- flatten a nested dict to dotted-key paths ("a.b.c" -> value) and un-flatten back. For
// config diffing, form-field serialization, analytics event flattening, and nested->env-var mapping. Leaves are
// any non-dict value. LEAF -- imports NOTHING.

fn _flatten_into(node: any, prefix: string, out: dict)
    if type_of(node) == "dict"
        let ks = keys(node)
        for i in 0..len(ks)
            let k = ks[i]
            let np = k
            if len(prefix) > 0
                np = prefix + "." + k
            _flatten_into(node[k], np, out)
    else
        out[prefix] = node

// Flatten a nested dict -> a flat dict of dotted-path keys.
fn json_flatten(node: dict) -> dict
    let out = {}
    _flatten_into(node, "", out)
    out

fn _unflatten_set(root: dict, path: string, value: any)
    let segs = split(path, ".")
    let n = len(segs)
    let cur = root
    for j in 0..(n - 1)
        let seg = segs[j]
        if seg in cur == false or type_of(cur[seg]) != "dict"
            let fresh = {}
            cur[seg] = fresh
        cur = cur[seg]
    cur[segs[n - 1]] = value

// Un-flatten dotted-path keys back into a nested dict.
fn json_unflatten(flat: dict) -> dict
    let out = {}
    let ks = keys(flat)
    for i in 0..len(ks)
        _unflatten_set(out, ks[i], flat[ks[i]])
    out
