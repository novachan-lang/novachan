// forge_productexcept -- for each position, the product of every OTHER element of the array, computed WITHOUT
// division. The tempting shortcut is "total product / this element", but that explodes the moment any element is
// zero (division by zero) and loses precision with floats. The clean O(n) trick uses two sweeps: first fill each
// slot with the product of everything to its LEFT (a running prefix product), then sweep back multiplying in the
// product of everything to its RIGHT (a running suffix product). No division, and it handles zeros perfectly --
// with one zero, only that position is non-zero; with two or more, every result is zero. This is the archetypal
// "prefix/suffix product" pattern, used to normalize weights without touching the current item, compute
// leave-one-out aggregates, balance influence in ranking, and as a building block in differentiation-free
// numerics. Integer arrays (mind 64-bit overflow on long inputs). LEAF -- imports NOTHING.

// A list where element i is the product of all elements of `arr` except arr[i]. product_except_self([1,2,3,4]) =
// [24,12,8,6]. Uses prefix and suffix products, so zeros are handled and no division is performed.
fn product_except_self(arr: list) -> list
    let n = len(arr)
    let result = [1 for z in 0..n]
    // left/prefix products
    let prefix = 1
    for i in 0..n
        result[i] = prefix
        prefix = prefix * arr[i]
    // right/suffix products
    let suffix = 1
    let j = n - 1
    while j >= 0
        result[j] = result[j] * suffix
        suffix = suffix * arr[j]
        j -= 1
    result
