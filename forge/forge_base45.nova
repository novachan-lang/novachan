// forge_base45 -- Base45 encoding (RFC 9285): a compact, QR-code-friendly binary-to-text encoding. Base45 is
// the payload encoding used by the EU Digital COVID Certificate and other QR-carried structured data, because
// the QR "alphanumeric" mode encodes exactly this 45-character set densely. It sits alongside forge_base32/58/
// 62/64 in the encoding family but is optimized for QR, not URLs. Encodes a byte list to a Base45 string.
//
// Algorithm: bytes are taken two at a time; each pair (a,b) -> n = a*256 + b is written as THREE base-45
// digits, least-significant first (n = c + d*45 + e*45*45). A lone trailing byte -> TWO digits (a = c + d*45).
// Alphabet index: 0-9, A-Z, then space $ % * + - . / :  (45 symbols). LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Two problems:
//
//   1. base45_encode used `out += ...` string concat (QUADRATIC). push to parts + join.
//   2. Three-char / two-char symbol groups used multi-concat. Interpolation.

fn _b45_alpha() -> string
    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

fn base45_encode(data: list) -> string
    let alpha = _b45_alpha()
    let parts = []
    let n = len(data)
    let i = 0
    // STAYS a while: steps by 2 (pairs of bytes) with a trailing single-byte case.
    while i + 1 < n
        let x = data[i] * 256 + data[i + 1]
        let c = x % 45
        let d = (x / 45) % 45
        let e = x / 2025
        push(parts, "{char_at(alpha, c)}{char_at(alpha, d)}{char_at(alpha, e)}")
        i += 2
    if i < n
        let x = data[i]
        push(parts, "{char_at(alpha, x % 45)}{char_at(alpha, x / 45)}")
    join(parts, "")
