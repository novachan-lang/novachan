// forge_uptime_tracker — Track service uptime and incidents.

fn ut_new(service: string) -> dict
    {"service": service, "status": "up", "total_up": 0, "total_down": 0, "incidents": 0, "last_change": 0, "longest_down": 0, "current_down": 0}

fn ut_mark_down(u: dict, timestamp: int) -> dict
    if u["status"] == "down"
        return u
    let elapsed = timestamp - u["last_change"]
    u["total_up"] += elapsed
    u["status"] = "down"
    u["incidents"] += 1
    u["last_change"] = timestamp
    u["current_down"] = 0
    u

fn ut_mark_up(u: dict, timestamp: int) -> dict
    if u["status"] == "up"
        return u
    let elapsed = timestamp - u["last_change"]
    u["total_down"] += elapsed
    u["current_down"] = elapsed
    if elapsed > u["longest_down"]
        u["longest_down"] = elapsed
    u["status"] = "up"
    u["last_change"] = timestamp
    u

fn ut_uptime_pct(u: dict, now: int) -> int
    let up = u["total_up"]
    let down = u["total_down"]
    if u["status"] == "up"
        up += (now - u["last_change"])
    else
        down += (now - u["last_change"])
    let total = up + down
    if total == 0
        return 100
    up * 100 / total

fn ut_incident_count(u: dict) -> int
    u["incidents"]

fn ut_is_up(u: dict) -> int
    if u["status"] == "up"
        return 1
    0

fn ut_longest_outage(u: dict) -> int
    u["longest_down"]

fn ut_total_downtime(u: dict, now: int) -> int
    let down = u["total_down"]
    if u["status"] == "down"
        down += (now - u["last_change"])
    down
