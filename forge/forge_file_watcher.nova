// forge_file_watcher — file change tracking with Result API (in-memory simulation).

fn fw_new() -> dict
    let w = {}
    w["files"] = {}
    w["hashes"] = {}
    w["changes"] = 0
    w["watch_count"] = 0
    w

fn fw_watch(w: dict, path: string) -> dict
    let pk = "f_" + path
    if contains(w["files"], pk) != true
        w["files"][pk] = "watching"
        let hk = "h_" + path
        w["hashes"][hk] = 0
        w["watch_count"] = w["watch_count"] + 1
    w

fn fw_update(w: dict, path: string, new_hash: int) -> Result
    let pk = "f_" + path
    if contains(w["files"], pk) != true
        return err("not watching: " + path)
    let hk = "h_" + path
    let old_hash = w["hashes"][hk]
    if old_hash != new_hash
        w["hashes"][hk] = new_hash
        w["changes"] = w["changes"] + 1
        return ok("changed")
    ok("unchanged")

fn fw_unwatch(w: dict, path: string) -> Result
    let pk = "f_" + path
    if contains(w["files"], pk) != true
        return err("not watching: " + path)
    w["files"][pk] = ""
    w["watch_count"] = w["watch_count"] - 1
    ok(w)

fn fw_is_watching(w: dict, path: string) -> int
    let pk = "f_" + path
    if contains(w["files"], pk) == true
        if w["files"][pk] == "watching"
            return 1
    0

fn fw_change_count(w: dict) -> int
    w["changes"]

fn fw_watch_count(w: dict) -> int
    w["watch_count"]
