// forge_wildcard -- glob-style wildcard matching (* = any run of chars incl. empty, ? = exactly one char):
// route patterns, static-file filters, ACL/permission rules, and pub-sub topic subscriptions. Iterative
// backtracking (O(n) typical, O(n*m) worst) -- no recursion, no catastrophic blowup. LEAF -- imports NOTHING.

// Does `text` match the glob `pattern`? '*' matches any sequence (including empty), '?' matches one char;
// every other char matches literally.
fn wildcard_match(pattern: string, text: string) -> bool
    let np = len(pattern)
    let nt = len(text)
    let p = 0
    let t = 0
    let star_p = -1
    let star_t = 0
    // STAYS a `while`: the step is data-dependent -- on a mismatch after a '*' we REWIND `t` to the
    // remembered resume point. A `for` cannot express that rewind. Guards are short-circuit so
    // char_at(pattern, p) is never evaluated at p == np.
    while t < nt
        if p < np and (char_at(pattern, p) == char_at(text, t) or char_at(pattern, p) == "?")
            p += 1
            t += 1
        else if p < np and char_at(pattern, p) == "*"
            // Remember the wildcard and the text position it starts swallowing from.
            star_p = p
            star_t = t
            p += 1
        else if star_p >= 0
            // Backtrack: let the last '*' swallow one more character of `text`.
            p = star_p + 1
            star_t += 1
            t = star_t
        else
            return false
    // Text exhausted: only trailing '*'s may still match the empty remainder.
    while p < np and char_at(pattern, p) == "*"
        p += 1
    p == np

// True if `text` matches ANY pattern in `patterns` (an allow/deny glob list). Short-circuits on the
// first hit -- `any_match` stops at the first closure call that returns true.
fn wildcard_any(patterns: list, text: string) -> bool
    any_match(patterns, (pat) => wildcard_match(pat, text))
