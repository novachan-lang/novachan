// forge_onehot -- turn CATEGORICAL data into numbers a model can use. Machine-learning methods work on numbers,
// but real features are often labels: "red/green/blue", "US/UK/JP", "free/pro/enterprise". You must NOT just
// map them to 1/2/3 -- that invents a false ordering and distance (green would sit "between" red and blue).
// One-hot encoding gives each category its own 0/1 column, so all categories are equidistant and orderless --
// the correct input for forge_knn / forge_kmeans / forge_bayes. Label encoding (a plain integer index) is fine
// for the TARGET class or for tree models. Fit a vocabulary over your training categories once, then encode
// consistently (a category unseen at fit time encodes to the all-zero vector / index -1). LEAF.

// Fit a vocabulary over a list of category labels: returns a dict label -> column index (first-seen order).
fn onehot_fit(categories: list) -> dict
    let vocab = {}
    let next = 0
    for i in 0..len(categories)
        let cat = str(categories[i])
        if cat not in vocab
            vocab[cat] = next
            next += 1
    vocab

// Number of categories in the fitted vocabulary.
fn onehot_size(vocab: dict) -> int
    len(keys(vocab))

// The integer column index of a category, or -1 if it wasn't seen at fit time.
fn label_encode(vocab: dict, category) -> int
    let cat = str(category)
    let out = 0 - 1
    if cat in vocab
        out = vocab[cat]
    out

// One-hot encode a single category into a 0/1 vector of length onehot_size. An unknown category -> all zeros.
fn onehot_vector(vocab: dict, category) -> list
    let n = onehot_size(vocab)
    let vec = [0 for i in 0..n]
    let idx = label_encode(vocab, category)
    if idx >= 0 and idx < n
        vec[idx] = 1
    vec

// One-hot encode a list of categories into a list of 0/1 vectors.
fn onehot_encode(vocab: dict, categories: list) -> list
    let out = []
    for i in 0..len(categories)
        push(out, onehot_vector(vocab, categories[i]))
    out

// Decode a one-hot vector back to its category label, or "" if no bit (or an unknown index) is set.
fn onehot_decode(vocab: dict, vector: list) -> string
    let hot = 0 - 1
    for i in 0..len(vector)
        if vector[i] == 1
            hot = i
    let out = ""
    if hot >= 0
        let labels = keys(vocab)
        for j in 0..len(labels)
            if vocab[labels[j]] == hot
                out = labels[j]
    out

// The category labels in column-index order.
fn onehot_categories(vocab: dict) -> list
    let n = onehot_size(vocab)
    let out = ["" for i in 0..n]
    let labels = keys(vocab)
    for j in 0..len(labels)
        let idx = vocab[labels[j]]
        out[idx] = labels[j]
    out
