// forge_finance -- the money-math toolkit: compound interest, present/future value, loan payments and full
// amortization schedules, net present value (NPV), and internal rate of return (IRR). These are the calculations
// behind mortgage/loan calculators, subscription and installment billing, savings projections, and investment
// analysis ("what's this stream of cashflows worth today, and what return does it imply?"). Rates are PER PERIOD
// as decimals (6% annual over monthly periods = 0.005 with 12 periods/yr). Everything is computed in floats;
// callers that need exact cents should round the results. LEAF -- imports NOTHING.

// Future value of a present sum after `periods` at `rate` per period: FV = PV * (1+rate)^periods.
fn future_value(present: float, rate: float, periods: float) -> float
    let p = present * 1.0
    let factor = pow(1.0 + rate * 1.0, periods * 1.0)
    let fv = p * factor
    fv

// Present value of a future sum: PV = FV / (1+rate)^periods.
fn present_value(future: float, rate: float, periods: float) -> float
    let f = future * 1.0
    let factor = pow(1.0 + rate * 1.0, periods * 1.0)
    let pv = 0.0
    if factor > 0.0
        pv = f / factor
    pv

// Compound interest EARNED on a principal (future value minus principal).
fn compound_interest(principal: float, rate: float, periods: float) -> float
    let p = principal * 1.0
    let fv = future_value(p, rate, periods)
    let earned = fv - p
    earned

// The level payment that amortizes `principal` over `n` payments at `rate` per period:
// M = P*r / (1 - (1+r)^-n). Handles rate == 0 (equal principal splits).
fn loan_payment(principal: float, rate: float, n: float) -> float
    let p = principal * 1.0
    let r = rate * 1.0
    let np = n * 1.0
    let pay = 0.0
    if r == 0.0
        if np > 0.0
            pay = p / np
    else
        let factor = pow(1.0 + r, -np)
        let denom = 1.0 - factor
        if denom != 0.0
            pay = p * r / denom
    pay

// Full amortization schedule: a list of rows [payment, principal_paid, interest_paid, remaining_balance],
// one per period. The final balance is ~0.
fn amortization_schedule(principal: float, rate: float, n: int) -> list
    let r = rate * 1.0
    let pay = loan_payment(principal, r, n * 1.0)
    let rows = []
    let balance = principal * 1.0
    let i = 0
    while i < n
        let interest = balance * r
        let principal_paid = pay - interest
        balance = balance - principal_paid
        push(rows, [pay, principal_paid, interest, balance])
        i = i + 1
    rows

// Net present value of a cashflow series at `rate` per period. cashflows[0] is period 0 (usually the initial
// outlay, negative), cashflows[i] discounted by (1+rate)^i.
fn npv(rate: float, cashflows: list) -> float
    let r = rate * 1.0
    let total = 0.0
    let i = 0
    while i < len(cashflows)
        let cf = cashflows[i] * 1.0
        let disc = pow(1.0 + r, i * 1.0)
        if disc != 0.0
            total = total + cf / disc
        i = i + 1
    total

// Internal rate of return: the per-period rate at which NPV(cashflows) == 0, via bisection. Assumes a
// conventional series (a sign change). Returns 0.0 if no sign change is bracketed in (-0.9999, 10).
fn irr(cashflows: list) -> float
    let lo = -0.9999
    let hi = 10.0
    let flo = npv(lo, cashflows)
    let fhi = npv(hi, cashflows)
    let result = 0.0
    let bracket = flo * fhi
    if bracket <= 0.0
        let iter = 0
        while iter < 200
            let mid = (lo + hi) / 2.0
            let fmid = npv(mid, cashflows)
            // NPV decreases as rate rises for a conventional series: if still positive, move lo up
            if fmid > 0.0
                lo = mid
            else
                hi = mid
            iter = iter + 1
        result = (lo + hi) / 2.0
    result
