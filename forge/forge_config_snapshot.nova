// forge_config_snapshot — versioned config snapshots with diff and Result API.

fn csn_new() -> dict
    let c = {}
    c["snap_count"] = 0
    c["key_count"] = 0
    c

fn csn_set(c: dict, key: string, value: string) -> dict
    let kk = "cur_" + key
    if kk not in c
        c["key_count"] = c["key_count"] + 1
    c[kk] = value
    c

fn csn_get(c: dict, key: string) -> Result
    let kk = "cur_" + key
    if kk not in c
        return err("key not found: " + key)
    ok(c[kk])

fn csn_snapshot(c: dict, label: string) -> dict
    let idx = c["snap_count"]
    c["sn_" + str(idx) + "_label"] = label
    c["sn_" + str(idx) + "_keys"] = c["key_count"]
    c["snap_count"] = idx + 1
    c

fn csn_label(c: dict, index: int) -> Result
    if index < 0 or index >= c["snap_count"]
        return err("snapshot index out of range")
    ok(c["sn_" + str(index) + "_label"])

fn csn_snap_count(c: dict) -> int
    c["snap_count"]

fn csn_key_count(c: dict) -> int
    c["key_count"]
