fn us_new()
    let state = {}
    state["component_count"] = 0
    state["update_count"] = 0
    state["listener_count"] = 0
    return state

fn us_create(state, component_id, initial_value)
    state["c_" + component_id + "_value"] = initial_value
    state["c_" + component_id + "_prev"] = ""
    state["c_" + component_id + "_dirty"] = 0
    state["c_" + component_id + "_updates"] = 0
    state["component_count"] = state["component_count"] + 1
    return state

fn us_set(state, component_id, value)
    let vkey = "c_" + component_id + "_value"
    if vkey not in state
        return err("unknown component: " + component_id)
    state["c_" + component_id + "_prev"] = state[vkey]
    state[vkey] = value
    state["c_" + component_id + "_dirty"] = 1
    state["c_" + component_id + "_updates"] = state["c_" + component_id + "_updates"] + 1
    state["update_count"] = state["update_count"] + 1
    return ok(state)

fn us_get(state, component_id)
    let vkey = "c_" + component_id + "_value"
    if vkey not in state
        return err("unknown component")
    return ok(state[vkey])

fn us_previous(state, component_id)
    let pkey = "c_" + component_id + "_prev"
    if pkey not in state
        return err("unknown component")
    return ok(state[pkey])

fn us_is_dirty(state, component_id)
    let dkey = "c_" + component_id + "_dirty"
    if dkey not in state
        return err("unknown component")
    return ok(state[dkey])

fn us_clean(state, component_id)
    let dkey = "c_" + component_id + "_dirty"
    if dkey not in state
        return err("unknown component")
    state[dkey] = 0
    return ok(state)

fn us_component_updates(state, component_id)
    let ukey = "c_" + component_id + "_updates"
    if ukey not in state
        return err("unknown component")
    return ok(state[ukey])

fn us_component_count(state)
    return state["component_count"]

fn us_update_count(state)
    return state["update_count"]

fn us_has_component(state, component_id)
    let vkey = "c_" + component_id + "_value"
    if vkey in state
        return 1
    return 0
