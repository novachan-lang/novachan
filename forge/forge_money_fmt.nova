// forge_money_fmt -- format integer CENTS as a currency string with correct symbol placement, thousands
// grouping, and decimal style per locale (US "$1,234.56" vs EU "1.234,56 €"). Pairs with forge_percent /
// forge_money (which compute on cents). Integer math only -- no float money errors. LEAF -- imports NOTHING.

// PRIVATE: group a digit string in 3s from the right with `thousands` separator.
fn _mf_group(digits: string, thousands: string) -> string
    let out = ""
    let cnt = 0
    let i = len(digits) - 1
    while i >= 0
        out = char_at(digits, i) + out
        cnt = cnt + 1
        if cnt % 3 == 0 and i > 0
            out = thousands + out
        i = i - 1
    out

fn _mf_split(cents: int) -> list
    let neg = cents < 0
    let v = cents
    if neg
        v = 0 - v
    let cc = str(v % 100)
    if v % 100 < 10
        cc = "0" + cc
    [neg, str(v / 100), cc]

// US-style: symbol before, "," thousands, "." decimal. money_us(123456, "$") -> "$1,234.56".
fn money_us(cents: int, symbol: string) -> string
    let parts = _mf_split(cents)
    let body = symbol + _mf_group(parts[1], ",") + "." + parts[2]
    if parts[0]
        return "-" + body
    body

// EU-style: symbol after, "." thousands, "," decimal. money_eu(123456, "€") -> "1.234,56 €".
fn money_eu(cents: int, symbol: string) -> string
    let parts = _mf_split(cents)
    let body = _mf_group(parts[1], ".") + "," + parts[2] + " " + symbol
    if parts[0]
        return "-" + body
    body
