// forge_distributed_lock — distributed lock manager with Result API.

fn dl_new() -> dict
    let d = {}
    d["locks"] = {}
    d["lock_count"] = 0
    d["total_acquires"] = 0
    d["total_releases"] = 0
    d["contention_count"] = 0
    d

fn dl_acquire(d: dict, resource: string, owner: string, expires_at: int) -> Result
    let lk = "lk_" + resource
    let has = contains(d["locks"], lk)
    if has == true
        if d["locks"][lk + "_exp"] > 0
            d["contention_count"] = d["contention_count"] + 1
            return err("lock held by: " + d["locks"][lk])
    d["locks"][lk] = owner
    d["locks"][lk + "_exp"] = expires_at
    d["lock_count"] = d["lock_count"] + 1
    d["total_acquires"] = d["total_acquires"] + 1
    ok(d)

fn dl_release(d: dict, resource: string, owner: string) -> Result
    let lk = "lk_" + resource
    let has = contains(d["locks"], lk)
    if has != true
        return err("not locked: " + resource)
    if d["locks"][lk] != owner
        return err("not owner")
    d["locks"][lk + "_exp"] = 0
    d["lock_count"] = d["lock_count"] - 1
    d["total_releases"] = d["total_releases"] + 1
    ok(d)

fn dl_is_locked(d: dict, resource: string) -> int
    let lk = "lk_" + resource
    let has = contains(d["locks"], lk)
    if has == true
        if d["locks"][lk + "_exp"] > 0
            return 1
    0

fn dl_owner(d: dict, resource: string) -> Result
    let lk = "lk_" + resource
    let has = contains(d["locks"], lk)
    if has != true
        return err("not locked")
    if d["locks"][lk + "_exp"] == 0
        return err("not locked")
    ok(d["locks"][lk])

fn dl_lock_count(d: dict) -> int
    d["lock_count"]

fn dl_contention_count(d: dict) -> int
    d["contention_count"]
