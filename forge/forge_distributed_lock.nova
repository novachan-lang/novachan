// forge_distributed_lock — Distributed locking primitives.
// Named locks with owner, TTL, acquire/release/renew.

fn dl_new() -> dict
    let dl = {}
    dl["locks"] = {}
    dl["history"] = []
    dl

fn dl_acquire(dl: dict, name: string, owner: string, ttl: int, now: int) -> dict
    let locks = dl["locks"]
    let has = contains(locks, name)
    if has == true
        let existing = locks[name]
        let expires = existing["acquired_at"] + existing["ttl"]
        if expires > now
            if existing["owner"] != owner
                let r = {}
                r["acquired"] = 0
                r["holder"] = existing["owner"]
                r["dl"] = dl
                return r
    let lock = {}
    lock["owner"] = owner
    lock["ttl"] = ttl
    lock["acquired_at"] = now
    locks[name] = lock
    let entry = {}
    entry["action"] = "acquire"
    entry["name"] = name
    entry["owner"] = owner
    entry["at"] = now
    push(dl["history"], entry)
    let r = {}
    r["acquired"] = 1
    r["holder"] = owner
    r["dl"] = dl
    r

fn dl_release(dl: dict, name: string, owner: string, now: int) -> dict
    let locks = dl["locks"]
    let has = contains(locks, name)
    if has != true
        return dl
    if locks[name]["owner"] != owner
        return dl
    locks[name]["ttl"] = 0
    locks[name]["acquired_at"] = 0
    let entry = {}
    entry["action"] = "release"
    entry["name"] = name
    entry["owner"] = owner
    entry["at"] = now
    push(dl["history"], entry)
    dl

fn dl_renew(dl: dict, name: string, owner: string, ttl: int, now: int) -> dict
    let locks = dl["locks"]
    let has = contains(locks, name)
    if has != true
        return dl
    if locks[name]["owner"] != owner
        return dl
    locks[name]["ttl"] = ttl
    locks[name]["acquired_at"] = now
    let entry = {}
    entry["action"] = "renew"
    entry["name"] = name
    entry["owner"] = owner
    entry["at"] = now
    push(dl["history"], entry)
    dl

fn dl_is_held(dl: dict, name: string, now: int) -> int
    let locks = dl["locks"]
    let has = contains(locks, name)
    if has != true
        return 0
    let lock = locks[name]
    let expires = lock["acquired_at"] + lock["ttl"]
    if expires <= now
        return 0
    1

fn dl_holder(dl: dict, name: string) -> string
    let locks = dl["locks"]
    let has = contains(locks, name)
    if has != true
        return ""
    locks[name]["owner"]

fn dl_lock_count(dl: dict) -> int
    len(keys(dl["locks"]))

fn dl_history(dl: dict) -> list
    dl["history"]
