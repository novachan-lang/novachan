// forge_bezier -- quadratic and cubic Bezier curve evaluation. Beziers are how vector graphics (SVG paths,
// fonts), animation motion paths, and smooth camera moves are defined: control points shape a curve that a
// parameter t in [0,1] sweeps along. This complements forge_easing (which reshapes time) and forge_vec3 (raw
// vectors) for the Reactor engine and any 2D drawing. Points are [x, y] float lists. LEAF -- imports NOTHING.
//
// Component values are bound to `let` locals before building the result list (the sound pattern near NOVA's
// float-return codegen edge).

// Quadratic Bezier B(t) = (1-t)^2 P0 + 2(1-t)t P1 + t^2 P2. t in [0,1]; t=0 -> P0, t=1 -> P2.
fn bezier_quad(p0: list, p1: list, p2: list, t: float) -> list
    let u = 1.0 - t
    let a = u * u
    let b = 2.0 * u * t
    let c = t * t
    let x = a * p0[0] + b * p1[0] + c * p2[0]
    let y = a * p0[1] + b * p1[1] + c * p2[1]
    [x, y]

// Cubic Bezier B(t) = (1-t)^3 P0 + 3(1-t)^2 t P1 + 3(1-t) t^2 P2 + t^3 P3. t=0 -> P0, t=1 -> P3.
fn bezier_cubic(p0: list, p1: list, p2: list, p3: list, t: float) -> list
    let u = 1.0 - t
    let a = u * u * u
    let b = 3.0 * u * u * t
    let c = 3.0 * u * t * t
    let d = t * t * t
    let x = a * p0[0] + b * p1[0] + c * p2[0] + d * p3[0]
    let y = a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1]
    [x, y]

// Sample a cubic Bezier into `n` points (n>=2) evenly in t, returning a list of [x,y] points from P0 to P3 --
// ready to render as a polyline.
fn bezier_cubic_path(p0: list, p1: list, p2: list, p3: list, n: int) -> list
    let out = []
    if n < 2
        push(out, [p0[0] * 1.0, p0[1] * 1.0])
        return out
    let i = 0
    while i < n
        let t = (i * 1.0) / ((n - 1) * 1.0)
        push(out, bezier_cubic(p0, p1, p2, p3, t))
        i = i + 1
    out
