// forge_service_registry — Service discovery registry.
// Register, deregister, health-check, lookup by name/tag.

fn sr_new() -> dict
    let r = {}
    r["services"] = {}
    r["next_id"] = 1
    r

fn sr_register(reg: dict, name: string, host: string, port: int) -> dict
    let id = reg["next_id"]
    reg["next_id"] = id + 1
    let svc = {}
    svc["id"] = id
    svc["name"] = name
    svc["host"] = host
    svc["port"] = port
    svc["healthy"] = true
    svc["tags"] = []
    svc["metadata"] = {}
    let sid = str(id)
    reg["services"][sid] = svc
    reg

fn sr_last_id(reg: dict) -> int
    reg["next_id"] - 1

fn sr_deregister(reg: dict, id: int) -> dict
    let sid = str(id)
    let has_svc = contains(reg["services"], sid)
    if has_svc == true
        reg["services"][sid]["healthy"] = false
        reg["services"][sid]["name"] = "_removed"
    reg

fn sr_set_health(reg: dict, id: int, healthy: bool) -> dict
    let sid = str(id)
    let has_svc = contains(reg["services"], sid)
    if has_svc == true
        reg["services"][sid]["healthy"] = healthy
    reg

fn sr_tag(reg: dict, id: int, tag: string) -> dict
    let sid = str(id)
    let has_svc = contains(reg["services"], sid)
    if has_svc == true
        push(reg["services"][sid]["tags"], tag)
    reg

fn sr_lookup(reg: dict, name: string) -> list
    let result = []
    let ids = keys(reg["services"])
    let i = 0
    while i < len(ids)
        let svc = reg["services"][ids[i]]
        if svc["name"] == name
            if svc["healthy"] == true
                push(result, svc)
        i = i + 1
    result

fn sr_lookup_tag(reg: dict, tag: string) -> list
    let result = []
    let ids = keys(reg["services"])
    let i = 0
    while i < len(ids)
        let svc = reg["services"][ids[i]]
        if svc["healthy"] == true
            let j = 0
            let found = false
            while j < len(svc["tags"])
                if svc["tags"][j] == tag
                    found = true
                j = j + 1
            if found == true
                push(result, svc)
        i = i + 1
    result

fn sr_all_healthy(reg: dict) -> list
    let result = []
    let ids = keys(reg["services"])
    let i = 0
    while i < len(ids)
        let svc = reg["services"][ids[i]]
        if svc["healthy"] == true
            if svc["name"] != "_removed"
                push(result, svc)
        i = i + 1
    result

fn sr_count(reg: dict) -> int
    len(sr_all_healthy(reg))

fn sr_set_meta(reg: dict, id: int, key: string, value: any) -> dict
    let sid = str(id)
    let has_svc = contains(reg["services"], sid)
    if has_svc == true
        reg["services"][sid]["metadata"][key] = value
    reg
