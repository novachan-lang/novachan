// forge_metrics — Application metrics collection (Prometheus-style).
// Counters, gauges, histograms. Pure data — export to any backend.

fn metrics_registry() -> dict
    {"counters": {}, "gauges": {}, "histograms": {}}

fn metrics_counter(reg: dict, name: string, help: string) -> dict
    reg["counters"][name] = {"value": 0, "help": help, "labels": {}}
    reg

fn metrics_inc(reg: dict, name: string) -> dict
    if name in reg["counters"]
        reg["counters"][name]["value"] += 1
    reg

fn metrics_inc_by(reg: dict, name: string, n: int) -> dict
    if name in reg["counters"]
        reg["counters"][name]["value"] += n
    reg

fn metrics_gauge(reg: dict, name: string, help: string) -> dict
    reg["gauges"][name] = {"value": 0.0, "help": help}
    reg

fn metrics_set(reg: dict, name: string, value: any) -> dict
    if name in reg["gauges"]
        reg["gauges"][name]["value"] = value
    reg

fn metrics_histogram(reg: dict, name: string, help: string, buckets: list) -> dict
    let counts = [0 for i in 0..len(buckets)]
    reg["histograms"][name] = {"help": help, "buckets": buckets, "counts": counts, "sum": 0.0, "count": 0}
    reg

fn metrics_observe(reg: dict, name: string, value: any) -> dict
    if name in reg["histograms"]
        let h = reg["histograms"][name]
        let v = value * 1.0
        h["sum"] += v
        h["count"] += 1
        for i in 0..len(h["buckets"])
            let b = h["buckets"][i] * 1.0
            if v <= b
                h["counts"][i] += 1
        reg["histograms"][name] = h
    reg

fn metrics_get_counter(reg: dict, name: string) -> int
    if name in reg["counters"]
        return reg["counters"][name]["value"]
    0

fn metrics_get_gauge(reg: dict, name: string) -> any
    if name in reg["gauges"]
        return reg["gauges"][name]["value"]
    0

fn metrics_export_text(reg: dict) -> string
    let out = ""
    let cnames = keys(reg["counters"])
    for i in 0..len(cnames)
        let n = cnames[i]
        let c = reg["counters"][n]
        let chelp = c["help"]
        let cval = str(c["value"])
        out += "# HELP {n} {chelp}\n"
        out += "# TYPE {n} counter\n"
        out += "{n} {cval}\n"
    let gnames = keys(reg["gauges"])
    for i in 0..len(gnames)
        let n = gnames[i]
        let g = reg["gauges"][n]
        let ghelp = g["help"]
        let gval = str(g["value"])
        out += "# HELP {n} {ghelp}\n"
        out += "# TYPE {n} gauge\n"
        out += "{n} {gval}\n"
    out
