// forge_deploy_tracker — deployment tracking with Result.

fn dt_new() -> dict
    {"deploys": {}, "deploy_count": 0, "success_count": 0, "rollback_count": 0, "current_version": "", "previous_version": ""}

fn dt_deploy(d: dict, version: string, timestamp: int) -> dict
    d["previous_version"] = d["current_version"]
    d["current_version"] = version
    let key = "dep_" + str(d["deploy_count"])
    d["deploys"][key] = version + ":" + str(timestamp)
    d["deploy_count"] += 1
    d["success_count"] += 1
    d

fn dt_rollback(d: dict) -> Result
    if d["previous_version"] == ""
        return err("no previous version to rollback to")
    d["current_version"] = d["previous_version"]
    d["previous_version"] = ""
    d["rollback_count"] += 1
    ok(d)

fn dt_current(d: dict) -> Result
    if d["current_version"] == ""
        return err("no deployments yet")
    ok(d["current_version"])

fn dt_deploy_count(d: dict) -> int
    d["deploy_count"]

fn dt_success_rate(d: dict) -> int
    if d["deploy_count"] == 0
        return 0
    (d["deploy_count"] - d["rollback_count"]) * 100 / d["deploy_count"]

fn dt_rollback_count(d: dict) -> int
    d["rollback_count"]
