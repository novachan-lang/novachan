// forge_command_bus — Command pattern (CQRS write-side).
// Register handlers, dispatch commands, middleware, history.

fn cmdb_new() -> dict
    {"handlers": {}, "history": [], "middleware": []}

fn cmdb_register(bus: dict, command_type: string, handler_name: string) -> dict
    bus["handlers"][command_type] = handler_name
    bus

fn cmdb_add_middleware(bus: dict, name: string) -> dict
    push(bus["middleware"], name)
    bus

fn cmdb_dispatch(bus: dict, command_type: string, payload: any) -> dict
    let handler = bus["handlers"][command_type] if command_type in bus["handlers"] else ""
    let status = "dispatched" if command_type in bus["handlers"] else "no_handler"
    let entry = {"type": command_type, "payload": payload, "handler": handler, "status": status, "middleware_applied": len(bus["middleware"])}
    push(bus["history"], entry)
    bus

fn cmdb_history(bus: dict) -> list
    bus["history"]

fn cmdb_history_count(bus: dict) -> int
    len(bus["history"])

fn cmdb_has_handler(bus: dict, command_type: string) -> bool
    command_type in bus["handlers"]

fn cmdb_list_commands(bus: dict) -> list
    keys(bus["handlers"])

fn cmdb_last_dispatch(bus: dict) -> dict
    let n = len(bus["history"])
    if n == 0
        let empty = {}
        return empty
    bus["history"][n - 1]
