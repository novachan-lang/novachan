// forge_dependency_injector — Simple DI container with named services.

fn di_new() -> dict
    let di = {}
    di["services"] = {}
    di["singletons"] = {}
    di["resolved"] = 0
    di

fn di_register(di: dict, name: string, value: string) -> dict
    di["services"][name] = value
    di

fn di_register_singleton(di: dict, name: string, value: string) -> dict
    di["singletons"][name] = value
    di["services"][name] = value
    di

fn di_resolve(di: dict, name: string) -> dict
    let result = {}
    let has = contains(di["services"], name)
    if has == true
        di["resolved"] = di["resolved"] + 1
        result["found"] = 1
        result["value"] = di["services"][name]
    else
        result["found"] = 0
        result["value"] = ""
    result["di"] = di
    result

fn di_has(di: dict, name: string) -> int
    let has = contains(di["services"], name)
    if has == true
        return 1
    0

fn di_is_singleton(di: dict, name: string) -> int
    let has = contains(di["singletons"], name)
    if has == true
        return 1
    0

fn di_service_count(di: dict) -> int
    len(keys(di["services"]))

fn di_total_resolves(di: dict) -> int
    di["resolved"]

fn di_remove(di: dict, name: string) -> dict
    let new_svc = {}
    let new_sing = {}
    let ks = keys(di["services"])
    for i in 0..len(ks)
        if ks[i] != name
            new_svc[ks[i]] = di["services"][ks[i]]
    let sk = keys(di["singletons"])
    for j in 0..len(sk)
        if sk[j] != name
            new_sing[sk[j]] = di["singletons"][sk[j]]
    di["services"] = new_svc
    di["singletons"] = new_sing
    di
