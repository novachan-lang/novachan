// forge_setops -- standalone set-algebra-over-lists implementation (no std
// import: std/collections/setops needs `import std/core/collect` for its own
// `set_union` etc. bodies, and collect's generic `fn <T> unique(xs: list<T>)`
// gets pulled into this compilation unit regardless of whether forge_setops
// calls it -- identifier resolution is scoped to a file's own direct imports
// (a bare `unique` import std/collections/setops does NOT bring the name
// into scope for the test importing forge_setops), but codegen still merges
// the ENTIRE transitive closure into one unit. So a local `unique` (needed
// for the test's identifier resolution) always collides with collect's
// `unique` (needed by set_union's own body) as long as std/collections/setops
// is imported at all -- there is no differently-named std delegate available,
// unlike forge_anagram's an_is_anagram. Dropping the import and reimplementing
// the (small, well-understood) set operations locally sidesteps this without
// touching std.

fn unique(xs: list) -> list
    let seen = {}
    let out = []
    for i in 0..len(xs)
        let key = str(xs[i])
        if key not in seen
            seen[key] = 1
            push(out, xs[i])
    out

// PRIVATE: a dict used as a string-keyed membership set over xs.
fn _as_seen(xs: list) -> dict
    let seen = {}
    for i in 0..len(xs)
        seen[str(xs[i])] = 1
    seen

// Elements in EITHER list (distinct), a's first-seen order then b's new ones.

fn list_union(a: list, b: list) -> list
    unique([...a, ...b])

fn list_intersection(a: list, b: list) -> list
    let seen = _as_seen(b)
    unique([x for x in a if str(x) in seen])

fn list_difference(a: list, b: list) -> list
    let seen = _as_seen(b)
    unique([x for x in a if str(x) not in seen])

fn symmetric_difference(a: list, b: list) -> list
    let out = list_difference(a, b)
    let extra = list_difference(b, a)
    for i in 0..len(extra)
        push(out, extra[i])
    out
