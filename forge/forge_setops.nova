// forge_setops -- classic SET ALGEBRA over plain integer lists: union, intersection, difference, symmetric
// difference, and de-duplication. These answer the reconciliation questions that come up whenever you compare two
// collections: what's in EITHER (union), what's in BOTH (intersection), what's in A but NOT B (difference), and
// what's in exactly one (symmetric difference -- the "what changed" between two snapshots). Doing it with a hash
// set makes each operation O(n+m) instead of the naive O(n*m) nested scan, and it de-duplicates naturally. Use it
// to merge id lists, find shared tags or common followers, diff two permission/feature sets, spot added and
// removed records between two exports, and clean duplicate entries. Results preserve FIRST-SEEN order (stable and
// predictable) rather than sorting. Membership is by value; inputs may contain duplicates. Integer elements. LEAF.

// PRIVATE: a set (dict value-string -> 1) of a list's elements.
fn _so_set(xs: list) -> dict
    let s = {}
    for i in 0..len(xs)
        s[str(xs[i])] = 1
    s

// The distinct elements of `xs` in first-seen order.
fn unique(xs: list) -> list
    let seen = {}
    let out = []
    for i in 0..len(xs)
        let key = str(xs[i])
        if key not in seen
            seen[key] = 1
            push(out, xs[i])
    out

// Elements in EITHER list (distinct), a's first-seen order then b's new ones.
fn list_union(a: list, b: list) -> list
    let seen = {}
    let out = []
    for i in 0..len(a)
        let key = str(a[i])
        if key not in seen
            seen[key] = 1
            push(out, a[i])
    for j in 0..len(b)
        let key = str(b[j])
        if key not in seen
            seen[key] = 1
            push(out, b[j])
    out

// Elements in BOTH lists (distinct), in a's first-seen order.
fn list_intersection(a: list, b: list) -> list
    let bset = _so_set(b)
    let seen = {}
    let out = []
    for i in 0..len(a)
        let key = str(a[i])
        if key in bset and contains(seen, key) == false
            seen[key] = 1
            push(out, a[i])
    out

// Elements in A but NOT in B (distinct), in a's first-seen order.
fn list_difference(a: list, b: list) -> list
    let bset = _so_set(b)
    let seen = {}
    let out = []
    for i in 0..len(a)
        let key = str(a[i])
        if key not in bset and contains(seen, key) == false
            seen[key] = 1
            push(out, a[i])
    out

// Elements in exactly one of the two lists (A-only then B-only), distinct.
fn symmetric_difference(a: list, b: list) -> list
    let out = list_difference(a, b)
    let extra = list_difference(b, a)
    for i in 0..len(extra)
        push(out, extra[i])
    out
