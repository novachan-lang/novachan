// forge_basen -- convert whole numbers to and from any base from 2 to 36. Base 2 is binary, 8 octal, 16 hex, and
// higher bases (up to 36, using 0-9 then a-z) pack a number into fewer characters -- handy for short, URL-safe
// IDs and codes (base 36 of a big counter), compact serial numbers, and displaying values in binary/hex/octal
// for debugging, bit work, and teaching. to_base renders a number as a string of digits in the target base;
// from_base parses such a string back to an integer. (forge_base64 / basex handle byte<->text encodings; this is
// integer<->digit-string in an arbitrary radix.) Handles negative numbers with a leading '-'. LEAF.
//
// RAISED 2026-08-05. Four problems:
//
//   1. _bn_digit used a 4-line if/else. Ternary.
//   2. _bn_value used `0 - 1` for -1. Unary `-1`.
//   3. to_base used `0 - m` for negation + a while-decrement reverse loop. `-m` + reverse() + join.
//   4. from_base used `0 - val`. `-val`.

fn _bn_digit(d: int) -> string
    chr(48 + d) if d < 10 else chr(97 + d - 10)

fn _bn_value(ch: string) -> int
    let c = ord(ch)
    if c >= 48 and c <= 57
        return c - 48
    if c >= 97 and c <= 122
        return c - 97 + 10
    if c >= 65 and c <= 90
        return c - 65 + 10
    -1

fn to_base(n: int, base: int) -> string
    if base < 2 or base > 36 or n == 0
        return "0"
    let neg = n < 0
    let m = -n if neg else n
    let rev = []
    while m > 0
        push(rev, _bn_digit(m % base))
        m = m / base
    let s = join(reverse(rev), "")
    "-{s}" if neg else s

fn from_base(s: string, base: int) -> int
    if len(s) == 0 or base < 2 or base > 36
        return 0
    let neg = char_at(s, 0) == "-"
    let start = 1 if neg else 0
    let val = 0
    for i in start..len(s)
        let d = _bn_value(char_at(s, i))
        if d >= 0 and d < base
            val = val * base + d
    -val if neg else val
