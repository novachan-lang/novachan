// forge_basen -- convert whole numbers to and from any base from 2 to 36. Base 2 is binary, 8 octal, 16 hex, and
// higher bases (up to 36, using 0-9 then a-z) pack a number into fewer characters -- handy for short, URL-safe
// IDs and codes (base 36 of a big counter), compact serial numbers, and displaying values in binary/hex/octal
// for debugging, bit work, and teaching. to_base renders a number as a string of digits in the target base;
// from_base parses such a string back to an integer. (forge_base64 / basex handle byte<->text encodings; this is
// integer<->digit-string in an arbitrary radix.) Handles negative numbers with a leading '-'. LEAF.

// PRIVATE: the digit character for value d (0..35): 0-9 then a-z.
fn _bn_digit(d: int) -> string
    let out = ""
    if d < 10
        out = chr(48 + d)
    else
        out = chr(97 + d - 10)
    out

// PRIVATE: the value (0..35) of a digit character, or -1 if not a valid digit.
fn _bn_value(ch: string) -> int
    let c = ord(ch)
    let out = 0 - 1
    if c >= 48 and c <= 57
        out = c - 48
    if c >= 97 and c <= 122
        out = c - 97 + 10
    if c >= 65 and c <= 90
        out = c - 65 + 10
    out

// Render integer n as a string of digits in the given base (2..36). Base 0 for n==0.
fn to_base(n: int, base: int) -> string
    let out = "0"
    if base >= 2 and base <= 36 and n != 0
        let neg = false
        let m = n
        if m < 0
            neg = true
            m = 0 - m
        let rev = []
        while m > 0
            push(rev, _bn_digit(m % base))
            m = m / base
        // reverse into a string
        let s_parts = []
        let i = len(rev) - 1
        while i >= 0
            push(s_parts, rev[i])
            i -= 1
        let s = join(s_parts, "")
        if neg
            s = "-" + s
        out = s
    out

// Parse a base-`base` digit string back to an integer (2..36, case-insensitive; leading '-' allowed).
fn from_base(s: string, base: int) -> int
    let out = 0
    if len(s) > 0 and base >= 2 and base <= 36
        let neg = false
        let start = 0
        if char_at(s, 0) == "-"
            neg = true
            start = 1
        let val = 0
        let i = start
        while i < len(s)
            let d = _bn_value(char_at(s, i))
            if d >= 0 and d < base
                val = val * base + d
            i += 1
        if neg
            val = 0 - val
        out = val
    out
