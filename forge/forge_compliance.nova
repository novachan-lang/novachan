// forge_compliance — Compliance tracking and auditing.
// Define controls, track evidence, report gaps, audit trail.

fn comp_new(framework: string) -> dict
    let c = {}
    c["framework"] = framework
    c["controls"] = {}
    c["evidence"] = []
    c["findings"] = []
    c

fn comp_add_control(c: dict, id: string, title: string, severity: string) -> dict
    let ctrl = {}
    ctrl["id"] = id
    ctrl["title"] = title
    ctrl["severity"] = severity
    ctrl["status"] = "open"
    c["controls"][id] = ctrl
    c

fn comp_mark_compliant(c: dict, control_id: string) -> dict
    let has = contains(c["controls"], control_id)
    if has != true
        return c
    c["controls"][control_id]["status"] = "compliant"
    c

fn comp_mark_non_compliant(c: dict, control_id: string, reason: string) -> dict
    let has = contains(c["controls"], control_id)
    if has != true
        return c
    c["controls"][control_id]["status"] = "non_compliant"
    let finding = {}
    finding["control"] = control_id
    finding["reason"] = reason
    push(c["findings"], finding)
    c

fn comp_add_evidence(c: dict, control_id: string, evidence_type: string, details: string) -> dict
    let ev = {}
    ev["control"] = control_id
    ev["type"] = evidence_type
    ev["details"] = details
    push(c["evidence"], ev)
    c

fn comp_control_count(c: dict) -> int
    len(keys(c["controls"]))

fn comp_compliant_count(c: dict) -> int
    let count = 0
    let all = keys(c["controls"])
    let i = 0
    while i < len(all)
        if c["controls"][all[i]]["status"] == "compliant"
            count = count + 1
        i = i + 1
    count

fn comp_compliance_pct(c: dict) -> int
    let total = comp_control_count(c)
    if total == 0
        return 0
    comp_compliant_count(c) * 100 / total

fn comp_open_findings(c: dict) -> list
    c["findings"]

fn comp_finding_count(c: dict) -> int
    len(c["findings"])

fn comp_by_severity(c: dict, severity: string) -> list
    let result = []
    let all = keys(c["controls"])
    let i = 0
    while i < len(all)
        if c["controls"][all[i]]["severity"] == severity
            push(result, c["controls"][all[i]])
        i = i + 1
    result
