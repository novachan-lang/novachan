// forge_permute -- generate the orderings (permutations) of a list, in lexicographic order. Where
// forge_combinatorics COUNTS arrangements (n!), this ENUMERATES them: step to the next permutation one at a
// time (constant extra memory, the same trick C++ std::next_permutation uses), or produce them all. Use it to
// brute-force small search spaces (schedules, seatings, the traveling-salesman on a handful of cities), list
// every anagram of a word, enumerate test-input orderings, or walk configurations in a stable, repeatable
// sequence. Elements are compared with `<` (works for integers or strings). Duplicates are handled: only
// DISTINCT permutations are produced (so [1,1,2] yields 3, not 6). LEAF -- imports NOTHING.

// PRIVATE: a sorted-ascending copy of a scalar list (insertion sort).
fn _perm_sorted(items: list) -> list
    let out = []
    let i = 0
    while i < len(items)
        push(out, items[i])
        i = i + 1
    let a = 1
    while a < len(out)
        let cur = out[a]
        let b = a - 1
        while b >= 0 and cur < out[b]
            out[b + 1] = out[b]
            b = b - 1
        out[b + 1] = cur
        a = a + 1
    out

// The next permutation of `arr` in lexicographic order, as a new list. Returns an empty list if `arr` is already
// the last (fully descending) permutation.
fn next_permutation(arr: list) -> list
    let n = len(arr)
    let a = []
    let i = 0
    while i < n
        push(a, arr[i])
        i = i + 1
    // find the pivot: the largest index k with a[k] < a[k+1]
    let piv = 0 - 1
    let k = n - 2
    let found = false
    while k >= 0 and found == false
        if a[k] < a[k + 1]
            piv = k
            found = true
        else
            k = k - 1
    let out = []
    if piv >= 0
        // find the largest j > piv with a[j] > a[piv]
        let j = n - 1
        let jf = false
        while j > piv and jf == false
            if a[piv] < a[j]
                jf = true
            else
                j = j - 1
        // swap pivot with j
        let tmp = a[piv]
        a[piv] = a[j]
        a[j] = tmp
        // reverse the suffix after the pivot
        let lo = piv + 1
        let hi = n - 1
        while lo < hi
            let t2 = a[lo]
            a[lo] = a[hi]
            a[hi] = t2
            lo = lo + 1
            hi = hi - 1
        out = a
    out

// All DISTINCT permutations of `items`, in ascending lexicographic order (a list of lists).
fn all_permutations(items: list) -> list
    let result = []
    let cur = _perm_sorted(items)
    let going = len(cur) > 0
    while going
        let c = []
        let i = 0
        while i < len(cur)
            push(c, cur[i])
            i = i + 1
        push(result, c)
        let nxt = next_permutation(cur)
        if len(nxt) == 0
            going = false
        else
            cur = nxt
    result

// The number of distinct permutations of `items`.
fn permutation_count(items: list) -> int
    len(all_permutations(items))
