// forge_nqueens -- the N-Queens problem: place N chess queens on an N x N board so that none attacks another (no
// two share a row, column, or diagonal). It's the canonical demonstration of BACKTRACKING -- try a queen in each
// column of the current row, recurse to the next row, and abandon (backtrack) the instant a placement conflicts,
// pruning enormous swaths of the search tree instead of checking all N^N boards. Attacks are detected in O(1) by
// keeping "occupied" flags for each column and each of the two diagonal directions (a cell's "/" diagonal is
// row+col, its "\" diagonal is row-col). Beyond the puzzle, this is the template for constraint-satisfaction and
// combinatorial search in general -- scheduling with exclusions, resource placement, and exact cover. Provides the
// COUNT of distinct solutions (the famous 1, 0, 0, 2, 10, 4, 40, 92, ... sequence) and ONE concrete placement.
// LEAF -- imports NOTHING.

// PRIVATE: backtracking count of valid completions from `row`, given occupied column/diagonal flags.
fn _nq_count(row: int, n: int, cols: list, d1: list, d2: list) -> int
    let total = 0
    if row == n
        total = 1
    else
        let c = 0
        while c < n
            let dg1 = row + c
            let dg2 = row - c + n - 1
            if cols[c] == 0 and d1[dg1] == 0 and d2[dg2] == 0
                cols[c] = 1
                d1[dg1] = 1
                d2[dg2] = 1
                total = total + _nq_count(row + 1, n, cols, d1, d2)
                cols[c] = 0
                d1[dg1] = 0
                d2[dg2] = 0
            c = c + 1
    total

// The number of distinct solutions to the N-Queens problem on an n x n board.
fn nqueens_count(n: int) -> int
    let out = 0
    if n >= 1
        let cols = []
        let d1 = []
        let d2 = []
        let z = 0
        while z < n
            push(cols, 0)
            z = z + 1
        let z2 = 0
        while z2 < 2 * n - 1
            push(d1, 0)
            push(d2, 0)
            z2 = z2 + 1
        out = _nq_count(0, n, cols, d1, d2)
    out

// PRIVATE: find one solution, filling `placement[row] = column`; returns 1 on success.
fn _nq_solve(row: int, n: int, cols: list, d1: list, d2: list, placement: list) -> int
    let ok = 0
    if row == n
        ok = 1
    else
        let c = 0
        while c < n and ok == 0
            let dg1 = row + c
            let dg2 = row - c + n - 1
            if cols[c] == 0 and d1[dg1] == 0 and d2[dg2] == 0
                cols[c] = 1
                d1[dg1] = 1
                d2[dg2] = 1
                placement[row] = c
                ok = _nq_solve(row + 1, n, cols, d1, d2, placement)
                if ok == 0
                    cols[c] = 0
                    d1[dg1] = 0
                    d2[dg2] = 0
            c = c + 1
    ok

// One valid placement as a list where element `row` is the queen's column, or an empty list if none exists.
fn nqueens_solution(n: int) -> list
    let placement = []
    if n >= 1
        let z = 0
        while z < n
            push(placement, 0 - 1)
            z = z + 1
        let cols = []
        let d1 = []
        let d2 = []
        let a = 0
        while a < n
            push(cols, 0)
            a = a + 1
        let b = 0
        while b < 2 * n - 1
            push(d1, 0)
            push(d2, 0)
            b = b + 1
        if _nq_solve(0, n, cols, d1, d2, placement) == 0
            placement = []
    placement
