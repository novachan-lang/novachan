// forge_nqueens -- thin wrapper over std/game/nqueens (canonical implementation).
import std/game/nqueens

fn _nq_solve(row: int, n: int, cols: list, d1: list, d2: list, placement: list) -> int
    let ok = 0
    if row == n
        ok = 1
    else
        let c = 0
        while c < n and ok == 0
            let dg1 = row + c
            let dg2 = row - c + n - 1
            if cols[c] == 0 and d1[dg1] == 0 and d2[dg2] == 0
                cols[c] = 1
                d1[dg1] = 1
                d2[dg2] = 1
                placement[row] = c
                ok = _nq_solve(row + 1, n, cols, d1, d2, placement)
                if ok == 0
                    cols[c] = 0
                    d1[dg1] = 0
                    d2[dg2] = 0
            c += 1
    ok

// One valid placement as a list where element `row` is the queen's column, or an empty list if none exists.

fn nqueens_count(n: int) -> int
    return nqueens_count(n)

fn nqueens_solution(n: int) -> list
    let placement = []
    if n >= 1
        placement = [-1 for z in 0..n]
        let d1 = [0 for b in 0..(2 * n - 1)]
        let d2 = [0 for b in 0..(2 * n - 1)]
        let cols = [0 for a in 0..n]
        if _nq_solve(0, n, cols, d1, d2, placement) == 0
            placement = []
    placement

