// forge_mst -- minimum spanning tree via Kruskal's algorithm: connect every node in a weighted graph using the
// cheapest possible total set of edges, with no cycles. This is the "wire up all these points as cheaply as
// possible" solver -- lay out a network/cabling/road plan at minimum cost, cluster points by cutting the most
// expensive links, or carve a perfect maze (a spanning tree IS a maze). Kruskal sorts every edge by weight and
// greedily adds the cheapest edge that joins two so-far-separate components (a union-find check rejects any edge
// that would close a loop). Edges are [u, v, weight] with string node ids and integer weights; the result is
// the chosen edges plus their total cost. Imports forge_union_find.

import forge_union_find

// Compute the minimum spanning tree (or forest, if the graph is disconnected). Returns [mst_edges, total_weight]
// where mst_edges is a list of [u, v, weight]. O(E log E).
fn mst_kruskal(edges: list) -> list
    // sort edge indices by weight using PARALLEL scalar arrays (never sort the [u,v,w] lists directly)
    let ws = []
    let idx = []
    let i = 0
    while i < len(edges)
        push(ws, edges[i][2])
        push(idx, i)
        i += 1
    let a = 1
    while a < len(ws)
        let cw = ws[a]
        let ci = idx[a]
        let b = a - 1
        while b >= 0 and ws[b] > cw
            ws[b + 1] = ws[b]
            idx[b + 1] = idx[b]
            b -= 1
        ws[b + 1] = cw
        idx[b + 1] = ci
        a += 1
    // greedily add the cheapest edge that connects two separate components
    let uf = uf_new()
    let mst = []
    let total = 0
    for j in 0..len(idx)
        let e = edges[idx[j]]
        let u = e[0]
        let v = e[1]
        if uf_connected(uf, u, v) == false
            uf = uf_union(uf, u, v)
            push(mst, [u, v, e[2]])
            total += e[2]
    [mst, total]

// The total weight of the minimum spanning tree.
fn mst_total_weight(edges: list) -> int
    let r = mst_kruskal(edges)
    r[1]

// The MST edges only (list of [u, v, weight]).
fn mst_edges(edges: list) -> list
    let r = mst_kruskal(edges)
    r[0]

// True if the MST spans all `node_count` nodes in one connected tree (i.e. exactly node_count-1 edges chosen).
// If false, the input graph was disconnected (the result is a spanning FOREST).
fn mst_spans_all(edges: list, node_count: int) -> bool
    let r = mst_kruskal(edges)
    let chosen = r[0]
    len(chosen) == node_count - 1
