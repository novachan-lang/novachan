// forge_vertexcover -- pick a small set of nodes that "covers" every edge, meaning every edge has at least one
// of its endpoints in the set. This models "where do I place watchers to see every connection": monitoring
// sensors or cameras so every corridor/link is observed, security guards covering every hallway, choosing which
// accounts to audit so every risky relationship is caught, and installing checkpoints on a road network so every
// road is watched. Finding the SMALLEST such set is NP-hard, so this uses the classic greedy 2-approximation
// (repeatedly take BOTH endpoints of any still-uncovered edge), which is guaranteed to be at most twice the
// optimal size and is fast. It also verifies whether a given set is a valid cover. Edges are [u, v] undirected,
// string ids. LEAF -- imports NOTHING.

// A vertex cover via the 2-approximation greedy: for each still-uncovered edge, add both its endpoints. Returns
// the list of chosen vertices (at most twice the minimum possible).
fn vertex_cover(edges: list) -> list
    let inset = {}
    let result = []
    for i in 0..len(edges)
        let u = edges[i][0]
        let v = edges[i][1]
        if u not in inset and v not in inset
            inset[u] = 1
            inset[v] = 1
            push(result, u)
            push(result, v)
    result

// The size of the greedy vertex cover.
fn vertex_cover_size(edges: list) -> int
    len(vertex_cover(edges))

// True if `cover` (a list of vertex ids) covers every edge (each edge has >= 1 endpoint in the set).
fn is_vertex_cover(edges: list, cover: list) -> bool
    let inset = {}
    for c in 0..len(cover)
        inset[cover[c]] = 1
    let ok = true
    for i in 0..len(edges)
        let u = edges[i][0]
        let v = edges[i][1]
        if u not in inset and v not in inset
            ok = false
    ok
