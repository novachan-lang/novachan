// forge_consensus_log — Consensus protocol log: propose values, collect votes, decide by quorum.

fn cl_new(quorum_size: int) -> dict
    let c = {}
    c["quorum"] = quorum_size
    c["proposal_count"] = 0
    c["decided_count"] = 0
    c

fn cl_propose(c: dict, value: string) -> int
    let id = c["proposal_count"]
    c["p_" + str(id) + "_value"] = value
    c["p_" + str(id) + "_accept"] = 0
    c["p_" + str(id) + "_reject"] = 0
    c["p_" + str(id) + "_decided"] = 0
    c["proposal_count"] = id + 1
    id

fn cl_vote(c: dict, proposal_id: int, voter: string, accept: int) -> Result
    if proposal_id < 0 or proposal_id >= c["proposal_count"]
        return err("unknown proposal")
    let dkey = "p_" + str(proposal_id) + "_decided"
    if c[dkey] == 1
        return err("already decided")
    let vkey = "p_" + str(proposal_id) + "_voter_" + voter
    let has_voted = contains(c, vkey)
    if has_voted == true
        return err("voter already voted")
    c[vkey] = 1
    if accept == 1
        let akey = "p_" + str(proposal_id) + "_accept"
        c[akey] = c[akey] + 1
        if c[akey] >= c["quorum"]
            c[dkey] = 1
            c["decided_count"] = c["decided_count"] + 1
    else
        let rkey = "p_" + str(proposal_id) + "_reject"
        c[rkey] = c[rkey] + 1
        if c[rkey] >= c["quorum"]
            c[dkey] = 1
            c["decided_count"] = c["decided_count"] + 1
    ok(c)

fn cl_is_decided(c: dict, proposal_id: int) -> Result
    if proposal_id < 0 or proposal_id >= c["proposal_count"]
        return err("unknown proposal")
    ok(c["p_" + str(proposal_id) + "_decided"])

fn cl_decision(c: dict, proposal_id: int) -> Result
    if proposal_id < 0 or proposal_id >= c["proposal_count"]
        return err("unknown proposal")
    let dkey = "p_" + str(proposal_id) + "_decided"
    if c[dkey] != 1
        return err("not decided")
    let akey = "p_" + str(proposal_id) + "_accept"
    if c[akey] >= c["quorum"]
        return ok("accepted")
    ok("rejected")

fn cl_vote_count(c: dict, proposal_id: int) -> Result
    if proposal_id < 0 or proposal_id >= c["proposal_count"]
        return err("unknown proposal")
    let akey = "p_" + str(proposal_id) + "_accept"
    let rkey = "p_" + str(proposal_id) + "_reject"
    ok(c[akey] + c[rkey])

fn cl_proposal_count(c: dict) -> int
    c["proposal_count"]

fn cl_decided_count(c: dict) -> int
    c["decided_count"]
