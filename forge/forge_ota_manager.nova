// forge_ota_manager — Edge over-the-air update manager.
// Register devices at a current version, publish new releases, check/apply updates per device.

fn ota_new() -> dict
    let s = {}
    s["current"] = {}
    s["registered"] = {}
    s["ids"] = {}
    s["device_count"] = 0
    s["next_idx"] = 0
    s["latest_version"] = ""
    s["changelog"] = ""
    s["has_release"] = 0
    s

fn ota_register(s: dict, device_id: string, current_version: string) -> dict
    let is_new = contains(s["registered"], device_id) != true
    s["registered"][device_id] = 1
    s["current"][device_id] = current_version
    if is_new
        s["ids"][str(s["next_idx"])] = device_id
        s["next_idx"] = s["next_idx"] + 1
        s["device_count"] = s["device_count"] + 1
    s

fn ota_publish(s: dict, target_version: string, changelog: string) -> dict
    s["latest_version"] = target_version
    s["changelog"] = changelog
    s["has_release"] = 1
    s

fn ota_check(s: dict, device_id: string) -> Result
    if contains(s["registered"], device_id) != true
        return err("unknown device: " + device_id)
    if s["has_release"] != 1
        return ok("up_to_date")
    if s["current"][device_id] == s["latest_version"]
        return ok("up_to_date")
    ok("available")

fn ota_apply(s: dict, device_id: string) -> Result
    if contains(s["registered"], device_id) != true
        return err("unknown device: " + device_id)
    if s["has_release"] != 1
        return err("no release published")
    s["current"][device_id] = s["latest_version"]
    ok(s["latest_version"])

fn ota_status(s: dict, device_id: string) -> Result
    if contains(s["registered"], device_id) != true
        return err("unknown device: " + device_id)
    ok(s["current"][device_id])

fn ota_pending_count(s: dict) -> int
    if s["has_release"] != 1
        return 0
    let i = 0
    let cnt = 0
    while i < s["next_idx"]
        let did = s["ids"][str(i)]
        if s["current"][did] != s["latest_version"]
            cnt += 1
        i += 1
    cnt

fn ota_updated_count(s: dict) -> int
    let i = 0
    let cnt = 0
    while i < s["next_idx"]
        let did = s["ids"][str(i)]
        if s["has_release"] == 1
            if s["current"][did] == s["latest_version"]
                cnt += 1
        i += 1
    cnt

fn ota_device_count(s: dict) -> int
    s["device_count"]

fn ota_latest_version(s: dict) -> Result
    if s["has_release"] != 1
        return err("no release published")
    ok(s["latest_version"])
