// forge_primes -- thin wrapper over std/math/primes (canonical implementation).
import std/math/primes

fn _nt_mulmod(a: int, b: int, m: int) -> int
    let result = 0
    let x = a % m
    let y = b
    while y > 0
        if (y & 1) == 1
            result = (result + x) % m
        x = (x + x) % m
        y = y / 2
    result

// True if n is prime. Trial division: correct for all n, O(sqrt n).

fn is_prime(n: int) -> bool
    return pr_is_prime(n)

fn next_prime(n: int) -> int
    return pr_next_prime(n)

fn prime_factors(n: int) -> list
    return pr_prime_factors(n)

fn prime_sieve(limit: int) -> list
    return pr_sieve(limit)

fn mod_pow(base: int, exp: int, m: int) -> int
    if m == 1
        return 0
    let result = 1
    let b = base % m
    let e = exp
    while e > 0
        if (e & 1) == 1
            result = _nt_mulmod(result, b, m)
        b = _nt_mulmod(b, b, m)
        e = e / 2
    result

// Euler's totient phi(n): the count of integers in [1, n] coprime to n.

fn euler_totient(n: int) -> int
    if n <= 0
        return 0
    let result = n
    let m = n
    let p = 2
    while p * p <= m
        if m % p == 0
            while m % p == 0
                m = m / p
            result -= result / p
        p += 1
    if m > 1
        result -= result / m
    result

