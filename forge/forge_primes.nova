// forge_primes -- the number-theory toolkit: primality testing, factorization, the Sieve of Eratosthenes,
// overflow-safe modular exponentiation, and Euler's totient. These underpin cryptography (RSA-style modular
// exponentiation, key math), hashing and hash-table sizing (pick a prime bucket count), checksums, random-
// number theory, and any "is this prime / factor this / a^b mod m" need. forge_math already has gcd/lcm; this
// adds the prime and modular-arithmetic layer. Primality and factoring are trial-division (correct for ALL n,
// O(sqrt n)) -- fast for n up to ~10^12; mod_pow uses a binary Russian-peasant mulmod so it stays correct for
// any modulus up to ~2^62 with NO 64-bit overflow. LEAF -- imports NOTHING.

// PRIVATE: (a * b) mod m WITHOUT 64-bit overflow, via binary doubling. Correct for m up to ~2^62.
fn _nt_mulmod(a: int, b: int, m: int) -> int
    let result = 0
    let x = a % m
    let y = b
    while y > 0
        if (y & 1) == 1
            result = (result + x) % m
        x = (x + x) % m
        y = y / 2
    result

// True if n is prime. Trial division: correct for all n, O(sqrt n).
fn is_prime(n: int) -> bool
    if n < 2
        return false
    if n < 4
        return true
    if (n & 1) == 0
        return false
    let i = 3
    while i * i <= n
        if n % i == 0
            return false
        i = i + 2
    true

// The smallest prime strictly greater than n.
fn next_prime(n: int) -> int
    let c = n + 1
    if c < 2
        c = 2
    while is_prime(c) == false
        c = c + 1
    c

// The prime factors of n WITH multiplicity, ascending (12 -> [2,2,3], 17 -> [17], 1 -> []).
fn prime_factors(n: int) -> list
    let out = []
    let m = n
    while m % 2 == 0 and m > 0
        push(out, 2)
        m = m / 2
    let i = 3
    while i * i <= m
        while m % i == 0
            push(out, i)
            m = m / i
        i = i + 2
    if m > 1
        push(out, m)
    out

// All primes <= limit, via the Sieve of Eratosthenes. O(n log log n).
fn prime_sieve(limit: int) -> list
    let out = []
    if limit < 2
        return out
    let sieve = []
    let i = 0
    while i <= limit
        push(sieve, 1)
        i = i + 1
    sieve[0] = 0
    sieve[1] = 0
    let p = 2
    while p * p <= limit
        if sieve[p] == 1
            let k = p * p
            while k <= limit
                sieve[k] = 0
                k = k + p
        p = p + 1
    let j = 2
    while j <= limit
        if sieve[j] == 1
            push(out, j)
        j = j + 1
    out

// (base ^ exp) mod m, via binary exponentiation with overflow-safe mulmod. exp >= 0, m >= 1.
fn mod_pow(base: int, exp: int, m: int) -> int
    if m == 1
        return 0
    let result = 1
    let b = base % m
    let e = exp
    while e > 0
        if (e & 1) == 1
            result = _nt_mulmod(result, b, m)
        b = _nt_mulmod(b, b, m)
        e = e / 2
    result

// Euler's totient phi(n): the count of integers in [1, n] coprime to n.
fn euler_totient(n: int) -> int
    if n <= 0
        return 0
    let result = n
    let m = n
    let p = 2
    while p * p <= m
        if m % p == 0
            while m % p == 0
                m = m / p
            result = result - result / p
        p = p + 1
    if m > 1
        result = result - result / m
    result
