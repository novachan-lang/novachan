// forge_bktree -- thin wrapper over std/collections/bktree (canonical implementation).
import std/collections/bktree

fn bk_new() -> list
    return bk_new()

fn bk_insert(tree: list, word: string)
    return bk_insert(tree, word)

fn bk_query(tree: list, word: string, max_dist: int) -> list
    return bk_query(tree, word, max_dist)

fn bk_size(tree: list) -> int
    return bk_size(tree)

