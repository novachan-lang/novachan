// forge_bktree -- standalone BK-tree wrapper (was a thin, self-recursive stub over
// std/collections/bktree; std uses the SAME public names (bk_new/bk_insert/bk_query/
// bk_size) as this module, which is a real codegen collision, not just delegation --
// so this file now owns a genuine implementation instead of importing that module.
// Only std/text/distance is imported (for d_levenshtein), which has no name overlap
// with anything defined here.
import std/text/distance

// ── Internal helpers (private; _bktw_ prefix avoids any future collision) ──────

// _bktw_node: create a new BK-tree node for `word`.
fn _bktw_node(word) -> dict
    let children = {}
    let node = {"w": word, "children": children}
    node

// _bktw_insert_node: recursively insert `word` into the subtree rooted at `node`.
// Duplicate words (edit distance 0 from an existing node) are silently ignored.
fn _bktw_insert_node(node, word)
    let d = d_levenshtein(node["w"], word)
    if d == 0
        return 0
    let dk = str(d)
    let children = node["children"]
    if dk in children
        _bktw_insert_node(children[dk], word)
    else
        let newnode = _bktw_node(word)
        children[dk] = newnode
    0

// _bktw_count_node: count total nodes in a subtree (used to keep tree["sz"] exact).
fn _bktw_count_node(node) -> int
    let children = node["children"]
    let ks = keys(children)
    let total = 1
    for i in 0..len(ks)
        total += _bktw_count_node(children[ks[i]])
    total

// _bktw_query_node: collect all words in the subtree rooted at `node` within edit
// distance `maxdist` of `word`, appending them to `results`. Uses the triangle
// inequality of Levenshtein distance to prune child subtrees that cannot contain
// a match.
fn _bktw_query_node(node, word, maxdist, results)
    let d = d_levenshtein(node["w"], word)
    if d <= maxdist
        push(results, node["w"])
    let children = node["children"]
    let ks = keys(children)
    for i in 0..len(ks)
        let dk = ks[i]
        let parsed = 0
        let ci = 0
        while ci < len(dk)
            parsed = parsed * 10 + ord(dk[ci]) - 48
            ci += 1
        let child_d = parsed
        let lo = d - maxdist
        let hi = d + maxdist
        if child_d >= lo and child_d <= hi
            _bktw_query_node(children[dk], word, maxdist, results)
    0

// ── Public API ───────────────────────────────────────────────────────────────

// bk_new: create an empty BK-tree.
fn bk_new() -> dict
    let t = {"root": null, "sz": 0}
    t

// bk_insert: insert `word` into the BK-tree `tree`. Duplicates are ignored.
fn bk_insert(tree: dict, word: string)
    if tree["root"] == null
        let n = _bktw_node(word)
        tree["root"] = n
        tree["sz"] = tree["sz"] + 1
    else
        _bktw_insert_node(tree["root"], word)
        tree["sz"] = _bktw_count_node(tree["root"])

// bk_query: return a sorted list of all words in `tree` within edit distance
// `max_dist` of `word`.
fn bk_query(tree: dict, word: string, max_dist: int) -> list
    let results = []
    if tree["root"] != null
        _bktw_query_node(tree["root"], word, max_dist, results)
    sort(results)
    results

// bk_size: return the number of unique words stored in `tree`.
fn bk_size(tree: dict) -> int
    tree["sz"]
