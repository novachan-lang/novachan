// forge_bktree -- a BK-tree: an index for FUZZY string search that finds every stored word within a given edit
// distance of a query, WITHOUT comparing the query to every word. It's the data structure behind spell-checkers
// and "did you mean?" suggestions, autocorrect, and near-duplicate detection. The trick is the triangle
// inequality on edit distance: if the query is distance d from a node's word and you'll accept matches up to
// tolerance t, then any acceptable word in that node's subtree must attach via an edge whose length is within
// [d-t, d+t] -- so the tree prunes away most branches instead of scanning the whole dictionary. Each node stores a
// word and keeps its children keyed by their exact distance to it. Build cost is a handful of edit-distance
// computations per insert; a query touches only the branches the tolerance allows. Uses Levenshtein distance
// internally. LEAF -- imports NOTHING.

// PRIVATE: Levenshtein (edit) distance between two strings, via a two-row dynamic program.
fn _bk_lev(a: string, b: string) -> int
    let la = len(a)
    let lb = len(b)
    let prev = []
    let j0 = 0
    while j0 <= lb
        push(prev, j0)
        j0 += 1
    let i = 1
    while i <= la
        let curr = [i]
        let j = 1
        while j <= lb
            let cost = 1
            if char_at(a, i - 1) == char_at(b, j - 1)
                cost = 0
            let m = prev[j] + 1
            if curr[j - 1] + 1 < m
                m = curr[j - 1] + 1
            if prev[j - 1] + cost < m
                m = prev[j - 1] + cost
            push(curr, m)
            j += 1
        prev = curr
        i += 1
    prev[lb]

// A new, empty BK-tree: a pack [words, childmaps] you pass to bk_insert / bk_query.
fn bk_new() -> list
    [[], []]

// Insert a word into the BK-tree (duplicates are ignored).
fn bk_insert(tree: list, word: string)
    let words = tree[0]
    let childmaps = tree[1]
    if len(words) == 0
        push(words, word)
        push(childmaps, {})
    else
        let cur = 0
        let done = false
        while done == false
            let d = _bk_lev(word, words[cur])
            if d == 0
                done = true
            else
                let key = str(d)
                if contains(childmaps[cur], key)
                    cur = childmaps[cur][key]
                else
                    let newidx = len(words)
                    push(words, word)
                    push(childmaps, {})
                    childmaps[cur][key] = newidx
                    done = true

// PRIVATE: is a lexicographically before b?
fn _bk_less(a: string, b: string) -> bool
    let n = len(a)
    if len(b) < n
        n = len(b)
    let out = false
    let decided = false
    let i = 0
    while i < n and decided == false
        let ca = ord(char_at(a, i))
        let cb = ord(char_at(b, i))
        if ca < cb
            out = true
            decided = true
        else
            if ca > cb
                decided = true
        i += 1
    if decided == false and len(a) < len(b)
        out = true
    out

// Every stored word within edit distance `max_dist` of `word`, sorted ascending. Prunes via the triangle
// inequality, so it does NOT scan the whole dictionary.
fn bk_query(tree: list, word: string, max_dist: int) -> list
    let words = tree[0]
    let childmaps = tree[1]
    let results = []
    if len(words) > 0
        let stack = [0]
        while len(stack) > 0
            let node = pop(stack)
            let dw = _bk_lev(word, words[node])
            if dw <= max_dist
                push(results, words[node])
            let lo = dw - max_dist
            let hi = dw + max_dist
            let ed = lo
            while ed <= hi
                if ed > 0
                    let key = str(ed)
                    if contains(childmaps[node], key)
                        push(stack, childmaps[node][key])
                ed += 1
    // sort results ascending (insertion sort over strings)
    for a in 1..len(results)
        let keyv = results[a]
        let b = a - 1
        while b >= 0 and _bk_less(keyv, results[b])
            results[b + 1] = results[b]
            b -= 1
        results[b + 1] = keyv
    results

// The number of words stored in the tree.
fn bk_size(tree: list) -> int
    len(tree[0])
