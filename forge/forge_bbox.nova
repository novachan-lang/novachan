// forge_bbox -- 2D axis-aligned bounding boxes: the min/max rectangle around a set of points, and the box
// algebra you build maps and spatial filters on. "Zoom to fit all these markers" is bbox_from_points +
// bbox_center; "is this click inside the region" is bbox_contains; "do these two areas overlap" (viewport
// culling, broad-phase collision, spatial join prefilter) is bbox_intersects; "combine two regions" is
// bbox_union. Works for geographic [lng,lat] or screen/world [x,y] coordinates alike -- a box is
// [min_x, min_y, max_x, max_y]. forge_geo.geo_bbox makes a box from a circle; this is the general box toolkit.
// LEAF -- imports NOTHING.

// The bounding box [min_x, min_y, max_x, max_y] of a list of [x, y] points, or null if the list is empty.
fn bbox_from_points(points: list) -> list
    let box = null
    if len(points) > 0
        let minx = points[0][0] * 1.0
        let miny = points[0][1] * 1.0
        let maxx = minx
        let maxy = miny
        for i in 1..len(points)
            let x = points[i][0] * 1.0
            let y = points[i][1] * 1.0
            if x < minx
                minx = x
            if x > maxx
                maxx = x
            if y < miny
                miny = y
            if y > maxy
                maxy = y
        box = [minx, miny, maxx, maxy]
    box

// Grow `box` (a [minx,miny,maxx,maxy] list) to include point (x, y). Mutates and returns the box.
fn bbox_extend(box: list, x, y) -> list
    let xf = x * 1.0
    let yf = y * 1.0
    if xf < box[0]
        box[0] = xf
    if yf < box[1]
        box[1] = yf
    if xf > box[2]
        box[2] = xf
    if yf > box[3]
        box[3] = yf
    box

// True if point (x, y) lies within the box (inclusive edges).
fn bbox_contains(box: list, x, y) -> bool
    let xf = x * 1.0
    let yf = y * 1.0
    xf >= box[0] and xf <= box[2] and yf >= box[1] and yf <= box[3]

// True if two boxes overlap (touching edges count).
fn bbox_intersects(a: list, b: list) -> bool
    a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]

// The smallest box containing both a and b.
fn bbox_union(a: list, b: list) -> list
    let minx = a[0] * 1.0
    if b[0] < minx
        minx = b[0] * 1.0
    let miny = a[1] * 1.0
    if b[1] < miny
        miny = b[1] * 1.0
    let maxx = a[2] * 1.0
    if b[2] > maxx
        maxx = b[2] * 1.0
    let maxy = a[3] * 1.0
    if b[3] > maxy
        maxy = b[3] * 1.0
    [minx, miny, maxx, maxy]

// The overlapping box of a and b, or null if they do not overlap.
fn bbox_intersection(a: list, b: list)
    let box = null
    if a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]
        let minx = a[0] * 1.0
        if b[0] > minx
            minx = b[0] * 1.0
        let miny = a[1] * 1.0
        if b[1] > miny
            miny = b[1] * 1.0
        let maxx = a[2] * 1.0
        if b[2] < maxx
            maxx = b[2] * 1.0
        let maxy = a[3] * 1.0
        if b[3] < maxy
            maxy = b[3] * 1.0
        box = [minx, miny, maxx, maxy]
    box

// The center point [cx, cy] of the box.
fn bbox_center(box: list) -> list
    let cx = (box[0] * 1.0 + box[2] * 1.0) / 2.0
    let cy = (box[1] * 1.0 + box[3] * 1.0) / 2.0
    [cx, cy]

// Width (max_x - min_x).
fn bbox_width(box: list) -> float
    let w = box[2] * 1.0 - box[0] * 1.0
    w

// Height (max_y - min_y).
fn bbox_height(box: list) -> float
    let h = box[3] * 1.0 - box[1] * 1.0
    h

// Area (width * height).
fn bbox_area(box: list) -> float
    let w = box[2] * 1.0 - box[0] * 1.0
    let h = box[3] * 1.0 - box[1] * 1.0
    let a = w * h
    a
