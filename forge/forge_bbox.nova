// forge_bbox -- thin wrapper over std/geometry/bbox (canonical implementation).
import std/geometry/bbox

fn bbox_from_points(points: list) -> list
    return bb_from_points(points)

fn bbox_extend(box: list, x, y) -> list
    let xf = x * 1.0
    let yf = y * 1.0
    if xf < box[0]
        box[0] = xf
    if yf < box[1]
        box[1] = yf
    if xf > box[2]
        box[2] = xf
    if yf > box[3]
        box[3] = yf
    box

fn bbox_contains(box: list, x, y) -> bool
    return bb_contains(box, x, y)

fn bbox_intersects(a: list, b: list) -> bool
    return bb_intersects(a, b)

fn bbox_union(a: list, b: list) -> list
    return bb_union(a, b)

fn bbox_intersection(a: list, b: list)
    let box = null
    if a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]
        let minx = a[0] * 1.0
        if b[0] > minx
            minx = b[0] * 1.0
        let miny = a[1] * 1.0
        if b[1] > miny
            miny = b[1] * 1.0
        let maxx = a[2] * 1.0
        if b[2] < maxx
            maxx = b[2] * 1.0
        let maxy = a[3] * 1.0
        if b[3] < maxy
            maxy = b[3] * 1.0
        box = [minx, miny, maxx, maxy]
    box

fn bbox_center(box: list) -> list
    return bb_center(box)

fn bbox_width(box: list) -> float
    return bb_width(box)

fn bbox_height(box: list) -> float
    return bb_height(box)

fn bbox_area(box: list) -> float
    return bb_area(box)

