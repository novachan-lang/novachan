// forge_dijkstra -- Dijkstra's shortest-path over a WEIGHTED directed graph. forge_graph gives BFS (fewest
// hops on an unweighted graph); this gives least-COST paths when edges carry weights: road distances, network
// latency/cost, game-AI movement cost (Reactor pathfinding), dependency build cost. Non-negative weights only
// (Dijkstra's requirement). The graph is a dict node -> list of [neighbor, weight] pairs. LEAF -- imports NONE.
//
// The min-selection is a linear O(V^2) scan (no binary heap) -- simple and correct; fine for the small/medium
// graphs a request handler builds. Distances are ints; an unreachable node keeps the sentinel INF.

fn _dij_inf() -> int
    1000000000

// A fresh empty weighted graph.
fn wgraph_new() -> dict
    let g = {}
    g

// Add a directed weighted edge from -> to. For an undirected graph, add both directions.
fn wgraph_edge(g: dict, from_node: string, to_node: string, weight: int) -> dict
    let adj = []
    if from_node in g
        adj = g[from_node]
    push(adj, [to_node, weight])
    g[from_node] = adj
    g

// PRIVATE: all distinct node names (sources AND destinations).
fn _dij_nodes(g: dict) -> list
    let nodes = []
    let seen = {}
    let ks = keys(g)
    for i in 0..len(ks)
        let node = ks[i]
        if node in seen == false
            push(nodes, node)
            seen[node] = 1
        let adj = g[node]
        let j = 0
        while j < len(adj)
            let nb = adj[j][0]
            if nb in seen == false
                push(nodes, nb)
                seen[nb] = 1
            j += 1
    nodes

// Shortest-distance dict from `start` to every reachable node (unreachable -> INF sentinel = 1000000000).
fn dijkstra_dist(g: dict, start: string) -> dict
    let nodes = _dij_nodes(g)
    let inf = _dij_inf()
    let dist = {}
    for i in 0..len(nodes)
        dist[nodes[i]] = inf
    dist[start] = 0
    let visited = {}
    let count = 0
    while count < len(nodes)
        // pick the unvisited node with the smallest tentative distance
        let u = ""
        let best = inf + 1
        for k in 0..len(nodes)
            let nd = nodes[k]
            if nd in visited == false and dist[nd] < best
                best = dist[nd]
                u = nd
        if u == ""
            count = len(nodes)
        else
            visited[u] = 1
            count += 1
            if u in g
                let adj = g[u]
                for j in 0..len(adj)
                    let nb = adj[j][0]
                    let alt = dist[u] + adj[j][1]
                    if alt < dist[nb]
                        dist[nb] = alt
    dist

// The shortest path as a node list from `start` to `goal`, or [] if `goal` is unreachable. Tracks predecessors
// during the same relaxation, then walks them back from the goal.
fn dijkstra_path(g: dict, start: string, goal: string) -> list
    let nodes = _dij_nodes(g)
    let inf = _dij_inf()
    let dist = {}
    let prev = {}
    for i in 0..len(nodes)
        dist[nodes[i]] = inf
    dist[start] = 0
    let visited = {}
    let count = 0
    while count < len(nodes)
        let u = ""
        let best = inf + 1
        for k in 0..len(nodes)
            let nd = nodes[k]
            if nd in visited == false and dist[nd] < best
                best = dist[nd]
                u = nd
        if u == ""
            count = len(nodes)
        else
            visited[u] = 1
            count += 1
            if u in g
                let adj = g[u]
                for j in 0..len(adj)
                    let nb = adj[j][0]
                    let alt = dist[u] + adj[j][1]
                    if alt < dist[nb]
                        dist[nb] = alt
                        prev[nb] = u
    // unreachable?
    if dist[goal] >= inf
        return []
    // walk predecessors goal -> start into a reversed list, then flip
    let rev = []
    let cur = goal
    push(rev, cur)
    while cur != start
        if cur in prev == false
            return []
        cur = prev[cur]
        push(rev, cur)
    let path = []
    let m = len(rev) - 1
    while m >= 0
        push(path, rev[m])
        m -= 1
    path
