// forge_dijkstra -- thin wrapper over std/graph/dijkstra (canonical implementation).
import std/graph/dijkstra

fn _dij_inf() -> int
    1000000000

// A fresh empty weighted graph.

fn _dij_nodes(g: dict) -> list
    let nodes = []
    let seen = {}
    let ks = keys(g)
    for i in 0..len(ks)
        let node = ks[i]
        if node not in seen
            push(nodes, node)
            seen[node] = 1
        let adj = g[node]
        for j in 0..len(adj)
            let nb = adj[j][0]
            if nb not in seen
                push(nodes, nb)
                seen[nb] = 1
    nodes

// Shortest-distance dict from `start` to every reachable node (unreachable -> INF sentinel = 1000000000).

fn wgraph_new() -> dict
    {}

// Add a directed weighted edge from -> to. For an undirected graph, add both directions.

fn wgraph_edge(g: dict, from_node: string, to_node: string, weight: int) -> dict
    let adj = []
    if from_node in g
        adj = g[from_node]
    push(adj, [to_node, weight])
    g[from_node] = adj
    g

// PRIVATE: all distinct node names (sources AND destinations).

fn dijkstra_dist(g: dict, start: string) -> dict
    let nodes = _dij_nodes(g)
    let inf = _dij_inf()
    let dist = {}
    for i in 0..len(nodes)
        dist[nodes[i]] = inf
    dist[start] = 0
    let visited = {}
    let count = 0
    while count < len(nodes)
        // pick the unvisited node with the smallest tentative distance
        let u = ""
        let best = inf + 1
        for k in 0..len(nodes)
            let nd = nodes[k]
            if nd not in visited and dist[nd] < best
                best = dist[nd]
                u = nd
        if u == ""
            count = len(nodes)
        else
            visited[u] = 1
            count += 1
            if u in g
                let adj = g[u]
                for j in 0..len(adj)
                    let nb = adj[j][0]
                    let alt = dist[u] + adj[j][1]
                    if alt < dist[nb]
                        dist[nb] = alt
    dist

// The shortest path as a node list from `start` to `goal`, or [] if `goal` is unreachable. Tracks predecessors
// during the same relaxation, then walks them back from the goal.

fn dijkstra_path(g: dict, start: string, goal: string) -> list
    return dj_path(g, start, goal)

