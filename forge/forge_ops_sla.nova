// forge_ops_sla -- single-service uptime tracking that additionally derives DOWNTIME WINDOWS
// (contiguous [start_ts, end_ts] outage periods) from a raw timestamped up/down stream. The
// existing forge_sla_tracker (sla_/sm_ APIs) and forge_sla_monitor (sla_/sm_ APIs) already track
// uptime PERCENTAGE and violation COUNTS per service, but neither reconstructs the actual outage
// windows a postmortem needs ("down from 10:03 to 10:11, 3 separate incidents"). This module is
// purpose-built for that one gap. LEAF -- imports NOTHING.

fn sl_new(target_pct: int) -> dict
    {"target_pct": target_pct, "records": [], "up_count": 0, "total": 0}

// Record an observation. `up_or_down` is 1 for up, 0 for down. Callers must record in
// chronological (non-decreasing timestamp) order -- sl_violations relies on stream order.
fn sl_record(t: dict, timestamp: int, up_or_down: int) -> dict
    push(t["records"], {"ts": timestamp, "up": up_or_down})
    t["total"] += 1
    if up_or_down == 1
        t["up_count"] += 1
    t

// Uptime as an integer percentage. No records yet -> 100 (nothing observed down).
fn sl_uptime(t: dict) -> int
    if t["total"] == 0
        return 100
    t["up_count"] * 100 / t["total"]

fn sl_is_met(t: dict) -> bool
    sl_uptime(t) >= t["target_pct"]

// Contiguous downtime windows derived from the recorded stream: each is {"start": ts, "end": ts},
// spanning from the first "down" record of a run to the timestamp of the record that ends it (the
// next "up" record). If the stream ends still down, that final window's "end" is the last recorded
// "down" timestamp (an ongoing outage, reported through its last known-down sample).
fn sl_violations(t: dict) -> list
    let windows = []
    let records = t["records"]
    let n = len(records)
    let in_down = false
    let start = 0
    let last_down_ts = 0
    for i in 0..n
        let rec = records[i]
        if rec["up"] == 0
            if not in_down
                in_down = true
                start = rec["ts"]
            last_down_ts = rec["ts"]
        else if in_down
            push(windows, {"start": start, "end": rec["ts"]})
            in_down = false
    if in_down
        push(windows, {"start": start, "end": last_down_ts})
    windows

fn sl_total_records(t: dict) -> int
    t["total"]
