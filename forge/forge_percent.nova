// forge_percent -- everyday percentage math (discounts, tax, tips, growth) using integer CENTS + rounding, so
// there are NO float rounding errors on money -- the arithmetic every checkout, invoice, and dashboard must
// get right. Amounts in cents; rates as whole percent or basis points. LEAF -- imports NOTHING.

// `pct` percent of `amount_cents`, rounded to the nearest cent. percent_of(10000, 15) -> 1500.
fn percent_of(amount_cents: int, pct: int) -> int
    (amount_cents * pct + 50) / 100

// `bps` basis points (1/100 of a percent) of `amount_cents`, rounded -- for fractional rates (8.25% = 825 bps).
fn bps_of(amount_cents: int, bps: int) -> int
    (amount_cents * bps + 5000) / 10000

// Amount minus pct%. apply_discount(10000, 20) -> 8000.
fn apply_discount(amount_cents: int, pct: int) -> int
    amount_cents - percent_of(amount_cents, pct)

// Amount plus pct%. apply_tax(10000, 8) -> 10800.
fn apply_tax(amount_cents: int, pct: int) -> int
    amount_cents + percent_of(amount_cents, pct)

// Amount plus `bps` basis points (fractional tax). apply_tax_bps(10000, 825) -> 10825.
fn apply_tax_bps(amount_cents: int, bps: int) -> int
    amount_cents + bps_of(amount_cents, bps)

// Percent change from old to new (rounded integer percent). percent_change(100, 150) -> 50; (100, 50) -> -50.
fn percent_change(old_cents: int, new_cents: int) -> int
    if old_cents == 0
        return 0
    let diff = (new_cents - old_cents) * 100
    if diff >= 0
        return (diff + old_cents / 2) / old_cents
    (diff - old_cents / 2) / old_cents
