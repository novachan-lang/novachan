// forge_partition_table — Distributed partition-to-node assignment table with rebalancing.

fn pt_new(partition_count: int) -> dict
    {"count": partition_count, "owners": {}, "node_counts": {}, "assigned_count": 0}

fn pt_assign(p: dict, partition_id: int, node_id: string) -> Result
    if partition_id < 0 or partition_id >= p["count"]
        return err("partition out of range")
    let key = str(partition_id)
    let was_assigned = key in p["owners"]
    if was_assigned
        let old_owner = p["owners"][key]
        if old_owner == node_id
            return ok(p)
        p["node_counts"][old_owner] -= 1
    else
        p["assigned_count"] += 1
    p["owners"][key] = node_id
    p["node_counts"][node_id] = (p["node_counts"][node_id] + 1) if node_id in p["node_counts"] else 1
    ok(p)

fn pt_lookup(p: dict, partition_id: int) -> Result
    if partition_id < 0 or partition_id >= p["count"]
        return err("partition out of range")
    let key = str(partition_id)
    if key not in p["owners"]
        return err("unassigned")
    ok(p["owners"][key])

fn pt_node_partitions(p: dict, node_id: string) -> int
    if node_id not in p["node_counts"]
        return 0
    p["node_counts"][node_id]

fn _pt_least_loaded(p: dict, exclude_node: string) -> Result
    let ks = keys(p["node_counts"])
    let best = ""
    let best_count = -1
    for i in 0..len(ks)
        let k = ks[i]
        if k != exclude_node
            let c = p["node_counts"][k]
            if best_count == -1 or c < best_count
                best = k
                best_count = c
    if best_count == -1
        return err("no other node")
    ok(best)

fn pt_rebalance(p: dict, node_id: string) -> Result
    if node_id not in p["node_counts"]
        return err("node not known")
    let check = _pt_least_loaded(p, node_id)
    if is_err(check)
        return err("no target node available")
    let moved = 0
    for i in 0..p["count"]
        let key = str(i)
        if key in p["owners"]
            if p["owners"][key] == node_id
                let target = _pt_least_loaded(p, node_id)
                let t = unwrap(target)
                p["owners"][key] = t
                p["node_counts"][node_id] -= 1
                p["node_counts"][t] += 1
                moved += 1
    ok(moved)

fn pt_partition_count(p: dict) -> int
    p["count"]

fn pt_assigned_count(p: dict) -> int
    p["assigned_count"]

fn pt_is_assigned(p: dict, partition_id: int) -> int
    if partition_id < 0 or partition_id >= p["count"]
        return 0
    1 if str(partition_id) in p["owners"] else 0
