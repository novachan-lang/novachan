// forge_sanitize -- whitelist HTML sanitizer for user rich text (keep safe tags, STRIP attributes,
// DROP dangerous tags) — OWASP-antisamy / Rails sanitize / DOMPurify. Attribute-stripping policy
// (removes onclick/style/js-urls); an href-allowlist is a follow-up. strip_tags = plain-text
// extraction. Verified by reasoning:
//   sanitize("<b onclick='x'>hi</b><script>e</script>") -> "<b>hi</b>"
//   strip_tags("<b>hi</b>")                             -> "hi"
// LEAF: imports nothing.

// ── Private helpers ──────────────────────────────────────────────────────────

// Return true iff `tag` (already lowercased, no attributes) is in the safe whitelist:
// b i em strong p br ul ol li a h1 h2 h3 h4 blockquote code pre span.
fn _san_allowed_tag(tag: string) -> bool
    let allowed = []
    push(allowed, "b")
    push(allowed, "i")
    push(allowed, "em")
    push(allowed, "strong")
    push(allowed, "p")
    push(allowed, "br")
    push(allowed, "ul")
    push(allowed, "ol")
    push(allowed, "li")
    push(allowed, "a")
    push(allowed, "h1")
    push(allowed, "h2")
    push(allowed, "h3")
    push(allowed, "h4")
    push(allowed, "blockquote")
    push(allowed, "code")
    push(allowed, "pre")
    push(allowed, "span")
    contains(allowed, tag)

// Given the inside of a tag (text between < and >, e.g. "a href='x'", "/p", "br/"),
// return the lowercased tag name: strip a leading "/", then take chars up to the
// first space, "/" or end.
//   "a href='x'" -> "a"
//   "/p"         -> "p"
//   "br/"        -> "br"
fn _san_tag_name(inner: string) -> string
    let n = len(inner)
    if n == 0
        return ""
    let start = 0
    if char_at(inner, 0) == "/"
        start = 1
    let i = start
    let name_parts = []
    while i < n
        let c = char_at(inner, i)
        if c == " " or c == "/"
            i = n
        else
            push(name_parts, lower(c))
            i += 1
    let name = join(name_parts, "")
    name

// ── Public API ───────────────────────────────────────────────────────────────

// Sanitize user HTML: keep whitelisted tags (stripping ALL attributes to close
// onclick/style/href=javascript: vectors), drop disallowed tags entirely, emit
// text nodes as-is.  If a "<" has no matching ">", emit the rest literally.
fn sanitize(html: string) -> string
    let out = ""
    let n = len(html)
    let i = 0
    while i < n
        let c = char_at(html, i)
        if c == "<"
            let rest = slice(html, i + 1, n)
            let gt = find(rest, ">")
            if gt < 0
                // No closing ">": emit the rest of the string literally and stop.
                out += slice(html, i, n)
                i = n
            else
                let inner = slice(rest, 0, gt)
                let tag = _san_tag_name(inner)
                if _san_allowed_tag(tag)
                    // Emit just the tag name, attributes stripped.
                    // Detect closing tag: inner starts with "/".
                    let is_close = 0
                    if len(inner) > 0 and char_at(inner, 0) == "/"
                        is_close = 1
                    if is_close == 1
                        out += "</" + tag + ">"
                    else
                        out += "<" + tag + ">"
                // else: disallowed tag — drop silently.
                i += 1 + gt + 1
        else
            out += c
            i += 1
    out

// Strip ALL tags and return only the plain text between them — for search indexes,
// summaries, or plain-text emails. Same scan as sanitize but never emits any tag.
fn strip_tags(html: string) -> string
    let out_parts = []
    let n = len(html)
    let i = 0
    while i < n
        let c = char_at(html, i)
        if c == "<"
            let rest = slice(html, i + 1, n)
            let gt = find(rest, ">")
            if gt < 0
                // No closing ">": emit rest literally.
                push(out_parts, slice(html, i, n))
                i = n
            else
                // Skip over the tag entirely.
                i += 1 + gt + 1
        else
            push(out_parts, c)
            i += 1
    let out = join(out_parts, "")
    out
