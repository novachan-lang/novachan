// forge_bic -- SWIFT / BIC business identifier code validation (ISO 9362): 8 or 11 chars = 4-letter bank code
// + 2-letter ISO country + 2-char location + optional 3-char branch. Validates FORMAT (not existence). Pairs
// with forge_iban for international wire/SEPA payments. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. One problem:
//
//   1. bic_valid had nested else+if. else if.

fn bic_valid(bic: string) -> bool
    let s = upper(trim(bic))
    let n = len(s)
    if n != 8 and n != 11
        return false
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let digits = "0123456789"
    for i in 0..n
        let c = char_at(s, i)
        if i < 6
            if find(letters, c) < 0
                return false
        else if find(letters, c) < 0 and find(digits, c) < 0
            return false
    true

fn bic_bank(bic: string) -> string
    slice(upper(trim(bic)), 0, 4)

fn bic_country(bic: string) -> string
    slice(upper(trim(bic)), 4, 6)
