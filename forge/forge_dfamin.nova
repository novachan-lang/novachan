// forge_dfamin -- DFA minimization: compute the unique smallest DFA equivalent to a given one.
// Given a deterministic finite automaton (states, alphabet, transition table, accepting set), there is a
// UNIQUE minimal DFA (fewest states) that accepts the exact same language -- the Myhill-Nerode theorem
// guarantees it. Minimization merges states that are INDISTINGUISHABLE (no input string leads one to
// accept and the other to reject). This is foundational for regular-expression engines (compile /
// optimize a regex to the smallest matcher), lexer generators, model checking, hardware FSM synthesis,
// and testing automaton EQUIVALENCE (two DFAs accept the same language iff their minimal DFAs are
// isomorphic). We implement partition refinement (the Moore/Hopcroft family): start with the coarse
// partition {accepting, non-accepting} and repeatedly split any block whose members transition, on some
// symbol, into DIFFERENT blocks -- until stable. The resulting blocks are the minimal DFA's states.
// (We also remove UNREACHABLE states first, since they never affect the language.)
//
// DFA representation: n states 0..n-1; alphabet size m (symbols 0..m-1); trans[s][c] = next state
// (must be total: every (state,symbol) defined; use a dead state if needed); accepting = list of 0/1
// per state; start state index. All states must have exactly m transitions.
//
// API:
//   dfa_minimize(n, m, trans, accepting, start) -> list
//     returns [num_states, new_trans, new_accepting, new_start, block_of] where block_of[s] = the minimal
//     state that old state s maps to (unreachable states map to -1).
//   dfa_num_states_minimal(n, m, trans, accepting, start) -> int   just the minimal state count
//   dfa_equivalent(nA,mA,tA,aA,sA, nB,mB,tB,aB,sB) -> bool          do two DFAs accept the same language?
// LEAF (imports nothing).

// Find reachable states from start (BFS over transitions).
fn _dm_reachable(n: int, m: int, trans: list, start: int) -> list
    let reach = [0 for i in 0..n]
    reach[start] = 1
    let queue = [start]
    let qi = 0
    // KEPT as `while`: this is a BFS WORKLIST -- `queue` grows inside the body, so the bound must be
    // re-read every iteration. A for-range bound is evaluated once and would miss every discovered state.
    while qi < len(queue)
        let s = queue[qi]
        qi += 1
        for c in 0..m
            let nx = trans[s][c]
            if nx >= 0 and nx < n and reach[nx] == 0
                reach[nx] = 1
                push(queue, nx)
    return reach

// PRIVATE: the partition-refinement signature of state `s` -- its own block id followed by the block id of
// each transition target (-1 for an out-of-range target). Two states in the same block that disagree here
// must be split apart. Built as PARTS + one join: `sig = sig + "_" + ...` inside the symbol loop
// reallocates and recopies the whole signature on every symbol (quadratic in the alphabet size).
fn _dm_signature(n: int, m: int, trans: list, block: list, s: int) -> string
    let parts = [str(block[s])]
    for c in 0..m
        let nx = trans[s][c]
        let tb = 0 - 1
        if nx >= 0 and nx < n
            tb = block[nx]
        push(parts, str(tb))
    return join(parts, "_")

// PRIVATE: the minimal DFA's transition row for the block represented by old state `s`.
fn _dm_row(n: int, m: int, trans: list, block: list, s: int) -> list
    let row = []
    for c in 0..m
        let old_target = trans[s][c]
        let tb = 0 - 1
        if old_target >= 0 and old_target < n
            tb = block[old_target]
        push(row, tb)
    return row

// Partition-refinement minimization. Returns [num_states, new_trans, new_accepting, new_start, block_of].
fn dfa_minimize(n: int, m: int, trans: list, accepting: list, start: int) -> list
    let reach = _dm_reachable(n, m, trans, start)
    // block[s] = current partition block for state s: -1 unreachable, else 1 accepting / 0 non-accepting
    let block = [((0 - 1) if reach[i] == 0 else (1 if accepting[i] == 1 else 0)) for i in 0..n]
    // KEPT as `while`: refinement runs to a FIXPOINT -- the trip count is data-dependent, not a range.
    let changed = true
    while changed
        // For each state, compute a signature = (current block, block of each transition target).
        // Group states with the same current block by signature; assign new block ids.
        let sigs = {}
        let next_id = 0
        let new_block = [0 - 1 for z in 0..n]
        for s in 0..n
            if block[s] >= 0
                let sig = _dm_signature(n, m, trans, block, s)
                let existing = get(sigs, sig, 0 - 1)
                if existing == 0 - 1
                    sigs[sig] = next_id
                    new_block[s] = next_id
                    next_id += 1
                else
                    new_block[s] = existing
        // did the partition change?
        changed = any([block[s2] != new_block[s2] for s2 in 0..n])
        block = new_block
    // number of minimal states = distinct block ids among reachable states
    let block_seen = {}
    for s3 in 0..n
        if block[s3] >= 0
            block_seen[str(block[s3])] = 1
    let num_states = len(block_seen)
    // Build new transition table + accepting set. Pick a representative state per block.
    // rep[b] = some old state in block b
    let rep = [0 - 1 for b in 0..num_states]
    for s4 in 0..n
        if block[s4] >= 0
            if rep[block[s4]] == 0 - 1
                rep[block[s4]] = s4
    let new_trans = [_dm_row(n, m, trans, block, rep[bb]) for bb in 0..num_states]
    let new_accepting = [accepting[rep[bb]] for bb in 0..num_states]
    let new_start = block[start]
    return [num_states, new_trans, new_accepting, new_start, block]

fn dfa_num_states_minimal(n: int, m: int, trans: list, accepting: list, start: int) -> int
    let res = dfa_minimize(n, m, trans, accepting, start)
    return res[0]

// Simulate a DFA on an input word (list of symbols); return true if accepted.
fn _dm_accepts(n: int, m: int, trans: list, accepting: list, start: int, word: list) -> bool
    let cur = start
    // KEPT as a loop (not a fold): it SHORT-CIRCUITS out on an invalid state.
    for c in word
        if cur < 0 or cur >= n
            return false
        cur = trans[cur][c]
    if cur < 0 or cur >= n
        return false
    return accepting[cur] == 1

// Equivalence by testing all words up to a bounded length (decisive for small automata; a full
// product-construction equivalence would be exact, this bounded check is the practical KAT tool).
fn dfa_equivalent(nA: int, mA: int, tA: list, aA: list, sA: int, nB: int, mB: int, tB: list, aB: list, sB: int) -> bool
    if mA != mB
        return false
    // test all words of length 0..(nA+nB) over the alphabet -- by Myhill-Nerode a difference,
    // if any, appears within this length. We enumerate words as base-m counters.
    let maxlen = nA + nB + 1
    let m = mA
    for l in 0..(maxlen + 1)
        // enumerate all m^l words of length l
        let total = 1
        for t in 0..l
            total = total * m
        for widx in 0..total
            // decode widx into a word of length l (base-m digits, least significant first)
            let word = []
            let tmp = widx
            for p in 0..l
                push(word, tmp % m)
                tmp = tmp / m
            let accA = _dm_accepts(nA, mA, tA, aA, sA, word)
            let accB = _dm_accepts(nB, mB, tB, aB, sB, word)
            if accA != accB
                return false
    return true
