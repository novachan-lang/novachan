// forge_spatialhash -- a spatial hash grid for fast "what's near here?" queries over many 2D objects. Checking
// every pair of N objects for proximity is O(N^2) and collapses at scale; a spatial hash buckets objects into
// grid cells by position, so you only ever compare things in the same or neighbouring cells -- near O(N) in
// practice. It's the broad-phase behind game/physics collision (only test nearby entities), particle systems,
// flocking/boids neighbour lookups, hit-testing a click against thousands of sprites, and map/point clustering.
// Pick a cell size roughly the size of your objects or query radius. You insert object ids at (x, y), then ask
// for the ids in a cell, its 3x3 neighbourhood, or an arbitrary box. Coordinates may be integer or float; ids
// are whatever you store. Representation: [cell_size, dict of "cx,cy" -> id list]. LEAF -- imports NOTHING.

// PRIVATE: the "cx,cy" cell key for a world position.
fn _sh_key(grid: list, x, y) -> string
    let cs = grid[0] * 1.0
    let cx = int(floor(x * 1.0 / cs))
    let cy = int(floor(y * 1.0 / cs))
    str(cx) + "," + str(cy)

// A new spatial hash with the given cell size.
fn spatial_new(cell_size) -> list
    [cell_size, {}]

// Insert object `id` at world position (x, y).
fn spatial_insert(grid: list, id, x, y)
    let d = grid[1]
    let key = _sh_key(grid, x, y)
    if contains(d, key) == false
        d[key] = []
    push(d[key], id)

// The ids stored in the single cell containing (x, y).
fn spatial_cell(grid: list, x, y) -> list
    let d = grid[1]
    let key = _sh_key(grid, x, y)
    let out = []
    if contains(d, key)
        let ids = d[key]
        let i = 0
        while i < len(ids)
            push(out, ids[i])
            i = i + 1
    out

// The ids in the 3x3 block of cells centered on (x, y) -- the usual "nearby objects" query for collision/boids.
fn spatial_neighbors(grid: list, x, y) -> list
    let cs = grid[0] * 1.0
    let cx = int(floor(x * 1.0 / cs))
    let cy = int(floor(y * 1.0 / cs))
    let d = grid[1]
    let out = []
    let dcx = 0 - 1
    while dcx <= 1
        let dcy = 0 - 1
        while dcy <= 1
            let key = str(cx + dcx) + "," + str(cy + dcy)
            if contains(d, key)
                let ids = d[key]
                let i = 0
                while i < len(ids)
                    push(out, ids[i])
                    i = i + 1
            dcy = dcy + 1
        dcx = dcx + 1
    out

// All ids in cells overlapping the axis-aligned box [minx,miny]..[maxx,maxy].
fn spatial_query(grid: list, minx, miny, maxx, maxy) -> list
    let cs = grid[0] * 1.0
    let cx0 = int(floor(minx * 1.0 / cs))
    let cy0 = int(floor(miny * 1.0 / cs))
    let cx1 = int(floor(maxx * 1.0 / cs))
    let cy1 = int(floor(maxy * 1.0 / cs))
    let d = grid[1]
    let out = []
    let cx = cx0
    while cx <= cx1
        let cy = cy0
        while cy <= cy1
            let key = str(cx) + "," + str(cy)
            if contains(d, key)
                let ids = d[key]
                let i = 0
                while i < len(ids)
                    push(out, ids[i])
                    i = i + 1
            cy = cy + 1
        cx = cx + 1
    out

// The number of non-empty cells (occupied buckets).
fn spatial_cell_count(grid: list) -> int
    len(keys(grid[1]))
