// forge_sensor_aggregator — Edge IoT sensor data aggregation.
// Register sensors, record readings, and query latest/count/mean/min/max stats.

fn sa_new() -> dict
    let s = {}
    s["type"] = {}
    s["registered"] = {}
    s["latest"] = {}
    s["count"] = {}
    s["sum"] = {}
    s["min"] = {}
    s["max"] = {}
    s["last_ts"] = {}
    s["sensor_count"] = 0
    s["total_readings"] = 0
    s

fn sa_register(s: dict, sensor_id: string, sensor_type: string) -> dict
    let is_new = contains(s["registered"], sensor_id) != true
    s["registered"][sensor_id] = 1
    s["type"][sensor_id] = sensor_type
    if is_new
        s["count"][sensor_id] = 0
        s["sum"][sensor_id] = 0.0
        s["latest"][sensor_id] = 0.0
        s["min"][sensor_id] = 0.0
        s["max"][sensor_id] = 0.0
        s["last_ts"][sensor_id] = 0
        s["sensor_count"] = s["sensor_count"] + 1
    s

fn sa_reading(s: dict, sensor_id: string, value: float, timestamp: int) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    let c = s["count"][sensor_id]
    s["latest"][sensor_id] = value
    s["last_ts"][sensor_id] = timestamp
    s["sum"][sensor_id] = s["sum"][sensor_id] + value
    if c == 0
        s["min"][sensor_id] = value
        s["max"][sensor_id] = value
    else
        if value < s["min"][sensor_id]
            s["min"][sensor_id] = value
        if value > s["max"][sensor_id]
            s["max"][sensor_id] = value
    s["count"][sensor_id] = c + 1
    s["total_readings"] = s["total_readings"] + 1
    ok(value)

fn sa_latest(s: dict, sensor_id: string) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    if s["count"][sensor_id] == 0
        return err("no readings: " + sensor_id)
    ok(s["latest"][sensor_id])

fn sa_count(s: dict, sensor_id: string) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    ok(s["count"][sensor_id])

fn sa_mean(s: dict, sensor_id: string) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    let c = s["count"][sensor_id]
    if c == 0
        return err("no readings: " + sensor_id)
    ok(s["sum"][sensor_id] / float(c))

fn sa_min_val(s: dict, sensor_id: string) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    if s["count"][sensor_id] == 0
        return err("no readings: " + sensor_id)
    ok(s["min"][sensor_id])

fn sa_max_val(s: dict, sensor_id: string) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    if s["count"][sensor_id] == 0
        return err("no readings: " + sensor_id)
    ok(s["max"][sensor_id])

fn sa_sensor_count(s: dict) -> int
    s["sensor_count"]

fn sa_total_readings(s: dict) -> int
    s["total_readings"]

fn sa_sensor_type(s: dict, sensor_id: string) -> Result
    if contains(s["registered"], sensor_id) != true
        return err("unknown sensor: " + sensor_id)
    ok(s["type"][sensor_id])
