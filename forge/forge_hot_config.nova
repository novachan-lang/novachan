// forge_hot_config — Hot configuration reload.
// Watch config values, update without restart, track versions.

fn hc_new() -> dict
    let hc = {}
    hc["values"] = {}
    hc["versions"] = {}
    hc["watchers"] = []
    hc["reload_count"] = 0
    hc

fn hc_set(hc: dict, key: string, value: string, version: int) -> dict
    hc["values"][key] = value
    hc["versions"][key] = version
    hc

fn hc_get(hc: dict, key: string) -> string
    let has = contains(hc["values"], key)
    if has != true
        return ""
    hc["values"][key]

fn hc_get_version(hc: dict, key: string) -> int
    let has = contains(hc["versions"], key)
    if has != true
        return 0
    hc["versions"][key]

fn hc_reload(hc: dict, key: string, value: string, version: int) -> dict
    let old_ver = hc_get_version(hc, key)
    if version > old_ver
        hc["values"][key] = value
        hc["versions"][key] = version
        hc["reload_count"] = hc["reload_count"] + 1
    hc

fn hc_add_watcher(hc: dict, key: string, callback_name: string) -> dict
    let w = {}
    w["key"] = key
    w["callback"] = callback_name
    push(hc["watchers"], w)
    hc

fn hc_watchers_for(hc: dict, key: string) -> list
    let result = []
    let i = 0
    while i < len(hc["watchers"])
        if hc["watchers"][i]["key"] == key
            push(result, hc["watchers"][i]["callback"])
        i += 1
    result

fn hc_key_count(hc: dict) -> int
    len(keys(hc["values"]))

fn hc_reload_count(hc: dict) -> int
    hc["reload_count"]

fn hc_has_key(hc: dict, key: string) -> int
    let has = contains(hc["values"], key)
    if has == true
        return 1
    0
