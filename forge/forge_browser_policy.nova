// forge_browser_policy -- BUILDERS for two browser-control response headers that forge_security_headers only
// ships as fixed strings: a per-feature Permissions-Policy (which browser capabilities a document may use, and
// for whom) and Clear-Site-Data (wipe the client's cache/cookies/storage, e.g. on logout). forge_security_
// headers gives you a locked-down default; this module lets you OPEN specific features precisely -- allow the
// camera for your own origin plus a named partner, autoplay for everyone, geolocation for no one. LEAF.
//
// Permissions-Policy allowlist grammar: `feature=*` (all), `feature=()` (none), or `feature=(self "https://x"
// "https://y")`. Origins are quoted. Directives are comma-separated.

// PRIVATE: quote an origin string for an allowlist ("https://x.com" -> the same, wrapped in double quotes).
fn _bp_qorigin(origin: string) -> string
    chr(34) + origin + chr(34)

// feature disabled for everyone: `geolocation=()`.
fn pp_none(feature: string) -> string
    feature + "=()"

// feature allowed only for the document's own origin: `fullscreen=(self)`.
fn pp_self(feature: string) -> string
    feature + "=(self)"

// feature allowed for ALL origins (including cross-origin iframes): `autoplay=*`.
fn pp_any(feature: string) -> string
    feature + "=*"

// feature allowed for self plus an explicit list of origins: `camera=(self "https://a.com" "https://b.com")`.
// An empty origins list collapses to `feature=(self)`.
fn pp_allow(feature: string, origins: list) -> string
    let inner = "self"
    let i = 0
    while i < len(origins)
        inner = inner + " " + _bp_qorigin(origins[i])
        i = i + 1
    feature + "=(" + inner + ")"

// Join directive strings into the full Permissions-Policy header value (comma+space separated).
fn permissions_policy(directives: list) -> string
    let out = ""
    let i = 0
    while i < len(directives)
        if i > 0
            out = out + ", "
        out = out + directives[i]
        i = i + 1
    out

// Clear-Site-Data header value from a list of data types ("cache","cookies","storage","executionContexts"):
// each is a quoted-string, comma-separated -> `"cache", "cookies"`. Sent on logout to purge client state.
fn clear_site_data(types: list) -> string
    let out = ""
    let i = 0
    while i < len(types)
        if i > 0
            out = out + ", "
        out = out + chr(34) + types[i] + chr(34)
        i = i + 1
    out

// Clear EVERYTHING: the wildcard `"*"` Clear-Site-Data value.
fn clear_site_data_all() -> string
    chr(34) + "*" + chr(34)
