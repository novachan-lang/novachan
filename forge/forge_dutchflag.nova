// forge_dutchflag -- Dijkstra's Dutch National Flag problem: partition an array into THREE groups in ONE linear
// pass with O(1) extra space, using three pointers that sweep the "low", "middle", and "high" regions inward until
// they meet. dutch_flag sorts an array of just three distinct values (classically 0/1/2, like the red/white/blue
// stripes of the Dutch flag) -- the textbook "sort colors" problem. partition3 generalizes it to any pivot,
// rearranging elements into [ < pivot | == pivot | > pivot ]; that three-way split is the heart of a QUICKSORT
// that stays fast even when the data has MANY DUPLICATE keys (ordinary two-way quicksort degrades to O(n^2) there),
// and it's how you bucket data into below/at/above a threshold, group by a ternary category, or move all
// zeros/nulls to one end. Everything happens in place, stable within the middle group's boundaries only by
// construction. Integer arrays. LEAF -- imports NOTHING.

// Sort an array whose elements are only 0, 1, or 2 into ascending order in a single pass. dutch_flag([2,0,2,1,1,0])
// = [0,0,1,1,2,2].
fn dutch_flag(arr: list) -> list
    let out = []
    for i in 0..len(arr)
        push(out, arr[i])
    let low = 0
    let mid = 0
    let high = len(out) - 1
    while mid <= high
        if out[mid] == 0
            let t = out[low]
            out[low] = out[mid]
            out[mid] = t
            low += 1
            mid += 1
        else
            if out[mid] == 1
                mid += 1
            else
                let t2 = out[mid]
                out[mid] = out[high]
                out[high] = t2
                high -= 1
    out

// Partition around `pivot` into [ < pivot | == pivot | > pivot ]. Returns [partitioned_array, lt_count, eq_count]
// so the three regions are arr[0..lt), arr[lt..lt+eq), arr[lt+eq..n). One pass, O(1) extra space.
fn partition3(arr: list, pivot: int) -> list
    let out = [arr[i] for i in 0..len(arr)]
    let low = 0
    let mid = 0
    let high = len(out) - 1
    while mid <= high
        if out[mid] < pivot
            let t = out[low]
            out[low] = out[mid]
            out[mid] = t
            low += 1
            mid += 1
        else
            if out[mid] == pivot
                mid += 1
            else
                let t2 = out[mid]
                out[mid] = out[high]
                out[high] = t2
                high -= 1
    // low = start of ==pivot region = count of <pivot; mid = start of >pivot region
    [out, low, mid - low]
