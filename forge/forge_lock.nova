// forge_lock -- named mutual-exclusion locks as a single-owner ACTOR. Coordinate access to a named resource
// among green tasks: lock_acquire PARKS until the lock is free (FIFO-fair waiter queue), lock_release frees
// it (or hands it to the next waiter). Race-free -- one actor owns all lock state, no OS mutex. (A
// cluster-wide lock routes to a coordinator node; single-node here.) LEAF -- channel/spawn/send/receive/
// contains/push/len only.

fn _lock_loop(l)
    let held = {}
    let waiters = {}
    let running = 1
    while running == 1
        let env = receive(l["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "acquire"
            let nm = env["name"]
            let free = 1
            if nm in held
                if held[nm] == 1
                    free = 0
            if free == 1
                held[nm] = 1
                send(env["reply"], 1)
            else
                if nm not in waiters
                    waiters[nm] = []
                push(waiters[nm], env["reply"])
        else if op == "release"
            let nm = env["name"]
            let handed = 0
            if nm in waiters
                let ws = waiters[nm]
                if len(ws) > 0
                    let next = ws[0]
                    let rest = [ws[i] for i in 1..len(ws)]
                    waiters[nm] = rest
                    send(next, 1)
                    handed = 1
            if handed == 0
                held[nm] = 0

fn lock_new() -> any
    let l = {}
    l["req"] = channel()
    spawn _lock_loop(l)
    l

// Acquire `name` -- PARKS the calling task until the lock is granted (immediately if free, else when the
// current holder releases and this waiter reaches the front of the queue). Returns 1 when held.
fn lock_acquire(l, name: string) -> int
    let rc = channel()
    let env = {}
    env["op"] = "acquire"
    env["name"] = name
    env["reply"] = rc
    send(l["req"], env)
    receive(rc)

// Release `name` -- frees the lock, or hands it directly to the next waiter (FIFO). Fire-and-forget.
fn lock_release(l, name: string)
    let env = {}
    env["op"] = "release"
    env["name"] = name
    send(l["req"], env)

fn lock_stop(l)
    let env = {}
    env["op"] = "stop"
    send(l["req"], env)
