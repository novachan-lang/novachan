// forge_cachecontrol -- Cache-Control directive builder. LEAF -- imports NOTHING.

fn cache_public(max_age: int) -> string
    "public, max-age={max_age}"

fn cache_private(max_age: int) -> string
    "private, max-age={max_age}"

fn cache_immutable() -> string
    "public, max-age=31536000, immutable"

fn cache_no_store() -> string
    "no-store, no-cache, must-revalidate, max-age=0"

fn cache_swr(max_age: int, swr: int) -> string
    "public, max-age={max_age}, stale-while-revalidate={swr}"

fn cache_shared(max_age: int, s_maxage: int) -> string
    "public, max-age={max_age}, s-maxage={s_maxage}"
