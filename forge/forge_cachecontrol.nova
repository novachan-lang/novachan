// forge_cachecontrol -- Cache-Control directive BUILDER (produces the header VALUE; Forge's core
// cache_control(resp, value) sets it). Compose correct caching policy so responses cache exactly as intended:
// public CDN caching, private per-user, immutable fingerprinted assets, no-store for sensitive data, and
// stale-while-revalidate for snappy revalidation. Getting these strings wrong causes stale data or zero
// caching -- this makes them one obvious call. LEAF -- imports NOTHING.

// Public, shared-cacheable for `max_age` seconds (CDN + browser).
fn cache_public(max_age: int) -> string
    "public, max-age=" + str(max_age)

// Private (per-user; browser only, never a shared cache) for `max_age` seconds.
fn cache_private(max_age: int) -> string
    "private, max-age=" + str(max_age)

// Immutable fingerprinted asset -- cache a year, never revalidate (hashed JS/CSS/images).
fn cache_immutable() -> string
    "public, max-age=31536000, immutable"

// Never store -- auth pages, personal data. The safe default for anything sensitive.
fn cache_no_store() -> string
    "no-store, no-cache, must-revalidate, max-age=0"

// Fresh for `max_age`, then serve stale up to `swr` seconds while revalidating in the background (snappy UX
// with eventual freshness -- the Next.js / Vercel edge pattern).
fn cache_swr(max_age: int, swr: int) -> string
    "public, max-age=" + str(max_age) + ", stale-while-revalidate=" + str(swr)

// Distinct browser vs CDN TTL: browser `max_age`, shared-cache `s_maxage`.
fn cache_shared(max_age: int, s_maxage: int) -> string
    "public, max-age=" + str(max_age) + ", s-maxage=" + str(s_maxage)
