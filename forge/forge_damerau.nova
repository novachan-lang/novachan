// forge_damerau -- Damerau-Levenshtein edit distance (Optimal String Alignment variant): like the plain
// Levenshtein distance (forge already has that) but with a fourth edit -- transposing two ADJACENT characters
// counts as ONE operation, not two. That single change matches how people actually mistype ("teh" -> "the",
// "recieve" -> "receive"), so it ranks fuzzy-search / spell-check / typo-tolerant lookups markedly better than
// Levenshtein. Returns the minimum edit count between two strings. LEAF -- imports NOTHING.
//
// Implementation note: the DP table is a FLAT (m+1)*(n+1) int list indexed i*w+j -- NOVA supports 1D list
// element assignment, which keeps this sound without relying on nested-list writes.

fn damerau_levenshtein(a: string, b: string) -> int
    let m = len(a)
    let n = len(b)
    let w = n + 1
    let sz = (m + 1) * w
    let d = [0 for k in 0..sz]
    // first column d[i][0] = i, first row d[0][j] = j
    for i in 0..(m + 1)
        d[i * w] = i
    for j in 0..(n + 1)
        d[j] = j
    // fill
    for i in 1..(m + 1)
        for jj in 1..(n + 1)
            let cost = 0 if char_at(a, i - 1) == char_at(b, jj - 1) else 1
            let best = d[(i - 1) * w + jj] + 1
            let ins = d[i * w + jj - 1] + 1
            if ins < best
                best = ins
            let sub = d[(i - 1) * w + jj - 1] + cost
            if sub < best
                best = sub
            if i > 1 and jj > 1
                if char_at(a, i - 1) == char_at(b, jj - 2) and char_at(a, i - 2) == char_at(b, jj - 1)
                    let trans = d[(i - 2) * w + jj - 2] + 1
                    if trans < best
                        best = trans
            d[i * w + jj] = best
    d[m * w + n]
