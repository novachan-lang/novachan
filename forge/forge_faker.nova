// forge_faker -- fake test/seed DATA generation (names, emails, usernames, sentences) for seeding dev
// databases, demos, and load tests (the Faker / factory_bot / faker.js role). DETERMINISTIC from a caller
// seed, so tests are reproducible (pass a loop index) or varied (pass secure_bytes-derived seeds). LEAF.

fn _fake_firsts() -> list
    ["ada", "grace", "alan", "linus", "margaret", "dennis", "barbara", "ken", "radia", "hedy"]

fn _fake_lasts() -> list
    ["lovelace", "hopper", "turing", "torvalds", "hamilton", "ritchie", "liskov", "thompson", "perlman", "lamarr"]

fn _fake_cap(w: string) -> string
    upper(slice(w, 0, 1)) + slice(w, 1, len(w))

// A full name from a seed: "Ada Lovelace".
fn fake_name(seed: int) -> string
    let firsts = _fake_firsts()
    let lasts = _fake_lasts()
    _fake_cap(firsts[seed % len(firsts)]) + " " + _fake_cap(lasts[(seed / 7) % len(lasts)])

// An email from a seed: "ada.lovelace@example.com".
fn fake_email(seed: int) -> string
    let firsts = _fake_firsts()
    let lasts = _fake_lasts()
    firsts[seed % len(firsts)] + "." + lasts[(seed / 7) % len(lasts)] + "@example.com"

// A username from a seed: "ada_42".
fn fake_username(seed: int) -> string
    let firsts = _fake_firsts()
    firsts[seed % len(firsts)] + "_" + str(seed % 100)

// A lorem-ish sentence of `words` words from a seed (mod-kept to avoid overflow).
fn fake_sentence(seed: int, words: int) -> string
    let lex = ["lorem", "ipsum", "dolor", "sit", "amet", "forge", "nova", "builds", "everything", "everywhere", "fast", "simple", "safe"]
    let out = ""
    let s = seed
    let i = 0
    while i < words
        if i > 0
            out = out + " "
        out = out + lex[s % len(lex)]
        s = (s * 31 + 7) % 1000000007
        i = i + 1
    out
