// forge_time_series — Time series storage with Result.

fn ts_new() -> dict
    let t = {}
    t["points"] = {}
    t["count"] = 0
    t

fn ts_add(t: dict, timestamp: int, value: int) -> dict
    let k = str(t["count"])
    t["points"][k + "_ts"] = timestamp
    t["points"][k + "_val"] = value
    t["count"] = t["count"] + 1
    t

fn ts_get(t: dict, idx: int) -> Result
    if idx < 0
        return err("negative index")
    if idx >= t["count"]
        return err("index out of range")
    ok(t["points"][str(idx) + "_val"])

fn ts_range_sum(t: dict, start_ts: int, end_ts: int) -> int
    let total = 0
    let i = 0
    while i < t["count"]
        let ts = t["points"][str(i) + "_ts"]
        if ts >= start_ts
            if ts <= end_ts
                total = total + t["points"][str(i) + "_val"]
        i = i + 1
    total

fn ts_range_count(t: dict, start_ts: int, end_ts: int) -> int
    let c = 0
    let i = 0
    while i < t["count"]
        let ts = t["points"][str(i) + "_ts"]
        if ts >= start_ts
            if ts <= end_ts
                c = c + 1
        i = i + 1
    c

fn ts_latest(t: dict) -> Result
    if t["count"] == 0
        return err("no data points")
    ok(t["points"][str(t["count"] - 1) + "_val"])

fn ts_min(t: dict) -> Result
    if t["count"] == 0
        return err("no data points")
    let m = t["points"]["0_val"]
    let i = 1
    while i < t["count"]
        let v = t["points"][str(i) + "_val"]
        if v < m
            m = v
        i = i + 1
    ok(m)

fn ts_max(t: dict) -> Result
    if t["count"] == 0
        return err("no data points")
    let m = t["points"]["0_val"]
    let i = 1
    while i < t["count"]
        let v = t["points"][str(i) + "_val"]
        if v > m
            m = v
        i = i + 1
    ok(m)

fn ts_count(t: dict) -> int
    t["count"]
