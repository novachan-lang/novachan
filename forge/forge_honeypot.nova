// forge_honeypot -- accessible, no-CAPTCHA form spam prevention via the HONEYPOT + submission-timing
// technique. A hidden form field that humans never see (CSS-hidden) but naive bots eagerly fill, paired
// with a minimum render-to-submit time check (bots submit in milliseconds; humans take seconds). This is
// the WCAG-friendly anti-bot method: no puzzle, no third party, no user friction. The server renders the
// hidden field with honeypot_field_name(), records the render timestamp, then on POST calls honeypot_ok()
// (or honeypot_is_bot()) to decide. Pure/deterministic -- no hidden RNG, no clock read. LEAF -- imports NOTHING.

// A plausible trap field name derived from `seed`. Bots pattern-match on tempting names like "url"/"website"
// and fill them; a human never sees the CSS-hidden input so leaves it blank. Deterministic per seed so the
// renderer and the checker agree on ONE name: "" -> "website"; otherwise `seed + "_url"`.
fn honeypot_field_name(seed: string) -> string
    if seed == ""
        return "website"
    seed + "_url"

// True iff the honeypot `field` is present in `form` AND carries a non-empty value. A human leaves the
// hidden field blank (empty or absent); a bot that auto-fills every input trips this. Exposed separately
// so callers can log/flag the honeypot hit distinctly from the timing hit.
fn honeypot_field_filled(form: dict, field: string) -> bool
    if field in form
        return len(str(form[field])) > 0
    false

// Core spam decision. Returns TRUE (likely a bot) if EITHER:
//   (a) the honeypot field was filled in (honeypot_field_filled), OR
//   (b) the submission was too fast: submit_ms - render_ms < min_ms (bots POST in ms; use min_ms ~2000).
// Returns FALSE (likely human) otherwise. `or` short-circuits, so a filled honeypot skips the timing math.
fn honeypot_is_bot(form: dict, field: string, submit_ms: int, render_ms: int, min_ms: int) -> bool
    honeypot_field_filled(form, field) or (submit_ms - render_ms < min_ms)

// Convenience negation: TRUE means the submission looks human -- accept it. Use as the gate at the top of a
// POST handler: `if honeypot_ok(form, hp, now, rendered, 2000)` then process, else silently drop/soft-fail.
fn honeypot_ok(form: dict, field: string, submit_ms: int, render_ms: int, min_ms: int) -> bool
    not honeypot_is_bot(form, field, submit_ms, render_ms, min_ms)
