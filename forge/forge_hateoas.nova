// forge_hateoas -- S17: hypermedia (HAL) links (Spring HATEOAS parity). A resource carries "_links" so a
// client navigates by relation ("self", "next", "author"), not by hard-coded URLs -- the REST maturity
// level Spring HATEOAS adds. Build a HAL envelope: hal_resource(data) + hal_link(rel, href); json_stringify
// it to emit application/hal+json.
//
// LEAF MODULE -- imports NOTHING. Built-ins: keys, contains.

// Wrap a data dict as a HAL resource (copies the fields + adds an empty _links object).
fn hal_resource(data: dict) -> dict
    let r = {}
    for k in keys(data)
        r[k] = data[k]
    r["_links"] = {}
    r

// Add a link: resource["_links"][rel] = {"href": href}. Fluent.
fn hal_link(resource: dict, rel: string, href: string) -> dict
    resource["_links"][rel] = {"href": href}
    resource

// The conventional self link.
fn hal_self(resource: dict, href: string) -> dict
    hal_link(resource, "self", href)
