// forge_lru -- a bounded LRU cache (evict the Least-Recently-Used entry when full). The cache abstraction
// WITH an eviction policy (Caffeine / Guava LRU) -- forge_cache is unbounded; this bounds memory. A dict for
// values + an access-order list (most-recent last). LEAF. (Wrap in an actor for cross-task/N>1 sharing.)

fn lru_new(capacity: int) -> dict
    let c = {}
    c["cap"] = capacity
    c["data"] = {}
    c["order"] = []
    c

// Move `key` to most-recently-used (rebuild order without it, then append).
fn _lru_touch(cache: dict, key: string)
    let order = cache["order"]
    let no = []
    for i in 0..len(order)
        if order[i] != key
            push(no, order[i])
    push(no, key)
    cache["order"] = no

fn lru_put(cache: dict, key: string, value) -> dict
    let data = cache["data"]
    data[key] = value
    _lru_touch(cache, key)
    let order = cache["order"]
    if len(order) > cache["cap"]
        let evict = order[0]
        let nd = {}
        for k in keys(data)
            if k != evict
                nd[k] = data[k]
        cache["data"] = nd
        let no = [order[i] for i in 1..len(order)]
        cache["order"] = no
    cache

fn lru_get(cache: dict, key: string) -> any
    let data = cache["data"]
    if key in data
        _lru_touch(cache, key)
        return data[key]
    ""

fn lru_has(cache: dict, key: string) -> bool
    contains(cache["data"], key)
