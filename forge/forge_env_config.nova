// forge_env_config — environment-aware config with Result API.

fn env_new(environment: string) -> dict
    let e = {}
    e["env"] = environment
    e["values"] = {}
    e["count"] = 0
    e

fn env_set(e: dict, key: string, value: string) -> dict
    let ek = e["env"] + "_" + key
    e["values"][ek] = value
    e["count"] = e["count"] + 1
    e

fn env_get(e: dict, key: string) -> Result
    let ek = e["env"] + "_" + key
    let has = contains(e["values"], ek)
    if has == true
        return ok(e["values"][ek])
    err("key not found in " + e["env"] + ": " + key)

fn env_get_or(e: dict, key: string, fallback: string) -> string
    let ek = e["env"] + "_" + key
    let has = contains(e["values"], ek)
    if has == true
        return e["values"][ek]
    fallback

fn env_environment(e: dict) -> string
    e["env"]

fn env_count(e: dict) -> int
    e["count"]

fn env_is_production(e: dict) -> int
    if e["env"] == "production"
        return 1
    0
