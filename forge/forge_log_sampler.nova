// forge_log_sampler — Sample logs at a configurable rate to reduce volume.

fn ls_new(sample_rate: int) -> dict
    let s = {}
    s["rate"] = sample_rate
    s["counter"] = 0
    s["sampled"] = 0
    s["dropped"] = 0
    s

fn ls_should_log(s: dict) -> dict
    let result = {}
    s["counter"] = s["counter"] + 1
    let mod_val = s["counter"] % s["rate"]
    if mod_val == 0
        s["sampled"] = s["sampled"] + 1
        result["log"] = 1
    else
        s["dropped"] = s["dropped"] + 1
        result["log"] = 0
    result["s"] = s
    result

fn ls_total_events(s: dict) -> int
    s["counter"]

fn ls_total_sampled(s: dict) -> int
    s["sampled"]

fn ls_total_dropped(s: dict) -> int
    s["dropped"]

fn ls_drop_rate(s: dict) -> int
    if s["counter"] == 0
        return 0
    s["dropped"] * 100 / s["counter"]

fn ls_sample_rate(s: dict) -> int
    s["rate"]
