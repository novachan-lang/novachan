// forge_job_scheduler — Cron-like job scheduler with history.
// Register jobs with intervals, track runs, enable/disable.

fn js_new() -> dict
    let js = {}
    js["jobs"] = {}
    js["history"] = []
    js["next_id"] = 1
    js

fn js_add_job(js: dict, name: string, interval_sec: int) -> dict
    let job = {}
    job["id"] = js["next_id"]
    job["name"] = name
    job["interval"] = interval_sec
    job["enabled"] = 1
    job["last_run"] = 0
    job["run_count"] = 0
    js["next_id"] = js["next_id"] + 1
    js["jobs"][name] = job
    js

fn js_disable(js: dict, name: string) -> dict
    let has = contains(js["jobs"], name)
    if has != true
        return js
    js["jobs"][name]["enabled"] = 0
    js

fn js_enable(js: dict, name: string) -> dict
    let has = contains(js["jobs"], name)
    if has != true
        return js
    js["jobs"][name]["enabled"] = 1
    js

fn js_is_due(js: dict, name: string, now: int) -> int
    let has = contains(js["jobs"], name)
    if has != true
        return 0
    let job = js["jobs"][name]
    if job["enabled"] != 1
        return 0
    let elapsed = now - job["last_run"]
    if elapsed >= job["interval"]
        return 1
    0

fn js_mark_run(js: dict, name: string, now: int, status: string) -> dict
    let has = contains(js["jobs"], name)
    if has != true
        return js
    js["jobs"][name]["last_run"] = now
    js["jobs"][name]["run_count"] = js["jobs"][name]["run_count"] + 1
    let entry = {}
    entry["job"] = name
    entry["at"] = now
    entry["status"] = status
    push(js["history"], entry)
    js

fn js_due_jobs(js: dict, now: int) -> list
    let result = []
    let all = keys(js["jobs"])
    let i = 0
    while i < len(all)
        let name = all[i]
        let due = js_is_due(js, name, now)
        if due == 1
            push(result, name)
        i = i + 1
    result

fn js_job_count(js: dict) -> int
    len(keys(js["jobs"]))

fn js_run_count(js: dict, name: string) -> int
    let has = contains(js["jobs"], name)
    if has != true
        return 0
    js["jobs"][name]["run_count"]

fn js_history(js: dict) -> list
    js["history"]
