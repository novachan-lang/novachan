// forge_omap -- an ORDERED map: a key->value store kept sorted by key, with the range/neighbor queries a plain
// hash dict cannot answer. A dict gives you O(1) get/set but NO order: you cannot ask "the largest key <= X",
// "every entry between LO and HI", or "the smallest key". forge_omap does -- it is NOVA's std::map / Java
// TreeMap / Python sortedcontainers. Use it for leaderboards (score->player, ranked scans), time-series
// buckets (timestamp->value, range scans), IP/CIDR or version tables (floor lookup = "which rule covers this"),
// autocomplete over sorted string keys, and any "find nearest key" need.
//
// Representation: a list of [key, value] pairs held sorted by key. get/has/floor/ceiling are O(log n) binary
// search; set/del are O(log n) search + O(n) shift (via the `insert` builtin / a shift-pop). Keys must be
// mutually comparable via `<` -- use ALL-integer or ALL-string keys (NOVA compares ints numerically and
// strings lexicographically; do not mix the two in one map). LEAF -- imports NOTHING.

// PRIVATE: lower_bound -- the first index whose key is >= k (== the insertion point for k). O(log n).
fn _omap_lower(m: list, k) -> int
    let lo = 0
    let hi = len(m)
    while lo < hi
        let mid = (lo + hi) / 2
        if m[mid][0] < k
            lo = mid + 1
        else
            hi = mid
    lo

// PRIVATE: remove the pair at index p, shifting the tail left. O(n).
fn _omap_removeat(m: list, p: int)
    for i in p..(len(m) - 1)
        m[i] = m[i + 1]
    pop(m)

// A new empty ordered map.
fn omap_new() -> list
    []

// Number of entries.
fn omap_len(m: list) -> int
    len(m)

// Insert or update key -> value, keeping the map sorted. O(log n) search + O(n) shift.
fn omap_set(m: list, k, v)
    let i = _omap_lower(m, k)
    if i < len(m) and m[i][0] == k
        m[i] = [k, v]
    else
        insert(m, i, [k, v])

// The value for key k, or null if absent. O(log n).
fn omap_get(m: list, k)
    let i = _omap_lower(m, k)
    let out = m[i][1] if (i < len(m) and m[i][0] == k) else null
    out

// True if key k is present. O(log n).
fn omap_has(m: list, k) -> bool
    let i = _omap_lower(m, k)
    i < len(m) and m[i][0] == k

// Remove key k; returns true if it was present. O(log n) + O(n) shift.
fn omap_del(m: list, k) -> bool
    let i = _omap_lower(m, k)
    if i < len(m) and m[i][0] == k
        _omap_removeat(m, i)
        return true
    false

// The [key, value] pair with the LARGEST key <= k, or null if none. O(log n).
fn omap_floor(m: list, k)
    let i = _omap_lower(m, k)
    let out = null
    if i < len(m) and m[i][0] == k
        out = m[i]
    else if i > 0
        out = m[i - 1]
    out

// The [key, value] pair with the SMALLEST key >= k, or null if none. O(log n).
fn omap_ceiling(m: list, k)
    let i = _omap_lower(m, k)
    let out = m[i] if i < len(m) else null
    out

// The [key, value] pair with the smallest key, or null if empty. O(1).
fn omap_min(m: list)
    let out = m[0] if len(m) > 0 else null
    out

// The [key, value] pair with the largest key, or null if empty. O(1).
fn omap_max(m: list)
    let out = m[len(m) - 1] if len(m) > 0 else null
    out

// All keys in ascending order. O(n).
fn omap_keys(m: list) -> list
    [m[i][0] for i in 0..len(m)]

// All values in key-ascending order. O(n).
fn omap_values(m: list) -> list
    [m[i][1] for i in 0..len(m)]

// All [key, value] pairs whose key is in [lo, hi] inclusive, in ascending order. O(log n + result).
fn omap_range(m: list, lo, hi) -> list
    let out = []
    let i = _omap_lower(m, lo)
    while i < len(m) and m[i][0] <= hi
        push(out, m[i])
        i += 1
    out
