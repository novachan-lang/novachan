// forge_request_tracer — HTTP request tracing with timing and Result API.

fn rt_new() -> dict
    let r = {}
    r["trace_count"] = 0
    r["total_duration"] = 0
    r

fn rt_trace(r: dict, method: string, path: string, status: int, duration_ms: int) -> dict
    let idx = r["trace_count"]
    r["tr_" + str(idx) + "_method"] = method
    r["tr_" + str(idx) + "_path"] = path
    r["tr_" + str(idx) + "_status"] = status
    r["tr_" + str(idx) + "_dur"] = duration_ms
    r["trace_count"] = idx + 1
    r["total_duration"] = r["total_duration"] + duration_ms
    r

fn rt_get_method(r: dict, index: int) -> Result
    if index < 0 or index >= r["trace_count"]
        return err("trace index out of range")
    ok(r["tr_" + str(index) + "_method"])

fn rt_get_path(r: dict, index: int) -> Result
    if index < 0 or index >= r["trace_count"]
        return err("trace index out of range")
    ok(r["tr_" + str(index) + "_path"])

fn rt_get_status(r: dict, index: int) -> Result
    if index < 0 or index >= r["trace_count"]
        return err("trace index out of range")
    ok(r["tr_" + str(index) + "_status"])

fn rt_get_duration(r: dict, index: int) -> Result
    if index < 0 or index >= r["trace_count"]
        return err("trace index out of range")
    ok(r["tr_" + str(index) + "_dur"])

fn rt_avg_duration(r: dict) -> Result
    if r["trace_count"] == 0
        return err("no traces")
    ok(r["total_duration"] / r["trace_count"])

fn rt_trace_count(r: dict) -> int
    r["trace_count"]

fn rt_total_duration(r: dict) -> int
    r["total_duration"]
