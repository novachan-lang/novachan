// forge_markdown_parser — Simple markdown to structure with Result.

fn md_new() -> dict
    {"blocks": {}, "block_count": 0}

fn md_add_heading(m: dict, level: int, text: string) -> dict
    let k = str(m["block_count"])
    m["blocks"]["{k}_type"] = "heading"
    m["blocks"]["{k}_level"] = level
    m["blocks"]["{k}_text"] = text
    m["block_count"] += 1
    m

fn md_add_paragraph(m: dict, text: string) -> dict
    let k = str(m["block_count"])
    m["blocks"]["{k}_type"] = "paragraph"
    m["blocks"]["{k}_text"] = text
    m["block_count"] += 1
    m

fn md_add_code(m: dict, lang: string, code: string) -> dict
    let k = str(m["block_count"])
    m["blocks"]["{k}_type"] = "code"
    m["blocks"]["{k}_lang"] = lang
    m["blocks"]["{k}_text"] = code
    m["block_count"] += 1
    m

fn md_block_type(m: dict, idx: int) -> Result
    if idx >= m["block_count"]
        return err("index out of range")
    ok(m["blocks"]["{idx}_type"])

fn md_block_text(m: dict, idx: int) -> Result
    if idx >= m["block_count"]
        return err("index out of range")
    ok(m["blocks"]["{idx}_text"])

fn md_block_count(m: dict) -> int
    m["block_count"]

fn md_heading_count(m: dict) -> int
    let c = 0
    for i in 0..m["block_count"]
        if m["blocks"]["{i}_type"] == "heading"
            c += 1
    c
