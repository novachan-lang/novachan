// forge_unit_converter — unit conversion with Result API.

fn uc_new() -> dict
    let u = {}
    u["conversions"] = {}
    u["conv_count"] = 0
    u["total_conversions"] = 0
    u

fn uc_add_conversion(u: dict, from: string, to: string, factor: int) -> dict
    let key = "cv_" + from + "_" + to
    u["conversions"][key] = factor
    u["conv_count"] = u["conv_count"] + 1
    u

fn uc_convert(u: dict, value: int, from: string, to: string) -> Result
    if from == to
        return ok(value)
    let key = "cv_" + from + "_" + to
    let has = contains(u["conversions"], key)
    if has == true
        u["total_conversions"] = u["total_conversions"] + 1
        return ok(value * u["conversions"][key])
    err("no conversion: " + from + " -> " + to)

fn uc_has_conversion(u: dict, from: string, to: string) -> int
    if from == to
        return 1
    let key = "cv_" + from + "_" + to
    let has = contains(u["conversions"], key)
    if has == true
        return 1
    0

fn uc_conversion_count(u: dict) -> int
    u["conv_count"]

fn uc_total_conversions(u: dict) -> int
    u["total_conversions"]
