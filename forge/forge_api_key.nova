// forge_api_key — API key management.
// Issue, validate, revoke, scope-check, rate-limit tracking.

fn ak_new() -> dict
    let ak = {}
    ak["keys"] = {}
    ak["next_id"] = 1
    ak["revoked"] = []
    ak

fn ak_issue(ak: dict, owner: string, scopes: list) -> dict
    let id = ak["next_id"]
    ak["next_id"] = id + 1
    let prefix = "nova_"
    let key_str = prefix + str(id * 1000 + 42)
    let entry = {}
    entry["id"] = id
    entry["owner"] = owner
    entry["key"] = key_str
    entry["scopes"] = scopes
    entry["active"] = 1
    entry["uses"] = 0
    ak["keys"][key_str] = entry
    let r = {}
    r["ak"] = ak
    r["key"] = key_str
    r

fn ak_validate(ak: dict, key: string) -> int
    let has = contains(ak["keys"], key)
    if has != true
        return 0
    let entry = ak["keys"][key]
    if entry["active"] != 1
        return 0
    1

fn ak_revoke(ak: dict, key: string) -> dict
    let has = contains(ak["keys"], key)
    if has != true
        return ak
    ak["keys"][key]["active"] = 0
    push(ak["revoked"], key)
    ak

fn ak_has_scope(ak: dict, key: string, scope: string) -> int
    let has = contains(ak["keys"], key)
    if has != true
        return 0
    if ak["keys"][key]["active"] != 1
        return 0
    let scopes = ak["keys"][key]["scopes"]
    for i in 0..len(scopes)
        if scopes[i] == scope
            return 1
        if scopes[i] == "*"
            return 1
    0

fn ak_record_use(ak: dict, key: string) -> dict
    let has = contains(ak["keys"], key)
    if has != true
        return ak
    ak["keys"][key]["uses"] = ak["keys"][key]["uses"] + 1
    ak

fn ak_usage(ak: dict, key: string) -> int
    let has = contains(ak["keys"], key)
    if has != true
        return 0
    ak["keys"][key]["uses"]

fn ak_owner(ak: dict, key: string) -> string
    let has = contains(ak["keys"], key)
    if has != true
        return ""
    ak["keys"][key]["owner"]

fn ak_key_count(ak: dict) -> int
    len(keys(ak["keys"]))

fn ak_active_count(ak: dict) -> int
    let count = 0
    let all = keys(ak["keys"])
    for i in 0..len(all)
        let k = all[i]
        if ak["keys"][k]["active"] == 1
            count += 1
    count

fn ak_revoked_count(ak: dict) -> int
    len(ak["revoked"])
