// forge_api_key -- API key management: issue, validate, revoke, scope-check, and usage tracking.
// Keys are deterministic ("nova_" + id*1000+42) so tests are reproducible. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. ak_new / ak_issue built dicts as 5-7 individual assignments. Dict literals.
//   2. `contains(ak["keys"], key); if has != true` at SIX sites -- `not in`.
//   3. ak_has_scope iterated scopes with `for i in 0..len(scopes); if scopes[i] == scope` -- that
//      is `scope in scopes` (and `"*" in scopes` for the wildcard).
//   4. ak_record_use: `ak["keys"][key]["uses"] = ... + 1` -- compound assignment.
//   5. ak_active_count used an index loop + manual counter -- a comprehension.

fn ak_new() -> dict
    {"keys": {}, "next_id": 1, "revoked": []}

fn ak_issue(ak: dict, owner: string, scopes: list) -> dict
    let id = ak["next_id"]
    ak["next_id"] = id + 1
    let key_str = "nova_{id * 1000 + 42}"
    ak["keys"][key_str] = {"id": id, "owner": owner, "key": key_str, "scopes": scopes, "active": 1, "uses": 0}
    {"ak": ak, "key": key_str}

fn ak_validate(ak: dict, key: string) -> int
    if key not in ak["keys"]
        return 0
    if ak["keys"][key]["active"] != 1
        return 0
    1

fn ak_revoke(ak: dict, key: string) -> dict
    if key not in ak["keys"]
        return ak
    ak["keys"][key]["active"] = 0
    push(ak["revoked"], key)
    ak

fn ak_has_scope(ak: dict, key: string, scope: string) -> int
    if key not in ak["keys"]
        return 0
    if ak["keys"][key]["active"] != 1
        return 0
    let scopes = ak["keys"][key]["scopes"]
    1 if scope in scopes or "*" in scopes else 0

fn ak_record_use(ak: dict, key: string) -> dict
    if key not in ak["keys"]
        return ak
    ak["keys"][key]["uses"] += 1
    ak

fn ak_usage(ak: dict, key: string) -> int
    if key not in ak["keys"]
        return 0
    ak["keys"][key]["uses"]

fn ak_owner(ak: dict, key: string) -> string
    if key not in ak["keys"]
        return ""
    ak["keys"][key]["owner"]

fn ak_key_count(ak: dict) -> int
    len(keys(ak["keys"]))

fn ak_active_count(ak: dict) -> int
    len([k for k in keys(ak["keys"]) if ak["keys"][k]["active"] == 1])

fn ak_revoked_count(ak: dict) -> int
    len(ak["revoked"])
