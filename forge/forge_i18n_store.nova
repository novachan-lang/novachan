// forge_i18n_store — Internationalization key store with Result.

fn i18n_new(default_locale: string) -> dict
    {"strings": {}, "default": default_locale, "count": 0, "misses": 0}

fn i18n_set(i: dict, locale: string, key: string, value: string) -> dict
    i["strings"][locale + ":" + key] = value
    i["count"] += 1
    i

fn i18n_get(i: dict, locale: string, key: string) -> Result
    let primary = locale + ":" + key
    if primary in i["strings"]
        return ok(i["strings"][primary])
    let fallback = i["default"] + ":" + key
    if fallback in i["strings"]
        return ok(i["strings"][fallback])
    i["misses"] += 1
    err("missing key: " + key)

fn i18n_has(i: dict, locale: string, key: string) -> int
    let k = locale + ":" + key
    1 if k in i["strings"] else 0

fn i18n_count(i: dict) -> int
    i["count"]

fn i18n_miss_count(i: dict) -> int
    i["misses"]
