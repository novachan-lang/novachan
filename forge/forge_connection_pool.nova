// forge_connection_pool — generic connection pool with Result API.

fn cp_new(max_size: int) -> dict
    {"max": max_size, "conns": {}, "available": 0, "in_use": 0, "total_created": 0, "total_borrowed": 0}

fn cp_add(p: dict, conn_id: string) -> Result
    if p["available"] + p["in_use"] >= p["max"]
        return err("pool full")
    let key = "c_{conn_id}"
    p["conns"][key] = "available"
    p["available"] += 1
    p["total_created"] += 1
    ok(p)

fn cp_borrow(p: dict) -> Result
    if p["available"] == 0
        return err("no available connections")
    let found = ""
    let keys = keys(p["conns"])
    let i = 0
    while i < len(keys)
        let k = keys[i]
        if p["conns"][k] == "available"
            found = k
            i = len(keys)
        i += 1
    if found == ""
        return err("no available connections")
    p["conns"][found] = "in_use"
    p["available"] -= 1
    p["in_use"] += 1
    p["total_borrowed"] += 1
    ok(found)

fn cp_release(p: dict, conn_key: string) -> Result
    if conn_key not in p["conns"]
        return err("unknown connection")
    if p["conns"][conn_key] != "in_use"
        return err("connection not in use")
    p["conns"][conn_key] = "available"
    p["in_use"] -= 1
    p["available"] += 1
    ok(p)

fn cp_remove(p: dict, conn_key: string) -> Result
    if conn_key not in p["conns"]
        return err("unknown connection")
    let was = p["conns"][conn_key]
    p["conns"][conn_key] = "removed"
    if was == "available"
        p["available"] -= 1
    else
        p["in_use"] -= 1
    ok(p)

fn cp_available(p: dict) -> int
    p["available"]

fn cp_in_use(p: dict) -> int
    p["in_use"]

fn cp_total_created(p: dict) -> int
    p["total_created"]

fn cp_total_borrowed(p: dict) -> int
    p["total_borrowed"]

fn cp_utilization(p: dict) -> int
    let total = p["available"] + p["in_use"]
    if total == 0
        return 0
    p["in_use"] * 100 / total
