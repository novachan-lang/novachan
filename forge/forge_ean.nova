// forge_ean -- EAN-13 / UPC-A / EAN-8 barcode check-digit validation + generation (GS1 retail product codes).
// The check digit is a mod-10 weighted sum where digits alternate weight 3 and 1 from the right of the body.
// Validate a scanned code or compute the check digit to print one. LEAF -- imports NOTHING.

// PRIVATE: GS1 check digit for a digit `body` (WITHOUT the check digit). The rightmost body digit has weight
// 3, alternating 3,1,3,1 leftward. Returns 0..9, or -1 if `body` contains a non-digit.
fn _ean_check(body: string) -> int
    let sum = 0
    let n = len(body)
    let i = 0
    while i < n
        let d = find("0123456789", char_at(body, n - 1 - i))
        if d < 0
            return -1
        if i % 2 == 0
            sum = sum + d * 3
        else
            sum = sum + d
        i = i + 1
    let m = sum % 10
    if m == 0
        return 0
    10 - m

// The check digit for a body (EAN-13 body=12, UPC-A=11, EAN-8=7 digits). -1 if the body has a non-digit.
fn ean_check_digit(body: string) -> int
    _ean_check(body)

// Validate a FULL code (body + trailing check digit): length 8, 12, or 13 and the check digit matches.
fn ean_valid(code: string) -> bool
    let n = len(code)
    if n != 8 and n != 12 and n != 13
        return false
    let want = _ean_check(slice(code, 0, n - 1))
    if want < 0
        return false
    let last = find("0123456789", char_at(code, n - 1))
    if last < 0
        return false
    want == last

// Append the correct check digit to a body -> the full code ("" if the body has a non-digit).
fn ean_complete(body: string) -> string
    let c = _ean_check(body)
    if c < 0
        return ""
    body + str(c)
