// forge_compensator — Saga compensation (undo steps on failure).

fn comp_new() -> dict
    {"steps": {}, "step_count": 0, "completed": 0, "compensated": 0, "status": "pending"}

fn comp_add_step(c: dict, name: string, action: string, undo: string) -> dict
    let k = str(c["step_count"])
    c["steps"]["{k}_name"] = name
    c["steps"]["{k}_action"] = action
    c["steps"]["{k}_undo"] = undo
    c["steps"]["{k}_done"] = 0
    c["steps"]["{k}_undone"] = 0
    c["step_count"] += 1
    c

fn comp_complete_step(c: dict, idx: int) -> dict
    if idx >= c["step_count"]
        return c
    c["steps"]["{idx}_done"] = 1
    c["completed"] += 1
    c

fn comp_fail_at(c: dict, idx: int) -> dict
    c["status"] = "compensating"
    let i = idx - 1
    while i >= 0
        let k = str(i)
        if c["steps"]["{k}_done"] == 1
            c["steps"]["{k}_undone"] = 1
            c["compensated"] += 1
        i -= 1
    c["status"] = "compensated"
    c

fn comp_step_name(c: dict, idx: int) -> string
    c["steps"]["{idx}_name"]

fn comp_step_undo(c: dict, idx: int) -> string
    c["steps"]["{idx}_undo"]

fn comp_is_undone(c: dict, idx: int) -> int
    c["steps"]["{idx}_undone"]

fn comp_status(c: dict) -> string
    c["status"]

fn comp_completed_count(c: dict) -> int
    c["completed"]

fn comp_compensated_count(c: dict) -> int
    c["compensated"]
