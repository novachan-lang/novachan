// forge_duration -- humanize durations + relative time (Rails distance_of_time_in_words / moment fromNow).
// humanize_ms(90500) -> "1m 30s"; time_ago(7200) -> "2 hours ago". For UIs + logs. LEAF -- imports NOTHING.

fn humanize_ms(ms: int) -> string
    let secs = ms / 1000
    let h = secs / 3600
    let m = (secs % 3600) / 60
    let s = secs % 60
    let out = ""
    if h > 0
        out += "{h}h "
    if m > 0
        out += "{m}m "
    out + "{s}s"

// Relative time from a seconds-ago count: "just now" / "N minutes ago" / "N hours ago" / "N days ago".
fn time_ago(seconds_ago: int) -> string
    if seconds_ago < 60
        return "just now"
    if seconds_ago < 3600
        return "{seconds_ago / 60} minutes ago"
    if seconds_ago < 86400
        return "{seconds_ago / 3600} hours ago"
    "{seconds_ago / 86400} days ago"
