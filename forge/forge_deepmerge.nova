// forge_deepmerge -- recursive dict merging + dotted-path get/set/has for LAYERED configuration. This is the
// property-source layering that every serious framework needs: Spring stacks application.yml < profile <
// env < CLI; Rails uses Hash#deep_merge for nested config; lodash exposes merge/get/set. NOVA gets all of it
// as four pure functions over its native dict. deep_merge is the layering primitive (nested overrides win at
// the leaf, structure is preserved); deep_get/deep_set/deep_has are the dotted-path accessors ("server.http.
// port") so callers never hand-walk nested dicts. LEAF -- imports NOTHING (built-ins only: keys, contains,
// split, len, type_of, str).

// Deeply merge `override` onto `base` -> a NEW dict; neither input is mutated. Rule per key in the union:
// if BOTH sides hold a dict, recurse (structure merges, not replaces); otherwise override wins, and a key
// present on only one side is taken as-is. This is what separates deep_merge from a shallow overlay -- a
// profile that sets only server.http.port keeps server.http.host from the base layer instead of dropping it.
fn deep_merge(base: dict, override: dict) -> dict
    let out = {}
    for k in keys(base)
        if contains(override, k) and type_of(base[k]) == "dict" and type_of(override[k]) == "dict"
            out[k] = deep_merge(base[k], override[k])
        else
            if contains(override, k)
                out[k] = override[k]
            else
                out[k] = base[k]
    for k in keys(override)
        if contains(base, k) == false
            out[k] = override[k]
    out

// Resolve a dotted path against `d` -> the node found, or "" if any segment is missing / a non-dict is hit
// mid-walk. An empty path returns `d` itself (the whole document). Return type is `any`: a resolved node may
// be a dict, list, string, int, etc. -- e.g. deep_get(cfg, "server.http.port") -> 8080.
fn deep_get(d: dict, path: string) -> any
    if len(path) == 0
        return d
    let node = d
    let segs = split(path, ".")
    for seg in segs
        if type_of(node) == "dict" and contains(node, seg)
            node = node[seg]
        else
            return ""
    node

// True iff the dotted path resolves to an existing key. Same walk as deep_get, but distinguishes "the key is
// absent" from "the key holds the empty string" (which deep_get cannot). An empty path -> true (the doc).
fn deep_has(d: dict, path: string) -> bool
    if len(path) == 0
        return true
    let node = d
    let segs = split(path, ".")
    for seg in segs
        if type_of(node) == "dict" and contains(node, seg)
            node = node[seg]
        else
            return false
    true

// Set `value` at a dotted path, creating intermediate dicts as needed, and return `d` (mutated in place --
// this is the builder half of the pair). deep_set(cfg, "a.b.c", 5) makes cfg["a"]["b"]["c"] = 5, creating a
// and b as dicts if absent. If an intermediate exists but is NOT a dict, it is overwritten with a fresh dict
// (the path wins over a stale scalar). Descent relies on NOVA dicts being reference values: reassigning `cur`
// to a nested dict and mutating it writes through into `d`.
fn deep_set(d: dict, path: string, value) -> dict
    let segs = split(path, ".")
    let n = len(segs)
    if n == 0
        return d
    let cur = d
    let i = 0
    while i < n - 1
        let seg = segs[i]
        if contains(cur, seg) == false or type_of(cur[seg]) != "dict"
            let fresh = {}
            cur[seg] = fresh
        cur = cur[seg]
        i = i + 1
    cur[segs[n - 1]] = value
    d
