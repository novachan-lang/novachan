// forge_replication_log — Append-only log replication across nodes, with commit tracking.

fn rl_new() -> dict
    let r = {}
    r["total_entries"] = 0
    r["committed_count"] = 0
    r["committed_index"] = -1
    r

fn rl_append(r: dict, entry: string, term: int) -> dict
    let idx = r["total_entries"]
    r["e_" + str(idx) + "_entry"] = entry
    r["e_" + str(idx) + "_term"] = term
    r["total_entries"] = idx + 1
    r

fn rl_get(r: dict, index: int) -> Result
    if index < 0 or index >= r["total_entries"]
        return err("index out of range")
    ok(r["e_" + str(index) + "_entry"])

fn rl_term_at(r: dict, index: int) -> Result
    if index < 0 or index >= r["total_entries"]
        return err("index out of range")
    ok(r["e_" + str(index) + "_term"])

fn rl_commit(r: dict, index: int) -> Result
    if index < 0 or index >= r["total_entries"]
        return err("index out of range")
    if index + 1 <= r["committed_count"]
        return err("already committed")
    r["committed_count"] = index + 1
    r["committed_index"] = index
    ok(r)

fn rl_committed_count(r: dict) -> int
    r["committed_count"]

fn rl_total_entries(r: dict) -> int
    r["total_entries"]

fn rl_last_term(r: dict) -> Result
    if r["total_entries"] == 0
        return err("log empty")
    ok(r["e_" + str(r["total_entries"] - 1) + "_term"])
