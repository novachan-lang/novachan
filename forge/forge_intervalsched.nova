// forge_intervalsched -- pick the best set of non-overlapping intervals. Two classic scheduling problems: the
// unweighted case (fit the MOST jobs/meetings/reservations into one resource without overlap -- the greedy
// "activity selection") and the WEIGHTED case (each interval has a value, maximize the total value of a
// non-overlapping selection -- e.g. bookings that pay different amounts, ad slots, machine jobs with profits).
// This is everyday resource allocation: room/CPU/equipment booking, ad placement, event scheduling, and any
// "which non-conflicting subset is best". The weighted version is the textbook DP (sort by end time, and for
// each interval either skip it or take it plus the best compatible earlier solution). forge_interval handles
// merge/overlap of ranges; this OPTIMIZES a selection. Intervals are [start, end] or [start, end, weight] with
// integer bounds. LEAF -- imports NOTHING.

// The maximum NUMBER of mutually non-overlapping intervals (greedy activity selection: repeatedly take the one
// that ends earliest). Intervals are [start, end]; touching (end == next start) is allowed.
fn max_nonoverlapping(intervals: list) -> int
    let n = len(intervals)
    let out = 0
    if n > 0
        // sort a copy of end/start by end ascending (parallel scalar arrays)
        let starts = []
        let ends = []
        for i in 0..n
            push(starts, intervals[i][0])
            push(ends, intervals[i][1])
        let a = 1
        while a < n
            let cs = starts[a]
            let ce = ends[a]
            let b = a - 1
            while b >= 0 and ends[b] > ce
                starts[b + 1] = starts[b]
                ends[b + 1] = ends[b]
                b -= 1
            starts[b + 1] = cs
            ends[b + 1] = ce
            a += 1
        // greedy pick
        let count = 0
        let last_end = 0 - 1000000000
        for k in 0..n
            if starts[k] >= last_end
                count += 1
                last_end = ends[k]
        out = count
    out

// The maximum total WEIGHT of a non-overlapping selection. Intervals are [start, end, weight]. Weighted-interval
// -scheduling DP: sort by end, then for each interval take max(skip it, weight + best solution ending before it).
fn max_weight_schedule(intervals: list) -> int
    let n = len(intervals)
    let out = 0
    if n > 0
        let starts = []
        let ends = []
        let weights = []
        for i in 0..n
            push(starts, intervals[i][0])
            push(ends, intervals[i][1])
            push(weights, intervals[i][2])
        // sort all three by end ascending
        for a in 1..n
            let cs = starts[a]
            let ce = ends[a]
            let cw = weights[a]
            let b = a - 1
            while b >= 0 and ends[b] > ce
                starts[b + 1] = starts[b]
                ends[b + 1] = ends[b]
                weights[b + 1] = weights[b]
                b -= 1
            starts[b + 1] = cs
            ends[b + 1] = ce
            weights[b + 1] = cw
        // dp[m] = best total weight using sorted intervals 0..m
        let dp = [0 for z in 0..n]
        for m in 0..n
            let incl = weights[m]
            // last interval that ends at or before this one's start
            let p = m - 1
            while p >= 0 and ends[p] > starts[m]
                p -= 1
            if p >= 0
                incl += dp[p]
            let excl = 0
            if m > 0
                excl = dp[m - 1]
            if incl > excl
                dp[m] = incl
            else
                dp[m] = excl
        out = dp[n - 1]
    out
