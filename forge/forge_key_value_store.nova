// forge_key_value_store — Simple KV store with TTL and stats.

fn kv_new() -> dict
    {"data": {}, "ttls": {}, "gets": 0, "sets": 0, "hits": 0, "misses": 0}

fn kv_set(k: dict, key: string, value: string, ttl: int) -> dict
    k["data"][key] = value
    k["ttls"][key] = ttl
    k["sets"] += 1
    k

fn kv_get(k: dict, key: string, now: int) -> dict
    k["gets"] += 1
    if key not in k["data"]
        k["misses"] += 1
        return {"found": 0, "value": "", "k": k}
    let ttl = k["ttls"][key]
    if ttl > 0
        if now > ttl
            k["misses"] += 1
            return {"found": 0, "value": "", "k": k}
    k["hits"] += 1
    {"found": 1, "value": k["data"][key], "k": k}

fn kv_delete(k: dict, key: string) -> dict
    if key in k["data"]
        k["data"][key] = ""
        k["ttls"][key] = -1
    k

fn kv_size(k: dict) -> int
    len(keys(k["data"]))

fn kv_hit_rate(k: dict) -> int
    0 if k["gets"] == 0 else k["hits"] * 100 / k["gets"]

fn kv_total_sets(k: dict) -> int
    k["sets"]

fn kv_total_gets(k: dict) -> int
    k["gets"]
