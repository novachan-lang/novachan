// forge_key_value_store — Simple KV store with TTL and stats.

fn kv_new() -> dict
    let k = {}
    k["data"] = {}
    k["ttls"] = {}
    k["gets"] = 0
    k["sets"] = 0
    k["hits"] = 0
    k["misses"] = 0
    k

fn kv_set(k: dict, key: string, value: string, ttl: int) -> dict
    k["data"][key] = value
    k["ttls"][key] = ttl
    k["sets"] = k["sets"] + 1
    k

fn kv_get(k: dict, key: string, now: int) -> dict
    let result = {}
    k["gets"] = k["gets"] + 1
    let has = contains(k["data"], key)
    if has != true
        k["misses"] = k["misses"] + 1
        result["found"] = 0
        result["value"] = ""
        result["k"] = k
        return result
    let ttl = k["ttls"][key]
    if ttl > 0
        if now > ttl
            k["misses"] = k["misses"] + 1
            result["found"] = 0
            result["value"] = ""
            result["k"] = k
            return result
    k["hits"] = k["hits"] + 1
    result["found"] = 1
    result["value"] = k["data"][key]
    result["k"] = k
    result

fn kv_delete(k: dict, key: string) -> dict
    let has = contains(k["data"], key)
    if has == true
        k["data"][key] = ""
        k["ttls"][key] = -1
    k

fn kv_size(k: dict) -> int
    len(keys(k["data"]))

fn kv_hit_rate(k: dict) -> int
    if k["gets"] == 0
        return 0
    k["hits"] * 100 / k["gets"]

fn kv_total_sets(k: dict) -> int
    k["sets"]

fn kv_total_gets(k: dict) -> int
    k["gets"]
