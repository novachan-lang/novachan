// forge_align -- thin wrapper over std/bio/align (canonical implementation).
import std/bio/align

fn _sub_score(a: string, b: string, i: int, j: int, sc: Scoring) -> int
    sc.matchv if char_at(a, i - 1) == char_at(b, j - 1) else sc.mismatch

// PRIVATE: the flat-table index of cell (i, j) in a table of row width w. Open-coded at ten sites,
// where one mistyped index reads a neighbouring cell and yields a plausible wrong alignment.

fn _at(i: int, j: int, w: int) -> int
    i * w + j

// PRIVATE: the filled score table (flat, row width m+1). dp[_at(i,j,w)] is the best score aligning
// a[0:i] with b[0:j].

fn _al_fill(a: string, b: string, sc: Scoring) -> list
    let n = len(a)
    let m = len(b)
    let w = m + 1
    let dp = [0 for z in 0..((n + 1) * w)]
    // Row 0 and column 0 are pure gaps -- i or j gap penalties. Comprehension-style init over a
    // range, rather than two hand-written while loops with their own counters.
    for i in 1..(n + 1)
        dp[_at(i, 0, w)] = i * sc.gap
    for j in 1..(m + 1)
        dp[_at(0, j, w)] = j * sc.gap
    // The recurrence. Both loops STAY loops: every cell depends on three already-computed neighbours,
    // so this is a fold over a 2-D lattice, not a per-element map.
    for i in 1..(n + 1)
        for j in 1..(m + 1)
            let diag = dp[_at(i - 1, j - 1, w)] + _sub_score(a, b, i, j, sc)
            let up = dp[_at(i - 1, j, w)] + sc.gap
            let left = dp[_at(i, j - 1, w)] + sc.gap
            dp[_at(i, j, w)] = max(max(diag, up), left)
    dp

// Globally align a and b under `sc`. Returns [score, aligned_a, aligned_b], where the aligned strings
// have equal length and "-" marks a gap.

fn _col_mark(x: string, y: string) -> string
    if x == "-" or y == "-"
        return " "
    "|" if x == y else "."

// How many columns are matches / mismatches / gaps. A caller judging alignment quality had to walk the
// two strings itself.

fn align_default_scoring() -> Scoring
    Scoring(1, 0 - 1, 0 - 1)

// PRIVATE: the substitution score for aligning a[i-1] against b[j-1] -- match or mismatch.
// THE rule, stated once: the fill and the traceback must agree on it or the traceback reconstructs a
// path the table never took.

fn align_with(a: string, b: string, sc: Scoring) -> list
    let n = len(a)
    let m = len(b)
    let w = m + 1
    let dp = _al_fill(a, b, sc)
    // Traceback from (n, m). Columns are PUSHED and reversed once at the end; the old version
    // prepended to two strings, reallocating both per column.
    let acols = []
    let bcols = []
    let i = n
    let j = m
    // STAYS a while: each step moves diagonally, up, or left depending on which predecessor produced
    // this cell's score, so the step is data-dependent.
    while i > 0 or j > 0
        if i > 0 and j > 0 and dp[_at(i, j, w)] == dp[_at(i - 1, j - 1, w)] + _sub_score(a, b, i, j, sc)
            push(acols, char_at(a, i - 1))
            push(bcols, char_at(b, j - 1))
            i -= 1
            j -= 1
        else if i > 0 and dp[_at(i, j, w)] == dp[_at(i - 1, j, w)] + sc.gap
            push(acols, char_at(a, i - 1))
            push(bcols, "-")
            i -= 1
        else
            push(acols, "-")
            push(bcols, char_at(b, j - 1))
            j -= 1
    [dp[_at(n, m, w)], join(reverse(acols), ""), join(reverse(bcols), "")]

// Loose-int entry point, contract UNCHANGED.

fn align_global(a: string, b: string, matchv: int, mismatch: int, gap: int) -> list
    return nw_global(a, b, matchv, mismatch, gap)

fn align_score_with(a: string, b: string, sc: Scoring) -> int
    _al_fill(a, b, sc)[_at(len(a), len(b), len(b) + 1)]

fn align_score(a: string, b: string, matchv: int, mismatch: int, gap: int) -> int
    return nw_score(a, b, matchv, mismatch, gap)

fn align_ruler(aligned_a: string, aligned_b: string) -> string
    join([_col_mark(char_at(aligned_a, i), char_at(aligned_b, i)) for i in 0..len(aligned_a)], "")

fn align_stats(aligned_a: string, aligned_b: string) -> dict
    // SELF-REVIEW FIX: the first version filtered `marks` three times, one pass per category. A tally
    // over the marks is exactly `frequencies`, which walks them once -- and it is the same function
    // this campaign has been substituting for hand-rolled counting everywhere else, so writing three
    // filters here would have been the pattern I keep removing.
    let marks = [_col_mark(char_at(aligned_a, i), char_at(aligned_b, i)) for i in 0..len(aligned_a)]
    let tally = frequencies(marks)
    {"matches": get(tally, "|", 0),
     "mismatches": get(tally, ".", 0),
     "gaps": get(tally, " ", 0),
     "columns": len(marks)}

// Percent identity: matching columns over total columns, 0-100 truncated. The number a biologist or a
// diff tool actually reports, and the reason percent identity is not just "score" -- the score mixes
// in gap penalties.

fn align_identity_pct(aligned_a: string, aligned_b: string) -> int
    let st = align_stats(aligned_a, aligned_b)
    0 if st["columns"] == 0 else st["matches"] * 100 / st["columns"]

