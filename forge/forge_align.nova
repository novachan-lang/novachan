// forge_align -- global sequence alignment by the Needleman-Wunsch algorithm. Edit distance (forge levenshtein)
// tells you HOW DIFFERENT two strings are as a single number; alignment tells you HOW they line up -- it produces
// the two strings padded with gap characters so that matching symbols sit in the same column, making every match,
// mismatch, insertion and deletion visible. That's exactly what DNA/protein aligners, file-diff tools, spelling-
// correction explanations, and plagiarism/version comparison need. It's a dynamic program over a scoring scheme
// you choose (reward matches, penalize mismatches and gaps): fill a table of best scores, then trace back from the
// corner to reconstruct the alignment. Positive `matchv`, negative `mismatch` and `gap` are typical (e.g. 1, -1,
// -1). Returns the score and the two gap-padded strings ("-" marks a gap). LEAF -- imports NOTHING.

// PRIVATE: the maximum of three integers.
fn _al_max3(x: int, y: int, z: int) -> int
    let m = x
    if y > m
        m = y
    if z > m
        m = z
    m

// Globally align a and b under the given scores. Returns [score, aligned_a, aligned_b], where the aligned strings
// have equal length and "-" marks a gap. matchv > 0 rewards equal symbols; mismatch and gap are usually negative.
fn align_global(a: string, b: string, matchv: int, mismatch: int, gap: int) -> list
    let n = len(a)
    let m = len(b)
    let w = m + 1
    // dp table (flat), dp[i*w + j] = best score aligning a[0:i] with b[0:j]
    let dp = [0 for z in 0..((n + 1) * w)]
    let i = 1
    while i <= n
        dp[i * w] = i * gap
        i += 1
    let j = 1
    while j <= m
        dp[j] = j * gap
        j += 1
    let ii = 1
    while ii <= n
        let jj = 1
        while jj <= m
            let sub = mismatch
            if char_at(a, ii - 1) == char_at(b, jj - 1)
                sub = matchv
            let diag = dp[(ii - 1) * w + (jj - 1)] + sub
            let up = dp[(ii - 1) * w + jj] + gap
            let left = dp[ii * w + (jj - 1)] + gap
            dp[ii * w + jj] = _al_max3(diag, up, left)
            jj += 1
        ii += 1
    // traceback from (n, m)
    let aa = ""
    let bb = ""
    let ti = n
    let tj = m
    while ti > 0 or tj > 0
        let took = false
        if ti > 0 and tj > 0 and took == false
            let sub = mismatch
            if char_at(a, ti - 1) == char_at(b, tj - 1)
                sub = matchv
            if dp[ti * w + tj] == dp[(ti - 1) * w + (tj - 1)] + sub
                aa = char_at(a, ti - 1) + aa
                bb = char_at(b, tj - 1) + bb
                ti -= 1
                tj -= 1
                took = true
        if took == false and ti > 0
            if dp[ti * w + tj] == dp[(ti - 1) * w + tj] + gap
                aa = char_at(a, ti - 1) + aa
                bb = "-" + bb
                ti -= 1
                took = true
        if took == false
            aa = "-" + aa
            bb = char_at(b, tj - 1) + bb
            tj -= 1
    [dp[n * w + m], aa, bb]

// Just the optimal global alignment score (no traceback).
fn align_score(a: string, b: string, matchv: int, mismatch: int, gap: int) -> int
    let r = align_global(a, b, matchv, mismatch, gap)
    r[0]
