// forge_compact_map — size-limited map with eviction and Result API.

fn cm_new(max_size: int) -> dict
    let m = {}
    m["data"] = {}
    m["order"] = {}
    m["max"] = max_size
    m["count"] = 0
    m["evictions"] = 0
    m["next_order"] = 0
    m

fn cm_put(m: dict, key: string, value: string) -> dict
    let dk = "d_" + key
    if contains(m["data"], dk) == true
        m["data"][dk] = value
        return m
    if m["count"] >= m["max"]
        let oldest_order = m["next_order"] - m["count"]
        let ok_key = "o_" + str(oldest_order)
        if contains(m["order"], ok_key) == true
            let old_key = m["order"][ok_key]
            let old_dk = "d_" + old_key
            m["data"][old_dk] = ""
            m["order"][ok_key] = ""
            m["evictions"] = m["evictions"] + 1
            m["count"] = m["count"] - 1
    m["data"][dk] = value
    let ok2 = "o_" + str(m["next_order"])
    m["order"][ok2] = key
    m["next_order"] = m["next_order"] + 1
    m["count"] = m["count"] + 1
    m

fn cm_get(m: dict, key: string) -> Result
    let dk = "d_" + key
    if contains(m["data"], dk) != true
        return err("key not found")
    if m["data"][dk] == ""
        return err("key evicted")
    ok(m["data"][dk])

fn cm_has(m: dict, key: string) -> int
    let dk = "d_" + key
    if contains(m["data"], dk) == true
        if m["data"][dk] != ""
            return 1
    0

fn cm_count(m: dict) -> int
    m["count"]

fn cm_eviction_count(m: dict) -> int
    m["evictions"]
