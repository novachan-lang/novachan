// forge_compact_map — size-limited map with eviction and Result API.

fn cm_new(max_size: int) -> dict
    {"data": {}, "order": {}, "max": max_size, "count": 0, "evictions": 0, "next_order": 0}

fn cm_put(m: dict, key: string, value: string) -> dict
    let dk = "d_{key}"
    if dk in m["data"]
        m["data"][dk] = value
        return m
    if m["count"] >= m["max"]
        let oldest_order = m["next_order"] - m["count"]
        let ok_key = "o_{oldest_order}"
        if ok_key in m["order"]
            let old_key = m["order"][ok_key]
            let old_dk = "d_{old_key}"
            m["data"][old_dk] = ""
            m["order"][ok_key] = ""
            m["evictions"] += 1
            m["count"] -= 1
    m["data"][dk] = value
    let no = m["next_order"]
    let ok2 = "o_{no}"
    m["order"][ok2] = key
    m["next_order"] += 1
    m["count"] += 1
    m

fn cm_get(m: dict, key: string) -> Result
    let dk = "d_{key}"
    if dk not in m["data"]
        return err("key not found")
    if m["data"][dk] == ""
        return err("key evicted")
    ok(m["data"][dk])

fn cm_has(m: dict, key: string) -> int
    let dk = "d_{key}"
    if dk in m["data"]
        if m["data"][dk] != ""
            return 1
    0

fn cm_count(m: dict) -> int
    m["count"]

fn cm_eviction_count(m: dict) -> int
    m["evictions"]
