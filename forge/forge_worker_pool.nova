// forge_worker_pool — Pool of workers with load distribution.

fn wp_new(max_workers: int) -> dict
    let w = {}
    w["max"] = max_workers
    w["workers"] = {}
    w["load"] = {}
    w["worker_count"] = 0
    w["total_assigned"] = 0
    w

fn wp_add_worker(w: dict, name: string) -> dict
    if w["worker_count"] >= w["max"]
        return w
    w["workers"][name] = "idle"
    w["load"][name] = 0
    w["worker_count"] += 1
    w

fn wp_assign(w: dict) -> dict
    let best = ""
    let best_load = 999999
    let ks = keys(w["workers"])
    for i in 0..len(ks)
        let wk = ks[i]
        if w["workers"][wk] != "stopped"
            if w["load"][wk] < best_load
                best_load = w["load"][wk]
                best = wk
    if best == ""
        return {"ok": 0, "worker": "", "w": w}
    w["load"][best] += 1
    w["workers"][best] = "busy"
    w["total_assigned"] += 1
    {"ok": 1, "worker": best, "w": w}

fn wp_release(w: dict, name: string) -> dict
    if name in w["load"]
        if w["load"][name] > 0
            w["load"][name] -= 1
        if w["load"][name] == 0
            w["workers"][name] = "idle"
    w

fn wp_stop_worker(w: dict, name: string) -> dict
    if name in w["workers"]
        w["workers"][name] = "stopped"
    w

fn wp_active_count(w: dict) -> int
    let ks = keys(w["workers"])
    let count = 0
    for i in 0..len(ks)
        if w["workers"][ks[i]] != "stopped"
            count += 1
    count

fn wp_total_assigned(w: dict) -> int
    w["total_assigned"]
