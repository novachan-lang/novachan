// forge_naming -- ORM / REST naming conventions (Rails ActiveSupport::Inflector's classify / tableize /
// humanize / foreign_key). These are the mappings an ORM and a router need but that pure case-conversion and
// pure pluralization can't do alone -- they COMPOSE the two: a table name pluralizes only its LAST word and a
// class name singularizes only its last word. Used to auto-derive a model class from a table ("users" ->
// "User"), a table from a model ("BlogPost" -> "blog_posts"), a form label from a column ("author_id" ->
// "Author"), and a foreign-key column from an association ("Message" -> "message_id").
//
// COMPOSES forge_case (word-splitting + to_snake/to_pascal) and forge_inflect (pluralize/singularize) -- it
// imports both rather than re-deriving their logic, so a fix to either flows through here automatically.

import forge_case
import forge_inflect

// PRIVATE: capitalize the first character, leave the rest untouched (words are already lowercase from to_snake).
fn _name_cap(w: string) -> string
    if len(w) == 0
        return w
    upper(slice(w, 0, 1)) + slice(w, 1, len(w))

// table/relation name -> singular model class name. Only the LAST word is singularized, then the whole thing is
// PascalCased: "posts" -> "Post", "raw_scaled_scorers" -> "RawScaledScorer", "categories" -> "Category".
fn classify(name: string) -> string
    let snake = to_snake(name)
    let parts = split(snake, "_")
    let n = len(parts)
    let out = ""
    let i = 0
    while i < n
        let w = parts[i]
        if i == n - 1
            w = singularize(w)
        out = out + _name_cap(w)
        i = i + 1
    out

// model class name -> plural snake_case table name. Only the LAST word is pluralized: "Post" -> "posts",
// "BlogPost" -> "blog_posts", "RawScaledScorer" -> "raw_scaled_scorers", "Category" -> "categories".
fn tableize(name: string) -> string
    let snake = to_snake(name)
    let parts = split(snake, "_")
    let n = len(parts)
    let out = ""
    let i = 0
    while i < n
        let w = parts[i]
        if i == n - 1
            w = pluralize(w)
        if i > 0
            out = out + "_"
        out = out + w
        i = i + 1
    out

// column/attribute name -> a human-readable form label. Strips a trailing "_id", turns "_"/"-" into spaces, and
// capitalizes only the first word: "employee_salary" -> "Employee salary", "author_id" -> "Author".
fn humanize_label(field: string) -> string
    let f = field
    if ends_with(f, "_id")
        f = slice(f, 0, len(f) - 3)
    let spaced = ""
    let i = 0
    while i < len(f)
        let c = char_at(f, i)
        if c == "_" or c == "-"
            spaced = spaced + " "
        else
            spaced = spaced + c
        i = i + 1
    let t = trim(spaced)
    if len(t) == 0
        return t
    upper(slice(t, 0, 1)) + slice(t, 1, len(t))

// association / model name -> its foreign-key column: snake_case + "_id". "Message" -> "message_id",
// "User" -> "user_id", "BlogPost" -> "blog_post_id".
fn foreign_key(model: string) -> string
    to_snake(model) + "_id"
