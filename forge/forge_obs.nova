// forge_obs -- observability for Forge: RED metrics, health probes, structured logs. The metrics
// registry is a single-owner ACTOR (a spawned loop draining a request channel) -> race-free counters
// with NO locks, N>1-safe by construction. This is the thing Spring loses across async boundaries.
import forge

// ── RED metrics registry (single-owner actor) ─────────────────────────────────────────────────────
// Keyed by "METHOD route" (the route PATTERN, so /users/1 and /users/2 fold under /users/:id). Each
// key's entry carries: total latency across ALL statuses (totlat, for the duration histogram's _sum),
// a nested per-status-code observation count (statuses: {"200": n, "404": m, ...}, for the counter's
// status label -- FIX for the status signal that used to be silently dropped), and a nested cumulative
// bucket count (buckets: {"5": n_le_5ms, "10": n_le_10ms, ...} -- FIX for the duration histogram that
// was never exported despite totlat already being accumulated). This extends the ONE existing dict
// instead of adding parallel structures: what was a bare int value per key is now a small record
// value; the key scheme itself (and the route-folding it gives) is unchanged.
// Maps are BORN IN THE LOOP (adding a new key to a spawn-deep-copied dict is broken -- see
// nova-otp-spawn-constraints). The snapshot is a LIST of fixed-key entries (safe to deep-copy back
// over the channel), never the raw dynamic-key dicts.

// Histogram bucket upper-bounds (ms), cumulative Prometheus-style (a 12ms observation counts toward
// le="25", le="50", ... AND the implicit le="+Inf"). A plain fn (NOT a module-level `let [...]`) --
// forge_obs is always an IMPORTED module, never the entry file, and a module-level literal-list `let`
// only gets its prologue bake-init run in the ENTRY file's prologue: read from an importing module it
// comes back empty (verified live: len() == 0 cross-module vs correctly 10 same-module). Real compiler
// gap, out of this file's scope to fix -- worked around here by making it an ordinary fn call.
fn _obs_bucket_bounds_ms() -> list
    [5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000]

// Fresh per-key record for a (method, route) never observed before.
fn _new_stat_entry(method: string, route: string) -> any
    let st = {}
    st["method"] = method
    st["route"] = route
    st["statuses"] = {}
    st["totlat"] = 0
    st["buckets"] = {str(b): 0 for b in _obs_bucket_bounds_ms()}
    st

fn _metrics_loop(reg)
    let stats = {}
    let inflight = 0
    let running = 1
    while running == 1
        let env = receive(reg["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "observe"
            let key = env["method"] + " " + env["route"]
            let st = {}
            if contains(stats, key)
                st = stats[key]
            else
                st = _new_stat_entry(env["method"], env["route"])
            let statuses = st["statuses"]
            let status_key = str(env["status"])
            // NOT statuses.get(status_key, 0): this file `import forge`s, and forge.nova owns a
            // top-level `get(app, pattern, handler)` route fn -- same collision class as
            // problem/obs_problem above, except THIS one doesn't hard-error at link time, it silently
            // resolves to the wrong symbol and corrupts the result (verified live: statuses.get(k, 0)
            // returned a garbage pointer-sized int instead of the count). Manual contains-check only.
            let sc = 0
            if contains(statuses, status_key)
                sc = statuses[status_key]
            statuses[status_key] = sc + 1
            st["statuses"] = statuses
            st["totlat"] = st["totlat"] + env["latency"]
            let buckets = st["buckets"]
            for b in _obs_bucket_bounds_ms() if env["latency"] <= b
                let bk = str(b)
                buckets[bk] = buckets[bk] + 1
            st["buckets"] = buckets
            stats[key] = st
        else if op == "inflight"
            inflight = inflight + env["delta"]
        else if op == "snapshot"
            let out = []
            for k, st in stats
                let statuses = st["statuses"]
                let total = sum(statuses.values())
                let e = {}
                e["key"] = k
                e["method"] = st["method"]
                e["route"] = st["route"]
                e["statuses"] = statuses
                e["totlat"] = st["totlat"]
                e["count"] = total
                e["buckets"] = st["buckets"]
                push(out, e)
            let snap = {}
            snap["entries"] = out
            snap["inflight"] = inflight
            send(env["reply"], snap)

fn metrics_registry() -> any
    let reg = {}
    reg["req"] = channel()
    spawn _metrics_loop(reg)
    reg

// Record one request: method + route PATTERN + status + latency (ms).
fn metric_observe(reg, method: string, route: string, status: int, latency: int) -> int
    let env = {}
    env["op"] = "observe"
    env["method"] = method
    env["route"] = route
    env["status"] = status
    env["latency"] = latency
    env["reply"] = 0
    send(reg["req"], env)
    0

// Adjust the in-flight gauge (+1 on request start, -1 on finish).
fn metric_inflight(reg, delta: int) -> int
    let env = {}
    env["op"] = "inflight"
    env["delta"] = delta
    env["reply"] = 0
    send(reg["req"], env)
    0

// Read a snapshot: {entries: [{key, method, route, count, totlat, statuses, buckets}], inflight}.
// `statuses` is a dict from status-code string ("200", "404", ...) to the observation count at that
// status; `count` is the total across every status (equal to the sum of `statuses`' values); `totlat`
// is the summed latency (ms) across every status, for computing the mean via totlat/count; `buckets`
// is a dict from bucket-upper-bound string ("5", "10", ...; see _obs_bucket_bounds_ms) to the
// CUMULATIVE count of observations at or under that bound (Prometheus histogram semantics; the
// implicit "+Inf" bucket's count is always `count`).
fn metrics_snapshot(reg) -> any
    let rc = channel()
    let env = {}
    env["op"] = "snapshot"
    env["reply"] = rc
    send(reg["req"], env)
    receive(rc)

// Prometheus text exposition (/metrics body) from a snapshot. Braces/quotes are built via chr() --
// a literal `{` in a NOVA string interpolates, so it must never appear in a template string.
// Emits, per distinct (method, route) seen:
//   - http_requests_total{method,route,status} counter -- one line PER STATUS observed (the status
//     signal used to be silently dropped: metric_observe took a status arg the loop never read).
//   - http_request_duration_ms{method,route,le} -- a REAL Prometheus histogram (bucket/sum/count
//     grouped under one metric family, per the exposition-format spec) built from the totlat/buckets
//     this actor was already accumulating internally but never exported before this fix.
fn metrics_prometheus(reg) -> string
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let snap = metrics_snapshot(reg)
    let entries = snap["entries"]
    let bounds = _obs_bucket_bounds_ms()
    let counters = ""
    let lat_bucket = ""
    let lat_sum = ""
    let lat_count = ""
    for e in entries
        let labels = "method=" + q + e["method"] + q + ",route=" + q + e["route"] + q
        let statuses = e["statuses"]
        for sk, sv in statuses
            counters = counters + "http_requests_total" + lb + labels + ",status=" + q + sk + q + rb + " " + str(sv) + "\n"
        let buckets = e["buckets"]
        for b in bounds
            let bk = str(b)
            lat_bucket = lat_bucket + "http_request_duration_ms_bucket" + lb + labels + ",le=" + q + bk + q + rb + " " + str(buckets[bk]) + "\n"
        lat_bucket = lat_bucket + "http_request_duration_ms_bucket" + lb + labels + ",le=" + q + "+Inf" + q + rb + " " + str(e["count"]) + "\n"
        lat_sum = lat_sum + "http_request_duration_ms_sum" + lb + labels + rb + " " + str(e["totlat"]) + "\n"
        lat_count = lat_count + "http_request_duration_ms_count" + lb + labels + rb + " " + str(e["count"]) + "\n"
    let body = "# HELP http_requests_total Total HTTP requests\n# TYPE http_requests_total counter\n" + counters
    body = body + "# HELP http_request_duration_ms Observed HTTP request latency in milliseconds\n# TYPE http_request_duration_ms histogram\n" + lat_bucket + lat_sum + lat_count
    body = body + "# TYPE http_inflight_requests gauge\nhttp_inflight_requests " + str(snap["inflight"]) + "\n"
    body

// ── Health probes (T8.5/T8.6) ─────────────────────────────────────────────────────────────────────
// Liveness (the process runs) vs readiness (dependencies are up). readiness runs a list of
// [name, fn()->bool] checks; the FIRST failure makes it not-ready and names the culprit -> the route
// layer turns {ready:1} into 200 and {ready:0} into 503. Distinct probes (liveness != readiness).

fn health_ok() -> string
    "ok"

fn readiness(checks) -> any
    let st = {}
    st["ready"] = 1
    st["failed"] = ""
    let i = 0
    while i < len(checks)
        let c = checks[i]
        let f = c[1]
        if f() == false
            st["ready"] = 0
            st["failed"] = c[0]
            return st
        i = i + 1
    st

// ── Structured JSON logs (T8.7) ───────────────────────────────────────────────────────────────────
// One JSON object per line: {"level":..,"msg":..,<fields>}. Braces/quotes via chr() (a literal `{`
// interpolates in a NOVA string). Prints the line and returns it (testable). fields = a dict of extras.

fn log_json(level: string, msg: string, fields) -> string
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let line = lb + q + "level" + q + ":" + q + level + q + "," + q + "msg" + q + ":" + q + msg + q
    let ks = keys(fields)
    let i = 0
    while i < len(ks)
        let k = ks[i]
        line = line + "," + q + k + q + ":" + q + str(fields[k]) + q
        i = i + 1
    line = line + rb
    print(line)
    line

// ── Route wiring: expose the observability endpoints on a Forge app ───────────────────────────────
// obs_routes(app, reg) registers GET /metrics (Prometheus text from the registry) + GET /healthz
// (liveness, always 200). readyz_route(app, checks) adds GET /readyz (503 if any check fails). Call
// after app(). The handlers capture the registry's channel, which is shared across the
// spawn-per-connection boundary, so live requests reach the metrics actor.
fn obs_routes(a, reg) -> any
    let r = reg
    get(a, "/metrics", fn(req) resp_text(200, metrics_prometheus(r)))
    get(a, "/healthz", fn(req) resp_text(200, "ok"))
    a

fn _readyz_resp(checks) -> any
    let st = readiness(checks)
    if st["ready"] == 1
        return resp_text(200, "ready")
    resp_text(503, "not ready: " + st["failed"])

fn readyz_route(a, checks) -> any
    let c = checks
    get(a, "/readyz", fn(req) _readyz_resp(c))
    a

// ── W3C trace context (T8.8): parse an inbound `traceparent` to continue a distributed trace ──────
// Format: version(2hex)-traceid(32hex)-spanid(16hex)-flags(2hex), e.g.
//   00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01
// parse_traceparent returns the 32-hex trace_id when the header is well-formed (and not all-zero),
// else "" -> the caller mints a fresh id. (Minting a random 32-hex id is a small follow-up; it needs a
// public random/hex helper -- _csrf_rand_hex is module-private to forge.)
fn _obs_is_hex_str(s: string, n: int) -> bool
    if len(s) != n
        return false
    let i = 0
    while i < n
        let o = ord(char_at(s, i))
        let ok = (o >= 48 and o <= 57) or (o >= 97 and o <= 102) or (o >= 65 and o <= 70)
        if ok == false
            return false
        i = i + 1
    true

fn parse_traceparent(header: string) -> string
    let parts = split(header, "-")
    if len(parts) != 4
        return ""
    if _obs_is_hex_str(parts[0], 2) == false
        return ""
    if _obs_is_hex_str(parts[1], 32) == false
        return ""
    if _obs_is_hex_str(parts[2], 16) == false
        return ""
    if _obs_is_hex_str(parts[3], 2) == false
        return ""
    if parts[1] == "00000000000000000000000000000000"
        return ""
    parts[1]

// Mint a fresh 32-hex trace_id when a request has no inbound traceparent. A trace_id is a CORRELATION
// id (not a secret), so high-resolution clock reads give sufficient uniqueness within a process; a
// crypto-random mint via a future runtime rand builtin would be a strict upgrade, not a correctness fix.
fn _int_to_hex(n: int, width: int) -> string
    let digits = "0123456789abcdef"
    let v = n
    if v < 0
        v = 0 - v
    let s = ""
    let i = 0
    while i < width
        let nibble = v % 16
        s = char_at(digits, nibble) + s
        v = v / 16
        i = i + 1
    s

fn mint_trace_id() -> string
    _int_to_hex(clock_ns(), 16) + _int_to_hex(clock_ns(), 16)

// ── RFC 9457 problem+json (T8.11): a structured error body ────────────────────────────────────────
// obs_problem(status, title, detail) -> a Response with content-type application/problem+json and a body
// {"type":"about:blank","title":..,"status":..,"detail":..}. The interoperable error shape (vs ad-hoc
// JSON). Braces/quotes via chr() (a literal '{' interpolates in a NOVA string).
// Named obs_problem (not the bare `problem`) because forge.nova already owns a top-level `problem`
// (status, detail) helper with a different arity -- NOVA gives top-level fn names no per-module
// mangling, so two same-named top-level fns reaching the same compiled unit (forge_obs already
// `import forge`s) is a hard link error, not an overload. Pre-existing latent collision, not
// introduced by this change; scoped-fixed here since forge.nova is out of scope for this file.
fn obs_problem(status: int, title: string, detail: string) -> Response
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let body = lb + q + "type" + q + ":" + q + "about:blank" + q + "," + q + "title" + q + ":" + q + title + q + "," + q + "status" + q + ":" + str(status) + "," + q + "detail" + q + ":" + q + detail + q + rb
    let h = {}
    h["Content-Type"] = "application/problem+json"
    Response(status, h, body, false, [])

// ── Auto-metrics middleware (T8.2): observe EVERY request (method, route, status, latency) ──────────
// use(app, mw_metrics(reg)) folds around the route terminal: bumps the in-flight gauge, times the
// handler, and records (method, route-PATTERN, status, latency-ms) into the registry. The route pattern
// comes from req.state["route"] (set by the dispatcher when a route matches), so /users/42 and
// /users/99 fold under /users/:id -- BOUNDED cardinality, the thing naive per-path metrics get wrong
// (unbounded label explosion that kills Prometheus). dispatch_req sets req.state["route"] inside
// nxt(req), so it is populated by the time this reads it after the downstream call returns.
fn _t_metrics(req, nxt, reg)
    metric_inflight(reg, 1)
    let t0 = clock_ns()
    let resp = nxt(req)
    let dt = (clock_ns() - t0) / 1000000
    metric_inflight(reg, -1)
    let route = "unmatched"
    if contains(req.state, "route")
        route = req.state["route"]
    metric_observe(reg, req.method, route, resp.status, dt)
    resp

fn mw_metrics(reg)
    let r = reg
    return fn(req, nxt) _t_metrics(req, nxt, r)