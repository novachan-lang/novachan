// forge_obs -- observability for Forge: RED metrics, health probes, structured logs. The metrics
// registry is a single-owner ACTOR (a spawned loop draining a request channel) -> race-free counters
// with NO locks, N>1-safe by construction. This is the thing Spring loses across async boundaries.
import forge

// ── RED metrics registry (single-owner actor) ─────────────────────────────────────────────────────
// Counts + total latency keyed by "METHOD route" (the route PATTERN, so /users/1 and /users/2 fold
// under /users/:id), status-code counts, and an in-flight gauge. Maps are BORN IN THE LOOP (adding a
// new key to a spawn-deep-copied dict is broken -- see nova-otp-spawn-constraints). The snapshot is a
// LIST of fixed-key entries (safe to deep-copy back over the channel), never the raw dynamic-key dicts.

fn _metrics_loop(reg)
    let counts = {}
    let totlat = {}
    let inflight = 0
    let running = 1
    while running == 1
        let env = receive(reg["req"])
        let op = env["op"]
        if op == "stop"
            running = 0
        else if op == "observe"
            let key = env["method"] + " " + env["route"]
            let c = 0
            if contains(counts, key)
                c = counts[key]
            counts[key] = c + 1
            let l = 0
            if contains(totlat, key)
                l = totlat[key]
            totlat[key] = l + env["latency"]
        else if op == "inflight"
            inflight = inflight + env["delta"]
        else if op == "snapshot"
            let out = []
            let ks = keys(counts)
            let i = 0
            while i < len(ks)
                let k = ks[i]
                let e = {}
                e["key"] = k
                e["count"] = counts[k]
                e["totlat"] = totlat[k]
                push(out, e)
                i = i + 1
            let snap = {}
            snap["entries"] = out
            snap["inflight"] = inflight
            send(env["reply"], snap)

fn metrics_registry() -> any
    let reg = {}
    reg["req"] = channel()
    spawn _metrics_loop(reg)
    reg

// Record one request: method + route PATTERN + status + latency (ms).
fn metric_observe(reg, method: string, route: string, status: int, latency: int) -> int
    let env = {}
    env["op"] = "observe"
    env["method"] = method
    env["route"] = route
    env["status"] = status
    env["latency"] = latency
    env["reply"] = 0
    send(reg["req"], env)
    0

// Adjust the in-flight gauge (+1 on request start, -1 on finish).
fn metric_inflight(reg, delta: int) -> int
    let env = {}
    env["op"] = "inflight"
    env["delta"] = delta
    env["reply"] = 0
    send(reg["req"], env)
    0

// Read a snapshot: {entries: [{key, count, totlat}], inflight}.
fn metrics_snapshot(reg) -> any
    let rc = channel()
    let env = {}
    env["op"] = "snapshot"
    env["reply"] = rc
    send(reg["req"], env)
    receive(rc)

// Prometheus text exposition (/metrics body) from a snapshot. Braces/quotes are built via chr() --
// a literal `{` in a NOVA string interpolates, so it must never appear in a template string.
fn metrics_prometheus(reg) -> string
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let snap = metrics_snapshot(reg)
    let entries = snap["entries"]
    let body = "# HELP http_requests_total Total HTTP requests\n# TYPE http_requests_total counter\n"
    let i = 0
    while i < len(entries)
        let e = entries[i]
        body = body + "http_requests_total" + lb + "endpoint=" + q + e["key"] + q + rb + " " + str(e["count"]) + "\n"
        i = i + 1
    body = body + "# TYPE http_inflight_requests gauge\nhttp_inflight_requests " + str(snap["inflight"]) + "\n"
    body

// ── Health probes (T8.5/T8.6) ─────────────────────────────────────────────────────────────────────
// Liveness (the process runs) vs readiness (dependencies are up). readiness runs a list of
// [name, fn()->bool] checks; the FIRST failure makes it not-ready and names the culprit -> the route
// layer turns {ready:1} into 200 and {ready:0} into 503. Distinct probes (liveness != readiness).

fn health_ok() -> string
    "ok"

fn readiness(checks) -> any
    let st = {}
    st["ready"] = 1
    st["failed"] = ""
    let i = 0
    while i < len(checks)
        let c = checks[i]
        let f = c[1]
        if f() == false
            st["ready"] = 0
            st["failed"] = c[0]
            return st
        i = i + 1
    st

// ── Structured JSON logs (T8.7) ───────────────────────────────────────────────────────────────────
// One JSON object per line: {"level":..,"msg":..,<fields>}. Braces/quotes via chr() (a literal `{`
// interpolates in a NOVA string). Prints the line and returns it (testable). fields = a dict of extras.

fn log_json(level: string, msg: string, fields) -> string
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let line = lb + q + "level" + q + ":" + q + level + q + "," + q + "msg" + q + ":" + q + msg + q
    let ks = keys(fields)
    let i = 0
    while i < len(ks)
        let k = ks[i]
        line = line + "," + q + k + q + ":" + q + str(fields[k]) + q
        i = i + 1
    line = line + rb
    print(line)
    line

// ── Route wiring: expose the observability endpoints on a Forge app ───────────────────────────────
// obs_routes(app, reg) registers GET /metrics (Prometheus text from the registry) + GET /healthz
// (liveness, always 200). readyz_route(app, checks) adds GET /readyz (503 if any check fails). Call
// after app(). The handlers capture the registry's channel, which is shared across the
// spawn-per-connection boundary, so live requests reach the metrics actor.
fn obs_routes(a, reg) -> any
    let r = reg
    get(a, "/metrics", fn(req) resp_text(200, metrics_prometheus(r)))
    get(a, "/healthz", fn(req) resp_text(200, "ok"))
    a

fn _readyz_resp(checks) -> any
    let st = readiness(checks)
    if st["ready"] == 1
        return resp_text(200, "ready")
    resp_text(503, "not ready: " + st["failed"])

fn readyz_route(a, checks) -> any
    let c = checks
    get(a, "/readyz", fn(req) _readyz_resp(c))
    a

// ── W3C trace context (T8.8): parse an inbound `traceparent` to continue a distributed trace ──────
// Format: version(2hex)-traceid(32hex)-spanid(16hex)-flags(2hex), e.g.
//   00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01
// parse_traceparent returns the 32-hex trace_id when the header is well-formed (and not all-zero),
// else "" -> the caller mints a fresh id. (Minting a random 32-hex id is a small follow-up; it needs a
// public random/hex helper -- _csrf_rand_hex is module-private to forge.)
fn _is_hex_str(s: string, n: int) -> bool
    if len(s) != n
        return false
    let i = 0
    while i < n
        let o = ord(char_at(s, i))
        let ok = (o >= 48 and o <= 57) or (o >= 97 and o <= 102) or (o >= 65 and o <= 70)
        if ok == false
            return false
        i = i + 1
    true

fn parse_traceparent(header: string) -> string
    let parts = split(header, "-")
    if len(parts) != 4
        return ""
    if _is_hex_str(parts[0], 2) == false
        return ""
    if _is_hex_str(parts[1], 32) == false
        return ""
    if _is_hex_str(parts[2], 16) == false
        return ""
    if _is_hex_str(parts[3], 2) == false
        return ""
    if parts[1] == "00000000000000000000000000000000"
        return ""
    parts[1]

// Mint a fresh 32-hex trace_id when a request has no inbound traceparent. A trace_id is a CORRELATION
// id (not a secret), so high-resolution clock reads give sufficient uniqueness within a process; a
// crypto-random mint via a future runtime rand builtin would be a strict upgrade, not a correctness fix.
fn _int_to_hex(n: int, width: int) -> string
    let digits = "0123456789abcdef"
    let v = n
    if v < 0
        v = 0 - v
    let s = ""
    let i = 0
    while i < width
        let nibble = v % 16
        s = char_at(digits, nibble) + s
        v = v / 16
        i = i + 1
    s

fn mint_trace_id() -> string
    _int_to_hex(clock_ns(), 16) + _int_to_hex(clock_ns(), 16)

// ── RFC 9457 problem+json (T8.11): a structured error body ────────────────────────────────────────
// problem(status, title, detail) -> a Response with content-type application/problem+json and a body
// {"type":"about:blank","title":..,"status":..,"detail":..}. The interoperable error shape (vs ad-hoc
// JSON). Braces/quotes via chr() (a literal '{' interpolates in a NOVA string).
fn problem(status: int, title: string, detail: string) -> Response
    let lb = chr(123)
    let rb = chr(125)
    let q = chr(34)
    let body = lb + q + "type" + q + ":" + q + "about:blank" + q + "," + q + "title" + q + ":" + q + title + q + "," + q + "status" + q + ":" + str(status) + "," + q + "detail" + q + ":" + q + detail + q + rb
    let h = {}
    h["Content-Type"] = "application/problem+json"
    Response(status, h, body, false, [])

// ── Auto-metrics middleware (T8.2): observe EVERY request (method, route, status, latency) ──────────
// use(app, mw_metrics(reg)) folds around the route terminal: bumps the in-flight gauge, times the
// handler, and records (method, route-PATTERN, status, latency-ms) into the registry. The route pattern
// comes from req.state["route"] (set by the dispatcher when a route matches), so /users/42 and
// /users/99 fold under /users/:id -- BOUNDED cardinality, the thing naive per-path metrics get wrong
// (unbounded label explosion that kills Prometheus). dispatch_req sets req.state["route"] inside
// nxt(req), so it is populated by the time this reads it after the downstream call returns.
fn _t_metrics(req, nxt, reg)
    metric_inflight(reg, 1)
    let t0 = clock_ns()
    let resp = nxt(req)
    let dt = (clock_ns() - t0) / 1000000
    metric_inflight(reg, -1)
    let route = "unmatched"
    if contains(req.state, "route")
        route = req.state["route"]
    metric_observe(reg, req.method, route, resp.status, dt)
    resp

fn mw_metrics(reg)
    let r = reg
    return fn(req, nxt) _t_metrics(req, nxt, r)