fn rb_new()
    let s = {}
    s["book_count"] = 0
    s["book_names"] = ""
    s["total_runs"] = 0
    return s

fn rb_add(s, book_name, description)
    let idx = int(s["book_count"])
    s["bk_" + str(idx) + "_name"] = book_name
    s["bk_" + str(idx) + "_desc"] = description
    s["bk_" + str(idx) + "_step_count"] = 0
    s["bk_" + str(idx) + "_runs"] = 0
    s["book_count"] = idx + 1
    if s["book_names"] == ""
        s["book_names"] = book_name
    else
        s["book_names"] = str(s["book_names"]) + "," + book_name
    return s

fn _rb_find(s, book_name)
    let cnt = int(s["book_count"])
    let i = 0
    while i < cnt
        if str(s["bk_" + str(i) + "_name"]) == book_name
            return i
        i = i + 1
    return -1

fn rb_add_step(s, book_name, step_desc) -> Result
    let bi = _rb_find(s, book_name)
    if bi < 0
        return err("runbook not found: " + book_name)
    let sidx = int(s["bk_" + str(bi) + "_step_count"])
    s["bk_" + str(bi) + "_step_" + str(sidx)] = step_desc
    s["bk_" + str(bi) + "_step_count"] = sidx + 1
    return ok(s)

fn rb_step_count(s, book_name) -> Result
    let bi = _rb_find(s, book_name)
    if bi < 0
        return err("runbook not found: " + book_name)
    return ok(int(s["bk_" + str(bi) + "_step_count"]))

fn rb_get_step(s, book_name, step_index) -> Result
    let bi = _rb_find(s, book_name)
    if bi < 0
        return err("runbook not found: " + book_name)
    let cnt = int(s["bk_" + str(bi) + "_step_count"])
    if step_index < 0 or step_index >= cnt
        return err("step index out of range")
    return ok(str(s["bk_" + str(bi) + "_step_" + str(step_index)]))

fn rb_execute(s, book_name) -> Result
    let bi = _rb_find(s, book_name)
    if bi < 0
        return err("runbook not found: " + book_name)
    s["bk_" + str(bi) + "_runs"] = int(s["bk_" + str(bi) + "_runs"]) + 1
    s["total_runs"] = int(s["total_runs"]) + 1
    return ok(s)

fn rb_run_count(s, book_name) -> Result
    let bi = _rb_find(s, book_name)
    if bi < 0
        return err("runbook not found: " + book_name)
    return ok(int(s["bk_" + str(bi) + "_runs"]))

fn rb_book_count(s)
    return int(s["book_count"])

fn rb_total_runs(s)
    return int(s["total_runs"])

fn rb_book_list(s)
    return str(s["book_names"])

fn rb_has_book(s, book_name)
    let bi = _rb_find(s, book_name)
    if bi >= 0
        return 1
    return 0

fn rb_description(s, book_name) -> Result
    let bi = _rb_find(s, book_name)
    if bi < 0
        return err("runbook not found: " + book_name)
    return ok(str(s["bk_" + str(bi) + "_desc"]))
