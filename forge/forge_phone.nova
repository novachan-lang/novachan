// forge_phone -- phone number validation + E.164 normalization (libphonenumber-lite). Strip formatting,
// validate the E.164 digit range (7-15), normalize to +<countrycode><digits>. LEAF -- imports NOTHING.

fn _phone_digits(number: string) -> string
    join([char_at(number, i) for i in 0..len(number) if find("0123456789", char_at(number, i)) >= 0], "")

// Valid iff 7-15 digits (the E.164 length range).
fn phone_valid(number: string) -> bool
    let d = _phone_digits(number)
    len(d) >= 7 and len(d) <= 15

// Normalize to E.164 "+<cc><national>". If the input already had a leading '+', keep its digits; else
// prepend `default_cc` (the country code, e.g. "1" for US). "" for empty input.
fn phone_e164(number: string, default_cc: string) -> string
    let d = _phone_digits(number)
    if len(d) == 0
        return ""
    if starts_with(number, "+")
        return "+" + d
    "+" + default_cc + d
