// forge_content_type -- parse + build a Content-Type header value (media type + parameters like charset,
// boundary). content_type_parse("text/html; charset=utf-8") -> a dict with "media" + each param. Complements
// forge_mime (extension->type) and forge_negotiate (Accept). LEAF -- imports NOTHING.

fn _ct_unquote(s: string) -> string
    if len(s) >= 2 and char_at(s, 0) == chr(34) and char_at(s, len(s) - 1) == chr(34)
        return slice(s, 1, len(s) - 1)
    s

// Parse "type/subtype; k=v; k2=\"v2\"" -> dict: "media" (lowercased) + each param (lowercased key, unquoted value).
fn content_type_parse(header: string) -> dict
    let out = {}
    let parts = split(header, ";")
    out["media"] = lower(trim(parts[0]))
    for i in 1..len(parts)
        let p = trim(parts[i])
        let eq = find(p, "=")
        if eq > 0
            out[lower(trim(slice(p, 0, eq)))] = _ct_unquote(trim(slice(p, eq + 1, len(p))))
    out

// The base media type only ("text/html" from "text/html; charset=utf-8").
fn content_type_media(header: string) -> string
    let ct = content_type_parse(header)
    ct["media"]

// The charset parameter ("" if none).
fn content_type_charset(header: string) -> string
    let ct = content_type_parse(header)
    if "charset" in ct
        return ct["charset"]
    ""

// Build a Content-Type value from a media type + charset ("" to omit charset).
fn content_type_build(media: string, charset: string) -> string
    if len(charset) == 0
        return media
    "{media}; charset={charset}"
