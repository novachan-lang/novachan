// forge_config_validator — Configuration schema validation.
// Define required/optional fields with types, validate config dicts.

fn cv_new() -> dict
    {"fields": []}

fn cv_required(cv: dict, name: string, field_type: string) -> dict
    push(cv["fields"], {"name": name, "type": field_type, "required": 1, "default": ""})
    cv

fn cv_optional(cv: dict, name: string, field_type: string, default_val: any) -> dict
    push(cv["fields"], {"name": name, "type": field_type, "required": 0, "default": default_val})
    cv

fn cv_validate(cv: dict, config: dict) -> dict
    let result = {"valid": 1, "errors": [], "warnings": []}
    for i in 0..len(cv["fields"])
        let field = cv["fields"][i]
        let fname = field["name"]
        if fname not in config
            if field["required"] == 1
                result["valid"] = 0
                push(result["errors"], "missing required: {fname}")
            else
                push(result["warnings"], "using default for: {fname}")
        else
            let val = config[fname]
            let t = type_of(val)
            if field["type"] == "string"
                if t != "string"
                    result["valid"] = 0
                    push(result["errors"], "wrong type for {fname}: expected string")
            if field["type"] == "int"
                if t != "int"
                    result["valid"] = 0
                    push(result["errors"], "wrong type for {fname}: expected int")
    result

fn cv_apply_defaults(cv: dict, config: dict) -> dict
    for i in 0..len(cv["fields"])
        let field = cv["fields"][i]
        if field["required"] != 1
            if field["name"] not in config
                config[field["name"]] = field["default"]
    config

fn cv_field_count(cv: dict) -> int
    len(cv["fields"])

fn cv_required_fields(cv: dict) -> list
    [cv["fields"][i]["name"] for i in 0..len(cv["fields"]) if cv["fields"][i]["required"] == 1]
