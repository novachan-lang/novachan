// forge_config_validator — Configuration schema validation.
// Define required/optional fields with types, validate config dicts.

fn cv_new() -> dict
    let cv = {}
    cv["fields"] = []
    cv

fn cv_required(cv: dict, name: string, field_type: string) -> dict
    let f = {}
    f["name"] = name
    f["type"] = field_type
    f["required"] = 1
    f["default"] = ""
    push(cv["fields"], f)
    cv

fn cv_optional(cv: dict, name: string, field_type: string, default_val: any) -> dict
    let f = {}
    f["name"] = name
    f["type"] = field_type
    f["required"] = 0
    f["default"] = default_val
    push(cv["fields"], f)
    cv

fn cv_validate(cv: dict, config: dict) -> dict
    let result = {}
    result["valid"] = 1
    result["errors"] = []
    result["warnings"] = []
    let i = 0
    while i < len(cv["fields"])
        let field = cv["fields"][i]
        let has = contains(config, field["name"])
        if has != true
            if field["required"] == 1
                result["valid"] = 0
                push(result["errors"], "missing required: " + field["name"])
            else
                push(result["warnings"], "using default for: " + field["name"])
        else
            let val = config[field["name"]]
            let t = type_of(val)
            if field["type"] == "string"
                if t != "string"
                    result["valid"] = 0
                    push(result["errors"], "wrong type for " + field["name"] + ": expected string")
            if field["type"] == "int"
                if t != "int"
                    result["valid"] = 0
                    push(result["errors"], "wrong type for " + field["name"] + ": expected int")
        i = i + 1
    result

fn cv_apply_defaults(cv: dict, config: dict) -> dict
    let i = 0
    while i < len(cv["fields"])
        let field = cv["fields"][i]
        if field["required"] != 1
            let has = contains(config, field["name"])
            if has != true
                config[field["name"]] = field["default"]
        i = i + 1
    config

fn cv_field_count(cv: dict) -> int
    len(cv["fields"])

fn cv_required_fields(cv: dict) -> list
    let result = []
    let i = 0
    while i < len(cv["fields"])
        if cv["fields"][i]["required"] == 1
            push(result, cv["fields"][i]["name"])
        i = i + 1
    result
