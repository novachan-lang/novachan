// forge_membership_list — Cluster membership tracking (SWIM-like).

fn ml_new() -> dict
    {"members": {}, "status": {}, "joined_at": {}, "count": 0, "suspicions": 0}

fn ml_join(m: dict, node: string, timestamp: int) -> dict
    m["members"][node] = 1
    m["status"][node] = "alive"
    m["joined_at"][node] = timestamp
    m["count"] += 1
    m

fn ml_leave(m: dict, node: string) -> dict
    m["status"][node] = "left"
    m

fn ml_suspect(m: dict, node: string) -> dict
    m["status"][node] = "suspect"
    m["suspicions"] += 1
    m

fn ml_confirm_alive(m: dict, node: string) -> dict
    m["status"][node] = "alive"
    m

fn ml_confirm_dead(m: dict, node: string) -> dict
    m["status"][node] = "dead"
    m

fn ml_is_alive(m: dict, node: string) -> int
    if node not in m["status"]
        return 0
    if m["status"][node] == "alive"
        return 1
    0

fn ml_status(m: dict, node: string) -> string
    m["status"][node]

fn ml_alive_count(m: dict) -> int
    let ks = keys(m["status"])
    let c = 0
    for i in 0..len(ks)
        if m["status"][ks[i]] == "alive"
            c += 1
    c

fn ml_total_members(m: dict) -> int
    m["count"]

fn ml_suspicion_count(m: dict) -> int
    m["suspicions"]
