// forge_cron -- cron expression parsing + matching (Quartz / Spring @Scheduled(cron) / Unix cron). Parse a
// 5-field "min hour dom month dow" expression and test whether a given time matches. Pair with a scheduler
// loop (tick every 60s -> if cron_matches, run the job) for declarative cron scheduling. Supports *, N, */K,
// A-B ranges, and A,B,C lists per field. LEAF -- imports NOTHING.

// Does one cron ATOM ("*"/"N"/"*/K"/"A-B") match `value`?
fn _cron_atom_matches(atom: string, value: int) -> bool
    if atom == "*"
        return true
    if starts_with(atom, "*/")
        let k = parse_int(slice(atom, 2, len(atom)))
        if k > 0
            return (value % k) == 0
        return false
    let dash = find(atom, "-")
    if dash > 0
        let lo = parse_int(slice(atom, 0, dash))
        let hi = parse_int(slice(atom, dash + 1, len(atom)))
        return value >= lo and value <= hi
    parse_int(atom) == value

// Does a cron FIELD (comma-separated atoms) match `value`?
fn _cron_field_matches(field: string, value: int) -> bool
    if field == "*"
        return true
    let parts = split(field, ",")
    for i in 0..len(parts)
        if _cron_atom_matches(parts[i], value)
            return true
    false

// Does the 5-field cron `expr` match this (minute, hour, day-of-month, month, day-of-week)?
fn cron_matches(expr: string, minute: int, hour: int, dom: int, month: int, dow: int) -> bool
    let fields = split(expr, " ")
    if len(fields) != 5
        return false
    if not _cron_field_matches(fields[0], minute)
        return false
    if not _cron_field_matches(fields[1], hour)
        return false
    if not _cron_field_matches(fields[2], dom)
        return false
    if not _cron_field_matches(fields[3], month)
        return false
    _cron_field_matches(fields[4], dow)
