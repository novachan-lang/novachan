// forge_cloudevents -- CloudEvents v1.0 (CNCF spec) envelopes in JSON structured content mode. CloudEvents is
// the vendor-neutral way to describe an event so it interoperates across Knative, AWS EventBridge, Azure Event
// Grid, Kafka, and HTTP -- exactly the boundary NOVA's Processes/Channels cross when an event leaves one node
// for another. This module builds, validates, and (de)serializes that envelope; forge_events remains the
// in-process pub/sub bus, while this is the on-the-wire interop format a distributed handler emits/consumes.
//
// v1.0 REQUIRED context attributes: specversion (MUST be "1.0"), id (producer-unique per source), source (a
// URI-reference identifying the emitter), type (reverse-DNS event kind). OPTIONAL: subject, time (RFC 3339),
// datacontenttype, dataschema, and the event `data` payload. Structured mode = the whole envelope is one JSON
// object, so it composes with the json_stringify / json_decode builtins. LEAF -- imports NOTHING.

// Build a minimal valid CloudEvent (the four required attributes + data). specversion is fixed to "1.0".
fn cloudevent(id: string, source: string, ce_type: string, data: any) -> dict
    let e = {}
    e["specversion"] = "1.0"
    e["id"] = id
    e["source"] = source
    e["type"] = ce_type
    e["data"] = data
    e

// Attach an optional attribute only when non-empty (keeps the envelope free of empty-string junk keys).
fn cloudevent_set(e: dict, name: string, value: string) -> dict
    if len(value) > 0
        e[name] = value
    e

// Build a fuller event: subject (routing hint), time (RFC 3339), datacontenttype (e.g. "application/json").
// Empty optionals are dropped.
fn cloudevent_full(id: string, source: string, ce_type: string, subject: string, time: string, datacontenttype: string, data: any) -> dict
    let e = cloudevent(id, source, ce_type, data)
    cloudevent_set(e, "subject", subject)
    cloudevent_set(e, "time", time)
    cloudevent_set(e, "datacontenttype", datacontenttype)
    e

// True iff the envelope satisfies the v1.0 REQUIRED-attribute rules: specversion == "1.0" and id/source/type
// are each present, string-typed, and non-empty. Used to reject a malformed inbound event before dispatch.
fn cloudevent_valid(e: dict) -> bool
    if "specversion" not in e
        return false
    if not (e["specversion"] == "1.0")
        return false
    let req = ["id", "source", "type"]
    for k in req
        if k not in e
            return false
        if not (type_of(e[k]) == "string")
            return false
        if len(e[k]) == 0
            return false
    true

// Structured-mode serialization: the whole envelope as one JSON object.
fn cloudevent_to_json(e: dict) -> string
    json_stringify(e)

// Parse a structured-mode CloudEvent JSON string back into a dict (does NOT validate -- call cloudevent_valid).
fn cloudevent_from_json(s: string) -> dict
    json_decode(s)

// Routing helper: does this event's type match `t`? (The common consumer-side dispatch predicate.)
fn cloudevent_is(e: dict, t: string) -> bool
    if "type" not in e
        return false
    e["type"] == t

// ── HTTP binary content mode (the other CloudEvents HTTP binding) ────────────────────────────────────
// In binary mode the event's context attributes travel as HTTP headers named "ce-<attribute>" and the event
// `data` is the raw HTTP body (this is how Knative/EventBridge/Event Grid usually deliver over HTTP). Note the
// spec exception: `datacontenttype` maps to the standard "content-type" header, NOT "ce-datacontenttype".
// cloudevent_to_headers returns the header dict to send alongside the body (= e["data"]).
fn cloudevent_to_headers(e: dict) -> dict
    let h = {}
    let attrs = ["specversion", "id", "source", "type", "subject", "time"]
    for a in attrs
        if a in e
            if type_of(e[a]) == "string"
                if len(e[a]) > 0
                    h["ce-" + a] = e[a]
    if "datacontenttype" in e
        if type_of(e["datacontenttype"]) == "string"
            if len(e["datacontenttype"]) > 0
                h["content-type"] = e["datacontenttype"]
    h

// Reconstruct a CloudEvent dict from inbound binary-mode HTTP headers + the raw body. The reverse of
// cloudevent_to_headers: "ce-<attr>" headers become context attributes, "content-type" becomes
// datacontenttype, and the body becomes `data`. Does NOT validate -- call cloudevent_valid on the result.
fn cloudevent_from_headers(headers: dict, body: any) -> dict
    let e = {}
    let attrs = ["specversion", "id", "source", "type", "subject", "time"]
    for a in attrs
        let hk = "ce-" + a
        if hk in headers
            e[a] = headers[hk]
    if "content-type" in headers
        e["datacontenttype"] = headers["content-type"]
    e["data"] = body
    e
