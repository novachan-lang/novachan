// forge_idempotency_store — Prevent duplicate request processing.

fn ids_new(ttl: int) -> dict
    {"keys": {}, "timestamps": {}, "results": {}, "count": 0, "ttl": ttl, "hits": 0, "misses": 0}

fn ids_check(s: dict, key: string, now: int) -> dict
    let r = {}
    if key in s["keys"]
        let ts = s["timestamps"][key]
        if now - ts <= s["ttl"]
            s["hits"] += 1
            r["duplicate"] = 1
            r["result"] = s["results"][key]
            r["s"] = s
            return r
    s["misses"] += 1
    r["duplicate"] = 0
    r["result"] = ""
    r["s"] = s
    r

fn ids_store(s: dict, key: string, result: string, now: int) -> dict
    s["keys"][key] = 1
    s["timestamps"][key] = now
    s["results"][key] = result
    s["count"] += 1
    s

fn ids_evict(s: dict, key: string) -> dict
    s["keys"][key] = 0
    s

fn ids_count(s: dict) -> int
    s["count"]

fn ids_hit_rate(s: dict) -> int
    let total = s["hits"] + s["misses"]
    if total == 0
        return 0
    s["hits"] * 100 / total
