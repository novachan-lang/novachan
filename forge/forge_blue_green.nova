// forge_blue_green — Blue/green deployment management.
// Track two environments, swap traffic, rollback.

fn bg_new() -> dict
    let bg = {}
    bg["active"] = "blue"
    bg["blue_version"] = ""
    bg["green_version"] = ""
    bg["blue_healthy"] = 1
    bg["green_healthy"] = 1
    bg["swaps"] = 0
    bg["history"] = []
    bg

fn bg_deploy(bg: dict, env: string, version: string) -> dict
    if env == "blue"
        bg["blue_version"] = version
    if env == "green"
        bg["green_version"] = version
    let entry = {}
    entry["action"] = "deploy"
    entry["env"] = env
    entry["version"] = version
    push(bg["history"], entry)
    bg

fn bg_swap(bg: dict) -> dict
    if bg["active"] == "blue"
        bg["active"] = "green"
    else
        bg["active"] = "blue"
    bg["swaps"] = bg["swaps"] + 1
    let entry = {}
    entry["action"] = "swap"
    entry["to"] = bg["active"]
    push(bg["history"], entry)
    bg

fn bg_rollback(bg: dict) -> dict
    bg = bg_swap(bg)
    bg

fn bg_active_env(bg: dict) -> string
    bg["active"]

fn bg_active_version(bg: dict) -> string
    if bg["active"] == "blue"
        return bg["blue_version"]
    bg["green_version"]

fn bg_inactive_env(bg: dict) -> string
    if bg["active"] == "blue"
        return "green"
    "blue"

fn bg_set_health(bg: dict, env: string, healthy: int) -> dict
    if env == "blue"
        bg["blue_healthy"] = healthy
    if env == "green"
        bg["green_healthy"] = healthy
    bg

fn bg_is_healthy(bg: dict, env: string) -> int
    if env == "blue"
        return bg["blue_healthy"]
    if env == "green"
        return bg["green_healthy"]
    0

fn bg_swap_count(bg: dict) -> int
    bg["swaps"]

fn bg_history_count(bg: dict) -> int
    len(bg["history"])
