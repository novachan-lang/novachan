// forge_cookie -- Set-Cookie SERIALIZATION + Cookie-header PARSING with the security attributes every session
// cookie needs (HttpOnly, Secure, SameSite, Max-Age, Path, Domain). Forge's core cookie_get reads a REQUEST
// cookie; this builds the RESPONSE Set-Cookie header correctly -- the difference between a session that is
// XSS/CSRF-hardened and one that silently leaks. `opts` is a dict; omitted attributes are skipped.
// The value is NOT auto-encoded (pass an already-safe token, or forge_qs qs_encode arbitrary bytes). LEAF.

// Serialize a Set-Cookie header value. opts keys (all optional): "max_age" (int seconds), "path", "domain",
// "same_site" ("Strict"/"Lax"/"None"), "http_only" (bool), "secure" (bool).
fn cookie_serialize(name: string, value: string, opts: dict) -> string
    let out = "{name}={value}"
    if "max_age" in opts
        let ma = opts["max_age"]
        out += "; Max-Age={ma}"
    if "path" in opts
        let p = opts["path"]
        out += "; Path={p}"
    if "domain" in opts
        let d = opts["domain"]
        out += "; Domain={d}"
    if "same_site" in opts
        let ss = opts["same_site"]
        out += "; SameSite={ss}"
    if "http_only" in opts
        if opts["http_only"]
            out += "; HttpOnly"
    if "secure" in opts
        if opts["secure"]
            out += "; Secure"
    out

// A hardened session cookie: HttpOnly + Secure + SameSite=Lax + Path=/ with a max age. The safe default for
// auth/session tokens -- blocks JS access (XSS), HTTPS-only, CSRF-resistant.
fn cookie_session(name: string, value: string, max_age: int) -> string
    cookie_serialize(name, value, {"max_age": max_age, "path": "/", "same_site": "Lax", "http_only": true, "secure": true})

// A cookie that deletes `name` on the client (empty value, Max-Age=0).
fn cookie_delete(name: string) -> string
    cookie_serialize(name, "", {"max_age": 0, "path": "/"})

// Parse a Cookie REQUEST header ("a=1; b=2; c=3") into a dict. Trimmed; a pair with no '=' maps to "".
fn cookie_parse(header: string) -> dict
    let out = {}
    if len(header) == 0
        return out
    let parts = split(header, ";")
    for i in 0..len(parts)
        let p = trim(parts[i])
        if len(p) > 0
            let eq = find(p, "=")
            if eq < 0
                out[p] = ""
            else
                out[trim(slice(p, 0, eq))] = trim(slice(p, eq + 1, len(p)))
    out
