// forge_config -- S14: externalized configuration + PROFILES + a lightweight DI service-registry + a
// request-scoped context. This is the "batteries-included" foundation Spring gives via @Configuration
// Properties/@Profile/the IoC container -- but delivered the NOVA way: explicit typed access + HOF wiring,
// NO reflective auto-wiring, NO annotation processor, NO hidden costs.
//
// CONFIG: a plain dict of string values. Layer sources by precedence (base < profile-overlay < env). Read
// with typed getters. TYPED STRUCT BINDING composes with the typed-extraction keystone:
//   let c: AppConfig = from_json_safe(json_stringify(cfg))   // dict -> typed struct, defaults on missing.
//
// PROFILES: config_profile() reads NOVA_PROFILE (dev/test/prod, default "dev"); config_for_profile overlays
// the profile-specific values onto the base.
//
// DI ERGONOMIC: a registry wires named components once at startup (app-scoped singletons); resolve them
// anywhere without a global. A ctx carries request-scoped values (user, tenant, trace id, deadline) through
// the handler chain. Both are just dicts + typed accessors -- explicit, race-free (a registry is built once
// and read-only after; a ctx is per-request, never shared).
//
// LEAF MODULE -- imports NOTHING. Built-ins: env, contains, keys, parse_int, len.

// ── configuration ──────────────────────────────────────────────────────────────────────────────────
fn config_new() -> dict
    {}

fn config_set(cfg: dict, key: string, value: string) -> dict
    cfg[key] = value
    cfg

fn config_get(cfg: dict, key: string, default: string) -> string
    if contains(cfg, key)
        return cfg[key]
    default

fn config_get_int(cfg: dict, key: string, default: int) -> int
    if contains(cfg, key)
        return parse_int(cfg[key])
    default

fn config_get_bool(cfg: dict, key: string, default: bool) -> bool
    if contains(cfg, key)
        let v = cfg[key]
        return v == "true" or v == "1" or v == "yes" or v == "on"
    default

// Merge env vars named in `keys` into cfg (env WINS -- the externalized-config precedence rule). A key with
// an empty/unset env value is skipped (keeps the base/profile value).
fn config_from_env(cfg: dict, names: list) -> dict
    let i = 0
    while i < len(names)
        let k = names[i]
        let v = env(k)
        if len(v) > 0
            cfg[k] = v
        i = i + 1
    cfg

// ── profiles ───────────────────────────────────────────────────────────────────────────────────────
// The active profile from NOVA_PROFILE (dev/test/prod, ...), default "dev".
fn config_profile() -> string
    let p = env("NOVA_PROFILE")
    if len(p) == 0
        return "dev"
    p

// Overlay `overlay` onto `base` (overlay wins) -> a NEW merged dict (inputs unmutated). The profile primitive.
fn config_merge(base: dict, overlay: dict) -> dict
    let out = {}
    for k in keys(base)
        out[k] = base[k]
    for k in keys(overlay)
        out[k] = overlay[k]
    out

// Select the effective config for a profile: base overlaid with profiles[profile] (if that profile exists).
//   config_for_profile(base, {"prod": prodOverrides}, config_profile())
fn config_for_profile(base: dict, profiles: dict, profile: string) -> dict
    if contains(profiles, profile)
        return config_merge(base, profiles[profile])
    base

// ── service registry (app-scoped singletons) — the DI ergonomic, no reflection ───────────────────────
fn registry_new() -> dict
    {}

// Register a named component (a service value: a db pool, a client, a config, a fn). Fluent.
fn provide(reg: dict, name: string, service) -> dict
    reg[name] = service
    reg

fn has_service(reg: dict, name: string) -> bool
    contains(reg, name)

// Resolve a component by name (the caller knows the type). Use has_service first if it may be absent.
fn resolve(reg: dict, name: string) -> any
    reg[name]

// ── request-scoped context ───────────────────────────────────────────────────────────────────────────
// A fresh ctx per request carries scoped values (current_user, tenant, trace id, deadline) through the
// handler + service chain without a global. Born per-request -> never shared across processes.
fn ctx_new() -> dict
    {}

fn ctx_set(ctx: dict, key: string, value) -> dict
    ctx[key] = value
    ctx

fn ctx_get(ctx: dict, key: string, default) -> any
    if contains(ctx, key)
        return ctx[key]
    default

fn ctx_has(ctx: dict, key: string) -> bool
    contains(ctx, key)
