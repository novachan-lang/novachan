// forge_distance_calc — Distance calculations with Result.

fn dc_manhattan(x1: int, y1: int, x2: int, y2: int) -> int
    abs(x2 - x1) + abs(y2 - y1)

fn dc_chebyshev(x1: int, y1: int, x2: int, y2: int) -> int
    let dx = abs(x2 - x1)
    let dy = abs(y2 - y1)
    dx if dx > dy else dy

fn dc_squared(x1: int, y1: int, x2: int, y2: int) -> int
    let dx = x2 - x1
    let dy = y2 - y1
    dx * dx + dy * dy

fn dc_within_radius(x1: int, y1: int, x2: int, y2: int, radius: int) -> int
    let sq = dc_squared(x1, y1, x2, y2)
    if sq <= radius * radius
        return 1
    0

fn dc_nearest(x: int, y: int, points: dict, count: int) -> Result
    if count == 0
        return err("no points")
    let best = ""
    let best_dist = 999999999
    for i in 0..count
        let k = str(i)
        let px = points[k + "_x"]
        let py = points[k + "_y"]
        let d = dc_squared(x, y, px, py)
        if d < best_dist
            best_dist = d
            best = points[k + "_name"]
    ok(best)
