// forge_bech32 -- Bech32 encoding (BIP 173): the checksummed base-32 format behind SegWit Bitcoin addresses
// (bc1...), Lightning BOLT11 invoices, Nostr npub keys, and Cosmos addresses. Unlike Base58Check's double-
// SHA-256 checksum, Bech32 uses a 6-symbol BCH code over GF(32) that detects (and can locate) more error
// types and is case-insensitive. This module builds a Bech32 string from a human-readable part (hrp) and a
// list of 5-bit data values. Verified against the BIP 173 test vectors. LEAF -- imports NOTHING.
//
// RAISED 2026-08-05. Five problems:
//
//   1. _bech32_polymod used `while j < 5`. for-in range.
//   2. _bech32_hrp_expand used two while-index loops. Comprehensions.
//   3. _bech32_checksum had a dead binding `let out = [...]; out`. Inlined.
//   4. bech32_encode copied data/chk into combined via two for-index+push loops. Spread operator.
//   5. bech32_encode used quadratic `out += char_at(...)`. Parts list + join.

fn _bech32_charset() -> string
    "qpzry9x8gf2tvdw0s3jn54khce6mua7l"

fn _bech32_pow2(e: int) -> int
    let p = 1
    for i in 0..e
        p = p * 2
    p

fn _bech32_polymod(values: list) -> int
    let gen = [996825010, 642813549, 513874426, 1027748829, 705979059]
    let chk = 1
    for i in 0..len(values)
        let b = chk / 33554432
        chk = ((chk % 33554432) * 32) ^ values[i]
        for j in 0..5
            if ((b / _bech32_pow2(j)) & 1) != 0
                chk = chk ^ gen[j]
    chk

fn _bech32_hrp_expand(hrp: string) -> list
    let hi = [ord(char_at(hrp, i)) / 32 for i in 0..len(hrp)]
    let lo = [ord(char_at(hrp, i)) & 31 for i in 0..len(hrp)]
    [...hi, 0, ...lo]

fn _bech32_checksum(hrp: string, data: list) -> list
    let values = [..._bech32_hrp_expand(hrp), ...data, 0, 0, 0, 0, 0, 0]
    let polymod = _bech32_polymod(values) ^ 1
    [(polymod / _bech32_pow2(5 * (5 - p))) & 31 for p in 0..6]

fn bech32_encode(hrp: string, data: list) -> string
    let cs = _bech32_charset()
    let combined = [...data, ..._bech32_checksum(hrp, data)]
    let parts = [char_at(cs, combined[i]) for i in 0..len(combined)]
    "{hrp}1{join(parts, "")}"
