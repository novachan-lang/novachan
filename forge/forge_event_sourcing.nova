// forge_event_sourcing — Event sourcing: append events, replay to build state.

fn es_new(stream: string) -> dict
    let es = {}
    es["stream"] = stream
    es["events"] = {}
    es["event_count"] = 0
    es["version"] = 0
    es

fn es_append(es: dict, event_type: string, data: string) -> dict
    let idx = es["event_count"]
    let k = str(idx)
    es["events"][k + "_type"] = event_type
    es["events"][k + "_data"] = data
    es["events"][k + "_version"] = es["version"] + 1
    es["event_count"] = idx + 1
    es["version"] = es["version"] + 1
    es

fn es_event_count(es: dict) -> int
    es["event_count"]

fn es_version(es: dict) -> int
    es["version"]

fn es_event_type(es: dict, index: int) -> string
    if index < 0
        return ""
    if index >= es["event_count"]
        return ""
    es["events"][str(index) + "_type"]

fn es_event_data(es: dict, index: int) -> string
    if index < 0
        return ""
    if index >= es["event_count"]
        return ""
    es["events"][str(index) + "_data"]

fn es_events_since(es: dict, from_version: int) -> dict
    let result = {}
    let count = 0
    let i = 0
    while i < es["event_count"]
        let v = es["events"][str(i) + "_version"]
        if v > from_version
            result[str(count) + "_type"] = es["events"][str(i) + "_type"]
            result[str(count) + "_data"] = es["events"][str(i) + "_data"]
            count = count + 1
        i = i + 1
    result["count"] = count
    result

fn es_stream_name(es: dict) -> string
    es["stream"]
