// forge_event_sourcing — event sourcing with Result API.

fn es_new() -> dict
    {"events": {}, "event_count": 0, "snapshots": {}, "snap_count": 0}

fn es_append(e: dict, stream: string, event_type: string, data: string) -> dict
    let key = "ev_" + str(e["event_count"])
    e["events"][key + "_stream"] = stream
    e["events"][key + "_type"] = event_type
    e["events"][key + "_data"] = data
    e["event_count"] += 1
    e

fn es_get_event(e: dict, idx: int) -> Result
    if idx < 0 or idx >= e["event_count"]
        return err("index out of range")
    let key = "ev_" + str(idx)
    ok(e["events"][key + "_type"] + ":" + e["events"][key + "_data"])

fn es_stream_count(e: dict, stream: string) -> int
    let count = 0
    for i in 0..e["event_count"]
        let key = "ev_" + str(i)
        if e["events"][key + "_stream"] == stream
            count += 1
    count

fn es_save_snapshot(e: dict, stream: string, state: string) -> dict
    let key = "snap_" + stream
    e["snapshots"][key] = state
    e["snap_count"] += 1
    e

fn es_load_snapshot(e: dict, stream: string) -> Result
    let key = "snap_" + stream
    if key not in e["snapshots"]
        return err("no snapshot for: " + stream)
    ok(e["snapshots"][key])

fn es_event_count(e: dict) -> int
    e["event_count"]
