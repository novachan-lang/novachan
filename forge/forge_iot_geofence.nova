// forge_iot_geofence — Circular geofencing for IoT devices (Edge).
//
// NOTE ON NAMING: forge/forge_geo_fence.nova already exists (rectangular
// zones, gf_contains/gf_zones_at API) and is wired into
// nova-compiler/lib + test_programs/_kat_geo_fence.nova. This module
// covers a different spec (circular zones, gf_check -> Result
// "inside"/"outside", gf_nearest_zone, event counters) that collides on
// the gf_* prefix with different signatures, so it lives under a
// distinct module name to avoid breaking the existing module's callers.
//
// Distance is compared as squared Euclidean distance (no sqrt / floats):
// a point is "inside" a zone iff dist_sq <= radius*radius.

fn gf_new() -> dict
    let s = {}
    s["zone_names"] = []
    s["zone_lat"] = {}
    s["zone_lon"] = {}
    s["zone_radius"] = {}
    s["inside_counts"] = {}
    s["events"] = 0
    s

fn _gf_key(zone_name: string) -> string
    "z_" + zone_name

fn _gf_dist_sq(lat1: int, lon1: int, lat2: int, lon2: int) -> int
    let dlat = lat1 - lat2
    let dlon = lon1 - lon2
    (dlat * dlat) + (dlon * dlon)

fn gf_add_zone(s: dict, zone_name: string, center_lat: int, center_lon: int, radius: int) -> dict
    let key = _gf_key(zone_name)
    let has = contains(s["zone_lat"], key)
    if has != true
        push(s["zone_names"], zone_name)
        s["inside_counts"][key] = 0
    s["zone_lat"][key] = center_lat
    s["zone_lon"][key] = center_lon
    s["zone_radius"][key] = radius
    s

fn gf_has_zone(s: dict, zone_name: string) -> int
    let key = _gf_key(zone_name)
    let has = contains(s["zone_lat"], key)
    if has == true
        return 1
    0

fn gf_zone_count(s: dict) -> int
    len(s["zone_names"])

fn gf_zone_radius(s: dict, zone_name: string) -> Result
    let key = _gf_key(zone_name)
    let has = contains(s["zone_lat"], key)
    if has != true
        return err("zone not found: " + zone_name)
    ok(s["zone_radius"][key])

fn gf_check(s: dict, zone_name: string, lat: int, lon: int) -> Result
    let key = _gf_key(zone_name)
    let has = contains(s["zone_lat"], key)
    if has != true
        return err("zone not found: " + zone_name)
    s["events"] = s["events"] + 1
    let dsq = _gf_dist_sq(lat, lon, s["zone_lat"][key], s["zone_lon"][key])
    let rad = s["zone_radius"][key]
    if dsq <= (rad * rad)
        s["inside_counts"][key] = s["inside_counts"][key] + 1
        return ok("inside")
    ok("outside")

fn gf_nearest_zone(s: dict, lat: int, lon: int) -> Result
    if len(s["zone_names"]) == 0
        return err("no zones")
    let best_name = ""
    let best_dsq = 0
    let i = 0
    while i < len(s["zone_names"])
        let name = s["zone_names"][i]
        let key = _gf_key(name)
        let dsq = _gf_dist_sq(lat, lon, s["zone_lat"][key], s["zone_lon"][key])
        if i == 0
            best_name = name
            best_dsq = dsq
        else
            if dsq < best_dsq
                best_name = name
                best_dsq = dsq
        i = i + 1
    ok(best_name)

fn gf_events(s: dict) -> int
    s["events"]

fn gf_inside_count(s: dict, zone_name: string) -> Result
    let key = _gf_key(zone_name)
    let has = contains(s["zone_lat"], key)
    if has != true
        return err("zone not found: " + zone_name)
    ok(s["inside_counts"][key])
