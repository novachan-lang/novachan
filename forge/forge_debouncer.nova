// forge_debouncer — event debouncing with configurable delay and Result API.

fn db_new(delay: int) -> dict
    {"delay": delay, "last_times": {}, "total_calls": 0, "total_accepted": 0, "total_rejected": 0}

fn db_call(d: dict, key: string, now: int) -> Result
    d["total_calls"] += 1
    let tk = "t_" + key
    if tk not in d["last_times"]
        d["last_times"][tk] = now
        d["total_accepted"] += 1
        return ok("accepted")
    let elapsed = now - d["last_times"][tk]
    if elapsed < d["delay"]
        d["total_rejected"] += 1
        return err("debounced")
    d["last_times"][tk] = now
    d["total_accepted"] += 1
    ok("accepted")

fn db_reset(d: dict, key: string) -> dict
    let tk = "t_" + key
    if tk in d["last_times"]
        d["last_times"][tk] = 0
    d

fn db_total_calls(d: dict) -> int
    d["total_calls"]

fn db_acceptance_rate(d: dict) -> int
    if d["total_calls"] == 0
        return 0
    d["total_accepted"] * 100 / d["total_calls"]
