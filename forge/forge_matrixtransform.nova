// forge_matrixtransform -- the everyday geometric transforms of a 2-D grid: rotate it 90 degrees, transpose it,
// mirror it, and read it out in spiral order. These are the operations you reach for constantly when a matrix
// represents a PICTURE or a BOARD rather than a system of equations (that's forge_matrix): rotating a sprite or
// photo, flipping a tile, turning a game board a quarter-turn, transposing rows and columns of a table, or walking
// a grid in spiral order to serialize/print it or scan an image outward. Each returns a NEW matrix (or list),
// leaving the input untouched, and they compose -- two 90-degree rotations give 180, transpose-then-flip gives a
// rotation, and so on. Rows may be any equal length; elements are any values. LEAF -- imports NOTHING.

// The transpose: element [i][j] becomes [j][i] (rows and columns swapped). An R x C matrix becomes C x R.
fn transpose(m: list) -> list
    let r = len(m)
    let c = 0
    if r > 0
        c = len(m[0])
    let out = []
    for j in 0..c
        let row = [m[i][j] for i in 0..r]
        push(out, row)
    out

// Rotate the matrix 90 degrees CLOCKWISE. [[1,2],[3,4]] -> [[3,1],[4,2]].
fn rotate_cw(m: list) -> list
    let r = len(m)
    let c = 0
    if r > 0
        c = len(m[0])
    let out = []
    for j in 0..c
        let row = [m[r - 1 - k][j] for k in 0..r]
        push(out, row)
    out

// Rotate the matrix 90 degrees COUNTER-clockwise. [[1,2],[3,4]] -> [[2,4],[1,3]].
fn rotate_ccw(m: list) -> list
    let r = len(m)
    let c = 0
    if r > 0
        c = len(m[0])
    let out = []
    for j in 0..c
        let row = [m[k][c - 1 - j] for k in 0..r]
        push(out, row)
    out

// Mirror the matrix left-to-right (reverse each row).
fn flip_horizontal(m: list) -> list
    let out = []
    for i in 0..len(m)
        let row = []
        let j = len(m[i]) - 1
        while j >= 0
            push(row, m[i][j])
            j -= 1
        push(out, row)
    out

// Mirror the matrix top-to-bottom (reverse the row order).
fn flip_vertical(m: list) -> list
    let out = []
    let i = len(m) - 1
    while i >= 0
        let row = [m[i][j] for j in 0..len(m[i])]
        push(out, row)
        i -= 1
    out

// Read the matrix in clockwise SPIRAL order starting at the top-left, as a flat list.
// [[1,2,3],[4,5,6],[7,8,9]] -> [1,2,3,6,9,8,7,4,5].
fn spiral(m: list) -> list
    let out = []
    let r = len(m)
    if r > 0
        let c = len(m[0])
        let top = 0
        let bottom = r - 1
        let left = 0
        let right = c - 1
        while top <= bottom and left <= right
            for cc in left..(right + 1)
                push(out, m[top][cc])
            top += 1
            for rr in top..(bottom + 1)
                push(out, m[rr][right])
            right -= 1
            if top <= bottom
                let cb = right
                while cb >= left
                    push(out, m[bottom][cb])
                    cb -= 1
                bottom -= 1
            if left <= right
                let rl = bottom
                while rl >= top
                    push(out, m[rl][left])
                    rl -= 1
                left += 1
    out
