// forge_softmax -- turn a vector of raw scores ("logits") into a probability distribution that sums to 1. This
// is the last step of almost every classifier and neural network: the model outputs unbounded scores per class,
// and softmax converts them to calibrated probabilities (bigger score -> bigger probability, but every option
// keeps some mass). Use it to get confidence values out of forge_bayes/knn-style scores, to sample weighted by
// score, or with a TEMPERATURE to make the distribution softer (more exploratory) or sharper (more greedy) --
// the same knob LLM sampling exposes. It subtracts the max score first for numerical stability, so huge inputs
// don't overflow. Scores are numbers; the result is floats in (0,1) that sum to 1. LEAF -- imports NOTHING.

// The index of the largest score (first on ties). -1 for an empty list.
fn argmax(scores: list) -> int
    let best = 0 - 1
    if len(scores) > 0
        best = 0
        let bestv = scores[0] * 1.0
        let i = 1
        while i < len(scores)
            let v = scores[i] * 1.0
            if v > bestv
                bestv = v
                best = i
            i = i + 1
    best

// Softmax: exp(x_i - max) / sum_j exp(x_j - max). Returns a probability vector summing to 1.
fn softmax(scores: list) -> list
    let out = []
    let n = len(scores)
    if n > 0
        // max for numerical stability
        let mx = scores[0] * 1.0
        let i = 1
        while i < n
            let v = scores[i] * 1.0
            if v > mx
                mx = v
            i = i + 1
        // sum of exp(x - max) -- exp inline into the accumulator
        let sumexp = 0.0
        let j = 0
        while j < n
            sumexp = sumexp + exp(scores[j] * 1.0 - mx)
            j = j + 1
        // normalize -- exp inline in the division (never stored in a local)
        let k = 0
        while k < n
            let p = 0.0
            if sumexp > 0.0
                p = exp(scores[k] * 1.0 - mx) / sumexp
            push(out, p)
            k = k + 1
    out

// Softmax with a temperature: scores are divided by `temp` first. temp > 1 softens (more uniform), temp < 1
// sharpens (more peaked), temp -> 0 approaches argmax. temp must be > 0.
fn softmax_temperature(scores: list, temp: float) -> list
    let scaled = []
    let t = temp * 1.0
    let i = 0
    while i < len(scores)
        let s = scores[i] * 1.0
        if t > 0.0
            s = s / t
        push(scaled, s)
        i = i + 1
    softmax(scaled)

// The probability the softmax assigns to the top-scoring option (its confidence). 0.0 for empty input.
fn softmax_confidence(scores: list) -> float
    let probs = softmax(scores)
    let out = 0.0
    let i = 0
    while i < len(probs)
        let p = probs[i] * 1.0
        if p > out
            out = p
        i = i + 1
    out
