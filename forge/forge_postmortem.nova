fn pm_new()
    let s = {}
    s["pm_count"] = 0
    s["pm_ids"] = ""
    s["total_actions"] = 0
    return s

fn pm_create(s, pm_id, title, severity, owner)
    let idx = int(s["pm_count"])
    s["pm_" + str(idx) + "_id"] = pm_id
    s["pm_" + str(idx) + "_title"] = title
    s["pm_" + str(idx) + "_severity"] = severity
    s["pm_" + str(idx) + "_owner"] = owner
    s["pm_" + str(idx) + "_status"] = "open"
    s["pm_" + str(idx) + "_action_count"] = 0
    s["pm_" + str(idx) + "_root_cause"] = ""
    s["pm_count"] = idx + 1
    if s["pm_ids"] == ""
        s["pm_ids"] = pm_id
    else
        s["pm_ids"] = str(s["pm_ids"]) + "," + pm_id
    return s

fn _pm_find(s, pm_id)
    let cnt = int(s["pm_count"])
    let i = 0
    while i < cnt
        if str(s["pm_" + str(i) + "_id"]) == pm_id
            return i
        i = i + 1
    return -1

fn pm_set_root_cause(s, pm_id, cause) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    s["pm_" + str(pi) + "_root_cause"] = cause
    return ok(s)

fn pm_add_action(s, pm_id, action_desc, assignee) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    let aidx = int(s["pm_" + str(pi) + "_action_count"])
    let prefix = "pm_" + str(pi) + "_act_" + str(aidx)
    s[prefix + "_desc"] = action_desc
    s[prefix + "_assignee"] = assignee
    s[prefix + "_done"] = 0
    s["pm_" + str(pi) + "_action_count"] = aidx + 1
    s["total_actions"] = int(s["total_actions"]) + 1
    return ok(s)

fn pm_complete_action(s, pm_id, action_index) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    let cnt = int(s["pm_" + str(pi) + "_action_count"])
    if action_index < 0 or action_index >= cnt
        return err("action index out of range")
    s["pm_" + str(pi) + "_act_" + str(action_index) + "_done"] = 1
    return ok(s)

fn pm_close(s, pm_id) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    s["pm_" + str(pi) + "_status"] = "closed"
    return ok(s)

fn pm_status(s, pm_id) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    return ok(str(s["pm_" + str(pi) + "_status"]))

fn pm_root_cause(s, pm_id) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    let rc = str(s["pm_" + str(pi) + "_root_cause"])
    if rc == ""
        return err("root cause not set")
    return ok(rc)

fn pm_action_count(s, pm_id) -> Result
    let pi = _pm_find(s, pm_id)
    if pi < 0
        return err("postmortem not found: " + pm_id)
    return ok(int(s["pm_" + str(pi) + "_action_count"]))

fn pm_count(s)
    return int(s["pm_count"])

fn pm_total_actions(s)
    return int(s["total_actions"])

fn pm_id_list(s)
    return str(s["pm_ids"])

fn pm_has(s, pm_id)
    let pi = _pm_find(s, pm_id)
    if pi >= 0
        return 1
    return 0
