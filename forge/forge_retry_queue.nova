// forge_retry_queue — Retry queue with backoff tracking.
// Queue failed items with attempt count, backoff delay, max attempts.

fn rq_new(max_attempts: int, base_delay: int) -> dict
    {"items": [], "max_attempts": max_attempts, "base_delay": base_delay, "exhausted": 0, "succeeded": 0}

fn rq_add(rq: dict, item_id: string, payload: string) -> dict
    push(rq["items"], {"id": item_id, "payload": payload, "attempts": 0, "next_retry_at": 0, "status": "queued"})
    rq

fn rq_attempt(rq: dict, item_id: string, now: int) -> dict
    for i in 0..len(rq["items"])
        if rq["items"][i]["id"] == item_id
            rq["items"][i]["attempts"] += 1
            if rq["items"][i]["attempts"] >= rq["max_attempts"]
                rq["items"][i]["status"] = "exhausted"
                rq["exhausted"] += 1
            else
                let delay = rq["base_delay"] * rq["items"][i]["attempts"]
                rq["items"][i]["next_retry_at"] = now + delay
                rq["items"][i]["status"] = "waiting"
            return rq
    rq

fn rq_mark_success(rq: dict, item_id: string) -> dict
    let new_items = [it for it in rq["items"] if it["id"] != item_id]
    rq["succeeded"] += len(rq["items"]) - len(new_items)
    rq["items"] = new_items
    rq

fn rq_ready_count(rq: dict, now: int) -> int
    let count = 0
    for i in 0..len(rq["items"])
        if rq["items"][i]["status"] == "queued"
            count += 1
        if rq["items"][i]["status"] == "waiting"
            if now >= rq["items"][i]["next_retry_at"]
                count += 1
    count

fn rq_queue_size(rq: dict) -> int
    len(rq["items"])

fn rq_total_exhausted(rq: dict) -> int
    rq["exhausted"]

fn rq_total_succeeded(rq: dict) -> int
    rq["succeeded"]

fn rq_get_attempts(rq: dict, item_id: string) -> int
    for i in 0..len(rq["items"])
        if rq["items"][i]["id"] == item_id
            return rq["items"][i]["attempts"]
    0
