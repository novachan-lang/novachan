// forge_setsim -- set-based similarity metrics between two documents/token lists: Jaccard, Sorensen-Dice, and
// the overlap coefficient. Where forge_cosine compares term-FREQUENCY vectors, these compare SET membership
// (does a term appear at all), which is what you want for tag/keyword similarity, shingled near-duplicate
// detection, and recommendation overlap. All three are in [0,1]. LEAF -- imports NOTHING.

// PRIVATE: the set of distinct tokens as a dict (token -> 1).
fn _set_of(tokens: list) -> dict
    {t: 1 for t in tokens}

// PRIVATE: number of tokens present in BOTH sets.
fn _inter_size(a: dict, b: dict) -> int
    len([k for k in keys(a) if k in b])

// Jaccard index |A intersect B| / |A union B|. 0.0 when both sets are empty.
fn jaccard(a: list, b: list) -> float
    let sa = _set_of(a)
    let sb = _set_of(b)
    let inter = _inter_size(sa, sb)
    let union = len(keys(sa)) + len(keys(sb)) - inter
    if union == 0
        return 0.0
    (inter * 1.0) / (union * 1.0)

// Sorensen-Dice coefficient 2|A intersect B| / (|A| + |B|). Weights the intersection more than Jaccard.
fn dice_coef(a: list, b: list) -> float
    let sa = _set_of(a)
    let sb = _set_of(b)
    let inter = _inter_size(sa, sb)
    let total = len(keys(sa)) + len(keys(sb))
    if total == 0
        return 0.0
    (2.0 * inter) / (total * 1.0)

// Overlap (Szymkiewicz-Simpson) coefficient |A intersect B| / min(|A|, |B|). 1.0 when one set is a subset of
// the other -- good for "is this a specialization of that".
fn overlap_coef(a: list, b: list) -> float
    let sa = _set_of(a)
    let sb = _set_of(b)
    let inter = _inter_size(sa, sb)
    let ua = len(keys(sa))
    let ub = len(keys(sb))
    let mn = ua if ua < ub else ub
    if mn == 0
        return 0.0
    (inter * 1.0) / (mn * 1.0)
