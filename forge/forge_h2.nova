// ══════════════════════════════════════════════════════════════════════════════
// forge_h2 — HTTP/2 frame codec (RFC 7540 §4-6). LEAF module (byte-list based, no sockets/forge dep).
// The 9-octet frame header: Length(24) | Type(8) | Flags(8) | R(1)+StreamID(31), big-endian, followed by
// the payload. Plus the connection preface and the frame-type/flag constants. HPACK (forge_hpack) supplies
// the HEADERS payload; serve_h2 (later) drives these over the netpoller. See NOVA_DESIGN/HTTP2_PLAN.md.
// ══════════════════════════════════════════════════════════════════════════════

// Frame types (RFC 7540 §6).
fn h2_DATA() -> int
    0
fn h2_HEADERS() -> int
    1
fn h2_RST_STREAM() -> int
    3
fn h2_SETTINGS() -> int
    4
fn h2_PING() -> int
    6
fn h2_GOAWAY() -> int
    7
fn h2_WINDOW_UPDATE() -> int
    8

// Flags (RFC 7540 §6): END_STREAM=0x1 (DATA/HEADERS), END_HEADERS=0x4 (HEADERS), ACK=0x1 (SETTINGS/PING).
fn h2_END_STREAM() -> int
    1
fn h2_END_HEADERS() -> int
    4
fn h2_ACK() -> int
    1

// The client connection preface (RFC 7540 §3.5). The server reads exactly this before the first frame.
fn h2_preface() -> string
    "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

// ── Big-endian octet encoders ──────────────────────────────────────────────────────────────────────────
// Every multi-octet field in this file is a big-endian integer split by /,& -- previously open-coded at
// each of the four use sites, with the 31-bit form (top bit reserved, RFC 7540 §4.1/§6.9) written twice.
// One named encoder per width, used everywhere.

// PRIVATE: 3 octets — a frame's 24-bit Length field.
fn _h2_be24(v: int) -> list
    return [(v / 65536) & 255, (v / 256) & 255, v & 255]

// PRIVATE: 2 octets — a 16-bit SETTINGS identifier.
fn _h2_be16(v: int) -> list
    return [(v / 256) & 255, v & 255]

// PRIVATE: 4 octets — a 31-bit value with the reserved top bit CLEARED (a frame header's stream id, and a
// WINDOW_UPDATE increment).
fn _h2_be31(v: int) -> list
    return [(v / 16777216) & 127, (v / 65536) & 255, (v / 256) & 255, v & 255]

// PRIVATE: 4 octets — a full 32-bit value (a SETTINGS value).
fn _h2_be32(v: int) -> list
    return [(v / 16777216) & 255, (v / 65536) & 255, (v / 256) & 255, v & 255]

// Encode one frame: the 9-octet header (length = len(payload)) followed by the payload bytes.
fn h2_frame(ftype: int, flags: int, stream_id: int, payload: list) -> list
    return [..._h2_be24(len(payload)), ftype & 255, flags & 255, ..._h2_be31(stream_id), ...payload]

// Parse one frame from `buf` at `off`. Returns [ftype, flags, stream_id, payload_off, payload_len, next_off],
// or [] if fewer than a full frame (header + declared payload) is available yet (caller reads more).
// NOTE: `[]` here means "not enough bytes yet", a normal streaming outcome, NOT a failure -- so it stays a
// list rather than becoming err(..). Turning it into a Result would also break every caller.
fn h2_frame_parse(buf: list, off: int) -> list
    if off + 9 > len(buf)
        return []
    let length = buf[off] * 65536 + buf[off + 1] * 256 + buf[off + 2]
    let ftype = buf[off + 3]
    let flags = buf[off + 4]
    let sid = (buf[off + 5] & 127) * 16777216 + buf[off + 6] * 65536 + buf[off + 7] * 256 + buf[off + 8]
    let payoff = off + 9
    if payoff + length > len(buf)
        return []
    return [ftype, flags, sid, payoff, length, payoff + length]

// Extract a frame's payload bytes (given a parse result).
fn h2_payload(buf: list, parsed: list) -> list
    return [buf[parsed[3] + i] for i in 0..parsed[4]]

// A SETTINGS frame from [id, value] pairs (each id is 16-bit, value 32-bit; RFC 7540 §6.5). ACK is a
// zero-length SETTINGS with the ACK flag.
fn h2_settings(pairs: list) -> list
    return h2_frame(h2_SETTINGS(), 0, 0, flatten([[..._h2_be16(p[0]), ..._h2_be32(p[1])] for p in pairs]))

// WINDOW_UPDATE frame (RFC 7540 §6.9): a 31-bit increment on the given stream (0 = connection-level).
fn h2_window_update(stream_id: int, increment: int) -> list
    return h2_frame(h2_WINDOW_UPDATE(), 0, stream_id, _h2_be31(increment))

// ── Flow control (RFC 7540 §6.9) ───────────────────────────────────────────────────────────────────────
// A window is just its remaining credit (default 65535). The sender must not send more DATA than the
// smaller of the connection window and the stream window; each is decremented on send and replenished by a
// received WINDOW_UPDATE. These primitives are the accounting; serve_h2 holds the per-conn/per-stream ints.
fn h2_window_init() -> int
    65535

// 1 iff `size` DATA octets fit in `window` (never send past the window; a 0-size frame always fits).
fn h2_can_send(window: int, size: int) -> int
    return 1 if size <= window else 0

// The window after sending `size` octets (may go to 0; never send when h2_can_send is 0).
fn h2_window_consume(window: int, size: int) -> int
    window - size

// The window after a received WINDOW_UPDATE increment (RFC 7540 caps a window at 2^31-1; a real overflow is
// a FLOW_CONTROL_ERROR the caller raises).
fn h2_window_credit(window: int, increment: int) -> int
    window + increment
