// forge_csv_parse -- RFC 4180 CSV PARSER (inbound side). forge.nova already has csv_row/csv_of for
// BUILDING csv; this is the parser that turns a csv document back into rows. Handles quoted fields,
// embedded commas, embedded newlines inside quotes, and escaped quotes ("" -> a single "). A field is
// quoted only if its FIRST char is a double quote. \r\n and lone \n both end a row; a trailing \r is
// dropped. No spurious empty trailing row when the text ends with a newline. LEAF -- imports NOTHING.

// Parse a whole CSV document into a list of rows; each row is a list of string fields.
fn csv_parse(text: string) -> list
    let comma = ","
    let quote = chr(34)
    let nl = chr(10)
    let cr = chr(13)
    let field = ""
    let row = []
    let rows = []
    let in_quotes = false
    let i = 0
    let n = len(text)
    while i < n
        let c = char_at(text, i)
        if in_quotes
            if c == quote
                if i + 1 < n and char_at(text, i + 1) == quote
                    field += quote
                    i += 2
                else
                    in_quotes = false
                    i += 1
            else
                field += c
                i += 1
        else
            if c == quote and field == ""
                in_quotes = true
                i += 1
            else
                if c == comma
                    push(row, field)
                    field = ""
                    i += 1
                else
                    if c == nl
                        if len(field) > 0 and char_at(field, len(field) - 1) == cr
                            field = slice(field, 0, len(field) - 1)
                        push(row, field)
                        push(rows, row)
                        field = ""
                        row = []
                        i += 1
                    else
                        field += c
                        i += 1
    if len(field) > 0 or len(row) > 0
        if len(field) > 0 and char_at(field, len(field) - 1) == cr
            field = slice(field, 0, len(field) - 1)
        push(row, field)
        push(rows, row)
    rows

// Parse with the first row as a header; return a list of dicts (header-name -> field value). Rows with
// fewer fields than the header get "" for the missing columns; extra fields beyond the header are ignored.
// An empty document -> empty list.
fn csv_parse_dicts(text: string) -> list
    let rows = csv_parse(text)
    let out = []
    if len(rows) == 0
        return out
    let header = rows[0]
    let hcount = len(header)
    for r in 1..len(rows)
        let cur = rows[r]
        let d = {}
        let j = 0
        while j < hcount
            let key = header[j]
            if j < len(cur)
                d[key] = cur[j]
            else
                d[key] = ""
            j += 1
        push(out, d)
    out

// Safe field accessor: row[idx] when in range, else "".
fn csv_field(row: list, idx: int) -> string
    if idx < 0 or idx >= len(row)
        return ""
    row[idx]
