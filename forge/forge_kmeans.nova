// forge_kmeans -- thin wrapper over std/ml/kmeans (canonical implementation).
import std/ml/kmeans

fn kmeans(points: list, k: int, max_iters: int) -> list
    return km_fit(points, k, max_iters)

fn kmeans_assign(points: list, centroids: list) -> list
    return km_predict(points, centroids)

fn kmeans_inertia(points: list, centroids: list, assignments: list) -> float
    let total = 0.0
    for i, pt in points
        total += knn_distance_sq(centroids[assignments[i]], pt)
    total

