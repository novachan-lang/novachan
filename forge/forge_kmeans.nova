// forge_kmeans -- k-means clustering: partition points into k groups so each point sits with the others it's
// most similar to. This is unsupervised learning (no labels needed): customer/behaviour segmentation, color
// quantization (reduce an image to k colors), grouping sensors/documents/vectors, or picking k representative
// examples. Lloyd's algorithm -- assign every point to its nearest center, move each center to the mean of its
// members, repeat until stable. Initialization is the deterministic farthest-point heuristic (start at the
// first point, then repeatedly add the point farthest from all chosen centers), which spreads the seeds across
// the data and converges reliably on well-separated clusters without a random seed. Reuses forge_knn's squared
// distance. Imports forge_knn.

import forge_knn

// PRIVATE: index of the centroid nearest to point p.
fn _km_nearest(centroids: list, p: list) -> int
    let best = 0
    let bestd = knn_distance_sq(centroids[0], p)
    let c = 1
    while c < len(centroids)
        let d = knn_distance_sq(centroids[c], p)
        if d < bestd
            bestd = d
            best = c
        c = c + 1
    best

// PRIVATE: deterministic farthest-point initial centroids (a k-means++ style spread without randomness).
fn _km_init(points: list, k: int) -> list
    let centroids = []
    push(centroids, points[0])
    while len(centroids) < k
        let bestp = 0
        let bestd = 0.0 - 1.0
        let i = 0
        while i < len(points)
            let mind = knn_distance_sq(centroids[0], points[i])
            let c = 1
            while c < len(centroids)
                let dd = knn_distance_sq(centroids[c], points[i])
                if dd < mind
                    mind = dd
                c = c + 1
            if mind > bestd
                bestd = mind
                bestp = i
            i = i + 1
        push(centroids, points[bestp])
    centroids

// PRIVATE: recompute each centroid as the mean of its assigned points; empty clusters keep their old centroid.
fn _km_recompute(points: list, assignments: list, k: int, dim: int, old: list) -> list
    let centroids = []
    let c = 0
    while c < k
        let sumv = []
        let d0 = 0
        while d0 < dim
            push(sumv, 0.0)
            d0 = d0 + 1
        let count = 0
        let i = 0
        while i < len(points)
            if assignments[i] == c
                let j = 0
                while j < dim
                    sumv[j] = sumv[j] * 1.0 + points[i][j] * 1.0
                    j = j + 1
                count = count + 1
            i = i + 1
        if count == 0
            push(centroids, old[c])
        else
            let cent = []
            let j2 = 0
            while j2 < dim
                let m = (sumv[j2] * 1.0) / (count * 1.0)
                push(cent, m)
                j2 = j2 + 1
            push(centroids, cent)
        c = c + 1
    centroids

// Cluster `points` into k groups (max_iters Lloyd iterations, stops early on convergence). Returns
// [centroids, assignments] where centroids is a list of k mean vectors and assignments[i] is point i's cluster.
fn kmeans(points: list, k: int, max_iters: int) -> list
    let dim = len(points[0])
    let centroids = _km_init(points, k)
    let assignments = []
    let a = 0
    while a < len(points)
        push(assignments, 0)
        a = a + 1
    let iter = 0
    let running = true
    while running and iter < max_iters
        let changed = false
        let p = 0
        while p < len(points)
            let nc = _km_nearest(centroids, points[p])
            if nc != assignments[p]
                changed = true
            assignments[p] = nc
            p = p + 1
        centroids = _km_recompute(points, assignments, k, dim, centroids)
        iter = iter + 1
        if changed == false
            running = false
    [centroids, assignments]

// Assign each point to its nearest centroid; returns the assignment list.
fn kmeans_assign(points: list, centroids: list) -> list
    let out = []
    let i = 0
    while i < len(points)
        push(out, _km_nearest(centroids, points[i]))
        i = i + 1
    out

// Total within-cluster squared distance (inertia) -- lower is tighter; use it to compare k (elbow method).
fn kmeans_inertia(points: list, centroids: list, assignments: list) -> float
    let total = 0.0
    let i = 0
    while i < len(points)
        total = total + knn_distance_sq(centroids[assignments[i]], points[i])
        i = i + 1
    total
