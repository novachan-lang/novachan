// forge_ip_reputation — IP reputation scoring with block/allow and Result API.

fn ipr_new(block_threshold: int) -> dict
    {"block_threshold": block_threshold, "ip_count": 0, "total_checks": 0, "blocks": 0}

fn ipr_report(r: dict, ip: string, score_delta: int) -> dict
    let sk = "ip_" + ip + "_score"
    if sk in r
        r[sk] += score_delta
    else
        r[sk] = score_delta
        r["ip_count"] += 1
    r

fn ipr_check(r: dict, ip: string) -> Result
    r["total_checks"] += 1
    let sk = "ip_" + ip + "_score"
    if sk not in r
        return ok("allowed")
    if r[sk] >= r["block_threshold"]
        r["blocks"] += 1
        return err("blocked")
    ok("allowed")

fn ipr_score(r: dict, ip: string) -> Result
    let sk = "ip_" + ip + "_score"
    if sk not in r
        return err("IP not tracked: " + ip)
    ok(r[sk])

fn ipr_is_blocked(r: dict, ip: string) -> int
    let sk = "ip_" + ip + "_score"
    1 if sk in r and r[sk] >= r["block_threshold"] else 0

fn ipr_ip_count(r: dict) -> int
    r["ip_count"]

fn ipr_total_checks(r: dict) -> int
    r["total_checks"]

fn ipr_block_count(r: dict) -> int
    r["blocks"]
