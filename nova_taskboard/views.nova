// View layer — HTML rendering with comprehensions and string interpolation.

import forge
import forge_html

fn layout(title: string, content: string) -> string
    let head_extra = "<link rel=\"stylesheet\" href=\"/style.css\">"
    let inner = navbar() + forge_html.div({"class": "container"}, content)
    forge_html.page("TaskBoard - {title}", head_extra, inner)

fn navbar() -> string
    let brand = forge_html.div({"class": "nav-brand"}, forge_html.link("/", "TaskBoard"))
    let items = forge_html.li({}, forge_html.link("/", "Dashboard")) + forge_html.li({}, forge_html.link("/projects", "Projects"))
    let nav_links = forge_html.ul({"class": "nav-links"}, items)
    forge_html.nav({"class": "navbar"}, brand + nav_links)

fn flash_banner(req) -> string
    let msg = forge.get_flash(req)
    if len(msg) > 0
        return forge_html.div({"class": "flash"}, forge_html.esc(msg))
    ""

fn stat_card(lbl: string, value: string, kind: string) -> string
    let val_div = forge_html.div({"class": "stat-value"}, value)
    let lbl_div = forge_html.div({"class": "stat-label"}, lbl)
    forge_html.div({"class": "stat-card stat-{kind}"}, val_div + lbl_div)

fn status_badge(status: string) -> string
    forge_html.span({"class": "badge badge-{status}"}, status)

fn priority_badge(priority: string) -> string
    forge_html.span({"class": "badge priority-{priority}"}, priority)

fn field_input(lbl: string, name: string, kind: string, value: string) -> string
    let inp = forge_html.input_tag({"type": kind, "name": name, "value": value, "class": "form-input"})
    forge_html.div({"class": "form-group"}, forge_html.label({}, lbl) + inp)

fn select_input(name: string, options: list) -> string
    let opts = join([forge_html.el("option", {"value": o}, o) for o in options], "")
    forge_html.el("select", {"name": name, "class": "form-input"}, opts)

fn task_add_form(project_id: int) -> string
    let title_input = forge_html.input_tag({"type": "text", "name": "title", "placeholder": "New task...", "class": "form-input"})
    let pri_select = select_input("priority", ["low", "medium", "high", "critical"])
    let submit = forge_html.button({"type": "submit", "class": "btn btn-primary"}, "Add Task")
    let action_url = "/projects/{project_id}/tasks"
    forge_html.form({"method": "POST", "action": action_url, "class": "inline-form"}, title_input + pri_select + submit)

fn action_btn(action: string, txt: string) -> string
    let btn = forge_html.button({"type": "submit", "class": "btn btn-sm"}, txt)
    forge_html.form({"method": "POST", "action": action, "class": "inline-action"}, btn)

fn not_found_body() -> string
    forge_html.h1({}, "404 - Page Not Found") + forge_html.p({}, "The page you're looking for doesn't exist.") + forge_html.link("/", "Go to Dashboard")
