// Domain types for TaskBoard — typed structs with methods.

type Project
    id: int
    name: string
    description: string
    status: string

type Task
    id: int
    project_id: int
    title: string
    description: string
    priority: string
    status: string

type DashboardStats
    total_projects: int
    total_tasks: int
    done_tasks: int
    active_projects: int

fn Task.is_done(self) -> int
    self.status == "done"

fn Task.toggled_status(self) -> string
    "todo" if self.is_done() else "done"

fn Task.priority_level(self) -> int
    match self.priority
        "critical" => 4
        "high" => 3
        "medium" => 2
        "low" => 1
        _ => 0

fn DashboardStats.completion_pct(self) -> int
    if self.total_tasks == 0
        return 0
    (self.done_tasks * 100) / self.total_tasks
