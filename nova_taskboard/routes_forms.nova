// Form POST handlers — each validates, mutates, and redirects.

import forge
import models
import db

fn register_forms(a, pool)
    forge.post(a, "/projects", fn(req) _form_create_project(pool, req))
    forge.post(a, "/projects/:id/tasks", fn(req) _form_create_task(pool, req))
    forge.post(a, "/tasks/:id/toggle", fn(req) _form_toggle_task(pool, req))
    forge.post(a, "/tasks/:id/delete", fn(req) _form_remove_task(pool, req))

fn _form_create_project(pool, req: Request) -> Response
    let name = forge.req_form(req, "name")
    let desc = forge.req_form(req, "description")
    let status = forge.req_form(req, "status")
    if len(name) == 0
        return forge.flash(forge.resp_redirect(303, "/projects/new"), "Name is required")
    if len(name) > 200
        return forge.flash(forge.resp_redirect(303, "/projects/new"), "Name must be under 200 characters")
    if len(desc) > 2000
        return forge.flash(forge.resp_redirect(303, "/projects/new"), "Description too long")
    let st = "active" if len(status) == 0 else status
    if is_valid_status(st) == 0
        return forge.flash(forge.resp_redirect(303, "/projects/new"), "Invalid status")
    db_insert_project(pool, name, desc, st)
    forge.flash(forge.resp_redirect(303, "/projects"), "Project created!")

fn _form_create_task(pool, req: Request) -> Response
    let pid = parse_int(req.params["id"])
    let title = forge.req_form(req, "title")
    let priority = forge.req_form(req, "priority")
    let redir = "/projects/{pid}"
    if len(title) == 0
        return forge.flash(forge.resp_redirect(303, redir), "Title is required")
    if len(title) > 500
        return forge.flash(forge.resp_redirect(303, redir), "Title must be under 500 characters")
    let pri = "medium" if len(priority) == 0 else priority
    if is_valid_priority(pri) == 0
        return forge.flash(forge.resp_redirect(303, redir), "Invalid priority")
    db_insert_task(pool, pid, title, "", pri)
    forge.flash(forge.resp_redirect(303, redir), "Task added!")

fn _form_toggle_task(pool, req: Request) -> Response
    let id = parse_int(req.params["id"])
    let task_r = db_get_task(pool, id)
    if is_err(task_r)
        return forge.resp_redirect(303, "/projects")
    let task: Task = unwrap(task_r)
    let new_status = task.toggled_status()
    db_set_task_status(pool, id, new_status)
    forge.flash(forge.resp_redirect(303, "/projects/{task.project_id}"), "Task marked {new_status}")

fn _form_remove_task(pool, req: Request) -> Response
    let id = parse_int(req.params["id"])
    let task_r = db_get_task(pool, id)
    let pid = 0
    if is_ok(task_r)
        let t: Task = unwrap(task_r)
        pid = t.project_id
    db_delete_task(pool, id)
    forge.flash(forge.resp_redirect(303, "/projects/{pid}"), "Task deleted")
