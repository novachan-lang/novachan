// Nova TaskBoard — entry point.
// Wires middleware, routes, and server. All logic lives in sibling modules.

import forge
import forge_html
import models
import db
import views
import routes_api
import routes_web
import routes_forms

fn _port() -> int
    let pe = env("PORT")
    if len(pe) > 0
        return parse_int(pe)
    8080

fn main()
    print("TaskBoard: connecting to PostgreSQL (pool=3)...")
    let pool_r = tb_open()
    if is_err(pool_r)
        print("error: could not connect to database: {unwrap_err(pool_r)}")
        exit(1)
    let pool = unwrap(pool_r)
    print("TaskBoard: initializing schema...")
    db_init_schema(pool)

    let a = forge.app()

    forge.use(a, forge.mw_log())
    forge.use(a, forge.mw_security_headers())
    forge.use(a, forge.mw_cors_origin("*"))
    forge.use(a, forge.mw_rate_limit(100, 60000))
    forge.use(a, forge.mw_flash())
    forge.use(a, forge.mw_etag())
    forge.use(a, forge.mw_request_id())

    register_web(a, pool)
    register_forms(a, pool)
    register_api(a, pool)
    forge.health_route(a)
    forge.static(a, "/", "public")

    forge.on_not_found(a, fn(req) forge.resp_html(404, layout("Not Found", not_found_body())))

    let av = args()
    if len(av) > 1 and av[1] == "--check"
        let r: Response = forge.dispatch_req(a, forge.build_request("GET / HTTP/1.1\r\n\r\n", 0))
        print("selfcheck status={r.status}")
        let r2: Response = forge.dispatch_req(a, forge.build_request("GET /api/v1/stats HTTP/1.1\r\n\r\n", 0))
        print("api check status={r2.status}")
        tb_close(pool)
        if r.status >= 400 or r2.status >= 400
            exit(1)
        print("TaskBoard: selfcheck PASS")
        return

    let port = _port()
    print("TaskBoard running on http://localhost:{port}")
    print("  Dashboard: http://localhost:{port}/")
    print("  API:       http://localhost:{port}/api/v1/")
    print("  Health:    http://localhost:{port}/health")
    forge.serve_req(a, port)
