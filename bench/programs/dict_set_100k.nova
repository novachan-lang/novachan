// Bench: insert 100,000 entries into a dict, look up all, drop.
// Validates: hash function, open-addressing probe; dict_set_no_rc.

fn main()
    let t0 = clock_ns()
    let d = {}
    let i = 0
    while i < 100000
        d[str(i)] = i * 2
        i = i + 1

    let total = 0
    let j = 0
    while j < 100000
        total = total + d[str(j)]
        j = j + 1

    let dt = (clock_ns() - t0) / 1000000
    // sum 2*j for j in 0..100_000 = 2 * (99999 * 100000 / 2) = 9_999_900_000
    if total != 9999900000
        print("FAIL dict_set_100k: total=" + str(total))
        exit(1)
    print("BENCH dict_set_100k elapsed_ms=" + str(dt))
    rc_stats_dump()
