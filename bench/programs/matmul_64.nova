// Bench: 64x64 matrix multiplication using NOVA's tensor stdlib.
// Validates: tensor_matmul kernel, contiguous float memory.

fn main()
    // Build two 64x64 matrices filled with 1.0
    let n = 64
    let total = n * n
    let xs = []
    let i = 0
    while i < total
        xs.push(1.0)
        i = i + 1

    let A = tensor_from_list(xs, [n, n])
    let B = tensor_from_list(xs, [n, n])

    let t0 = clock_ns()
    let C = tensor_matmul(A, B)
    let dt = (clock_ns() - t0) / 1000000

    // Each cell of C = sum of 64 * (1.0 * 1.0) = 64.0
    let c00 = tensor_get(C, [0, 0])
    if c00 != 64.0
        print("FAIL matmul_64: c[0][0]=" + str(c00))
        exit(1)

    print("BENCH matmul_64 elapsed_ms=" + str(dt))
    rc_stats_dump()
