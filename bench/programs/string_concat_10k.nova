// Bench: build a 10,000-character string via repeated concatenation.
// Validates: string buffer amortization; raw alloc latency.

fn main()
    let t0 = clock_ns()
    let s = ""
    let i = 0
    while i < 10000
        s = s + "x"
        i = i + 1
    let dt = (clock_ns() - t0) / 1000000
    if len(s) != 10000
        print("FAIL string_concat_10k: len=" + str(len(s)))
        exit(1)
    print("BENCH string_concat_10k elapsed_ms=" + str(dt))
    rc_stats_dump()
