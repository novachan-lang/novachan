// Bench: classic recursive fibonacci.
// Validates: function call dispatch, integer arithmetic, stack discipline.

fn fib(n: int) -> int
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)

fn main()
    let t0 = clock_ns()
    let r = fib(30)
    let dt = (clock_ns() - t0) / 1000000
    if r != 832040
        print("FAIL fib_recursive: r=" + str(r))
        exit(1)
    print("BENCH fib_recursive elapsed_ms=" + str(dt))
    rc_stats_dump()
