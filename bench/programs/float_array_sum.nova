// Bench: sum a 2,000,000-element float array x50 (the Tier 2.2 metric: xs[j] float read
// in a hot loop). Tracks the S4 floatlist fast path; a regression here = a re-boxing.
fn main()
    let n = 2000000
    let xs = []
    let i = 0
    while i < n
        xs.push(i * 1.5)
        i = i + 1
    let t0 = clock_ns()
    let total = 0.0
    let r = 0
    while r < 50
        let s = 0.0
        let j = 0
        while j < n
            s = s + xs[j]
            j = j + 1
        total = total + s
        r = r + 1
    let dt = (clock_ns() - t0) / 1000000
    // sum_{j<n} j*1.5 = 1.5 * (n-1)*n/2, x50 reps
    if total < 1.0
        print("FAIL float_array_sum: total=" + str(total))
        exit(1)
    print("BENCH float_array_sum elapsed_ms=" + str(dt))
    rc_stats_dump()
