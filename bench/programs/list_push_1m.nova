// Bench: append 1,000,000 ints to a local list, sum, drop.
// Validates: list_append_no_rc when Track 8 is on; raw allocator throughput.

fn build(n: int) -> int
    let xs = []
    let i = 0
    while i < n
        xs.push(i)
        i = i + 1
    let total = 0
    let j = 0
    while j < len(xs)
        total = total + xs[j]
        j = j + 1
    total

fn main()
    let t0 = clock_ns()
    let result = build(1000000)
    let dt = (clock_ns() - t0) / 1000000  // ns -> ms
    // sum of 0..999_999 = 999_999 * 1_000_000 / 2 = 499_999_500_000
    if result != 499999500000
        print("FAIL list_push_1m: expected 499999500000, got " + str(result))
        exit(1)
    print("BENCH list_push_1m elapsed_ms=" + str(dt))
    rc_stats_dump()
