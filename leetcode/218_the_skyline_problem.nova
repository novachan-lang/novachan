// 218_the_skyline_problem.nova — LeetCode 218, The Skyline Problem (Hard).
//
// Given the [left, right, height] triples of every building in a city, return the
// skyline's key points [x, height] in left-to-right order — a key point is the left
// endpoint of a horizontal segment of the contour; the final point has height 0 and
// marks where the skyline returns to the ground after the last building ends.
//
// ALGORITHM — sweep line over the critical x-coordinates, keeping a max-heap of the
// heights of all buildings "active" (left <= x < right) at the current sweep position.
// We drive the sweep with two synchronized cursors instead of materializing one combined,
// pre-sorted event list: `idx` walks the buildings in left-ascending order (so the next
// "start" event is always `by_left[idx].left`), and the heap's root is always the tallest
// building that is either still active OR simply hasn't been lazily evicted yet — an
// "end" event is really just "the tallest heap entry's own right edge has been reached".
// At each step, `cur_x = min(next building's left, heap root's right)`. We then admit
// every building whose left == cur_x into the heap (priority = -height, since NOVA's
// pq_* builtins are a min-heap — negating height turns it into a max-heap; payload =
// that building's right edge, all that's needed to test the root for expiry later), and
// LAZILY evict every heap root whose right edge has already been reached (<= cur_x)
// before reading the new max. Because the heap can only ever be READ at its root, an
// expired-but-buried entry can never leak into `cur_max`: by the time it would rise to
// the root (everything taller than it has been evicted), `cur_x` has only grown since
// the iteration where it expired, so the expiry test still fires correctly then. This
// also makes the classic "start events before end events at the same x, taller building
// first among starts" tie rule automatic — both a start and an expiry at the same x are
// fully applied before `cur_max` is ever read, and since it's a max-heap the tallest
// survivor wins regardless of push order. A key point is emitted only when `cur_max`
// actually changes, which is what collapses two adjacent same-height buildings (e.g.
// [0,2,3],[2,5,3]) into one segment instead of a spurious point at their shared edge.
//
// COMPLEXITY — O(n log n) time: sorting buildings by left is O(n log n); the outer sweep
// loop runs O(n) times total, because every iteration either advances `idx` by >= 1 (when
// cur_x comes from a building's left) or pops the heap by >= 1 (when cur_x comes from the
// heap root's own right edge, so `pq_peek(pq) <= cur_x` holds trivially for that root) —
// and both idx-advances and pops are bounded by n over the whole run. Each iteration does
// O(log n) heap work. Space is O(n) for the sorted buildings + heap + output — NOT an
// O(n * maxX) brute-force height-array scan.

type Building
    left: int
    right: int
    height: int

fn get_skyline(buildings: list<list<int>>) -> list<list<int>>
    let n = len(buildings)
    if n == 0
        return []

    let by_left = [Building(b[0], b[1], b[2]) for b in buildings].sort_by(fn(b) b.left)

    let pq = pq_create()          // active buildings: priority = -height (max-heap), payload = right edge
    let idx = 0
    let prev_max = 0
    let result = []

    while idx < n or not pq_is_empty(pq)
        let cur_x = pq_peek(pq) if idx >= n else by_left[idx].left if pq_is_empty(pq) else min(by_left[idx].left, pq_peek(pq))

        // Admit every building starting exactly at cur_x.
        while idx < n and by_left[idx].left == cur_x
            let b = by_left[idx]
            pq_push(pq, -b.height, b.right)
            idx += 1

        // Lazily evict every heap root that has already expired by cur_x.
        while not pq_is_empty(pq) and pq_peek(pq) <= cur_x
            pq_pop(pq)

        let cur_max = -pq_peek_priority(pq) if not pq_is_empty(pq) else 0

        if cur_max != prev_max
            result.push([cur_x, cur_max])
            prev_max = cur_max

    return result

fn main()
    let skyline1 = get_skyline([[2, 9, 10], [3, 7, 15], [5, 12, 12], [15, 20, 10], [19, 24, 8]])
    assert(skyline1 == [[2, 10], [3, 15], [7, 12], [12, 0], [15, 10], [20, 8], [24, 0]], "five overlapping buildings produce the classic skyline sample")

    let skyline2 = get_skyline([[0, 2, 3], [2, 5, 3]])
    assert(skyline2 == [[0, 3], [5, 0]], "adjacent same-height buildings merge into one segment, no redundant point at x=2")

    // Extra edge probes beyond the required cases: a single building, and two disjoint
    // (non-overlapping) buildings of different heights that never contend for the heap top.
    assert(get_skyline([[0, 5, 4]]) == [[0, 4], [5, 0]], "single building -> rise then fall to ground")
    assert(get_skyline([[1, 3, 2], [5, 8, 6]]) == [[1, 2], [3, 0], [5, 6], [8, 0]], "two disjoint buildings -> two independent segments")

    print("PASS: The Skyline Problem")
