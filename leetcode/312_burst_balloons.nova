// 312_burst_balloons.nova — LeetCode 312, Burst Balloons (Hard).
//
// n balloons in a row, each with a number nums[i]. Bursting balloon i pays
// nums[l] * nums[i] * nums[r], where l and r are whichever balloons are
// still standing immediately to its left/right AT THE MOMENT it is burst
// (an out-of-bounds neighbor counts as 1). Burst every balloon, in whatever
// order maximizes total coins.
//
// ALGORITHM — interval DP over "last balloon burst in the interval",
// O(n^3) time, O(n^2) space (the required bound; brute-force order
// enumeration is O(n!)).
//
// The trick that makes this an interval DP instead of an exponential search:
// don't think about which balloon is burst FIRST in a range (its neighbors
// are unstable — they depend on everything else you do first). Think about
// which balloon is burst LAST. If balloon k is the last one standing inside
// an open interval (l, r) — l and r themselves already burst, or are the
// sentinel boundary — then at the instant k is burst, EVERY other balloon
// strictly between l and r is already gone, so k's live neighbors are
// exactly l and r, no matter what order the rest of the interval was
// cleared in. That fixes k's payout at nums[l]*nums[k]*nums[r] regardless
// of the sub-order chosen for (l, k) and (k, r) — the two sub-intervals
// left of k and right of k become fully independent subproblems (bursting
// balloons in one never changes who's adjacent to a balloon in the other,
// since k itself hasn't burst yet). That independence is exactly optimal
// substructure, which is what makes DP legal here.
//
// Pad the array with a 1 on each end (nums_padded[0] and nums_padded[m-1],
// m = n+2) so "no neighbor" becomes an ordinary array read instead of a
// special case. Define:
//
//   dp[l][r] = max coins obtainable from bursting ALL balloons strictly
//              between padded-indices l and r (exclusive), for l < r.
//
// Base case: dp[l][r] = 0 whenever r - l < 2 (no balloons strictly between
// them) — this is exactly the zero-initialized table, no separate pass
// needed. Recurrence, choosing k as the LAST balloon burst in (l, r):
//
//   dp[l][r] = max over k in (l, r) of:
//       dp[l][k] + nums_padded[l] * nums_padded[k] * nums_padded[r] + dp[k][r]
//
// Filled by increasing gap = r - l so that dp[l][k] and dp[k][r] (both
// strictly smaller intervals) are already computed when dp[l][r] is
// needed. The answer is dp[0][m-1] — everything strictly between the two
// sentinels, i.e. every real balloon.
//
// Complexity: two nested loops over (l, r) pairs — O(n^2) of them — each
// scanning O(n) choices of k, giving the required O(n^3) time. The table
// itself is O(n^2) cells, the required space bound. This beats the naive
// "try every burst order" approach, which is O(n!) and intractable past
// n ~ 10.

fn max_coins(nums: list<int>) -> int
    let n = len(nums)
    if n == 0
        return 0

    let balloons = [1, ...nums, 1]
    let m = len(balloons)

    // dp[l][r] = max coins from bursting everything strictly inside (l, r).
    // Zero-initialized, which already IS the r - l < 2 base case.
    let dp = [[0 for _ in 0..m] for _ in 0..m]

    for gap in 2..m
        for l in 0..(m - gap)
            let r = l + gap
            let best = 0
            for k in (l + 1)..r
                best = max(best, dp[l][k] + balloons[l] * balloons[k] * balloons[r] + dp[k][r])
            dp[l][r] = best

    return dp[0][m - 1]

fn main()
    assert(max_coins([3, 1, 5, 8]) == 167, "[3,1,5,8] -> 167")
    assert(max_coins([1, 5]) == 10, "[1,5] -> 10")
    assert(max_coins([7]) == 7, "[7] -> 7")

    // Extra edge probes beyond the required cases: empty input (0 balloons
    // burst, 0 coins, and must not divide-by-zero or index out of bounds
    // on the padded array), and an all-ones input (every burst pays
    // exactly 1*1*1 = 1 regardless of order, so the answer is just n).
    assert(max_coins([]) == 0, "empty -> 0 coins, no balloons to burst")
    assert(max_coins([1, 1, 1, 1]) == 4, "all-ones -> every order pays exactly n coins total")

    // Additional probes cross-checked against an independent Python
    // brute-force permutation search (exhaustive over every burst order),
    // not just against this same DP re-derived by hand.
    assert(max_coins([0]) == 0, "single zero -> 0 coins")
    assert(max_coins([0, 0]) == 0, "all zeros -> 0 coins regardless of order")
    assert(max_coins([0, 3, 5]) == 20, "leading zero -> 20 (brute-force verified)")
    assert(max_coins([5, 0, 0, 5]) == 30, "zeros sandwiched between values -> 30 (brute-force verified)")
    assert(max_coins([1, 0, 4, 3, 3, 2]) == 76, "n=6 random case -> 76 (brute-force verified)")
    assert(max_coins([1, 10, 8, 1, 9, 6]) == 1412, "n=6 random case with larger values -> 1412 (brute-force verified)")

    print("PASS: Burst Balloons")
