// 42_trapping_rain_water.nova — LeetCode 42, Trapping Rain Water (Hard).
//
// Given n non-negative integers representing an elevation map where the width
// of each bar is 1, compute how much water it can trap after raining.
//
// ALGORITHM — two-pointer, O(n) time, O(1) extra space.
// The water level standing above index i is min(max_left(i), max_right(i)) - height[i].
// The classic approach precomputes max_left[] and max_right[] arrays (O(n) space).
// The O(1)-space trick: walk two pointers inward from both ends, tracking only the
// running max seen so far from the left (left_max) and from the right (right_max).
// Whichever side currently has the SMALLER running max is the side whose water level
// is already fully determined — its own running max is provably the bottleneck (the
// far side is guaranteed to have a max at least that high, because the pointers meet
// in the middle and the untouched region still holds at least one bar >= the larger
// pointer's max). That lets us settle one bar's contribution and advance that pointer,
// without ever knowing the true max on the far side.
fn trap(height: list<int>) -> int
    let n = len(height)
    if n == 0
        return 0
    let left = 0
    let right = n - 1
    let left_max = 0
    let right_max = 0
    let water = 0
    while left < right
        if height[left] < height[right]
            left_max = max(left_max, height[left])
            water += left_max - height[left]
            left += 1
        else
            right_max = max(right_max, height[right])
            water += right_max - height[right]
            right -= 1
    return water

fn main()
    assert(trap([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]) == 6, "classic elevation map traps 6 units")
    assert(trap([4, 2, 0, 3, 2, 5]) == 9, "descending-then-ascending map traps 9 units")
    assert(trap([]) == 0, "empty map traps nothing")
    assert(trap([1]) == 0, "single bar traps nothing")
    assert(trap([3, 3, 3, 3, 3]) == 0, "flat plateau traps nothing")
    assert(trap([1, 2, 3, 4, 5]) == 0, "strictly increasing traps nothing")
    assert(trap([5, 4, 3, 2, 1]) == 0, "strictly decreasing traps nothing")
    assert(trap([5, 0, 5]) == 5, "V-shape traps the full middle gap")
    assert(trap([5, 0, 0, 0, 5]) == 15, "wide flat basin between equal walls")
    assert(trap([0, 0, 0, 0]) == 0, "all-zero map traps nothing")
    assert(trap([5, 1]) == 0, "two elements, descending, traps nothing")
    assert(trap([1, 5]) == 0, "two elements, ascending, traps nothing")
    assert(trap([0, 5, 0]) == 0, "single spike with no walls traps nothing")
    assert(trap([2, 0, 2]) == 2, "small symmetric basin")
    assert(trap([3, 0, 0, 2, 0, 4]) == 10, "uneven multi-basin map")
    assert(trap([1, 0, 4, 3, 3, 2, 1, 8, 1, 9, 6, 0, 0, 1, 3, 3, 8, 9, 0, 8, 3]) == 65, "long random map, oracle-checked")
    assert(trap([8, 6, 3, 7, 9, 4, 0, 2, 6, 5, 4, 2, 3, 5, 1, 1, 6, 1, 5, 5, 9, 4, 0]) == 93, "another long random map, oracle-checked")
    assert(trap([5, 0, 3, 0, 5, 6, 4, 1]) == 12, "multiple nested basins")
    print("PASS: Trapping Rain Water")
