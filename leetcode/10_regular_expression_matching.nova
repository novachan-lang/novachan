// 10_regular_expression_matching.nova — LeetCode 10, Regular Expression Matching (Hard).
//
// Given a string s and a pattern p, implement regex matching supporting '.' (matches
// any single character) and '*' (matches zero or more of the PRECEDING element). The
// match must cover the ENTIRE input string, not just a prefix.
//
// ALGORITHM — bottom-up 2D dynamic programming, O(m*n) time and O(m*n) space, where
// m = len(s) and n = len(p).
//
// dp[i][j] = true iff the first i characters of s, s[0..i), match the first j
// characters of p, p[0..j), in full.
//
//   dp[0][0] = true                 -- empty string matches empty pattern
//   dp[0][j], j > 0: p[0..j) can only match an empty string if it is built entirely
//                    of "x*" pairs (e.g. "a*b*c*"): p[j-1] must be '*' and dp[0][j-2]
//                    must already hold — each "x*" pair can be dropped by choosing
//                    zero occurrences, chaining back to the empty pattern.
//   dp[i][j], i > 0, j > 0:
//     - p[j-1] == '*': stands for "zero or more of p[j-2]". Two ways to satisfy it:
//         zero occurrences    -> dp[i][j-2]           (drop the "x*" pair entirely)
//         >=1 more occurrence -> dp[i-1][j] AND p[j-2] matches s[i-1]
//                                 (consume one s char under the SAME "x*" pair, since
//                                  '*' is free to repeat)
//       dp[i][j] = dp[i][j-2] or (matches(s[i-1], p[j-2]) and dp[i-1][j])
//     - otherwise ('.' or a literal char): the last characters must line up AND the
//       remaining prefixes must already match.
//       dp[i][j] = matches(s[i-1], p[j-1]) and dp[i-1][j-1]
//
// Every cell depends only on cells with a strictly smaller i, or the same i with a
// smaller j (j-1 or j-2) — so filling row-major, i = 0..m then j = 0..n, is a valid
// topological order. Each of the (m+1)*(n+1) cells does O(1) work, giving O(m*n) time;
// the full table is retained, giving O(m*n) space (the classic optimization rolls this
// down to two rows / O(n) space, but the problem's required technique is the 2D table).

fn _char_matches(sc: string, pc: string) -> bool
    pc == "." or sc == pc

fn is_match(s: string, p: string) -> bool
    let m = len(s)
    let n = len(p)

    // dp[i][j]: does s[0..i) match p[0..j)?
    let dp = [[false for j in 0..(n + 1)] for i in 0..(m + 1)]
    dp[0][0] = true

    for j in 1..(n + 1)
        if p[j - 1] == "*" and j >= 2
            dp[0][j] = dp[0][j - 2]

    for i in 1..(m + 1)
        for j in 1..(n + 1)
            let pc = p[j - 1]
            if pc == "*"
                // A leading '*' is not a valid pattern, so p[j-2] always exists here.
                let prev = p[j - 2]
                let zero_occurrence = dp[i][j - 2]
                let one_more_occurrence = _char_matches(s[i - 1], prev) and dp[i - 1][j]
                dp[i][j] = zero_occurrence or one_more_occurrence
            else
                dp[i][j] = _char_matches(s[i - 1], pc) and dp[i - 1][j - 1]

    return dp[m][n]

fn main()
    assert(is_match("aa", "a") == false, "s=aa p=a -> false (plain literal, length mismatch)")
    assert(is_match("aa", "a*") == true, "s=aa p=a* -> true (a* repeats to cover aa)")
    assert(is_match("ab", ".*") == true, "s=ab p=.* -> true (.* matches any sequence)")
    assert(is_match("aab", "c*a*b") == true, "s=aab p=c*a*b -> true (c* matches zero c's)")
    assert(is_match("mississippi", "mis*is*p*.") == false, "s=mississippi p=mis*is*p*. -> false")
    assert(is_match("", "a*") == true, "s=(empty) p=a* -> true (a* matches zero a's)")

    // --- ADVERSARIAL VERIFICATION: extra cases beyond the dev's original set ---

    // Both empty: base case dp[0][0].
    assert(is_match("", "") == true, "s=(empty) p=(empty) -> true (base case)")

    // Pattern empty, string non-empty: dp[i][0] must stay false for all i>0
    // (never explicitly set, must default false from table init).
    assert(is_match("a", "") == false, "s=a p=(empty) -> false (nothing to consume s)")

    // Single-char exact and single-char '.' match.
    assert(is_match("a", "a") == true, "s=a p=a -> true (exact single char)")
    assert(is_match("a", ".") == true, "s=a p=. -> true (dot matches single char)")

    // Classic tricky overlap case: a* can consume a variable number of a's,
    // requires the "zero occurrences" AND ">=1 occurrence" branches to both
    // be reachable and correctly OR'd.
    assert(is_match("aaa", "a*a") == true, "s=aaa p=a*a -> true (a* covers 2, trailing a covers 1)")
    assert(is_match("aaa", "a*a*a") == true, "s=aaa p=a*a*a -> true (multiple star chains)")

    // Known LeetCode adversarial example mixing '.' and '*' together.
    assert(is_match("bbbba", ".*a*a") == true, "s=bbbba p=.*a*a -> true (.* then a*a)")

    // Star element that never matches anything real in s -> must fall back to
    // the zero-occurrence branch, not silently accept a bogus 1+ match.
    assert(is_match("ab", ".*c") == false, "s=ab p=.*c -> false (no c anywhere, .* can't invent one)")

    // All-same-character stress case combined with a real complexity probe:
    // s is 300 a's, p is 150 repetitions of "a*" (300 chars). A naive
    // exponential/backtracking solution (the classic catastrophic-backtracking
    // regex case, well documented as a TLE trap for this exact problem) would
    // not return in any reasonable time at this size. A true O(m*n) DP table
    // is only 301*301 =~ 90601 cells and must finish essentially instantly.
    let big_s = str_mul("a", 300)
    let big_p = str_mul("a*", 150)
    assert(is_match(big_s, big_p) == true, "s=300 a's p=150x(a*) -> true, must finish fast under real O(m*n) DP")

    // Same shape but engineered to be false (trailing 'b' with no matching
    // literal in a pure a*-chain pattern) -- exercises the same catastrophic-
    // backtracking blowup risk on the FALSE path, where naive backtrackers are
    // usually even slower because they exhaust every zero/one-or-more split
    // before concluding failure.
    let big_s_fail = str_mul("a", 300) + "b"
    let big_p_fail = str_mul("a*", 150)
    assert(is_match(big_s_fail, big_p_fail) == false, "300 a's + b vs 150x(a*) (no b in pattern) -> false, still fast")

    print("PASS: Regular Expression Matching")
