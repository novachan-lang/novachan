// 212_word_search_ii.nova — LeetCode 212, Word Search II (Hard).
//
// Given an m x n board of characters and a list of words, return every word
// that can be traced as a path of sequentially adjacent (horizontally or
// vertically neighboring) cells, never reusing a cell within one word's path.
//
// ALGORITHM — build ONE trie over every word, then run a SINGLE combined
// DFS sweep of the board that walks the trie in lock-step with the board
// path, instead of running len(words) independent "does this word exist"
// searches. This is the key design requirement, not an incidental detail:
//   - Search sharing: two words with a common prefix (e.g. "an"/"and") walk
//     the SAME trie nodes for their shared prefix, so the board cells under
//     that prefix are explored once per sweep, not once per word.
//   - Pruning: a board path that matches no trie edge dead-ends immediately
//     (`ch not in node`), which is strictly more pruning than any single
//     per-word DFS could offer, because "no word can still match from here"
//     is shared across every word that could still be alive at that node.
//   - Trie shape: a dict-of-dicts (matches std/collections/trie.nova's
//     idiom) — each node is a `dict<string, dict>` keyed by single-character
//     board letters; a node also holds "$" -> the complete word when it
//     terminates one, which both signals "found" and hands back the word
//     without needing to reconstruct it from the path.
//
// Cell reuse is prevented by the classic in-place backtracking trick:
// overwrite `board[r][c]` with a sentinel ("#", which can never appear in a
// trie edge since inputs are lowercase a-z) before recursing into neighbors,
// then restore the original letter on the way back up. This needs no extra
// visited-set allocation.
//
// Once a word is found at a leaf, its "$" entry is deleted from the trie so
// the same word can't be appended twice (a board can revisit the same trie
// leaf from a different start cell even though the word list itself has no
// duplicates). After each neighbor exploration returns, if the just-visited
// trie node has no children left (its "$" is already gone by then), it is
// pruned from its parent — a dead branch of the trie is never re-examined by
// a later sweep from another board cell.
//
// COMPLEXITY — O(rows * cols * 4^L) worst case, where L = the longest word
// length: each of the rows*cols start cells can fan out into a DFS whose
// branching factor is <=4 and whose depth is bounded by L (a path can't walk
// deeper than the deepest live trie node, and the trie has depth L). This
// matches the requested bound, but the shared trie makes the real cost far
// below "L independent O(rows*cols*4^L) searches": common prefixes are
// explored once per sweep, and trie pruning permanently cuts dead branches
// out of every future sweep as soon as they're discovered to be
// unproductive. Trie construction itself is O(sum of word lengths),
// dominated by the DFS sweep term above. Auxiliary space is O(sum of word
// lengths) for the trie plus O(L) for the recursion stack.

// Build a dict-of-dicts trie over `words`. Each leaf node's "$" entry holds
// the complete word that terminates there.
fn _ws2_build_trie(words: list<string>) -> dict
    let root = {}
    for word in words
        let node = root
        for ch in word
            if ch not in node
                node[ch] = {}
            node = node[ch]
        node["$"] = word
    return root

// DFS from board[r][c], walking `node` (the trie node reached by the path so
// far) in lock-step with the board. Appends every completed word found under
// this cell to `found`, deleting matched leaves and pruning exhausted trie
// branches as it backtracks. Caller guarantees board[r][c] is a live edge of
// `node` (checked before the very first call; re-checked per neighbor below).
fn _ws2_dfs(board: list<list<string>>, r: int, c: int, node: dict, rows: int, cols: int, found: list<string>)
    let ch = board[r][c]
    let next = node[ch]

    if "$" in next
        found.push(next["$"])
        next.del("$")

    board[r][c] = "#"
    for d in [[-1, 0], [1, 0], [0, -1], [0, 1]]
        let nr = r + d[0]
        let nc = c + d[1]
        if 0 <= nr < rows and 0 <= nc < cols and board[nr][nc] != "#" and board[nr][nc] in next
            _ws2_dfs(board, nr, nc, next, rows, cols, found)
    board[r][c] = ch

    if len(next.keys()) == 0
        node.del(ch)

// Return every word from `words` that traces a path of sequentially
// adjacent board cells (no cell reused within one word), via a single
// trie-guided DFS sweep starting from every board cell. Result order is
// unspecified, matching the problem statement's "order does not matter".
fn find_words(board: list<list<string>>, words: list<string>) -> list<string>
    let rows = len(board)
    if rows == 0
        return []
    let cols = len(board[0])
    let root = _ws2_build_trie(words)
    let found = []
    for r in 0..rows
        for c in 0..cols
            if board[r][c] in root
                _ws2_dfs(board, r, c, root, rows, cols, found)
    return found

fn main()
    let board1 = [
        ["o", "a", "a", "n"],
        ["e", "t", "a", "e"],
        ["i", "h", "k", "r"],
        ["i", "f", "l", "v"],
    ]
    let words1 = ["oath", "pea", "eat", "rain"]
    let result1 = find_words(board1, words1) |> sort()
    assert(result1 == ["eat", "oath"], "classic 4x4 board finds exactly \{eat, oath\}")

    let board2 = [
        ["a", "b"],
        ["c", "d"],
    ]
    let words2 = ["abcb"]
    assert(find_words(board2, words2) == [], "abcb cannot be traced without reusing cell (0,0)")

    // Extra edge probes beyond the two required cases.

    // A single-cell board can only ever match a single-letter word.
    let board3 = [["a"]]
    assert(find_words(board3, ["a"]) == ["a"], "single-cell board matches its lone letter")
    assert(find_words(board3, ["b"]) == [], "single-cell board finds no unmatched letter")

    // Overlapping prefixes exercise the shared-trie DFS sweep directly: all
    // three words live under the same 'a' -> 'n' trie path.
    let board4 = [
        ["a", "n", "d"],
        ["e", "x", "y"],
    ]
    let result4 = find_words(board4, ["an", "and", "any"]) |> sort()
    assert(result4 == ["an", "and"], "shared-prefix words an/and both found; any is diagonal-only, absent")

    // Empty word list and empty board must not crash and must return [].
    assert(find_words(board1, []) == [], "empty word list yields no matches")
    assert(find_words([], ["a"]) == [], "empty board yields no matches")

    // --- ADVERSARIAL VERIFIER PROBES (temporary) ---

    // Plus-shaped board: from the center 'b', several neighbors are 'a' but
    // one direction is a dead sentinel-free path and the START cell itself
    // becomes "#" mid-DFS, so a correct restore-on-backtrack is required or
    // this either false-negatives (over-blocked) or double-counts.
    let boardPlus = [
        ["z", "a", "z"],
        ["a", "b", "a"],
        ["z", "a", "z"],
    ]
    let resultPlus = find_words(boardPlus, ["aba"])
    assert(resultPlus == ["aba"], "plus-shaped board finds aba exactly once via backtrack+restore")

    // Word requiring a cell-reuse on a 1x1 board must fail, not crash --
    // trie depth (2) exceeds any possible simple path (1 cell).
    assert(find_words(board3, ["aa"]) == [], "word longer than reachable path on 1x1 board is absent")

    // Duplicate entries in the word list must not produce duplicate output
    // and must not crash the trie-leaf-delete-on-find step.
    let resultDup = find_words(board1, ["eat", "eat", "oath"]) |> sort()
    assert(resultDup == ["eat", "oath"], "duplicate words in input list yield no duplicate output")

    // Adversarial worst case for a naive/unpruned DFS: a board saturated
    // with one letter and a single long word that is ALMOST all matching
    // letters but fails only at the very last character (which never
    // appears on the board at all). This forces near-maximal backtracking
    // exploration and must still terminate quickly, proving the shared
    // trie-guided sweep (with dead-branch pruning) actually bounds the
    // search rather than blowing up silently.
    let boardAllA = [
        ["a", "a", "a", "a"],
        ["a", "a", "a", "a"],
        ["a", "a", "a", "a"],
        ["a", "a", "a", "a"],
    ]
    assert(find_words(boardAllA, ["aaaaaaab"]) == [], "adversarial all-same-letter board with unreachable tail terminates and finds nothing")
    // A word that IS fully reachable on the saturated board must still be found.
    assert(find_words(boardAllA, ["aaaaa"]) == ["aaaaa"], "reachable word on saturated board is still found")

    print("PASS: Word Search II")
