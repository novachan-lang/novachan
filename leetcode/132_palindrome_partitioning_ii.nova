// ============================================================================
// LeetCode 132 — Palindrome Partitioning II
// ============================================================================
// Given a string s, partition it so that every substring of the partition is
// a palindrome. Return the MINIMUM number of cuts needed for such a
// partitioning.
//
// Algorithm: two DP tables over s, O(n^2) time and O(n^2) space total (the
// required bound) — never enumerate partitions, which is exponential.
//
//   1. is_pal[i][j] answers "is s[i..j] (inclusive) a palindrome?", filled
//      bottom-up over DECREASING i (so is_pal[i+1][j-1] — the answer for the
//      inner substring — is already known when we need it):
//          is_pal[i][j] = (s[i] == s[j]) and (j - i < 2 or is_pal[i+1][j-1])
//      j - i < 2 covers the 0- and 1-length-gap base cases (single char, and
//      two equal adjacent chars) without a separate table pass. Every cell
//      does O(1) work, so this stage is exactly O(n^2).
//
//   2. cuts[i] = minimum cuts needed to partition the PREFIX s[0..i]
//      (inclusive) into palindromes. Seeded to the worst case — cut before
//      every character, cuts[i] = i — then relaxed left to right:
//          if is_pal[0][i]:            cuts[i] = 0   (whole prefix already one palindrome)
//          else for j in 1..(i + 1):
//              if is_pal[j][i]:        cuts[i] = min(cuts[i], cuts[j - 1] + 1)
//      j ranges over every possible start of the FINAL palindrome piece
//      ending at index i; cuts[j - 1] is already the optimal answer for the
//      part of the prefix before that piece (optimal substructure — the best
//      partitioning of a prefix is built from the best partitioning of a
//      shorter prefix plus one more palindrome piece), so each i does O(n)
//      work and the whole stage is O(n^2). The final answer is cuts[n - 1]
//      (a string of length 1 needs 0 cuts, handled by the n <= 1 fast path).
//
// Both tables are O(n^2) cells, meeting the required space bound exactly.
fn min_cut(s: string) -> int
    let n = len(s)
    if n <= 1
        return 0

    // Stage 1: is_pal[i][j] — is s[i..j] inclusive a palindrome?
    let is_pal = [[false for _ in 0..n] for _ in 0..n]
    for i in reversed(0..n)
        for j in i..n
            if s[i] == s[j] and (j - i < 2 or is_pal[i + 1][j - 1])
                is_pal[i][j] = true

    // Stage 2: cuts[i] — min cuts to palindrome-partition the prefix s[0..i].
    let cuts = [i for i in 0..n]
    for i in 0..n
        if is_pal[0][i]
            cuts[i] = 0
        else
            for j in 1..(i + 1) if is_pal[j][i]
                cuts[i] = min(cuts[i], cuts[j - 1] + 1)

    cuts[n - 1]

fn main()
    assert(min_cut("aab") == 1, "aab -> 1 cut: aa|b")
    assert(min_cut("a") == 0, "a -> 0 cuts: single char is already a palindrome")
    assert(min_cut("ab") == 1, "ab -> 1 cut: a|b")
    assert(min_cut("aaa") == 0, "aaa -> 0 cuts: whole string is a palindrome")
    assert(min_cut("racecarxyz") == 3, "racecarxyz -> 3 cuts: racecar|x|y|z")

    // Extra edge probes beyond the required cases.
    assert(min_cut("") == 0, "empty string -> 0 cuts")
    assert(min_cut("aabbabbaa") == 0, "aabbabbaa -> 0 cuts: entire string is already a palindrome")
    assert(min_cut("abccba") == 0, "abccba -> 0 cuts: entire string is already a palindrome")
    assert(min_cut("abcde") == 4, "abcde -> 4 cuts: no palindromic substring longer than 1")

    print("PASS: Palindrome Partitioning II")
