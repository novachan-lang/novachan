// 239_sliding_window_maximum.nova — LeetCode 239, Sliding Window Maximum (Hard).
//
// Given nums and a window size k that slides from the very left to the very
// right of the array, return the max value of each window position.
//
// ALGORITHM — monotonic DECREASING deque of INDICES, O(n) time, O(k) space.
//
// The deque holds indices whose corresponding values form a strictly
// decreasing run from front to back. That invariant is the whole trick:
// the FRONT index is always the current window's maximum, because any
// index that could beat it would have already knocked it out when it was
// pushed (see below) — so once something survives to the front, nothing
// still inside the window can be bigger.
//
// Walk i from 0 to n-1, maintaining the deque:
//   1. Evict from the FRONT any index that has fallen out of the window,
//      i.e. index <= i - k. That index is more than k-1 positions behind
//      i, so it is no longer inside [i-k+1, i].
//   2. Evict from the BACK any index whose value is <= nums[i]. Those
//      values can never be the max of any FUTURE window that also
//      contains i, because i is both later (survives longer) and at
//      least as large (a bigger or equal candidate) — they are
//      permanently dominated and can be discarded for good.
//   3. Push i onto the back — it is now the smallest-surviving, most
//      recent candidate, keeping the back-to-front order decreasing.
//   4. Once the window is fully formed (i >= k - 1), the front index is
//      this window's max — record nums[deque_front(d)].
//
// Complexity proof: every index is pushed onto the back exactly once
// (step 3, once per i) and can be popped at most once total across the
// whole run (either evicted at the front in step 1 or evicted at the
// back in step 2 — never both, and never re-pushed). So the total work
// across all n iterations is O(n), not the O(n*k) of re-scanning every
// window from scratch. The deque holds at most k indices at any time
// (everything older than the window has been evicted by step 1), giving
// O(k) space for the deque plus O(n-k+1) for the output — the required
// bound, as opposed to the brute-force O(n*k).
//
// deque_create/push_back/pop_back/back/push_front/pop_front/front/
// is_empty are zero-import runtime builtins (NOVA_DESIGN/
// NOVA_LANGUAGE_FEATURES.md section 8) used here as the deque — same
// convention as 84_largest_rectangle_in_histogram.nova's monotonic stack.

fn max_sliding_window(nums: list<int>, k: int) -> list<int>
    let n = len(nums)
    if n == 0 or k <= 0
        return []

    let d = deque_create()   // monotonic decreasing deque of indices
    let result = []
    for i in 0..n
        // Step 1: drop the front index once it exits the window on the left.
        if not deque_is_empty(d) and deque_front(d) <= i - k
            deque_pop_front(d)

        // Step 2: drop back indices whose values can never win again.
        while not deque_is_empty(d) and nums[deque_back(d)] <= nums[i]
            deque_pop_back(d)

        deque_push_back(d, i)

        // Step 4: the window is fully formed once we've seen k elements.
        if i >= k - 1
            result.push(nums[deque_front(d)])

    return result

fn main()
    assert(max_sliding_window([1, 3, -1, -3, 5, 3, 6, 7], 3) == [3, 3, 5, 5, 6, 7], "classic sliding window -> [3,3,5,5,6,7]")
    assert(max_sliding_window([1], 1) == [1], "single element, k=1 -> [1]")
    assert(max_sliding_window([9, 11], 2) == [11], "two elements, k=n -> [11]")

    // Extra edge probes beyond the required cases: strictly decreasing input
    // (every window's max is its leftmost element), all-equal values (the
    // eviction-on-<= rule must still keep exactly one survivor per window),
    // and k == 1 (every element is its own window's max, output == input).
    assert(max_sliding_window([5, 4, 3, 2, 1], 2) == [5, 4, 3, 2], "strictly descending, k=2")
    assert(max_sliding_window([4, 4, 4, 4], 2) == [4, 4, 4], "all-equal values, k=2")
    assert(max_sliding_window([2, 1, 3], 1) == [2, 1, 3], "k=1 -> output equals input")

    print("PASS: Sliding Window Maximum")
