// ============================================================================
// LeetCode 44 — Wildcard Matching
// ============================================================================
// Given an input string s and a pattern p, implement wildcard pattern
// matching with support for '?' (matches any single character) and '*'
// (matches any sequence of characters, including the empty sequence).
// Matching must cover the ENTIRE input string.
//
// Algorithm: bottom-up dynamic programming over a (m+1) x (n+1) table, where
// m = len(s), n = len(p). dp[i][j] answers "does p[0..j) match s[0..i)?":
//
//   dp[0][0]                                    = true
//       (the empty pattern matches the empty string)
//   dp[0][j]                                    = dp[0][j-1] and p[j-1] == '*'
//       (only a pattern made ENTIRELY of '*' can match an empty string)
//   dp[i][j], when p[j-1] == '*'                = dp[i-1][j] or dp[i][j-1]
//       ('*' either consumes one more character of s and stays at the same
//        pattern position (dp[i-1][j]), or consumes nothing and the match
//        falls through to the pattern position before it (dp[i][j-1]))
//   dp[i][j], when p[j-1] == '?' or s[i-1] == p[j-1]  = dp[i-1][j-1]
//       ('?' or an exact character match consumes one char of each)
//   dp[i][j], otherwise                          = false
//
// Every cell depends only on cells with a strictly smaller i or j, so a
// single left-to-right, top-to-bottom pass over the table fills it — this is
// genuinely O(m*n) time and O(m*n) space (the required bound), not the
// exponential blowup an unmemoized recursive "try '*' as empty, try '*' as
// one-more-char" branch-and-backtrack would give.
fn is_match(s: string, p: string) -> bool
    let m = len(s)
    let n = len(p)
    let dp = [[false for _ in 0..(n + 1)] for _ in 0..(m + 1)]
    dp[0][0] = true
    for j in 1..(n + 1)
        dp[0][j] = dp[0][j - 1] and char_at(p, j - 1) == "*"

    for i in 1..(m + 1)
        let sc = char_at(s, i - 1)
        for j in 1..(n + 1)
            let pc = char_at(p, j - 1)
            if pc == "*"
                dp[i][j] = dp[i - 1][j] or dp[i][j - 1]
            else if pc == "?" or pc == sc
                dp[i][j] = dp[i - 1][j - 1]

    dp[m][n]

fn main()
    assert(is_match("aa", "a") == false, "s=aa p=a -> false (extra trailing char, no wildcard)")
    assert(is_match("aa", "*") == true, "s=aa p=* -> true (* matches the whole string)")
    assert(is_match("cb", "?a") == false, "s=cb p=?a -> false (? matches c, but a != b)")
    assert(is_match("adceb", "*a*b") == true, "s=adceb p=*a*b -> true (* spans dc and empty)")
    assert(is_match("acdcb", "a*c?b") == false, "s=acdcb p=a*c?b -> false (no valid split)")
    assert(is_match("", "*") == true, "s='' p=* -> true (* matches the empty sequence)")
    // --- extra adversarial cases (independent verifier) ---
    assert(is_match("", "") == true, "empty s, empty p -> true")
    assert(is_match("", "a") == false, "empty s, non-star p -> false")
    assert(is_match("a", "") == false, "non-empty s, empty p -> false")
    assert(is_match("abc", "***") == true, "redundant consecutive stars still match")
    assert(is_match("", "***") == true, "redundant consecutive stars match empty string too")
    assert(is_match("aaabbb", "a*b") == true, "single star spans middle run")
    assert(is_match("mississippi", "m??*ss*?i*pi") == false, "classic LC44 tricky case -> false")
    assert(is_match("mississippi", "m??*ss*?i*p*") == false, "classic LC44 tricky case near-miss variant -> false")
    assert(is_match("ho", "ho**") == true, "trailing redundant stars after exact match")
    assert(is_match("a", "*?") == true, "star followed by ? still matches single char")
    assert(is_match("aa", "?*") == true, "? followed by * matches multi-char string")
    assert(is_match("abcabczzzde", "*abc???de*") == true, "star anchors with fixed middle segment")
    assert(is_match("bbbbbbbaaaaaaabbbbbbbccc", "*bb*a*") == true, "multiple star segments with backtrack need")
    print("PASS: Wildcard Matching")
