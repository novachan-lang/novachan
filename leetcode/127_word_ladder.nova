// 127_word_ladder.nova — LeetCode 127, Word Ladder (Hard).
//
// Given beginWord, endWord, and a wordList, return the number of words in the
// SHORTEST transformation sequence from beginWord to endWord, where each step
// changes exactly one letter and every intermediate word must exist in
// wordList (beginWord itself need not be in wordList; endWord must be).
// Return 0 if no such sequence exists.
//
// ALGORITHM — level-order BFS over the implicit graph where an edge connects
// two words differing by exactly one letter. Rather than testing every pair
// of words for a one-letter difference (O(N^2*L), the naive approach), each
// word at the current BFS frontier generates its own neighbors by trying all
// 26 letters at each of its L positions (O(L*26) candidates per word) and
// checking each candidate against a hash table built from wordList (O(1)
// average membership test). wordList is loaded into that table once up
// front, and a word is REMOVED from it the instant it is first discovered —
// this both prevents it from ever being enqueued again (doubling as the
// visited-set) and shrinks the table the algorithm still has to probe. BFS
// explores strictly level by level (frontier -> next_frontier, `steps`
// counting the word-count of the current level) so the first level at which
// endWord is reached is guaranteed to be the SHORTEST possible sequence
// length — this is the standard graph-shortest-path guarantee of BFS on an
// unweighted graph. Each of the N words is generated and visited at most
// once across the whole search, so total work is O(N * L * 26) time; the
// dictionary table and the frontier lists together hold at most O(N) words,
// so space is O(N).
//
// NOTE ON THE DICTIONARY STRUCTURE — deliberately `dict<string,bool>`, NOT
// NOVA's `set_from_list`/`set_has`/`set_remove` builtins. Those `set_*`
// builtins are backed by a plain NovaList scanned linearly via `nova_rt_eq`
// (see nova_runtime.c: "Set implementation — backed by a list with equality
// checks") — every set_has/set_remove call is O(current size), and building
// the set is O(N^2). That would silently turn this whole BFS back into the
// O(N^2*L) blowup the technique note above says to avoid. `dict` in NOVA is
// a real open-addressed hash table (nova_rt_dict_has/_set/_del all hash +
// probe), and the `in`/`not in` operators dispatch straight to the hashed
// nova_rt_dict_has when the right-hand side is a dict — so that's the
// primitive that actually delivers the O(1)-average membership test this
// algorithm's complexity depends on.
fn word_ladder_length(begin_word: string, end_word: string, word_list: list<string>) -> int
    let dict = {w: true for w in word_list}
    if end_word not in dict
        return 0
    if begin_word in dict
        dict.del(begin_word)

    const ALPHABET = "abcdefghijklmnopqrstuvwxyz"
    let frontier = [begin_word]
    let steps = 1

    while len(frontier) > 0
        let next_frontier = []
        for word in frontier
            if word == end_word
                return steps
            for i in 0..len(word)
                let prefix = slice(word, 0, i)
                let suffix = slice(word, i + 1, len(word))
                let original = char_at(word, i)
                for c in ALPHABET if c != original
                    let candidate = prefix + c + suffix
                    if candidate in dict
                        dict.del(candidate)
                        next_frontier.push(candidate)
        frontier = next_frontier
        steps += 1

    return 0

fn main()
    assert(word_ladder_length("hit", "cog", ["hot", "dot", "dog", "lot", "log", "cog"]) == 5, "hit->hot->dot->dog->cog (or lot/log variant) is a 5-word shortest ladder")
    assert(word_ladder_length("hit", "cog", ["hot", "dot", "dog", "lot", "log"]) == 0, "cog is missing from wordList, so no valid ladder exists")
    assert(word_ladder_length("a", "c", ["a", "b", "c"]) == 2, "single-letter words: a and c differ by one letter, direct 2-word ladder")

    // Extra: beginWord == endWord, and endWord present in wordList — trivial
    // 1-word "sequence" (also exercises the begin_word-removed-from-dict path
    // not breaking the very next equality check).
    assert(word_ladder_length("a", "a", ["a", "b"]) == 1, "beginWord already equals endWord: the ladder is just [endWord], length 1")

    // Extra: endWord IS present in the dictionary but genuinely unreachable
    // (no chain of single-letter edits connects it to beginWord) — must
    // return 0, distinguishing "unreachable" from "missing entirely" (which
    // the existing hit/cog test above already covers).
    assert(word_ladder_length("hit", "cog", ["hot", "dow", "dox", "cog"]) == 0, "cog is in wordList but no one-letter-edit chain reaches it from hit/hot: unreachable, not missing")

    // Extra: branching graph with two equal-length competing paths from "hot"
    // (hot-dot-dog-cog and hot-hop-cop-cog, both 3 hops) — BFS must explore
    // level by level and return the tied-shortest length (5 words total:
    // hit-hot-{dot,hop}-{dog,cop}-cog), not overcount by following just one
    // arbitrary branch to completion first.
    assert(word_ladder_length("hit", "cog", ["hot", "dot", "dog", "cog", "hop", "cop"]) == 5, "hit-hot-dot-dog-cog (tied with hit-hot-hop-cop-cog) is the 5-word shortest ladder")

    // Extra: a moderately sized wordList to confirm the hashed-dict
    // membership path (the fix above) still finds the right shortest length
    // once N grows past a handful of words — via a "thermometer code":
    // word_i has 'b' in its first i positions and 'a' in the rest (word_0 is
    // all 'a', word_{n-1} is all 'b'). The Hamming distance between word_i
    // and word_j is EXACTLY |i-j| (only positions in the range [min,max) can
    // differ, and every one of them does), so this is a true path graph with
    // no shortcut edges — unlike a naive "vary one alphabet position"
    // construction, where any two words sharing all-but-one position end up
    // mutually adjacent (a clique, not a chain).
    const N = 30
    let l = N - 1
    let chain = [str_mul("b", i) + str_mul("a", l - i) for i in 0..N]
    assert(len(chain) == N, "chain construction sanity check: N distinct words")
    assert(word_ladder_length(chain[0], chain[N - 1], chain) == N, "forced N-word one-letter path (thermometer-code construction, no shortcuts): shortest ladder must be exactly N")

    print("PASS: Word Ladder")
