// 51_n_queens.nova — LeetCode 51, N-Queens (Hard).
//
// The n-queens puzzle places n queens on an n x n board so that no two queens
// attack each other (same row, same column, or same diagonal). Return the
// COUNT of distinct solutions (board strings are not required).
//
// ALGORITHM — backtracking, one queen per row, O(1) conflict check per placement.
// A queen is placed row-by-row (row 0..n-1), one queen per row, so row conflicts
// are impossible by construction. What remains to check per candidate column is:
//   - column reuse       -> tracked by direct index into the `cols` array
//   - "/" diagonal reuse  -> every cell on the same "/" diagonal shares the
//                            invariant (row - col) == constant, tracked by direct
//                            index into `diag1` (shifted by n-1 so it's non-negative)
//   - "\" diagonal reuse  -> every cell on the same "\" diagonal shares the
//                            invariant (row + col) == constant, tracked by direct
//                            index into `diag2`
// `cols`/`diag1`/`diag2` are plain boolean arrays, not NOVA's `set_*` handle: NOVA's
// `set_*` builtins are documented as an "opaque hash-set handle" but the runtime
// (nova_runtime.c, nova_rt_set_has/add/remove) actually backs them with a NovaList
// and a LINEAR SCAN under `nova_rt_eq` per call — i.e. O(row) per membership test,
// not O(1). Using them here would silently degrade this solution to exactly the
// O(row)-per-candidate re-scan the required technique calls out to avoid. Direct
// array indexing (`nova_rt_list_get`/`nova_rt_list_set`, bounds-checked, no scan) is
// genuinely O(1) regardless of how many queens are already placed, so that's what's
// used for all three conflict axes. Placing a queen flips its three flags to true;
// backtracking (after exploring that branch) flips them back to false, so the three
// arrays always describe exactly the queens on the current partial board. The search
// itself is inherently exponential (it enumerates every valid arrangement) — the
// O(1)-per-check pruning is what keeps each node of that exponential tree cheap,
// which is the actual target of this problem.
fn _count_solutions(n: int, row: int, cols, diag1, diag2) -> int
    if row == n
        return 1
    let total = 0
    for col in 0..n
        let d1 = row - col + n - 1
        let d2 = row + col
        if cols[col] or diag1[d1] or diag2[d2]
            continue
        cols[col] = true
        diag1[d1] = true
        diag2[d2] = true
        total += _count_solutions(n, row + 1, cols, diag1, diag2)
        cols[col] = false
        diag1[d1] = false
        diag2[d2] = false
    return total

// Returns the number of distinct N-queens solutions for an n x n board.
fn total_n_queens(n: int) -> int
    if n <= 0
        return 0
    let cols = [false for _ in 0..n]
    let diag1 = [false for _ in 0..(2 * n - 1)]
    let diag2 = [false for _ in 0..(2 * n - 1)]
    return _count_solutions(n, 0, cols, diag1, diag2)

fn main()
    assert(total_n_queens(0) == 0, "n=0 has no board to place queens on")
    assert(total_n_queens(1) == 1, "1x1 board has 1 trivial solution")
    assert(total_n_queens(2) == 0, "2x2 board has no solution")
    assert(total_n_queens(3) == 0, "3x3 board has no solution")
    assert(total_n_queens(4) == 2, "4x4 board has 2 distinct solutions")
    assert(total_n_queens(5) == 10, "5x5 board has 10 distinct solutions")
    assert(total_n_queens(6) == 4, "6x6 board has 4 distinct solutions (notoriously few)")
    assert(total_n_queens(7) == 40, "7x7 board has 40 distinct solutions")
    assert(total_n_queens(8) == 92, "classic 8x8 board has 92 solutions")
    assert(total_n_queens(9) == 352, "9x9 board (LeetCode's max n) has 352 solutions")
    print("PASS: N-Queens")
