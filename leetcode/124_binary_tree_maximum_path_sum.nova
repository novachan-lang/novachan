// LeetCode 124 — Binary Tree Maximum Path Sum
//
// ALGORITHM — single post-order DFS. For each node we need two different numbers, so the
// helper returns them threaded together as a 2-element list instead of using a module-level
// mutable:
//   [0] "downward gain" — the best sum of a path that starts AT this node and goes down into
//       AT MOST ONE child (this is the only shape usable by an ancestor, since a path can't
//       fork once it commits to going through a parent). A branch is only worth taking if it's
//       positive, so each child's downward gain is clamped to >= 0 ("an unhelpful negative
//       branch contributes nothing") before being folded in.
//   [1] "best so far" — the best path sum found ANYWHERE in this subtree, including paths that
//       are NOT constrained to pass through this node's parent. At every node we try it as the
//       path's "peak" — left_gain + node.val + right_gain, i.e. the path bends through this
//       node using BOTH children at once — and fold that against whatever the two child
//       subtrees already found on their own, via max().
// An empty subtree contributes gain 0 (nothing to add) and a sentinel NEG_INF best (it has no
// path of its own, so it must never win a max() against a real node's result).
//
// COMPLEXITY — every node is visited exactly once in the post-order walk, O(n) time. The only
// extra space is the call stack, O(h) where h is the tree height (O(log n) balanced, O(n)
// degenerate/skewed) — no auxiliary arrays or memo tables.

const NEG_INF = -1000000000

type TreeNode
    val: int
    left: TreeNode
    right: TreeNode

// Returns [downward_gain, best_path_sum_in_this_subtree]
fn _max_path_helper(node: TreeNode) -> list
    if node == null
        return [0, NEG_INF]

    let (left_down, left_best) = _max_path_helper(node.left)
    let (right_down, right_best) = _max_path_helper(node.right)

    let left_gain = max(left_down, 0)
    let right_gain = max(right_down, 0)

    let peak = node.val + left_gain + right_gain            // path bending through this node
    let best_here = max(peak, max(left_best, right_best))   // vs. the best each subtree found alone

    let downward = node.val + max(left_gain, right_gain)    // usable by this node's own parent
    return [downward, best_here]

fn max_path_sum(root: TreeNode) -> int
    let (_, best) = _max_path_helper(root)
    return best

fn main()
    // [1,2,3] -> peak at root: 2 + 1 + 3 = 6
    let t1 = TreeNode(1, TreeNode(2, null, null), TreeNode(3, null, null))
    assert(max_path_sum(t1) == 6, "[1,2,3] -> 6")

    // [-10,9,20,null,null,15,7] -> best path is 15 -> 20 -> 7 = 42, ignoring the negative root
    let t2 = TreeNode(-10, TreeNode(9, null, null), TreeNode(20, TreeNode(15, null, null), TreeNode(7, null, null)))
    assert(max_path_sum(t2) == 42, "[-10,9,20,null,null,15,7] -> 42")

    // single node -3 -> the only path is the node itself, negative or not
    let t3 = TreeNode(-3, null, null)
    assert(max_path_sum(t3) == -3, "single node [-3] -> -3")

    // [2,-1] -> the negative child is not worth including; best path is just the root
    let t4 = TreeNode(2, TreeNode(-1, null, null), null)
    assert(max_path_sum(t4) == 2, "[2,-1] -> 2")

    // ADVERSARIAL: all-negative tree -> best path is the single least-negative node (-1),
    // clamping downward gains to 0 must stop any two negatives from being combined
    let t5 = TreeNode(-3, TreeNode(-2, null, null), TreeNode(-1, null, null))
    assert(max_path_sum(t5) == -1, "all-negative [-3,-2,-1] -> -1")

    // ADVERSARIAL: very negative single node -> must not collide with NEG_INF sentinel
    let t6 = TreeNode(-100000, null, null)
    assert(max_path_sum(t6) == -100000, "single node [-100000] -> -100000")

    // ADVERSARIAL: the true best path is buried in a non-root subtree (4-2-5 = 11) and must
    // survive being folded upward through a node whose OWN peak (-90) is much worse, proving
    // best_here propagates via max() rather than being overwritten by the parent's peak
    //        -100
    //        /  \
    //       2    3
    //      / \
    //     4   5
    let t7 = TreeNode(-100, TreeNode(2, TreeNode(4, null, null), TreeNode(5, null, null)), TreeNode(3, null, null))
    assert(max_path_sum(t7) == 11, "buried subtree peak (4-2-5=11) survives past a bad root -> 11")

    // ADVERSARIAL: left-skewed chain of 5 all-positive nodes -> no fork is possible, so the
    // only path is the whole spine; also exercises O(h) recursion depth on a degenerate tree
    let t8 = TreeNode(1, TreeNode(2, TreeNode(3, TreeNode(4, TreeNode(5, null, null), null), null), null), null)
    assert(max_path_sum(t8) == 15, "left-skewed chain [1,2,3,4,5] -> 15 (whole spine)")

    print("PASS: Binary Tree Maximum Path Sum")
