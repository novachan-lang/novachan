// 32_longest_valid_parentheses.nova — LeetCode 32, Longest Valid Parentheses (Hard).
//
// Given a string containing just '(' and ')', return the length of the
// longest valid (well-formed) parentheses substring.
//
// ALGORITHM — stack of INDICES, O(n) time, O(n) space, single left-to-right pass.
// The stack always holds the index of the last character that could still be
// the LEFT boundary of an unmatched region — either an unmatched '(' or the
// index right before the start of a currently-valid run. We seed it with a
// sentinel base of -1 so the very first valid run (starting at index 0) has
// something to measure against.
//
// For each character:
//   - '(' : push its index — it's a new candidate boundary.
//   - ')' : pop first (attempting to match it against the top of the stack).
//       - If the stack is now EMPTY, this ')' had nothing to match — it
//         becomes the new base boundary, so push its own index.
//       - Otherwise the pop just consumed a matched '(' and the new top of
//         stack is the index of the character just before the current valid
//         run — the run's length is `i - stack.top()`, a candidate for the max.
// Every index is pushed at most once and popped at most once, so the stack
// holds O(n) entries across the run and the whole pass is O(n) time / O(n)
// space — the required complexity for this problem (no DP table needed).
// deque_create/push_back/pop_back/back/is_empty are zero-import runtime
// builtins (see NOVA_DESIGN/NOVA_LANGUAGE_FEATURES.md section 8) — do not
// confuse with std/collections/deque.nova's separate dq_* API.

fn longest_valid_parentheses(s: string) -> int
    let stack = deque_create()
    deque_push_back(stack, -1)
    let max_len = 0
    for i in 0..len(s)
        if s[i] == "("
            deque_push_back(stack, i)
        else
            deque_pop_back(stack)
            if deque_is_empty(stack)
                deque_push_back(stack, i)
            else
                max_len = max(max_len, i - deque_back(stack))
    return max_len

fn main()
    assert(longest_valid_parentheses("(()") == 2, "(()  -> 2")
    assert(longest_valid_parentheses(")()())") == 4, ")()())  -> 4")
    assert(longest_valid_parentheses("") == 0, "empty string -> 0")
    assert(longest_valid_parentheses("()(()") == 2, "()((()  -> 2")
    assert(longest_valid_parentheses("()(())") == 6, "()(())  -> 6")

    // Extra edge probes beyond the required cases: all-unmatched closers,
    // all-unmatched openers, and a run that starts mid-string after a reset.
    assert(longest_valid_parentheses(")))") == 0, "all closers -> 0")
    assert(longest_valid_parentheses("(((") == 0, "all openers -> 0")
    assert(longest_valid_parentheses("()()") == 4, "back-to-back pairs -> 4")

    print("PASS: Longest Valid Parentheses")
