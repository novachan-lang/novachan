// LeetCode 297 — Serialize and Deserialize Binary Tree
//
// ALGORITHM — pre-order DFS with an explicit null sentinel ("#"), the classic bijective
// tree<->string encoding:
//   serialize:   pre-order walk (node, then left subtree, then right subtree). Every visited
//     node contributes its value; every missing child contributes the sentinel "#" in place of
//     a subtree instead of being skipped. Because a null contributes exactly one token, the
//     token stream fully determines where every subtree starts and ends — no separator/count
//     metadata is needed, and the shape is recoverable purely from token ORDER.
//   deserialize: read tokens in the SAME pre-order — value first, then recursively rebuild the
//     left subtree, then recursively rebuild the right subtree — so the token consumed by each
//     recursive call lines up exactly with the token the matching serialize call produced at
//     that position. The token stream is consumed via an explicit cursor: `split()` the encoded
//     string into tokens, `reverse()` once (O(n), done exactly once), then `pop()` off the tail
//     of the reversed list for O(1) "take the next token" — the reversed list acts as an
//     array-backed stack whose pop order is the original forward token order. This is the
//     array-backed-stack technique that fits the algorithm: a plain recursive index-into-list
//     read would need an extra threaded return value (or a boxed cursor) just to advance a
//     position across sibling recursive calls, while `pop()` mutates the SAME list handle that
//     every recursive call already shares as a parameter (list parameters are reference/handle
//     values within a process — see `_ws2_dfs`'s shared `found` accumulator in
//     212_word_search_ii.nova for the identical cross-call-mutation pattern), so the cursor
//     advances correctly with zero extra plumbing.
//
// COMPLEXITY — serialize visits each of the n nodes exactly once, doing O(1) work per node
// (one push, or one push + two recursive calls), so O(n) time; the output token list holds
// exactly n + (number of null children) <= 2n+1 entries, O(n) space. deserialize does one O(n)
// split, one O(n) reverse, then pops exactly (2n+1) tokens total (one per real node's value
// token, two per real node's null-child sentinels, one for a wholly-empty tree), each pop O(1)
// amortized, so O(n) time; the rebuilt tree plus the token list is O(n) space. Both directions
// use only the call stack beyond the token list — O(h) deep, h = tree height — no auxiliary
// visited-set or memo table.

type TreeNode
    val: int
    left: TreeNode
    right: TreeNode

// Pre-order DFS. Appends "#" for a missing child, otherwise the value followed by the
// left-subtree tokens then the right-subtree tokens.
fn _serialize_helper(node: TreeNode, tokens: list<string>)
    if node == null
        tokens.push("#")
    else
        tokens.push(str(node.val))
        _serialize_helper(node.left, tokens)
        _serialize_helper(node.right, tokens)

fn serialize(root: TreeNode) -> string
    let tokens = []
    _serialize_helper(root, tokens)
    return tokens.join(",")

// Consumes tokens off the TAIL of `rtokens` (the reverse of the real token order), so each
// pop() yields the next token in original left-to-right order. Rebuilds bottom-up: a node's
// left and right subtrees are fully parsed (and have consumed their tokens) before the node
// itself is constructed, since TreeNode fields are set once at construction time.
fn _deserialize_helper(rtokens: list<string>) -> TreeNode
    let tok = rtokens.pop()
    if tok == "#"
        return null
    let val = parse_int(tok)
    let left = _deserialize_helper(rtokens)
    let right = _deserialize_helper(rtokens)
    return TreeNode(val, left, right)

fn deserialize(data: string) -> TreeNode
    let rtokens = data.split(",") |> reverse()
    _deserialize_helper(rtokens)

fn main()
    // [1,2,3,null,null,4,5]: root=1, left=2 (leaf), right=3 (left=4, right=5).
    // Nulls appear in a non-trivial position (node 2's two children), not just at the fringe.
    let t1 = TreeNode(1, TreeNode(2, null, null), TreeNode(3, TreeNode(4, null, null), TreeNode(5, null, null)))
    let s1 = serialize(t1)
    assert(s1 == "1,2,#,#,3,4,#,#,5,#,#", "serialize [1,2,3,null,null,4,5] produces the expected preorder token stream")
    let d1 = deserialize(s1)
    assert(d1.val == 1, "root value round-trips")
    assert(d1.left.val == 2, "left child value round-trips")
    assert(d1.left.left == null and d1.left.right == null, "left child stays a leaf after round-trip")
    assert(d1.right.val == 3, "right child value round-trips")
    assert(d1.right.left.val == 4, "right-left grandchild round-trips")
    assert(d1.right.right.val == 5, "right-right grandchild round-trips")
    assert(serialize(d1) == s1, "re-serializing the reconstructed tree reproduces the exact original encoding")

    // [] : an empty tree.
    let s2 = serialize(null)
    assert(s2 == "#", "serializing an empty tree yields the lone null sentinel")
    let d2 = deserialize(s2)
    assert(d2 == null, "deserializing the empty encoding yields an empty tree")

    // [1] : a single node.
    let t3 = TreeNode(42, null, null)
    let s3 = serialize(t3)
    assert(s3 == "42,#,#", "serializing a single node yields its value plus two null sentinels")
    let d3 = deserialize(s3)
    assert(d3.val == 42, "single node value round-trips")
    assert(d3.left == null and d3.right == null, "single node has no children after round-trip")
    assert(serialize(d3) == s3, "re-serializing the reconstructed single node reproduces the exact original encoding")

    print("PASS: Serialize and Deserialize Binary Tree")
