// 84_largest_rectangle_in_histogram.nova — LeetCode 84, Largest Rectangle in
// Histogram (Hard).
//
// Given an array of integers heights representing a histogram's bar heights
// (each bar has width 1), return the area of the largest rectangle that fits
// entirely within the histogram's outline.
//
// ALGORITHM — monotonic increasing stack of INDICES, O(n) time, O(n) space,
// single left-to-right pass.
//
// The stack always holds indices of bars whose heights form a strictly
// increasing run (bottom to top). That invariant is the whole trick: while
// an index sits on the stack, every bar to its LEFT that's still below it is
// unresolved, but its LEFT boundary is already known — it's the bar just
// below it on the stack (or the start of the array, if the stack is empty
// beneath it). Its RIGHT boundary is unknown until we hit a bar shorter than
// it, because that's the first bar that could not extend a rectangle of that
// height any further right.
//
// So: walk i from 0 to n (inclusive — one past the end, using an implicit
// height-0 sentinel at i == n to flush whatever is still on the stack, so no
// bar is left unresolved). At each step, while the current height is LESS
// than the height at the stack's top index, that top bar's right boundary
// has just been found (index i), so pop it and settle its rectangle:
//   - height  = heights[popped]
//   - width   = i - (new stack top) - 1, or i if the stack is now empty
//               (an empty stack means the popped bar was the shortest bar
//               seen so far, so it spans the whole run from index 0 to i-1)
//   - area    = height * width, a candidate for the running maximum
// Then push i (unless i == n, the sentinel) — heights[i] is now the new
// candidate top of a still-increasing run.
//
// Every index is pushed exactly once and popped at most once across the
// whole pass, so total work is O(n) time and the stack holds at most O(n)
// indices — the required complexity (no O(n^2) pairwise left/right scan).
//
// deque_create/push_back/pop_back/back/is_empty are zero-import runtime
// builtins (see NOVA_DESIGN/NOVA_LANGUAGE_FEATURES.md section 8) used here
// as the stack — same convention as 32_longest_valid_parentheses.nova.

fn largest_rectangle_area(heights: list<int>) -> int
    let n = len(heights)
    if n == 0
        return 0

    let stack = deque_create()
    let max_area = 0
    for i in 0..(n + 1)
        let cur_height = heights[i] if i < n else 0

        while not deque_is_empty(stack) and heights[deque_back(stack)] > cur_height
            let top = deque_pop_back(stack)
            let height = heights[top]
            let width = (i - deque_back(stack) - 1) if not deque_is_empty(stack) else i
            max_area = max(max_area, height * width)

        if i < n
            deque_push_back(stack, i)

    return max_area

fn main()
    assert(largest_rectangle_area([2, 1, 5, 6, 2, 3]) == 10, "classic histogram -> 10")
    assert(largest_rectangle_area([2, 4]) == 4, "two ascending bars -> 4")
    assert(largest_rectangle_area([1]) == 1, "single bar -> 1")
    assert(largest_rectangle_area([0, 9]) == 9, "leading zero bar -> 9")

    // Extra edge probes beyond the required cases: all-equal bars (the whole
    // strip is the answer), strictly descending (max is the tallest single
    // bar or a wide short run), and an all-zero histogram.
    assert(largest_rectangle_area([3, 3, 3, 3]) == 12, "all-equal bars -> full strip")
    assert(largest_rectangle_area([5, 4, 3, 2, 1]) == 9, "strictly descending -> 9")
    assert(largest_rectangle_area([0, 0, 0]) == 0, "all-zero histogram -> 0")

    // Adversarial-verification additions: an empty histogram (exercises the
    // n == 0 guard, which had no assert covering it) and a multi-peak
    // "valley" shape that forces several pops per outer step, cross-checked
    // independently against an O(n^2) brute force before landing here.
    assert(largest_rectangle_area([]) == 0, "empty histogram -> 0")
    assert(largest_rectangle_area([6, 7, 5, 2, 4, 5, 9, 3]) == 16, "multi-peak valley -> 16")

    print("PASS: Largest Rectangle in Histogram")
