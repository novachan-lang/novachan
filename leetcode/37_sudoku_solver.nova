// 37_sudoku_solver.nova — LeetCode 37, Sudoku Solver (Hard).
//
// Fill the empty cells (0) of a 9x9 board so every row, every column, and
// every 3x3 sub-box contains each digit 1-9 exactly once. Mutates the board
// in place and also returns it.
//
// ALGORITHM — backtracking, one empty cell at a time, O(1) conflict check
// per candidate digit. Row-major would work directly, but pre-collecting the
// empty cells once means each backtracking step is a pure array-index bump
// (idx + 1) instead of a re-scan for "the next empty cell" — the "3 boolean-
// tracking structures" prescribed by the problem are extended to also cover
// this bookkeeping for free.
//
// Correctness/complexity of the per-candidate check is the crux: a naive
// solver re-scans the 9 cells of the row, the 9 of the column, and the 9 of
// the box (27 cell reads, with duplicates) EVERY time it wants to know "is
// digit d legal at (r, c)". Instead we keep 9 row x 10, col x 10, and box x
// 10 BOOLEAN ARRAYS (rows[r][d], cols[c][d], boxes[b][d] = "digit d already
// used in that row/col/box"), exactly the `cols`/`diag1`/`diag2` direct-index
// pattern used in 51_n_queens.nova — NOT NOVA's `set_*` handle. `set_*` is
// documented as an "opaque hash-set handle" but the runtime
// (nova_runtime.c, nova_rt_set_has/add/remove) actually backs it with a
// NovaList and a LINEAR SCAN under `nova_rt_eq` per call, i.e. O(k) per
// membership test where k = digits already placed in that row/col/box, not
// a real O(1) hash lookup (51_n_queens.nova's header comment documents this
// same trap in detail — do not repeat the mistake here). Direct array
// indexing is genuinely O(1): a single bounds-checked index with zero
// iteration, regardless of how many digits are already placed. Placing
// digit d at (r, c) sets rows[r][d]/cols[c][d]/boxes[box_id(r,c)][d] to
// true; backtracking out of that branch flips them back to false. So the
// full legality check for one candidate is 3 true O(1) array reads instead
// of an O(27) board re-scan — the required optimization.
//
// The search itself is still exponential in the worst case (that's inherent
// to Sudoku — it's NP-complete in general, and even the classic instances
// need real backtracking) but a valid Sudoku puzzle prunes ferociously in
// practice: this classic newspaper puzzle backtracks to a solution almost
// immediately with 9-way branching capped by the row/col/box sets pruning
// nearly every branch at depth 1-2.

type Cell
    r: int
    c: int

// Every (row, col) whose starting value is 0, in row-major order.
fn _find_empties(board: list<list<int>>) -> list<Cell>
    [Cell(r, c) for r in 0..9 for c in 0..9 if board[r][c] == 0]

fn _box_id(r: int, c: int) -> int
    (r / 3) * 3 + (c / 3)

// Recursively assign the empty cell at empties[idx], trying digits 1-9 with
// O(1) legality checks against the running rows/cols/boxes boolean-tracking
// arrays. Returns true the instant a full assignment (idx reaches
// len(empties)) is found; unwinds (undoing both the board write and the
// three flag flips) on every dead end, which is exactly the backtrack step.
fn _fill(board: list<list<int>>, empties: list<Cell>, idx: int, rows: list, cols: list, boxes: list) -> bool
    if idx == len(empties)
        return true

    let cell = empties[idx]
    let r = cell.r
    let c = cell.c
    let b = _box_id(r, c)

    for d in 1..10
        if rows[r][d] or cols[c][d] or boxes[b][d]
            continue

        board[r][c] = d
        rows[r][d] = true
        cols[c][d] = true
        boxes[b][d] = true

        if _fill(board, empties, idx + 1, rows, cols, boxes)
            return true

        board[r][c] = 0
        rows[r][d] = false
        cols[c][d] = false
        boxes[b][d] = false

    return false

// Solves `board` in place and returns it wrapped in Ok; returns Err if the
// puzzle (as given) has no valid solution.
fn solve_sudoku(board: list<list<int>>) -> Result<list, string>
    // rows[r][d]/cols[c][d]/boxes[b][d] = "digit d already present" — index
    // 0 of the inner list is unused (digits are 1-9), sized 10 to allow
    // direct indexing by the digit itself with no off-by-one shift.
    let rows = [[false for d in 0..10] for i in 0..9]
    let cols = [[false for d in 0..10] for i in 0..9]
    let boxes = [[false for d in 0..10] for i in 0..9]

    for r in 0..9
        for c in 0..9
            let v = board[r][c]
            if v != 0
                rows[r][v] = true
                cols[c][v] = true
                boxes[_box_id(r, c)][v] = true

    let empties = _find_empties(board)
    if _fill(board, empties, 0, rows, cols, boxes)
        return ok(board)
    return err("puzzle has no solution")

// True iff xs is exactly a permutation of 1..9 (no repeats, no out-of-range,
// no leftover 0s from a failed solve).
fn _is_permutation_1_9(xs: list<int>) -> bool
    copy(xs) |> sort() == [1, 2, 3, 4, 5, 6, 7, 8, 9]

fn _box_cells(board: list<list<int>>, br: int, bc: int) -> list<int>
    [board[br * 3 + dr][bc * 3 + dc] for dr in 0..3 for dc in 0..3]

fn _board_is_valid_solution(board: list<list<int>>) -> bool
    let rows_ok = board.all_match(fn(row) _is_permutation_1_9(row))
    let cols_ok = [0, 1, 2, 3, 4, 5, 6, 7, 8].all_match(fn(c) _is_permutation_1_9([board[r][c] for r in 0..9]))
    let boxes_ok = [0, 1, 2].all_match(fn(br) [0, 1, 2].all_match(fn(bc) _is_permutation_1_9(_box_cells(board, br, bc))))
    rows_ok and cols_ok and boxes_ok

fn main()
    let board = [
        [5, 3, 0, 0, 7, 0, 0, 0, 0],
        [6, 0, 0, 1, 9, 5, 0, 0, 0],
        [0, 9, 8, 0, 0, 0, 0, 6, 0],
        [8, 0, 0, 0, 6, 0, 0, 0, 3],
        [4, 0, 0, 8, 0, 3, 0, 0, 1],
        [7, 0, 0, 0, 2, 0, 0, 0, 6],
        [0, 6, 0, 0, 0, 0, 2, 8, 0],
        [0, 0, 0, 4, 1, 9, 0, 0, 5],
        [0, 0, 0, 0, 8, 0, 0, 7, 9],
    ]

    match solve_sudoku(board)
        Ok(solved) =>
            assert(solved[0] == [5, 3, 4, 6, 7, 8, 9, 1, 2], "row 0 matches the classic puzzle's unique solution")
            assert(_board_is_valid_solution(solved), "every row/col/3x3-box of the solved board is a permutation of 1..9")
        Err(e) =>
            assert(false, "classic puzzle must be solvable, got error: " + e)

    print("PASS: Sudoku Solver")
