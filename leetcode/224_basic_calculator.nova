// 224_basic_calculator.nova — LeetCode 224, Basic Calculator (Hard).
//
// Given a string s representing a valid mathematical expression, evaluate it
// and return the result. The expression contains only non-negative integers,
// '+', '-', '(', ')', and spaces — no '*' or '/'.
//
// ALGORITHM — single left-to-right scan with an explicit stack, O(n) time,
// O(n) space worst case (stack depth == parenthesis nesting depth).
//
// Maintain a running `result`, the digits of the number currently being
// accumulated (`number`), and the `sign` (+1/-1) that applies to it once it
// is folded into `result`. A run of digits only ever extends `number`, so no
// character does more than O(1) work — that's the O(n) time bound. On '('
// the pair (result-so-far, sign-so-far) is pushed and both reset to
// (0, +1): everything inside the parens is then evaluated exactly as if it
// were its own independent top-level expression, because the outer sign in
// front of "(" hasn't been applied to it yet. On ')' the just-finished
// number is first folded into `result` (closing out the sub-expression's own
// arithmetic), then the pair on top of the stack is popped and combined as
// `result = priorResult + priorSign * result` — this multiplies the whole
// parenthesized sub-expression by the sign that preceded it and adds it back
// into the outer expression's running total, collapsing one level of
// nesting per ')'. The stack holds at most one [priorResult, priorSign]
// pair per currently-open, unmatched '(', so it never exceeds the maximum
// nesting depth — O(n) space in the worst case of a fully nested
// "(((...)))" string, O(1) for a flat expression.
fn calculate(s: string) -> int
    let stack = deque_create()   // stack of [priorResult, priorSign] pairs
    let result = 0
    let number = 0
    let sign = 1
    for c in s
        match c
            "+" =>
                result += sign * number
                number = 0
                sign = 1
            "-" =>
                result += sign * number
                number = 0
                sign = -1
            "(" =>
                deque_push_back(stack, [result, sign])
                result = 0
                sign = 1
            ")" =>
                result += sign * number
                number = 0
                let prior = deque_pop_back(stack)
                result = prior[0] + prior[1] * result
            _ =>
                if is_digit(c)
                    number = number * 10 + int(c)
    result += sign * number
    return result

fn main()
    assert(calculate("1 + 1") == 2, "simple addition -> 2")
    assert(calculate(" 2-1 + 2 ") == 3, "leading/trailing spaces, mixed signs -> 3")
    assert(calculate("(1+(4+5+2)-3)+(6+8)") == 23, "nested parens, two top-level groups -> 23")
    assert(calculate("2-(5-6)") == 3, "sign distributes through a single paren -> 3")

    // Extra edge probes beyond the required cases: multi-digit numbers (the
    // digit-accumulation path), a lone number with no operators, and
    // triple-nested parens (stack depth 3, exercising repeated pop+combine).
    assert(calculate("12+13-4") == 21, "multi-digit numbers -> 21")
    assert(calculate("42") == 42, "single number, no operators -> 42")
    assert(calculate("((1-(2-3))+4)") == 6, "triple-nested parens -> 6")

    // Independent adversarial probes (verifier-added): leading unary minus,
    // unary minus before a paren group, deep 5-level nesting, single number
    // wrapped in parens, and runs of multiple interior spaces.
    assert(calculate("-2+ 1") == -1, "leading unary minus -> -1")
    assert(calculate("- (3 + (4 + 5))") == -12, "unary minus distributes into nested parens -> -12")
    assert(calculate("1-(2-(3-(4-(5-6))))") == -3, "five-level nesting -> -3")
    assert(calculate("(0)") == 0, "single zero in parens -> 0")
    assert(calculate("1   +    2") == 3, "runs of interior spaces -> 3")
    assert(calculate("0") == 0, "bare zero -> 0")
    print("PASS: Basic Calculator")
