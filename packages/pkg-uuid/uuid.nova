fn _hex_char(n: int) -> string
    char_at("0123456789abcdef", n % 16)

fn _hex_byte(n: int) -> string
    _hex_char(n / 16) + _hex_char(n % 16)

fn _rand_byte() -> int
    random_int(0, 255)

fn uuid4() -> string
    let b0 = _hex_byte(_rand_byte())
    let b1 = _hex_byte(_rand_byte())
    let b2 = _hex_byte(_rand_byte())
    let b3 = _hex_byte(_rand_byte())
    let b4 = _hex_byte(_rand_byte())
    let b5 = _hex_byte(_rand_byte())
    let b6_raw = _rand_byte()
    let b6 = _hex_byte((b6_raw & 0x0f) | 0x40)
    let b7 = _hex_byte(_rand_byte())
    let b8_raw = _rand_byte()
    let b8 = _hex_byte((b8_raw & 0x3f) | 0x80)
    let b9 = _hex_byte(_rand_byte())
    let b10 = _hex_byte(_rand_byte())
    let b11 = _hex_byte(_rand_byte())
    let b12 = _hex_byte(_rand_byte())
    let b13 = _hex_byte(_rand_byte())
    let b14 = _hex_byte(_rand_byte())
    let b15 = _hex_byte(_rand_byte())
    b0 + b1 + b2 + b3 + "-" + b4 + b5 + "-" + b6 + b7 + "-" + b8 + b9 + "-" + b10 + b11 + b12 + b13 + b14 + b15
