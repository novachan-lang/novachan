fn _find_char(s: string, c: string) -> int
    let i = 0
    while i < len(s)
        if s[i] == c
            return i
        i += 1
    0 - 1

fn args_parse(argv: list) -> dict
    let result = {}
    result["_positional"] = []
    let i = 0
    while i < len(argv)
        let arg = str(argv[i])
        if starts_with(arg, "--")
            let key = slice(arg, 2, len(arg))
            let eq = _find_char(key, "=")
            if eq >= 0
                result[slice(key, 0, eq)] = slice(key, eq + 1, len(key))
            else if i + 1 < len(argv) and not starts_with(str(argv[i + 1]), "-")
                result[key] = str(argv[i + 1])
                i += 1
            else
                result[key] = "true"
        else if starts_with(arg, "-") and len(arg) == 2
            let key = slice(arg, 1, 2)
            if i + 1 < len(argv) and not starts_with(str(argv[i + 1]), "-")
                result[key] = str(argv[i + 1])
                i += 1
            else
                result[key] = "true"
        else
            push(result["_positional"], arg)
        i += 1
    result

fn args_get(parsed: dict, key: string, default_val: string) -> string
    if key in parsed
        return str(parsed[key])
    default_val

fn args_has(parsed: dict, key: string) -> bool
    key in parsed

fn args_positional(parsed: dict) -> list
    parsed["_positional"]
