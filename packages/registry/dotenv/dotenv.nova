fn _find_char(s: string, c: string) -> int
    let i = 0
    while i < len(s)
        if s[i] == c
            return i
        i += 1
    0 - 1

fn dotenv_parse(content: string) -> dict
    let env = {}
    let lines = split(content, "\n")
    for line in lines
        let trimmed = trim(line)
        if len(trimmed) == 0 or starts_with(trimmed, "#")
            continue
        let eq = _find_char(trimmed, "=")
        if eq > 0
            let key = trim(slice(trimmed, 0, eq))
            let val = trim(slice(trimmed, eq + 1, len(trimmed)))
            if len(val) >= 2 and starts_with(val, "\"") and ends_with(val, "\"")
                val = slice(val, 1, len(val) - 1)
            env[key] = val
    env

fn dotenv_load(path: string) -> dict
    let content = read_file(path)
    dotenv_parse(content)

fn dotenv_get(env: dict, key: string, default_val: string) -> string
    if key in env
        return str(env[key])
    default_val
