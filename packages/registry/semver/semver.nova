type SemVer
    major: int
    minor: int
    patch: int

fn semver_parse(s: string) -> SemVer
    let parts = split(s, ".")
    if len(parts) != 3
        return SemVer(0, 0, 0)
    SemVer(int(parts[0]), int(parts[1]), int(parts[2]))

fn semver_str(v: SemVer) -> string
    str(v.major) + "." + str(v.minor) + "." + str(v.patch)

fn semver_cmp(a: SemVer, b: SemVer) -> int
    if a.major != b.major
        return a.major - b.major
    if a.minor != b.minor
        return a.minor - b.minor
    a.patch - b.patch

fn semver_gt(a: SemVer, b: SemVer) -> bool
    semver_cmp(a, b) > 0

fn semver_gte(a: SemVer, b: SemVer) -> bool
    semver_cmp(a, b) >= 0

fn semver_lt(a: SemVer, b: SemVer) -> bool
    semver_cmp(a, b) < 0

fn semver_eq(a: SemVer, b: SemVer) -> bool
    semver_cmp(a, b) == 0

fn semver_compatible(a: SemVer, b: SemVer) -> bool
    a.major == b.major
